DEFINITION MODULE Midea;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   IOO,
   Log,
   StorageO,
   StringsO,
   Sync;

IMPORT
   device,
   io,
   iovalue,
   ns,
   nsitem,
   objlib,
   serial;
   
(*===========================================================================*)

TYPE
   TPIO = POINTER TO CIO;
   TPNS = POINTER TO CNS;
   TPMidea = POINTER TO CMideaDevice;

(*---------------------------------------------------------------------------*)

TYPE
   TPNSI = POINTER TO CNSI;

CLASS CNS( nsitem.Ans );
   LOCAL VAR
      Midea : TPMidea;

   INTERNAL VIRTUAL PROCEDURE CreateRoot() : ns.TPnsItem;
   INTERNAL VIRTUAL PROCEDURE CreateStructure();

   PRIVATE PROCEDURE NewItem( CONST Name : ARRAY OF WCHAR; NType : ns.TNameType; VType : iovalue.TValueType; Data : PTR ) : TPNSI;
END CNS;

(*---------------------------------------------------------------------------*)

CLASS CSerial( serial.CSerialHandler );
   LOCAL VAR
      PIO : TPIO;

   INTERNAL VIRTUAL PROCEDURE DataComplete( CONST Data : StorageO.AMemoryBuffer; OUT FirstIndexAfterData, FirstIndexAfterFrame : CARDINAL; OUT ApplyCheckSum : BOOLEAN ) : BOOLEAN;
   INTERNAL VIRTUAL PROCEDURE TestChkSum( CONST Data : StorageO.AMemoryBuffer ) : BOOLEAN;
   INTERNAL VIRTUAL PROCEDURE OnRx( Result : Sync.TAsyncResult; CONST Data : StorageO.AMemoryBuffer );

   INTERNAL VIRTUAL PROCEDURE AddChkSum( REF Data : StorageO.AMemoryBuffer );
   INTERNAL VIRTUAL PROCEDURE OnTx( Result : Sync.TAsyncResult );
END CSerial;

(*---------------------------------------------------------------------------*)

TYPE
   TPPacket = POINTER TO TInPacket;

CLASS CIO( io.AItemizedIO );
   LOCAL VAR
      Serial : CSerial;
      Midea : TPMidea;
   PRIVATE VAR
      _AbortFlag : BOOLEAN;
      _Pending : IOO.TDirection;
      _Item : TPNSI;
      _DataInfo : io.TPDataInfo;

   PUBLIC VIRTUAL READONLY PROPERTY
      Pending : BOOLEAN;
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROPERTY
      Advise : io.TAdvise;

   PUBLIC PROCEDURE Dispose();

   // IIO
   PUBLIC VIRTUAL PROCEDURE Run() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();
   PUBLIC VIRTUAL PROCEDURE IOh( Direction : IOO.TDirection; Item : ns.THash; REF Value : iovalue.Value; Delegate : io.TPDataInfo ) : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Abort();

   LOCAL PROCEDURE OnRx( Result : Sync.TAsyncResult; PPacket : TPPacket );
   LOCAL PROCEDURE OnTxCON( Result : Sync.TAsyncResult );
END CIO;

(*---------------------------------------------------------------------------*)

TYPE
   TModeItem = CARD8(
      mdFan = 0,
      mdXX = 1,
      mdHeat = 2,
      mdCool = 3,
      mdOn = 7
   );
   TMode = SET CARD8 OF TModeItem;
   
   TFanSpeedItem = CARD8(
      fsHigh = 0,
      fsMiddle = 1,
      fsLow = 2,
      fsAuto = 7
   );
   TFanSpeed = SET CARD8 OF TFanSpeedItem;
   
   TAuxItem = CARD8(
      aiSwingOn = 2
   );
   TAux = SET CARD8 OF TAuxItem;

   TData = RECORD
      Mode : TMode;
      FanSpeed : TFanSpeed;
      SetTemperature : CARD8;
      Aux : TAux;
   END; // TData
   TPData = POINTER TO TData;

CLASS CMideaDevice( objlib.AObject ) IMPLEMENTS device.IDevice;
   PRIVATE VAR
      _NS : CNS;
      _IO : CIO;
   LOCAL VAR
      _ACS : ARRAY [0..16], [0..64] OF TData;

   // IObject
   PUBLIC FINAL READONLY PROPERTY
      Type : objlib.TObjectType;
   PUBLIC FINAL PROPERTY
      Library : objlib.TPLibrary;
   PUBLIC FINAL PROCEDURE Dispose();

   // IDevice
   PUBLIC VIRTUAL PROCEDURE NS() : ns.TPns;
   PUBLIC VIRTUAL PROCEDURE IO() : io.TPIO;
	PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF PTR; CONST Log : log.TPLogger ) : Sync.TAsyncResult;
	
	// helpers
	LOCAL PROCEDURE TargetToData( Target : CARD16 ) : TPData;

   INITIALLY CMideaDevice();
   FINALLY CMideaDevice();
END CMideaDevice;

(*---------------------------------------------------------------------------*)

END Midea.