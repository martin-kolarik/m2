DEFINITION MODULE Onkyo;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   device,
   helper,
   INIFile,
   io,
   IOO,
   iovalue,
   lists,
   log,
   netsocket,
   ns,
   nsitem,
   rawconnection,
   StorageO,
   StringsO,
   Sync,
   TextReader,
   threadpool;
   
(*===========================================================================*)

TYPE
   TPIO = POINTER TO CIO;
   TPNS = POINTER TO CNS;

(*---------------------------------------------------------------------------*)

CLASS CNS( nsitem.Ans );
   LOCAL VAR
      DataRoot : nsitem.TPnsItem;

   // IMapper
   PUBLIC VIRTUAL PROCEDURE HashToName( CONST Hash : ns.THash; OUT Name : StringsO.IString ) : BOOLEAN;

   // Ans
   INTERNAL VIRTUAL PROCEDURE CreateRoot() : ns.TPnsItem;
   INTERNAL VIRTUAL PROCEDURE CreateStructure();

   // SELF
   PUBLIC VIRTUAL PROCEDURE CreateNewItem( CONST Name : ARRAY OF WCHAR; NType : ns.TNameType; VType : iovalue.TValueType; Data : PTR ) : ns.TPnsItem;
END CNS;

(*---------------------------------------------------------------------------*)

TYPE
   TConnectState = (
      csDisconnected,
      csConnecting,
      csWaitAuthorization,
      csConnected
   );

CLASS CDeviceCommunicator( netsocket.ASocketNotifier ) IMPLEMENTS io.IStartStopControl, threadpool.ITimeoutSink;

   LOCAL VAR
      PIO : TPIO;
      Logger : log.CLogger;

   PRIVATE VAR
      _AppenderList : lists.CPtrList;
      _Running : BOOLEAN := FALSE;
      _Lock : Sync.LOCK;
      _State : TConnectState := csDisconnected; // 0 = disconnected, -1 = connected wait auth, 1 = connected with auth
      _AuthRequested : BOOLEAN := FALSE;
      _AuthKey : StringsO.CString;
      _HostAddress : StringsO.CString;
      _Password : StringsO.CString;
      _Connection : rawconnection.ClientTCPConnection;
      _ConnectionCloseTimeoutHandle : threadpool.TPoolHandle;
      _PoolDelegate : threadpool.CSinkDelegate;
      _Queue : lists.CStringList;
      _Reader : TextReader.CTextReader;

   // ASocketNotifier
   LOCAL VIRTUAL PROCEDURE OnConnect( Result : CARDINAL; CONST Socket : netsocket.TPDSocket; Local : BOOLEAN ); 
   PUBLIC VIRTUAL PROCEDURE OnReadable( Length : CARDINAL; Source : ADDRESS );

   // IStartStopControl
   // ???
   PUBLIC VIRTUAL READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();
   
   // ITimeoutSink
   LOCAL VIRTUAL PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : threadpool.TPoolHandle; UserId : PTR );

   // SELF
   PUBLIC PROCEDURE Configure( CONST iniFile : INIFile.CINIFile; CONST iniFileSection : StringsO.IString; CONST Log : log.TPLogger ) : Sync.TAsyncResult;
   PUBLIC PROCEDURE Dispose();

   PUBLIC PROCEDURE Request( CONST request : StringsO.IString );
   
   // private
   PRIVATE PROCEDURE FlushQueue();
   PRIVATE PROCEDURE StartTimeout( TimeoutMS : CARDINAL; WaitOnce : BOOLEAN; REF Handle : threadpool.TPoolHandle );
   PRIVATE PROCEDURE StopTimeout( REF Handle : threadpool.TPoolHandle );
END CDeviceCommunicator;

(*---------------------------------------------------------------------------*)

CLASS CIO( io.AItemizedIO ) IMPLEMENTS threadpool.ITimeoutSink;

   LOCAL VAR
      DeviceCommunicator : CDeviceCommunicator;
      DataRoot : nsitem.TPnsItem;
   PRIVATE VAR
      _Lock : Sync.LOCK;
      _PoolDelegate : threadpool.CSinkDelegate;
      _PeriodHandle : threadpool.TPoolHandle := NIL;

   PUBLIC PROCEDURE Dispose();

   // IStartStopControl
   PUBLIC VIRTUAL READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();

   // IIO
   PUBLIC VIRTUAL READONLY PROPERTY
      IOCapabilities : io.TCapabilities;
      Pending : BOOLEAN;
   PUBLIC VIRTUAL PROPERTY
      Advise : io.TAdvise;
      AdviseListener : io.TPIAdviseInfo;
   PUBLIC VIRTUAL PROCEDURE IOh( CONST Originator : io.TPOriginator; Direction : IOO.TDirection; Item : ns.THash; REF Value : iovalue.Value; Delegate : io.TPDataInfo ) : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE AbortAll();

   // ITimeoutSink
   LOCAL VIRTUAL PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : threadpool.TPoolHandle; UserId : PTR );

   // SELF
   LOCAL PROCEDURE OnResponse( response : StringsO.CString );
END CIO;

(*---------------------------------------------------------------------------*)

CLASS COnkyoDevice( helper.AObject ) IMPLEMENTS device.IDevice;

   // IObject
   PUBLIC FINAL READONLY PROPERTY
      Type : iobject.TObjectType;
   PUBLIC FINAL PROPERTY
      Library : iobject.TPLibrary;
   PUBLIC VIRTUAL PROCEDURE OnDispose();

   // IDevice
   PUBLIC VIRTUAL READONLY PROPERTY
      DeviceCapabilities : device.TCapabilities;
   PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult;

   PUBLIC VIRTUAL PROCEDURE Mapper() : ns.TPMapper;
   PUBLIC VIRTUAL PROCEDURE NS() : ns.TPns;

   PUBLIC VIRTUAL PROCEDURE IO() : io.TPIO;

   // self
   PRIVATE VAR
      _NS : CNS;
      _IO : CIO;

END COnkyoDevice;

(*---------------------------------------------------------------------------*)

END Onkyo.