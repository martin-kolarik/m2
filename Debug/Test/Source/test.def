DEFINITION MODULE test;

IMPORT
   iobject,
   log;

(*================================================================================*)
// interfaces
   
TYPE
   TTestResult = TRISTATE(
      trSuccess = 1,
      trFailure = 0,
      trUnknown = -1
   );
   
TYPE
   TPHost = POINTER TO IHost;
   TPTest = POINTER TO ITest;
   TPTests = POINTER TO ITests;
   
INTERFACE IHost;
   READONLY PROPERTY
      Log : log.TPLogger;
   PROPERTY
      Progress : CARDINAL; // percent
   // optional
   PROCEDURE StartPhase( CONST Name : ARRAY OF WCHAR );
   PROCEDURE StopPhase();
END IHost;

INTERFACE ITest;
   PROCEDURE Run( CONST Host : TPHost; CONST Parameters : ARRAY OF PWCHAR ) : TTestResult;
END ITest;

INTERFACE ITests( iobject.IObject ); // CID in : Development.Tests
   // for test run
   PROCEDURE TestFactory( CONST ClassPath : ARRAY OF WCHAR; OUT Object : iobject.TPObject ) : CARDINAL; // ClassPath can be empty, in the case default ITests class is created; return is objlib.TResult
   PROCEDURE EnumerateTests( REF ES : PTR; OUT Name : ARRAY OF WCHAR; OUT Test : TPTest ) : BOOLEAN;
   // for test creation
   PROCEDURE AddTest( CONST Name : ARRAY OF WCHAR; Test : TPTest );
END ITests;

(*================================================================================*)
   
END test.