DEFINITION MODULE test;

IMPORT
   collection,
   iplugin,
   log;

(*================================================================================*)
// interfaces
   
TYPE
   TTestResult = TRISTATE(
      trSuccess = 1,
      trFailure = 0,
      trUnknown = -1
   );
   
TYPE
   TPHost = POINTER TO IHost;
   TPTest = POINTER TO ITest;
   TPTests = POINTER TO ITests;
   
#save, option( dll_export => on )

(*---------------------------------------------------------------------------*)

INTERFACE IHost;

   // overall data
   READONLY PROPERTY
      Log : log.TPILogger;
      Output : log.TPIOutput;
      FastEvaluation : BOOLEAN;

   PROPERTY
      Progress : CARDINAL; // percent

   // phasing
   PROCEDURE StartPhase( CONST Name : ARRAY OF WCHAR );
      // particles inbetween, see below
   PROCEDURE StopPhase();
   PROCEDURE StopPhaseWithResult( result : BOOLEAN ); // expression = TRUE and no ASSERT means success

   // particles allow more detailed test tracking, although they are unnecessary, phases are sufficient
   PROCEDURE ParticleWithResult( CONST Description : ARRAY OF WCHAR; result : BOOLEAN ); // expression = TRUE and no ASSERT means success
   PROCEDURE ParticleWithAssert( CONST Description : ARRAY OF WCHAR ); // found means success

END IHost;

(*---------------------------------------------------------------------------*)

INTERFACE ITest;

   PROCEDURE Run( CONST Host : TPHost; CONST Parameters : ARRAY OF PWCHAR ) : TTestResult;

END ITest;

(*---------------------------------------------------------------------------*)

INTERFACE ITestIterator( collection.IIterator );

   PROCEDURE
      Name( OUT name : ARRAY OF WCHAR );
   READONLY PROPERTY
      Test : TPTest;

END ITestIterator;

(*---------------------------------------------------------------------------*)

INTERFACE ITests( iplugin.IPluginObject ); // CID in : Development.Tests

   // for test run
   PROCEDURE TestFactory( CONST ClassPath : ARRAY OF WCHAR; OUT Object : iplugin.TPPluginObject ) : CARDINAL; // ClassPath can be empty, in the case default ITests class is created; return is objlib.TResult
   PROCEDURE GetIterator() : POINTER TO ITestIterator;

   // for test creation
   PROCEDURE AddTest( CONST Name : ARRAY OF WCHAR; Test : TPTest );

END ITests;

(*---------------------------------------------------------------------------*)

#restore   

(*================================================================================*)
   
END test.