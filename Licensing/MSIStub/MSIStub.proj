<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType>Product</ComponentType>

        <ProductId>SmartControl.MSIHelper</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>
        <FileDescription>MSI Helper</FileDescription>
        <FileVersionMajor>1</FileVersionMajor>
        <FileVersionMinor>0</FileVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="modula2\modula2;api\Win32;api\Msi"/>
        <Components Include="component\sccore;licensing\core"/>
        <Program Include="MSIStub"/>
    </ItemGroup>

    <PropertyGroup>
        <Export>export</Export>
    </PropertyGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
