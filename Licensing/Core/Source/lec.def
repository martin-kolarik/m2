DEFINITION MODULE lec;

IMPORT
   Delegate,
   lists,
   sync,
   time;

(*================================================================================*)

TYPE
   TInfo = (
      riUnknown,
      riDemo,
      riNotActivated,
      riActivated
   );
   
   TBehaviour =
   (
      bhWorstCase, // use the data with most restrictive setting
      bhBestCase // use the data with most benevolent setting
   );

   // copy of Items.TLicenceTypeItem, keep this synchronized
	TLicenceTypeItem = (
		ltUnnamed,
		ltUpgrade,
		ltEducational,
		ltTrial, // without activation runs as DEMO not as unregistered
		
		ltActivated,
		ltExpired
	);
	TLicenceType = SET OF TLicenceTypeItem;

(*--------------------------------------------------------------------------------*)

CLASS CResult( Delegate.ADelegate );
   PRIVATE VAR
      _Lock : sync.LOCK;
      _Info : TInfo;
      _Expires : time.TJD;
      _Start : time.TJD;
      _Counter : CARDINAL := 0;
      _Licences : lists.CStringList; // Data contains TLicenceType

   LOCAL PROCEDURE QueryStarted();
   LOCAL PROCEDURE QueryData( data : PTR );
   LOCAL PROCEDURE QueryFinished();
   
   PUBLIC VAR
      Behaviour : TBehaviour := bhBestCase;
   PUBLIC READONLY PROPERTY
      Info : TInfo;
      Expires : time.DateTime;
      Expired : BOOLEAN;
      NextCheck : CARDINAL;
      Counted : BOOLEAN;
      Licences : lists.TPStringList;

   PUBLIC PROCEDURE Reset( Behaviour : TBehaviour );
   PUBLIC PROCEDURE Inc();
END CResult;

(*================================================================================*)

PROCEDURE Query( CONST Path1, Path2, ProductId : ARRAY OF WCHAR; REF Result : CResult ); // dangerous
PROCEDURE QueryData( CONST Path1, Path2 : ARRAY OF WCHAR; Data : ADDRESS; Length : CARDINAL; REF Result : CResult );

PROCEDURE RegisterValidator( Data : ADDRESS; Length : CARDINAL; Validator : ADDRESS );
PROCEDURE UnregisterValidator( Data : ADDRESS );

PROCEDURE StoreData( CONST Path : ARRAY OF WCHAR; Data : ADDRESS; Length : CARDINAL; Value : BOOLEAN );
CONST
   LockSystem ::= StoreData;

(*================================================================================*)

END lec.