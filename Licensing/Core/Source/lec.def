DEFINITION MODULE lec;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   Delegate,
   datetime,
   lists,
   sync;

(*================================================================================*)

TYPE
   TStateInfo = (
      siUnknown,
      siDemo,
      siNotActivated,
      siActivated
   );
   
   TBehaviour =
   (
      bhWorstCase, // use the data with most restrictive setting
      bhBestCase // use the data with most benevolent setting
   );

   // copy of Items.TLicenceTypeItem, keep this synchronized
	TLicenceTypeItem = (
		ltUnnamed,
		ltUpgrade,
		ltEducational,
		ltTrial, // without activation runs as DEMO not as unregistered
		
		ltActivated,
		ltExpired
	);
	TLicenceType = SET OF TLicenceTypeItem;

(*--------------------------------------------------------------------------------*)

TYPE
   TPProduct = POINTER TO CProduct;

CLASS CProduct;
   PRIVATE VAR
      _Id : StringsO.CString;
      _Name : StringsO.CString;
      _Licences : lists.CStringList; // Data contains TLicenceType
      _StateInfo : TStateInfo;
      _Expires : datetime.TJD;
      _Info : lists.CStringStringList;

   PUBLIC READONLY PROPERTY
      Name : StringsO.CString;
      Id : StringsO.CString;
      StateInfo : TStateInfo;
      Expires : datetime.DateTime;
      Expired : BOOLEAN;
      Info : lists.TPStringStringList;
      Licences : lists.TPStringList;

   VIRTUAL PROCEDURE Dispose();
   
   // private
   LOCAL PROCEDURE Construct( CONST Id, Name : StringsO.IString; stateInfo : TStateInfo; expires : datetime.TJD );
END CProduct;

(*--------------------------------------------------------------------------------*)

CLASS CResult( Delegate.ADelegate );
   PRIVATE VAR
      _Lock : sync.LOCK;
      _Info : TStateInfo;
      _Expires : datetime.TJD;
      _Start : datetime.TJD;
      _Counter : CARDINAL := 0;
      _Products : lists.CPtrList;

   LOCAL PROCEDURE QueryStarted();
   LOCAL PROCEDURE QueryData( data : PTR );
   LOCAL PROCEDURE QueryFinished();

   // result summarization method   
   PUBLIC VAR
      Behaviour : TBehaviour := bhBestCase;
   // summarized data
   PUBLIC READONLY PROPERTY
      StateInfo : TStateInfo;
      Expires : datetime.DateTime;
      Expired : BOOLEAN;
      NextCheck : CARDINAL;
      Counted : BOOLEAN;

   PUBLIC PROCEDURE Reset( Behaviour : TBehaviour );
   PUBLIC PROCEDURE Inc();
   PUBLIC PROCEDURE GetLicences( OUT list : lists.CStringList ); // fills licences of the first product
   
   // enumerating products
   PUBLIC PROCEDURE ProductsLock();
   PUBLIC PROCEDURE ProductsUnlock();
   PUBLIC PROCEDURE ProductsReset();
   PUBLIC PROCEDURE ProductsMoveNext() : BOOLEAN;
   PUBLIC READONLY PROPERTY
      CurrentProduct : TPProduct;

   // SELF helpers
   PRIVATE PROCEDURE Dispose();
END CResult;

(*================================================================================*)

PROCEDURE Query( CONST Path1, Path2, ProductId : ARRAY OF WCHAR; REF Result : CResult ); // dangerous
PROCEDURE QueryData( CONST Path1, Path2 : ARRAY OF WCHAR; Data : ADDRESS; Length : CARDINAL; REF Result : CResult );

PROCEDURE RegisterValidator( Data : ADDRESS; Length : CARDINAL; Validator : ADDRESS );
PROCEDURE UnregisterValidator( Data : ADDRESS );

PROCEDURE StoreInfo( CONST Path : ARRAY OF WCHAR; Data : ADDRESS; Length : CARDINAL; CONST InfoKey, InfoValue : StringsO.IString );

(*================================================================================*)

END lec.