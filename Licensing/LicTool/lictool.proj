<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType>Product</ComponentType>

        <ProductId>SmartControl.LicenceTool</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>
        <ProjectDescription>Licence Tool</ProjectDescription>
        <ProjectVersionMajor>1</ProjectVersionMajor>
        <ProjectVersionMinor>0</ProjectVersionMinor>

        <ProductVariant>Supervisor</ProductVariant><!-- Supervisor Builder Licensor Client -->
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <PropertyGroup>
        <ResultName Condition="$(ProductVariant)=='Supervisor'">lictool</ResultName>
        <ResultName Condition="$(ProductVariant)=='Builder'">licbuild</ResultName>
        <ResultName Condition="$(ProductVariant)=='Licensor'">licgen</ResultName>
        <ResultName Condition="$(ProductVariant)=='Client'">liccli</ResultName>
        <ResultName Condition="$(ProductVariant)=='Activator'">activate</ResultName>
    </PropertyGroup>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib"/>
        <Components Include="Modula2\m2rtl;Modula2\m2ortl;Licensing\Core"/>
        <Program Include="lictool"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>
    
</Project>
