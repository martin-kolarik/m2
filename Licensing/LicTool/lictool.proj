<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType>Product</ComponentType>

        <ProductId>SmartControl.LicenceTool</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>
        <FileDescription>Licence tool</FileDescription>
        <FileVersionMajor>1</FileVersionMajor>
        <FileVersionMinor>0</FileVersionMinor>

        <ProductVariant>Supervisor</ProductVariant><!-- Supervisor Builder Licensor Client -->
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib"/>
        <Components Include="Modula2\m2rtl;Modula2\m2ortl;Licensing\Core"/>
        <Program Include="lictool"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>
    
    <!-- 5 specials -->
    <PropertyGroup>
        <UserPostBuild>RenameTarget</UserPostBuild>
        <TargetName Condition="$(ProductVariant)=='Supervisor'">lictool.exe</TargetName>
        <TargetName Condition="$(ProductVariant)=='Builder'">licbuild.exe</TargetName>
        <TargetName Condition="$(ProductVariant)=='Licensor'">licgen.exe</TargetName>
        <TargetName Condition="$(ProductVariant)=='Client'">liccli.exe</TargetName>
    </PropertyGroup>

    <Target Name="RenameTarget"
            Inputs="$(OutputFile)"
            Outputs="$(OutputDir)\$(TargetName)">
        <Delete Files="$(OutputDir)\$(TargetName)" ContinueOnError="true"/>
        <Copy SourceFiles="$(OutputFile)" DestinationFiles="$(OutputDir)\$(TargetName)"/>
    </Target>

</Project>
