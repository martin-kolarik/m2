<Project
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <PropertyGroup>
        <Result>Program</Result>
        <LicenceMachineId>MD</LicenceMachineId>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName)!='lictool'">
        <Result>Static</Result>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName)=='sccore'">
        <ComponentType>Generic</ComponentType>
    </PropertyGroup>

    <PropertyGroup>
        <ProductM2Control Condition="$(ProductM2Control)==''">-DTarget:&quot;$(ProductVariant)&quot;</ProductM2Control>
        <ProductCLControl></ProductCLControl>
        <ProductRCControl></ProductRCControl>
        <ProductLNControl></ProductLNControl>
    </PropertyGroup>

</Project>
