DEFINITION MODULE ef82_def;

(*===========================================================================*)

PROCEDURE GetVSOP82Elements( jd : LONGREAL; planeta : CARDINAL;
                             VAR a, L, k, h, p, q : LONGREAL );

(*===========================================================================*)

(* zakladni rozvoje efemerid planet - VSOP82 (Bretagnon 1982),
   lehce korigovano podle VSOP87 (Bretagnon-Francou 1987,
   interni presnost chybovych rozvoju 1",
   chyba celkem 5"-10" Mer-Mar a 10"-20" u Jup-Nep
 *)

TYPE
  T3R            = ARRAY [0..2] OF LONGREAL;
  TOrbitElement  = RECORD;
                     a : T3R;
                     L : T3R;
                     k : T3R;
                     h : T3R;
                     q : T3R;
                     p : T3R;
                   END;
  TPlanetElement = RECORD
                     orbit : TOrbitElement;
                   END;
  TSolarSystem   = ARRAY [1..8] OF TPlanetElement;

