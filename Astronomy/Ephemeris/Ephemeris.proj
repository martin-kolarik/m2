<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ProjectDescription>Ephemeris of Sun system bodies</ProjectDescription>
        <ProjectVersionMajor>0</ProjectVersionMajor>
        <ProjectVersionMinor>9</ProjectVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\clib;Modula2\m2rtl"/>
        <Modules Include="ef82_def;efmo_def;efpl_def;astro;astro_p"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
