<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType>Product</ComponentType>
        <ProductVariant>Standard</ProductVariant><!-- Standard Lite (Full available in SmartServer 2.0 only) -->

        <ProductGUID>2E913ED6-D3C0-427D-B3B2-1D7AC3CFE725</ProductGUID>
        <ProductUpgradeGUID>67E4985B-93E9-43ED-8B7E-5D381F094F5D</ProductUpgradeGUID>

        <ProductId>NeNo.EibSrv</ProductId>
        <ProductNote>Stable</ProductNote>
        <!-- DynamicCLibInstallMethod>Shared</DynamicCLibInstallMethod -->

        <FileDisplayName>EIB/KNX Server</FileDisplayName>
        <FileDescription>EIB/KNX SmartServer</FileDescription>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
        <BuildVersionSource Include="$(RootPath)\Component\sccore;$(RootPath)\EIB\eibnetstack;$(RootPath)\EIB\srvsvc;$(RootPath)\EIB\EibSrvWeb;$(RootPath)\EIB\SmartServer"/>

        <Components Include="Component\sccore;Component\scmvc;EIB\srvsvc;EIB\checkcfg;EIB\discover;Licensing\LicTool;Tools\svcinst"/>
    </ItemGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
