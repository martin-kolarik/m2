<Project
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <PropertyGroup>
        <Manufacturer>NeNo</Manufacturer>

        <PlatformName Condition="$(PlatformName)==''">Win32</PlatformName>
        <ConfigurationName Condition="$(ConfigurationName)==''">Debug</ConfigurationName>
        <LanguageStyle Condition="$(LanguageStyle)==''">UNICODE</LanguageStyle>
        <Language Condition="$(Language)==''">Czech</Language>
        <CLib>Private</CLib>
        <SetupLicensing>on</SetupLicensing>
        <LeakChecking>off</LeakChecking>

        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>2</ProductVersionMinor>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName)=='svcsrv' Or $(MSBuildProjectName)=='checkcfg' Or $(MSBuildProjectName)=='discover' Or $(MSBuildProjectName)=='LicTool'">
        <Result>Program</Result>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName)=='LicTool'">
        <ProductVariant>Activator</ProductVariant>
    </PropertyGroup>

    <PropertyGroup>
        <!-- ProductM2Control Condition="$(MSBuildProjectName)=='LicTool'">-DTarget:"Client"</ProductM2Control -->
        <ProductCLControl></ProductCLControl>
        <ProductRCControl></ProductRCControl>
        <ProductLNControl></ProductLNControl>
    </PropertyGroup>

</Project>
