<?xml version="1.0" encoding="utf-8"?>
<pageTemplate xmlns:pt="http://www.smartcontrol.cz/2008/XML/Web/PageTemplate">
  <html xmlns="http://www.w3.org/1999/xhtml">
      <head>
          <title>NeNo KNX/EIBSrv</title>
          <link rel="StyleSheet" type="text/css" href="NeNo.css" />
      </head>
      <body>
          <div class="shell">
              <div class="shell-topstrip"></div>
              <div class="canvas">

                  <div class="top">
                  </div>

                  <div class="middle">
                      <div id="menu">
                          <p>${msg.menu.status}</p>
                          <p pt:condition="${isAdmin}"><a href="control">${msg.menu.control}</a></p>
                          <p><a href="datalog">${msg.menu.datalog}</a></p>
                          <p pt:condition="${isAdmin}"><a href="syslog">${msg.menu.syslog}</a></p>
                          <p><a href="io">${msg.menu.io}</a></p>
                          <p> </p>
                          <p class="logout"><a href="logout">${msg.menu.logout}</a></p>
                      </div>

                      <div class="content">

                        <h1>${msg.status.server}</h1>
                        <table cellpadding="0px" cellspacing="0px">
                          <tr>
                            <td>${msg.status.Project}</td><td class="spare"> </td><td>${project}</td>
                          </tr>
                          <tr>
                            <td>${msg.status.EIBconnection}</td><td class="spare"> </td>
                            <pt:choose>
                              <pt:when condition="${connected}">
                                <td><span class="green">${connection}, ${msg.status.connectedFrom}${connectionTime}</span>
                                    <span pt:condition="${isAdmin}"><a href="?disconnect=true"><span class="red">[${msg.status.disconnect}]</span></a></span></td>
                              </pt:when>
                              <pt:otherwise>
                                <td><span class="red">${msg.status.notConnectedFrom}${connectionTime}</span>
                                    <span pt:condition="${isAdmin}"><a href="?connect=true"><span class="green">[${msg.status.connect}]</span></a></span></td>
                              </pt:otherwise>
                            </pt:choose>
                          </tr>
                          <tr>
                            <td>${msg.status.uptime}</td><td class="spare"> </td><td>${uptime}</td>
                          </tr>
                          <tr>
                            <td>${msg.status.configuration}</td><td class="spare"> </td><td>${configurationPath}</td>
                          </tr>
                          <tr>
                            <td>${msg.status.licence}</td><td class="spare"> </td>
                            <td><pt:choose>
                              <pt:when condition="${licenceValid}"><span class="green">${licence}</span></pt:when>
                              <pt:otherwise><span class="red">${licence}</span></pt:otherwise>
                            </pt:choose></td>
                          </tr>
                          <tr>
                            <td> </td><td class="spare"> </td><td>${licenceType} ${licenceNumber}</td>
                          </tr>
                        </table>

                        <h1>${msg.status.communication}</h1>
                        <table cellpadding="0px" cellspacing="0px">
                          <tr>
                            <td>${msg.status.lasthour}</td><td class="spare"> </td><td>${ioLastHour}</td>
                          </tr>
                          <tr>
                            <td>${msg.status.lastday}</td><td class="spare"> </td><td>${ioLastDay}</td>
                          </tr>
                        </table>

                      </div>
                  </div>

                  <div class="bottom">
                    <p>EIB/KNX SmartServer © NeNo ver. ${version}</p>
                  </div>

              </div>
          </div>
      </body>
  </html>
</pageTemplate>
