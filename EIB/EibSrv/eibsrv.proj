<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType>Product</ComponentType>
        <Manufacturer>NeNo</Manufacturer>

        <ProductUpgradeGUID>67E4985B-93E9-43ED-8B7E-5D381F094F5D</ProductUpgradeGUID>

        <ProductId>NeNo.EibSrv</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>
        <ProductNote></ProductNote>
        <!-- DynamicCLibInstallMethod>Shared</DynamicCLibInstallMethod -->

        <FileDisplayName>EIB/KNX Server</FileDisplayName>
        <FileDescription>EIB/KNX group object server</FileDescription>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
        <Components Include="EIB\srvsvc;EIB\checkcfg;EIB\discover"/>
    </ItemGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
