<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE pageTemplate [
    <!ENTITY nbsp "&amp;nbsp;">
    <!ENTITY copy "&amp;copy;">
]>
<pageTemplate xmlns:pt="http://www.smartcontrol.cz/2008/XML/Web/PageTemplate">
  <html>
      <head>
          <title>NeNo KNX/EIBSrv</title>
          <link rel="StyleSheet" type="text/css" href="NeNo.css" />
      </head>
      <body>
          <div class="shell">
              <div class="shell-topstrip"></div>
              <div class="canvas">

                  <div class="top">
                  </div>

                  <div class="middle">
                      <div id="menu">
                          <p><a href="status">${msg.menu.status}</a></p>
                          <p pt:condition="${isAdmin}"><a href="control">${msg.menu.control}</a></p>
                          <p>${msg.menu.datalog}</p>
                          <p pt:condition="${isAdmin}"><a href="syslog">${msg.menu.syslog}</a></p>
                          <p><a href="io">${msg.menu.io}</a></p>
                          <p>&nbsp;</p>
                          <p class="logout"><a href="logout">${msg.menu.logout}</a></p>
                      </div>

                      <div class="content">

                        <h1>${msg.datalog.title}</h1>
                        <div class="longlog"><pre class="longlog">${logRecords}</pre></div>

                      </div>
                  </div>

                  <div class="bottom">
                    <p>EIB/KNX SmartServer &copy; NeNo</p>
                  </div>

              </div>
          </div>
      </body>
  </html>
</pageTemplate>