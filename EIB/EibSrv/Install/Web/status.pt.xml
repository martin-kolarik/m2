<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE pageTemplate [
    <!ENTITY nbsp "&amp;nbsp;">
    <!ENTITY copy "&amp;copy;">
]>
<pageTemplate xmlns:pt="http://www.smartcontrol.cz/2008/XML/Web/PageTemplate">
  <html>
      <head>
          <title>NeNo KNX/EIBSrv</title>
          <link rel="StyleSheet" type="text/css" href="NeNo.css" />
      </head>
      <body>
          <div class="shell">
              <div class="shell-topstrip"></div>
              <div class="canvas">

                  <div class="top">
                  </div>

                  <div class="middle">
                      <div id="menu">
                          <p>${msg.menu.status}</p>
                          <p><a href="control">${msg.menu.control}</a></p>
                          <p><a href="log">${msg.menu.log}</a></p>
                          <p><a href="io">${msg.menu.io}</a></p>
                      </div>

                      <div class="content">

                        <h1>${msg.status.server}</h1>
                        <table cellpadding="0px" cellspacing="0px">
                          <tr>
                            <td>${msg.status.EIBconnection}</td><td class="spare">&nbsp;</td>
                            <pt:choose>
                              <pt:when condition="${connected}">
                                <td><span class="green">${msg.status.connectedFrom}${connectionTime}</span></td>
                                <td class="spare">&nbsp;</td>
                                <td><a href="?disconnect=true"><span class="red">[${msg.status.disconnect}]</span></a></td>
                              </pt:when>
                              <pt:otherwise>
                                <td><span class="red">${msg.status.notConnectedFrom}${connectionTime}</span></td>
                                <td class="spare">&nbsp;</td>
                                <td><a href="?connect=true"><span class="green">[${msg.status.connect}]</span></a></td>
                              </pt:otherwise>
                            </pt:choose>
                          </tr>
                          <tr>
                            <td>${msg.status.uptime}</td><td class="spare">&nbsp;</td><td>${uptime}</td>
                          <tr>
                          </tr>
                            <td>${msg.status.configuration}</td><td class="spare">&nbsp;</td><td>${configurationPath}</td>
                          <tr>
                          </tr>
                            <td>${msg.status.licence}</td><td class="spare">&nbsp;</td>
                            <td><pt:choose>
                              <pt:when condition="${licenceValid}"><span class="green">${licence}</span></pt:when>
                              <pt:otherwise><span class="red">${licence}</span></pt:otherwise>
                            </pt:choose></td>
                          </tr>
                        </table>

                        <h1>${msg.status.communication}</h1>
                        <table cellpadding="0px" cellspacing="0px">
                          <tr>
                            <td>${msg.status.lasthour}</td><td class="spare">&nbsp;</td><td>${ioLastHour}</td>
                          </tr>
                          <tr>
                            <td>${msg.status.lastday}</td><td class="spare">&nbsp;</td><td>${ioLastDay}</td>
                          </tr>
                        </table>

                      </div>
                  </div>

                  <div class="bottom">
                    <p>EIB/KNX SmartServer &copy; NeNo</p>
                  </div>

              </div>
          </div>
      </body>
  </html>
</pageTemplate>