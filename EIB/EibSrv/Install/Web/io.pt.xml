<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE pageTemplate [
    <!ENTITY nbsp "&amp;nbsp;">
    <!ENTITY copy "&amp;copy;">
]>
<pageTemplate xmlns:pt="http://www.smartcontrol.cz/2008/XML/Web/PageTemplate">
  <html>
      <head>
          <title>NeNo KNX/EIBSrv</title>
          <link rel="StyleSheet" type="text/css" href="NeNo.css" />
      </head>
      <body>
          <div class="shell">
              <div class="shell-topstrip"></div>
              <div class="canvas">

                  <div class="top">
                  </div>

                  <div class="middle">
                      <div id="menu">
                          <p><a href="status">${msg.menu.status}</a></p>
                          <p><a href="datalog">${msg.menu.control}</a></p>
                          <p><a href="datalog">${msg.menu.datalog}</a></p>
                          <p><a href="syslog">${msg.menu.syslog}</a></p>
                          <p>${msg.menu.io}</p>
                      </div>

                      <div class="content">

                        <h1>${msg.io.read}</h1>
                        <pt:form  method="post" action="io">
                          <pt:formid model="formId" formid="read"/>
                          <pt:input model="readName"/> <input type="submit" value="${msg.io.doRead}"/>
                          ${readValue}
                        </pt:form>

                        <h1>${msg.io.write}</h1>
                        <pt:form  method="post" action="io">
                          <pt:formid model="formId" formid="write"/>
                          <pt:input model="writeName"/> <pt:input model="writeValue"/> <input type="submit" value="${msg.io.doWrite}"/>
                          ${writeStatus}
                        </pt:form>

                      </div>
                  </div>

                  <div class="bottom">
                    <p>EIB/KNX SmartServer &copy; NeNo</p>
                  </div>

              </div>
          </div>
      </body>
  </html>
</pageTemplate>