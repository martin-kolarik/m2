DEFINITION MODULE srvcore;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   arrays,
   device,
   eib_def,
   eib_stack,
   eib_status,
   eib_user,
   io,
   iobject,
   iovalue,
   lec,
   list,
   lists,
   log,
   msghandler,
   ns,
   Resources,
   StringsO;

//================================================================================

TYPE
   TPEIBServer = POINTER TO CEIBServer;
   TPObject = POINTER TO CObject;

//--------------------------------------------------------------------------------

CLASS CObject( eib_user.CUserObject );
   Server             : TPEIBServer;

   Name               : StringsO.CString;
   Comment            : StringsO.CString;

   RSStatus           : eib_status.TEIBStackStatus;
   WSStatus           : eib_status.TEIBStackStatus;
   ReadRepeatCount    : CARDINAL;
   RecoveryExpiration : CARDINAL;

   PUBLIC PROCEDURE LogNumber() : CARDINAL;

   // rewritten due to locking
   INTERNAL VIRTUAL PROCEDURE Lock();
   INTERNAL VIRTUAL PROCEDURE Unlock();

   // handling events, NOT synchronized, if there is a need (e.g. if synchronized helper is not called) accessing object data inside MUST be synchronized
   INTERNAL VIRTUAL PROCEDURE ValueReadRequestSent( Status : eib_status.TEIBStackStatus; CurrentState : eib_user.TObjectState );
   INTERNAL VIRTUAL PROCEDURE ValueRead( Status : eib_status.TEIBStackStatus; CurrentState : eib_user.TObjectState; CurrentInitReadState : eib_user.TInitReadState );
   INTERNAL VIRTUAL PROCEDURE ValueUpdated( Status : eib_status.TEIBStackStatus; CurrentState : eib_user.TObjectState );
   INTERNAL VIRTUAL PROCEDURE ValueWritten( Status : eib_status.TEIBStackStatus; CurrentState : eib_user.TObjectState );
END CObject;

//--------------------------------------------------------------------------------

CLASS CStackSink IMPLEMENTS eib_stack.IEIBStackEventSink;
   Server : TPEIBServer;
   PUBLIC VIRTUAL PROCEDURE OnDeviceConnected();
   PUBLIC VIRTUAL PROCEDURE OnDeviceDisconnected();
END CStackSink;

//--------------------------------------------------------------------------------

TYPE
   TPPromiscuousData = POINTER TO PromiscuousData;

CLASS PromiscuousData;
   Address : eib_def.CAddress;
   Value   : eib_def.CValue;
END PromiscuousData;

//--------------------------------------------------------------------------------

TYPE
   TStack = (
      stackUnknown,
      stackUSB,
      stackFalcon,
      stackEIBNet
   );

   TRStatusItem = (
      rsRunning,
      rsInitReadPending,
      rsInitReadRepeat,
      rsInitReadFinished,
      rsProcessingOOB,
      rsEnumeratingObject,
      rsPromiscuousInQueue,
      rsEXEFlag
   );
   TRStatus = SET OF TRStatusItem;

   TReadParameters = RECORD
                        Timeout      : CARDINAL;
                        RepeatCount  : CARDINAL;
                        Delay        : CARDINAL;
                        RecoveryTime : CARDINAL;
                     END;

TYPE
   TPEIBServerSink = POINTER TO IEIBServerSink;
   
INTERFACE IEIBServerSink;
   PROCEDURE OnConnect();
   PROCEDURE OnDisconnect();
   PROCEDURE OnInitReadCompleted();
   PROCEDURE OnRead( PObject : TPObject );
   PROCEDURE OnWritten( PObject : TPObject );
   PROCEDURE OnInputQueueAdd( OOBQueue, PromiscuousQueue : BOOLEAN );
   PROCEDURE OnInputQueueOverflow( OOBQueue, PromiscuousQueue : BOOLEAN );
END IEIBServerSink;

CLASS CEIBServer( msghandler.MessageHandler ) IMPLEMENTS device.IDevice, ns.IMapper, io.IIO;
   RStatus                  : TRStatus;

   Stack                    : TStack;
   EIB                      : eib_stack.TPEIBStack;
   EIBBoundaryLock          : Sync.LOCK;
   Sink                     : CStackSink;
   EventSink                : TPEIBServerSink;
   Logger                   : log.CLogger;
   R                        : Resources.CResources;
   _Advise                  : io.TAdvise;
   _AdviseListener          : io.TPIAdviseInfo;

   Result                   : lec.CResult;
   cllvdata                 : ADDRESS;
   cllvlength               : CARDINAL;

   DeviceId                 : LONGWORD;
   PromiscuousMode          : BOOLEAN;

   InputQueueLength         : CARDINAL;
   Address                  : eib_def.CAddress;
   ACKTimeout               : CARDINAL;
   BUSYDelay                : CARDINAL;
   SendDelay                : CARDINAL;
   IgnoreRepeated           : BOOLEAN;
   WriteDelay               : CARDINAL;

   ReadOnStart              : TReadParameters;
   ReadDuringRun            : TReadParameters;
   InitReadRepeatDelay      : CARDINAL;
   InitReadRepeatCount      : CARDINAL;

   Behaviours               : list.CList;

   ObjectLock               : Sync.LOCK;
   Groups                   : ARRAY CARD16 OF CARD16; // maps group addresses to object indexes
   Objects                  : arrays.CPtrArray;
   prObjects                : ARRAY eib_def.TEIBType OF CObject; // promiscuous objects

   InitReadItems            : CARDINAL;
   InitReadRepeat           : CARDINAL;

   QueueLock                : Sync.LOCK;
   // OOB management
   oobData                  : lists.CBufferList;
   // promiscuous data management
   prData                   : lists.CBufferList;

   PUBLIC READONLY PROPERTY
     PResult                : POINTER TO lec.CResult;
   PUBLIC WRITEONLY PROPERTY
     cllvData               : ADDRESS;
     cllvLength             : CARDINAL;
   PUBLIC PROPERTY
     EXEFlag                : BOOLEAN;

   // inherited
   INTERNAL VIRTUAL PROCEDURE OnTimer( TimerId : PTR );

   // IObject
   PUBLIC VIRTUAL READONLY PROPERTY
      Type : iobject.TObjectType;
   PUBLIC VIRTUAL PROPERTY
      Library : iobject.TPLibrary;
   PUBLIC VIRTUAL PROCEDURE OnDispose(); // here meant also as a Command

   // IDevice
   PUBLIC VIRTUAL READONLY PROPERTY
      DeviceCapabilities : device.TCapabilities;
	PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult;
	PUBLIC VIRTUAL PROCEDURE Mapper() : ns.TPMapper;
	PUBLIC VIRTUAL PROCEDURE NS() : ns.TPns;
	PUBLIC VIRTUAL PROCEDURE IO() : io.TPIO;

   // IMapper
   PUBLIC VIRTUAL PROCEDURE NameToHash( CONST Name : StringsO.IString; OUT Hash : ns.THash ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE HashToName( CONST Hash : ns.THash; OUT Name : StringsO.IString ) : BOOLEAN;
	
	// IIO
   PUBLIC VIRTUAL READONLY PROPERTY
      IOCapabilities : io.TCapabilities;
      Pending : BOOLEAN;
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROPERTY
      Advise : io.TAdvise;
      AdviseListener : io.TPIAdviseInfo;

   PUBLIC VIRTUAL PROCEDURE Run() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();

   PUBLIC VIRTUAL PROCEDURE IOh( Direction : IOO.TDirection; Item : ns.THash; REF Value : iovalue.Value; Callback : io.TPDataInfo ) : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE IOha( Direction : IOO.TDirection; Item : ARRAY OF ns.THash; REF Value : ARRAY OF iovalue.Value; Callback : io.TPDataInfo ) : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE AbortAll();

   // self
   PUBLIC PROCEDURE LoadConfiguration( CONST ConfigurationFile : StringsO.IString; OUT ErrorMessage : StringsO.CString; OUT ErrorLine : CARDINAL ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Dispose();

   PUBLIC PROCEDURE OnDeviceConnect();
   PUBLIC PROCEDURE OnDeviceDisconnect();
   
   PUBLIC PROCEDURE GetObject( CONST Address : eib_def.TAddress; OUT PObject : TPObject ) : BOOLEAN;
   
   // internal
   PROCEDURE FindBehaviour( BehaviourName : ARRAY OF WCHAR; VAR Priority : eib_def.TPriority; VAR Flags : eib_def.TA_ObjectFlags ) : BOOLEAN;
   PROCEDURE AddObject( Class : eib_def.TPriority; Flags : eib_def.TA_ObjectFlags; Type : eib_def.TEIBType ) : TPObject;
   PROCEDURE DoneObjects( NILExecutive : BOOLEAN );

   // object callbacks
   LOCAL PROCEDURE ValueReadRequestSent( PObject : TPObject; CurrentState : eib_user.TObjectState ); // ObjectState is a synchronous copy
   LOCAL PROCEDURE ValueRead( PObject : TPObject; CurrentState : eib_user.TObjectState; CurrentInitReadState : eib_user.TInitReadState ); // dtto
   LOCAL PROCEDURE ValueUpdated( PObject : TPObject; CurrentState : eib_user.TObjectState ); // dtto
   LOCAL PROCEDURE ValueWritten( PObject : TPObject; CurrentState : eib_user.TObjectState ); // dtto

   // helpers
   PROCEDURE DoInitRead( RepeatFlag : BOOLEAN );
   PROCEDURE InitToDefault();
   PROCEDURE InitReadFinished();
   
   LOCAL PROCEDURE LockObjects();
   LOCAL PROCEDURE UnlockObjects();

   LOCAL PROCEDURE IOValue2EIBValue( CONST Value : iovalue.Value; DestEVType : eib_def.TEIBType; OUT EV : eib_def.TValue );
   LOCAL PROCEDURE EIBValue2IOValue( CONST EV : eib_def.TValue; OUT Value : iovalue.Value );
END CEIBServer;

//================================================================================

END srvcore.