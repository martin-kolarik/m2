<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <ProductGUID>D207A286-98FA-420f-917F-F3AF8E9C43FB</ProductGUID>
        <ProductUpgradeGUID>8AC5313F-C205-4eab-90AE-3BB039D7CE65</ProductUpgradeGUID>

        <ProductFlag>on</ProductFlag>
        <ProductId>SmartControl.EibDiscovery</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>
        <ProductNote></ProductNote>
        <DynamicCLibInstallMethod>Shared</DynamicCLibInstallMethod>

        <FileDisplayName>EIB/KNX EIBNet/IP discoverer</FileDisplayName>
        <FileDescription>SmartControl EIB/KNX EIBNet/IP device discover tool</FileDescription>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
        <Components Include="modula2\modula2;api\clib;API\win32"/>
        <Components Include="component\sccore;EIB\srvcore"/>
        <Messages Include="Texts"/>
        <Program Include="discover"/>
    </ItemGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
