DEFINITION MODULE EibSrvWeb;

(*================================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   INIfile,
   io,
   Log,
   mvc,
   srvcore,
   StringsO,
   threadcall,
   time;

(*--------------------------------------------------------------------------------*)

TYPE
   TRole = (
      roleAdministrator,
      roleUser,
      roleGuest
   );

TYPE
   TPEibSrvWeb = POINTER TO CEibSrvWeb;

CLASS CEibSrvWeb IMPLEMENTS srvcore.IEIBServerSink, threadcall.IThreadProcedureCallTarget;

   // IEIBServerSink
   PUBLIC VIRTUAL PROCEDURE OnConnect();
   PUBLIC VIRTUAL PROCEDURE OnDisconnect();
   PUBLIC VIRTUAL PROCEDURE OnInitReadCompleted();
   PUBLIC VIRTUAL PROCEDURE OnRead( PObject : srvcore.TPObject );
   PUBLIC VIRTUAL PROCEDURE OnWritten( PObject : srvcore.TPObject );
   PUBLIC VIRTUAL PROCEDURE OnInputQueueAdd( OOBQueue, PromiscuousQueue : BOOLEAN );
   PUBLIC VIRTUAL PROCEDURE OnInputQueueOverflow( OOBQueue, PromiscuousQueue : BOOLEAN );
   
   // IThreadProcedureCallTarget
   PUBLIC VIRTUAL PROCEDURE Invoke( Operation : CARDINAL; CONST Parameters : ARRAY OF PTR ) : PTR;

   // Client interface
   PUBLIC READONLY PROPERTY
      RootDir : StringsO.TPString;
      Configuration : StringsO.TPString;
      Connected : BOOLEAN;
      StartedTime : time.TJD;
      ConnectedTime : time.TJDC;
      DisconnectedTime : time.TJD;
      LicenceExpires : time.TDateTime;
      WrittenByHour : CARDINAL;
      WrittenByDay : CARDINAL;
      ReadByHour : CARDINAL;
      ReadByDay : CARDINAL;
      OperatedDeviceCount : CARDINAL;
      ConfigLogger : Log.TPLogger;
      DataLogger : Log.TPLogger;
      
   PUBLIC PROCEDURE ConnectEIB();
   PUBLIC PROCEDURE DisconnectEIB();
   PUBLIC PROCEDURE ConfigureEIB( CONST ConfigFilePath : StringsO.CString );
   
   PUBLIC PROCEDURE OperatedDeviceName( index : CARDINAL ) : PWCHAR;
   PUBLIC PROCEDURE OperateDevice( index : CARDINAL; StartNotStop : BOOLEAN );
   PUBLIC PROCEDURE DeviceRunning( index : CARDINAL ) : BOOLEAN;
   
   PUBLIC PROCEDURE SetValue( CONST name, value : StringsO.IString ) : BOOLEAN;
   PUBLIC PROCEDURE GetValue( CONST name : StringsO.IString; OUT value : StringsO.IString ) : BOOLEAN;
   
   PUBLIC PROCEDURE Authenticate( CONST Name, Password : StringsO.IString ) : TRole;
   
   // SELF
   PRIVATE VAR
      _Context : StringsO.CString;
      _RootDir : StringsO.CString;
      _MessageFile : StringsO.CString;
      _EIB : srvcore.TPEIBServer;
      _MVC : mvc.TPMVC;
      _Port : CARDINAL;
      _Running : BOOLEAN;
      _Controller : mvc.TPController;
      _DeviceCount : CARDINAL;
      _DeviceNames : POINTER TO ARRAY [0..0] OF PWCHAR;
      _Devices : POINTER TO ARRAY [0..0] OF io.TPIStartStopControl;
      _ConfigLogger : Log.TPLogger;
      _DataLogger : Log.TPLogger;
      _Users : lists.CStringStringList;
      _Lock : Sync.RWLOCK;
      
      _StartedTime : time.TJD;
      _Connected : BOOLEAN;
      _ConnectedTime : time.TJD;
      _DisconnectedTime : time.TJD;
      _WrittenByHour : ARRAY [0..23] OF CARDINAL;
      _GotByHour : ARRAY [0..23] OF CARDINAL;

   PUBLIC PROCEDURE Init( Port : CARDINAL; CONST ContextName : ARRAY OF WCHAR; CONST cfg : INIfile.CINIFile; EIB : srvcore.TPEIBServer; DeviceNames : ARRAY OF PWCHAR; Devices : ARRAY OF io.TPIStartStopControl; ConfigLogger, DataLogger : Log.TPLogger ) : BOOLEAN;
   
   PUBLIC READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC PROCEDURE Run();
   PUBLIC PROCEDURE Stop();
   
   // PRIVATE
   PRIVATE PROCEDURE AddControllers();
   PRIVATE PROCEDURE RemoveControllers();

END CEibSrvWeb;

(*================================================================================*)

END EibSrvWeb.