<?xml version="1.0" encoding="utf-8"?>
<pageTemplate xmlns:pt="http://www.smartcontrol.cz/2008/XML/Web/PageTemplate">

<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <title>table.pt.xml</title>
  </head>
  <body>
    <h1>Light status</h1>
    
    <table>
        <tr><th>Number</th><th>State</th><th>Brightness</th></tr>
        <pt:for from="30" to="39" index="index" order="order" odd="odd">
            <pt:variable model="status" source="3/0/${index}" />
            <pt:variable model="brightness" source="3/3/${index}" />
            <pt:variable model="kopka">kl <!-- --></pt:variable>
            <tr><td>${odd}</td><td>${order}</td><td>${index}</td><td>${get(status)}</td><td>${get(brightness)}</td><td>${kopka}</td><td>
                <span pt:condition="${equal(35,index)}">rovno 35, </span>
                <span pt:condition="${notEqual(35,index)}">nerovno 35, </span>
                <span pt:condition="${less(35,index)}">menší 35, </span>
                <span pt:condition="${lessEqual(35,index)}">menší nebo rovno 35, </span>
                <span pt:condition="${greater(35,index)}">vetší 35, </span>
                <span pt:condition="${greaterEqual(35,index)}">větší nebo rovno 35, </span>
            </td></tr>
        </pt:for>
    </table>

    <p>
       <span pt:condition="${equal(Čivava,čivava)}">rovno, </span>
       <span pt:condition="${notEqual(Čivava,čivava)}">nerovno, </span>
       <span pt:condition="${less(Čivava,čivava)}">menší, </span>
       <span pt:condition="${lessEqual(Čivava,čivava)}">menší nebo rovno, </span>
       <span pt:condition="${greater(Čivava,čivava)}">vetší, </span>
       <span pt:condition="${greaterEqual(Čivava,čivava)}">větší nebo rovno, </span>
       <br/>

       <span pt:condition="${equal(Čivava,Ďábel)}">rovno, </span>
       <span pt:condition="${notEqual(Čivava,Ďábel)}">nerovno, </span>
       <span pt:condition="${less(Čivava,Ďábel)}">menší, </span>
       <span pt:condition="${lessEqual(Čivava,Ďábel)}">menší nebo rovno, </span>
       <span pt:condition="${greater(Čivava,Ďábel)}">vetší, </span>
       <span pt:condition="${greaterEqual(Čivava,Ďábel)}">větší nebo rovno, </span>
       <br/>

       <span pt:condition="${equal(čivava,čivava)}">rovno, </span>
       <span pt:condition="${notEqual(čivava,čivava)}">nerovno, </span>
       <span pt:condition="${less(čivava,čivava)}">menší, </span>
       <span pt:condition="${lessEqual(čivava,čivava)}">menší nebo rovno, </span>
       <span pt:condition="${greater(čivava,čivava)}">vetší, </span>
       <span pt:condition="${greaterEqual(čivava,čivava)}">větší nebo rovno, </span>

    </p>

  </body>
</html>

</pageTemplate>
