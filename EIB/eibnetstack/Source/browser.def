DEFINITION MODULE browser;

(*================================================================================*)

IMPORT
   winsock; // must be the first

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   core,
   Delegate,
   eibnet,
   StringsO,
   Sync;

(*================================================================================*)

TYPE
   TPServer = POINTER TO CServer;

CLASS CServer;
   PUBLIC VAR
      HPAI            : core.HostProtocolAddressInformation;
      Description     : StringsO.CString;
      ServiceFamilies : core.TServiceFamilies;
      MAC             : StringsO.CString;
      Address         : winsock.IN_ADDR;
      Port            : CARDINAL := core.EIBNET_IPPORT;
      RoutingAddress  : winsock.IN_ADDR;
END CServer;

(*--------------------------------------------------------------------------------*)

TYPE
   TPBrowserDelegate = POINTER TO CBrowserDelegate;

ABSTRACT CLASS CBrowserDelegate( Delegate.ADelegate );
   LOCAL ABSTRACT PROCEDURE OnCompleted( Result : Sync.TAsyncResult; CONST Servers : arrays.CPtrArray );
END CBrowserDelegate;

(*--------------------------------------------------------------------------------*)

CLASS CBrowser( eibnet.CConnection );
   PRIVATE VAR
      Delegate : TPBrowserDelegate;
      Servers  : arrays.CPtrArray;

   PUBLIC PROCEDURE Browse( Delegate : TPBrowserDelegate; Timeout : CARDINAL ) : Sync.TAsyncResult; // if Timeout = 0 then the default one is used

   INTERNAL VIRTUAL PROCEDURE OnScanCompleted();
   INTERNAL VIRTUAL PROCEDURE OnSearchResponse( CONST packet : core.SearchResponse );

   PRIVATE PROCEDURE DisposeServers();
END CBrowser;

(*================================================================================*)

END browser.