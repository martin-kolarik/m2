<?xml version="1.0" encoding="utf-8"?>
<resources>
    <strings version="1.0">

        <string name="_DriverName">
            <item lang="en-US">SmartControl EIB/KNX Group Object Server</item>
            <item lang="cs-CZ">SmartControl EIB/KNX Group Object Server</item>
        </string>

        <string name="_LicenceNotFound">
            <item lang="en-US">Licence information not found</item>
            <item lang="cs-CZ">Nenalezena informace o licenci</item>
        </string>
        <string name="_InitError">
            <item lang="en-US">Initialization failed</item>
            <item lang="cs-CZ">Chyba inicializace ovladače</item>
        </string>

        <comment>error code texts</comment>
        <string name="_E_DeviceUnplugged">
            <item lang="en-US">Device unplugged (check device power, USB cable and id paremeter of PAR file)</item>
            <item lang="cs-CZ">Zařízení odpojeno (prověřte napájení, USB kabel a parametr id v PAR souboru)</item>
        </string>
        <string name="_E_NoEIBConnection">
            <item lang="en-US">Device is not connected to EIB (check EIB mounting)</item>
            <item lang="cs-CZ">Zařízení není připojeno k EIB (prověřte zapojení EIB)</item>
        </string>
        <string name="_E_BUSMONActive">
            <item lang="en-US">Operation aborted, BUSMON mode is active</item>
            <item lang="cs-CZ">Operace ukončena, BUSMON režim je aktivní</item>
        </string>
        <string name="_E_LCONError">
            <item lang="en-US">Operation aborted, it was not ACKed</item>
            <item lang="cs-CZ">Operace ukončena, chyba potvrzení (ACK)</item>
        </string>
        <string name="_E_RD_RES_Timeout">
            <item lang="en-US">Operation aborted, readed device did not respond</item>
            <item lang="cs-CZ">Operace ukončena, čtené zařízení neodpovědělo</item>
        </string>
        <string name="_E_LineBusy">
            <item lang="en-US">Operation aborted, EIB is busy</item>
            <item lang="cs-CZ">Operace ukončena, EIB je zaneprázdněna</item>
        </string>
        <string name="_E_TransceiverFault">
            <item lang="en-US">Operation aborted, transceiver is unable to send data</item>
            <item lang="cs-CZ">Operace ukončena, vysílač není schopen vyslat data</item>
        </string>
        <string name="_E_OutputQueueOverflow">
            <item lang="en-US">Data cannot be sent, output queue length has reached the limit</item>
            <item lang="cs-CZ">Data nelze odeslat, délka výstupní fronty dosáhla limitu</item>
        </string>
        <string name="_E_ReadQueueOverflow">
            <item lang="en-US">Data cannot be sent, read request queue length has reached the limit</item>
            <item lang="cs-CZ">Data nelze odeslat, délka fronty požadavků na čtení dosáhla limitu</item>
        </string>
        <string name="_E_WriteQueueOverflow">
            <item lang="en-US">Data cannot be sent, write request queue length has reached the limit</item>
            <item lang="cs-CZ">Data nelze odeslat, délka fronty požadavků k zápisu dosáhla limitu</item>
        </string>

        <comment>PAR errors</comment>
        <string name="_CannotOpenPar">
            <item lang="en-US">Error during opening configuration file</item>
            <item lang="cs-CZ">Chyba při otevření konfiguračního souboru</item>
        </string>
        <string name="_BadConnection">
            <item lang="en-US">Bad connection definition</item>
            <item lang="cs-CZ">Chybný zápis definice spojení</item>
        </string>
        <string name="_UnsupportedStack">
            <item lang="en-US">Unsupported stack</item>
            <item lang="cs-CZ">Nepodporovaný způsob spojení s EIB</item>
        </string>
        <string name="_BadOrUndefinedDeviceId">
            <item lang="en-US">Bad or undefined id</item>
            <item lang="cs-CZ">Chybné nebo nedefinované id</item>
        </string>
        <string name="_BadPhysicalAddress">
            <item lang="en-US">Bad or badly typed physical address</item>
            <item lang="cs-CZ">Chybná nebo chybně zapsaná adresa zařízení</item>
        </string>
        <string name="_UnknownACKMethod">
            <item lang="en-US">Unknown ACK method</item>
            <item lang="cs-CZ">Neznámá metoda ACK</item>
        </string>
        <string name="_MissingBehaviourName">
            <item lang="en-US">Missing behaviour name</item>
            <item lang="cs-CZ">Chybí jméno chování</item>
        </string>
        <string name="_BadBehaviourItemName">
            <item lang="en-US">Bad behaviour item name</item>
            <item lang="cs-CZ">Neznámé jméno položky chování</item>
        </string>
        <string name="_UnknownBehaviour">
            <item lang="en-US">Unknown behaviour name</item>
            <item lang="cs-CZ">Neznámé jméno chování</item>
        </string>
        <string name="_MissingType">
            <item lang="en-US">Missing data type</item>
            <item lang="cs-CZ">Chybí datový typ</item>
        </string>
        <string name="_UnknownType">
            <item lang="en-US">Unknown data type</item>
            <item lang="cs-CZ">Neznámý datový typ</item>
        </string>
        <string name="_MissingAddress">
            <item lang="en-US">Missing address</item>
            <item lang="cs-CZ">Chybí skupinová adresa</item>
        </string>
        <string name="_BadGroupAddress">
            <item lang="en-US">Bad group address</item>
            <item lang="cs-CZ">Chybná skupinová adresa</item>
        </string>
        <string name="_BadGroupAddressInterval">
            <item lang="en-US">Bad group address interval</item>
            <item lang="cs-CZ">Chybné rozmezí skupinových adres</item>
        </string>
        <string name="_RequestedBlockNotFound">
            <item lang="en-US">Defined block not found</item>
            <item lang="cs-CZ">Definovaný blok nebyl nalezen</item>
        </string>
        <string name="_CannotOpenESF">
            <item lang="en-US">ESF file is now found</item>
            <item lang="cs-CZ">ESF soubor nebyl nalezen</item>
        </string>
        <string name="_ESFMissingGroupField1">
            <item lang="en-US">Missing first field, group address</item>
            <item lang="cs-CZ">Chybí první položka, skupinová adresa</item>
        </string>
        <string name="_ESFMissingTypeField3">
            <item lang="en-US">Missing third field, type information</item>
            <item lang="cs-CZ">Chybí třetí položka, popis datového typu</item>
        </string>
        <string name="_ESFMissingPriorityField4">
            <item lang="en-US">Missing fourth field, priority</item>
            <item lang="cs-CZ">Chybí čtvrtá položka, priorita</item>
        </string>
        <string name="_BadTypeInfo">
            <item lang="en-US">Type information is bad or badly formatted</item>
            <item lang="cs-CZ">Datový typ je chybný nebo je chybně zapsán</item>
        </string>
        <string name="_BadESFPriority">
            <item lang="en-US">Unknown priority</item>
            <item lang="cs-CZ">Neznámá priorita</item>
        </string>
        <string name="_BlockWithoutType ">
            <item lang="en-US">Block does not contain data type</item>
            <item lang="cs-CZ">V bloku není určen datový typ</item>
        </string>
        <string name="_BlockWithoutBehaviour ">
            <item lang="en-US">Block does not contain behaviour</item>
            <item lang="cs-CZ">V bloku není určeno chování</item>
        </string>
        <string name="_UnknownFalconInterface">
            <item lang="en-US">Unknown Falcon interface</item>
            <item lang="cs-CZ">Neznámé Falcon rozhraní</item>
        </string>
        <string name="InitError_ParametersNotValidated">
            <item lang="cs-CZ">Komunikační zásobník se nepodařilo inicializovat.</item>
            <item lang="en-US">Communication stack initialization has failed.</item>
        </string>

        <comment>Descriptions</comment> 
        <string name="_StatusComment">
            <item lang="en-US">Status channel of the driver (information about connection and common actions)</item>
            <item lang="cs-CZ">Stavový kanál ovladače (informace o komunikaci a obecných akcích)</item>
        </string>
        <string name="_InputQueueLengthComment">
            <item lang="en-US">Length of queue of packets received from the bus without being requested</item>
            <item lang="cs-CZ">Počet paketů přijatých ze sběrnice bez požadavku na jejich čtení</item>
        </string>
        <string name="_OutputQueueLengthComment">
            <item lang="en-US">Length of queue of packets waiting to be written into the bus</item>
            <item lang="cs-CZ">Počet paketů čekajících na zápis do sběrnice</item>
        </string>
        <string name="_WriteQueueLengthComment">
            <item lang="en-US">Length of queue of group-write-packets waiting prepared for transmit due to non zero write delay (write_delay parameter)</item>
            <item lang="cs-CZ">Počet paketů zápisu do skupiny čekajících na odeslání kvůli nenulové prodlevě zápisu do skupiny (write_delay parameter)</item>
        </string>
    
   </strings>
</resources>
