DEFINITION MODULE EquithermicCurve;

IMPORT
   adviser,
   device,
   iovalue,
   log,
   ns,
   Resources,
   Sync;

FROM Storage IMPORT
  ALLOCATE, DEALLOCATE;

(*# call( o_a_copy => off ) *)

(*================================================================================*)

TYPE
   TPCurve = POINTER TO CCurve;

CLASS CEquithermicCurveFunction IMPLEMENTS io.IStartStopControl, io.IAdviseInfo;

   // IStartStopControl
   PUBLIC VIRTUAL READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();
   
   // IAdviseInfo
   PUBLIC VIRTUAL PROCEDURE OnAdvise( Source : io.TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST Value : ARRAY OF iovalue.Value );

   // SELF
   PUBLIC PROPERTY
      Device : adviser.TPAdvisedDevice; // setting Device requires calling Configure to follow
      Logger : log.TPILogger;
      
   PUBLIC PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult; // accepts citINIFile or citINIFileSection
   PUBLIC VIRTUAL PROCEDURE Dispose();
   
   // SELF
   PRIVATE VAR
      R : Resources.CResources;
      _Device : adviser.TPAdvisedDevice := NIL;
      _Logger : log.TPILogger := log.logger();
      _Running : BOOLEAN := FALSE;
      _Curves : lists.CPtrList; // list of CCurve

   PRIVATE PROCEDURE Compute( curve : TPCurve );

END CEquithermicCurveFunction;

(*================================================================================*)

END EquithermicCurve.