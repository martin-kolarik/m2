DEFINITION MODULE eib_user;

(*================================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   eib_def,
   eib_status,
   eib_stack,
   list;
  
(*================================================================================*)

TYPE
   TObjectStateItem = (
      // system states
      osUnknown,
      osTransmitting,
      osTransmitted,
      osUpdated,
         osChanged,
      // mainly user-level hint states
      osReading,
      osWriting,
      osInitReadPending,
      osInitReadRepeat
   );
   TObjectState = SET OF TObjectStateItem;

   TObjectBehaviour = ( // standard mostly used behaviour
      obNone,
      obTransmitter,           // object SETS value upon user request
      obTransmitterWithStatus, // object SETS value upon user request and passively GETS value upon EIB network change
      obTracker,               // object passively GETS value upon EIB network change
      obReader                 // object actively COMMUNICATES value from EIB network
   );
   
   TInitReadState = (
      irsUnknown,
      irsPending,
      irsWillRepeat
   );

CLASS CUserObject IMPLEMENTS eib_stack.IUserObject;
   // internal
   PExecutive : eib_stack.TPEIBStackApplicationLayer;

   PRIVATE VAR // runtime states, MUST be synchronized, using setter, getter or some method
      State : TObjectState;
      Value : eib_def.TValue;
      prAddress : eib_def.CAddress; // promiscuous address
   PUBLIC VAR // parameters settable during startup, NOT synchronized
      Flags : eib_def.TA_ObjectFlags;
      Class : eib_def.TPriority;
      Groups : list.CList; // the first address is used for sending

   PUBLIC READONLY PROPERTY   
      Type : eib_def.TEIBType;

   PUBLIC PROCEDURE Init( POfStack : eib_stack.TPEIBStack; Type : eib_def.TEIBType; Behaviour : TObjectBehaviour );
   VIRTUAL FINALLY CUserObject();

   INTERNAL VIRTUAL PROCEDURE Lock(); // hook to lock synchronized data, by default empty
   INTERNAL VIRTUAL PROCEDURE Unlock(); // hook to lock synchronized data, by default empty

   // chaining
   PUBLIC PROCEDURE Executive() : eib_stack.TPEIBStackApplicationLayer;

   // USER LAYER
   PUBLIC VIRTUAL PROCEDURE AU_GroupValue_Read_Req(); // should sync access to data
   PUBLIC VIRTUAL PROCEDURE AU_GroupValue_Read_Con( Status : eib_status.TEIBStackStatus ); // should sync access to data
   PUBLIC VIRTUAL PROCEDURE AU_GroupValue_Read_Res( Status : eib_status.TEIBStackStatus; CONST PPacket : eib_def.TPPacket ); // should sync access to data
   PUBLIC VIRTUAL PROCEDURE AU_GroupValue_Write_Ind( CONST PPacket : eib_def.TPPacket ); // should sync access to data
   PUBLIC VIRTUAL PROCEDURE AU_GroupValue_Write_Con( Status : eib_status.TEIBStackStatus ); // should sync access to data

   // USER LAYER ADDRESSES
   PUBLIC VIRTUAL PROPERTY
      ReadAddress        : eib_def.TAddress;
      SendAddress        : eib_def.TAddress;
      PromiscuousAddress : eib_def.TAddress;
   PUBLIC VIRTUAL READONLY PROPERTY
      Promiscuous        : BOOLEAN;

  // helpers
  PUBLIC PROCEDURE GetFlags() : eib_def.TA_ObjectFlags;
  PUBLIC PROCEDURE SetFlags( Flags : eib_def.TA_ObjectFlags );
  PUBLIC PROCEDURE GetSendFlag( CONST Address : eib_def.TAddress; VAR SendFlag : BOOLEAN ) : BOOLEAN;
  PUBLIC PROCEDURE SetSendFlag( CONST Address : eib_def.TAddress; SendFlag : BOOLEAN ) : BOOLEAN;
  PUBLIC PROCEDURE GetReadFlag( CONST Address : eib_def.TAddress; VAR ReadFlag : BOOLEAN ) : BOOLEAN;
  PUBLIC PROCEDURE SetReadFlag( CONST Address : eib_def.TAddress; ReadFlag : BOOLEAN ) : BOOLEAN;
  PUBLIC PROCEDURE GetClass() : eib_def.TPriority;
  PUBLIC PROCEDURE SetClass( Class : eib_def.TPriority );

  // subscription
  PUBLIC PROCEDURE AddAddress( SendFlag : BOOLEAN; UpdateWholeStack : BOOLEAN; CONST Address : eib_def.TAddress );
  PUBLIC PROCEDURE RemoveAddress( UpdateWholeStack : BOOLEAN; CONST Address : eib_def.TAddress );
  PUBLIC PROCEDURE HaveAddress( CONST Address : eib_def.TAddress ) : BOOLEAN;
  PUBLIC PROCEDURE SubscribePromiscuous();
  PUBLIC PROCEDURE UnsubscribePromiscuous();
  // helper
  PUBLIC PROCEDURE EnumerateAddress( VAR EnumerationState : PTR; VAR Address : eib_def.TAddress ) : BOOLEAN;

   // client request
   PUBLIC PROPERTY
      InitReadState : TInitReadState; // should sync access to data
   PUBLIC READONLY PROPERTY
      CommunicationState : TObjectState;
      Reading : BOOLEAN; // should sync access to data
      Writing : BOOLEAN; // should sync access to data
  PUBLIC PROCEDURE CancelIO(); // should sync access to data 
  PUBLIC PROCEDURE SetValue( CONST Value : eib_def.TValue ) : eib_status.TEIBStackStatus; // should sync access to data
  PUBLIC PROCEDURE GetValue( OUT Value : eib_def.TValue; UseCached, ForceReadOutOfOrder : BOOLEAN ) : eib_status.TEIBStackStatus; // should sync access to data
  PUBLIC PROCEDURE Transmit() : eib_status.TEIBStackStatus;
  PUBLIC PROCEDURE InitiateTransmit( CONST Address : eib_def.TAddress; CONST Value : eib_def.TValue ) : eib_status.TEIBStackStatus; // getting of address and value should be sync
  PUBLIC PROCEDURE InitiateGetValue( CONST Address : eib_def.TAddress ) : eib_status.TEIBStackStatus; // getting of Address should be sync

  // client callback, NOT in synchronized context
  INTERNAL VIRTUAL PROCEDURE ValueReadRequestSent( Status : eib_status.TEIBStackStatus; CurrentState : TObjectState ); // CurrentState is copy of synchronous state to avoid new synchronized state get
  INTERNAL VIRTUAL PROCEDURE ValueRead( Status : eib_status.TEIBStackStatus; CurrentState : TObjectState; CurrentInitReadState : TInitReadState ); // Object.State is already cleared in time of method call.
  INTERNAL VIRTUAL PROCEDURE ValueUpdated( Status : eib_status.TEIBStackStatus; CurrentState : TObjectState ); // dtto
  INTERNAL VIRTUAL PROCEDURE ValueWritten( Status : eib_status.TEIBStackStatus; CurrentState : TObjectState ); // dtto

  // private
  PRIVATE PROCEDURE eit2prl( eit : eib_def.TEIBType; VAR prl : eib_stack.TprLength ) : BOOLEAN;
  PRIVATE PROCEDURE UpdateStack();
END CUserObject;

(*================================================================================*)

END eib_user.