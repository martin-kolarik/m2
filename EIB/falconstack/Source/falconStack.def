DEFINITION MODULE falconStack;

(*================================================================================*)

IMPORT
  guiddef,
  oaidl,
  unknwn,
  wtypes,
  windows;

IMPORT
  eib_def,
  eib_stack;

IMPORT
  ax_automation,
  falcon;

(*================================================================================*)
// TP-UART connection

TYPE
  TPFalconTransportLayer = POINTER TO CFalconTransportLayer;
  TPFalconStack          = POINTER TO CFalconStack;

(*--------------------------------------------------------------------------------*)

TYPE
  TBUSConnection = (
    bcUnknown,
    bcConnected,
    bcDisconnected
  );

(*--------------------------------------------------------------------------------*)

(*# save, call( convention => stdcall ) *)

CLASS CGroupDataEvent( falcon.ICustomClientGroupDataEvent );
  PTL : TPFalconTransportLayer;

  VIRTUAL PROCEDURE QueryInterface( CONST riid : guiddef.IID; ppvObject : PADDRESS ) : wtypes.HRESULT;

  VIRTUAL PROCEDURE GroupDataIndicationRead( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : falcon.Priority;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataIndicationWrite( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : falcon.Priority;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataIndicationResponse( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : falcon.Priority;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataConfirmationRead( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : falcon.Priority;
      Error        : wtypes.VARIANT_BOOL;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataConfirmationWrite( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : falcon.Priority;
      Error        : wtypes.VARIANT_BOOL;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataConfirmationResponse( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : falcon.Priority;
      Error        : wtypes.VARIANT_BOOL;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;

  PROCEDURE GroupDataConfirmation(
      Direction : eib_def.TValueDirection;
      GroupAddress : INTEGER;
      RoutingCount : INTEGER;
      Priority : falcon.Priority;
      Error : wtypes.VARIANT_BOOL;
      Data : oaidl.VARIANT
  );

  PROCEDURE GroupDataIndication(
      Direction : eib_def.TValueDirection;
      GroupAddress : INTEGER;
      RoutingCount : INTEGER;
      Priority : falcon.Priority;
      Data : oaidl.VARIANT
  );

END CGroupDataEvent;

(*# restore *)

(*--------------------------------------------------------------------------------*)

TYPE
  TKey = ARRAY [0..63] OF WCHAR;
  TPKey = POINTER TO TKey;

CLASS CFalconTransportLayer( eib_stack.CEIBStackTransportLayer );
  GroupDataEvent    : CGroupDataEvent;
  Connection        : TBUSConnection;
  COMFlag           : BOOLEAN;

  PFalconConnection : falcon.TPFalconConnection;
  PKey              : TPKey;

  PConnection       : falcon.TPIConnectionCustom;
  PGroupData        : falcon.TPIGroupDataTransfer;
  PCPContainer      : ax_automation.TPIConnectionPointContainer;
  PCPoint           : ax_automation.TPIConnectionPoint;
  AdviseCookie      : windows.DWORD;

  VIRTUAL PROCEDURE T_Groupdata_Req(
          Destination : eib_def.TAddress; // cr_id
          Class       : eib_def.TPriority;
      VAR Packet      : eib_def.TPacket
  );

  PROCEDURE ConnectBUS() : eib_stack.TEIBStackStatus;
  PROCEDURE DisconnectBUS() : eib_stack.TEIBStackStatus;
END CFalconTransportLayer;

(*--------------------------------------------------------------------------------*)

CLASS CFalconStack( eib_stack.CEIBStack );
  Connection       : ARRAY [0..63] OF WCHAR;
  FalconConnection : falcon.FalconConnection;
  Key              : TKey;

  INTERNAL VIRTUAL PROCEDURE ValidateParameters( OUT ErrorText : ARRAY OF WCHAR ) : BOOLEAN;

  INTERNAL VIRTUAL PROCEDURE Initialize() : eib_stack.TEIBStackStatus;
  INTERNAL VIRTUAL PROCEDURE ConnectBUS() : eib_stack.TEIBStackStatus;
  INTERNAL VIRTUAL PROCEDURE DisconnectBUS() : eib_stack.TEIBStackStatus;
  INTERNAL VIRTUAL PROCEDURE CreateLayer( Layer : eib_stack.TEIBStackLayerType; VAR PLayer : eib_stack.TPEIBStackLayer ) : BOOLEAN;

  PUBLIC VIRTUAL PROCEDURE DeviceConnected() : BOOLEAN;
  PUBLIC VIRTUAL PROCEDURE EIBConnected() : BOOLEAN;
END CFalconStack;

(*================================================================================*)

END falconStack.