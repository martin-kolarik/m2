DEFINITION MODULE falcon;

IMPORT
  guiddef,
  oaidl,
  unknwn,
  windows,
  wtypes;

IMPORT
  com;

(*# call( convention => stdcall ) *)

TYPE
  DeviceOpenError = (
    DeviceOpenErrorNoError = 0,
    DeviceOpenErrorUnexpectedError = 1,
    DeviceOpenErrorAlreadyOpenWithDifferentLayer = 2,
    DeviceOpenErrorInvalidMode = 3,
    DeviceOpenErrorDriverOpenError = 4,
    DeviceOpenErrorBcuInitializeError = 5,
    DeviceOpenErrorInvalidDevice = 6,
    DeviceOpenErrorCreateInstanceError = 7,
    DeviceOpenErrorUnableToChangeMode = 8
  );

  ConnectionMode = (
    ConnectionModeUndefined = 0,
    ConnectionModeBusmon = 1,
    ConnectionModeLocalDirect = 2,
    ConnectionModeLocalConnection = 3,
    ConnectionModeRemoteConnection = 4,
    ConnectionModeRemoteConnectionless = 5,
    ConnectionModeClosed = 6,
    ConnectionModeOpenDriver = 7,
    ConnectionModeLLBusmon = 8
  );

  ConnectionState = (
    ConnectionClosed = 0,
    ConnectionOpenedOk = 1,
    ConnectionOpenedBroken = 2,
    ConnectionOpenedDriverOnly = 3
  );

  Priority = (
    PrioritySystem = 0,
    PriorityAlarm = 2,
    PriorityHigh = 1,
    PriorityLow = 3,
    PriorityDefault = 255
  );

  InternalMessageType = (
    InternalMessageTypeUndefined = 0,
    InternalMessageTypeBcuResetReceived = 1,
    InternalMessageTypeDummyMessage = 2,
    InternalMessageTypeReinitializeBcu = 3,
    InternalMessageTypeLifeTimeInfo = 4,
    InternalMessageQueueOverflow = 5
  );

  DeviceWriteError = (
    DeviceWriteErrorNoError = 0,
    DeviceWriteErrorWriteError = 1,
    DeviceWriteErrorInvalidMessage = 2,
    DeviceWriteErrorDriverNotOpen = 3,
    DeviceWriteErrorQueueOverflow = 4,
    DeviceWriteErrorUnexpectedError	= 255
  );

  FalconService = (
    FalconServiceUndefined	= 0,
	  FalconServiceFalconMessage	= 1,
	  FalconServiceEibMessage	= 2
  );

(*# save, option( pack => 8 ) *)

  EibMessage = RECORD
                 cData : ARRAY [0..32] OF BYTE;
               END; // RECORD

  InternalMessage = RECORD
                      eType : InternalMessageType;
                      dwData : CARDINAL;
                    END; // RECORD

  MessageType = RECORD
                  CASE : CARDINAL OF
                  | 0 : rEibMessage : EibMessage;
                  | 1 : rInternalMessage : InternalMessage;
                  END; // CASE
                END; // RECORD

  FalconMessage = RECORD
                    cMessageLength : BYTE;
                    rTime : windows.FILETIME;
                    eService : FalconService;
                    rMessage : MessageType;
                  END; // RECORD

  FalconConnection  = RECORD
                        wszName       : ARRAY [0..63] OF WCHAR;
                        fcmfFlags     : CARDINAL;
                        guidEdi       : guiddef.GUID;
                        wszParameters : ARRAY [0..511] OF WCHAR;
                      END; // RECORD
  TPFalconConnection = POINTER TO FalconConnection;

  FalconConnectionManagerFlags = (
    fcmfNone = 0,
    fcmfDefaultConnection = 1,
    fcmfSuccessful = 2
  );

(*# restore *)

//=====
CONST
  EDI_Loopback               = com.TGUID( 00826FFA6H, 0FF34H, 011D3H, 0B3H, 04BH, 000H, 090H, 027H, 043H, 04FH, 0FAH );
  EDI_PEI10                  = com.TGUID( 07530A4F7H, 099DFH, 011D4H, 0AEH, 0BEH, 000H, 010H, 05AH, 0A2H, 0DDH, 097H );
  EDI_PEI16                  = com.TGUID( 02913B764H, 0A0E2H, 011D4H, 0AEH, 0C9H, 000H, 010H, 05AH, 0A2H, 0DDH, 097H );
  EDI_USB                    = com.TGUID( 0273A2B65H, 0F373H, 0417DH, 08AH, 0B9H, 0CCH, 043H, 099H, 0D6H, 0CCH, 012H );
  EDI_EibNet                 = com.TGUID( 013BEC8E3H, 0969DH, 04604H, 083H, 0F4H, 05EH, 0BFH, 041H, 08EH, 054H, 0F6H );
  EDI_EibIPLib               = com.TGUID( 0EE530A02H, 0D041H, 011D4H, 08BH, 06EH, 000H, 000H, 0E8H, 06AH, 080H, 0B2H );

  CLSID_ConnectionManager    = com.TGUID( 07B9D3F3CH, 0B09EH, 04B81H, 081H, 060H, 0C8H, 0C3H, 0CFH, 0D1H, 0F5H, 082H );
  CLSID_SerialPeiEdiConfigUI = com.TGUID( 030F04437H, 04CEEH, 043A8H, 085H, 0D0H, 057H, 0DEH, 0F9H, 055H, 039H, 0A2H );
  CLSID_EiblibIPEdiConfigUI  = com.TGUID( 0048E0778H, 02761H, 049C8H, 087H, 0BCH, 091H, 073H, 039H, 073H, 03FH, 052H );
  CLSID_UsbEdiConfigUI       = com.TGUID( 0EBD5351EH, 0EDB7H, 042F6H, 081H, 010H, 081H, 06FH, 0D0H, 0BDH, 009H, 009H );
  CLSID_EibnetEdiConfigUI    = com.TGUID( 017455E93H, 0B72BH, 042F7H, 0ACH, 0DBH, 0E9H, 0FFH, 09FH, 0AEH, 0E6H, 058H );
  CLSID_KnxIpWizard          = com.TGUID( 0BFDDB56FH, 00EB6H, 04135H, 092H, 09AH, 010H, 0C7H, 02EH, 0ABH, 02FH, 058H );

  CLSID_CommunicationObject  = com.TGUID( 00826FF97H, 0FF34H, 011D3H, 0B3H, 04BH, 000H, 090H, 027H, 043H, 04FH, 0FAH );
  CLSID_GroupTransfer        = com.TGUID( 00826FF99H, 0FF34H, 011D3H, 0B3H, 04BH, 000H, 090H, 027H, 043H, 04FH, 0FAH );

  LIBID_FALCONCONNECTIONMANAGERLib
                             = com.TGUID( 0CB5E6F9CH, 07C23H, 04BF4H, 08AH, 0E6H, 048H, 08CH, 0B9H, 0A3H, 0A9H, 09EH );

//===== forward pointer types
TYPE
  TPIEnumFalconConnection       = POINTER TO IEnumFalconConnection;
  TPIConnectionManager          = POINTER TO IConnectionManager;
  TPIConnectionCustom           = POINTER TO IConnectionCustom;
  TPIGroupDataTransfer          = POINTER TO IGroupDataTransfer;
  TPICustomClientGroupDataEvent = POINTER TO ICustomClientGroupDataEvent;

//===== IEnumFalconConnection
CONST
  IID_IEnumFalconConnection = com.TGUID( 04E93E624H, 0DDAFH, 04BEEH, 0A1H, 057H, 065H, 011H, 046H, 0F0H, 098H, 0C6H );

COM INTERFACE IEnumFalconConnection( unknwn.IUnknown );

  VIRTUAL PROCEDURE Next(
    celt         : windows.ULONG;
    prgfc        : TPFalconConnection;
    pceltFetched : windows.PULONG
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE Skip(
    celt : windows.ULONG
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE Reset() : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE Clone(
    VAR ppenum : TPIEnumFalconConnection
  ) : wtypes.HRESULT;

END IEnumFalconConnection;        

//===== IConnectionManager
CONST
  IID_IConnectionManager = com.TGUID( 0BA990407H, 04865H, 04467H, 0BBH, 07CH, 0A9H, 020H, 088H, 03AH, 092H, 0FCH );

COM INTERFACE IConnectionManager( unknwn.IUnknown );

  VIRTUAL PROCEDURE get__NewEnum( 
      VAR ppVal : unknwn.TPIUnknown
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE Item( 
          vtSelector    : oaidl.VARIANTARG;
      VAR pfcConnection : FalconConnection
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE get_Count( 
      VAR Val : windows.LONG
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE AddConnection( 
          pNewConnection : TPFalconConnection
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE DeleteConnection( 
          pszConnectionName : windows.PSTR
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE SetAsDefaultConnection( 
          pszConnectionName : windows.PSTR
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE GetDefaultConnection( 
      VAR pfcDefaultConnection : FalconConnection
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE GetConnection( 
          pszPreSelection : windows.PSTR;
          bAllowEditing   : windows.LONG;
      VAR ppfcConnection  : FalconConnection
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE SetSuccessfulFlag( 
          pszConnection : windows.PSTR
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE RemoveFromMruList( 
          pszConnection : windows.PSTR
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE SetMruMaxCount( 
          lMaxMruEntries : windows.LONG
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE GetMruMaxCount( 
      VAR plCurrentMaxMruCount : windows.LONG
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE ClearMruList() : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE GetMruList( 
      VAR plCount : windows.LONG;
      VAR ppszConnections : windows.PSTR
  ) : wtypes.HRESULT;

END IConnectionManager;        

//===== IEdiParamConfiguration
CONST
  IID_IEdiParamConfiguration = com.TGUID( 00A69FBC5H, 03AF0H, 04BB7H, 091H, 067H, 0B4H, 0FCH, 088H, 0CFH, 09BH, 0A8H );

COM INTERFACE IEdiParamConfiguration( oaidl.IDispatch );

  VIRTUAL PROCEDURE put_Enabled( 
          pbool : wtypes.VARIANT_BOOL
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE get_Enabled( 
      VAR pbool : wtypes.VARIANT_BOOL
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE get_Parameters( 
      VAR pVal : wtypes.BSTR
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE put_Parameters( 
          pVal : wtypes.BSTR
  ) : wtypes.HRESULT;

END IEdiParamConfiguration;

//===== IKnxIpWizard
CONST
  IID_IKnxIpWizard = com.TGUID( 012220235H, 0D7C9H, 0459FH, 09CH, 0A7H, 046H, 078H, 04CH, 0A6H, 020H, 0F4H );

COM INTERFACE IKnxIpWizard( unknwn.IUnknown );

  VIRTUAL PROCEDURE Show( 
          lcidLang       : windows.ULONG;
          ConnectionName : wtypes.BSTR;
      VAR pbChanged      : wtypes.VARIANT_BOOL
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE InternalShow( 
          lcidLang       : windows.ULONG;
      VAR pbstrName      : wtypes.BSTR;
      VAR pbstrIPAddress : wtypes.BSTR;
      VAR pbstrPort      : wtypes.BSTR;
      VAR pbChanged      : wtypes.VARIANT_BOOL
  ) : wtypes.HRESULT;

END IKnxIpWizard;

//===== IConnection
CONST
  IID_IConnectionCustom = com.TGUID( 00826FFACH, 0FF34H, 011D3H, 0B3H, 04BH, 000H, 090H, 027H, 043H, 04FH, 0FAH );

CLASS IConnectionCustom( com.CIUnknown );

  VIRTUAL PROCEDURE Open( 
          EdiGuid      : guiddef.CLSID;
      VAR DevOpenError : DeviceOpenError
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE Open2( 
          EdiGuid      : guiddef.CLSID;
          Parameters   : oaidl.VARIANT;
      VAR DevOpenError : DeviceOpenError
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE Write( 
          Msg : FalconMessage;
      VAR DevWriteError : DeviceWriteError
  ) : wtypes.HRESULT;
        
  VIRTUAL PROCEDURE (*/* [helpstring][propget][id]*/*) get_Mode( 
      VAR pVal : ConnectionMode
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propput][id]*/*) put_Mode( 
          pVal : ConnectionMode
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propget][id]*/*) get_TargetAddress( 
      VAR pVal : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propput][id]*/*) put_TargetAddress( 
          pVal : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propget][id]*/*) get_State( 
      VAR pVal : ConnectionState
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propget][id]*/*) get_FirmwareDescriptor( 
      VAR pVal : INTEGER
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propget][id]*/*) get_FirmwareDescriptor2( 
      VAR pVal : INTEGER
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propget][id]*/*) get_AccessKey( 
      VAR pVal : INTEGER
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propput][id]*/*) put_AccessKey( 
      pVal : INTEGER
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propget][id]*/*) get_EdiGuid( 
      VAR pVal : wtypes.BSTR
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE RequestAsyncLifeTimeInfo() : wtypes.HRESULT;

END IConnectionCustom;

//===== IGroupDataTransfer
CONST
  IID_IGroupDataTransfer = com.TGUID( 03EE14E52H, 089BCH, 04AF8H, 090H, 0CCH, 06FH, 0C2H, 0C1H, 024H, 068H, 03DH );

CLASS IGroupDataTransfer( com.CIDispatch );

  VIRTUAL PROCEDURE (*/* [helpstring][propget][id]*/*) get_Connection( 
      VAR pVal : TPIConnectionCustom // should be TPIConnection
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE (*/* [helpstring][propputref][id]*/*) putref_Connection( 
          pVal : TPIConnectionCustom // should be TPIConnection
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE Read( 
          GroupAddress : oaidl.VARIANT;
          Prio         : Priority;
          RoutingCnt   : INTEGER;
      VAR WriteError   : DeviceWriteError
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE Write( 
          GroupAddress : oaidl.VARIANT;
          Prio         : Priority;
          RoutingCnt   : INTEGER;
          Less7Bits    : wtypes.VARIANT_BOOL;
          Data         : oaidl.VARIANT;
      VAR WriteError   : DeviceWriteError
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE ReadSync( 
          GroupAddress : oaidl.VARIANT;
          Prio         : Priority;
          RoutingCnt   : INTEGER;
      VAR Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE SendReadResponse( 
          GroupAddress : oaidl.VARIANT;
          Prio         : Priority;
          RoutingCnt   : INTEGER;
          Less7Bits    : wtypes.VARIANT_BOOL;
          Data         : oaidl.VARIANT;
      VAR WriteError   : DeviceWriteError
  ) : wtypes.HRESULT;
  
END IGroupDataTransfer;
    
//===== IClientGroupDataEvent
CONST
  IID_ICustomClientGroupDataEvent = com.TGUID( 00826FFC4H, 0FF34H, 011D3H, 0B3H, 04BH, 000H, 090H, 027H, 043H, 04FH, 0FAH );

CLASS ICustomClientGroupDataEvent( com.CIUnknown );

  VIRTUAL PROCEDURE GroupDataIndicationRead( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : Priority;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataIndicationWrite( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : Priority;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataIndicationResponse( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : Priority;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataConfirmationRead( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : Priority;
      Error        : wtypes.VARIANT_BOOL;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataConfirmationWrite( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : Priority;
      Error        : wtypes.VARIANT_BOOL;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE GroupDataConfirmationResponse( 
      GroupAddress : INTEGER;
      RoutingCnt   : INTEGER;
      Prio         : Priority;
      Error        : wtypes.VARIANT_BOOL;
      Data         : oaidl.VARIANT
  ) : wtypes.HRESULT;
  
  VIRTUAL PROCEDURE Status( 
      MsgType : InternalMessageType;
      Data    : INTEGER
  ) : wtypes.HRESULT;

END ICustomClientGroupDataEvent;

END falcon.
