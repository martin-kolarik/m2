<?xml version ="1.0" encoding ="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- main resource properties -->
    <PropertyGroup>
        <CopyrightYears Condition="$(CopyrightYears)==''">2005-2007</CopyrightYears>
        <CompanyName Condition="$(CompanyName)==''">SmartControl®</CompanyName>
        <LegalCopyright Condition="$(LegalCopyright)==''">Copyright © SmartControl® $(CopyrightYears)</LegalCopyright>
        <LegalTrademarks Condition="$(LegalTrademarks)==''">SmartControl</LegalTrademarks>
        <LegalNote></LegalNote>
        <Contact>info@smartcontrol.cz</Contact>
        <Phone>(420) 576 121 191</Phone>
        <Support>http://www.smartcontrol.cz/support</Support>
        <URL>http://www.smartcontrol.cz</URL>
        <UpdateURL>http://www.smartcontrol.cz/update/$(ProductId)</UpdateURL>
    </PropertyGroup>

    <!-- language identifiers -->
    <PropertyGroup Condition="$(Language)=='Czech'">
        <LangIdDec>1029</LangIdDec>
        <LangIdHex>0405</LangIdHex>
        <CodePageDec>1250</CodePageDec>
        <CodePageHex>04e2</CodePageHex>
        <LangName>LANG_CZECH</LangName>
        <SublangName>SUBLANG_DEFAULT</SublangName>
    </PropertyGroup>

    <!-- language identifiers -->
    <PropertyGroup Condition="$(Language)=='English'">
        <LangIdDec>1033</LangIdDec>
        <LangIdHex>0409</LangIdHex>
        <CodePageDec>1252</CodePageDec>
        <CodePageHex>04e4</CodePageHex>
        <LangName>LANG_ENGLISH</LangName>
        <SublangName>SUBLANG_ENGLISH_US</SublangName>
    </PropertyGroup>

</Project>
