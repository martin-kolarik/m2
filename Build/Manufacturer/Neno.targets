<?xml version ="1.0" encoding ="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- main resource properties -->
    <PropertyGroup>
        <CopyrightYears Condition="$(CopyrightYears)==''">2008</CopyrightYears>
        <CompanyName Condition="$(CompanyName)==''">NeNo®</CompanyName>
        <LegalCopyright Condition="$(LegalCopyright)==''">Copyright © NeNo® $(CopyrightYears)</LegalCopyright>
        <LegalTrademarks Condition="$(LegalTrademarks)==''">NeNo SmartVision</LegalTrademarks>
        <LegalNote></LegalNote>
        <Contact>info@neno.cz</Contact>
        <Phone>(420) 605 023 970</Phone>
        <Support>programator@neno.cz</Support>
        <URL>http://www.neno.cz</URL>
        <UpdateURL>http://www.neno.cz</UpdateURL>
        <!-- UpdateURL>http://update.neno.cz/$(ProductId)</UpdateURL -->
    </PropertyGroup>

    <!-- language identifiers -->
    <PropertyGroup Condition="$(Language)=='Czech'">
        <LangIdDec>1029</LangIdDec>
        <LangIdHex>0405</LangIdHex>
        <CodePageDec>1250</CodePageDec>
        <CodePageHex>04e2</CodePageHex>
        <LangName>LANG_CZECH</LangName>
        <SublangName>SUBLANG_DEFAULT</SublangName>
    </PropertyGroup>

    <!-- language identifiers -->
    <PropertyGroup Condition="$(Language)=='English'">
        <LangIdDec>1033</LangIdDec>
        <LangIdHex>0409</LangIdHex>
        <CodePageDec>1252</CodePageDec>
        <CodePageHex>04e4</CodePageHex>
        <LangName>LANG_ENGLISH</LangName>
        <SublangName>SUBLANG_ENGLISH_US</SublangName>
    </PropertyGroup>

</Project>
