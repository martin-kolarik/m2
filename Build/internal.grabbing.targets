<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- common properties -->
    <PropertyGroup>
        <!-- recursive child parameters -->
        <Grabbing>off</Grabbing>
        <GrabProcessFileName>GrabbedComponents.tmp</GrabProcessFileName>
        <GrabProcessFile>$(ComponentPath)\$(IntermediateDirName)\$(GrabProcessFileName)</GrabProcessFile>
        <GrabProcessFile Condition="$(DefinitionsFileAllowed)=='off' And $(GrabbingGrabProcessFile)!=''">$(GrabbingGrabProcessFile)</GrabProcessFile>
    </PropertyGroup>
    
    <ItemGroup>
        <GrabProcessFile Include="$(GrabProcessFile)"/>
    </ItemGroup>

    <PropertyGroup>
        <!-- recursive dependencies parameters -->
        <SelfBuildDependenciesDir>$(ComponentPath)\$(IntermediateDirName)</SelfBuildDependenciesDir>
        <SelfBuildDependenciesFile>$(SelfBuildDependenciesDir)\Dependencies.targets</SelfBuildDependenciesFile>
        <BuildDependenciesFile>$(SelfBuildDependenciesFile)</BuildDependenciesFile>
        <BuildDependenciesFile Condition="$(InheritedBuildDependenciesFile)!=''">$(InheritedBuildDependenciesFile)</BuildDependenciesFile>
    </PropertyGroup>
    
    <!-- out of recursion, (new) grab file is created always, because each component needs grab self dependencies -->
    <Target Name="DeleteGrabProcessFile">
        <Delete Files="@(GrabProcessFile)" ContinueOnError="true"/>
    </Target>
    
    <!-- in recursion, (new) grab file is created (old deleted) only for components allowing self definitions -->
    <Target Name="DeleteGrabProcessFileIfAllowed"
            Condition="$(DefinitionsFileAllowed)=='on'">
        <Delete Files="@(GrabProcessFile)" ContinueOnError="true"/>
    </Target>

    <Target Name="GrabEnclosedComponentsObjects"
            Condition="$(PropagateSources)=='on'" 
            Returns="@(GrabbedObjects)">
        <CreateItem Include="@(Objects -> '$(RootDir)\$(ComponentName)\$(IntermediateDirName)\%(FileName).obj')"
                    AdditionalMetadata="Type=InterfaceObjects">
            <Output TaskParameter="Include" ItemName="GrabbedObjects"/>
        </CreateItem>
        
        <!-- Message Importance="high" Text="!!## @(GrabbedObjects)"/ -->
    </Target>
    
    <Target Name="PrepareLibraryName">
        <!-- The target is called from two places - when library name is prepared to be inherited and when the coponent which should offer its values to enclosed components sets up self. -->
        <!-- For the second case, GrabbedLibraryName is inherited (e.g. checkcfg), but for Library type components (e.g. sccore) sccore still must be used as library name (and not checkcfg, e.g.). -->
        <PropertyGroup>
            <LibraryNameToGrab>$(GrabbingLibraryName)</LibraryNameToGrab><!-- default -->
            <LibraryNameToGrab Condition="$(LibraryNameToGrab)==''">$(ResultName)</LibraryNameToGrab><!-- initialization if compilation started with me  -->
            <LibraryNameToGrab Condition="$(PublishExports)=='on' And $(PropagateSources)=='on'">$(ResultName)</LibraryNameToGrab><!-- overwrite for Library type components -->
        </PropertyGroup>

    </Target>
    
    <Target Name="GrabComponent"
            DependsOnTargets="Directories;PrepareLibraryName"
            Condition="$(PropagateSources)=='on' Or $(PropagateDeliverables)=='on'"
            Returns="@(Grabbed)">
        
        <!-- Message Importance="high" Text="$(InheritedLevel) Grabbing: $(ComponentName)"/ -->
        <!-- Message Importance="high" Text="Definition self: $(SelfComponentDefinitionsSource) for [$(ComponentName)]"/ -->
        <!-- Message Importance="high" Text="Definition inhr: $(InheritedComponentDefinitionsSource) for [$(ComponentName)]"/ -->
        <!-- Message Importance="high" Text="Definition rslt: $(ComponentDefinitionsSource) for [$(ComponentName)]"/ -->
        <!-- Message Importance="high" Text="@(GrabProcessFile)" / -->
        
        <!-- Message Importance="high" Text="$(ComponentName): $(ComponentType), $(PublishExports), $(GrabbingPublishExports)" / -->
        
        <ItemGroup>
            <!-- 1. add self to components -->
            <Grabbed Include="$(ComponentName)">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <DefinitionPath>$(ComponentDefinitionsPath)</DefinitionPath>
                <Type>Component</Type>
                <ComponentType>Component</ComponentType>
                <AdditionalProperties>CompilePublishExports=$(GrabbingPublishExports);CompileLibraryName=$(LibraryNameToGrab)</AdditionalProperties>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>
            <Grabbed Include="$(ComponentDefinitionsSource)">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <DefinitionPath>$(ComponentDefinitionsPath)</DefinitionPath>
                <Type>Definition</Type>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>

            <!-- 2. DEF reference -->
            <Grabbed Condition="$(PropagateSources)=='on' And Exists('$(SourceDir)')"
                     Include="$(ComponentName)\$(SourceDir)">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <Type>Source</Type>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>

            <!-- 3a. H reference dynamically created -->
            <Grabbed Condition="$(PropagateSources)=='on'"
                     Include="$(ComponentName)\$(IntermediateDirName)">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <Type>Header</Type>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>
            <!-- 3b. H reference statically stated -->
            <Grabbed Condition="$(PropagateSources)=='on' And Exists( 'Header' )"
                     Include="$(ComponentName)\Header">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <Type>Header</Type>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>

            <!-- 4. add messages -->
            <Grabbed Condition="$(PropagateSources)=='on' And $(Result)=='Static' And @(Messages)!=''"
                     Include="@(MessagesBin -> '$(ComponentPath)\%(Identity)')">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <Type>Message</Type>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>
        
            <!-- 5a. LIB used by me normally loaded. -->
            <Grabbed Condition="$(PropagateSources)=='on' And $(Result)!='Program'"
                     Include="@(Interface -> '%(Identity).lib')">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <Type>Library</Type>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>
            <!-- 5b. LIB used by me delayed in load -->
            <Grabbed Condition="$(PropagateSources)=='on' And $(Result)!='Program'"
                     Include="@(InterfaceWithDelayLoad -> '%(Identity).lib /delayload:%(FileName).dll')">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <Type>Library</Type>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>
            <!-- 5c. my output LIB -->
            <!-- if GrabbingPublishExports is on then my owner publishes mine symbols so I must not add myself to the list of libraries to be linked with -->
            <!-- SelfInterface in condition prevents adding lib file for enclosing components not doing any enclosing at the time -->
            <Grabbed Condition="$(GrabbingPublishExports)!='on' And $(PropagateSources)=='on' And @(SelfInterface)!='' And $(Result)!='Program'"
                     Include="@(SelfInterface -> '%(Identity).lib')">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <Type>Library</Type>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>

            <!-- 6. components which are not built must offer their runtimes -->
            <!-- SelfInterface in condition prevents adding lib file for enclosing components not doing any enclosing at the time -->
            <Grabbed Condition="$(PropagateDeliverables)=='on' And @(SelfInterface)!=''"
                        Include="$(OutputFilePath);$(OutputPDBFilePath);$(OutputMAPFilePath)">
                <Definition>$(ComponentDefinitionsSource)</Definition>
                <Type>Runtime</Type>
                <LibraryName>$(LibraryNameToGrab)</LibraryName>
            </Grabbed>
        </ItemGroup>
       
        <!-- mark me as parsed as soon as I know it -->
        <MakeDir Condition="!Exists( @(GrabProcessFile -> '%(RootDir)%(Directory)'))"
                 Directories="@(GrabProcessFile -> '%(RootDir)%(Directory)')" />
        <WriteLinesToFile File="$(GrabProcessFile)"
                          Lines="$(ComponentName)"/>
    </Target>
    
    <Target Condition="@(Components)!='' Or ($(ClientLicensing)=='on' And $(LicensingComponent)!='')"
            Name="GrabComponentsRecursion"
            DependsOnTargets="DeleteGrabProcessFileIfAllowed;PrepareLibraryName"
            Returns="@(Grabbed)">
        <!-- adjust list of components with internally added ones -->
        <ItemGroup Condition="$(ClientLicensing)=='on' And $(LicensingComponent)!=''">
            <InternalComponents Include="$(LicensingComponent)"/>
        </ItemGroup>

        <!-- filter already grabbed components -->
        <ReadLinesFromFile File="$(GrabProcessFile)">
            <Output TaskParameter="Lines" ItemName="ComponentsParsed"/>
        </ReadLinesFromFile>
        <ItemGroup>
            <ComponentsToParse Include="@(InternalComponents);@(Components)"
                               Exclude="@(ComponentsParsed)" />
        </ItemGroup>

        <!-- dive deeper -->
        <ItemGroup Condition="@(ComponentsToParse)!=''">
            <DefinitionToDisplay Include="$(ComponentDefinitionsSource)"/>
        </ItemGroup>
        <Message Condition="@(ComponentsToParse)!=''"
                 Importance="normal"
                 Text="@(DefinitionToDisplay -> '%(FileName)') &lt;- @(ComponentsToParse -> '%(FileName)', ' ' )"/>
        
        <PropertyGroup>
            <PublishExportsValueToGrab>off</PublishExportsValueToGrab>
            <PublishExportsValueToGrab Condition="$(PublishExports)=='on' And $(PropagateSources)=='on'">on</PublishExportsValueToGrab>

            <InheritedComponentProperties>InheritedComponentDefinitionsSource=$(ComponentDefinitionsSource);InheritedComponentDefinitionsPath=$(ComponentDefinitionsPath)</InheritedComponentProperties>
            <InheritedGrabbingProperties>GrabbingGrabProcessFile=$(GrabProcessFile);GrabbingLibraryName=$(LibraryNameToGrab);GrabbingPublishExports=$(PublishExportsValueToGrab)</InheritedGrabbingProperties>
        </PropertyGroup>

        <Message Condition="@(ComponentsToParse)!=''"
                 Importance="normal"
                 Text="@(DefinitionToDisplay -> '%(FileName)') &lt;- @(ComponentsToParse -> '%(FileName)', ' ' )"/>
        
        <MSBuild Condition="@(ComponentsToParse)!=''"
                 Projects="@(ComponentsToParse -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Properties="$(ChildParameters);Grabbing=on;$(InheritedComponentProperties);$(InheritedGrabbingProperties)"
                 Targets="GrabComponentsRecursion;GrabComponent"><!-- first do childs to get proper build order -->
            <Output TaskParameter="TargetOutputs" ItemName="GrabbedFromChilds"/>
        </MSBuild>

        <!-- cleanup output -->
        <RemoveDuplicates Condition="@(ComponentsToParse)!='' And '%(GrabbedFromChilds.Definition)%(GrabbedFromChilds.Type)'!='.'"
                          Inputs="@(GrabbedFromChilds)"><!-- definition file cannot be '.', so using it as a neg-condition forces emitting all items -->
            <Output TaskParameter="Filtered" ItemName="Grabbed"/>
        </RemoveDuplicates>
    </Target>
    
    <Target Name="DebugDisplayGrabbedComponent" Condition="off">
        <Message Importance="high" Text="======================================"/>
        <Message Importance="high" Text="Project:      $(MSBuildProjectName) -> @(Components)"/>
        <Message Importance="high" Text="  Components: grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Component'"/>
        <Message Importance="high" Text="  Sources:    grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Source'"/>
        <Message Importance="high" Text="  Headers:    grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Header'"/>
        <Message Importance="high" Text="  Messages:   grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Message'"/>
        <Message Importance="high" Text="  Libraries:  grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Library'"/>
    </Target>

    <Target Name="WriteGrabbedComponentsToBuildDependeciesFile"
            Outputs="$(BuildDependenciesFile)">
        <ItemGroup>
            <Dependencies Condition="%(Grabbed.Type)!='Definition' And %(Grabbed.Type)!='Component' And %(Grabbed.Type)!='Message'"
                          Include="@(Grabbed -> '&lt;%(Type) Include=&quot;%(Identity)&quot;&gt;&lt;Definition&gt;%(Definition)&lt;/Definition&gt;&lt;/%(Type)&gt;')" />
            <Dependencies Condition="%(Grabbed.Type)=='Message'"
                          Include="@(Grabbed -> '&lt;%(Type) Include=&quot;%(Identity)&quot;&gt;&lt;Definition&gt;%(Definition)&lt;/Definition&gt;&lt;LibraryName&gt;%(LibraryName)&lt;/LibraryName&gt;&lt;/%(Type)&gt;')" />
        </ItemGroup>

        <PropertyGroup>
            <Leading>&lt;Project xmlns=&quot;http://schemas.microsoft.com/developer/msbuild/2003&quot;&gt;&lt;ItemGroup&gt;</Leading>
            <Trailing>&lt;/ItemGroup&gt;&lt;/Project&gt;</Trailing>
        </PropertyGroup>
        
        <WriteLinesToFile File="$(BuildDependenciesFile)"
                          Lines="$(Leading);@(Dependencies);$(Trailing)"
                          Overwrite="true"/>
    </Target>
    
    <Target Name="PrepareDependenciesForCurrentProject">
        <ItemGroup>
            <Header Condition="%(Grabbed.Type)=='Header'"
                    Include="%(Identity)">
                <Definition>%(Definition)</Definition>
            </Header>

            <Source Condition="%(Grabbed.Type)=='Source'"
                    Include="%(Identity)">
                <Definition>%(Definition)</Definition>
            </Source>

            <Message Condition="%(Grabbed.Type)=='Message'"
                        Include="%(Identity)">
                <Definition>%(Definition)</Definition>
                <LibraryName>%(LibraryName)</LibraryName>
            </Message>

            <Library Condition="%(Grabbed.Type)=='Library'"
                     Include="%(Identity)">
                <Definition>%(Definition)</Definition>
            </Library>

            <Runtime Condition="%(Grabbed.Type)=='Runtime'"
                     Include="%(Identity)">
                <Definition>%(Definition)</Definition>
            </Runtime>
        </ItemGroup>
    </Target>
    
    <Target Name="CheckUnexpectedCall">
        <Error Condition="$(InheritedBuildDependenciesFile)!=''" Text="GrabComponents called for single MSBuild project run twice. This is not expected, build will stop."/>
    </Target>
    
    <Target Name="GrabComponents"
            DependsOnTargets="CheckUnexpectedCall;DeleteGrabProcessFile;Directories;GrabComponentsRecursion;DebugDisplayGrabbedComponent;WriteGrabbedComponentsToBuildDependeciesFile;PrepareDependenciesForCurrentProject"
            Returns="@(Grabbed)">
        <!-- Grabbed is returned as a whole, even if it is duplicate to the build dependencies file. Grabbed may be used, for example, for cleaning etc. -->
    </Target>
    
    <Import Condition="Exists('$(BuildDependenciesFile)')"
            Project="$(BuildDependenciesFile)"/>

</Project>
