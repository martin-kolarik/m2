<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- common properties -->
    <PropertyGroup>
        <!-- recursive child parameters -->
        <Grabbing>off</Grabbing>
        <GrabProcessFileName>GrabbedComponents.tmp</GrabProcessFileName>
        <GrabProcessFile>$(ComponentPath)\$(IntermediateDirName)\$(GrabProcessFileName)</GrabProcessFile>
        <GrabProcessFile Condition="$(DefinitionsFileAllowed)=='off' And $(InheritedGrabProcessFile)!=''">$(InheritedGrabProcessFile)</GrabProcessFile>
    </PropertyGroup>
    
    <ItemGroup>
        <GrabProcessFile Include="$(GrabProcessFile)"/>
    </ItemGroup>

    <PropertyGroup>
        <!-- recursive dependencies parameters -->
        <SelfBuildDependenciesDir>$(ComponentPath)\$(IntermediateDirName)</SelfBuildDependenciesDir>
        <SelfBuildDependenciesFile>$(SelfBuildDependenciesDir)\Dependencies.targets</SelfBuildDependenciesFile>
        <BuildDependenciesFile>$(SelfBuildDependenciesFile)</BuildDependenciesFile>
        <BuildDependenciesFile Condition="$(InheritedBuildDependenciesFile)!=''">$(InheritedBuildDependenciesFile)</BuildDependenciesFile>
    </PropertyGroup>
    
    <!-- out of recursion, (new) grab file is created always, because each component needs grab self dependencies -->
    <Target Name="DeleteGrabProcessFile">
        <Delete Files="@(GrabProcessFile)" ContinueOnError="true"/>
    </Target>
    
    <!-- in recursion, (new) grab file is created (old deleted) only for components allowing self definitions -->
    <Target Name="DeleteGrabProcessFileIfAllowed"
            Condition="$(DefinitionsFileAllowed)=='on'">
        <Delete Files="@(GrabProcessFile)" ContinueOnError="true"/>
    </Target>

    <Target Name="oldGrabComponent"
            DependsOnTargets="Directories"
            Outputs="@(Grabbed)">

        <!-- PARSE ALL CHILD COMPONENTS, specially handle libraries masked with standalone/re-export components -->
        <CreateProperty Value="$(GetLibrariesToFilter)">
            <Output TaskParameter="Value" PropertyName="FilterLibraries"/>
        </CreateProperty>
        <CreateProperty Condition="@(ExportToInterface)==''" Value="false">
            <Output TaskParameter="Value" PropertyName="GetLibrariesToFilter"/>
        </CreateProperty>
        <CreateProperty Condition="@(ExportToInterface)!=''" Value="true">
            <Output TaskParameter="Value" PropertyName="GetLibrariesToFilter"/>
        </CreateProperty>

        <!-- components which are not built must offer their runtimes -->
        <CreateItem Condition="$(Level)!='0' And $(PropagateBuild)=='off'"
                    Include="$(OutputFilePath);$(OutputPDBFilePath);$(OutputMAPFilePath)"
                    AdditionalMetadata="Type=Runtime">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- standalone/re-export component and component libs -->
        <CreateItem Condition="$(FilterLibraries)=='true' And $(PropagateBuild)=='on'"
                    Include="@(SelfInterface -> '%(Identity).filtered')"
                    AdditionalMetadata="Type=LibraryToFilter">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- Including Grabbed to PrivateGrabbed assures, that PrivateGrabbed used later will behave in the same manner as Grabbed for PropagateComponents=on -->
        <!-- CreateItem Condition="$(PropagateComponents)=='on'"
                    Include="@(Grabbed)">
            <Output TaskParameter="Include" ItemName="PrivateGrabbed"/>
        </CreateItem -->

        <!-- Message Text="+LW(%(Type)):$(MSBuildProjectName)/$(Result): @(Grabbed)" Importance="high"/ -->
    </Target>

    <Target Name="oldGrabComponents"
            DependsOnTargets="DeleteGrabProcessFile;oldGrabComponent">

        <!-- SPLIT COMPONENTS (1a) TO Libraries... -->
        <CreateItem Condition="%(Type)=='Library'"
                    Include="@(PrivateGrabbed)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedUnfilteredLibraries"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedUnfilteredLibraries)">
            <Output TaskParameter="Filtered" ItemName="GrabbedUnfilteredLibraries"/>
        </RemoveDuplicates>
        <!-- SPLIT COMPONENTS (1b) TO libraries to be filtered... -->
        <CreateItem Condition="%(Type)=='LibraryToFilter'"
                    Include="@(PrivateGrabbed -> '%(RootDir)%(Directory)%(FileName).lib')">
            <Output TaskParameter="Include" ItemName="LocalGrabbedLibrariesToFilter"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedLibrariesToFilter)">
            <Output TaskParameter="Filtered" ItemName="GrabbedLibrariesToFilter"/>
        </RemoveDuplicates>
        <!-- ...and filter them, excluding SELF's one, see not above when these libs are added: I cannot link with myself -->
        <CreateItem Include="@(GrabbedUnfilteredLibraries)" Exclude="@(GrabbedLibrariesToFilter);@(SelfInterface -> '%(Identity).lib')">
            <Output TaskParameter="Include" ItemName="LocalGrabbedLibraries"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedLibraries)">
            <Output TaskParameter="Filtered" ItemName="GrabbedLibraries"/>
        </RemoveDuplicates>
        <!-- ...and create final libraries -->
        <CreateItem Include="@(GrabbedLibraries);@(Libraries -> '%(Filename).lib')"
                    Condition="Exists('%(Identity)')">
            <Output TaskParameter="Include" ItemName="LocalLinkDependencyLibraries"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalLinkDependencyLibraries)">
            <Output TaskParameter="Filtered" ItemName="LinkDependencyLibraries"/>
        </RemoveDuplicates>

        <!-- prepare (2a) unfiltered components -->
        <CreateItem Condition="%(Type)=='Component'"
                    Include="@(PrivateGrabbed)"
                    Exclude="@(GrabbedComponents)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedComponents"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedComponents)">
            <Output TaskParameter="Filtered" ItemName="GrabbedComponents"/>
        </RemoveDuplicates>

        <!-- SPLIT COMPONENTS (6) TO Messages (BinaryReSources)... -->
        <CreateItem Condition="%(Type)=='Messages'"
                    Include="@(PrivateGrabbed)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedMessages"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedMessages)">
            <Output TaskParameter="Filtered" ItemName="GrabbedMessages"/>
        </RemoveDuplicates>

        <!-- SPLIT COMPONENTS (7) TO Runtime Modules (DLL,EXE)... -->
        <CreateItem Condition="%(Type)=='Runtime'"
                    Include="@(PrivateGrabbed)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedRuntimes"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedRuntimes)">
            <Output TaskParameter="Filtered" ItemName="GrabbedRuntimes"/>
        </RemoveDuplicates>

        <!-- Message Text="+AL(%(Type)):$(MSBuildProjectName)/$(Result): @(GrabbedUnfilteredLibraries)" Importance="high"/ -->
        <!-- Message Text="+FL(%(Type)):$(MSBuildProjectName)/$(Result): @(GrabbedLibrariesToFilter)" Importance="high"/ -->
        <!-- Message Text="+PR(%(Type)):$(MSBuildProjectName)/$(Result): @(PrivateGrabbed)" Importance="high"/ -->
        <!-- Message Text="+GC(%(Type)):$(MSBuildProjectName)/$(Result): @(GrabbedComponents)" Importance="high"/ -->
        <Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedSources)" Importance="high"/>
        <!-- Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedIncludes)" Importance="high"/ -->
        <!-- Message Text="+!!$(MSBuildProjectName)/$(Result): @(GrabbedLibraries)" Importance="high"/ -->
        <!-- Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedMessages)" Importance="high"/ -->
        <!-- Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedRuntimes)" Importance="high"/ -->
        <!-- Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedExportInterfaces)" Importance="high"/ -->
        <!-- Message Text="=========================================" Importance="high"/ -->
    </Target>

    <Target Name="GrabEnclosedComponentsObjects"
            Condition="$(PropagateSources)=='on'" 
            Returns="@(GrabbedObjects)">
        <CreateItem Include="@(Objects -> '$(RootDir)\$(ComponentName)\$(IntermediateDirName)\%(FileName).obj')"
                    AdditionalMetadata="Type=InterfaceObjects">
            <Output TaskParameter="Include" ItemName="GrabbedObjects"/>
        </CreateItem>
        
        <!-- Message Importance="high" Text="!!## @(GrabbedObjects)"/ -->
    </Target>
    
    <Target Name="CheckUnexpectedCall">
        <Error Condition="$(InheritedBuildDependenciesFile)!=''" Text="GrabComponents called for single MSBuild project run twice. This is not expected, build will stop."/>
    </Target>
    
    <Target Name="GrabComponent"
            DependsOnTargets="Directories"
            Condition="$(PropagateSources)=='on' Or $(PropagateDeliverables)=='on'"
            Returns="@(Grabbed)">
        
        <!-- Message Importance="high" Text="$(InheritedLevel) Grabbing: $(ComponentName)"/ -->
        <!-- Message Importance="high" Text="Definition self: $(SelfComponentDefinitionsSource) for [$(ComponentName)]"/ -->
        <!-- Message Importance="high" Text="Definition inhr: $(InheritedComponentDefinitionsSource) for [$(ComponentName)]"/ -->
        <!-- Message Importance="high" Text="Definition rslt: $(ComponentDefinitionsSource) for [$(ComponentName)]"/ -->
        <!-- Message Importance="high" Text="@(GrabProcessFile)" / -->

        <!-- 1. add self to components -->
        <CreateItem Include="$(ComponentName)"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Component;ComponentType=$(ComponentType);DefinitionPath=$(ComponentDefinitionsPath);AdditionalProperties=InheritedLibraryName=$(LibraryName);AdditionalProperties=InheritedPublishExports=$(InheritedPublishExports)">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <CreateItem Include="$(ComponentDefinitionsSource)"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Definition;DefinitionPath=$(ComponentDefinitionsPath)">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- 2. DEF reference -->
        <CreateItem Condition="$(PropagateSources)=='on' And Exists( '$(SourceDir)' )"
                    Include="$(ComponentName)\$(SourceDir)"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Source">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- 3a. H reference dynamically created -->
        <CreateItem Condition="$(PropagateSources)=='on'"
                    Include="$(ComponentName)\$(IntermediateDirName)"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Header">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>
        <!-- 3b. H reference statically stated -->
        <CreateItem Condition="$(PropagateSources)=='on' And Exists( 'Header' )"
                    Include="$(ComponentName)\Header"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Header">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- 4. add messages -->
        <CreateItem Condition="$(PropagateSources)=='on' And $(Result)=='Static' And @(Messages)!=''"
                    Include="@(MessagesBin -> '$(ComponentPath)\%(Identity)')"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Message;LibraryName=$(LibraryName)">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>
        
        <!-- 5a. LIB used by me normally loaded. -->
        <CreateItem Condition="$(PropagateSources)=='on' And $(Result)!='Program'"
                    Include="@(Interface -> '%(Identity).lib')"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Library">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>
        <!-- 5b. LIB used by me delayed in load -->
        <CreateItem Condition="$(PropagateSources)=='on' And $(Result)!='Program'"
                    Include="@(InterfaceWithDelayLoad -> '%(Identity).lib /delayload:%(FileName).dll')"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Library">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>
        <!-- 5c. my output LIB -->
        <CreateItem Condition="$(PropagateDeliverables)=='on' And $(Result)!='Program'"
                    Include="@(SelfInterface -> '%(Identity).lib')"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Library">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- 6. components which are not built must offer their runtimes -->
        <!-- CreateItem Condition="true Or $(Level)!='0' And $(PropagateBuild)=='off'"
                    Include="$(OutputFilePath);$(OutputPDBFilePath);$(OutputMAPFilePath)"
                    AdditionalMetadata="Definition=$(ComponentDefinitionsSource);Type=Runtime">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem -->
        
        <!-- mark me as parsed as soon as I know it -->
        <MakeDir Condition="!Exists( @(GrabProcessFile -> '%(RootDir)%(Directory)'))"
                 Directories="@(GrabProcessFile -> '%(RootDir)%(Directory)')" />
        <WriteLinesToFile File="$(GrabProcessFile)"
                          Lines="$(ComponentName)"/>
    </Target>
    
    <Target Condition="@(Components)!='' Or ($(ClientLicensing)=='on' And $(LicensingComponent)!='')"
            Name="GrabComponentsRecursion"
            DependsOnTargets="DeleteGrabProcessFileIfAllowed"
            Returns="@(Grabbed)">
        <!-- adjust list of components with internally added ones -->
        <ItemGroup Condition="$(ClientLicensing)=='on' And $(LicensingComponent)!=''">
            <InternalComponents Include="$(LicensingComponent)"/>
        </ItemGroup>

        <!-- filter already grabbed components -->
        <ReadLinesFromFile File="$(GrabProcessFile)">
            <Output TaskParameter="Lines" ItemName="ComponentsParsed"/>
        </ReadLinesFromFile>
        <CreateItem Include="@(InternalComponents);@(Components)"
                    Exclude="@(ComponentsParsed)">
            <Output TaskParameter="Include" ItemName="ComponentsToParse"/>
        </CreateItem>

        <!-- dive deeper -->
        <ItemGroup Condition="@(ComponentsToParse)!=''">
            <DefinitionToDisplay Include="$(ComponentDefinitionsSource)"/>
        </ItemGroup>
        <Message Condition="@(ComponentsToParse)!=''"
                 Importance="normal"
                 Text="@(DefinitionToDisplay -> '%(FileName)') &lt;- @(ComponentsToParse -> '%(FileName)', ' ' )"/>
        
        <PropertyGroup>
            <InheritedPublishExportsValue>off</InheritedPublishExportsValue>
            <InheritedPublishExportsValue Condition="$(PublishExports)=='on' And $(PropagateSources)=='on'">on</InheritedPublishExportsValue>
            <InheritedComponentProperties>InheritedComponentDefinitionsSource=$(ComponentDefinitionsSource);InheritedComponentDefinitionsPath=$(ComponentDefinitionsPath);InheritedLibraryName=$(LibraryName);InheritedPublishExports=$(InheritedPublishExportsValue)</InheritedComponentProperties>
            <InheritedGrabbingProperties>InheritedGrabProcessFile=$(GrabProcessFile)</InheritedGrabbingProperties>
        </PropertyGroup>

        <MSBuild Condition="@(ComponentsToParse)!=''"
                 Projects="@(ComponentsToParse -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Properties="$(ChildParameters);Grabbing=on;$(InheritedComponentProperties);$(InheritedGrabbingProperties)"
                 Targets="GrabComponentsRecursion;GrabComponent"><!-- first do childs to get proper build order -->
            <Output TaskParameter="TargetOutputs" ItemName="GrabbedFromChilds"/>
        </MSBuild>

        <!-- cleanup output -->
        <RemoveDuplicates Condition="@(ComponentsToParse)!='' And '%(GrabbedFromChilds.Definition)%(GrabbedFromChilds.Type)'!='.'"
                          Inputs="@(GrabbedFromChilds)"><!-- definition file cannot be '.', so using it as a neg-condition forces emitting all items -->
            <Output TaskParameter="Filtered" ItemName="Grabbed"/>
        </RemoveDuplicates>
    </Target>
    
    <Target Name="DebugDisplayGrabbedComponent" Condition="off">
        <Message Importance="high" Text="======================================"/>
        <Message Importance="high" Text="Project:      $(MSBuildProjectName) -> @(Components)"/>
        <Message Importance="high" Text="  Components: grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Component'"/>
        <Message Importance="high" Text="  Sources:    grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Source'"/>
        <Message Importance="high" Text="  Headers:    grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Header'"/>
        <Message Importance="high" Text="  Messages:   grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Message'"/>
        <Message Importance="high" Text="  Libraries:  grabbed[%(Type)||%(Definition)]: @(Grabbed)" Condition="%(Type)=='Library'"/>
    </Target>

    <Target Name="WriteGrabbedComponentsToBuildDependeciesFile"
            Outputs="$(BuildDependenciesFile)">
        <CreateItem Condition="%(Grabbed.Type)=='Definition'"
                    Include="@(Grabbed -> '&lt;%(Type) Include=&quot;%(Identity)&quot;&gt;&lt;Definition&gt;%(Definition)&lt;/Definition&gt;&lt;Path&gt;%(Path)&lt;/Path&gt;&lt;/%(Type)&gt;')">
            <Output TaskParameter="Include" ItemName="Dependencies"/>
        </CreateItem>

        <CreateItem Condition="%(Grabbed.Type)!='Definition' And %(Grabbed.Type)!='Component' And %(Grabbed.Type)!='Message'"
                    Include="@(Grabbed -> '&lt;%(Type) Include=&quot;%(Identity)&quot;&gt;&lt;Definition&gt;%(Definition)&lt;/Definition&gt;&lt;/%(Type)&gt;')">
            <Output TaskParameter="Include" ItemName="Dependencies"/>
        </CreateItem>

        <CreateItem Condition="%(Grabbed.Type)=='Message'"
                    Include="@(Grabbed -> '&lt;%(Type) Include=&quot;%(Identity)&quot;&gt;&lt;Definition&gt;%(Definition)&lt;/Definition&gt;&lt;LibraryName&gt;%(LibraryName)&lt;/LibraryName&gt;&lt;/%(Type)&gt;')">
            <Output TaskParameter="Include" ItemName="Dependencies"/>
        </CreateItem>

        <PropertyGroup>
            <Leading>&lt;Project xmlns=&quot;http://schemas.microsoft.com/developer/msbuild/2003&quot;&gt;&lt;ItemGroup&gt;</Leading>
            <Trailing>&lt;/ItemGroup&gt;&lt;/Project&gt;</Trailing>
        </PropertyGroup>
        
        <WriteLinesToFile File="$(BuildDependenciesFile)"
                          Lines="$(Leading);@(Dependencies);$(Trailing)"
                          Overwrite="true"/>
    </Target>
    
    <Target Name="GrabComponents"
            DependsOnTargets="CheckUnexpectedCall;DeleteGrabProcessFile;Directories;GrabComponentsRecursion;DebugDisplayGrabbedComponent;WriteGrabbedComponentsToBuildDependeciesFile"
            Returns="@(Grabbed)">
        <!-- Grabbed is returned as a whole, even if it is duplicate to the build dependencies file. Grabbed may be used, for example, for cleaning etc. -->
    </Target>
    
    <Import Condition="Exists('$(BuildDependenciesFile)')"
            Project="$(BuildDependenciesFile)"/>

</Project>
