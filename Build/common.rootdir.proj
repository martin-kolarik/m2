<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- root directories, do not modify -->
    <PropertyGroup>
        <ComponentDir></ComponentDir>
        <ComponentPath>$(MSBuildProjectDirectory)</ComponentPath>
        <ComponentType Condition="$(ComponentType)==''">Generic</ComponentType>

        <!-- RootDir>$(ComponentDir)\..\..</RootDir -->
        <RootDir Condition="$(RootDir)==''">..\..</RootDir>
        <RootPath>$(ComponentPath)\$(RootDir)</RootPath>

        <RootBuildDir>$(RootDir)\Build</RootBuildDir>
        <RootBuildPath>$(RootPath)\Build</RootBuildPath>

        <Level>0</Level>
    </PropertyGroup>

    <PropertyGroup Condition="$(ComponentType)=='Product'">
        <ProductPath>$(ComponentPath)</ProductPath>

        <ProductBuildPath>$(MSBuildProjectDirectory)</ProductBuildPath>
        <ProductBuildFile>$(ProductBuildPath)\$(MSBuildProjectName).proj</ProductBuildFile>
    </PropertyGroup>

    <PropertyGroup>
        <ResultName Condition="$(ResultName)==''">$(MSBuildProjectName)</ResultName>
    </PropertyGroup>

</Project>
