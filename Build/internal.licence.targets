<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>

        <ProductLicenceFileContents>[product]
id = $(ProductId)
name = $(ProductDescription)
version = $(ProductVersionMajor).$(ProductVersionMinor).#(ProductVersionBuild).$(ProductVersionRevision)
copyright = $(LegalCopyright)
legal = $(LegalNote)
note = $(ProductNote)</ProductLicenceFileContents>

    </PropertyGroup>

    <UsingTask TaskName="Patch" AssemblyFile="$(BuildTask)"/>
    <Target Name="CreateProductLicenceFile"
            Inputs="$(ProductBuildFile)"
            Outputs="$(ProductLicenceFile)">
        
        <!-- Message Importance="high" Text="#-$(ProductVersionBuild)-#" / -->
        
        <Patch Value="$(ProductLicenceFileContents)" Keys="ProductVersionBuild" Patches="$(ProductVersionBuild)">
            <Output TaskParameter="Value" PropertyName="ProductLicenceFileContents"/>
        </Patch>
        <WriteLinesToFile File="$(ProductLicenceFile)" Overwrite="true" Lines="$(ProductLicenceFileContents)"/>
    </Target>

</Project>
