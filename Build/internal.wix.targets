<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup Condition ="$(Language)=='Czech'">
        <RFC1766Short>cs</RFC1766Short>
        <RFC1766Long>cs-cz</RFC1766Long>
    </PropertyGroup>
    <PropertyGroup Condition ="$(Language)=='English'">
        <RFC1766Short>en</RFC1766Short>
        <RFC1766Long>en-us</RFC1766Long>
    </PropertyGroup>

    <PropertyGroup>
        <RFC1766Short Condition="$(RFC1766Short)==''">en</RFC1766Short>
        <RFC1766Long Condition="$(RFC1766Long)==''">en-us</RFC1766Long>

        <WixBin>c:\program files\wix</WixBin>
        <Candle>$(WixBin)\candle</Candle>
        <Light>$(WixBin)\light</Light>
        <WixSrc>..\$(RootBuildDir)\WiX</WixSrc>

        <SetupFile>..\$(SetupDir)\$(MSBuildProjectName).wxs</SetupFile>
        <SetupObj>$(IntermediateDir)\$(MSBuildProjectName).wixobj</SetupObj>

        <CandleDefs>-dBuildRoot=&quot;$(WiXSrc)&quot; -dProductRoot=&quot;$(ComponentPath)\Install&quot; -dProductId=&quot;$(ProductId)&quot;</CandleDefs>
        <CandleDefs>$(CandleDefs) -dContact=&quot;$(Contact)&quot; -dSupport=&quot;$(Support)&quot; -dPhone=&quot;$(Phone)&quot; -dURL=&quot;$(URL)&quot; -dUpdateURL=&quot;$(UpdateURL)&quot;</CandleDefs>
        <CandleDefs>$(CandleDefs) -dManufacturer=&quot;$(Manufacturer)&quot; -dProductDisplayName=&quot;$(ProductDisplayName)&quot; -dProductDescription=&quot;$(ProductDescription)&quot;</CandleDefs>
        <CandleDefs>$(CandleDefs) -dUpgradeGUID=$(ProductUpgradeGUID) -dLicenceMId=$(LicenceMachineId)</CandleDefs>
        <CandleDefs>$(CandleDefs) -dLanguageName=$(RFC1766Short) -dLanguage=$(LangIdDec) -dCodePage=$(OriginalCodePageDec) -dConfigurationName=$(ConfigurationName) -dLeakChecking=$(LeakChecking)</CandleDefs>
        <CandleDefs Condition="$(CLib)=='Static'">$(CandleDefs) -dCLib=$(CLib)</CandleDefs>
        <CandleDefs Condition="$(CLib)=='Dynamic'">$(CandleDefs) -dCLib=$(DynamicCLibInstallMethod)</CandleDefs>
    </PropertyGroup>

    <ItemGroup>
        <SetupSource Include="$(SetupDir)\*;$(SetupDir)\**\*.bmp;$(SetupDir)\**\*.ico" />
        <IntermediateSetupFiles Include="$(SetupDir)\License.rtf;$(IntermediateDir)\*.wixobj"/>
    </ItemGroup>

    <UsingTask TaskName="GenerateGUID" AssemblyFile="BuildTasks.dll"/>

    <Target Name="CleanSetup">
        <Delete Files="@(IntermediateSetupFiles)" ContinueOnError="true" />
    </Target>

    <Target Name="CreateSetup"
            DependsOnTargets="OutputProperties;GUID;MSI;Digests"/>

    <Target Name="OutputProperties">
        <CreateProperty Condition="$(ConfigurationName)=='Release'" Value="$(MSBuildProjectName)-$(ProductVersion)_$(RFC1766Short).msi">
            <Output TaskParameter="Value" PropertyName="SetupResult" />
        </CreateProperty>
        <CreateProperty Condition="$(ConfigurationName)!='Release'" Value="$(MSBuildProjectName)-$(ProductVersion)_$(RFC1766Short)-$(ConfigurationName).msi">
            <Output TaskParameter="Value" PropertyName="SetupResult" />
        </CreateProperty>
        <CreateProperty Value="$(OutputDir)\$(SetupResult)">
            <Output TaskParameter="Value" PropertyName="SetupResultDir" />
        </CreateProperty>
    </Target>
    
    <Target Name="GUID" Condition="$(ProductGUID)==''">
        <GenerateGUID>
            <Output TaskParameter="GUID" PropertyName="ProductGUID"/>
        </GenerateGUID>
    </Target>

    <Target Name="MSI"
            Inputs="$(Compiled);@(SetupSource)"
            Outputs="$(SetupResultDir)">
        <Copy SourceFiles="$(SetupDir)\License.$(Manufacturer).$(RFC1766Long).rtf"
              DestinationFiles="$(SetupDir)\License.rtf" />
        <Exec WorkingDirectory="$(IntermediateDir)"
              Command="&quot;$(Candle)&quot; $(SetupFile) -dProductVersion=$(ProductVersion) -dProductGUID=$(ProductGUID) $(CandleDefs)"/>
        <Exec WorkingDirectory="$(OutputDir)"
              Command="&quot;$(Light)&quot; -b &quot;..\$(SetupDir)&quot; &quot;..\$(SetupObj)&quot; &quot;$(WiXSrc)\WixUI_Licence.wixlib&quot; -loc &quot;$(WiXSrc)\WixUI_$(RFC1766Long).wxl&quot; -loc &quot;$(WixSrc)\WixUI_Licence_$(RFC1766Long).wxl&quot; -out $(SetupResult)"/>
    </Target>

    <Target Name="Digests"
            Inputs="$(SetupResultDir)"
            Outputs="$(OutputDir)\$(SetupResult).sha1;$(OutputDir)\$(SetupResult).md5">
        <Exec WorkingDirectory="$(OutputDir)"
              Command="$(SUM) -b -1 $(SetupResult) &gt; $(SetupResult).sha1"/>
        <Exec WorkingDirectory="$(OutputDir)"
              Command="$(SUM) -b -5 $(SetupResult) &gt; $(SetupResult).md5"/>
    </Target>

</Project>
