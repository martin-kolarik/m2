<?xml version="1.0" encoding="utf-8"?>
<Include>

    <Upgrade Id="$(var.UpgradeGUID)">
        <UpgradeVersion OnlyDetect="yes" Property="SELFFOUND" Minimum="$(var.ProductVersion)" IncludeMinimum="yes" Maximum="$(var.ProductVersion)" IncludeMaximum="yes" />
        <UpgradeVersion OnlyDetect="yes" Property="NEWERFOUND" Minimum="$(var.ProductVersion)" IncludeMinimum="no" />
        <UpgradeVersion OnlyDetect="yes" Property="OLDERFOUND" Maximum="$(var.ProductVersion)" IncludeMaximum="no" />
    </Upgrade>
    
    <CustomAction Id="AlreadyUpdated" Error="$(loc.UpgradeErrorSelfInstalled)" />
    <CustomAction Id="NoDowngrade" Error="$(loc.UpgradeErrorNewerFound)" />

    <InstallExecuteSequence>
        <Custom Action="AlreadyUpdated" Before="InstallInitialize">SELFFOUND</Custom>
        <Custom Action="NoDowngrade" Before="InstallInitialize">NEWERFOUND</Custom>
        <RemoveExistingProducts After="InstallFinalize">OLDERFOUND</RemoveExistingProducts>
    </InstallExecuteSequence>
    
    <InstallUISequence>
        <Custom Action="AlreadyUpdated" Before="FindRelatedProducts">SELFFOUND</Custom>
        <Custom Action="NoDowngrade" Before="FindRelatedProducts">NEWERFOUND</Custom>
    </InstallUISequence>
    
</Include>
