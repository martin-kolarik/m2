<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- RC versioning -->
    <PropertyGroup>
        <RCFileFlags Condition="$(Debug)=='on'">VS_FF_DEBUG</RCFileFlags>
        <RCFileFlags Condition="$(Debug)!='on'">0</RCFileFlags>
        <RCFileFlags Condition="$(ProductStepping)!=''">$(RCFileFlags) | VS_FF_SPECIALBUILD</RCFileFlags>
        <RCFileType Condition="$(Result)=='Static'">VFT_STATIC_LIB</RCFileType>
        <RCFileType Condition="$(Result)=='Dynamic'">VFT_DLL</RCFileType>
        <RCFileType Condition="$(Result)=='Program'">VFT_APP</RCFileType>

        <OriginalCodePageDec>$(CodePageDec)</OriginalCodePageDec>
        <CodePageDec Condition="$(LanguageStyle)=='UNICODE'">1200</CodePageDec>
        <CodePageHex Condition="$(LanguageStyle)=='UNICODE'">04b0</CodePageHex>
    </PropertyGroup>

    <PropertyGroup>
        <RCStringFileInfo>
    VALUE &quot;CompanyName&quot;, &quot;$(CompanyName)\0&quot;
    VALUE &quot;LegalCopyright&quot;, &quot;$(LegalCopyright)\0&quot;
    VALUE &quot;LegalTrademarks&quot;, &quot;$(LegalTrademarks)\0&quot;

    VALUE &quot;ProductName&quot;, &quot;$(ProductDescription)\0&quot;
    VALUE &quot;ProductVersion&quot;, &quot;$(ProductVersionMajor).$(ProductVersionMinor).#(ProductVersionBuild).$(ProductVersionRevision)\0&quot;

    VALUE &quot;FileDescription&quot;, &quot;$(FileDescription)\0&quot;
    VALUE &quot;FileVersion&quot;, &quot;$(FileVersionMajor).$(FileVersionMinor).#(FileVersionBuild).$(FileVersionRevision) (#(FileRevisionId))\0&quot;
    VALUE &quot;InternalName&quot;, &quot;$(InternalName)\0&quot;
    VALUE &quot;OriginalFilename&quot;, &quot;$(OriginalFilename)\0&quot;
    VALUE &quot;LanguageStyle&quot;, &quot;$(LanguageStyle)\0&quot;
        </RCStringFileInfo>
        <RCStepping Condition="$(ProductStepping)!=''">
    VALUE &quot;SpecialBuild&quot;, &quot;$(ProductStepping)\0&quot;
        </RCStepping>

        <RCVarFileInfo>
    VALUE &quot;Translation&quot;, 0x$(LangIdHex), $(CodePageDec)
        </RCVarFileInfo>

        <RCFileContents>
#include &quot;winres.h&quot;
#pragma code_page($(OriginalCodePageDec))
        
VS_VERSION_INFO VERSIONINFO
  PRODUCTVERSION $(ProductVersionMajor),$(ProductVersionMinor),#(ProductVersionBuild),$(ProductVersionRevision)
  FILEVERSION $(FileVersionMajor),$(FileVersionMinor),#(FileVersionBuild),$(FileVersionRevision)
  FILEFLAGSMASK VS_FF_DEBUG | VS_FF_SPECIALBUILD
  FILEFLAGS $(RCFileFlags)
  FILEOS VOS_NT
  FILETYPE $(RCFileType)
  FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo" BEGIN BLOCK "$(LangIdHex)$(CodePageHex)" BEGIN
    $(RCStringFileInfo)$(RCStepping)
  END END
  BLOCK "VarFileInfo" BEGIN
    $(RCVarFileInfo)
  END
END

LANGUAGE $(LangName), $(SubLangName)
        </RCFileContents>
    </PropertyGroup>

    <UsingTask TaskName="WriteLinesToEncodedFile" AssemblyFile="BuildTasks.dll"/>
    <!-- UsingTask TaskName="BuildNumber" AssemblyFile="BuildTasks.dll"/ -->
    <UsingTask TaskName="Patch" AssemblyFile="BuildTasks.dll"/>

    <PropertyGroup>
        <RCFile>$(IntermediateDir)\$(MSBuildProjectName).generated.rc</RCFile>
        <RCFileDependency>$(ResourceFile);$(TLBFile);@(GrabbedMessages);@(MessagesBin)</RCFileDependency>
        <RCFileDependency Condition="!Exists('$(RCFile)')">$(RCFile);$(RCFileDependency)</RCFileDependency>
    </PropertyGroup>

    <Target Name="AppendSpecificRC">
        <WriteLinesToFile File="$(RCFile)" Lines="//* specific data, merged;//*"/>
        <ReadLinesFromFile Condition ="Exists($(ResourceFile))" File ="$(ResourceFile)">
            <Output TaskParameter="Lines" ItemName="SourceLines"/>
        </ReadLinesFromFile>
        <WriteLinesToEncodedFile File="$(RCFile)" Lines="@(SourceLines)" Encoding="$(OriginalCodePageDec)"/>
    </Target>

    <Target Name="CreateRCFile"
            Condition="@(RESFile)!=''"
            Inputs="$(RCFileDependency)"
            Outputs="$(RCFile)">
        <!-- operate build numbers -->
        <CreateProperty Condition="$(ProductVersionBuild)==''" Value="$(FileVersionBuild)">
            <Output TaskParameter="Value" PropertyName="ProductVersionBuild"></Output>
        </CreateProperty>
        <CreateProperty Value="@(FileRevisionIds)">
            <Output TaskParameter="Value" PropertyName="FileRevisionId"/>
        </CreateProperty>
        <Patch Value="$(RCFileContents)" Keys="ProductVersionBuild;FileVersionBuild;FileRevisionId" Patches="$(ProductVersionBuild);$(FileVersionBuild);$(FileRevisionId)"><!-- patch property -->
            <Output TaskParameter="Value" PropertyName="RCFileContents"/>
        </Patch>
        <!-- create rc file itself -->
        <WriteLinesToFile File="$(RCFile)" Overwrite="true" Lines="//*-----;//* RC file generated by build system;//*"/>
        <WriteLinesToEncodedFile File="$(RCFile)" Lines="$(RCFileContents)" Encoding="$(OriginalCodePageDec)"/>
        <WriteLinesToFile File="$(RCFile)" Lines=" "/>

        <WriteLinesToFile Condition="$(TypeLibrary)!=''"
                          File="$(RCFile)"
                          Lines="//* type library;1 TYPELIB &quot;$(TypeLibrary).tlb&quot;"/>

        <WriteLinesToFile Condition="@(GrabbedMessages)!='' or @(MessagesBin)!=''"
                          File="$(RCFile)"
                          Lines="//*-----;//* message files" />
        <WriteLinesToFile Condition="@(GrabbedMessages)!=''"
                          File="$(RCFile)"
                          Lines="@(GrabbedMessages -> '%(FileName) RCDATA &quot;%(Filename).brs&quot;')"/>
        <WriteLinesToFile Condition="@(MessagesBin)!=''"
                          File="$(RCFile)"
                          Lines="@(MessagesBin -> '%(FileName) RCDATA &quot;%(Filename).brs&quot;')"/>

        <WriteLinesToFile File="$(RCFile)" Lines="//*;//* end of automatically generated part;//*-----"/>
        <CallTarget Condition="Exists($(ResourceFile))" Targets="AppendSpecificRC"/>
    </Target>

</Project>
