<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- TOOLS -->
    <PropertyGroup>
        <CompileProductId Condition="$(ProductId)==''">$(MSBuildProjectName)</CompileProductId>
        <CompileProductId Condition="$(ProductId)!=''">$(ProductId)</CompileProductId>
        <CompileProductVersion Condition="$(ProductVersion)==''">0.0.0</CompileProductVersion>
        <CompileProductVersion Condition="$(ProductVersion)!=''">$(ProductVersion)</CompileProductVersion>

        <CL>&quot;$(CompilerBin)\cl&quot; /nologo /c /DNO_STRICT /DWIN32 /DWINVER=0x0501 /D_WIN32_WINNT=0x0501 /D_ATL_MIN_CRT /DWIN32_LEAN_AND_MEAN</CL>
        <LINK>&quot;$(CompilerBin)\link&quot; /nologo /map /nodefaultlib</LINK>
        <LIB>&quot;$(CompilerBin)\lib&quot; /nologo /nodefaultlib</LIB>
        <RC>&quot;$(SDKBin)\rc&quot; /nologo -r -DWIN32</RC><!-- -i&quot;$(VCD)\..\include&quot;</RC -->

        <MT>&quot;$(SDKBin)\mt&quot; -manifest $(OutputFile).manifest -outputresource:$(OutputFile)</MT>
        <MTT>&quot;$(SDKBin)\mt&quot; -manifest $(TestOutput).manifest -outputresource:$(TestOutput)</MTT>

        <M2>&quot;$(RootBuildPath)\Bin\m2cpp&quot;</M2>
        <M2D>&quot;$(RootBuildPath)\Bin\m2cpp&quot;</M2D>
        <XRSDEF>&quot;$(RootBuildPath)\Bin\xrsc&quot; -D -O$(SourceDir)</XRSDEF>
        <XRSBIN>&quot;$(RootBuildPath)\Bin\xrsc&quot; -B -O$(IntermediateDir) -P$(MSBuildProjectName).</XRSBIN>

        <LICSRC Condition="$(ClientLicensingType)=='Host'">&quot;$(RootBuildPath)\Bin\licbuild&quot; -M</LICSRC>
        <LICSRC Condition="$(ClientLicensingType)=='Plugin'">&quot;$(RootBuildPath)\Bin\licbuild&quot; -Mp</LICSRC>
        <LICSIGN>&quot;$(RootBuildPath)\Bin\licbuild&quot; -S</LICSIGN>
        <SUM>&quot;$(RootBuildPath)\Bin\sum&quot;</SUM>
        <RUNTEST>&quot;$(RootBuildPath)\Bin\runtest&quot; -F</RUNTEST>
        
        <!-- M2PROD takes here self initial value -->
        <M2PROD>-DProductId:$(CompileProductId) -DProductVersion:$(CompileProductVersion) -DProjectId:$(ProjectId)</M2PROD>
    </PropertyGroup>

    <!-- CONTROLS -->
    <PropertyGroup>
        <M2CTRL>-DManufacturer:$(Manufacturer) -DConfiguration:$(Configuration) -DPlatform:$(Platform) -DLicenceMachineId:$(LicenceMachineId)</M2CTRL>
        <M2CTRL>$(M2CTRL) -W8 -W9 -W10 -W11 -DDEBUG:$(Debug)</M2CTRL>
        <M2CTRL Condition="$(CPPExceptions)=='on'">$(M2CTRL) -SE</M2CTRL>
        <M2CTRL Condition="$(LeakChecking)=='on'">$(M2CTRL) -SM</M2CTRL>
        <CLCTRL>/Zp8 /J /Gy /Gr /Gs /GF /GS- /Oi /Zi /Zl /MP</CLCTRL><!-- Gs commits stack, its default commit threshold is 4K, the same as linker sets for initial stack commit -->
        <CLCTRL Condition="$(CPPExceptions)=='on'">$(CLCTRL) /GR /EHsc</CLCTRL>
        <CLCTRL Condition="$(CPPExceptions)!='on'">$(CLCTRL) /GR-</CLCTRL>
        <!-- CLCTRL>$(CLCTRL) /W4 /wd4018 /wd4100 /wd4102 /wd4127 /wd4146 /wd4245</CLCTRL -->
        <!-- CLCTRL Condition="$(CLib)!='Static' And $(DynamicCLibInstallMethod)=='Private'">$(CLCTRL) /D_USE_RTM_VERSION</CLCTRL -->
        <LINKCTRL>/DYNAMICBASE /LARGEADDRESSAWARE /NXCOMPAT /STACK:$(StackReservation) /OPT:REF /MERGE:.rdata=.text /IGNORE:4049 /IGNORE:4199 /IGNORE:4210 /IGNORE:4217 delayimp.lib</LINKCTRL>
        <LINKCTRL Condition="$(ResultSubsystem)=='Console'">$(LINKCTRL) /SUBSYSTEM:CONSOLE</LINKCTRL>
        <LINKCTRL Condition="$(ResultSubsystem)=='GUI'">$(LINKCTRL) /SUBSYSTEM:WINDOWS</LINKCTRL>
        <LINKCTRL Condition="$(CLib)=='Private'">$(LINKCTRL) /SAFESEH:NO</LINKCTRL>
        <LINKCTRL>$(LINKCTRL) /MACHINE:$(Platform)</LINKCTRL>
        <LIBDEF>/MACHINE:$(Platform)</LIBDEF>
    </PropertyGroup>

    <!-- Manifests: CRT and UAC -->
    <PropertyGroup>
        <LINKCTRL Condition="$(CLib)=='Dynamic' Or  $(Result)=='Program'">$(LINKCTRL) /MANIFEST</LINKCTRL>
        <LINKCTRL Condition="$(CLib)!='Dynamic' And $(Result)!='Program'">$(LINKCTRL) /MANIFEST:NO</LINKCTRL>
        <LINKCTRL Condition="$(Result)=='Program'">$(LINKCTRL) /MANIFESTUAC /MANIFESTUAC:uiAccess=\"false\"</LINKCTRL>
        <LINKCTRL Condition="$(Result)=='Program' And $(UACElevation)=='on'">$(LINKCTRL) /MANIFESTUAC:level=\"requireAdministrator\"</LINKCTRL>
        <LINKCTRL Condition="$(Result)=='Program' And $(UACElevation)!='on'">$(LINKCTRL) /MANIFESTUAC:level=\"asInvoker\"</LINKCTRL>
        <MT Condition="$(Result)=='Program'">$(MT);#1</MT>
        <MT Condition="$(CLib)=='Dynamic' And $(Result)=='Dynamic'">$(MT);#2</MT>
    </PropertyGroup>

    <!-- Configuration -->
    <PropertyGroup Condition ="$(Configuration)=='Release'">
        <RCCTRL>-DRELEASE</RCCTRL>
        <LINKCTRL>$(LINKCTRL) /RELEASE /LTCG</LINKCTRL>
        <LIBDEF>$(LIBDEF) /LTCG</LIBDEF>
    </PropertyGroup>
    <PropertyGroup Condition ="$(Configuration)!='Release'">
        <RCCTRL></RCCTRL>
    </PropertyGroup>

    <PropertyGroup Condition ="$(Debug)=='on'">
        <M2CTRL>$(M2CTRL) -SS</M2CTRL>
        <CLCTRL>$(CLCTRL)</CLCTRL>
        <CLCTRL Condition="$(CLib)=='Static'">$(CLCTRL) /MTd</CLCTRL>
        <CLCTRL Condition="$(CLib)=='Dynamic'">$(CLCTRL) /MDd</CLCTRL>
        <RCCTRL>$(RCCTRL) -DDEBUG</RCCTRL>
        <LINKCTRL>$(LINKCTRL) /DEBUG</LINKCTRL>
    </PropertyGroup>
    <PropertyGroup Condition ="$(Debug)!='on'">
        <M2CTRL>$(M2CTRL) -SD</M2CTRL>
        <CLCTRL>$(CLCTRL) /GL /O2</CLCTRL>
        <CLCTRL Condition="$(CLib)=='Static'">$(CLCTRL) /MT</CLCTRL>
        <CLCTRL Condition="$(CLib)=='Dynamic'">$(CLCTRL) /MD</CLCTRL>
        <RCCTRL>$(RCCTRL)</RCCTRL>
        <LINKCTRL>$(LINKCTRL) /DEBUG</LINKCTRL>
    </PropertyGroup>

    <PropertyGroup>
        <M2CTRL Condition ="$(CompilePublishExports)=='on'">$(M2CTRL) -LN$(CompileLibraryName) -LD</M2CTRL>
        <M2CTRL Condition ="$(CompilePublishExports)!='on'">$(M2CTRL) -LN$(CompileLibraryName)</M2CTRL>
        <M2TESTCTRL Condition ="$(Result)=='Static'">$(M2CTRL) -LN$(CompileLibraryName) -LD</M2TESTCTRL>
        <M2TESTCTRL Condition ="$(Result)!='Static'">$(M2CTRL) -LN$(CompileLibraryName)_test -LD</M2TESTCTRL>
    </PropertyGroup>

    <!-- INPUTS -->
    <Target Name="SplitComponentsForTools">
        <ItemGroup>
            <M2INPUTS Condition="%(Source.Definition)==$(ComponentDefinitionsSource)"
                      Include="@(Source -> '-I&quot;$(RootDir)\..\%(Identity)&quot;')" />
            <CLINPUTS Condition="%(Header.Definition)==$(ComponentDefinitionsSource)"
                      Include="@(Header -> '-I&quot;$(RootDir)\..\%(Identity)&quot;')" />
            <LINKINPUTLIBS Condition="%(Library.Definition)==$(ComponentDefinitionsSource)"
                        Include="@(Library -> '%(Identity)')"
                        Exclude="@(SelfInterface -> '%(Identity).lib')" /><!-- if linking, self lib cannot be used as source for objs, self is just going to be created -->
            <GrabbedMessages Condition="%(Message.Definition)==$(ComponentDefinitionsSource) And %(Message.LibraryName)==$(CompileLibraryName)"
                             Include="@(Message)" />
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <M2INPUTS>@(M2INPUTS, ' ')</M2INPUTS>
        <CLINPUTS>@(CLINPUTS, ' ') -I&quot;$(SDKInclude)&quot; -I&quot;$(CompilerInclude)&quot;</CLINPUTS>
        <RCINPUTS>-I&quot;..\$(ResourceDir)&quot;</RCINPUTS>
        <RCINPUTS>$(RCINPUTS) @(CLINPUTS, ' ') -I&quot;$(SDKInclude)&quot; -I&quot;$(CompilerInclude)&quot;</RCINPUTS>
        <LINKCTRL>$(LINKCTRL) /LIBPATH:&quot;$(SDKLib)&quot; /LIBPATH:&quot;$(CompilerLib)&quot; @(LINKINPUTLIBS, ' ')</LINKCTRL>
    </PropertyGroup>

    <!-- OUTPUT -->
    <PropertyGroup>
        <BUILDOUTPUT>/out:..\$(OutputFile)</BUILDOUTPUT>
        <ExportPath Condition="$(Export)!=''">$(SourceDir)\$(Export).def</ExportPath>
        <LIBEXPORT Condition="$(ExportPath)!=''">/def:&quot;..\$(ExportPath)&quot;</LIBEXPORT>
    </PropertyGroup>

    <!-- LANGUAGES -->
    <PropertyGroup Condition ="$(Language)=='Czech'">
        <RCLANG>-C1250</RCLANG>
    </PropertyGroup>
    <PropertyGroup Condition ="$(Language)!='Czech'">
        <RCLANG>-C1252</RCLANG>
    </PropertyGroup>

    <PropertyGroup Condition ="$(LanguageStyle)=='ANSI'">
        <M2LANG>-DUNICODE:off -CB</M2LANG>
        <CLLANG></CLLANG>
    </PropertyGroup>
    <PropertyGroup Condition ="$(LanguageStyle)!='ANSI'">
        <M2LANG>-DUNICODE:on -CW</M2LANG>
        <CLLANG>-DUNICODE</CLLANG>
    </PropertyGroup>

    <PropertyGroup>
        <M2CTRL Condition="$(ProductM2Control)!=''">$(M2CTRL) $(ProductM2Control)</M2CTRL>
        <CLCTRL Condition="$(ProductCLControl)!=''">$(CLCTRL) $(ProductCLControl)</CLCTRL>
        <RCCTRL Condition="$(ProductRCControl)!=''">$(RCCTRL) $(ProductRCControl)</RCCTRL>
        <LINKCTRL Condition="$(ProductLNControl)!=''">$(LINKCTRL) $(ProductLNControl)</LINKCTRL>
    </PropertyGroup>

    <!-- DEFINITIONS TOGETHER -->
    <PropertyGroup>
        <M2DEF>$(M2CTRL) $(M2LANG) $(M2INPUTS)</M2DEF>
        <M2TIMEDEF>-T -QI $(M2DEF)</M2TIMEDEF>
        <M2TESTDEF>$(M2TESTCTRL) $(M2LANG) $(M2INPUTS)</M2TESTDEF>
        <CLDEF>$(CLCTRL) $(CLLANG) $(CLINPUTS)</CLDEF>
        <RCDEF>$(RCCTRL) $(RCLANG) $(RCINPUTS)</RCDEF>
        <LINKDEF>$(LINKCTRL) $(BUILDOUTPUT)</LINKDEF>
        <LINKTEST>$(LINKCTRL)</LINKTEST>
        <LIBDEF>$(LIBDEF) $(BUILDOUTPUT)</LIBDEF>
    </PropertyGroup>

</Project>
