<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- compiler -->
    <PropertyGroup>
        <LicensingComponent>Licensing\Core</LicensingComponent>

        <LeakDetectorComponent>Debug\LeakDetector</LeakDetectorComponent>

        <TestComponent>Debug\Test</TestComponent>
        <TestFactoryName>testfactory</TestFactoryName>
    </PropertyGroup>

    <!-- defaults, which should be set in $(MSBuildProjectFile) -->
    <PropertyGroup>
        <Manufacturer Condition="$(Manufacturer)==''">SmartControl</Manufacturer>
        <DynamicCLibInstallMethod Condition="$(DynamicCLibInstallMethod)==''">Private</DynamicCLibInstallMethod><!-- Private Shared -->
    </PropertyGroup>

    <PropertyGroup Condition="$(ComponentType)=='Product'">
        <ProductId Condition="$(ProductId)==''">$(MSBuildProjectName)</ProductId>
        <ProductDisplayName Condition="$(ProductDisplayName)==''">$(FileDisplayName)</ProductDisplayName>
        <ProductDescription Condition="$(ProductDescription)==''">$(FileDescription)</ProductDescription>
    </PropertyGroup>
    <PropertyGroup>
        <!-- the assignment should be the same as for LibraryName -->
        <!-- primarily use self definitions (bundle does not have defintions file)... -->
        <SelfComponentDefinitionsPath Condition="$(ComponentType)!='Bundle'">$(MSBuildProjectDirectory)\$(MSBuildProjectName).definition.proj</SelfComponentDefinitionsPath>
        <ComponentDefinitionsPath>$(SelfComponentDefinitionsPath)</ComponentDefinitionsPath>
        <!-- ...and if I am controlled use global one -->
        <ComponentDefinitionsPath Condition="$(ComponentType)=='Generic'">$(InheritedComponentDefinitionsPath)</ComponentDefinitionsPath>
    </PropertyGroup>

    <!-- configuration depended on component definition-->
    <PropertyGroup>
        <SelfDefinitionFileExists>off</SelfDefinitionFileExists>
        <SelfDefinitionFileExists Condition="Exists('$(SelfComponentDefinitionsPath)')">on</SelfDefinitionFileExists>
        <DefintionFileExists>off</DefintionFileExists>
        <DefinitionFileExists Condition="Exists('$(ComponentDefinitionsPath)')">on</DefinitionFileExists>
    </PropertyGroup>
    <Import Condition="$(DefinitionFileExists)=='on'" Project="$(ComponentDefinitionsPath)"/>

    <!-- (constructed properties, DO NOT MODIFY) -->
    <Choose>
        <When Condition="$(ComponentType)=='Generic'">
            <PropertyGroup>
                <ProductFlag>off</ProductFlag>
                <PropagateComponents>on</PropagateComponents>
                <PropagateBuild>on</PropagateBuild>
                <DefinitionFileAllowed>off</DefinitionFileAllowed>
            </PropertyGroup>
        </When>
        <When Condition="$(ComponentType)=='Library'">
            <PropertyGroup>
                <ProductFlag>off</ProductFlag>
                <PropagateComponents>on</PropagateComponents>
                <PropagateBuild>off</PropagateBuild>
                <DefinitionFileAllowed>on</DefinitionFileAllowed>
            </PropertyGroup>
        </When>
        <When Condition="$(ComponentType)=='Module'">
            <PropertyGroup>
                <ProductFlag>off</ProductFlag>
                <PropagateComponents>off</PropagateComponents>
                <PropagateBuild>off</PropagateBuild>
                <DefinitionFileAllowed>on</DefinitionFileAllowed>
            </PropertyGroup>
        </When>
        <When Condition="$(ComponentType)=='Product'">
            <PropertyGroup>
                <ProductFlag>on</ProductFlag>
                <PropagateComponents>on</PropagateComponents>
                <PropagateBuild>off</PropagateBuild>
                <DefinitionFileAllowed>on</DefinitionFileAllowed>
            </PropertyGroup>
        </When>
        <When Condition="$(ComponentType)=='Bundle'">
            <PropertyGroup>
                <ProductFlag>on</ProductFlag>
                <PropagateComponents>on</PropagateComponents>
                <PropagateBuild>off</PropagateBuild>
                <DefinitionFileAllowed>off</DefinitionFileAllowed>
            </PropertyGroup>
        </When>
        <Otherwise>
            <PropertyGroup>
                <ProductFlag>off</ProductFlag>
                <PropagateComponents>on</PropagateComponents>
                <PropagateBuild>on</PropagateBuild>
                <DefinitionFileAllowed>off</DefinitionFileAllowed>
            </PropertyGroup>
        </Otherwise>
    </Choose>

    <!-- default compilation control, CAN BE MODIFIED here as GLOBAL, or in product $(ComponentDefinitions) file -->
    <PropertyGroup>
        <PlatformName Condition="$(PlatformName)==''">Win32</PlatformName>
        <ConfigurationName Condition="$(ConfigurationName)==''">Debug</ConfigurationName><!-- Release Debug -->
        <LanguageStyle Condition="$(LanguageStyle)==''">UNICODE</LanguageStyle><!-- ANSI UNICODE -->
        <Language Condition="$(Language)==''">Czech</Language><!-- English Czech German Japanese -->
        <CLib Condition="$(CLib)==''">Dynamic</CLib><!-- Static Dynamic --><!-- Static = LIBC, Dynamic = MSVCRT -->
        <Result Condition="$(Result)==''">Static</Result><!-- Static (LIB) Dynamic (DLL) Program (EXE) -->
        <LeakChecking Condition="$(LeakChecking)==''">off</LeakChecking>
        <CPPExceptions Condition="$(CPPExceptions)==''">on</CPPExceptions>
        <CopyRuntimes Condition="$(CopyRuntimes)==''">$(ProductFlag)</CopyRuntimes>

        <Test>off</Test>
    </PropertyGroup>

    <!-- (constructed properties, DO NOT MODIFY) -->
    <PropertyGroup>
        <ClientLicensing Condition="$(ClientLicensing)=='' Or $(ProductFlag)=='off'">off</ClientLicensing>
        <SetupLicensing Condition="$(SetupLicensing)=='' Or $(ProductFlag)=='off'">off</SetupLicensing>
        <ClientLicensing Condition="$(Licensing)=='on' And $(ProductFlag)=='on'">on</ClientLicensing>
        <SetupLicensing Condition="$(Licensing)=='on' And $(ProductFlag)=='on'">on</SetupLicensing>

        <PublishExports Condition="$(PublishExports)=='' And $(Result)=='Dynamic'">on</PublishExports>
        <PublishExports Condition="$(PublishExports)=='' And $(Result)!='Dynamic'">off</PublishExports>
    </PropertyGroup>

    <!-- (constructed properties, DO NOT MODIFY) -->
    <PropertyGroup Condition ="$(ConfigurationName)=='Release'">
        <Licensing Condition="$(Licensing)==''">off</Licensing>
        <Debug Condition="$(Debug)==''">off</Debug>
        <LeakChecking Condition="$(LeakChecking)==''">off</LeakChecking>
    </PropertyGroup>

    <!-- (constructed properties, DO NOT MODIFY) -->
    <PropertyGroup Condition ="$(ConfigurationName)!='Release'">
        <Licensing Condition="$(Licensing)==''">off</Licensing>
        <Debug Condition="$(Debug)==''">on</Debug>
        <LeakChecking Condition="$(LeakChecking)==''">off</LeakChecking>
    </PropertyGroup>

</Project>
