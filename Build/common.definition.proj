<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- environment definition -->
    <PropertyGroup>
        <SDKPath>C:\Program Files\Microsoft SDKs\Windows\v7.1</SDKPath>
        <CompilerPath>C:\Program Files (x86)\Microsoft Visual Studio 10.0\VC</CompilerPath>
        <!-- particular directories are constructed at the file end -->
        <!-- the latter properties depends on MSBuildBittness, not on Platform settings -->
        <BuildTask Condition="$(PROCESSOR_ARCHITECTURE)=='AMD64'">BuildTasks.x64.dll</BuildTask>
        <BuildTask Condition="$(PROCESSOR_ARCHITECTURE)!='AMD64'">BuildTasks.x86.dll</BuildTask>
    </PropertyGroup>

    <!-- compiler -->
    <PropertyGroup>
        <LicensingComponent>Licensing\Core</LicensingComponent>

        <LeakDetectorComponent>Debug\LeakDetector</LeakDetectorComponent>

        <TestComponent>Debug\Test</TestComponent>
        <TestFactoryName>testfactory</TestFactoryName>
    </PropertyGroup>

    <!-- defaults, which should be set in $(MSBuildProjectFile) -->
    <PropertyGroup>
        <Manufacturer Condition="$(Manufacturer)==''">SmartControl</Manufacturer>
        <DynamicCLibInstallMethod Condition="$(DynamicCLibInstallMethod)==''">Private</DynamicCLibInstallMethod><!-- Private Shared -->
        <ProjectId Condition="$(ProjectId)==''">$(MSBuildProjectName)</ProjectId>
        <ProductId Condition="$(ProductId)==''">$(ProjectId)</ProductId>
        <ProductVersion Condition="$(ProductVersion)==''">0.0.0</ProductVersion>
        <TestExec Condition="$(TestExec)==''">off</TestExec>
    </PropertyGroup>

    <PropertyGroup Condition="$(ComponentType)=='Product'">
        <ProductDisplayName Condition="$(ProductDisplayName)==''">$(ProjectDisplayName)</ProductDisplayName>
        <ProductDescription Condition="$(ProductDescription)==''">$(ProjectDescription)</ProductDescription>
    </PropertyGroup>
    
    <!-- 1. handle definitions file in separate file for clarity -->
    <Import Project="internal.definitionfile.targets"/>
    
    <!-- 2. constructed properties, DO NOT MODIFY -->
    <!-- meaning properties: -->
    <!--   PropagateComponents = allows GrabRecursion to nest deeply, it looks for child components of grabbed components. Usually wanted, but e.g. LeakDetector in some configurations need not offer them -->
    <!--   PropagateSources = component's DEF/H files will be available for descendant components -->
    <!--   PropagateDeliverables = component's binaries will be available for descendant components -->
    <!--   EncloseComponents = component XX is able to grab all childs YY and offer them as being XX -->
    <!--   Shared = component is shared among others upper components, it build only once in dependency tree -->
    <Choose>
        <When Condition="$(ComponentType)=='Generic'">
            <PropertyGroup>
                <PropagateComponents>on</PropagateComponents>
                <PropagateSources>on</PropagateSources>
                <PropagateDeliverables>off</PropagateDeliverables>
                <EncloseComponents>off</EncloseComponents>
                <Shared>off</Shared>
                <ProductFlag>off</ProductFlag>
            </PropertyGroup>
        </When>
        <When Condition="$(ComponentType)=='Library'">
            <PropertyGroup>
                <PropagateComponents>on</PropagateComponents>
                <PropagateSources>on</PropagateSources>
                <PropagateDeliverables>on</PropagateDeliverables>
                <EncloseComponents>on</EncloseComponents>
                <Shared>off</Shared>
                <ProductFlag>off</ProductFlag>
            </PropertyGroup>
        </When>
        <When Condition="$(ComponentType)=='SupportLibrary'"><!--library intended to be independent, usually not a part of product, e.g. for debug purposes -->
            <PropertyGroup>
                <PropagateComponents>off</PropagateComponents>
                <PropagateSources>on</PropagateSources>
                <PropagateDeliverables>on</PropagateDeliverables>
                <EncloseComponents>off</EncloseComponents>
                <Shared>on</Shared>
                <ProductFlag>off</ProductFlag>
            </PropertyGroup>
        </When>
        <When Condition="$(ComponentType)=='Deliverable'">
            <PropertyGroup>
                <PropagateComponents>on</PropagateComponents>
                <PropagateSources>on</PropagateSources>
                <PropagateDeliverables>on</PropagateDeliverables>
                <EncloseComponents>on</EncloseComponents>
                <Shared>on</Shared>
                <ProductFlag>off</ProductFlag>
            </PropertyGroup>
        </When>
        <When Condition="$(ComponentType)=='Product'">
            <PropertyGroup>
                <PropagateComponents>on</PropagateComponents>
                <PropagateSources>off</PropagateSources>
                <PropagateDeliverables>on</PropagateDeliverables>
                <EncloseComponents>off</EncloseComponents>
                <Shared>on</Shared>
                <ProductFlag>on</ProductFlag>
            </PropertyGroup>
        </When>
        <When Condition="$(ComponentType)=='Bundle'">
            <PropertyGroup>
                <PropagateComponents>on</PropagateComponents>
                <PropagateSources>off</PropagateSources>
                <PropagateDeliverables>off</PropagateDeliverables>
                <EncloseComponents>off</EncloseComponents>
                <Shared>on</Shared>
                <ProductFlag>on</ProductFlag>
            </PropertyGroup>
        </When>
        <Otherwise>
            <PropertyGroup>
                <PropagateComponents>off</PropagateComponents>
                <PropagateSources>off</PropagateSources>
                <PropagateDeliverables>on</PropagateDeliverables>
                <EncloseComponents>off</EncloseComponents>
                <Shared>off</Shared>
                <ProductFlag>off</ProductFlag>
            </PropertyGroup>
        </Otherwise>
    </Choose>

    <!-- 3. setup final component sources variables -->
    <PropertyGroup>
        <ComponentDefinitionsSource Condition="$(Shared)=='on'">$(ComponentName)</ComponentDefinitionsSource>
        <ComponentDefinitionsSource Condition="$(Shared)=='off' And $(InheritedDefinitionsFileExists)=='on'">$(InheritedComponentDefinitionsSource)</ComponentDefinitionsSource>
        <ComponentDefinitionsPath Condition="$(SelfDefinitionsFileExists)=='on'">$(SelfComponentDefinitionsPath)</ComponentDefinitionsPath>
        <ComponentDefinitionsPath Condition="$(SelfDefinitionsFileExists)=='off' And $(InheritedDefinitionsFileExists)=='on'">$(InheritedComponentDefinitionsPath)</ComponentDefinitionsPath>
    </PropertyGroup>
    
    <!-- 4. default compilation control, CAN BE MODIFIED here as GLOBAL, or in product $(ComponentDefinitions) file -->
    <PropertyGroup>
        <Platform Condition="$(Platform)==''">x86</Platform><!-- x86 x64 -->
        <Configuration Condition="$(Configuration)==''">Debug</Configuration><!-- Release Debug -->
        <LanguageStyle Condition="$(LanguageStyle)==''">UNICODE</LanguageStyle><!-- ANSI UNICODE -->
        <Language Condition="$(Language)==''">English</Language><!-- English Czech German Japanese -->
        <CLib Condition="$(CLib)==''">Private</CLib><!-- Static Dynamic Private --><!-- Static = LIBC, Dynamic = MSVCRT, Private = CCppSupp -->
        <Result Condition="$(Result)==''">Static</Result><!-- Static (LIB) Dynamic (DLL) Program (EXE) -->
        <ResultSubsystem Condition="$(ResultSubsystem)==''">Console</ResultSubsystem><!-- Console GUI -->
        <CPPExceptions Condition="$(CPPExceptions)==''">off</CPPExceptions>
        <LicenceMachineId Condition="$(LicenceMachineId)==''">M</LicenceMachineId><!-- M = MAC, D = disc, MD = MAC + Disc -->
        <StackReservation Condition="$(StackReservation)==''">65536</StackReservation>
        <UACElevation Condition="$(UACElevation)==''">off</UACElevation>
        <Test Condition="$(Test)=='' And $(ComponentName)==$(TestComponent)">off</Test><!-- do not refer test to test -->
        <Test Condition="$(Test)==''">on</Test>
    </PropertyGroup>

    <ItemGroup>
        <BuildVersionSource Condition="@(BuildVersionSource)==''" Include="$(ComponentName)"/><!-- if some component uses version from another source, e.g. SCCore from Library, fill it -->
    </ItemGroup>

    <!-- 4b. adjust internal components -->
    <PropertyGroup Condition="$(ComponentName)==$(LeakDetectorComponent)">
        <Result>Dynamic</Result><!-- LeakDetector must always be dynamic (it uses DllMain heavily). -->
    </PropertyGroup>
    <PropertyGroup Condition="$(ComponentName)==$(TestComponent)">
        <Result>Dynamic</Result><!-- Test must always be dynamic. -->
    </PropertyGroup>
    
    <!-- (constructed properties, DO NOT MODIFY) -->
    <PropertyGroup>
        <ClientLicensing Condition="$(ClientLicensing)=='' Or $(ProductId)==''">off</ClientLicensing>
        <ClientLicensingType Condition="$(ClientLicensingType)==''">Host</ClientLicensingType><!-- Host, Plugin -->
        <SetupLicensing Condition="$(SetupLicensing)=='' Or $(ProductFlag)=='off'">off</SetupLicensing>
        <ClientLicensing Condition="$(Licensing)=='on' And $(ProductFlag)=='on'">on</ClientLicensing>
        <SetupLicensing Condition="$(Licensing)=='on' And $(ProductFlag)=='on'">on</SetupLicensing>

        <PublishExports Condition="$(PublishExports)=='' And $(Result)=='Dynamic'">on</PublishExports>
        <PublishExports Condition="$(PublishExports)==''">off</PublishExports>
    </PropertyGroup>

    <!-- (constructed properties, DO NOT MODIFY) -->
    <PropertyGroup Condition ="$(Configuration)=='Release'">
        <Licensing Condition="$(Licensing)==''">off</Licensing>
        <Debug Condition="$(Debug)==''">off</Debug>
        <LeakChecking Condition="$(LeakChecking)==''">off</LeakChecking>
    </PropertyGroup>

    <!-- (constructed properties, DO NOT MODIFY) -->
    <PropertyGroup Condition ="$(Configuration)!='Release'">
        <Licensing Condition="$(Licensing)==''">off</Licensing>
        <Debug Condition="$(Debug)==''">on</Debug>
        <LeakChecking Condition="$(LeakChecking)==''">off</LeakChecking>
    </PropertyGroup>

    <!-- (constructed properties, modify only SUBDIRECTORIES, if needed) -->
    <PropertyGroup Condition="$(Platform)=='x86'">
        <SDKInclude>$(SDKPath)\Include</SDKInclude>
        <SDKLib>$(SDKPath)\Lib</SDKLib>
        <SDKBin>$(SDKPath)\Bin</SDKBin>
        <SDKCommonBin>$(SDKPath)\Bin</SDKCommonBin>
        <CompilerInclude>$(CompilerPath)\Include</CompilerInclude>
        <CompilerLib>$(CompilerPath)\Lib</CompilerLib>
        <CompilerBin>$(CompilerPath)\Bin</CompilerBin>
    </PropertyGroup>
    <PropertyGroup Condition="$(Platform)=='x64'">
        <SDKInclude>$(SDKPath)\Include</SDKInclude>
        <SDKLib>$(SDKPath)\Lib\x64</SDKLib>
        <SDKBin>$(SDKPath)\Bin\x64</SDKBin>
        <SDKCommonBin>$(SDKPath)\Bin</SDKCommonBin>
        <CompilerInclude>$(CompilerPath)\Include</CompilerInclude>
        <CompilerLib>$(CompilerPath)\Lib\amd64</CompilerLib>
        <CompilerBin>$(CompilerPath)\Bin\amd64</CompilerBin>
    </PropertyGroup>
    
</Project>
