<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets="Build">

    <!-- common properties -->
    <PropertyGroup>
        <!-- directories -->
        <SourceDir>Source</SourceDir>
        <ResourceDir>Resource</ResourceDir>
        <ResourceFile>$(ResourceDir)\$(MSBuildProjectName).rc</ResourceFile>
        <ResourceFile Condition="!Exists('$(ResourceFile)')"></ResourceFile>
        <SetupDir>Install</SetupDir>

        <OutputDirName>!$(Configuration).$(Platform)</OutputDirName>
        <IntermediateDirName>!Build.$(Configuration).$(Platform)</IntermediateDirName>
        <HeaderDirName>$(IntermediateDirName)</HeaderDirName>

        <OutputDir>$(OutputDirName)</OutputDir>
        <OutputPath>$(ComponentPath)\$(OutputDirName)</OutputPath>

        <IntermediateDir>$(IntermediateDirName)</IntermediateDir>
        <HeaderDir>$(HeaderDirName)</HeaderDir>
        
        <!-- default entered export is overwritten -->
        <OriginalExport>$(Export)</OriginalExport>

        <!-- M2 initializing code -->
        <Modula2InitCode>$(RootDir)\Modula2\Modula2\Header\m2init.cpp</Modula2InitCode>

        <!-- licensing -->
        <LicensingSourceDir>$(SourceDir)</LicensingSourceDir>
        <ProductLicenceFile>$(OutputDir)\$(ProductId).tlic</ProductLicenceFile>

        <!-- COM -->
        <TypeLibFile Condition="$(TypeLibrary)!=''">$(SourceDir)\$(TypeLibrary).idl</TypeLibFile>
        <TypeLibHeader Condition="$(TypeLibrary)!=''">$(TypeLibrary)_i.h</TypeLibHeader>
        <TypeLibCPP Condition="$(TypeLibrary)!=''">$(TypeLibrary)_i.c</TypeLibCPP>
        <TypeLibOBJ Condition="$(TypeLibrary)!=''">$(TypeLibrary)_i.obj</TypeLibOBJ>
        <TLBFile Condition="$(TypeLibrary)!=''">$(TypeLibrary).tlb</TLBFile>
    </PropertyGroup>

    <!-- outputs -->
    <PropertyGroup>
        <InterfaceName>$(ComponentRelativePath)\$(OutputDir)\$(MSBuildProjectName)</InterfaceName><!-- !! without .lib -->

        <!-- result name may be changed by owned project -->
        <ResultName Condition="$(ResultName)==''">$(MSBuildProjectName)</ResultName>

        <OutputName Condition="$(OutputName)=='' And $(Result)=='Static'">$(ResultName).lib</OutputName>
        <OutputName Condition="$(OutputName)=='' And $(Result)=='Dynamic'">$(ResultName).dll</OutputName>
        <OutputName Condition="$(OutputName)=='' And $(Result)=='Program'">$(ResultName).exe</OutputName>
        <OutputPDBName Condition="$(OutputPDBName)=='' And $(Result)!='Static'">$(ResultName).pdb</OutputPDBName>
        <OutputMAPName Condition="$(OutputMAPName)=='' And $(Result)!='Static'">$(ResultName).map</OutputMAPName>
        <OutputFile>$(OutputDir)\$(OutputName)</OutputFile>
        <OutputFilePath>$(OutputPath)\$(OutputName)</OutputFilePath>
        <OutputPDBFilePath Condition="$(OutputPDBName)!=''">$(OutputPath)\$(OutputPDBName)</OutputPDBFilePath>
        <OutputMAPFilePath Condition="$(OutputMAPName)!=''">$(OutputPath)\$(OutputMAPName)</OutputMAPFilePath>
    </PropertyGroup>

    <!-- testing support -->
    <Import Project="internal.test.targets"/>

    <!-- compilation programs and parameters -->
    <Import Project="internal.compilation.targets"/>

    <!-- grabbing data from used components -->
    <Import Project="internal.grabbing.targets"/>
    
    <!-- build control -->
    <PropertyGroup>
        <!-- recursive child parameters -->
        <InheritedProperties>InheritedManufacturer=$(Manufacturer);InheritedProductVersion=$(ProductVersion);InheritedBuildDependenciesFile=$(BuildDependenciesFile)</InheritedProperties>
        <ChildParameters>ProductId=$(ProductId);$(InheritedProperties)</ChildParameters>
    </PropertyGroup>
    
    <!-- file names, sources, outputs -->
    <ItemGroup>
        <TemporaryDirectories Condition="$(HeaderDirName)!=$(IntermediateDirName)" Include="$(HeaderDir);$(IntermediateDir)" />
        <TemporaryDirectories Condition="$(HeaderDirName)==$(IntermediateDirName)" Include="$(IntermediateDir)" />

        <!-- resources -->
        <MessagesDir Include="@(Messages -> '$(SourceDir)\%(Filename).xrs')"/>
        <MessagesDefDir Include="@(Messages -> '$(SourceDir)\%(Filename).def')"/>
        <!-- add messages DEF between normal DEF -->
        <!-- !!! IT IS SAFER TO HAVE MESSAGES FIRST -->
        <DEFFiles Include = "@(Messages -> '%(Filename).def')" />
        <DEFFilesDir Include = "@(MessagesDefDir)" />

        <DEFs Include = "@(Definitions);@(Modules)" />
        <DEFFiles Include = "@(DEFs -> '%(Filename).def')" />
        <DEFFilesDir Include = "@(DEFs -> '$(SourceDir)\%(Filename).def')" />

        <MODs Include = "@(Modules);@(Program)" />
        <MODFiles Include = "@(MODs -> '%(Filename).mod')" />
        <MODFilesDir Include = "@(MODs -> '$(SourceDir)\%(Filename).mod')" />

        <HeadersDir Include="@(Definitions -> '$(HeaderDir)\%(Filename).h')"/>
    </ItemGroup>

    <!-- add licensing files between normal DEF/MOD -->
    <ItemGroup Condition="$(ClientLicensing)=='on'">
        <DEFFiles Include = "cllv.def" />
        <DEFFilesDir Include = "$(SourceDir)\cllv.def" />
        <MODFiles Include = "cllv.mod" />
        <MODFilesDir Include = "$(SourceDir)\cllv.mod" />
        <LicensingSourceDef Include="$(SourceDir)\cllv.def"/><!-- it is used in condition of LicensingSource task -->
        <LicensingSourceFiles Include="@(LicensingSourceDef);$(SourceDir)\cllv.mod"/>
    </ItemGroup>

    <!-- intermediates -->
    <ItemGroup>
        <EnclosedComponents Condition="$(EncloseComponents)=='on' And $(Result)=='Dynamic'"
                            Include="@(Components)"/>
        <!-- EncloseComponent component is component, which condensates together more generic components to single library (DLL), it
             must propagate interfaces (DEF, H) to users transparently -->
        
        <CPPs Include="@(MODFiles -> '%(Filename).cpp')" />
        <CPPsDir Include="@(MODFiles -> '$(IntermediateDir)\%(Filename).cpp')" />
        <CPPsDir Condition="$(TypeLibCPP) !=''" Include="$(IntermediateDir)\$(TypeLibCPP)" />
        <CPPsDir Condition="$(Result)!='Static' And $(Modula2InitCode)!=''" Include="$(IntermediateDir)\m2init.cpp"/>

        <Objects Include="@(MODFiles -> '$(IntermediateDir)\%(Filename).obj')" />
        <Objects Condition="$(TypeLibOBJ) !=''" Include="$(TypeLibOBJ)" />
        <Objects Condition="$(Grabbing)!='on' And $(Result)!='Static' And (@(EnclosedComponents)!='' Or @(Objects)!='') And $(Modula2InitCode)!=''"
                 Include="$(IntermediateDir)\m2init.obj"/>

        <RESFile Condition="$(Result)!='Static' And (@(EnclosedComponents)!='' Or @(Objects)!='')"
                 Include="$(IntermediateDir)\$(MSBuildProjectName).res" />

        <SelfInterface Condition="$(Result)!='Program' And (@(EnclosedComponents)!='' Or @(MODFiles)!='' Or $(ExportPath)!='')" Include="..\$(InterfaceName)"/><!-- using MODFiles instead of Objects denies exporting of LIB if only m2init.obj is created. -->
        <!-- SelfInterface/Interface: Interface could be extended by project to export some interfaces, e.g. Ws32, msxml, etc. -->

        <MessagesBin Condition="@(Messages)!=''" Include="@(Messages -> '$(IntermediateDir)\$(MSBuildProjectName).%(FileName).brs')"/>
    </ItemGroup>

    <!-- inner, invisible targets -->
    <Target Name="Environment">
        <Error Condition="@(Objects)!='' And $(ProjectDescription)==''"
               Text="Required 'ProjectDescription' property is not defined (project $(MSBuildProjectName))."
               HelpKeyword="ProjectDescription"/>
        <Error Condition="@(EnclosedComponents)!='' And $(OriginalExport)!=''"
               Text="Both 'EnclosedComponents' and 'Export' keys are defined, this is not allowed. Select only one of them. (project $(MSBuildProjectName))."
               HelpKeyword="EnclosedComponents"/>
        <Error Condition="$(CPPExceptions)=='on' And $(CLib)=='Private'"
               Text="Private CLib does not support native CPP exceptions, switch native exceptions off or use Static or Dynamic CLib."
               HelpKeyword="CLib"/>
        <Error Condition="$(ComponentName)==$(LeakDetectorComponent) And $(Result)!='Dynamic'"
               Text="LeakDetector must always be a DLL, it cannot be used as a Library"
               HelpKeyword="LeakDetector"/>
    </Target>


    <!-- default version info -->
    <PropertyGroup>
        <ProjectVersionMajor Condition="$(ProjectVersionMajor)==''">1</ProjectVersionMajor>
        <ProjectVersionMinor Condition="$(ProjectVersionMinor)==''">0</ProjectVersionMinor>
        <ProjectVersionRevision Condition="$(ProjectVersionRevision)==''">0</ProjectVersionRevision>
        <ProductVersionMajor Condition="$(ProductVersionMajor)==''">$(ProjectVersionMajor)</ProductVersionMajor>
        <ProductVersionMinor Condition="$(ProductVersionMinor)==''">$(ProjectVersionMinor)</ProductVersionMinor>
        <ProductVersionRevision Condition="$(ProductVersionRevision)==''">$(ProjectVersionRevision)</ProductVersionRevision>
    </PropertyGroup>

    <!-- build number -->
    <Target Name="LoadRevisions">
        <HgVersion Condition="%(Identity)!=''" LocalPath="@(BuildVersionSource -> '$(RootDir)\%(Identity)')">
            <Output TaskParameter="Revision" ItemName="VersionBuilds"/>
            <Output TaskParameter="RevisionId" ItemName="RevisionIds"/>
        </HgVersion>
        <Error Condition="@(RevisionIds)=='&lt;unversioned&gt;'"
               Text="@(BuildVersionSource) is not versioned, unable to get product revision (check case of referenced project names)." />
    </Target>
    
    <Target Name="DoProductBuildNumberGet"
            Condition="$(ProductFlag)=='on'"
            DependsOnTargets="LoadRevisions">
        <MinMax Input="@(VersionBuilds)">
            <Output TaskParameter="Maximum" PropertyName="ProductVersionBuild"/>
        </MinMax>
        <PropertyGroup>
            <ProductVersion>$(ProductVersionMajor).$(ProductVersionMinor).$(ProductVersionBuild)</ProductVersion>
        </PropertyGroup>
    </Target>

    <Target Name="DoDummyProductBuildNumberGet" Condition="$(ProductFlag)!='on'">
        <PropertyGroup>
            <ProductVersion Condition="$(InheritedProductVersion)!=''">$(InheritedProductVersion)</ProductVersion>
        </PropertyGroup>
    </Target>

    <Target Name="ProductBuildNumberGet"
            DependsOnTargets="DoDummyProductBuildNumberGet;DoProductBuildNumberGet">
        <PropertyGroup>
            <M2PROD>-DProductId:$(CompileProductId) -DProductVersion:$(ProductVersion)</M2PROD>
        </PropertyGroup>
    </Target>

    <!-- resources default -->
    <UsingTask TaskName="SvnVersion" AssemblyFile="$(BuildTask)"/>
    <UsingTask TaskName="HgVersion" AssemblyFile="$(BuildTask)"/>
    <UsingTask TaskName="MinMax" AssemblyFile="$(BuildTask)"/>
    <UsingTask TaskName="Item" AssemblyFile="$(BuildTask)"/>
    <Import Project="internal.resource.targets"/>


    <!-- start of pure build targets -->
    <Target Name="Directories">
        <MakeDir Directories="@(TemporaryDirectories);$(OutputDir)" />
    </Target>


    <Target Name="MessagesDef" Inputs="@(MessagesDir)" Outputs="@(MessagesDefDir)">
        <Exec Command="$(XRSDEF) @(MessagesDir, ' ')"/>
    </Target>


    <Target Condition="$(ClientLicensing)=='on' And !Exists(@(LicensingSourceDef))"
            Name="LicensingSource"
            Outputs="@(LicensingSourceFiles)">
        <!-- Message Importance="high" Text="$(ClientLicensingType)=='Host': $(ProductId) else: $(ProjectId)" / -->
        <Exec Condition="$(ClientLicensingType)=='Host'"
              WorkingDirectory="$(LicensingSourceDir)"
              Command="$(LICSRC) $(ProductId)"/>
        <Exec Condition="$(ClientLicensingType)=='Plugin'"
              WorkingDirectory="$(LicensingSourceDir)"
              Command="$(LICSRC) $(ProjectId)"/>
    </Target>


    <Target Name="PrepareIDL" Inputs="$(TypeLibFile)" Outputs="$(IntermediateDir)\$(TypeLibCPP)">
        <Exec WorkingDirectory="$(IntermediateDir)"
              Command="midl /tlb $(TLBFile) /header $(TypeLibHeader) ..\$(TypeLibFile)"/>
    </Target>


    <Target Name="GrabOutOfDateFiles" Condition="@(DEFFiles)!='' Or @(MODFiles)!=''">
        <Exec WorkingDirectory="$(SourceDir)"
              Command="$(M2D) $(M2PROD) $(M2TIMEDEF) -O&quot;..\$(IntermediateDir)&quot; @(DEFFiles, ' ') @(MODFiles, ' ')"/>
        <ReadLinesFromFile File="$(IntermediateDir)\OutOfDate.DEF.log">
            <Output TaskParameter="Lines" ItemName="OutOfDateDEFs"/>
        </ReadLinesFromFile>
        <ReadLinesFromFile File="$(IntermediateDir)\OutOfDate.MOD.log">
            <Output TaskParameter="Lines" ItemName="OutOfDateMODs"/>
        </ReadLinesFromFile>
    </Target>
    <Target Name="TouchOutOfDateFiles">
        <Touch Condition="@(OutOfDateDEFs)!=''" Files="@(OutOfDateDEFs -> '$(SourceDir)\%(Identity)')" />
        <Touch Condition="@(OutOfDateMODs)!=''" Files="@(OutOfDateMODs -> '$(SourceDir)\%(Identity)')" />
    </Target>


    <Target Name="ComponentCPPs" Condition="(@(DEFFiles)!='' or @(MODFiles)!='')"
            Inputs="@(DEFFilesDir);@(MODFilesDir)"
            Outputs="@(DEFFilesDir -> '$(HeaderDir)\%(Filename).h');@(MODFilesDir -> '$(IntermediateDir)\%(Filename).cpp')">
        <Exec WorkingDirectory="$(SourceDir)"
              Command="$(M2) $(M2PROD) $(M2DEF) -O&quot;..\$(IntermediateDir)&quot; @(DEFFilesDir -> '%(FileName).def', ' ') @(MODFilesDir -> '%(FileName).mod', ' ')"/>
    </Target>

    <Target Name="Modula2InitCPP"
            Condition="($(Result)!='Static' Or $(Test)=='on') And $(Modula2InitCode)!=''"
            Inputs="$(Modula2InitCode)"
            Outputs="$(IntermediateDir)\m2init.cpp">
        <Copy SourceFiles="$(Modula2InitCode)"
              DestinationFiles="$(IntermediateDir)\m2init.cpp"/>
    </Target>

    <PropertyGroup>
        <CompileCPPsDEP>$(UserPreCPP);Modula2InitCPP;ComponentCPPs</CompileCPPsDEP>
    </PropertyGroup>
    <Target Name="ComponentObjects" Condition="@(CPPsDir)!=''"
            DependsOnTargets="$(UserPreCompile);MessagesDef;LicensingSource;GrabOutOfDateFiles;TouchOutOfDateFiles;$(CompileCPPsDEP);$(UserPostCPP);$(UserPreOBJ)"
            Inputs="@(CPPsDir)" Outputs="@(CPPsDir -> '$(IntermediateDir)\%(Filename).obj')">
        <Exec WorkingDirectory="$(IntermediateDir)"
              Command="$(CL) $(CLDEF) @(CPPsDir ->'%(FileName)%(Extension)', ' ')"/>
    </Target>

    
    <Target Name="MessagesBin" Inputs="@(MessagesDir)" Outputs="@(MessagesBin)">
        <Exec Command="$(XRSBIN) @(MessagesDir, ' ')"/>
    </Target>

    <Target Name="CheckRevision"
            DependsOnTargets="LoadRevisions">
        <MinMax Input="@(VersionBuilds)">
            <Output TaskParameter="Maximum" PropertyName="ProjectVersionBuild"/>
            <Output TaskParameter="MaximumIndex" PropertyName="ProductVersionBuildIndex"/>
        </MinMax>
        <Item Input="@(RevisionIds)" Index="$(ProductVersionBuildIndex)">
            <Output TaskParameter="Output" PropertyName="ProjectRevisionId"/>
        </Item>

        <ReadLinesFromFile File="$(IntermediateDir)\internal.buildRevision" ContinueOnError="true">
            <Output TaskParameter="Lines" PropertyName="LastRev"/>
        </ReadLinesFromFile>

        <Delete Condition="$(ProjectVersionBuild)!=$(LastRev)"
                Files="$(RCFile)"/>
        <Delete Condition="$(ProjectVersionBuild)!=$(LastRev) And $(ClientLicensing)"
                Files="@(LicensingSourceFiles)"
                ContinueOnError="true"/>
        <Delete Condition="$(ProjectVersionBuild)!=$(LastRev) And $(SetupLicensing)"
                Files="$(ProductLicenceFile)"
                ContinueOnError="true"/>

        <WriteLinesToFile Condition="$(ProjectVersionBuild)!=$(LastRev)"
                          File="$(IntermediateDir)\internal.buildRevision"
                          Lines="$(ProjectVersionBuild)"
                          Overwrite="true"/>
    </Target>

    <Target Name="BuildResources"
            Condition="$(Result)!='Static'"
            DependsOnTargets="PrepareIDL;CreateRCFile"
            Inputs="$(RCFile)"
            Outputs="@(RESFile)">
        <Exec WorkingDirectory="$(IntermediateDir)"
              Command="$(RC) $(RCDEF) /fo&quot;@(RESFile -> '%(Filename).res')&quot; ..\$(RCFile)"/>
    </Target>

    <Target Name="Resources" DependsOnTargets="MessagesBin;CreateRCFileInput;BuildResources" />


    <Target Name="GetEnclosedComponentsObjects"
            Condition="@(EnclosedComponents)!=''"
            Outputs="@(EnclosedComponentsObjects)">
        <MSBuild Projects="@(EnclosedComponents -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Properties="Grabbing=on;$(ChildParameters)"
                 Targets="GrabEnclosedComponentsObjects">
            <Output TaskParameter="TargetOutputs" ItemName="EnclosedComponentsObjects"/>
        </MSBuild>

        <!-- Message Text="## @(EnclosedComponentsObjects)" Importance="high" /-->
    </Target>

    <Target Name="ComponentCode"
            Condition="@(EnclosedComponents)!='' Or @(Objects)!='' Or $(ExportPath)!=''"
            DependsOnTargets="Resources;$(UserPostRES);ComponentObjects;$(UserPostOBJ)"
            Inputs="@(Objects);@(EnclosedComponentsObjects);@(RESFile);@(LinkDependencyLibraries);$(ExportPath)"
            Outputs="$(OutputFile)">
        <Exec Condition="$(Result)=='Dynamic'"
              WorkingDirectory="$(IntermediateDir)"
              Command="$(LINK) /dll $(LINKDEF) $(LIBEXPORT) @(EnclosedComponentsObjects -> '..\%(Identity)', ' ') @(Objects -> '%(Filename).obj', ' ') @(RESFile -> '%(Filename).res') @(Libraries -> '%(Filename).lib', ' ')"/>
        <Exec Condition="$(Result)=='Static'"
              WorkingDirectory="$(IntermediateDir)"
              Command="$(LIB) $(LIBDEF) $(LIBEXPORT) @(Objects -> '%(Filename).obj', ' ')"/>
        <Exec Condition="$(Result)=='Program'"
              WorkingDirectory="$(IntermediateDir)"
              Command="$(LINK) $(LINKDEF) $(LIBEXPORT) @(Objects -> '%(Filename).obj', ' ') @(RESFile -> '%(Filename).res') @(Libraries -> '%(Filename).lib', ' ')"/>
        <Exec Condition="$(Result)=='Program' Or ($(Result)=='Dynamic' And $(CLib)=='Dynamic')"
              Command="$(MT)"/>
    </Target>

    <Target Name="ComponentRuntimes"
            Condition="$(ProductFlag)=='on'"
            Inputs="@(Runtime)"
            Outputs="@(Runtime -> '$(OutputDir)\%(FileName)%(Extension)')">
        <Copy Condition="%(Runtime.Definition)==$(ComponentDefinitionsSource) And %(Runtime.Definition)!=%(Runtime.OfComponent)"
              SourceFiles="@(Runtime)"
              DestinationFiles="@(Runtime -> '$(OutputDir)\%(FileName)%(Extension)')"
              SkipUnchangedFiles="true"
              ContinueOnError="false" />
    </Target>

    <Target Name="ComponentSign"
            Condition="$(Sign)!='off' And
                       $(SignCertificatePath)!='' And (
                         @(EnclosedComponents)!='' Or @(Objects)!=''
                       )"
            DependsOnTargets="ComponentCode"
            Inputs="$(OutputFile)"
            Outputs="$(IntermediateDir)\internal.signTimestamp">
        <Exec Condition="$(Result)=='Program' Or $(Result)=='Dynamic'"
              Command="&quot;$(SDKCommonBin)\signtool&quot; sign /f $(SignCertificatePath) /p $(SignCertificatePassword) /t http://timestamp.comodoca.com/authenticode $(OutputFile)"
              ContinueOnError="true"/>
        <WriteLinesToFile File="$(IntermediateDir)\internal.signTimestamp"
                          Lines="---"
                          Overwrite="true"/>
    </Target>

    <Import Project="internal.licence.targets"/>
    <Target Name="BuildProductLicence"
            Condition="$(SetupLicensing)=='on'"
            DependsOnTargets="CreateProductLicenceFile"
            Inputs="$(ProductLicenceFile)"
            Outputs="$(IntermediateDir)\internal.licenceTimestamp">
        <Exec WorkingDirectory="$(OutputDir)"
              Command="$(LICSIGN) *.tlic"/>
        <WriteLinesToFile File="$(IntermediateDir)\internal.licenceTimestamp"
                          Lines="---"
                          Overwrite="true"/>
    </Target>
    
    <Target Name="ComponentTest"
            DependsOnTargets="ComponentTestMessage;ComponentTestIncludes;ComponentTestBuild;ComponentTestExec"/>

    <Target Name="Component"
            DependsOnTargets="CheckRevision;GetEnclosedComponentsObjects;ComponentCode;ComponentRuntimes;ComponentSign;ComponentTest;BuildProductLicence"/>


    <Target Name="CleanIfDefinitionsSourceHasChanged">
        <!-- check what was compiled for last -->
        <ReadLinesFromFile File="$(IntermediateDir)\internal.builtFor">
            <Output TaskParameter="Lines" ItemName="LastCompiledFor"/>
        </ReadLinesFromFile>
        <PropertyGroup>
            <NeedToClean>off</NeedToClean>
            <NeedToClean Condition="@(LastCompiledFor)!='' And @(LastCompiledFor)!=$(ComponentDefinitionsSource)">on</NeedToClean>
        </PropertyGroup>

        <!-- clean self I was compiled for somebody else - embedded clean -->
        <Message Condition="$(NeedToClean)=='on'" Importance="high" Text="Cleaning to force new compile, previously built for: @(LastCompiledFor)"/>

        <RemoveDir Condition="$(NeedToClean)=='on'"
                   Directories="@(TemporaryDirectories)"
                   ContinueOnError="true" />
        <Delete Condition="$(NeedToClean)=='on'"
                Files="@(LicensingSourceFiles)"
                ContinueOnError="true" />
        <MakeDir Directories="@(TemporaryDirectories)" /><!-- CallTarget Targets="Directories" is unusable as it could be considered as done, even if folders do not exist -->

        <!-- mark definitions file I am build for -->
        <WriteLinesToFile File="$(IntermediateDir)\internal.builtFor"
                          Lines="$(ComponentDefinitionsSource)"
                          Overwrite="true"/>
    </Target>
    
    <Target Name="DisplayComponentsToBuild">
        <Message Condition="$(ComponentDefinitionsSource)==''" Importance="high" Text="Building (for no def file): $(MSBuildProjectName)" />
        <Message Condition="$(ComponentDefinitionsSource)!=''" Importance="high" Text="Building (for $(ComponentDefinitionsSource)): $(MSBuildProjectName)" />
        <!-- Message Importance="high" Text="Dependencies: $(BuildDependenciesFile)" / -->
        <!-- Message Importance="high" Text="Sources: @(M2INPUTS)" / -->
    </Target>
    
    <Target Name="BuildWithPreparedDependencies"
            DependsOnTargets="Environment;DisplayComponentsToBuild;ProductBuildNumberGet;CleanIfDefinitionsSourceHasChanged;Directories;SplitComponentsForTools;$(UserPreBuild);Component;$(UserPostBuild)"
            Outputs="@(Compiled)">
        <ItemGroup>
            <Compiled Condition="@(Objects)!='' And $(Result)!='Static'"
                      Include="$(OutputPath)\$(OutputName)" />
        </ItemGroup>

        <Message Condition="$(ComponentDefinitionsSource)==''" Importance="high" Text="Built (for no def file): $(MSBuildProjectName)" />
        <Message Condition="$(ComponentDefinitionsSource)!=''" Importance="high" Text="Built (for $(ComponentDefinitionsSource)): $(MSBuildProjectName)" />
    </Target>
    
    <Target Name="OnErrorHandler">
        <!-- Cleanup -->
        <CallTarget Targets="CleanupDependenciesFile"/>
        <Message Importance="high" Text="Build FAILED.%07%07" />
    </Target>
    
    <!-- outer, visible targets -->

    <Target Name="Clean">
        <RemoveDir Directories="@(TemporaryDirectories)"
                   ContinueOnError="true" />
        <Delete Condition="$(ClientLicensing)=='on'"
                Files="@(LicensingSourceFiles)"
                ContinueOnError="true" />
    </Target>

    <Target Name="CleanAll"
            DependsOnTargets="GrabComponents">
        <!-- flatten components to list of all components (notwithstanding the fact they can belong to many definition files) -->
        <ItemGroup>
            <ToCleanUnflattened Condition="%(Grabbed.Type)=='Component'"
                                Include="@(Grabbed)" />
        </ItemGroup>
        <RemoveDuplicates Inputs="@(ToCleanUnflattened)">
            <Output TaskParameter="Filtered" ItemName="ToClean"/>
        </RemoveDuplicates>
        
        <!-- clean them all -->
        <Message Importance="high"
                 Text="Components to clean for $(ComponentName): @(ToClean -> '%(FileName)', ' ' )"/>
        <Message Importance="high" Text=" " />
        <MSBuild Projects="@(ToClean -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Targets="Clean" />

        <!-- clean self too -->
        <CallTarget Targets="Clean"/>
    </Target>


    <Target Name="Build"
            DependsOnTargets="GrabComponents"
            Outputs="@(Compiled)">
        <!-- Use msbuild with properties to load dependencies file!!, also properties normally coming from Grabbed must be supplied.
             If Properties were not specified, MSBuild would not reload file/dependecies, what is innapropriate!! -->
        <MSBuild Projects="$(MSBuildProjectFile)"
                 Targets="BuildWithPreparedDependencies"
                 Properties="Root=true;CompilePublishExports=$(PublishExports);CompileLibraryName=$(ResultName)"
                 StopOnFirstFailure="true" >
            <Output TaskParameter="TargetOutputs" ItemName="Compiled"/>
        </MSBuild>

        <!-- Cleanup -->
        <CallTarget Targets="CleanupDependenciesFile"/>

        <OnError ExecuteTargets="OnErrorHandler" />
    </Target>

    <Target Name="BuildAll"
            DependsOnTargets="GrabComponents"
            Outputs="@(Compiled)">
        <!-- build all components in groups per definition file -->
        <Message Condition="%(Grabbed.Definition)!='.' And %(Grabbed.Type)=='Component'"
                 Importance="high"
                 Text="Components to build for %(Grabbed.Definition): @(Grabbed -> '%(Filename)', ' ' )"/>
        <Message Importance="high" Text=" " />
        
        <MSBuild Condition="%(Grabbed.Definition)!='.' And %(Grabbed.Type)=='Component'"
                 Projects="@(Grabbed -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Targets="BuildWithPreparedDependencies"
                 Properties="Root=false;$(ChildParameters)"
                 StopOnFirstFailure="true" >
            <Output TaskParameter="TargetOutputs" ItemName="Compiled"/>
        </MSBuild>

        <!-- build me too -->
        <CallTarget Targets="Build"/>
        
        <Message Importance="high" Text="Build SUCCEEDED.%07" />
        <OnError ExecuteTargets="OnErrorHandler" />
    </Target>


    <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
    <Target Name="RebuildAll" DependsOnTargets="CleanAll;BuildAll" />


    <!-- installation tasks -->
    <Import Project="internal.wix.targets"/>

    <Target Name="CheckSetup">
        <Error Condition="$(ComponentType)!='Product'" Text="Unable to create setup for not product project" />
        <Error Condition="$(ProductGUID)==''" Text="ProductGUID not defined" />
        <Error Condition="$(ProductUpgradeGUID)==''" Text="ProductUpgradeGUID not defined" />
    </Target>
    
    <Target Name="SetupBuild" DependsOnTargets="Directories;CheckSetup;ProductBuildNumberGet;CreateSetup" />
    <Target Name="SetupClean" DependsOnTargets="CleanSetup" />
    <Target Name="SetupRebuild" DependsOnTargets="CleanSetup;Directories;ProductBuildNumberGet;CreateSetup" />


    <!-- deploy tasks -->
    <Target Name="DeployDebug">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="RebuildAll" Properties="Configuration=Debug" StopOnFirstFailure="true" />
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="SetupRebuild" Properties="Configuration=Debug;Language=Czech" StopOnFirstFailure="true" />
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="SetupRebuild" Properties="Configuration=Debug;Language=English" StopOnFirstFailure="true" />
    </Target>

    <Target Name="DeployRelease">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="RebuildAll" Properties="Configuration=Release" StopOnFirstFailure="true" />
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="SetupRebuild" Properties="Configuration=Release;Language=Czech" StopOnFirstFailure="true" />
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="SetupRebuild" Properties="Configuration=Release;Language=English" StopOnFirstFailure="true" />
    </Target>

    <Target Name="Deploy" DependsOnTargets="DeployRelease;DeployDebug" />

</Project>
