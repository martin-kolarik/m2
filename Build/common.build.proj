<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- common properties -->
    <PropertyGroup>
        <!-- main controls -->
        <DeepFlag>off</DeepFlag><!-- for build -->

        <!-- directories -->
        <SourceDir>Source</SourceDir>
        <ResourceDir>Resource</ResourceDir>
        <ResourceFile>$(ResourceDir)\$(MSBuildProjectName).rc</ResourceFile>
        <ResourceFile Condition="!Exists('$(ResourceFile)')"></ResourceFile>
        <TestDir>Test</TestDir>
        <SetupDir>Install</SetupDir>

        <OutputDirName Condition="$(ConfigurationName)=='Release'">~Release</OutputDirName>
        <OutputDirName Condition="$(ConfigurationName)!='Release'">~Debug</OutputDirName>
        <!-- IntermediateDirName>%40$(OutputDirName)</IntermediateDirName -->
        <IntermediateDirName>~Build</IntermediateDirName>
        <HeaderDirName>$(IntermediateDirName)</HeaderDirName>

        <OutputDir>$(OutputDirName)</OutputDir>
        <OutputPath>$(ComponentPath)\$(OutputDirName)</OutputPath>

        <IntermediateDir>$(IntermediateDirName)</IntermediateDir>

        <!-- default entered export is overwritten -->
        <OriginalExport>$(Export)</OriginalExport>

        <!-- HeaderDirName>%40Header</HeaderDirName -->
        <HeaderDir>$(HeaderDirName)</HeaderDir>

        <!-- recursive child parameters -->
        <Grabbing>off</Grabbing>
        <GrabProcessFileName>GrabbedComponents.tmp</GrabProcessFileName>
        <GrabProcessFile>$(ComponentPath)\$(IntermediateDirName)\$(GrabProcessFileName)</GrabProcessFile>
        <GrabProcessFile Condition="$(ComponentType)=='Generic' And $(InheritedGrabProcessFile)!=''">$(InheritedGrabProcessFile)</GrabProcessFile>

        <InheritedProperties>InheritedComponentDefinitionsPath=$(ComponentDefinitionsPath);InheritedManufacturer=$(Manufacturer);InheritedLibraryName=$(LibraryName)</InheritedProperties>
        <ChildParameters>Level=1+;ProductPath=$(ProductPath);ProductId=$(ProductId);ProductLinkMapFilePath=$(ProductLinkMapFilePath);$(InheritedProperties)</ChildParameters>
        <ChildParameters Condition="$(Test)=='off'">Test=off;$(ChildParameters)</ChildParameters>

        <!-- M2 initializing code -->
        <Modula2InitCode>$(RootDir)\Modula2\Modula2\Header\m2init.cpp</Modula2InitCode>

        <!-- licensing -->
        <LicensingSourceDir>$(SourceDir)</LicensingSourceDir>
        <ProductLicenceFile>$(OutputDir)\$(ProductId).tlic</ProductLicenceFile>

        <!-- COM -->
        <TypeLibFile Condition="$(TypeLibrary)!=''">$(SourceDir)\$(TypeLibrary).idl</TypeLibFile>
        <TypeLibHeader Condition="$(TypeLibrary)!=''">$(TypeLibrary)_i.h</TypeLibHeader>
        <TypeLibCPP Condition="$(TypeLibrary)!=''">$(TypeLibrary)_i.c</TypeLibCPP>
        <TypeLibOBJ Condition="$(TypeLibrary)!=''">$(TypeLibrary)_i.obj</TypeLibOBJ>
        <TLBFile Condition="$(TypeLibrary)!=''">$(TypeLibrary).tlb</TLBFile>
    </PropertyGroup>

    <!-- outputs -->
    <PropertyGroup>
        <OutputName Condition="$(OutputName)=='' And $(Result)=='Static'">$(ResultName).lib</OutputName>
        <OutputName Condition="$(OutputName)=='' And $(Result)=='Dynamic'">$(ResultName).dll</OutputName>
        <OutputName Condition="$(OutputName)=='' And $(Result)=='Program'">$(ResultName).exe</OutputName>
        <OutputPDBName Condition="$(OutputPDBName)=='' And $(Result)!='Static'">$(ResultName).pdb</OutputPDBName>
        <OutputMAPName Condition="$(OutputMAPName)=='' And $(Result)!='Static'">$(ResultName).map</OutputMAPName>
        <OutputFile>$(OutputDir)\$(OutputName)</OutputFile>
        <OutputFilePath>$(OutputPath)\$(OutputName)</OutputFilePath>
        <OutputPDBFilePath Condition="$(OutputPDBName)!=''">$(OutputPath)\$(OutputPDBName)</OutputPDBFilePath>
        <OutputMAPFilePath Condition="$(OutputMAPName)!=''">$(OutputPath)\$(OutputMAPName)</OutputMAPFilePath>
        <InterfaceNamePath>$(OutputPath)\$(MSBuildProjectName)</InterfaceNamePath>
        <!-- !! without .lib -->
        <InterfacePath>$(OutputPath)\$(OutputName)</InterfacePath>

        <TestOutput>$(OutputDir)\$(MSBuildProjectName).test.dll</TestOutput>
        <TestFactoryDir>$(RootDir)\$(TestComponent)\$(SourceDir)</TestFactoryDir>
        <TestFactoryDEF>$(TestFactoryDir)\$(TestFactoryName).def</TestFactoryDEF>
        <TestFactoryMOD>$(TestFactoryDir)\$(TestFactoryName).mod</TestFactoryMOD>
    </PropertyGroup>

    <!-- compilation programs and parameters -->
    <Import Project="internal.compilation.targets"/>

    <!-- file names, sources, outputs -->
    <ItemGroup>
        <!-- resources -->
        <MessagesDir Include="@(Messages -> '$(SourceDir)\%(Filename).xrs')"/>
        <MessagesDefDir Include="@(Messages -> '$(SourceDir)\%(Filename).def')"/>
        <!-- add messages DEF between normal DEF -->
        <!-- !!! IT IS SAFER TO HAVE MESSAGES FIRST -->
        <DEFFiles Include = "@(Messages -> '%(Filename).def')" />
        <DEFFilesDir Include = "@(MessagesDefDir)" />

        <DEFs Include = "@(Definitions);@(Modules)" />
        <DEFFiles Include = "@(DEFs -> '%(Filename).def')" />
        <DEFFilesDir Include = "@(DEFs -> '$(SourceDir)\%(Filename).def')" />

        <MODs Include = "@(Modules);@(Program)" />
        <MODFiles Include = "@(MODs -> '%(Filename).mod')" />
        <MODFilesDir Include = "@(MODs -> '$(SourceDir)\%(Filename).mod')" />

        <HeadersDir Include="@(Definitions -> '$(HeaderDir)\%(Filename).h')"/>
    </ItemGroup>

    <!-- add licensing files between normal DEF/MOD -->
    <ItemGroup Condition="$(ClientLicensing)=='on'">
        <DEFFiles Include = "cllv.def" />
        <DEFFilesDir Include = "$(SourceDir)\cllv.def" />
        <MODFiles Include = "cllv.mod" />
        <MODFilesDir Include = "$(SourceDir)\cllv.mod" />
        <LicensingSourceFiles Include="$(SourceDir)\cllv.def;$(SourceDir)\cllv.mod"/>
    </ItemGroup>

    <!-- intermediates -->
    <ItemGroup>
        <ExportToInterface Condition="$(ComponentType)=='Library'" Include="@(Components)"/>
        <!-- library component is component, which condensates together more generic components to single library (DLL), it
             must propagate interfaces (DEF, H) to users transparently -->
        
        <CPPs Include="@(MODFiles -> '%(Filename).cpp')" />
        <CPPsDir Include="@(MODFiles -> '$(IntermediateDir)\%(Filename).cpp')" />
        <CPPsDir Condition="$(TypeLibCPP) !=''" Include="$(IntermediateDir)\$(TypeLibCPP)" />
        <CPPsDir Condition="$(Result)!='Static' And $(Modula2InitCode)!=''" Include="$(IntermediateDir)\m2init.cpp"/>

        <Objects Include="@(MODFiles -> '$(IntermediateDir)\%(Filename).obj')" />
        <Objects Condition="$(TypeLibOBJ) !=''" Include="$(TypeLibOBJ)" />
        <Objects Condition="$(Grabbing)!='on' And $(Result)!='Static' And (@(ExportToInterface)!='' Or @(Objects)!='') And $(Modula2InitCode)!=''"
                 Include="$(IntermediateDir)\m2init.obj"/>

        <RESFile Condition="$(Result)!='Static' And (@(ExportToInterface)!='' Or @(Objects)!='')"
                 Include="$(IntermediateDir)\$(MSBuildProjectName).res" />

        <SelfInterface Condition="$(Result)!='Program' And (@(ExportToInterface)!='' Or @(MODFiles)!='')" Include="$(InterfaceNamePath)"/><!-- using MODFiles instead of Objects denies exporting of LIB if only m2init.obj is created. -->
        <!-- SelfInterface/Interface: Interface could be extended by project to export some interfaces, e.g. Ws32, msxml, etc. -->
        <Interface Include="@(SelfInterface)"/>

        <MessagesBin Condition="@(Messages)!=''" Include="@(Messages -> '$(IntermediateDir)\$(MSBuildProjectName).%(FileName).brs')"/>

        <Components Condition="$(ClientLicensing)=='on' And $(LicensingComponent)!=''"
                    Include="$(LicensingComponent)"/>

        <Components Condition="$(Test)=='on' And $(TestComponent)!='' And $(LibraryName)!=$(TestComponentName)"
                    Include="$(TestComponent)"/>

        <Components Condition="$(LeakChecking)=='on' And $(LeakDetectorComponent)!='' And $(LibraryName)!=$(LeakDetectorComponentName) And
                               (@(ExportToInterface)!='' Or @(Objects)!='')"
                    Include="$(LeakDetectorComponent)"/>

    </ItemGroup>

    <!-- file names, sources, intermediates, outputs for TESTs -->
    <ItemGroup>
        <TestDEFFiles Condition="$(Test)!='off'" Include="$(TestDir)\*.def"/>
        <TestMODFiles Condition="$(Test)!='off'" Include="$(TestDir)\*.mod"/>

        <TestDEFFiles Condition="@(TestDEFFiles)!='' Or @(TestMODFiles)!=''" Include="$(TestFactoryDEF)"/>
        <TestMODFiles Condition="@(TestDEFFiles)!='' Or @(TestMODFiles)!=''" Include="$(TestFactoryMOD)"/>

        <TestCPPFiles Include="@(TestMODFiles -> '$(IntermediateDir)\%(Filename).cpp');m2init.cpp"/>
        <TestOBJFiles Include="@(TestMODFiles -> '$(IntermediateDir)\%(Filename).obj');m2init.obj"/>
    </ItemGroup>

    <!-- inner, invisible targets -->
    <Target Name="Environment">
        <Error Condition="@(Objects)!='' And $(FileDescription)==''"
               Text="Required 'FileDescription' property is not defined (project $(MSBuildProjectName))."
               HelpKeyword ="FileDescription"/>
        <Error Condition="@(ExportToInterface)!='' And $(OriginalExport)!=''"
               Text="Both 'ExportToInterface' and 'Export' keys are defined, this is not allowed. Select only one of them. (project $(MSBuildProjectName))."
               HelpKeyword ="ExportToInterface"/>
        <Warning Condition="$(DefinitionFileAllowed)=='off' And $(SelfDefinitionFileExists)=='on'"
                 Text="Definition file $(ComponentDefinitionsPath) will not be used, component type or owning component denies it."
                 HelpKeyword ="ComponentType, *.definition.proj"/>
        <!-- Exec Command="$(RootDir)\setenv.bat"/ -->
    </Target>


    <!-- default version info -->
    <PropertyGroup>
        <FileVersionMajor Condition="$(FileVersionMajor)==''">1</FileVersionMajor>
        <FileVersionMinor Condition="$(FileVersionMinor)==''">0</FileVersionMinor>
        <FileVersionRevision Condition="$(FileVersionRevision)==''">0</FileVersionRevision>
        <ProductVersionMajor Condition="$(ProductVersionMajor)==''">$(FileVersionMajor)</ProductVersionMajor>
        <ProductVersionMinor Condition="$(ProductVersionMinor)==''">$(FileVersionMinor)</ProductVersionMinor>
        <ProductVersionRevision Condition="$(ProductVersionRevision)==''">$(FileVersionRevision)</ProductVersionRevision>
    </PropertyGroup>

    <!-- build number -->
    <Target Name="DoProductBuildNumberGet" Condition="$(ComponentType)=='Product'">
        <HgVersion Condition="%(Identity)!=''" LocalPath="@(BuildVersionSource)">
            <Output TaskParameter="Revision" ItemName="ProductVersionBuilds"/>
            <Output TaskParameter="RevisionId" ItemName="RevisionIds"/>
        </HgVersion>
        <Error Condition="@(RevisionIds)=='&lt;unversioned&gt;'" Text="@(BuildVersionSource) is not versioned, unable to get product revision (check case of referenced project names)." />
        <MinMax Input="@(ProductVersionBuilds)">
            <Output TaskParameter="Maximum" PropertyName="ProductVersionBuild"/>
        </MinMax>
        <CreateProperty Value="$(ProductVersionMajor).$(ProductVersionMinor).$(ProductVersionBuild)">
            <Output TaskParameter="Value" PropertyName="ProductVersion"></Output>
        </CreateProperty>
    </Target>

    <Target Name="DoDummyProductBuildNumberGet" Condition="$(ComponentType)!='Product'">
        <CreateProperty Condition="$(InheritedProductVersion)!=''" Value="$(InheritedProductVersion)">
            <Output TaskParameter="Value" PropertyName="ProductVersion"></Output>
        </CreateProperty>
    </Target>

    <Target Name="ProductBuildNumberGet"
            DependsOnTargets="DoDummyProductBuildNumberGet;DoProductBuildNumberGet">
        <CreateProperty Value="-DProductId:$(CompileProductId) -DProductVersion:$(ProductVersion)">
            <Output TaskParameter="Value" PropertyName="M2PROD"></Output>
        </CreateProperty>
    </Target>

    <!-- resources default -->
    <UsingTask TaskName="SvnVersion" AssemblyFile="BuildTasks.dll"/>
    <UsingTask TaskName="HgVersion" AssemblyFile="BuildTasks.dll"/>
    <UsingTask TaskName="MinMax" AssemblyFile="BuildTasks.dll"/>
    <Import Project="internal.resource.targets"/>


    <!-- start of pure build targets -->
    <Target Name="Directories">
        <MakeDir Directories="$(IntermediateDir);$(OutputDir)" />
    </Target>


    <Target Name="DeleteGrabProcessFile">
        <Delete Files="$(GrabProcessFile)" ContinueOnError="true"/>
    </Target>

    <Target Name="GrabComponent"
            DependsOnTargets="Directories"
            Outputs="@(Grabbed)">
        <!-- Message Text="-LW:$(MSBuildProjectName)/$(Result): @(Grabbed)" Importance="high"/ -->
        <!-- Message Text="-LW:$(MSBuildProjectName)/$(Result)" Importance="high"/ -->

        <!-- Message Text="+MF:$(MSBuildProjectName): @(MODFiles)" Importance="high"/ -->
        <!-- Message Text="+IF:$(MSBuildProjectName): @(Interface -> '%(Identity).lib')" Importance="high"/ -->

        <CallTarget Condition="$(ComponentType)!='Generic'" Targets="DeleteGrabProcessFile"/>

        <!-- try remove already checked components and store result of removing -->
        <ReadLinesFromFile Condition="@(Components)!=''"
                           File="$(GrabProcessFile)">
            <Output TaskParameter="Lines" ItemName="GrabbedComponents"/>
        </ReadLinesFromFile>

        <!-- Message Text="+LN1:$(MSBuildProjectName)/$(GrabProcessFile): @(GrabbedComponents)" Importance="high"/ -->

        <CreateItem Condition="@(Components)!=''"
                    Include="@(Components)"
                    Exclude="@(GrabbedComponents)">
            <Output TaskParameter="Include" ItemName="ComponentsToParse"/>
        </CreateItem>
        <WriteLinesToFile Condition="@(Components)!='' And @(ComponentsToParse)!=''"
                          File="$(GrabProcessFile)"
                          Lines="@(ComponentsToParse)"/>

        <!-- Message Text="+LN2:$(MSBuildProjectName): @(ComponentsToParse)" Importance="high"/ -->

        <!-- PARSE ALL CHILD COMPONENTS, specially handle libraries masked with standalone/re-export components -->
        <CreateProperty Value="$(GetLibrariesToFilter)">
            <Output TaskParameter="Value" PropertyName="FilterLibraries"/>
        </CreateProperty>
        <CreateProperty Condition="@(ExportToInterface)==''" Value="false">
            <Output TaskParameter="Value" PropertyName="GetLibrariesToFilter"/>
        </CreateProperty>
        <CreateProperty Condition="@(ExportToInterface)!=''" Value="true">
            <Output TaskParameter="Value" PropertyName="GetLibrariesToFilter"/>
        </CreateProperty>

        <!-- ** After getting informations, clear grabbed for ancestors, if I must not propagate child components. This is achieved using another output,
             and later by joining the output with Grabbed (see ** below) -->
        <MSBuild Condition="@(ComponentsToParse)!=''"
                 Projects="@(ComponentsToParse -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Properties="Grabbing=on;InheritedGrabProcessFile=$(GrabProcessFile);GetLibrariesToFilter=$(GetLibrariesToFilter);$(ChildParameters)"
                 Targets="GrabComponent">
            <Output TaskParameter="TargetOutputs" ItemName="PrivateGrabbed"/>
        </MSBuild>

        <!-- CHILD COMPONENT PATHS FOR ANCESTOR ACCESS TO DEF/H -->
        <CreateItem Condition="@(ComponentsToParse)!=''"
                    Include="@(ComponentsToParse -> '$(RootDir)\%(Identity)')"
                    AdditionalMetadata="Type=Component">
            <Output TaskParameter="Include" ItemName="PrivateGrabbed"/>
        </CreateItem>

        <!-- ** If I am propagating components set found components to propagated ones (see ** above). -->
        <CreateItem Condition="$(PropagateComponents)=='on'"
                    Include="@(PrivateGrabbed)"
                    Exclude="@(GrabbedComponents)">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- USED MESSAGES -->
        <CreateItem Condition="$(Result)=='Static' And @(Messages)!=''"
                    Include="@(MessagesBin -> '$(ComponentPath)\%(Identity)')"
                    AdditionalMetadata="Type=Messages">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- SELF LIBRARY PATH and DLL/EXE, the libs will be removed during link to not to link with self, here I cannot distinguish if I am doing self or not. -->
        <CreateItem Condition="$(Result)!='Program'"
                    Include="@(Interface -> '%(Identity).lib')"
                    AdditionalMetadata="Type=Library">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>
        <!-- interface can be delayed in load -->
        <CreateItem Condition="$(Result)!='Program'"
                    Include="@(InterfaceWithDelayLoad -> '%(Identity).lib /delayload:%(FileName).dll')"
                    AdditionalMetadata="Type=Library">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- components which are not built must offer their runtimes -->
        <CreateItem Condition="$(Level)!='0' And $(PropagateBuild)=='off'"
                    Include="$(OutputFilePath);$(OutputPDBFilePath);$(OutputMAPFilePath)"
                    AdditionalMetadata="Type=Runtime">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- standalone/re-export component and component libs -->
        <CreateItem Condition="$(FilterLibraries)=='true' And $(PropagateBuild)=='on'"
                    Include="@(SelfInterface -> '%(Identity).filtered')"
                    AdditionalMetadata="Type=LibraryToFilter">
            <Output TaskParameter="Include" ItemName="Grabbed"/>
        </CreateItem>

        <!-- Including Grabbed to PrivateGrabbed assures, that PrivateGrabbed used later will behave in the same manner as Grabbed for PropagateComponents=on -->
        <!-- CreateItem Condition="$(PropagateComponents)=='on'"
                    Include="@(Grabbed)">
            <Output TaskParameter="Include" ItemName="PrivateGrabbed"/>
        </CreateItem -->

        <!-- Message Text="+LW(%(Type)):$(MSBuildProjectName)/$(Result): @(Grabbed)" Importance="high"/ -->
    </Target>

    <Target Name="GrabComponents"
            DependsOnTargets="DeleteGrabProcessFile;GrabComponent">

        <!-- SPLIT COMPONENTS (1a) TO Libraries... -->
        <CreateItem Condition="%(Type)=='Library'"
                    Include="@(PrivateGrabbed)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedUnfilteredLibraries"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedUnfilteredLibraries)">
            <Output TaskParameter="Filtered" ItemName="GrabbedUnfilteredLibraries"/>
        </RemoveDuplicates>
        <!-- SPLIT COMPONENTS (1b) TO libraries to be filtered... -->
        <CreateItem Condition="%(Type)=='LibraryToFilter'"
                    Include="@(PrivateGrabbed -> '%(RootDir)%(Directory)%(FileName).lib')">
            <Output TaskParameter="Include" ItemName="LocalGrabbedLibrariesToFilter"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedLibrariesToFilter)">
            <Output TaskParameter="Filtered" ItemName="GrabbedLibrariesToFilter"/>
        </RemoveDuplicates>
        <!-- ...and filter them, excluding SELF's one, see not above when these libs are added: I cannot link with myself -->
        <CreateItem Include="@(GrabbedUnfilteredLibraries)" Exclude="@(GrabbedLibrariesToFilter);@(SelfInterface -> '%(Identity).lib')">
            <Output TaskParameter="Include" ItemName="LocalGrabbedLibraries"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedLibraries)">
            <Output TaskParameter="Filtered" ItemName="GrabbedLibraries"/>
        </RemoveDuplicates>
        <!-- ...and create final libraries -->
        <CreateItem Include="@(GrabbedLibraries);@(Libraries -> '%(Filename).lib')"
                    Condition="Exists('%(Identity)')">
            <Output TaskParameter="Include" ItemName="LocalLinkDependencyLibraries"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalLinkDependencyLibraries)">
            <Output TaskParameter="Filtered" ItemName="LinkDependencyLibraries"/>
        </RemoveDuplicates>

        <!-- prepare (2a) unfiltered components -->
        <CreateItem Condition="%(Type)=='Component'"
                    Include="@(PrivateGrabbed)"
                    Exclude="@(GrabbedComponents)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedComponents"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedComponents)">
            <Output TaskParameter="Filtered" ItemName="GrabbedComponents"/>
        </RemoveDuplicates>

        <!-- ... (3a) TO Sources (for DEF)... -->
        <CreateItem Condition="Exists( '%(Identity)\$(SourceDirName)' )"
                    Include="@(GrabbedComponents)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedSources"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedSources)">
            <Output TaskParameter="Filtered" ItemName="GrabbedSources"/>
        </RemoveDuplicates>
        <!-- ... (3b) TO Includes (for H)... -->
        <CreateItem Condition="Exists( '%(Identity)\$(IntermediateDirName)' )"
                    Include="@(GrabbedComponents)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedIncludes"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedIncludes)">
            <Output TaskParameter="Filtered" ItemName="GrabbedIncludes"/>
        </RemoveDuplicates>

        <!-- ... (4) TO Header Includes... -->
        <CreateItem Condition="Exists( '%(Identity)\Header' )"
                    Include="@(GrabbedComponents)">
            <Output TaskParameter="Include" ItemName="GrabbedHeaders"/>
        </CreateItem>

        <!-- SPLIT COMPONENTS (6) TO Messages (BinaryReSources)... -->
        <CreateItem Condition="%(Type)=='Messages'"
                    Include="@(PrivateGrabbed)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedMessages"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedMessages)">
            <Output TaskParameter="Filtered" ItemName="GrabbedMessages"/>
        </RemoveDuplicates>

        <!-- SPLIT COMPONENTS (7) TO Runtime Modules (DLL,EXE)... -->
        <CreateItem Condition="%(Type)=='Runtime'"
                    Include="@(PrivateGrabbed)">
            <Output TaskParameter="Include" ItemName="LocalGrabbedRuntimes"/>
        </CreateItem>
        <RemoveDuplicates Inputs="@(LocalGrabbedRuntimes)">
            <Output TaskParameter="Filtered" ItemName="GrabbedRuntimes"/>
        </RemoveDuplicates>

        <!-- Message Text="+AL(%(Type)):$(MSBuildProjectName)/$(Result): @(GrabbedUnfilteredLibraries)" Importance="high"/ -->
        <!-- Message Text="+FL(%(Type)):$(MSBuildProjectName)/$(Result): @(GrabbedLibrariesToFilter)" Importance="high"/ -->
        <!-- Message Text="+PR(%(Type)):$(MSBuildProjectName)/$(Result): @(PrivateGrabbed)" Importance="high"/ -->
        <!-- Message Text="+GC(%(Type)):$(MSBuildProjectName)/$(Result): @(GrabbedComponents)" Importance="high"/ -->
        <!-- Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedSources)" Importance="high"/ -->
        <!-- Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedIncludes)" Importance="high"/ -->
        <!-- Message Text="+!!$(MSBuildProjectName)/$(Result): @(GrabbedLibraries)" Importance="high"/ -->
        <!-- Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedMessages)" Importance="high"/ -->
        <!-- Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedRuntimes)" Importance="high"/ -->
        <!-- Message Text="+%(Type)!!$(MSBuildProjectName)/$(Result): @(GrabbedExportInterfaces)" Importance="high"/ -->
        <!-- Message Text="=========================================" Importance="high"/ -->
    </Target>


    <Target Name="MessagesDef" Inputs="@(MessagesDir)" Outputs="@(MessagesDefDir)">
        <Exec Command="$(XRSDEF) @(MessagesDir, ' ')"/>
    </Target>


    <Target Name="LicensingSource" Condition="$(ClientLicensing)=='on'" Inputs="$(ProductBuildFile)" Outputs="@(LicensingSourceFiles)">
        <Exec WorkingDirectory="$(LicensingSourceDir)"
              Command="$(LICSRC) $(ProductId)"/>
    </Target>


    <Target Name="PrepareIDL" Inputs="$(TypeLibFile)" Outputs="$(IntermediateDir)\$(TypeLibCPP)">
        <Exec WorkingDirectory="$(IntermediateDir)"
              Command="midl /tlb $(TLBFile) /header $(TypeLibHeader) ..\$(TypeLibFile)"/>
    </Target>


    <Target Name="GrabOutOfDateFiles" Condition="@(DEFFiles)!='' Or @(MODFiles)!=''">
        <Exec WorkingDirectory="$(SourceDir)"
              Command="$(M2D) $(M2PROD) $(M2TDEF) -O&quot;..\$(IntermediateDir)&quot; @(DEFFiles, ' ') @(MODFiles, ' ')"/>
        <ReadLinesFromFile File="$(IntermediateDir)\OutOfDate.DEF.log">
            <Output TaskParameter="Lines" ItemName="OutOfDateDEFs"/>
        </ReadLinesFromFile>
        <ReadLinesFromFile File="$(IntermediateDir)\OutOfDate.MOD.log">
            <Output TaskParameter="Lines" ItemName="OutOfDateMODs"/>
        </ReadLinesFromFile>
    </Target>
    <Target Name="TouchOutOfDateFiles">
        <Touch Condition="@(OutOfDateDEFs)!=''" Files="@(OutOfDateDEFs -> '$(SourceDir)\%(Identity)')" />
        <Touch Condition="@(OutOfDateMODs)!=''" Files="@(OutOfDateMODs -> '$(SourceDir)\%(Identity)')" />
    </Target>


    <Target Name="CPPs" Condition="(@(DEFFiles)!='' or @(MODFiles)!='')"
            Inputs="@(DEFFilesDir);@(MODFilesDir)"
            Outputs="@(DEFFilesDir -> '$(HeaderDir)\%(Filename).h');@(MODFilesDir -> '$(IntermediateDir)\%(Filename).cpp')">
        <Message Importance="high" Text="$(M2PROD)" />
        <Exec WorkingDirectory="$(SourceDir)"
              Command="$(M2) $(M2PROD) $(M2DEF) -O&quot;..\$(IntermediateDir)&quot; @(DEFFilesDir -> '%(FileName).def', ' ') @(MODFilesDir -> '%(FileName).mod', ' ')"/>
    </Target>

    <Target Name="TestCPPs" Condition="@(TestDEFFiles)!='' or @(TestMODFiles)!=''"
            Inputs="@(TestDEFFiles);@(TestMODFiles)"
            Outputs="@(TestDEFFiles -> '$(HeaderDir)\%(Filename).h');@(TestMODFiles -> '$(IntermediateDir)\%(Filename).cpp')">
        <Exec WorkingDirectory="$(TestDir)"
              Command="$(M2) $(M2DEF) -LD -I..\$(SourceDir) -O&quot;..\$(IntermediateDir)&quot; @(TestDEFFiles -> '%(FileName).def', ' ') @(TestMODFiles -> '%(FileName).mod', ' ')"/>
    </Target>

    <Target Name="Modula2InitCPP" Condition="$(Modula2InitCode)!=''"
            Inputs="$(Modula2InitCode)"
            Outputs="$(IntermediateDir)\m2init.cpp">
        <Copy SourceFiles="$(Modula2InitCode)"
              DestinationFiles="$(IntermediateDir)\m2init.cpp"/>
    </Target>

    <PropertyGroup>
        <CompileCPPsDEP>$(UserPreCPP);Modula2InitCPP;CPPs</CompileCPPsDEP>
    </PropertyGroup>
    <Target Name="Objects" Condition="@(CPPs)!='' Or @(ExportToInterface)!=''"
            DependsOnTargets="$(UserPreCompile);MessagesDef;LicensingSource;GrabOutOfDateFiles;TouchOutOfDateFiles;$(CompileCPPsDEP);$(UserPostCPP);$(UserPreOBJ)"
            Inputs="@(CPPsDir)" Outputs="@(CPPsDir -> '$(IntermediateDir)\%(Filename).obj')">
        <Exec WorkingDirectory="$(IntermediateDir)"
              Command="$(CL) $(CLDEF) @(CPPsDir ->'%(FileName)%(Extension)', ' ')"/>
    </Target>

    <Target Name="TestObjects" Condition="@(TestDEFFiles)!='' or @(TestMODFiles)!=''"
            DependsOnTargets="Modula2InitCPP;TestCPPs"
            Inputs="@(TestCPPFiles)" Outputs="@(TestCPPFiles -> '$(IntermediateDir)\%(Filename).obj')">
        <Exec WorkingDirectory="$(IntermediateDir)"
              Command="$(CL) $(CLDEF) @(TestCPPFiles ->'%(FileName)%(Extension)', ' ')"/>
    </Target>

    
    <Target Name="MessagesBin" Inputs="@(MessagesDir)" Outputs="@(MessagesBin)">
        <Exec Command="$(XRSBIN) @(MessagesDir, ' ')"/>
    </Target>

    <Target Name="CheckRevision">
        <HgVersion Condition="%(Identity)!=''" LocalPath="@(BuildVersionSource)">
            <Output TaskParameter="Revision" ItemName="FileVersionBuilds"/>
            <Output TaskParameter="RevisionId" ItemName="FileRevisionIds"/>
        </HgVersion>
        <Error Condition="@(FileRevisionIds)=='&lt;unversioned&gt;'" Text="@(BuildVersionSource) is not versioned, unable to get file revision (check case of referenced project names)." />
        <MinMax Input="@(FileVersionBuilds)">
            <Output TaskParameter="Maximum" PropertyName="FileVersionBuild"/>
        </MinMax>
        <ReadLinesFromFile File="$(RCFile).lastrev" ContinueOnError="true">
            <Output TaskParameter="Lines" PropertyName="LastRev"/>
        </ReadLinesFromFile>
        <Delete Condition="$(FileVersionBuild)!=$(LastRev)"
                Files="$(RCFile)"/>
        <Delete Condition="$(FileVersionBuild)!=$(LastRev) And $(ClientLicensing)"
                Files="@(LicensingSourceFiles)"
                ContinueOnError="true"/>
        <Delete Condition="$(FileVersionBuild)!=$(LastRev) And $(SetupLicensing)"
                Files="$(ProductLicenceFile)"
                ContinueOnError="true"/>
    </Target>

    <Target Name="BuildResources"
            Condition="$(Result)!='Static'"
            DependsOnTargets="PrepareIDL;CreateRCFile"
            Inputs="$(RCFile)"
            Outputs="@(RESFile)">
        <Exec WorkingDirectory="$(IntermediateDir)"
              Command="$(RC) $(RCDEF) /fo&quot;@(RESFile -> '%(Filename).res')&quot; ..\$(RCFile)"/>
        <WriteLinesToFile File="$(RCFile).lastrev"
                          Lines="$(FileVersionBuild)"
                          Overwrite="true"/>
    </Target>

    <Target Name="Resources" DependsOnTargets="MessagesBin;CheckRevision;BuildResources" />


    <Target Name="GrabComponentInterface"
            Outputs="@(GrabbedObjects)">
        <CreateItem Include="@(Objects -> '$(ComponentPath)\$(IntermediateDirName)\%(FileName).obj')"
                    AdditionalMetadata="Type=InterfaceObjects">
            <Output TaskParameter="Include" ItemName="GrabbedObjects"/>
        </CreateItem>
    </Target>

    <Target Name="ComponentInterface"
            Condition="@(ExportToInterface)!=''">
        <MSBuild Projects="@(ExportToInterface -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Properties="Grabbing=on;$(ChildParameters)"
                 Targets="GrabComponentInterface">
            <Output TaskParameter="TargetOutputs" ItemName="ExportToInterfaceObjects"/>
        </MSBuild>

        <!-- Message Text="## @(ExportToInterfaceObjects)" Importance="high" / -->
    </Target>

    <Target Name="ComponentIncludes"
            DependsOnTargets="CPPs;TestCPPs">
        <!-- here CPPs are noted (and it is not left for automatic dependency by Object), because .h files from standalone .def files must be built too -->        
    </Target>

    <Target Name="ComponentCode"
            Condition="@(ExportToInterface)!='' Or @(Objects)!=''"
            DependsOnTargets="Resources;$(UserPostRES);Objects;$(UserPostOBJ)"
            Inputs="@(Objects);@(ExportToInterfaceObjects);@(RESFile);@(LinkDependencyLibraries)"
            Outputs="$(OutputFile)">
        <Exec Condition="$(Result)=='Dynamic'"
              WorkingDirectory="$(IntermediateDir)"
              Command="$(LINK) /dll $(LINKDEF) $(LINKEXPORT) @(ExportToInterfaceObjects, ' ') @(Objects -> '%(Filename).obj', ' ') @(RESFile -> '%(Filename).res') @(GrabbedLibraries, ' ') @(Libraries -> '%(Filename).lib', ' ')"/>
        <Exec Condition="$(Result)=='Static'"
              WorkingDirectory="$(IntermediateDir)"
              Command="$(LIB) $(LIBDEF) @(Objects -> '%(Filename).obj', ' ')"/>
        <Exec Condition="$(Result)=='Program'"
              WorkingDirectory="$(IntermediateDir)"
              Command="$(LINK) $(LINKDEF) @(Objects -> '%(Filename).obj', ' ') @(RESFile -> '%(Filename).res') @(GrabbedLibraries, ' ') @(Libraries -> '%(Filename).lib', ' ')"/>
        <Exec Condition="$(Result)!='Static' And $(CLib)!='Static'"
              Command="$(MT)"/>
    </Target>

    <Target Name="ComponentTest"
        Condition="(@(TestDEFFiles)!='' or @(TestMODFiles)!='') And $(Test)!='off'"
        DependsOnTargets="TestObjects"
        Inputs="@(TestOBJFiles);@(LinkDependencyLibraries)"
        Outputs="$(TestOutput)">
        <Exec WorkingDirectory="$(IntermediateDir)"
              Command="$(LINK) /dll $(LINKTEST) /out:..\$(TestOutput) @(Objects -> '%(Filename).obj', ' ') @(TestOBJFiles -> '%(Filename).obj', ' ') @(GrabbedLibraries, ' ') @(Libraries -> '%(Filename).lib', ' ') @(SelfInterface -> '%(Identity).lib')"/>
        <!-- LINK SelfInterface.lib is manually added as Libraries do not include self product -->
        <Exec Condition="$(CLib)!='Static'"
              Command="$(MTT)"/>
    </Target>

    <Target Name="ComponentRuntimes"
            Condition="$(CopyRuntimes)=='on'"
            Inputs="@(GrabbedRuntimes)"
            Outputs="@(GrabbedRuntimes -> '$(OutputDir)\%(FileName)%(Extension)')">
        <Copy SourceFiles="@(GrabbedRuntimes)"
              DestinationFiles="@(GrabbedRuntimes -> '$(OutputDir)\%(FileName)%(Extension)')"
              SkipUnchangedFiles="true"
              ContinueOnError="false" />
    </Target>

    <Import Project="internal.licence.targets"/>
    <Target Name="BuildProductLicence"
            Condition="$(SetupLicensing)=='on'"
            DependsOnTargets="CreateProductLicenceFile">
        <Exec WorkingDirectory="$(OutputDir)"
              Command="$(LICSIGN) *.tlic"/>
    </Target>

    <Target Name="Component"
            DependsOnTargets="ComponentInterface;ComponentCode;ComponentIncludes;ComponentTest;ComponentRuntimes;BuildProductLicence"/>


    <!-- outer, visible targets -->

    <Target Name="Clean">
        <RemoveDir Directories="$(HeaderDir);$(IntermediateDir)"
                   ContinueOnError="true" />
        <Delete Condition="$(ClientLicensing)=='on'"
                Files="@(LicensingSourceFiles)"
                ContinueOnError="true" />
    </Target>
    <Target Name="CleanAll"
            Condition="$(Level)=='0' Or $(PropagateBuild)=='on' Or ($(DeepFlag)=='on' And $(RespectDeepFlag)=='on')">
        <MSBuild Projects="@(Components -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Targets="CleanAll"
                 Properties="DeepFlag=off;Parameters=%(Components.Parameters);$(ChildParameters)"/>
        <CallTarget Targets="Clean"/>
    </Target>
    <Target Name="CleanAllComponents">
        <MSBuild Projects="@(Components -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Targets="CleanAll"
                 Properties="DeepFlag=on;Parameters=%(Components.Parameters);$(ChildParameters)"/>
        <CallTarget Targets="CleanAll"/>
    </Target>


    <Target Name="Build"
            DependsOnTargets="ProductBuildNumberGet;Environment;GrabComponents;$(UserPreBuild);Component;$(UserPostBuild)"
            Outputs="$(Compiled)">
        <CreateProperty Condition="@(Objects)!='' And $(Result)!='Static'"
                        Value="$(OutputPath)\$(OutputName)">
            <Output TaskParameter="Value" PropertyName="Compiled"/>
        </CreateProperty>
    </Target>
    <Target Name="BuildAll"
            Condition="$(Level)=='0' Or $(PropagateBuild)=='on' Or ($(DeepFlag)=='on' And $(RespectDeepFlag)=='on')"
            DependsOnTargets="ProductBuildNumberGet">
        <MSBuild Projects="@(Components -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Targets="BuildAll"
                 Properties="DeepFlag=off;Parameters=%(Components.Parameters);$(ChildParameters);InheritedProductVersion=$(ProductVersion)"
                 StopOnFirstFailure="true">
            <Output TaskParameter="TargetOutputs" ItemName="Compiled"/>
        </MSBuild>
        <CallTarget Targets="Build"/>
    </Target>
    <Target Name="BuildAllComponents"
            DependsOnTargets="ProductBuildNumberGet"><!-- duplicite dependency if building BuildAllComponents target for product -->
        <!-- Exec Command="msbuild -clp:nosummary -v:m -t:RebuildAll -p:DeepFlag=on;Parameters=%(Components.Parameters);$(ChildParameters);%(Components.Filename)Batch=on @(Components -> '$(RootDir)\%(Identity)\%(Filename).proj')"/ -->
        <MSBuild Projects="@(Components -> '$(RootDir)\%(Identity)\%(Filename).proj')"
                 Targets="RebuildAll"
                 Properties="DeepFlag=on;Parameters=%(Components.Parameters);$(ChildParameters);InheritedProductVersion=$(ProductVersion);%(Components.Filename)Batch=on"
                 StopOnFirstFailure="true">
            <Output TaskParameter="TargetOutputs" ItemName="Compiled"/>
        </MSBuild>
        <CallTarget Targets="Rebuild"/>
    </Target>


    <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
    <Target Name="RebuildAll" DependsOnTargets="CleanAll;BuildAll" />
    <Target Name="RebuildAllComponents" DependsOnTargets="BuildAllComponents" />


    <!-- installation tasks -->
    <Import Project="internal.wix.targets"/>

    <Target Name="CheckSetup">
        <Error Condition="$(ComponentType)!='Product'" Text="Unable to create setup for not product project" />
        <Error Condition="$(ProductGUID)==''" Text="ProductGUID not defined" />
        <Error Condition="$(ProductUpgradeGUID)==''" Text="ProductUpgradeGUID not defined" />
    </Target>
    
    <Target Name="SetupBuild" DependsOnTargets="Directories;CheckSetup;ProductBuildNumberGet;CreateSetup" />
    <Target Name="SetupClean" DependsOnTargets="CleanSetup" />
    <Target Name="SetupRebuild" DependsOnTargets="CleanSetup;Directories;ProductBuildNumberGet;CreateSetup" />

    <!-- deploy tasks -->
    <Target Name="DeployDebug">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="RebuildAllComponents" Properties="ConfigurationName=Debug" StopOnFirstFailure="true" />
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="SetupRebuild" Properties="ConfigurationName=Debug;Language=Czech" StopOnFirstFailure="true" />
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="SetupRebuild" Properties="ConfigurationName=Debug;Language=English" StopOnFirstFailure="true" />
    </Target>

    <Target Name="DeployRelease">
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="RebuildAllComponents" Properties="ConfigurationName=Release" StopOnFirstFailure="true" />
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="SetupRebuild" Properties="ConfigurationName=Release;Language=Czech" StopOnFirstFailure="true" />
        <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="SetupRebuild" Properties="ConfigurationName=Release;Language=English" StopOnFirstFailure="true" />
    </Target>

    <Target Name="Deploy" DependsOnTargets="DeployRelease;DeployDebug" />

</Project>
