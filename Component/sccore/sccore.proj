<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType Condition="$(ComponentType)==''">Library</ComponentType>

        <FileDescription>Core Library</FileDescription>
        
        <Result>Dynamic</Result>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
        <BuildVersionSource Include="$(RootPath)\Library;$(RootPath)\Modula2"/>

        <Components Include="Modula2\m2rtl;Modula2\m2ortl;Library\ADT;Library\LoggerFilter;Library\COM;Library\Resources;Library\Registry;Library\Text"/>
        <Components Include="Library\Ciphering;Library\Threading;Library\Network;Library\XML;Library\Service;Library\ClassLoader"/>
        <Components Include="Component\scinit"/>
    </ItemGroup>

    <!-- 4 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
