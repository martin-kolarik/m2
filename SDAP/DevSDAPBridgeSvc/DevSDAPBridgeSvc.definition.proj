<Project
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <PropertyGroup>
        <Manufacturer>NeNo</Manufacturer>

        <ProductVariant>Common</ProductVariant><!-- Common IBS -->

        <SetupLicensing Condition="$(ProductVariant)!='IBS'">on</SetupLicensing>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName)=='DevSDAPBridgeSvc'">
        <Result>Program</Result>
    </PropertyGroup>

    <PropertyGroup>
        <ProductM2Control></ProductM2Control>
        <ProductCLControl></ProductCLControl>
        <ProductRCControl></ProductRCControl>
        <ProductLNControl></ProductLNControl>
    </PropertyGroup>

</Project>
