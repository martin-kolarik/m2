<Project
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <PropertyGroup>
        <Manufacturer>NeNo</Manufacturer>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName)=='DeviceIOSDAPBridge'">
    </PropertyGroup>
    
    <PropertyGroup>
        <ProductM2Control Condition="$(ProductM2Control)==''">-DTarget:&quot;$(ProductVariant)&quot;</ProductM2Control>
        <ProductCLControl></ProductCLControl>
        <ProductRCControl></ProductRCControl>
        <ProductLNControl></ProductLNControl>
    </PropertyGroup>

</Project>
