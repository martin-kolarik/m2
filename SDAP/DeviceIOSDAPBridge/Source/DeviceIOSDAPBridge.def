DEFINITION MODULE DeviceIOSDAPBridge;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   baseobject,
   device,
   io,
   iplugin,
   lec,
   lists,
   loader,
   log,
   maps,
   thread,
   sdapClient,
   StringsO;

(*================================================================================*)

#save, option( dll_export => on )

TYPE
   TPBridge = POINTER TO ABridge;

ABSTRACT CLASS ABridge( baseobject.CDisposable ) IMPLEMENTS
   thread.IRunnable,
   device.IConfigurable,
   io.IStartStopControl,
   sdapClient.ISDAPClientEvents,
   loader.IPluginLoadAuthorizer;

   // IRunnable
   INTERNAL VIRTUAL PROCEDURE OnRun( Restarted : BOOLEAN; CONST Helper : thread.IRunnableHelper ) : CARDINAL;

   // IConfigurable
	PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult;

   // IStartStopControl
   PUBLIC VIRTUAL READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();
   
   // ISDAPClientEvents
   PUBLIC VIRTUAL PROCEDURE OnConnect( Result : Sync.TAsyncResult; Error : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE OnDisconnect( Result : Sync.TAsyncResult; Error : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE OnReceive( CONST Data, Value : StringsO.IString );

   // ILibraryLoadAuthorizer
   PUBLIC VIRTUAL PROCEDURE AuthorizedToLoad( CONST Plugin : iplugin.TPPlugin ) : BOOLEAN;

   // SELF
   PRIVATE VAR
      _Logger : log.CLogger;
      _AppenderList : lists.CPtrList;
      _SDAPHost : StringsO.CString;
      _SDAPClient : sdapClient.TPISDAPClient;
      _Loader : loader.CLoader;
      _Devices : lists.CStringList;
      _Data : lists.CPtrList;
      _Lookup : maps.CStringPtrMap;
      _Thread : thread.Thread;
      _Connecting : BOOLEAN;
      _PeriodCounter : CARDINAL;
      _TickCounter : CARDINAL;
      _WriteLock : Sync.LOCK;
      _WriteSignal : Sync.SIGNAL;
      _WriteQueue : lists.CStringStringList;
      _Result : lec.CResult;
   
   PUBLIC VIRTUAL PROCEDURE Dispose();
END ABridge;

(*--------------------------------------------------------------------------------*)

PROCEDURE newDeviceIOSDAPBridge( OUT bridge : TPBridge ) : Sync.TAsyncResult;

(*================================================================================*)

#restore

END DeviceIOSDAPBridge.