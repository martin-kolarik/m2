<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType>Product</ComponentType>

        <ProductGUID>DA1CC8C1-DD65-4CA0-B9FE-8A112DD6715D</ProductGUID>
        <ProductUpgradeGUID>67E4985B-93E9-43ED-8B7E-5D381F094F5D</ProductUpgradeGUID>

        <ProductId>SmartControl.EibSrv</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>
        <ProductNote></ProductNote>

        <FileDescription>EIB/KNX group object server</FileDescription>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
        <Components Include="modula2\modula2;api\clib;API\win32"/>
        <Components Include="component\sccore"/>
        <!-- Components Include="modula2\m2rtl;modula2\m2ortl;library\ADT;library\resources;library\Text;library\messaging;library\Service"/ -->
        <Components Include="library\sdio;EIB\eibstack;EIB\eibnetstack;library\CWdriver"/>
        <Messages Include="Texts"/>
        <Modules Include="eibsrv;eibsrvdiface"/>
        <Program Include="eibsvc"/>
    </ItemGroup>

    <PropertyGroup>
        <Export>export</Export>
    </PropertyGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
