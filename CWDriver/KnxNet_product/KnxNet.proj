<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType>Bundle</ComponentType>
        <SetupLicensing>on</SetupLicensing>

        <ProductGUID>841A3212-2680-4ed4-9307-D2964EE55842</ProductGUID>
        <ProductUpgradeGUID>3A9E965F-7926-4c49-B119-F21E6E0109B2</ProductUpgradeGUID>

        <ProductId>SmartControl.KnxNet.CWDriver</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>
        <ProductNote></ProductNote>

        <ProjectDisplayName>KnxNet/IP Driver</ProjectDisplayName>
        <ProjectDescription>KnxNet/IP Group Object Driver</ProjectDescription>

        <DynamicCLibInstallMethod>Shared</DynamicCLibInstallMethod>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
        <BuildVersionSource Include="Build;Component\sccore;KNX\knxstack_knxnet;KNX\knxcore;CWDriver\KnxNet;CWDriver\KnxNet_product"/>

        <Components Include="CWDriver\KnxNet;KNX\checkcfg;KNX\discover;Licensing\LicTool"/>
    </ItemGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
