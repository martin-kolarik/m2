<Project
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <PropertyGroup Condition="$(MSBuildProjectName)=='checkcfg' Or $(MSBuildProjectName)=='discover'">
        <Result>Program</Result>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName)=='KnxNet'">
        <Result>Dynamic</Result>
    </PropertyGroup>

    <PropertyGroup Condition="False And $(ComponentName)=='Component\sccore'">
        <ComponentType>Deliverable</ComponentType>
        <Result>Dynamic</Result>
    </PropertyGroup>
    <PropertyGroup Condition="$(ComponentName)=='Component\sccore'">
        <Result>Static</Result>
    </PropertyGroup>

    <PropertyGroup Condition="$(ComponentName)=='Licensing\LicTool'">
        <ProductVariant>Activator</ProductVariant>
    </PropertyGroup>

    <PropertyGroup>
        <ProductM2Control></ProductM2Control>
        <ProductCLControl></ProductCLControl>
        <ProductRCControl></ProductRCControl>
        <ProductLNControl></ProductLNControl>
    </PropertyGroup>

</Project>
