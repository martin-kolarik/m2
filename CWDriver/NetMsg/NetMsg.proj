<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <Manufacturer Condition="$(Manufacturer)==''">Inris</Manufacturer>
        <ComponentType>Product</ComponentType>
    </PropertyGroup>

    <PropertyGroup Condition="$(Manufacturer)=='SmartControl'">
      <ProductUpgradeGUID>F38E039F-0B92-4c7b-860E-5660BD6F58C5</ProductUpgradeGUID>
      <ProductId>SmartControl.NetMsg.CWDriver</ProductId>
      <ProductVersionMajor>1</ProductVersionMajor>
      <ProductVersionMinor>1</ProductVersionMinor>
      <ProjectDescription>Network Messaging Driver</ProjectDescription>
    </PropertyGroup>

    <PropertyGroup Condition="$(Manufacturer)=='Inris'">
      <ProductUpgradeGUID>02C64EE3-CC35-4a26-A5EF-0F56CC2AC484</ProductUpgradeGUID>
      <ProductId>Inris.NetMsg.CWDriver</ProductId>
      <ProductVersionMajor>1</ProductVersionMajor>
      <ProductVersionMinor>1</ProductVersionMinor>
      <ProjectDescription>Inris Network Messaging Driver</ProjectDescription>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
			<Components Include="Modula2\modula2;API\CLib;API\win32"/>
			<Components Include="Component\SCCore;Library\CWDriver"/>
			<Program Include="netmsg"/>
			<Messages Include="Texts"/>
		</ItemGroup>

    <PropertyGroup>
        <Export>export</Export>
    </PropertyGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
