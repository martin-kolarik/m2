        </string>
        <string name="_FileDebugMissingFile">
            <item lang="en-US">Debug output file definition is missing (debug_file = ...)</item>
            <item lang="cs-CZ">Chybí definice souboru s ladicími výpisy (debug_file = ...)</item>
        </string>
        <string name="_KeyTooShort">
            <item lang="en-US">Key must be at least 32 characters long</item>
            <item lang="cs-CZ">Klíč musí mít nejméně 32 znaků</item>
        </string>
        <string name="_DelimiterTooLong">
            <item lang="en-US">Delimiter must be one character</item>
            <item lang="cs-CZ">Oddělovač musí být jeden znak</item>
        </string>

        <string name="_MissingNameOfRecordType">
            <item lang="en-US">"name" key of "record_type" is missing</item>
            <item lang="cs-CZ">Chybí klíč "name" sekce "record_type"</item>
        </string>
        <string name="_RecordTypeDuplicated">
            <item lang="en-US">"record_type" with the same name already exists</item>
