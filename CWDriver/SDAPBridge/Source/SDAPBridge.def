DEFINITION MODULE SDAPBridge;

(*===============================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   INIFile,
   lists,
   log,
   msgqueue,
   SDAPClient,
   StringsO,
   threadpool;

(*===============================================================================*)

INTERFACE ISDAPEventSink; // in-thread
   LOCAL PROCEDURE OnConnected();
   LOCAL PROCEDURE OnDisconnected( Result : Sync.TAsyncResult );
   LOCAL PROCEDURE OnData( CONST Address, Value : StringsO.IString );
END ISDAPEventSink;

(*-------------------------------------------------------------------------------*)

CLASS CSDAP IMPLEMENTS threadpool.IHandleSink, SDAPClient.ISDAPClientEvents;

   // IHandleSink
   LOCAL VIRTUAL PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : threadpool.TPoolHandle; UserId : PTR );

   // ISDAPClientEvents   
   PUBLIC VIRTUAL PROCEDURE OnConnect( Result : Sync.TAsyncResult; Error : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE OnDisconnect( Result : Sync.TAsyncResult; Error : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE OnReceive( CONST Data, Value : StringsO.IString );

   // SELF
   PRIVATE VAR
      _Running : BOOLEAN;
      _Host : StringsO.CString;
      _Client : SDAPClient.TPISDAPClient;
      _Queue : msgqueue.CPtrQueue;
      _QueueLength : CARDINAL;
      _Logger : log.CLogger;
      _QueueSignal : Sync.SIGNAL;
      _QueueSignalPoolHandle : threadpool.TPoolHandle;
      _PoolSink : threadpool.CSinkDelegate;

   PUBLIC VAR
      EventSink : POINTER TO ISDAPEventSink;
   PUBLIC READONLY PROPERTY
      Connected : BOOLEAN;
      OutputQueueCount : CARDINAL;
   PUBLIC PROPERTY
      OutputQueueLength : CARDINAL;

   PUBLIC VIRTUAL PROCEDURE Dispose();

   // client commands
   PUBLIC PROCEDURE SetConfiguration( CONST ClientName : ARRAY OF WCHAR; CONST LoggerToClone : log.CLogger; CONST Host : StringsO.CString );
   
   PUBLIC PROCEDURE Run() : Sync.TAsyncResult;
   PUBLIC PROCEDURE Stop();
   
   PUBLIC PROCEDURE Set( CONST Data, Value : StringsO.CString ) : Sync.TAsyncResult;
   PUBLIC PROCEDURE Ask( CONST Data : StringsO.CString ) : Sync.TAsyncResult;
   PUBLIC PROCEDURE Advise() : Sync.TAsyncResult;
   PUBLIC PROCEDURE Unadvise() : Sync.TAsyncResult;
   // completes immediatelly or results to IEventSink callback

   PRIVATE PROCEDURE Enqueue( Request : ADDRESS ) : Sync.TAsyncResult;
   PRIVATE PROCEDURE DisposeQueue();
END CSDAP;

(*===============================================================================*)

END SDAPBridge.
