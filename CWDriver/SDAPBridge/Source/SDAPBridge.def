DEFINITION MODULE SDAPBridge;

(*===============================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   INIFile,
   lists,
   log,
   msgqueue,
   SDAPClient,
   StringsO,
   threadpool;

(*===============================================================================*)

INTERFACE ISDAPEventSink; // in-thread
   LOCAL PROCEDURE OnConnected();
   LOCAL PROCEDURE OnDisconnected( Result : Sync.TAsyncResult );
   LOCAL PROCEDURE OnData( CONST Data, Value : StringsO.CString );
END ISDAPEventSink;

(*-------------------------------------------------------------------------------*)

CLASS CSDAP IMPLEMENTS threadpool.IHandleSink;
   PRIVATE VAR
      Running : BOOLEAN;
      Host : StringsO.CString;
      Client : SDAPClient.TPISDAPClient;
      Queue : msgqueue.CPtrQueue;
      Logger : log.CLogger;
      Cookie : CARDINAL;
      QueueSignal : Sync.SIGNAL;

   PUBLIC VAR
      EventSink : POINTER TO ISDAPEventSink;
   PUBLIC READONLY PROPERTY
      Connected : BOOLEAN;
      OutputQueueCount : CARDINAL;
   PUBLIC PROPERTY
      OutputQueueLength : CARDINAL;

   PUBLIC VIRTUAL PROCEDURE Dispose();

   // client commands
   PUBLIC PROCEDURE SetConfiguration( CONST LoggerToClone : log.CLogger; CONST Host : StringsO.CString );
   
   PUBLIC PROCEDURE Run() : Sync.TAsyncResult;
   PUBLIC PROCEDURE Stop();
   
   PUBLIC PROCEDURE Set( CONST Data, Value : StringsO.CString ) : Sync.TAsyncResult;
   PUBLIC PROCEDURE Ask( CONST Data : StringsO.CString ) : Sync.TAsyncResult;
   PUBLIC PROCEDURE Advise() : Sync.TAsyncResult;
   PUBLIC PROCEDURE Unadvise() : Sync.TAsyncResult;
   // completes immediatelly or results to IEventSink callback
   
   // IHandleSink
   LOCAL VIRTUAL PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : threadpool.TPoolHandle; UserId : PTR );

   // SELF
   PRIVATE PROCEDURE Communicate() : Sync.TAsyncResult;
END CSDAP;

(*===============================================================================*)

END SDAPBridge.
