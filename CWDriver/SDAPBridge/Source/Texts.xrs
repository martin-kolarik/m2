        </string>
        <string name="_InputQueueCountComment">
            <item lang="en-US">Count of events still waiting to be read out to application</item>
            <item lang="cs-CZ">Počet událostí čekajících na přijetí aplikací</item>
        </string>
        <string name="_OutputQueueCountComment">
            <item lang="en-US">Count of commands still waiting to be sent</item>
