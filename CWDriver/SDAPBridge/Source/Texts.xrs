            <item lang="cs-CZ">Chyba při otevření konfiguračního souboru</item>
        </string>
        <string name="_UnknownDebugMode">
            <item lang="en-US">Bad or unknown "target"</item>
            <item lang="cs-CZ">Chybný nebo neznámý cíl logování ("target")</item>
        </string>
        <string name="_UnknownDebugLevel">
            <item lang="en-US">Bad or unknown "level"</item>
            <item lang="cs-CZ">Chybná nebo neznámá úroveň logování ("level")</item>
        </string>
        <string name="_FileDebugMissingFile">
            <item lang="en-US">Missing "file" key for "target = file"</item>
            <item lang="cs-CZ">Chybí klíč "file" pro "target = file"</item>
        </string>
        <string name="_MissingInterfaceSection">
            <item lang="en-US">Missing "interface" section</item>
            <item lang="cs-CZ">Chybí sekce "interface"</item>
        </string>
        <string name="_MissingDeviceSection">
            <item lang="en-US">Missing "device" section</item>
            <item lang="cs-CZ">Chybí sekce "device"</item>
