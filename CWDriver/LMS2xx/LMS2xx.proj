<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <Manufacturer>Inris</Manufacturer>

        <ProductFlag>on</ProductFlag>
        <ProductId>Inris.SICK-LMS2xx.CWDriver</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>1</ProductVersionMinor>
        <FileDescription>Inris SICK LMS2xx Driver</FileDescription>

        <ProductGUID>F32EED46-B2A4-4d9c-B963-BA94DA211A45</ProductGUID>
        <ProductUpgradeGUID>E87BB124-2AE3-459d-A43F-B2EAB67B04B6</ProductUpgradeGUID>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
			<Components Include="modula2\modula2;api\clib;API\win32"/>
			<Components Include="modula2\m2rtl;modula2\m2ortl;library\ADT;library\Resources;library\Text;library\messaging;library\serial;library\CWdriver"/>
			<Modules Include="LMS2xx"/>
			<Messages Include="Texts"/>
		</ItemGroup>

    <PropertyGroup>
        <Export>export</Export>
    </PropertyGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
