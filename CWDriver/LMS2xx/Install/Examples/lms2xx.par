[comm]
baudrate = 56000
parity = no
databits = 8
stopbits = 1
cts_flow = false
dsr_flow = false
dtr_control = disable
rts_control = disable

rx_buffer = 4096
tx_buffer = 4096
rx_frame_buffer = 4096
tx_frame_buffer = 4096


[LMS2xx]
com_driver = CWCOMM4.DLL COM7
read_back = false
debug_mode = windows
debug_level = all
detect_from = 25
scan_factor = 1
