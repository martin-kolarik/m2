          <Directory Id="INSTALLDIR" LongName="Validator" Name="Validat">
            <Component Guid="8013545F-AB52-4E57-8A20-C6209D7626D6" Id="Program">
              <File DiskId="1" Id="Changelog.txt" Name="Changes.txt" Source="Changelog.txt" Vital="yes">
              </File>
              <File DiskId="1" Id="License.rtf" Name="License.rtf" Source="License.rtf" Vital="yes">
              </File>
              <File DiskId="1" Id="Validator.DLL" Name="Validato.dll" Source="Validator.dll" Vital="yes" LongName="Validator.dll">
              </File>
            </Component>
            <?if $(var.LeakChecking)=on ?>
