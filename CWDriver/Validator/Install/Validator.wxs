  <Product Codepage="1250" Id="3066F5DF-CB4F-4EBD-B8AC-5011870C795B" Language="1029" Manufacturer="Inris" Name="Application Validator Driver" UpgradeCode="F9474D3E-7475-4F6A-88C4-38DAF7C4B8C4" Version="1.0.821">
