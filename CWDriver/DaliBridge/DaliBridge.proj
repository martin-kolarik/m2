<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <Manufacturer Condition="$(Manufacturer)==''">Inris</Manufacturer>
        <ComponentType>Product</ComponentType>
    </PropertyGroup>

    <PropertyGroup>
        <ProductGUID>9DEA5575-18DF-4e91-A2C4-14392DA2921A</ProductGUID>
        <ProductUpgradeGUID>4C73C97D-457A-4a08-8556-47B3B167C9AA</ProductUpgradeGUID>
        <ProductId>Inris.DaliBridge.CWDriver</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>
        <FileDescription>Inris DALI Bridge Driver</FileDescription>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
        <Components Include="modula2\modula2;api\clib;API\win32"/>
        <Components Include="component\sccore;library\CWdriver"/>
        <Modules Include="DaliBridge;driver"/>
        <Messages Include="Texts"/>
    </ItemGroup>

    <PropertyGroup>
        <Export>export</Export>
    </PropertyGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
