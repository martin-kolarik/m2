DEFINITION MODULE DaliBridge;

(*===============================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   INIFile,
   lists,
   log,
   msghandler,
   msgqueue,
   StringsO;

(*===============================================================================*)
// internal data

TYPE
   TPCommunicator;
   TPICommunicatorSink = POINTER TO ICommunicatorSink;

LOCAL INTERFACE ICommunicatorSink; // in-thread
   LOCAL PROCEDURE OnSendable();
   LOCAL PROCEDURE OnTimeout();
   LOCAL PROCEDURE OnDaliData( Result : Sync.TAsyncResult; Data : ARRAY OF BYTE );
END ICommunicatorSink;

(*===============================================================================*)

TYPE
   TDaliAddress = (
      adrUnknown, adrAll, adrGroup, adrSingle
   );

   TDaliCommand = (
      cmdDirect = 1024,

      cmdOff = 0,
      cmdDimUp, cmdDimDown, cmdStepUp, cmdStepDown,
      cmdMax, cmdMin,
      cmdStepDownOff, cmdStepUpOn,

      cmdScene1 = 10H,

      cmdReset = 20H, cmdStoreCurrentToDTR,
      cmdDTRToMax = 2AH, cmdDTRToMin, cmdDTRToFail, cmdDTRToPowerOn, cmdDTRToFadeTime, cmdDTRToFadeRate,
      
      cmdSceneFromDTR1 = 040H,
      cmdSceneRemove1 = 050H,
      cmdGroupAdd1 = 060H,
      cmdGroupRemove1 = 070H,
      
      cmdStatus = 090H, cmdWorking = 091H, cmdVersion = 097H, cmdDeviceType = 099H,
      
      cmdCurrentLevel = 0A0H,
      
      cmdLoadDTR = 0A3H
   );
   
   TDaliCommands = SET OF TDaliCommand;
   
CONST
   repeatedCommands = TDaliCommands{
      cmdDTRToMax, cmdDTRToMin, cmdDTRToFail, cmdDTRToPowerOn, cmdDTRToFadeTime, cmdDTRToFadeRate
   };
   respondedCommands = TDaliCommands{
      cmdStatus, cmdWorking, cmdVersion, cmdDeviceType, cmdCurrentLevel
   };

(*-------------------------------------------------------------------------------*)

CLASS DaliAddress;
   PRIVATE VAR
      _Address : CARD8;
   PUBLIC READONLY PROPERTY
      TransportAddress : CARD8;
   PUBLIC PROPERTY
      Address : CARDINAL;
      Type : TDaliAddress;
   PUBLIC PROCEDURE ToString( OUT S : ARRAY OF WCHAR );
END DaliAddress;

(*-------------------------------------------------------------------------------*)

INTERFACE IDaliEventSink; // in-thread
   LOCAL PROCEDURE OnCompletion( Result : Sync.TAsyncResult; Command : TDaliCommand; ClientId : PTR; Linie : CARDINAL; CONST daliAddress : DaliAddress; Data : CARD8 );
END IDaliEventSink;

(*-------------------------------------------------------------------------------*)

CLASS CDali( msghandler.MessageHandler ) IMPLEMENTS ICommunicatorSink;
   PRIVATE VAR
      Communicator : TPCommunicator;
      Queue : msgqueue.CPtrQueue;
      QueueLength : CARDINAL;
   PUBLIC VAR
      EventSink : POINTER TO IDaliEventSink;
      Logger : log.CLogger;
   PUBLIC READONLY PROPERTY
      OutputQueueCount : CARDINAL;
   PUBLIC PROPERTY
      OutputQueueLength : CARDINAL;

   PUBLIC PROCEDURE Dispose();

   // client commands
   PUBLIC PROCEDURE LoadConfiguration( CONST ClientName, ParFilePath : ARRAY OF WCHAR; CONST INI : INIFile.CINIFile; REF logger : log.CLogger ) : BOOLEAN;
   
   PUBLIC PROCEDURE Run() : Sync.TAsyncResult;
   PUBLIC PROCEDURE Stop();
   
   PUBLIC PROCEDURE Command( Linie : CARDINAL; CONST daliAddress : DaliAddress; Command : TDaliCommand; Data : CARD8; CONST ClientId : PTR ) : Sync.TAsyncResult;
   // completes immediatelly or results to IEventSink callback
   
   // MessageHandler -- in thread
   INTERNAL VIRTUAL PROCEDURE OnMessage( CONST Message : msghandler.IMessage; OUT Result : PTR ) : BOOLEAN;
   
   // ICommunicationSink -- in thread
   LOCAL VIRTUAL PROCEDURE OnSendable();
   LOCAL VIRTUAL PROCEDURE OnTimeout();
   LOCAL VIRTUAL PROCEDURE OnDaliData( Result : Sync.TAsyncResult; Data : ARRAY OF BYTE );

   PRIVATE PROCEDURE Communicate() : Sync.TAsyncResult;
END CDali;

(*===============================================================================*)

END DaliBridge.
