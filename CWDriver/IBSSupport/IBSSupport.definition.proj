<Project
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <PropertyGroup>
        <Manufacturer>NeNo</Manufacturer>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName)=='IBSSupport'">
        <Result>Dynamic</Result>
    </PropertyGroup>
    <PropertyGroup Condition="$(MSBuildProjectName)=='SCCore'">
        <ComponentType>Generic</ComponentType>
    </PropertyGroup>

    <PropertyGroup>
        <ProductM2Control></ProductM2Control>
        <ProductCLControl></ProductCLControl>
        <ProductRCControl></ProductRCControl>
        <ProductLNControl></ProductLNControl>
    </PropertyGroup>

</Project>
