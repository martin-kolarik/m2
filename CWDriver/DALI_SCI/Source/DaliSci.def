DEFINITION MODULE DaliSci;

(*===============================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   INIFile,
   lists,
   log,
   StringsO;

(*===============================================================================*)
// internal data

TYPE
   TPCommunicator;
   TPICommunicatorSink = POINTER TO ICommunicatorSink;

LOCAL INTERFACE ICommunicatorSink; // in-thread
   LOCAL PROCEDURE OnTimeout();
   LOCAL PROCEDURE OnDaliData( Result : Sync.TAsyncResult; Data : ARRAY OF BYTE );
END ICommunicatorSink;

(*===============================================================================*)

TYPE
   TDaliAddress = (
      adrUnknown, adrAll, adrGroup, adrSingle
   );

   TDaliCommand = (
      cmdDirect = 1024,

      cmdOff = 0,
      cmdDimUp, cmdDimDown, cmdStepUp, cmdStepDown,
      cmdMax, cmdMin,
      cmdStepDownOff, cmdStepUpOn,

      cmdScene1 = 10H,

      cmdReset = 20H, cmdStoreCurrentToDTR,
      cmdDTRToMax = 2AH, cmdDTRToMin, cmdDTRToFail, cmdDTRToPowerOn, cmdDTRToFadeTime, cmdDTRToFadeRate,
      
      cmdSceneFromDTR1 = 040H,
      cmdSceneRemove1 = 050H,
      cmdGroupAdd1 = 060H,
      cmdGroupRemove1 = 070H,
      
      cmdStatus = 090H, cmdWorking = 091H, cmdVersion = 097H, cmdDeviceType = 099H,
      
      cmdCurrentLevel = 0A0H
   );

(*-------------------------------------------------------------------------------*)

CLASS DaliAddress;
   PRIVATE VAR
      _Address : CARD8;
   PUBLIC READONLY PROPERTY
      TransportAddress : CARD8;
   PUBLIC PROPERTY
      Address : CARDINAL;
      Type : TDaliAddress;
END DaliAddress;

(*-------------------------------------------------------------------------------*)

INTERFACE IDaliEventSink; // in-thread
   LOCAL PROCEDURE OnCompletion( Result : Sync.TAsyncResult; ClientId : PTR; CONST daliAddress : DaliAddress; Data : CARD8 );
END IDaliEventSink;

(*-------------------------------------------------------------------------------*)

CLASS CDali IMPLEMENTS ICommunicatorSink;
   PRIVATE VAR
      Communicator : TPCommunicator;
      Queue : lists.CPtrList;
   PUBLIC VAR
      EventSink : POINTER TO IDaliEventSink;

   PUBLIC PROCEDURE Dispose();

   // client commands
   PUBLIC PROCEDURE LoadConfiguration( CONST INI : INIFile.CINIFile; REF logger : log.CLogger ) : BOOLEAN;
   
   PUBLIC PROCEDURE Run() : Sync.TAsyncResult;
   PUBLIC PROCEDURE Stop();
   
   PUBLIC PROCEDURE Command( CONST daliAddress : DaliAddress; Command : TDaliCommand; Data : CARD8; CONST ClientId : PTR ) : Sync.TAsyncResult;
   // completes immediatelly or results to IEventSink callback
   
   // ICommunicationSink -- in thread
   LOCAL VIRTUAL PROCEDURE OnTimeout();
   LOCAL VIRTUAL PROCEDURE OnDaliData( Result : Sync.TAsyncResult; Data : ARRAY OF BYTE );

   PRIVATE PROCEDURE Communicate() : Sync.TAsyncResult;
END CDali;

(*===============================================================================*)

END DaliSci.
