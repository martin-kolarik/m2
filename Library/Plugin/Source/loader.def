DEFINITION MODULE loader;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   baseobject,
   iplugin,
   lists,
   maps;

#save, option( dll_export => on )

(*===========================================================================*)

TYPE
   TPPluginLoadAuthorizer = POINTER TO IPluginLoadAuthorizer;

INTERFACE IPluginLoadAuthorizer;
   PROCEDURE AuthorizedToLoad( CONST Plugin : iplugin.TPPlugin ) : BOOLEAN;
END IPluginLoadAuthorizer;

(*---------------------------------------------------------------------------*)

TYPE
   TStateItem = (
      lsEnabled
   );
   TState = SET OF TStateItem;

TYPE
   TPLoader = POINTER TO CLoader;
   
(*---------------------------------------------------------------------------*)

CLASS CLoaderPluginIterator( lists.CPtrListIterator );

   PUBLIC READONLY PROPERTY
      State : TState;
      Name : StringsO.CString;
      Path : StringsO.CString;

END CLoaderPluginIterator;

(*---------------------------------------------------------------------------*)

CLASS CLoader( baseobject.CDisposable );

   PUBLIC READONLY PROPERTY
      Host : StringsO.TPString;
      HostVersionString : StringsO.TPString;
   PUBLIC PROPERTY
      LoadAuthorizer : TPPluginLoadAuthorizer;
      
   PUBLIC PROCEDURE SetHostInfo( CONST Host, HostVersionString : ARRAY OF WCHAR );

   PUBLIC PROCEDURE AddPlugin( CONST PluginPath : ARRAY OF WCHAR; PluginName : StringsO.TPString ) : iplugin.TLoadResult; // PluginName is optional and will be filled with computed library identifier (usable in CreateObject)
   PUBLIC PROCEDURE RemovePlugin( CONST PluginPath : ARRAY OF WCHAR );
   PUBLIC PROCEDURE ScanPath( CONST Path, PluginNamePattern : ARRAY OF WCHAR; OUT Found : CARDINAL ) : iplugin.TLoadResult;

   PUBLIC PROCEDURE DisablePlugin( CONST PluginPath : ARRAY OF WCHAR );
   PUBLIC PROCEDURE EnablePlugin( CONST PluginPath : ARRAY OF WCHAR );

   PUBLIC PROCEDURE InitializePluginIterator( REF Iterator : CLoaderPluginIterator );
   
   PUBLIC PROCEDURE CreateObject( CONST ClassPath : ARRAY OF WCHAR; OUT Object : iplugin.TPPluginObject ) : iplugin.TLoadResult;
   PUBLIC PROCEDURE ReleaseObject( REF Object : iplugin.TPPluginObject );
   
   PUBLIC VIRTUAL PROCEDURE Dispose();
   
   // privates, helpers
   PRIVATE PROCEDURE LookupPlugin( CONST PluginPath : ARRAY OF WCHAR; OUT Plugin : ADDRESS ) : BOOLEAN;
   PRIVATE PROCEDURE BuildNames();

   PRIVATE VAR
      _Plugins : lists.CPtrList;
      _Names : maps.CStringPtrMap;
      _LoadAuthorizer : TPPluginLoadAuthorizer;
      _Host : StringsO.CString;
      _HostVersionString : StringsO.CString;

END CLoader;

(*===========================================================================*)

// global loader
PROCEDURE ldr() : TPLoader;

(*===========================================================================*)

#restore

END loader.