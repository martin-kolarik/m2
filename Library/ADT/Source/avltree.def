DEFINITION MODULE avltree;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   baseobject,
   collection;

(*===========================================================================*)
//
// AVL tree
//
// version 5 (c) 1993-2006 mk
//
(*===========================================================================*)

#save, option( dll_export => on )

// common types
TYPE
   TBalance = (
      tbLeftOverflow, tbLeft,
      tbNone,
      tbRight, tbRightOverflow
   );

(*---------------------------------------------------------------------------*)

TYPE
   // public classes
   TPAVLTreeKey = POINTER TO IAVLTreeKey;
   TPAVLTreeElem = POINTER TO AAVLTreeElem;
   TPAVLTreeIterator = POINTER TO CAVLTreeIterator;
   TPAVLTree = POINTER TO CAVLTree;

   // internal data structures
   TAVLIndex = RECORD
      L, R    : TPAVLTreeElem;
      Balance : TBalance;
      Items   : CARDINAL;
   END;
   TPAVLIndex = POINTER TO TAVLIndex;
   TPAVLIndexes = POINTER TO ARRAY [0..0] OF TAVLIndex;

(*===========================================================================*)
// basic AVL Tree

INTERFACE IAVLTreeKey;

   PROCEDURE Compare( i : CARDINAL; pelem : TPAVLTreeKey ) : TRISTATE;
   // method Compare must:
   //   return 0 for pelem^.[Data] = SELF.[Data]
   //          1 for pelem^.[Data] < SELF.[Data]
   //         -1 for pelem^.[Data] > SELF.[Data]

END IAVLTreeKey;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS AAVLTreeElem( baseobject.CDisposable ) IMPLEMENTS IAVLTreeKey;

   LOCAL ABSTRACT READONLY INDEX( i : CARDINAL ) : TPAVLIndex;

END AAVLTreeElem;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS CAVLTreeElem1( AAVLTreeElem );

   // AAVLTreeElem
   LOCAL FINAL READONLY INDEX( i : CARDINAL ) : TPAVLIndex;

   // SELF
   PRIVATE VAR
      _I : TAVLIndex;

END CAVLTreeElem1;

CONST
  CAVLTreeElem ::= CAVLTreeElem1;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS CAVLTreeElem2( AAVLTreeElem );

   // AAVLTreeElem
   LOCAL FINAL READONLY INDEX( i : CARDINAL ) : TPAVLIndex;

   // SELF  
   PRIVATE VAR
      _I : ARRAY [0..1] OF TAVLIndex;

END CAVLTreeElem2;

(*---------------------------------------------------------------------------*)

CLASS CAVLTree( baseobject.CDisposable ) IMPLEMENTS collection.ICollection;

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // ICollection
   PUBLIC FINAL READONLY PROPERTY
      Empty : BOOLEAN;
      Count : CARDINAL;
      Sequence : CARDINAL;

   #save, option( leak_info => on )
   PUBLIC VIRTUAL PROCEDURE colGetIterator() : collection.TPIterator;
   #restore
   PUBLIC VIRTUAL PROCEDURE colGetFirst( OUT object : baseobject.PBASE ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE colNextOf( CONST of : baseobject.PBASE; OUT object : baseobject.PBASE ) : BOOLEAN;

   // SELF
   PUBLIC FINAL PROPERTY
      KeyCount : CARDINAL; // each element can have more keys
  
   PUBLIC PROCEDURE Contains( keyIndex : CARDINAL; CONST Key : TPAVLTreeKey ) : BOOLEAN;
   PUBLIC PROCEDURE Add( Element : TPAVLTreeElem );
   PUBLIC PROCEDURE Get( keyIndex : CARDINAL; CONST Key : TPAVLTreeKey; OUT Found : TPAVLTreeElem ) : BOOLEAN;
   PUBLIC PROCEDURE Remove( keyIndex : CARDINAL; CONST Key : TPAVLTreeKey; OUT Removed : TPAVLTreeElem ) : BOOLEAN;
   PUBLIC PROCEDURE Delete( keyIndex : CARDINAL; CONST Key : TPAVLTreeKey ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( keyIndex : CARDINAL; Index : CARDINAL; OUT Element : TPAVLTreeElem ) : BOOLEAN;

   PUBLIC PROCEDURE GetFirst( keyIndex : CARDINAL; OUT First : TPAVLTreeElem ) : BOOLEAN;
   PUBLIC PROCEDURE GetLast( keyIndex : CARDINAL; OUT Last : TPAVLTreeElem ) : BOOLEAN;

   PUBLIC PROCEDURE PrevOf( keyIndex : CARDINAL; CONST Element : TPAVLTreeElem; OUT Previous : TPAVLTreeElem ) : BOOLEAN;
   PUBLIC PROCEDURE NextOf( keyIndex : CARDINAL; CONST Element : TPAVLTreeElem; OUT Next : TPAVLTreeElem ) : BOOLEAN;
   PUBLIC PROCEDURE IndexOf( keyIndex : CARDINAL; CONST Key : TPAVLTreeKey ) : CARDINAL;

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPAVLTreeIterator;
   #restore

   // private
   PRIVATE VAR
      _Root : POINTER TO ARRAY [0..0] OF TPAVLTreeElem;
      _KeyCount : CARDINAL; // by default 1
      _Sequence : CARDINAL := 0;

   PRIVATE PROCEDURE iBalanceL( keyIndex : CARDINAL; REF Element : TPAVLTreeElem );
   PRIVATE PROCEDURE iBalanceR( keyIndex : CARDINAL; REF Element : TPAVLTreeElem );
   PRIVATE PROCEDURE iRemoveBalanceL( keyIndex : CARDINAL; REF Element : TPAVLTreeElem; REF w : BOOLEAN );
   PRIVATE PROCEDURE iRemoveBalanceR( keyIndex : CARDINAL; REF Element : TPAVLTreeElem; REF w : BOOLEAN );
   PRIVATE PROCEDURE iFindPredecessor( keyIndex : CARDINAL; REF Element : TPAVLTreeElem; REF w : BOOLEAN ) : TPAVLTreeElem;

END CAVLTree;

(*---------------------------------------------------------------------------*)

CLASS CAVLTreeIterator( collection.CIterator );

   // SELF
   PUBLIC READONLY PROPERTY
      Current : TPAVLTreeElem;

END CAVLTreeIterator;

(*==========================================================================*)

#restore

END avltree.