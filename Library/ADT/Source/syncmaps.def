DEFINITION MODULE syncmaps;

FROM Storage IMPORT
   ALLOCATE;

IMPORT
   maps,
   Sync;
   
FROM StringsO IMPORT
   IString;

#save, option( dll_export => on )

(*================================================================================*)

TYPE
   TPPtrBaseSyncMap = POINTER TO CPtrBaseSyncMap;

CLASS CPtrBaseSyncMap( maps.CPtrBaseMap ); // for enumerating (GetFirst/Last/Next/Prev) it must be locked explicitely

   PRIVATE VAR
      _Lock : Sync.RWLOCK;
      
   PUBLIC READONLY PROPERTY
      Lock : Sync.TPILockR;

   // TODO: Count, Empty

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( Key : PTR; Data : PTR );
   PUBLIC PROCEDURE Remove( Key : PTR );
   PUBLIC PROCEDURE Contains( Key : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : PTR; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : PTR; OUT Data : PTR ) : BOOLEAN;

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : maps.TPPtrBaseMapIterator;
   #restore

END CPtrBaseSyncMap;

(*================================================================================*)

TYPE
   TPStringBaseSyncMap = POINTER TO CStringBaseSyncMap;

CLASS CStringBaseSyncMap( maps.CStringBaseMap ); // for enumerating (GetFirst/Last/Next/Prev) it must be locked explicitely

   PRIVATE VAR
      _Lock : Sync.RWLOCK;
      
   PUBLIC READONLY PROPERTY
      Lock : Sync.TPILockR;

   // TODO: Count, Empty

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( CONST Key : IString; Data : PTR );
   PUBLIC PROCEDURE Remove( CONST Key : IString );
   PUBLIC PROCEDURE Contains( CONST Key : IString ) : BOOLEAN;
   PUBLIC PROCEDURE Get( CONST Key : IString; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : IString; OUT Data : PTR ) : BOOLEAN;

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : maps.TPStringBaseMapIterator;
   #restore

END CStringBaseSyncMap;

(*================================================================================*)

#restore

END syncmaps.