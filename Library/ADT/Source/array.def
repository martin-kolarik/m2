DEFINITION MODULE array;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   baseobject,
   collection,
   Exceptions;

#save, option( dll_export => on )

(*=============================================================================*)

TYPE
   TPArray = POINTER TO CArray;
   TPArrayIterator = POINTER TO CArrayIterator;
  
TYPE
  TStrategy = (
    astrgUnknown,
    astrgListInArray, // removed indexes are compacted
    astrgSparseArray // removed index stays in place (and is unused forever), so another indexes remain valid
  );

CLASS CArray( baseobject.CDisposable ) IMPLEMENTS collection.ICollection;

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // ICollection
   PUBLIC VIRTUAL READONLY PROPERTY
      Empty : BOOLEAN;
      Count : CARDINAL;
      Sequence : CARDINAL;

   #save, option( leak_info => on )
   PUBLIC VIRTUAL PROCEDURE colGetIterator( Direction : collection.TDirection ) : collection.TPIterator;
   #restore
   PUBLIC VIRTUAL PROCEDURE colGetFirst( OUT object : baseobject.PBASE ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE colNextOf( CONST of : baseobject.PBASE; OUT object : baseobject.PBASE ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE colGetLast( OUT object : baseobject.PBASE ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE colPrevOf( CONST of : baseobject.PBASE; OUT object : baseobject.PBASE ) : BOOLEAN;

   // SELF -- list interface
   PUBLIC PROCEDURE Contains( CONST Item : ARRAY OF BYTE ) : BOOLEAN;
   #save, option( leak_info => on )
   PUBLIC PROCEDURE Add( CONST Item : ARRAY OF BYTE ) : INTEGER; // returns index
   #restore
   PUBLIC PROCEDURE Remove( CONST Item : ARRAY OF BYTE );
   PUBLIC PROCEDURE ElementAt( Index : INTEGER; OUT Item : ARRAY OF BYTE ) : BOOLEAN;

   #save, option( leak_info => on )
   PUBLIC PROCEDURE Insert( ToIndex : INTEGER; CONST Item : ARRAY OF BYTE );
   PUBLIC PROCEDURE RemoveIndex( Index : INTEGER ) : BOOLEAN;
   #restore
   PUBLIC PROCEDURE IndexOf( CONST Item : ARRAY OF BYTE ) : INTEGER; // if not found returns LowBound-1
   PUBLIC PROCEDURE Clear();

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator( Direction : collection.TDirection ) : TPArrayIterator;
   #restore

   // SELF -- queue interface
   PUBLIC PROCEDURE Enqueue( CONST Item : ARRAY OF BYTE );
   PUBLIC PROCEDURE Dequeue( OUT Item : ARRAY OF BYTE ) : BOOLEAN; 

   // SELF -- itself
   PUBLIC PROPERTY
      Strategy : TStrategy;
      Size : CARDINAL; // get, set initializes (to 0)/reallocates space
      ItemSize : CARDINAL; // initializes whole array, looses data
      LowBound : INTEGER;
   PUBLIC WRITEONLY PROPERTY
      setCount : CARDINAL; // getter is inherited as readonly
   PUBLIC READONLY PROPERTY
      Data : ADDRESS;

   PUBLIC INDEX( Index : INTEGER ) : ADDRESS THROWS Exceptions.CModula2Exception; // on set, data of at least ItemSize is expected
  
   PRIVATE VAR
      _Sequence : CARDINAL := 0;
      _Strategy : TStrategy := astrgSparseArray;
      _Size : CARDINAL := 0;
      _ItemSize : CARDINAL := 8;
      _LowBound : INTEGER := 0;
      _Count : CARDINAL := 0;
      _Data : ADDRESS := NIL;

END CArray;

(*---------------------------------------------------------------------------*)

CLASS CArrayIterator( collection.CIterator );

   // SELF
   PUBLIC READONLY PROPERTY
      Current : ADDRESS; // address of the item

END CArrayIterator;

(*=============================================================================*)

#restore

END array.