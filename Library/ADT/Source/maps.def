DEFINITION MODULE maps;

//===========================================================================
//
// simple AVL tree implementations
//
// version 1 (c) 1993-2006 mk
//
//===========================================================================
//
// All classes having "Value : PTR" parameter properly distinguish between baseobject.BASE, baseobject.CDisposable and baseobject.CRefcounted
// and calls proper deallocation if "ValueOwnership = TRUE".

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
  
IMPORT
   avltree,
   baseobject;

FROM StringsO IMPORT
   IString, TPString;

#save, option( dll_export => on )

(*==========================================================================*)

CLASS CValueOwnershipControlMap( avltree.CAVLTree ); // ancestors with ValueOwnership = TRUE will examine Value : PTR as being PBASE and deallocate it

   // SELF
   PUBLIC PROPERTY
      ValueOwnership : BOOLEAN;

   PRIVATE VAR
      _ValueOwnership : BOOLEAN := FALSE;

END CValueOwnershipControlMap;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS CDataItem( avltree.CAVLTreeElem );

   // SELF   
   PUBLIC VAR
      Data : PTR := NIL;

END CDataItem;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS CValueItem( CDataItem ); // The item disposes Value if owning map wants. Distinguished are: BASE, CDisposable, CRefcounted.

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // SELF   
   PUBLIC VAR
      Value : PTR := NIL;
   LOCAL VAR
      OfValueOwnershipControlMap : POINTER TO CValueOwnershipControlMap := NIL;

END CValueItem;

(*==========================================================================*)

TYPE
   TPIntegerPtrMap = POINTER TO CIntegerPtrMap;
   TPIntegerPtrMapIterator = POINTER TO CIntegerPtrMapIterator;

CLASS CIntegerPtrMap( CValueOwnershipControlMap );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( Key : INTEGER; Value, Data : PTR );
   PUBLIC PROCEDURE Remove( Key : INTEGER );
   PUBLIC PROCEDURE Contains( Key : INTEGER ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : INTEGER; OUT Value : PTR; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Set( Key : INTEGER; Value, Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : INTEGER; OUT Value : PTR; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPIntegerPtrMapIterator;
   #restore

END CIntegerPtrMap;

CLASS CIntegerPtrMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : INTEGER;
   PUBLIC PROPERTY
      Value : PTR;
      Data : PTR;

   PUBLIC PROCEDURE Init( CONST OfCollection : CIntegerPtrMap; Direction : collection.TDirection );

END CIntegerPtrMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPIntegerStringMap = POINTER TO CIntegerStringMap;
   TPIntegerStringMapIterator = POINTER TO CIntegerStringMapIterator;

CLASS CIntegerStringMap( avltree.CAVLTree );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : TPString;

   PUBLIC PROCEDURE Add( Key : INTEGER; CONST Value : IString; Data : PTR );
   PUBLIC PROCEDURE Remove( Key : INTEGER );
   PUBLIC PROCEDURE Contains( Key : INTEGER ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : INTEGER; OUT Value : IString; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Set( Key : INTEGER; CONST Value : IString; Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : INTEGER; OUT Value : IString; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPIntegerStringMapIterator;
   #restore

END CIntegerStringMap;

CLASS CIntegerStringMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : INTEGER;
      Value : TPString;
   PUBLIC PROPERTY
      Data : PTR;

   PUBLIC PROCEDURE Init( CONST OfCollection : CIntegerStringMap; Direction : collection.TDirection );

END CIntegerStringMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPPtrPtrMap = POINTER TO CPtrPtrMap;
   TPPtrPtrMapIterator = POINTER TO CPtrPtrMapIterator;

CLASS CPtrPtrMap( CValueOwnershipControlMap );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( Key : PTR; Value, Data : PTR );
   PUBLIC PROCEDURE Remove( Key : PTR );
   PUBLIC PROCEDURE Contains( Key : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : PTR; OUT Value : PTR; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Set( Key : PTR; Value, Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : PTR; OUT Value : PTR; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPPtrPtrMapIterator;
   #restore

END CPtrPtrMap;

CLASS CPtrPtrMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : PTR;
   PUBLIC PROPERTY
      Value : PTR;
      Data : PTR;

   PUBLIC PROCEDURE Init( CONST OfCollection : CPtrPtrMap; Direction : collection.TDirection );

END CPtrPtrMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPStringPtrMap = POINTER TO CStringPtrMap;
   TPStringPtrMapIterator = POINTER TO CStringPtrMapIterator;

CLASS CStringPtrMap( CValueOwnershipControlMap );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( CONST Key : IString; Value, Data : PTR );
   PUBLIC PROCEDURE Remove( CONST Key : IString );
   PUBLIC PROCEDURE Contains( CONST Key : IString ) : BOOLEAN;
   PUBLIC PROCEDURE Get( CONST Key : IString; OUT Value : PTR; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Set( CONST Key : IString; Value, Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : IString; OUT Value : PTR; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPStringPtrMapIterator;
   #restore

END CStringPtrMap;

CLASS CStringPtrMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : TPString;
   PUBLIC PROPERTY
      Value : PTR;
      Data : PTR;

   PUBLIC PROCEDURE Init( CONST OfCollection : CStringPtrMap; Direction : collection.TDirection );

END CStringPtrMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPStringStringMap = POINTER TO CStringStringMap;
   TPStringStringMapIterator = POINTER TO CStringStringMapIterator;

CLASS CStringStringMap( avltree.CAVLTree );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : TPString;

   PUBLIC PROCEDURE Add( CONST Key : IString; CONST Value : IString; Data : PTR );
   PUBLIC PROCEDURE Remove( CONST Key : IString );
   PUBLIC PROCEDURE Contains( CONST Key : IString ) : BOOLEAN;
   PUBLIC PROCEDURE Get( CONST Key : IString; OUT Value : IString; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Set( CONST Key : IString; CONST Value : IString; Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : IString; OUT Value : IString; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPStringStringMapIterator;
   #restore

END CStringStringMap;

CLASS CStringStringMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : TPString;
      Value : TPString;
   PUBLIC PROPERTY
      Data : PTR;

   PUBLIC PROCEDURE Init( CONST OfCollection : CStringStringMap; Direction : collection.TDirection );

END CStringStringMapIterator;

//===========================================================================

#restore

END maps.