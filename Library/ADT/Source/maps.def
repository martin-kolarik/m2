DEFINITION MODULE maps;

//===========================================================================
//
// simple AVL tree implementations
//
// version 1 (c) 1993-2006 mk
//
//===========================================================================
//
// All classes having "Data : PBASE" parameter properly distinguish between baseobject.BASE, baseobject.CDisposable and baseobject.CRefcounted
// and calls proper deallocation if "DataOwnership = TRUE".

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
  
IMPORT
   avltree,
   baseobject;

FROM StringsO IMPORT
   IString, CString;

//---------------------------------------------------------------------------

#save, option( dll_export => on )

CLASS CDataOwnershipControlMap( avltree.CAVLTree );

   PUBLIC PROPERTY
      DataOwnership : BOOLEAN;

   PRIVATE VAR
      _DataOwnership : BOOLEAN := FALSE;

END CDataOwnershipControlMap;

//---------------------------------------------------------------------------

TYPE
   TPIntegerBaseMap = POINTER TO CIntegerBaseMap;
   TPIntegerBaseMapIterator = POINTER TO CIntegerBaseMapIterator;

CLASS CIntegerBaseMap( CDataOwnershipControlMap );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : baseobject.PBASE;

   PUBLIC PROCEDURE Add( Key : INTEGER; Data : baseobject.PBASE );
   PUBLIC PROCEDURE Remove( Key : INTEGER );
   PUBLIC PROCEDURE Contains( Key : INTEGER ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : INTEGER; OUT Data : baseobject.PBASE ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : INTEGER; OUT Data : baseobject.PBASE ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPIntegerBaseMapIterator;
   #restore

END CIntegerBaseMap;

CLASS CIntegerBaseMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : INTEGER;
   PUBLIC PROPERTY
      Data : baseobject.PBASE;

END CIntegerBaseMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPIntegerStringMap = POINTER TO CIntegerStringMap;
   TPIntegerStringMapIterator = POINTER TO CIntegerStringMapIterator;

CLASS CIntegerStringMap( avltree.CAVLTree );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : POINTER TO CString;

   PUBLIC PROCEDURE Add( Key : INTEGER; CONST Data : IString );
   PUBLIC PROCEDURE Remove( Key : INTEGER );
   PUBLIC PROCEDURE Contains( Key : INTEGER ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : INTEGER; OUT Data : IString ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : INTEGER; OUT Data : IString ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPIntegerStringMapIterator;
   #restore

END CIntegerStringMap;

CLASS CIntegerStringMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : INTEGER;
      Data : POINTER TO CString;

END CIntegerStringMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPPtrBaseMap = POINTER TO CPtrBaseMap;
   TPPtrBaseMapIterator = POINTER TO CPtrBaseMapIterator;

CLASS CPtrBaseMap( CDataOwnershipControlMap );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( Key : PTR; Data : PTR );
   PUBLIC PROCEDURE Remove( Key : PTR );
   PUBLIC PROCEDURE Contains( Key : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : PTR; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : PTR; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPPtrBaseMapIterator;
   #restore

END CPtrBaseMap;

CLASS CPtrBaseMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : PTR;
      Data : baseobject.PBASE;

END CPtrBaseMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPStringBaseMap = POINTER TO CStringBaseMap;
   TPStringBaseMapIterator = POINTER TO CStringBaseMapIterator;

CLASS CStringBaseMap( CDataOwnershipControlMap );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( CONST Key : IString; Data : PTR );
   PUBLIC PROCEDURE Remove( CONST Key : IString );
   PUBLIC PROCEDURE Contains( CONST Key : IString ) : BOOLEAN;
   PUBLIC PROCEDURE Get( CONST Key : IString; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : IString; OUT Data : PTR ) : BOOLEAN; // similar as []

   PUBLIC PROCEDURE AddOA( CONST Key : ARRAY OF WCHAR; Data : PTR );
   PUBLIC PROCEDURE RemoveOA( CONST Key : ARRAY OF WCHAR );
   PUBLIC PROCEDURE ContainsOA( CONST Key : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE GetOA( CONST Key : ARRAY OF WCHAR; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAtOA( Index : CARDINAL; OUT Key : ARRAY OF WCHAR; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPStringBaseMapIterator;
   #restore

END CStringBaseMap;

CLASS CStringBaseMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : POINTER TO CString;
      Data : baseobject.PBASE;

END CStringBaseMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPStringStringMap = POINTER TO CStringStringMap;
   TPStringStringMapIterator = POINTER TO CStringStringMapIterator;

CLASS CStringStringMap( avltree.CAVLTree );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : POINTER TO CString;

   PUBLIC PROCEDURE Add( CONST Key : IString; CONST Data : IString );
   PUBLIC PROCEDURE Remove( CONST Key : IString );
   PUBLIC PROCEDURE Contains( CONST Key : IString ) : BOOLEAN;
   PUBLIC PROCEDURE Get( CONST Key : IString; OUT Data : IString ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : IString; OUT Data : IString ) : BOOLEAN; // similar as []

   PUBLIC PROCEDURE AddOA( CONST Key : ARRAY OF WCHAR; CONST Data : IString );
   PUBLIC PROCEDURE RemoveOA( CONST Key : ARRAY OF WCHAR );
   PUBLIC PROCEDURE ContainsOA( CONST Key : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE GetOA( CONST Key : ARRAY OF WCHAR; OUT Data : IString ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAtOA( Index : CARDINAL; OUT Key : ARRAY OF WCHAR; OUT Data : IString ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPStringStringMapIterator;
   #restore

END CStringStringMap;

CLASS CStringStringMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : POINTER TO CString;
      Data : POINTER TO CString;

END CStringStringMapIterator;

//===========================================================================

#restore

END maps.