DEFINITION MODULE maps;

//===========================================================================
//
// simple AVL tree implementations
//
// version 1 (c) 1993-2006 mk
//
//===========================================================================
//
// All classes having "Data : PIBASE" parameter properly distinguish between baseobject.BASE, baseobject.CDisposable and baseobject.CRefcounted
// and calls proper deallocation if "DataOwnership = TRUE".

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
  
IMPORT
   avltree,
   baseobject;

FROM StringsO IMPORT
   IString, TPString;

//---------------------------------------------------------------------------

#save, option( dll_export => on )

CLASS CDataOwnershipControlMap( avltree.CAVLTree ); // ancestors with DataOwnership = TRUE will examine Data : PTR as being PBASE and deallocate it

   // SELF
   PUBLIC PROPERTY
      DataOwnership : BOOLEAN;

   PRIVATE VAR
      _DataOwnership : BOOLEAN := FALSE;

END CDataOwnershipControlMap;

//---------------------------------------------------------------------------

TYPE
   TPIntegerPtrMap = POINTER TO CIntegerPtrMap;
   TPIntegerPtrMapIterator = POINTER TO CIntegerPtrMapIterator;

CLASS CIntegerPtrMap( CDataOwnershipControlMap );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( Key : INTEGER; Data : PTR );
   PUBLIC PROCEDURE Remove( Key : INTEGER );
   PUBLIC PROCEDURE Contains( Key : INTEGER ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : INTEGER; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : INTEGER; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPIntegerPtrMapIterator;
   #restore

END CIntegerPtrMap;

CLASS CIntegerPtrMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : INTEGER;
   PUBLIC PROPERTY
      Data : PTR;

END CIntegerPtrMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPIntegerStringMap = POINTER TO CIntegerStringMap;
   TPIntegerStringMapIterator = POINTER TO CIntegerStringMapIterator;

CLASS CIntegerStringMap( avltree.CAVLTree );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : TPString;

   PUBLIC PROCEDURE Add( Key : INTEGER; CONST Data : IString );
   PUBLIC PROCEDURE Remove( Key : INTEGER );
   PUBLIC PROCEDURE Contains( Key : INTEGER ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : INTEGER; OUT Data : IString ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : INTEGER; OUT Data : IString ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPIntegerStringMapIterator;
   #restore

END CIntegerStringMap;

CLASS CIntegerStringMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : INTEGER;
      Data : TPString;

END CIntegerStringMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPPtrPtrMap = POINTER TO CPtrPtrMap;
   TPPtrPtrMapIterator = POINTER TO CPtrPtrMapIterator;

CLASS CPtrPtrMap( CDataOwnershipControlMap );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( Key : PTR; Data : PTR );
   PUBLIC PROCEDURE Remove( Key : PTR );
   PUBLIC PROCEDURE Contains( Key : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Get( Key : PTR; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : PTR; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPPtrPtrMapIterator;
   #restore

END CPtrPtrMap;

CLASS CPtrPtrMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : PTR;
   PUBLIC PROPERTY
      Data : PTR;

END CPtrPtrMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPStringPtrMap = POINTER TO CStringPtrMap;
   TPStringPtrMapIterator = POINTER TO CStringPtrMapIterator;

CLASS CStringPtrMap( CDataOwnershipControlMap );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : PTR;

   PUBLIC PROCEDURE Add( CONST Key : IString; Data : PTR );
   PUBLIC PROCEDURE Remove( CONST Key : IString );
   PUBLIC PROCEDURE Contains( CONST Key : IString ) : BOOLEAN;
   PUBLIC PROCEDURE Get( CONST Key : IString; OUT Data : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : IString; OUT Data : PTR ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPStringPtrMapIterator;
   #restore

END CStringPtrMap;

CLASS CStringPtrMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : TPString;
   PUBLIC PROPERTY
      Data : PTR;

END CStringPtrMapIterator;

//---------------------------------------------------------------------------

TYPE
   TPStringStringMap = POINTER TO CStringStringMap;
   TPStringStringMapIterator = POINTER TO CStringStringMapIterator;

CLASS CStringStringMap( avltree.CAVLTree );

   PUBLIC READONLY INDEX( Index : CARDINAL ) : TPString;

   PUBLIC PROCEDURE Add( CONST Key : IString; CONST Data : IString );
   PUBLIC PROCEDURE Remove( CONST Key : IString );
   PUBLIC PROCEDURE Contains( CONST Key : IString ) : BOOLEAN;
   PUBLIC PROCEDURE Get( CONST Key : IString; OUT Data : IString ) : BOOLEAN;
   PUBLIC PROCEDURE ElementAt( Index : CARDINAL; OUT Key : IString; OUT Data : IString ) : BOOLEAN; // similar as []

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator() : TPStringStringMapIterator;
   #restore

END CStringStringMap;

CLASS CStringStringMapIterator( avltree.CAVLTreeIterator );

   PUBLIC READONLY PROPERTY
      Key : TPString;
      Data : TPString;

END CStringStringMapIterator;

//===========================================================================

#restore

END maps.