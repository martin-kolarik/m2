DEFINITION MODULE arrays;

IMPORT
   array,
   baseobject,
   collection;
  
#save, option( dll_export => on )

(*=============================================================================*)

TYPE
   TPIntegerArray = POINTER TO CIntegerArray;
   TPIntegerArrayIterator = POINTER TO CIntegerArrayIterator;

CLASS CIntegerArray( array.CArray );

   // array/list interface
   PUBLIC INDEX( Index : INTEGER ) : INTEGER; // returns 0 if index is out of range

   PUBLIC PROCEDURE Contains( Value : INTEGER ) : BOOLEAN;
   PUBLIC PROCEDURE Add( Value : INTEGER ) : INTEGER; // returns index
   PUBLIC PROCEDURE Insert( ToIndex : INTEGER; Value : INTEGER );
   PUBLIC PROCEDURE Remove( Value : INTEGER );
   PUBLIC PROCEDURE ElementAt( Index : INTEGER; OUT Value : INTEGER ) : BOOLEAN;

   PUBLIC PROCEDURE IndexOf( Value : INTEGER ) : INTEGER; // if not found returns LowBound-1

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator( Direction : collection.TDirection ) : TPIntegerArrayIterator;
   #restore

   // queue interface
   #save, option( leak_info => on )
   PUBLIC PROCEDURE Enqueue( Value : INTEGER );
   #restore
   PUBLIC PROCEDURE Dequeue( OUT Value : INTEGER ) : BOOLEAN; 

   PRIVATE PROCEDURE Init(); // deny usage

END CIntegerArray;

(*---------------------------------------------------------------------------*)

CLASS CIntegerArrayIterator( array.CArrayIterator );

   PUBLIC READONLY PROPERTY
      Value : INTEGER;

END CIntegerArrayIterator;

(*=============================================================================*)

TYPE
   TPPtrArray = POINTER TO CPtrArray;
   TPPtrArrayIterator = POINTER TO CPtrArrayIterator;

CLASS CPtrArray( array.CArray );

   PUBLIC INDEX( Index : INTEGER ) : PTR; // returns 0 if index is out of range

   PUBLIC PROCEDURE Contains( Value : PTR ) : BOOLEAN;
   PUBLIC PROCEDURE Add( Value : PTR ) : INTEGER; // returns index
   PUBLIC PROCEDURE Insert( ToIndex : INTEGER; Value : PTR );
   PUBLIC PROCEDURE Remove( Value : PTR );
   PUBLIC PROCEDURE ElementAt( Index : INTEGER; OUT Value : PTR ) : BOOLEAN;

   PUBLIC PROCEDURE IndexOf( Value : PTR ) : INTEGER; // if not found returns LowBound-1

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator( Direction : collection.TDirection ) : TPPtrArrayIterator;
   #restore

   // queue interface
   #save, option( leak_info => on )
   PUBLIC PROCEDURE Enqueue( Value : PTR );
   #restore
   PUBLIC PROCEDURE Dequeue( OUT Value : PTR ) : BOOLEAN; 

   // SELF
   PUBLIC PROPERTY
      DataOwnership : BOOLEAN;

   PRIVATE VAR
      _DataOwnership : BOOLEAN := FALSE;

   PRIVATE PROCEDURE Init(); // deny usage
   PRIVATE PROCEDURE DisposeOwned( Data : PTR );

END CPtrArray;

(*---------------------------------------------------------------------------*)

CLASS CPtrArrayIterator( array.CArrayIterator );

   PUBLIC READONLY PROPERTY
      Value : PTR;

END CPtrArrayIterator;

(*=============================================================================*)

#restore

END arrays.