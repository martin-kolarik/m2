DEFINITION MODULE arrays;

IMPORT
   array,
   baseobject,
   collection;
  
#save, option( dll_export => on )

(*=============================================================================*)

TYPE
   TPIntegerArray = POINTER TO CIntegerArray;
   TPIntegerArrayIterator = POINTER TO CIntegerArrayIterator;

CLASS CIntegerArray( array.CArray );

   // array/list interface
   PUBLIC INDEX( Index : INTEGER ) : INTEGER; // returns 0 if index is out of range

   PUBLIC PROCEDURE Contains( Value : INTEGER ) : BOOLEAN;
   PUBLIC PROCEDURE Add( Value : INTEGER ) : INTEGER; // returns index
   PUBLIC PROCEDURE Insert( ToIndex : INTEGER; Value : INTEGER );
   PUBLIC PROCEDURE Remove( Value : INTEGER );
   PUBLIC PROCEDURE ElementAt( Index : INTEGER; OUT Value : INTEGER ) : BOOLEAN;

   PUBLIC PROCEDURE IndexOf( Value : INTEGER ) : INTEGER; // if not found returns LowBound-1

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator( Direction : collection.TDirection ) : TPIntegerArrayIterator;
   #restore

   // queue interface
   #save, option( leak_info => on )
   PUBLIC PROCEDURE Enqueue( Value : INTEGER );
   #restore
   PUBLIC PROCEDURE Dequeue( OUT Value : INTEGER ) : BOOLEAN; 

   PRIVATE PROCEDURE Init(); // deny usage

END CIntegerArray;

(*---------------------------------------------------------------------------*)

CLASS CIntegerArrayIterator( array.CArrayIterator );

   PUBLIC READONLY PROPERTY
      Value : INTEGER;

END CIntegerArrayIterator;

(*=============================================================================*)

TYPE
   TPBaseArray = POINTER TO CBaseArray;
   TPBaseArrayIterator = POINTER TO CBaseArrayIterator;

CLASS CBaseArray( array.CArray );

   PUBLIC INDEX( Index : INTEGER ) : baseobject.PIBASE; // returns 0 if index is out of range

   PUBLIC PROCEDURE Contains( Value : baseobject.PIBASE ) : BOOLEAN;
   PUBLIC PROCEDURE Add( Value : baseobject.PIBASE ) : INTEGER; // returns index
   PUBLIC PROCEDURE Insert( ToIndex : INTEGER; Value : baseobject.PIBASE );
   PUBLIC PROCEDURE Remove( Value : baseobject.PIBASE );
   PUBLIC PROCEDURE ElementAt( Index : INTEGER; OUT Value : baseobject.PIBASE ) : BOOLEAN;

   PUBLIC PROCEDURE IndexOf( Value : baseobject.PIBASE ) : INTEGER; // if not found returns LowBound-1

   #save, option( leak_info => on )
   PUBLIC PROCEDURE GetIterator( Direction : collection.TDirection ) : TPBaseArrayIterator;
   #restore

   // queue interface
   #save, option( leak_info => on )
   PUBLIC PROCEDURE Enqueue( Value : baseobject.PIBASE );
   #restore
   PUBLIC PROCEDURE Dequeue( OUT Value : baseobject.PIBASE ) : BOOLEAN; 

   // SELF
   PUBLIC PROPERTY
      DataOwnership : BOOLEAN;

   PRIVATE VAR
      _DataOwnership : BOOLEAN := FALSE;

   PRIVATE PROCEDURE Init(); // deny usage
   PRIVATE PROCEDURE DisposeOwned( Data : baseobject.PIBASE );

END CBaseArray;

(*---------------------------------------------------------------------------*)

CLASS CBaseArrayIterator( array.CArrayIterator );

   PUBLIC READONLY PROPERTY
      Value : baseobject.PIBASE;

END CBaseArrayIterator;

(*=============================================================================*)

#restore

END arrays.