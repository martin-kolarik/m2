DEFINITION MODULE nsimpl;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   avltree,
   IOO,
   iovalue,
   ns,
   StringsO,
   Sync;

(*---------------------------------------------------------------------------*)

TYPE
  TPNameValuePairs = POINTER TO NameValuePairs;

CLASS NameValuePairs IMPLEMENTS ns.IHierarchyMapper, iovalue.INameValuePairs; // ( baseobject.CDisposable ) // not synchronized

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // IHierarchyMapper
   PUBLIC VIRTUAL PROCEDURE NameToHash( CONST Name : StringsO.IString; OUT Hash : ns.THash ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE HashToName( CONST Hash : ns.THash; OUT Name : StringsO.IString ) : BOOLEAN; // STATIC
   PUBLIC VIRTUAL PROCEDURE HashToValue( CONST Hash : ns.THash; OUT Value : iovalue.TPValue ) : BOOLEAN; // STATIC
   PUBLIC VIRTUAL PROCEDURE HashToParent( CONST Hash : ns.THash; OUT Parent : ns.THash ) : BOOLEAN; // STATIC

   // INameValuePairs
   PUBLIC VIRTUAL PROCEDURE Get( CONST NameOrIndex : StringsO.IString; OUT Value : iovalue.TPValue ) : BOOLEAN; // tries to convert string to number, if it succeeds index is used
   PUBLIC VIRTUAL PROCEDURE Map( CONST Name : StringsO.IString; OUT Value : iovalue.TPValue ) : BOOLEAN; // looks for string, does not try to convert name to index
   PUBLIC VIRTUAL PROCEDURE ElementAt( Index : CARDINAL; OUT Value : iovalue.TPValue ) : BOOLEAN;

   PUBLIC VIRTUAL PROCEDURE Children( CONST Name : StringsO.IString; OUT Children : iovalue.TPINameValuePairs ) : BOOLEAN; // shorthand for Get[Name]->Value->Children

   // SELF
   PRIVATE VAR
      _Storage : avltree.CAVLTree;

END NameValuePairs;

(*---------------------------------------------------------------------------*)

TYPE
   TPNamespace = POINTER TO Namespace;

CLASS Namespace IMPLEMENTS ns.IMapper, ns.INamespace; // CDisposable

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // IMapper
   PUBLIC VIRTUAL PROCEDURE NameToHash( CONST Name : StringsO.IString; OUT Hash : ns.THash ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE HashToName( CONST Hash : ns.THash; OUT Name : StringsO.IString ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE HashToValue( CONST Hash : ns.THash; OUT Value : iovalue.TPValue ) : BOOLEAN;

   // INamespace/INameValuePairs -- looks inside whole namespace, names are separated with '.'
   PUBLIC VIRTUAL PROCEDURE Get( CONST NameOrIndex : StringsO.IString; OUT Value : iovalue.TPValue ) : BOOLEAN; // tries to convert string to number, if it succeeds index is used
   PUBLIC VIRTUAL PROCEDURE Map( CONST Name : StringsO.IString; OUT Value : iovalue.TPValue ) : BOOLEAN; // looks for string, does not try to convert name to index
   PUBLIC VIRTUAL PROCEDURE ElementAt( Index : CARDINAL; OUT Value : iovalue.TPValue ) : BOOLEAN;

   PUBLIC VIRTUAL PROCEDURE Children( CONST Name : StringsO.IString; OUT Children : iovalue.TPINameValuePairs ) : BOOLEAN; // shorthand for Get[Name]->Value->Children

   // INamespace
   PUBLIC VIRTUAL READONLY PROPERTY
      Root : iovalue.TPValue;
      Name : StringsO.CString; // reads Root.String

   PUBLIC VIRTUAL PROCEDURE Contains( CONST Name : StringsO.IString ) : BOOLEAN;

   // SELF
   PRIVATE VAR
      _Root : iovalue.Value;
      _Pairs : NameValuePairs;

END Namespace;

(*---------------------------------------------------------------------------*)

END nsimpl.