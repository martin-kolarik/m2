DEFINITION MODULE nsimpl;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   avltree,
   IOO,
   iovalue,
   ns,
   nsinternal,
   StringsO,
   Sync;

(*---------------------------------------------------------------------------*)

// STATIC-like
PROCEDURE HashToValue( CONST Hash : ns.THash; OUT Value : iovalue.TPValue ) : BOOLEAN;

(*---------------------------------------------------------------------------*)

TYPE
   TPNamespace = POINTER TO Namespace;

// all Name parameters are/can be hierachical
CLASS Namespace IMPLEMENTS ns.IMapper, ns.INamespace; // CDisposable

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // IMapper
   PUBLIC VIRTUAL PROCEDURE NameToHash( CONST Name : StringsO.IString; OUT Hash : ns.THash ) : BOOLEAN; // Name must not contain namespace's Name
   PUBLIC VIRTUAL PROCEDURE HashToName( CONST Hash : ns.THash; OUT Name : StringsO.IString ) : BOOLEAN; // STATIC-like, name without namespace's Name

   // INamespace/INameValuePairs -- looks inside whole namespace, names are separated with '.'
   PUBLIC VIRTUAL PROCEDURE Map( CONST Name : StringsO.IString; OUT Value : iovalue.TPValue ) : BOOLEAN; // looks for string, Name must not contain namespace's Name

   PUBLIC VIRTUAL READONLY PROPERTY
      Name : POINTER TO CONST StringsO.IString;
      Parent : ns.TPNameValuePairs;

   PUBLIC VIRTUAL PROCEDURE Child( CONST Name : StringsO.IString; OUT Child : ns.TPNameValuePairs ) : BOOLEAN;

   PUBLIC VIRTUAL PROCEDURE DefineValue( CONST Name : StringsO.IString; Type : iovalue.TType; Flags : iovalue.TFlags; Data : PTR; CONST InitialValue : iovalue.TPValue; OUT Children : ns.TPNameValuePairs ) : BOOLEAN;

   // INamespace
   PUBLIC VIRTUAL PROCEDURE Contains( CONST Name : StringsO.IString ) : BOOLEAN;

   // SELF
   PUBLIC PROCEDURE Init( CONST Name : StringsO.IString );
   PUBLIC PROCEDURE DefineLink( CONST Name : StringsO.IString; Flags : iovalue.TFlags; Link, Data : PTR ) : BOOLEAN;

   PRIVATE VAR
      _Pairs : nsinternal.TPNameValuePairs;
   PRIVATE PROCEDURE LookupForDefine( CONST Name : StringsO.IString; OUT Children : ns.TPNameValuePairs ) : BOOLEAN;

END Namespace;

(*---------------------------------------------------------------------------*)

END nsimpl.