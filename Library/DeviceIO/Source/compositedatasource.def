DEFINITION MODULE compositedatasource;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   baseobject,
   device,
   iovalue,
   lists,
   log,
   ns,
   nsimpl,
   StringsO,
   Sync;

(*---------------------------------------------------------------------------*)

TYPE
   TPCompositeDataSource = POINTER TO CCompositeDataSource;

CLASS CCompositeDataSource( baseobject.CDisposable ) IMPLEMENTS ns.IAdviseInfo, ns.IAdviseSource, device.IDataSource;

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // IAdviseInfo
   PUBLIC VIRTUAL PROCEDURE OnAdvise( CONST Originator : ns.TPOriginator; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.TPNameValuePairs; CONST Value : ARRAY OF iovalue.Value );

   // IAdviseSource
   PUBLIC VIRTUAL PROPERTY
      Advise : ns.TAdvise;
      AdviseListener : ns.TPAdviseInfo; // for Advise <> advNone

   // IConfigurable
   PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult; // Log is mandatory

   // IDataSource
   PUBLIC VIRTUAL READONLY PROPERTY
      DataSourceCapabilities : device.TCapabilities;

   PUBLIC VIRTUAL PROCEDURE NS() : ns.TPNamespace; // required, handles both naming and IO
   PUBLIC VIRTUAL PROCEDURE AdviseSource() : ns.TPAdviseSource; // optional

   // SELF
   PUBLIC PROCEDURE Init( CONST Name : StringsO.IString );

   PUBLIC PROCEDURE JoinDataSource( CONST Device : device.TPDataSource );
   PUBLIC PROCEDURE LeaveDataSource( CONST Device : device.TPDataSource );

   // callbacks from Join/LeaveDevice
   INTERNAL VIRTUAL PROCEDURE OnJoinDataSource( CONST Device : device.TPDataSource );
   INTERNAL VIRTUAL PROCEDURE OnLeaveDataSource( CONST Device : device.TPDataSource );

   PRIVATE VAR
      _Namespace : nsimpl.Namespace;
      _DataSources : lists.CPtrList;
      _Advise : ns.TAdvise := ns.advWithData;
      _AdviseListener : ns.TPAdviseInfo := NIL;

END CCompositeDataSource;

(*---------------------------------------------------------------------------*)

END compositedatasource.