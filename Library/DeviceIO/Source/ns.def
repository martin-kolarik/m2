DEFINITION MODULE ns;

IMPORT
   iovalue,
   StringsO;

(*===========================================================================*)

TYPE
   TPNameValuePairs = POINTER TO INameValuePairs;

INTERFACE INameValuePairs;

   // map interface
   PROCEDURE Get( CONST Name : StringsO.IString; OUT Child : TPNameValuePairs ) : BOOLEAN;

   // information and structurals
   READONLY PROPERTY
      Name : StringsO.CString;
      Parent : TPNameValuePairs;
   PROPERTY
      Value : iovalue.Value;

   // creation
   PROCEDURE DefineValue( CONST Name : StringsO.IString; Type : iovalue.TType; Flags : iovalue.TFlags; Data : PTR; CONST InitialValue : iovalue.TPValue; OUT Children : ns.TPNameValuePairs ) : BOOLEAN; // need not necessarily exist
   PROCEDURE Link( CONST Name : StringsO.IString; CONST Child : TPNameValuePairs ) : BOOLEAN; // creates child, although Name can be taken from Child^.Name separating the parameter is more free -- e.g. it allows using of hierarchical names in INamespace implementors

   // TODO iterator in "default" branch

END INameValuePairs;

(*---------------------------------------------------------------------------*)

TYPE
   TPNamespace = POINTER TO INamespace;

INTERFACE INamespace( INameValuePairs );

   PROCEDURE Contains( CONST Name : StringsO.IString ) : BOOLEAN;

   PROCEDURE GetFullName( CONST Value : TPNameValuePairs; OUT FullName : StringsO.IString ) : BOOLEAN;

END INamespace;

(*---------------------------------------------------------------------------*)

TYPE
   THash = PTR; // means TPNameValuePairs;
   
CONST
   hashINVALID = THash( NIL );

(*---------------------------------------------------------------------------*)

// TEMPORARY until its users move to INameValuePairs/INamespace
TYPE
   TPMapper = POINTER TO IMapper;

INTERFACE IMapper;

   PROCEDURE NameToHash( CONST Name : StringsO.IString; OUT Hash : THash ) : BOOLEAN;
   PROCEDURE HashToName( CONST Hash : THash; OUT Name : StringsO.IString ) : BOOLEAN;

END IMapper;

(*===========================================================================*)

END ns.