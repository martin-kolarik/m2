DEFINITION MODULE ns;

IMPORT
   iovalue,
   StringsO;

(*---------------------------------------------------------------------------*)
// Base namespace storage structure is tightly linked to Value, so
// NameValuePairs has to be defined in "iovalue.def".

CONST
   INameValuePairs ::= iovalue.INameValuePairs;
   TPNameValuePairs ::= iovalue.TPNameValuePairs;

(*---------------------------------------------------------------------------*)

TYPE
   TPMapper = POINTER TO IMapper; // simple name mapper
   TPNamespace = POINTER TO INamespace;

   THash = PTR;
   TPHash = POINTER TO THash;
   
CONST
   hashINVALID = NIL;

PROCEDURE nameName() : POINTER TO CONST StringsO.IString; // STATIC
PROCEDURE nameParent() : POINTER TO CONST StringsO.IString; // STATIC

(*---------------------------------------------------------------------------*)

INTERFACE IMapper;
   PROCEDURE NameToHash( CONST Name : StringsO.IString; OUT Hash : THash ) : BOOLEAN;
   PROCEDURE HashToName( CONST Hash : THash; OUT Name : StringsO.IString ) : BOOLEAN;
   PROCEDURE HashToValue( CONST Hash : THash; OUT Value : iovalue.TPValue ) : BOOLEAN;
END IMapper;

(*---------------------------------------------------------------------------*)

INTERFACE IHierarchyMapper( IMapper );
   PROCEDURE HashToParent( CONST Hash : THash; OUT Parent : THash ) : BOOLEAN;
END IHierarchyMapper;

(*---------------------------------------------------------------------------*)

INTERFACE INamespace( INameValuePairs );

   READONLY PROPERTY
      Root : iovalue.TPValue;

   PROCEDURE Contains( CONST Name : StringsO.IString ) : BOOLEAN;

END INamespace;

(*---------------------------------------------------------------------------*)

END ns.