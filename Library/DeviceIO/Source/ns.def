DEFINITION MODULE ns;

IMPORT
   IOO,
   iovalue,
   StringsO;

(*===========================================================================*)

TYPE
   TPOriginator = POINTER TO IOriginator;

INTERFACE IOriginator; // should be refactored? see #141

   READONLY PROPERTY
      Description : StringsO.CString;

END IOriginator;

(*---------------------------------------------------------------------------*)

TYPE
   TPNameValuePairs = POINTER TO INameValuePairs;
   TPValueIO = POINTER TO IValueIO;

INTERFACE IValueIO;

   PROCEDURE ValueIO( CONST Originator : TPOriginator; CONST NameValuePairs : TPNameValuePairs; Direction : IOO.TDirection; REF Value : iovalue.Value ) : Sync.TAsyncResult;
      // allows full access, including result resolution and originator
      // SHALL call Advise if IAdviseSource is assigned

END IValueIO;

(*---------------------------------------------------------------------------*)

TYPE
   TPAdviseInfo = POINTER TO IAdviseInfo;
   TPAdviseSource = POINTER TO IAdviseSource;

   TAdvise = (
      advNone,
      advWithoutData,
      advWithData
   );

INTERFACE IAdviseInfo;

   // notification from device
   PROCEDURE OnAdvise( CONST Originator : TPOriginator; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF TPNameValuePairs; CONST Value : ARRAY OF iovalue.Value );

END IAdviseInfo;

(*---------------------------------------------------------------------------*)

INTERFACE IAdviseSource;

   PROPERTY
      Advise : TAdvise;
      AdviseListener : TPAdviseInfo; // for Advise <> advNone

END IAdviseSource;

(*===========================================================================*)

INTERFACE INameValuePairs( IValueIO );

   // map interface
   PROCEDURE Get( CONST Name : StringsO.IString; OUT Child : TPNameValuePairs ) : BOOLEAN;

   // information and structurals
   READONLY PROPERTY
      Name : StringsO.CString;
      AdviseSource : TPAdviseSource;
   PROPERTY
      Parent : TPNameValuePairs; // items are linkable, so Parent must be writable too. On the other side, normal ns SHALL NOT change parents inside items.
      Value : iovalue.Value; // allows simple value access, no result and originator available, can use IValueIO.IO, SHALL call Advise if IAdviseSource is assigned
      Data : PTR; // user data
   READONLY PROPERTY
      VisibleToUser : BOOLEAN;
      HasValue : BOOLEAN;

   // creation
   PROCEDURE DefineStorageValue( CONST Name : StringsO.IString; Type : iovalue.TType; Flags : iovalue.TFlags; CONST InitialValue : iovalue.TPValue; Data : PTR; AccessLock : Sync.PIRLock; CONST AdviseSource : TPAdviseSource; OUT Children : ns.TPNameValuePairs ) : BOOLEAN;
   PROCEDURE DefineIOValue( CONST Name : StringsO.IString; REF ValueIO : IValueIO; Data : PTR; CONST AdviseSource : TPAdviseSource; OUT Children : ns.TPNameValuePairs ) : BOOLEAN;

   PROCEDURE Link( CONST Name : StringsO.IString; Child : TPNameValuePairs; SetParent : BOOLEAN ) : BOOLEAN;
      // creates child, although Name can be taken from Child^.Name separating the parameter is more free -- e.g. it allows using of hierarchical names in INamespace implementors
      // use SetParent = TRUE for creating a combined ns structure, FALSE for creating a reference elsewhere into the ns. Each element can only have single parent and, also, the parent has to be set.
   PROCEDURE Unlink( CONST Name : StringsO.IString; OUT Child : TPNameValuePairs ) : BOOLEAN;
      // removes child

   // TODO iterator in "default" branch

END INameValuePairs;

(*---------------------------------------------------------------------------*)
(*---------------------------------------------------------------------------*)

TYPE
   TPNamespace = POINTER TO INamespace;

INTERFACE INamespace( INameValuePairs );

   PROCEDURE Contains( CONST Name : StringsO.IString ) : BOOLEAN;

   PROCEDURE GetFullName( CONST Value : TPNameValuePairs; OUT FullName : StringsO.IString ) : BOOLEAN;

END INamespace;

(*---------------------------------------------------------------------------*)

TYPE
   THash = PTR; // means TPNameValuePairs;
   
CONST
   hashINVALID = THash( NIL );

(*---------------------------------------------------------------------------*)

// TEMPORARY until its users move to INameValuePairs/INamespace
TYPE
   TPMapper = POINTER TO IMapper;

INTERFACE IMapper;

   PROCEDURE NameToHash( CONST Name : StringsO.IString; OUT Hash : THash ) : BOOLEAN;
   PROCEDURE HashToName( CONST Hash : THash; OUT Name : StringsO.IString ) : BOOLEAN;

END IMapper;

(*===========================================================================*)

END ns.