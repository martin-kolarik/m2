DEFINITION MODULE nsinternal;
// the module is partially visible to allow its usage in test

(*===========================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   avltree,
   iovalue,
   ns,
   StringsO;

(*===========================================================================*)

CONST
   flagsDefaultName = iovalue.TFlags{iovalue.vfReadOnly};

(*===========================================================================*)

TYPE
   TPNameValuePairs = POINTER TO NameValuePairs;

CLASS NameValuePairs IMPLEMENTS ns.INameValuePairs; // ( baseobject.CDisposable ) // not synchronized

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // INameValuePairs
   PUBLIC VIRTUAL PROCEDURE Get( CONST Name : StringsO.IString; OUT Child : ns.TPNameValuePairs ) : BOOLEAN;

   PUBLIC VIRTUAL READONLY PROPERTY
      Name : StringsO.CString;
      Parent : ns.TPNameValuePairs;
   PUBLIC VIRTUAL PROPERTY
      Value : iovalue.Value;

   PUBLIC VIRTUAL PROCEDURE DefineValue( CONST Name : StringsO.IString; Type : iovalue.TType; Flags : iovalue.TFlags; Data : PTR; CONST InitialValue : iovalue.TPValue; OUT Children : ns.TPNameValuePairs ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Link( CONST Child : ns.TPNameValuePairs ) : BOOLEAN;

   // SELF
   PUBLIC PROCEDURE DefineReference( CONST Name : StringsO.IString; Flags : iovalue.TFlags; Reference, Data : PTR ) : BOOLEAN;

   LOCAL VAR
      _Value : iovalue.Value;
      _Name : StringsO.CString;
      _Parent : ns.TPNameValuePairs := NIL;
      _Children : avltree.CAVLTree;

END NameValuePairs;

(*===========================================================================*)

END nsinternal.