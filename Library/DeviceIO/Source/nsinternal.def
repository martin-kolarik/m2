DEFINITION MODULE nsinternal;
// the module is partially visible to allow its usage in test

(*===========================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   avltree,
   iovalue,
   ns,
   StringsO;

(*===========================================================================*)

CONST
   flagsDefaultName = iovalue.TFlags{iovalue.vfReadOnly};

(*---------------------------------------------------------------------------*)

// STATIC-like
PROCEDURE HashToValue( CONST Hash : ns.THash; OUT Value : iovalue.TPValue ) : BOOLEAN;

(*===========================================================================*)

TYPE
   TPNameValuePairs = POINTER TO NameValuePairs;

CLASS NameValuePairs IMPLEMENTS ns.IMapper, ns.INameValuePairs; // ( baseobject.CDisposable ) // not synchronized

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // IMapper
   PUBLIC VIRTUAL PROCEDURE NameToHash( CONST Name : StringsO.IString; OUT Hash : ns.THash ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE HashToName( CONST Hash : ns.THash; OUT Name : StringsO.IString ) : BOOLEAN; // STATIC-like

   // INameValuePairs
   PUBLIC VIRTUAL PROCEDURE Map( CONST Name : StringsO.IString; OUT Value : iovalue.TPValue ) : BOOLEAN; // looks for string, does not try to convert name to index

   PUBLIC VIRTUAL READONLY PROPERTY
      Name : POINTER TO CONST StringsO.IString;
      Parent : ns.TPNameValuePairs;

   PUBLIC VIRTUAL PROCEDURE Child( CONST Name : StringsO.IString; OUT Child : ns.TPNameValuePairs ) : BOOLEAN; // shorthand for NameToHash[Name]->HashToNameValuePairs->Children

   PUBLIC VIRTUAL PROCEDURE DefineValue( CONST Name : StringsO.IString; Type : iovalue.TType; Flags : iovalue.TFlags; Data : PTR; CONST InitialValue : iovalue.TPValue; OUT Children : ns.TPNameValuePairs ) : BOOLEAN;
      // returns FALSE e.g. if Name already exists and so
      // InitialValue/in is optional

   // SELF
   PUBLIC PROCEDURE DefineLink( CONST Name : StringsO.IString; Flags : iovalue.TFlags; Link, Data : PTR ) : BOOLEAN;

   LOCAL VAR
      _Value : iovalue.Value;
      _Name : StringsO.CString;
      _Parent : ns.TPNameValuePairs := NIL;
      _Children : avltree.CAVLTree;

END NameValuePairs;

(*===========================================================================*)

END nsinternal.