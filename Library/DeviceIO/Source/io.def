DEFINITION MODULE io;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   Sync,
   IOO;
   
IMPORT
   ns,
   iovalue;

(*---------------------------------------------------------------------------*)

TYPE
  TPIO = POINTER TO IIO;
  TPDataInfo = POINTER TO CDataInfo;

(*---------------------------------------------------------------------------*)

CLASS CDataInfo( Delegate.ADelegate );
   // called in case of any error (so for operations which has not started it is called)
   PUBLIC VIRTUAL PROCEDURE OnError( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL );
   // called on completion of io operation (so for operations which has not started it is not called)
   PUBLIC VIRTUAL PROCEDURE OnIO( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL; CONST Value : ARRAY OF iovalue.Value );
   // notification from device
   PUBLIC VIRTUAL PROCEDURE OnAdvise( Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST Value : ARRAY OF iovalue.Value );
END CDataInfo;

(*---------------------------------------------------------------------------*)

TYPE
   TCapability = (
      capArray,
      capAdvise
   );
   TCapabilities = SET OF TCapability;

TYPE
   TAdvise = (
      advNone,
      advWithoutData,
      advWithData
   );

(*---------------------------------------------------------------------------*)

INTERFACE IIO;
   READONLY PROPERTY
      Capabilities : TCapabilities;
      Pending : BOOLEAN;
      Running : BOOLEAN;
   PROPERTY
      Advise : TAdvise;

   PROCEDURE Run() : Sync.TAsyncResult;
   PROCEDURE Stop();

   PROCEDURE IOh( Direction : IOO.TDirection; Item : ns.THash; REF Value : iovalue.Value; Callback : TPDataInfo ) : Sync.TAsyncResult;
   PROCEDURE IOha( Direction : IOO.TDirection; Item : ARRAY OF ns.THash; REF Value : ARRAY OF iovalue.Value; Callback : TPDataInfo ) : Sync.TAsyncResult;
END IIO;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS AItemizedIO IMPLEMENTS IIO; // used for devices with single item operations
   PUBLIC ABSTRACT READONLY PROPERTY
      Pending : BOOLEAN;
   PUBLIC VIRTUAL READONLY PROPERTY
      Capabilities : TCapabilities;

   PUBLIC ABSTRACT PROCEDURE IOh( Direction : IOO.TDirection; Item : ns.THash; REF Value : iovalue.Value; Delegate : TPDataInfo ) : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE IOha( Direction : IOO.TDirection; Item : ARRAY OF ns.THash; REF Value : ARRAY OF iovalue.Value; Callback : TPDataInfo ) : Sync.TAsyncResult;
   
   PUBLIC ABSTRACT PROCEDURE Abort();
END AItemizedIO;

(*---------------------------------------------------------------------------*)

END io.