DEFINITION MODULE io;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   Sync,
   IOO;
   
IMPORT
   ns,
   iovalue;

(*---------------------------------------------------------------------------*)

#save, option( dll_export => on )

TYPE
  TPIStartStopControl = POINTER TO IStartStopControl;
  TPIO = POINTER TO IIO;
  TPIAdviseInfo = POINTER TO IAdviseInfo;
  TPIDataInfo = POINTER TO IDataInfo;
  TPDataInfo = POINTER TO CDataInfo;
  TPCompletionDataInfo = POINTER TO CCompletionDataInfo;

(*---------------------------------------------------------------------------*)

INTERFACE IAdviseInfo;
   // notification from device
   PROCEDURE OnAdvise( Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST Value : ARRAY OF iovalue.Value );
END IAdviseInfo;

(*---------------------------------------------------------------------------*)

INTERFACE IDataInfo( IAdviseInfo );
   // called in case of any error (so for operations which has not started it is called too), for started operation OnError is called together with OnIO
   PROCEDURE OnError( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL );
   // called on completion of io operation (so for operations which has not started it is not called), for started operation OnIO is called together with OnError (if error occured)
   PROCEDURE OnIO( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL; CONST Value : ARRAY OF iovalue.Value );
   // notification from device inherited
   // PROCEDURE OnAdvise( Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST Value : ARRAY OF iovalue.Value );
END IDataInfo;

(*---------------------------------------------------------------------------*)

CLASS CDataInfo( Delegate.ADelegate );
   PUBLIC VAR
      AdviseSink : TPIAdviseInfo;
      DataInfoSink : TPIDataInfo;
   PUBLIC PROCEDURE OnError( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL );
   PUBLIC PROCEDURE OnIO( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL; CONST Value : ARRAY OF iovalue.Value );
   PUBLIC PROCEDURE OnAdvise( Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST Value : ARRAY OF iovalue.Value );
END CDataInfo;

(*---------------------------------------------------------------------------*)

CLASS CCompletionDataInfo( CDataInfo ); // for single IO operation
   PUBLIC PROCEDURE Reset();
   PUBLIC PROCEDURE WaitCompletion( TimeoutMS : CARDINAL; OUT Value : iovalue.Value ) : Sync.TAsyncResult;
END CCompletionDataInfo;

(*---------------------------------------------------------------------------*)

TYPE
   TCapability = (
      capArray,
      capAdvise,
      capCache, // io has self cache, used in complex devices
      capSyncIO // io has synchronous interface, used in complex devices (asynchronous operations are default)
   );
   TCapabilities = SET OF TCapability;

TYPE
   TAdvise = (
      advNone,
      advWithoutData,
      advWithData
   );

(*---------------------------------------------------------------------------*)

INTERFACE IStartStopControl;
   
   READONLY PROPERTY
      Running : BOOLEAN;
   PROCEDURE Start() : Sync.TAsyncResult;
   PROCEDURE Stop();

END IStartStopControl;

(*---------------------------------------------------------------------------*)

INTERFACE IIO( IStartStopControl ); // single device, purpose is to have minimalistic interface, which can be implemented in the device without big effort.
                                    // So IIO can be very simple, it can do no caching, it can accept only single communication, or so. Everything more
                                    // complicated should be left to layers with higer abstraction like ICachedIO.
                                    // It is expected IOha will behave as a single operation -- items will not be callbacked by single.
   READONLY PROPERTY
      IOCapabilities : TCapabilities;
      Pending : BOOLEAN;
      // IRunStopControl.Running : BOOLEAN;
   PROPERTY
      Advise : TAdvise;
      AdviseListener : TPIAdviseInfo; // for Advise <> advNone

   // PROCEDURE IStartStopControl.Start() : Sync.TAsyncResult;
   // PROCEDURE IStartStopControl.Stop();

   PROCEDURE IOh( Direction : IOO.TDirection; Item : ns.THash; REF Value : iovalue.Value; Callback : TPDataInfo ) : Sync.TAsyncResult;
   PROCEDURE IOha( Direction : IOO.TDirection; Item : ARRAY OF ns.THash; REF Value : ARRAY OF iovalue.Value; Callback : TPDataInfo ) : Sync.TAsyncResult;
      // if operation is asynchronous input, then REF Value is not used and everything is returned to Callback

   PROCEDURE AbortAll(); // As IIO is allowed to run single operation only Abort does not need more parameters. But because ancestors
                         // will have need to Abort selectively the name here is AbortAll to avoid future conflicts.
END IIO;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS AItemizedIO IMPLEMENTS IIO; // used for devices with single item operations
   PUBLIC VIRTUAL READONLY PROPERTY
      Capabilities : TCapabilities;
   PUBLIC VIRTUAL PROCEDURE IOha( Direction : IOO.TDirection; Item : ARRAY OF ns.THash; REF Value : ARRAY OF iovalue.Value; Callback : TPDataInfo ) : Sync.TAsyncResult;
END AItemizedIO;

(*---------------------------------------------------------------------------*)

#restore

END io.