DEFINITION MODULE io;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   baseobject,
   delegate,
   StringsO,
   Sync,
   IOO;
   
IMPORT
   ns,
   iovalue;

(*---------------------------------------------------------------------------*)

#save, option( dll_export => on )

TYPE
  TPIDataInfo = POINTER TO IDataInfo;
  TPDataInfo = POINTER TO CDataInfo;
  TPCompletionDataInfo = POINTER TO CCompletionDataInfo;
  TPStartStopControl = POINTER TO IStartStopControl;
  TPIO = POINTER TO IIO;
  TPStartStopHandler = POINTER TO IStartStopHandler;

(*===========================================================================*)

INTERFACE IDataInfo( ns.IAdviseInfo );

   // called in case of any error (so for operations which has not started it is called too), for started operation OnError is called together with OnIOCompleted
   PROCEDURE OnError( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL );

   // called on completion of io operation (so for operations which has not started it is not called), for started operation OnIOCompleted is called together with OnError (if error occured)
   PROCEDURE OnIOCompleted( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL; CONST Value : ARRAY OF iovalue.Value );

END IDataInfo;

(*---------------------------------------------------------------------------*)

CLASS CDataInfo( delegate.Delegate ) IMPLEMENTS IDataInfo;

   // IDataInfo
   PUBLIC VIRTUAL PROCEDURE OnError( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL );
   PUBLIC VIRTUAL PROCEDURE OnIOCompleted( Direction : IOO.TDirection; Source : TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST DeviceSpecificError : ARRAY OF CARDINAL; CONST Value : ARRAY OF iovalue.Value );
   PUBLIC VIRTUAL PROCEDURE OnAdvise( CONST Originator : ns.TPOriginator; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.TPNameValuePairs; CONST Value : ARRAY OF iovalue.Value );

   // SELF
   PUBLIC VAR
      AdviseSink : ns.TPAdviseInfo;
      DataInfoSink : TPIDataInfo;

END CDataInfo;

(*---------------------------------------------------------------------------*)

CLASS CCompletionDataInfo( CDataInfo ); // for single IO operation

   // SELF
   PUBLIC PROCEDURE Reset();
   PUBLIC PROCEDURE WaitCompletion( TimeoutMS : CARDINAL; OUT Value : iovalue.Value ) : Sync.TAsyncResult;

END CCompletionDataInfo;

(*===========================================================================*)

TYPE
   TCapability = (
      capArray,
      capCache, // io has self cache, used in complex devices
      capSyncIO // io has synchronous interface, used in mainly complex devices (asynchronous operations are default)
   );
   TCapabilities = SET OF TCapability;

(*---------------------------------------------------------------------------*)

INTERFACE IStartStopControl;
   
   READONLY PROPERTY
      Running : BOOLEAN;
   PROCEDURE Start() : Sync.TAsyncResult;
   PROCEDURE Stop();

END IStartStopControl;

(*---------------------------------------------------------------------------*)

INTERFACE IIO( IStartStopControl ); // single device, purpose is to have minimalistic interface, which can be implemented in the device without big effort.
                                    // So IIO can be very simple, it can do no caching, it can accept only single communication, or so. Everything more
                                    // complicated should be left to layers with higer abstraction like ICachedIO.
                                    // It is expected IOha will behave as a single operation -- items will not be callbacked by single.
   READONLY PROPERTY
      IOCapabilities : TCapabilities;
      Pending : BOOLEAN;
      // IRunStopControl.Running : BOOLEAN;

   // IOh, IOha MUST BE asynchronous in the terms, that callback is always called (if operation starts). Anyhow,
   // requirement to be asynchronous means, that there must not be any delays or suspensing inside the methods.
   PROCEDURE IOh( CONST Originator : ns.TPOriginator; Direction : IOO.TDirection; Item : ns.THash; REF Value : iovalue.Value; Callback : TPDataInfo ) : Sync.TAsyncResult;
   PROCEDURE IOha( CONST Originator : ns.TPOriginator; Direction : IOO.TDirection; Item : ARRAY OF ns.THash; REF Value : ARRAY OF iovalue.Value; Callback : TPDataInfo ) : Sync.TAsyncResult;
      // if operation is asynchronous input, then REF Value is not used and everything is returned to Callback

   PROCEDURE AbortAll(); // As IIO is allowed to run single operation only Abort does not need more parameters. But because ancestors
                         // will have need to Abort selectively the name here is AbortAll to avoid future conflicts.
END IIO;

(*---------------------------------------------------------------------------*)

CLASS CSimpleOriginator( baseobject.BASE ) IMPLEMENTS ns.IOriginator;

   // IOriginator
   PUBLIC VIRTUAL READONLY PROPERTY
      Description : StringsO.CString;

   // SELF
   PUBLIC PROCEDURE SetDescription( CONST Description : StringsO.CString );
   
   PRIVATE VAR
      _Description : StringsO.CString;

END CSimpleOriginator;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS AItemizedIO IMPLEMENTS IIO; // used for devices with single item operations

   // part of IIO
   PUBLIC VIRTUAL READONLY PROPERTY
      Capabilities : TCapabilities;
   PUBLIC VIRTUAL PROCEDURE IOha( CONST Originator : ns.TPOriginator; Direction : IOO.TDirection; Item : ARRAY OF ns.THash; REF Value : ARRAY OF iovalue.Value; Callback : TPDataInfo ) : Sync.TAsyncResult;

END AItemizedIO;

(*===========================================================================*)

INTERFACE IStartStopHandler;

   PROCEDURE OnStart() : Sync.TAsyncResult;
   PROCEDURE OnStop();

END IStartStopHandler;

(*---------------------------------------------------------------------------*)

CLASS CSimpleStartStopHandler( baseobject.BASE ) IMPLEMENTS IStartStopControl;

   PUBLIC FINAL READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC FINAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC FINAL PROCEDURE Stop();

   PUBLIC VAR
      StartStopSink : TPStartStopHandler := NIL;

   PRIVATE VAR
      _Running : Sync.SIGNAL;

END CSimpleStartStopHandler;

(*===========================================================================*)

#restore

END io.
