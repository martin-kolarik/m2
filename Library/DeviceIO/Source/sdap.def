DEFINITION MODULE sdap;

(*================================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   adviser,
   inetaddr,
   iovalue,
   log,
   maps,
   msghandler,
   netconndispatch,
   StringsO,
   Sync;

(*================================================================================*)

TYPE
   // if any sdap result is followed by number then next number of lines contains information bound with response
   TsdapACK = (
      // successes
      sdap200 = 200, // OK
      sdap201 = 201, // OK, but cached without connection
      sdap202 = 202, // OK, advise
      
      // temporary states
      sdap300 = 300, // operation is pending

      // client problems
      sdap400 = 400, // empty command
      sdap401 = 401, // unknown command
      sdap402 = 402, // unknown/unsupported subcommand
      sdap403 = 403, // bad parameter count
      sdap404 = 404, // bad parameter value
      sdap405 = 405, // resource not found
      sdap406 = 406, // resource error
      sdap407 = 407, // resource readonly

      // server problems
      sdap500 = 500, // internal server error
      sdap501 = 501, // service not available (common error)
      sdap502 = 502  // unsupported command
   );

(*--------------------------------------------------------------------------------*)

TYPE
   TPSDAPServer = POINTER TO CSDAPServer;

CLASS CSDAPServer( netconndispatch.CDispatcher ) IMPLEMENTS io.IStartStopControl;

   // IRunStopControl
   PUBLIC VIRTUAL READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();

   // SELF
   PRIVATE VAR
      _Device : adviser.TPAdvisedDevice := NIL;
      _CommonLogger : log.TPILogger := NIL;
      _NetworkLogger : log.TPILogger := NIL;
      _ConfigurationLogger : log.TPBufferedLogger := NIL;
      _ListenAddress : inetaddr.INETADDR;
      _Running : BOOLEAN := FALSE;
      _Clients : maps.CPtrMap;
      _SendLock : Sync.LOCK;
      _SendQueue : lists.CStringList;

   // inherited
   INTERNAL VIRTUAL PROCEDURE OnMessage( CONST Message : msghandler.IMessage; OUT Result : PTR ) : BOOLEAN;

   PUBLIC PROPERTY
      Device : adviser.TPAdvisedDevice;
      CommonLogger : log.TPILogger;
      NetworkLogger : log.TPILogger;
      ConfigurationLogger : log.TPBufferedLogger;
      ListenAddress : inetaddr.INETADDR;

   INTERNAL VIRTUAL PROCEDURE OnConnect( Connection : netconndispatch.TConnectionHandle; Local : BOOLEAN; Error : CARDINAL );
   INTERNAL VIRTUAL PROCEDURE OnDisconnect( Connection : netconndispatch.TConnectionHandle; Local : BOOLEAN; Error : CARDINAL );
   INTERNAL VIRTUAL PROCEDURE OnReceive( Connection : netconndispatch.TConnectionHandle; PData : ADDRESS; DataLen : CARDINAL );

   PRIVATE PROCEDURE DoRun( Connection : netconndispatch.TConnectionHandle );
   PRIVATE PROCEDURE ACK( Connection : netconndispatch.TConnectionHandle; ack : TsdapACK );
   PRIVATE PROCEDURE ACKS( Connection : netconndispatch.TConnectionHandle; ack : TsdapACK; CONST S : StringsO.CString );
   PRIVATE PROCEDURE ACKs( Connection : netconndispatch.TConnectionHandle; ack : TsdapACK; subCode : CARDINAL );
   PRIVATE PROCEDURE ACKd( Connection : netconndispatch.TConnectionHandle; ack : TsdapACK; CONST address : StringsO.CString; CONST value : iovalue.Value );

   LOCAL PROCEDURE SendAdvise( Client : ADDRESS; CONST string : StringsO.IString );
   
   INITIALLY CSDAPServer();
   FINALLY CSDAPServer();
END CSDAPServer;

(*================================================================================*)

END sdap.