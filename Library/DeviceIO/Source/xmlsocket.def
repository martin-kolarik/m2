DEFINITION MODULE xmlsocket;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   adviser,
   inetaddr,
   log,
   maps,
   netconndispatch;

(*================================================================================*)

TYPE
   TPXMLSocketServer = POINTER TO CXMLSocketServer;

CLASS CXMLSocketServer( netconndispatch.CDispatcher );
   PRIVATE VAR
      _Device : adviser.TPAdvisedDevice := NIL;
      _Logger : log.TPLogger := NIL;
      _ListenAddress : inetaddr.INETADDR;
      _Running : BOOLEAN := FALSE;
      _Clients : maps.CPtrMap;
      
   // SELF
   PUBLIC PROPERTY
      Device : adviser.TPAdvisedDevice;
      Logger : log.TPLogger;
      ListenAddress : inetaddr.INETADDR;
   PUBLIC READONLY PROPERTY
      Running : BOOLEAN;

   PUBLIC PROCEDURE Start();
   PUBLIC PROCEDURE Stop();

   INTERNAL VIRTUAL PROCEDURE OnConnect( Connection : netconndispatch.TConnectionHandle; Local : BOOLEAN; Error : CARDINAL );
   INTERNAL VIRTUAL PROCEDURE OnDisconnect( Connection : netconndispatch.TConnectionHandle; Local : BOOLEAN; Error : CARDINAL );
   INTERNAL VIRTUAL PROCEDURE OnReceive( Connection : netconndispatch.TConnectionHandle; PData : ADDRESS; DataLen : CARDINAL );

   PRIVATE PROCEDURE Parse( Data : ARRAY OF CHAR );
   PRIVATE PROCEDURE HandleItem( CONST Name, Value : ARRAY OF WCHAR );
   LOCAL PROCEDURE Send( Client : ADDRESS; CONST Buffer : StorageO.AMemoryBuffer );
END CXMLSocketServer;

(*================================================================================*)

END xmlsocket.