DEFINITION MODULE xmlsocket;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   arrays,
   adviser,
   inetaddr,
   log,
   maps,
   msghandler,
   netconndispatch;

(*================================================================================*)

TYPE
   TPXMLSocketServer = POINTER TO CXMLSocketServer;

CLASS CXMLSocketServer( netconndispatch.CDispatcher ) IMPLEMENTS io.IStartStopControl;
   
   // IRunStopControl
   PUBLIC VIRTUAL READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();

   // SELF
   PRIVATE VAR
      _Device : adviser.TPAdvisedDevice := NIL;
      _CommonLogger : log.TPILogger := NIL;
      _NetworkLogger : log.TPILogger := NIL;
      _ListenAddress : inetaddr.INETADDR;
      _Running : BOOLEAN := FALSE;
      _Clients : maps.CPtrPtrMap;
      _SendQueue : msgqueue.CPtrQueue;
      
   // inherited
   INTERNAL VIRTUAL PROCEDURE OnMessage( CONST Message : msghandler.IMessage; OUT Result : PTR ) : BOOLEAN;
      
   PUBLIC PROPERTY
      Device : adviser.TPAdvisedDevice;
      CommonLogger : log.TPILogger;
      NetworkLogger : log.TPILogger;
      ListenAddress : inetaddr.INETADDR;

   INTERNAL VIRTUAL PROCEDURE OnConnect( Connection : netconndispatch.TConnectionHandle; Local : BOOLEAN; Error : CARDINAL );
   INTERNAL VIRTUAL PROCEDURE OnDisconnect( Connection : netconndispatch.TConnectionHandle; Local : BOOLEAN; Error : CARDINAL );
   INTERNAL VIRTUAL PROCEDURE OnReceive( Connection : netconndispatch.TConnectionHandle; PData : ADDRESS; DataLen : CARDINAL );

   PRIVATE PROCEDURE Parse( Connection : netconndispatch.TConnectionHandle; Client : ADDRESS; Data : ARRAY OF CHAR );
   PRIVATE PROCEDURE HandleConnect();
   PRIVATE PROCEDURE HandleDisconnect();
   PRIVATE PROCEDURE HandleRead( CONST Name : ARRAY OF WCHAR; REF readRequests : arrays.TPPtrArray );
   PRIVATE PROCEDURE HandleWrite( CONST ia : inetaddr.INETADDR; CONST Name, Value : ARRAY OF WCHAR );
   PRIVATE PROCEDURE ScheduleSend( Client : ADDRESS; Items : arrays.TPPtrArray );

   PRIVATE PROCEDURE RealizeSend( Items : arrays.TPPtrArray );
   LOCAL PROCEDURE Send( Client : ADDRESS; CONST Buffer : StorageO.AMemoryBuffer );

   INITIALLY CXMLSocketServer();
   FINALLY CXMLSocketServer();
END CXMLSocketServer;

(*================================================================================*)

END xmlsocket.