DEFINITION MODULE nsitem;

IMPORT
   IOO,
   nslookup,
   ns,
   iovalue;

(*---------------------------------------------------------------------------*)

TYPE
   TPnsWrapper = POINTER TO CnsWrapper;
   
CLASS CnsWrapper( ns.AnsItem );
   PRIVATE VAR
      _NS : ns.TPns;

   PUBLIC VIRTUAL READONLY PROPERTY
      Name : StringsO.TPString;
      NameType : ns.TNameType;
      ValueType : iovalue.TValueType;
      Value : iovalue.TPValue;
   PUBLIC VIRTUAL PROPERTY
      Data : PTR;
   PUBLIC VIRTUAL READONLY PROPERTY
      Count : CARDINAL;
   PUBLIC PROPERTY
      Namespace : ns.TPns;

   PUBLIC VIRTUAL READONLY INDEX( Index : CARDINAL ) : ns.TPnsItem;

   PUBLIC VIRTUAL PROCEDURE ContainsOA( CONST SingleName : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE GetOA( CONST SingleName : ARRAY OF WCHAR; OUT Item : ns.TPnsItem ) : BOOLEAN;

   PUBLIC VIRTUAL PROCEDURE AddChild( Child : ns.TPnsItem );
END CnsWrapper;

(*---------------------------------------------------------------------------*)

TYPE
  TPnsItem = POINTER TO CnsItem;

CLASS CnsItem( nslookup.AnsAVLItem ); // generic, everybody can/should create self, better nsItem
   PRIVATE VAR
      _Name : StringsO.CString;
      _NameType : ns.TNameType;
      _Value : iovalue.Value;
      _Data : PTR;
   PUBLIC VIRTUAL READONLY PROPERTY
      Name : StringsO.TPString;
      NameType : ns.TNameType;
      ValueType : iovalue.TValueType;
      Value : iovalue.TPValue;
   PUBLIC VIRTUAL PROPERTY
      Data : PTR;
   PUBLIC PROCEDURE Init( CONST SingleChildName : ARRAY OF WCHAR; ConstName : BOOLEAN; NameType : ns.TNameType; ValueType : iovalue.TValueType; Data : PTR );
END CnsItem;

(*---------------------------------------------------------------------------*)

TYPE
  TPns = POINTER TO Ans;

ABSTRACT CLASS Ans( ns.Ans );
   PRIVATE VAR
      _Root : ns.TPnsItem;
   PUBLIC VIRTUAL READONLY PROPERTY
      Root : ns.TPnsItem;
   PUBLIC VAR
      ConstNames : BOOLEAN := FALSE; // names passed to NS are constant and can be stored as references

   // must be called as the first
   PUBLIC PROCEDURE Initialize();

   // root creator
   INTERNAL ABSTRACT PROCEDURE CreateRoot() : ns.TPnsItem;
   // structure creator, could be left empty
   INTERNAL VIRTUAL PROCEDURE CreateStructure(); // excluding root, need not to be overriden

   // helpers
   PUBLIC PROCEDURE FromXML( Stream : IOO.TPStream );
END Ans;

(*---------------------------------------------------------------------------*)

END nsitem.