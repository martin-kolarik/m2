DEFINITION MODULE nslookup;

IMPORT
	arrays,
	avltree,
	sdns,
	StringsO;

(*---------------------------------------------------------------------------*)

TYPE
  TPnsAVLItem = POINTER TO AnsAVLItem;

ABSTRACT CLASS AnsAVLItem( sdns.ASDNSItem );
	PRIVATE VAR
		_Childs : avltree.CAVLTree;

	PUBLIC ABSTRACT READONLY PROPERTY
		Name : StringsO.TPString;
		NameType : sdns.TSDNameType;
		ValueType : sdvalue.TSDValueType;
		Data : PTR;

	PUBLIC VIRTUAL READONLY PROPERTY
		Count : CARDINAL;
	PUBLIC VIRTUAL READONLY INDEX( Index : CARDINAL ) : sdns.TPSDNSItem;

	PUBLIC VIRTUAL PROCEDURE ContainsOA( CONST SingleName : ARRAY OF WCHAR ) : BOOLEAN;
	PUBLIC VIRTUAL PROCEDURE GetOA( CONST SingleName : ARRAY OF WCHAR; OUT Item : sdns.TPSDNSItem ) : BOOLEAN;

	PUBLIC VIRTUAL PROCEDURE AddChild( Child : sdns.TPSDNSItem );
END AnsAVLItem;

(*---------------------------------------------------------------------------*)

TYPE
  TPnsArrayItem = POINTER TO AnsArrayItem;

ABSTRACT CLASS AnsArrayItem( sdns.ASDNSItem );
	PRIVATE VAR
		_Childs : arrays.CPtrArray;

	PUBLIC ABSTRACT READONLY PROPERTY
		Name : StringsO.TPString;
		NameType : sdns.TSDNameType;
		ValueType : sdvalue.TSDValueType;
		Data : PTR;

	VIRTUAL READONLY PROPERTY
		Items : CARDINAL;
	PUBLIC VIRTUAL READONLY INDEX( Index : CARDINAL ) : sdns.TPSDNSItem;

	PUBLIC VIRTUAL PROCEDURE ContainsOA( CONST SingleName : ARRAY OF WCHAR ) : BOOLEAN;
	PUBLIC VIRTUAL PROCEDURE GetOA( CONST SingleName : ARRAY OF WCHAR; OUT Item : sdns.TPSDNSItem ) : BOOLEAN;

	PUBLIC VIRTUAL PROCEDURE AddChild( Child : sdns.TPSDNSItem );
END AnsArrayItem;

(*---------------------------------------------------------------------------*)

END nslookup.