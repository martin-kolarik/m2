DEFINITION MODULE nslookup;

IMPORT
   arrays,
   avltree,
   ns,
   StringsO;

(*---------------------------------------------------------------------------*)

TYPE
  TPnsAVLItem = POINTER TO AnsAVLItem;

ABSTRACT CLASS AnsAVLItem( ns.AnsItem );
   PRIVATE VAR
      _Childs : avltree.CAVLTree;

   PUBLIC VIRTUAL READONLY PROPERTY
      Count : CARDINAL;
   PUBLIC VIRTUAL READONLY INDEX( Index : CARDINAL ) : ns.TPnsItem;

   PUBLIC VIRTUAL PROCEDURE ContainsOA( CONST SingleName : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE GetOA( CONST SingleName : ARRAY OF WCHAR; OUT Item : ns.TPnsItem ) : BOOLEAN;

   PUBLIC VIRTUAL PROCEDURE AddChild( Child : ns.TPnsItem );
END AnsAVLItem;

(*---------------------------------------------------------------------------*)

TYPE
  TPnsArrayItem = POINTER TO AnsArrayItem;

ABSTRACT CLASS AnsArrayItem( ns.AnsItem );
   PRIVATE VAR
      _Childs : arrays.CPtrArray;

   VIRTUAL READONLY PROPERTY
      Items : CARDINAL;
   PUBLIC VIRTUAL READONLY INDEX( Index : CARDINAL ) : ns.TPnsItem;

   PUBLIC VIRTUAL PROCEDURE ContainsOA( CONST SingleName : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE GetOA( CONST SingleName : ARRAY OF WCHAR; OUT Item : ns.TPnsItem ) : BOOLEAN;

   PUBLIC VIRTUAL PROCEDURE AddChild( Child : ns.TPnsItem );
END AnsArrayItem;

(*---------------------------------------------------------------------------*)

END nslookup.