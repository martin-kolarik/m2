DEFINITION MODULE device;

IMPORT
   INIFile,
   iobject,
	io,
	IOO,
	log,
	ns,
	StringsO,
	TextReader;

(*---------------------------------------------------------------------------*)

TYPE
   TConfigureItemType = (
      citZeroTerminatedString,
      citIString,
      citStream,
      citTextReader,
      citINIFile,
      citINIFileSection
   );
   
   TConfigureItem =  RECORD
                        CASE Type : TConfigureItemType OF
                        | citZeroTerminatedString :
                           zString : PWCHAR;
                        | citIString :
                           iString : StringsO.TPString;
                        | citStream :
                           stream : IOO.TPStream;
                        | citTextReader :
                           textReader : TextReader.TPTextReader;
                        | citINIFile :
                           iniFile : INIFile.TPINIFile;
                        | citINIFileSection :
                           _iniFile : INIFile.TPINIFile;
                           section : StringsO.TPString;
                        END; // CASE
                     END; // RECORD
                     
TYPE
   TPIConfigurable = POINTER TO IConfigurable;                     
                     
INTERFACE IConfigurable;
	PROCEDURE Configure( CONST Source : ARRAY OF TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult; // Log is mandatory
END IConfigurable;

(*---------------------------------------------------------------------------*)

TYPE
   TCapability = (
      capMultipleConfiguration,
      capNamespace
   );
   TCapabilities = SET OF TCapability;

TYPE
   TPDevice = POINTER TO IDevice;

INTERFACE IDevice( iobject.IObject ); // aka device driver
   PUBLIC READONLY PROPERTY
      DeviceCapabilities : TCapabilities;

	PROCEDURE Configure( CONST Source : ARRAY OF TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult;

   PROCEDURE Mapper() : ns.TPMapper; // required
	PROCEDURE NS() : ns.TPns; // optional

	PROCEDURE IO() : io.TPIO; // required
END IDevice;

(*---------------------------------------------------------------------------*)

TYPE
#save, call( convention => cdecl )
	TGetDevice = PROCEDURE( OUT ADDRESS ) : BOOLEAN;
#restore

(*---------------------------------------------------------------------------*)

END device.