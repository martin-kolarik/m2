DEFINITION MODULE device;

IMPORT
   INIFile,
   io,
   IOO,
   iplugin,
   log,
   ns,
   StringsO,
   TextReader;

(*---------------------------------------------------------------------------*)

TYPE
   TConfigureItemType = (
      citZeroTerminatedString,
      citIString,
      citStream,
      citTextReader,
      citINIFile,
      citINIFileSection
   );
   
   TConfigureItem =  RECORD
                        CASE Type : TConfigureItemType OF
                        | citZeroTerminatedString :
                           zString : PWCHAR;
                        | citIString :
                           iString : StringsO.TPString;
                        | citStream :
                           stream : IOO.TPStream;
                        | citTextReader :
                           textReader : TextReader.TPTextReader;
                        | citINIFile :
                           iniFile : INIFile.TPINIFile;
                        | citINIFileSection :
                           _iniFile : INIFile.TPINIFile;
                           section : StringsO.TPString;
                        END; // CASE
                     END; // RECORD
                     
TYPE
   TPIConfigurable = POINTER TO IConfigurable;                     
                     
INTERFACE IConfigurable;

   PROCEDURE Configure( CONST Source : ARRAY OF TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult; // Log is mandatory

END IConfigurable;

(*---------------------------------------------------------------------------*)

TYPE
   TCapability = (
      capMultipleConfiguration,
      capAdviseSource,
      capStartStop, // valid for IDevice, if the device is not capable the device is always RUNNING
      capIO // valid for IDevice
   );
   TCapabilities = SET OF TCapability;

TYPE
   TPDataSource = POINTER TO IDataSource;

INTERFACE IDataSource( IConfigurable );

   PUBLIC READONLY PROPERTY
      DataSourceCapabilities : TCapabilities;

   PROCEDURE NS() : ns.TPNamespace; // required, handles both naming and IO
   PROCEDURE AdviseSource() : ns.TPAdviseSource; // optional

END IDataSource;

(*---------------------------------------------------------------------------*)

TYPE
   TPDevice = POINTER TO IDevice;

INTERFACE IDevice( IDataSource );

   PROCEDURE StartStop() : io.TPStartStopControl; // optional, NS items itself can be able to use IO
   PROCEDURE IO() : io.TPIO; // optional, NS items itself can be able to use IO

END IDevice;

(*---------------------------------------------------------------------------*)

END device.
