DEFINITION MODULE device;

IMPORT
	io,
	ns;

(*---------------------------------------------------------------------------*)

INTERFACE IDevice; // aka device driver
	PROCEDURE NS() : ns.TPns;
	PROCEDURE IO() : io.TPIO;
END IDevice;

(*---------------------------------------------------------------------------*)

TYPE
#save, call( convention => cdecl )
	TGetDevice = PROCEDURE( OUT ADDRESS ) : BOOLEAN;
#restore

(*---------------------------------------------------------------------------*)

END device.