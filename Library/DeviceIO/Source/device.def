DEFINITION MODULE device;

IMPORT
   objlib,
	io,
	log,
	ns;

(*---------------------------------------------------------------------------*)

TYPE
   TPDevice = POINTER TO IDevice;

INTERFACE IDevice( objlib.IObject ); // aka device driver
	PROCEDURE NS() : ns.TPns;
	PROCEDURE IO() : io.TPIO;
	PROCEDURE Configure( CONST Source : ARRAY OF PTR; CONST Log : log.TPLogger ) : Sync.TAsyncResult;
END IDevice;

(*---------------------------------------------------------------------------*)

TYPE
#save, call( convention => cdecl )
	TGetDevice = PROCEDURE( OUT ADDRESS ) : BOOLEAN;
#restore

(*---------------------------------------------------------------------------*)

END device.