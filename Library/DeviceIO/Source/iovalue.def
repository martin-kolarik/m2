DEFINITION MODULE iovalue;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   datetime,
   StringsO;

(*---------------------------------------------------------------------------*)

#save, option( dll_export => on )

TYPE
   TPNameValuePairs = POINTER TO INameValuePairs;
   TPValue = POINTER TO Value;

INTERFACE INameValuePairs;

   // map interface
   PROCEDURE Get( CONST NameOrIndex : StringsO.IString; OUT Value : TPValue ) : BOOLEAN; // tries to convert string to number, if it succeeds index is used
   PROCEDURE Map( CONST Name : StringsO.IString; OUT Value : TPValue ) : BOOLEAN; // looks for string, does not try to convert name to index
   PROCEDURE ElementAt( Index : CARDINAL; OUT Value : TPValue ) : BOOLEAN;

   // information and structurals
   READONLY PROPERTY
      Name : POINTER TO CONST StringsO.IString;
      Parent : TPNameValuePairs;

   // helpers, shortcut
   PROCEDURE Children( CONST Name : StringsO.IString; OUT Children : TPNameValuePairs ) : BOOLEAN; // shorthand for Get[Name]->Value->Children

   // TODO iterator in "default" branch

END INameValuePairs;


(*---------------------------------------------------------------------------*)

TYPE
   TType = (
      vtUnknown,
      vtTag, // link to internal world, not visible for user
      vtObject, // has prototype
      vtBoolean,
      vtTristate,
      vtInteger,
      vtLong,
      vtFloat,
      vtString,
      vtDate,
      vtData // TODO
   );
   
TYPE
   TFlagItem = (
      vfReadOnly,
      vfUndefined,
      vfFunction, // children carries call parameters
      vfSaturate,
      vfUser // can be cleared, values without the flag can be removed from the pairs
   );
   TFlags = SET OF TFlagItem;

CONST
   flagsDefaultObject = TFlags{};
   flagsDefaultRO = TFlags{vfReadOnly, vfUndefined, vfSaturate};
   flagsDefaultRW = TFlags{vfUndefined, vfSaturate};
   
(*---------------------------------------------------------------------------*)

TYPE
   #save, option( pack => 1 )
   TStorage  = RECORD
                  CASE : TType OF
                  | vtUnknown  :
                  | vtObject   : // children contains members, the value is pure object
                  | vtTag      : Tag      : PTR;
                  | vtBoolean  : Boolean  : BOOLEAN;
                  | vtTristate : Tristate : TRISTATE;
                  | vtInteger  : Integer  : INT32;
                  | vtLong     : Long     : INT64;
                  | vtFloat    : Float    : LONGREAL;
                  | vtString   : String   : POINTER TO StringsO.CString;
                  | vtDate     : Date     : datetime.TJD;
                  END;
                END; // RECORD
   #restore
   
(*---------------------------------------------------------------------------*)

CLASS Value;

   PUBLIC PROPERTY
      Type : TType;
      Undefined : BOOLEAN;
      Saturate : BOOLEAN;
   PUBLIC PROPERTY
      // Object : ADDRESS; // will be object
      Boolean : BOOLEAN;
      Tristate : TRISTATE;
      Integer : INT32;
      Long : INT64;
      Float : LONGREAL;
      String : StringsO.CString;
      Date : datetime.TJD; // JD * 86400 * 10000 = count of 100 ns
      Tag : PTR;
      // TODO
      // Data : StorageO.CMemoryBuffer;
   PUBLIC READONLY PROPERTY
      Children : TPNameValuePairs;
      PString : StringsO.TPString; // returns internal string for Type = dstString, otherwise it returns NIL

   PUBLIC OPERATOR :=( CONST Source : Value ); // respects type

   PUBLIC OPERATOR = ( CONST Source : Value ) : BOOLEAN; // hard, binary comparing
   PUBLIC OPERATOR <>( CONST Source : Value ) : BOOLEAN; // hard, binary comparing
   PUBLIC OPERATOR > ( CONST Source : Value ) : BOOLEAN;
   PUBLIC OPERATOR >=( CONST Source : Value ) : BOOLEAN;
   PUBLIC OPERATOR < ( CONST Source : Value ) : BOOLEAN;
   PUBLIC OPERATOR <=( CONST Source : Value ) : BOOLEAN;
   PUBLIC OPERATOR + ( CONST Source : Value ) : Value;
   PUBLIC OPERATOR - ( CONST Source : Value ) : Value;
   PUBLIC OPERATOR * ( CONST Source : Value ) : Value;
   PUBLIC OPERATOR / ( CONST Source : Value ) : Value;

   PUBLIC PROCEDURE Dispose();
   PUBLIC PROCEDURE Clone( OUT New : Value ); // New has the same type
   PUBLIC PROCEDURE Equals( CONST Source : Value ) : BOOLEAN; // soft, casts, respects different types
   PUBLIC PROCEDURE EqualsS( CONST S : StringsO.IString ) : BOOLEAN;
   PUBLIC PROCEDURE EqualsOA( CONST S : ARRAY OF WCHAR ) : BOOLEAN;

   PUBLIC PROCEDURE ToString( OUT String : StringsO.IString; TransportFlag : BOOLEAN ); // if TransportFlag is set then string is used for some communication and will not be visible
   PUBLIC PROCEDURE FromString( CONST String : StringsO.IString; TransportFlag : BOOLEAN ); // if TransportFlag is set then string is used for some communication and will not be visible

   // TODO
   // PUBLIC PROCEDURE ToBuffer( OUT Buffer : StorageO.AMemoryBuffer );
   // PUBLIC PROCEDURE ToOA( OUT Data : ARRAY OF BYTE );
   // PUBLIC PROCEDURE FromBuffer( CONST Buffer : StorageO.AMemoryBuffer );
   // PUBLIC PROCEDURE FromSOA( CONST Data : ARRAY OF BYTE );

   PUBLIC PROCEDURE Limit( Bits : CARDINAL; Signed, Saturate : BOOLEAN ); // e.g. Limit( 8, TRUE, FALSE ) saturates to CARD8, limites IN PLACE only numbers (Integer, Long, Float)

   PUBLIC PROCEDURE LimitedInteger( Bits : CARDINAL; Signed, Saturate : BOOLEAN ) : INT32; // limites all types
   PUBLIC PROCEDURE LimitedLong( Bits : CARDINAL; Signed, Saturate : BOOLEAN ) : INT64; // limites all types
   PUBLIC PROCEDURE LimitedFloat( Bits : CARDINAL; Signed, Saturate : BOOLEAN ) : LONGREAL; // limites all types

   // SELF
   PUBLIC WRITEONLY PROPERTY // meant for group initialization only (in namespaces etc.)
      InitializeFlags : TFlags;
      InitializeChildren : TPNameValuePairs;

   INTERNAL VAR
      _Flags : TFlags;
      _Type : TType;
      _Storage : TStorage;
      _Children : TPNameValuePairs;

END Value;

(*---------------------------------------------------------------------------*)

#restore

END iovalue.