DEFINITION MODULE adviser;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   device,
   io,
   iobject,
   IOO,
   iovalue,
   log,
   maps,
   ns,
   StringsO,
   Sync;

(*---------------------------------------------------------------------------*)

TYPE
   TPAdviser = POINTER TO CAdviser;
   TPAdvisedDevice = POINTER TO CAdvisedDevice; // wrapper around device with CAdviser functionality
   
(*---------------------------------------------------------------------------*)

CLASS CAdviser IMPLEMENTS io.IAdviseInfo, io.IStartStopControl, io.IStartStopHandler;

   // IDisposable
   PUBLIC PROCEDURE Dispose();
   
   // IAdviseInfo
   PUBLIC FINAL PROCEDURE OnAdvise( Source : io.TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST Value : ARRAY OF iovalue.Value );

   // IStartStopControl
   PUBLIC VIRTUAL READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();

   // IStartStopHandler
   PUBLIC VIRTUAL PROCEDURE OnStart() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE OnStop();

   // SELF
   PUBLIC PROPERTY
      Device : device.TPDevice; // this device will be advised
   PUBLIC READONLY PROPERTY
      Empty : BOOLEAN;
      
   PUBLIC PROCEDURE JoinClient( Client : io.TPAdviseInfo; Advise : io.TAdvise );
   PUBLIC PROCEDURE LeaveClient( Client : io.TPAdviseInfo );
   
   PUBLIC PROCEDURE Advise( Client : io.TPAdviseInfo; CONST Name : StringsO.CString ) : BOOLEAN; // returns if Name is known
   PUBLIC PROCEDURE AdviseHash( Client : io.TPAdviseInfo; Hash : ns.THash ) : BOOLEAN; // does not checks for Hash validity, if the Hash is invalid, nothing will be advised
   PUBLIC PROCEDURE AdviseAll( Client : io.TPAdviseInfo );
   PUBLIC PROCEDURE Unadvise( Client : io.TPAdviseInfo; CONST Name : StringsO.CString ) : BOOLEAN; // returns if Name is known
   PUBLIC PROCEDURE UnadviseHash( Client : io.TPAdviseInfo; Hash : ns.THash ) : BOOLEAN; // does not checks for Hash validity
   PUBLIC PROCEDURE UnadviseAll( Client : io.TPAdviseInfo );
   
   // helpers
   PRIVATE PROCEDURE DoAdvise( ClientData : ADDRESS; CONST Name : StringsO.TPString; Hash : ns.THash ) : BOOLEAN;
   PRIVATE PROCEDURE DoUnadvise( ClientData : ADDRESS; CONST Name : StringsO.TPString; Hash : ns.THash; UnadviseCompletely : BOOLEAN ) : BOOLEAN;

   PRIVATE VAR
      _StartStopHandler : io.CSimpleStartStopHandler;
      _Advising : Sync.SIGNAL;
      _OnAdviseLock : Sync.LOCK; // to serialize OnAdvise processing, it uses loops over lists and trees and if device sends advises from more threads it could fail
      _Clients : maps.CPtrMap; // map of client/PtrList of joined clients
      _Advised : maps.CPtrMap; // map of item/PtrArray of clients/client data
   INTERNAL VAR
      _Device : device.TPDevice;

END CAdviser;

(*---------------------------------------------------------------------------*)

CLASS CAdvisedDevice( CAdviser ) IMPLEMENTS device.IDevice; // wrapper around device with CAdviser functionality

   // IDevice
   PUBLIC VIRTUAL READONLY PROPERTY
      DeviceCapabilities : device.TCapabilities;

   PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult;

   PUBLIC VIRTUAL PROCEDURE NS() : ns.TPNamespace;
   PUBLIC VIRTUAL PROCEDURE StartStop() : io.TPStartStopControl;
   PUBLIC VIRTUAL PROCEDURE IO() : io.TPIO;
   PUBLIC VIRTUAL PROCEDURE AdviseSource() : io.TPAdviseSource;

END CAdvisedDevice;

(*---------------------------------------------------------------------------*)

END adviser.