DEFINITION MODULE adviser;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   device,
   io,
   iobject,
   IOO,
   iovalue,
   log,
   maps,
   ns,
   StringsO,
   Sync;

(*---------------------------------------------------------------------------*)

TYPE
   TPAdviser = POINTER TO CAdviser;
   TPAdvisedDataSource = POINTER TO CAdvisedDataSource; // wrapper around data source with CAdviser functionality
   
(*---------------------------------------------------------------------------*)

CLASS CAdviser IMPLEMENTS ns.IAdviseInfo, io.IStartStopControl, io.IStartStopHandler;

   // IDisposable
   PUBLIC PROCEDURE Dispose();
   
   // IAdviseInfo
   PUBLIC FINAL PROCEDURE OnAdvise( CONST Originator : ns.TPOriginator; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.TPNameValuePairs; CONST Value : ARRAY OF iovalue.Value );

   // IStartStopControl
   PUBLIC VIRTUAL READONLY PROPERTY
      Running : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();

   // IStartStopHandler
   PUBLIC VIRTUAL PROCEDURE OnStart() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE OnStop();

   // SELF
   PUBLIC PROPERTY
      DataSource : device.TPDataSource; // this datasource will be advised
   PUBLIC READONLY PROPERTY
      Empty : BOOLEAN;
      
   PUBLIC PROCEDURE JoinClient( Client : ns.TPAdviseInfo; Advise : ns.TAdvise );
   PUBLIC PROCEDURE LeaveClient( Client : ns.TPAdviseInfo );
   
   PUBLIC PROCEDURE Advise( Client : ns.TPAdviseInfo; CONST Name : StringsO.IString ) : BOOLEAN; // returns if Name is known
   PUBLIC PROCEDURE AdviseHash( Client : ns.TPAdviseInfo; Hash : ns.THash ) : BOOLEAN; // does not checks for Hash validity, if the Hash is invalid, nothing will be advised
   PUBLIC PROCEDURE AdviseAll( Client : ns.TPAdviseInfo );
   PUBLIC PROCEDURE Unadvise( Client : ns.TPAdviseInfo; CONST Name : StringsO.IString ) : BOOLEAN; // returns if Name is known
   PUBLIC PROCEDURE UnadviseHash( Client : ns.TPAdviseInfo; Hash : ns.THash ) : BOOLEAN; // does not checks for Hash validity
   PUBLIC PROCEDURE UnadviseAll( Client : ns.TPAdviseInfo );
   
   // helpers
   PRIVATE PROCEDURE DoAdvise( ClientData : ADDRESS; CONST Name : StringsO.TPString; Hash : ns.THash ) : BOOLEAN;
   PRIVATE PROCEDURE DoUnadvise( ClientData : ADDRESS; CONST Name : StringsO.TPString; Hash : ns.THash; UnadviseCompletely : BOOLEAN ) : BOOLEAN;

   PRIVATE VAR
      _StartStopHandler : io.CSimpleStartStopHandler;
      _Advising : Sync.SIGNAL;
      _OnAdviseLock : Sync.LOCK; // to serialize OnAdvise processing, it uses loops over lists and trees and if device sends advises from more threads it could fail
      _Clients : maps.CPtrMap; // map of client/PtrList of joined clients
      _Advised : maps.CPtrMap; // map of item/PtrArray of clients/client data
   INTERNAL VAR
      _DataSource : device.TPDataSource;

END CAdviser;

(*---------------------------------------------------------------------------*)

CLASS CAdvisedDataSource( CAdviser ) IMPLEMENTS device.IDataSource; // wrapper around data source with CAdviser functionality

   // IDataSource
   PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult;

   PUBLIC VIRTUAL READONLY PROPERTY
      DataSourceCapabilities : device.TCapabilities;

   PUBLIC VIRTUAL PROCEDURE NS() : ns.TPNamespace;
   PUBLIC VIRTUAL PROCEDURE AdviseSource() : ns.TPAdviseSource;

END CAdvisedDataSource;

(*---------------------------------------------------------------------------*)

END adviser.