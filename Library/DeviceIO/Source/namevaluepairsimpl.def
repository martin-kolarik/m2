DEFINITION MODULE namevaluepairsimpl;
// the module is partially visible to allow its usage in test

(*===========================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   avltree,
   IOO,
   iovalue,
   ns,
   StringsO,
   Sync;

(*===========================================================================*)
// predefined implementations, mostly for structurals

ABSTRACT CLASS ANameValuePairsStructurals IMPLEMENTS ns.INameValuePairs; // ( baseobject.CDisposable ) // not synchronized

   // CDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // INameValuePairs
   PUBLIC VIRTUAL PROCEDURE Get( CONST Name : StringsO.IString; OUT Child : ns.TPNameValuePairs ) : BOOLEAN;

   PUBLIC VIRTUAL READONLY PROPERTY
      Name : StringsO.CString;
      Parent : ns.TPNameValuePairs;
   PUBLIC VIRTUAL PROPERTY
      Data : PTR;

   PUBLIC VIRTUAL PROCEDURE Link( CONST Name : StringsO.IString; CONST Child : ns.TPNameValuePairs ) : BOOLEAN; // Name and Child^.Name HAS TO be the same
   PUBLIC VIRTUAL PROCEDURE Unlink( CONST Name : StringsO.IString; OUT Child : ns.TPNameValuePairs ) : BOOLEAN; // removes child

   // SELF
   PUBLIC WRITEONLY PROPERTY
      InitializeName : StringsO.CString;

   LOCAL VAR
      _Name : StringsO.CString;
      _Parent : ns.TPNameValuePairs := NIL;
      _Children : avltree.TPAVLTree := NIL;
      _Data : PTR := 0;

END ANameValuePairsStructurals;

(*---------------------------------------------------------------------------*)
(*---------------------------------------------------------------------------*)

TYPE
   TPNameValuePairsIO = POINTER TO NameValuePairsIO;

(*---------------------------------------------------------------------------*)

CLASS NameValuePairsIO( ANameValuePairsStructurals );

   // IValueIO
   PUBLIC VIRTUAL PROCEDURE ValueIO( CONST Originator : ns.TPOriginator; Direction : IOO.TDirection; CONST NameValuePairs : ns.TPNameValuePairs; REF Value : iovalue.Value ) : Sync.TAsyncResult;

   // INameValuePairs
   PUBLIC VIRTUAL PROPERTY
      Value : iovalue.Value;

   PUBLIC VIRTUAL PROCEDURE DefineValue( CONST Name : StringsO.IString; Type : iovalue.TType; Flags : iovalue.TFlags; Data : PTR; CONST InitialValue : iovalue.TPValue; OUT Children : ns.TPNameValuePairs ) : BOOLEAN;

   // SELF
   PUBLIC PROPERTY
      ValueIODelegate : ns.TPValueIO;

   PRIVATE VAR
      _ValueIODelegate : ns.TPValueIO := NIL;

END NameValuePairsIO;

(*---------------------------------------------------------------------------*)
(*---------------------------------------------------------------------------*)

TYPE
   TPNameValuePairsStorage = POINTER TO NameValuePairsStorage;

CLASS NameValuePairsStorage( ANameValuePairsStructurals );

   // IValueIO
   PUBLIC VIRTUAL PROCEDURE ValueIO( CONST Originator : ns.TPOriginator; Direction : IOO.TDirection; CONST NameValuePairs : ns.TPNameValuePairs; REF Value : iovalue.Value ) : Sync.TAsyncResult;

   // INameValuePairs
   PUBLIC VIRTUAL PROPERTY
      Value : iovalue.Value;

   PUBLIC VIRTUAL PROCEDURE DefineValue( CONST Name : StringsO.IString; Type : iovalue.TType; Flags : iovalue.TFlags; Data : PTR; CONST InitialValue : iovalue.TPValue; OUT Children : ns.TPNameValuePairs ) : BOOLEAN;

   // SELF
   PUBLIC PROCEDURE DefineReference( CONST Name : StringsO.IString; Flags : iovalue.TFlags; Reference, Data : PTR ) : BOOLEAN;

   LOCAL VAR
      _Value : iovalue.Value;

END NameValuePairsStorage;

(*===========================================================================*)

END namevaluepairsimpl.