<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <FileDescription>XML support</FileDescription>
        <FileVersionMajor>1</FileVersionMajor>
        <FileVersionMinor>0</FileVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
			<Components Include="Modula2\modula2;API\CLib;API\win32;API\xml"/>
			<Components Include="Modula2\m2rtl;Modula2\m2ortl;Library\ADT;Library\COM"/>
			<Modules Include="DOM;XMLWriter;XMLSerializer"/>
		</ItemGroup>

		<!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
