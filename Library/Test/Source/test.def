DEFINITION MODULE test;

IMPORT
   lists,
   log,
   objlib;

(*================================================================================*)
// interfaces
   
TYPE
   TTestResult = TRISTATE(
      trSucceeded = 1,
      trFailed = 0,
      trUnknown = -1
   );
   
TYPE
   TPHost = POINTER TO IHost;
   TPTest = POINTER TO ITest;
   TPTests = POINTER TO ITests;
   
INTERFACE IHost;
   READONLY PROPERTY
      Log : log.TPLogger;
   PROPERTY
      Progress : CARDINAL; // percent
   // optional
   PROCEDURE StartPhase( Name : ARRAY OF WCHAR );
   PROCEDURE StopPhase();
END IHost;

INTERFACE ITest;
   PROCEDURE Run( CONST Host : TPHost; CONST Parameters : ARRAY OF PWCHAR ) : TTestResult;
END ITest;

INTERFACE ITests; // CID: Development.Tests
   PROCEDURE EnumerateTests( REF ES : PTR; OUT Name : ARRAY OF WCHAR; OUT Test : TPTest ) : BOOLEAN;
END ITests;

(*================================================================================*)
// helper implementations -- implementor can directly use the class, the only thing he
// must do it to export Factory procedure and instantiate the class

ABSTRACT CLASS ATests( objlib.ACreator ) IMPLEMENTS ITests;
   PRIVATE VAR
      Tests : lists.CPtrList;

   // part of ILibrary
   PUBLIC VIRTUAL PROCEDURE EnumerateClasses( REF EnumerateState : PTR; OUT ClassName : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE GetLECData( OUT cllvData : objlib.TcllvData; OUT cllvPath : ARRAY OF WCHAR ) : BOOLEAN;

   // ITests
   PUBLIC VIRTUAL PROCEDURE EnumerateTests( REF ES : PTR; OUT Name : ARRAY OF WCHAR; OUT Test : TPTest ) : BOOLEAN;

   // CTests
   PUBLIC PROCEDURE AddTest( CONST Name : ARRAY OF WCHAR; Test : TPTest );
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // ACreator
   VIRTUAL PROCEDURE OnFactory( CONST QName : ARRAY OF WCHAR; OUT Object : objlib.TPObject ) : objlib.TResult;
END ATests;
   
(*================================================================================*)
   
END test.