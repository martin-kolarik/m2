<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ProjectDescription>Common Thread Messaging</ProjectDescription>
        <ProjectVersionMajor>1</ProjectVersionMajor>
        <ProjectVersionMinor>0</ProjectVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib;API\win32"/>
        <Components Include="Modula2\m2rtl;Library\ADT"/>

        <Definitions Include="msghandler;thread;msgqueuethread"/>
        <Modules Include="OSALmsg;OSALthread;Win32thread;msgthreadsupport;msgqueue;msghandlersink;threadcall;TimeoutableTwoPtrMap;threadpool;threadinit"/>
        <Modules Include="SCmsg;SCmsgqueuethread"/>
        <Modules Include="Win32msg;Win32msgqueuethread"/>

        <Libraries Include="user32"/>

    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
