<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <FileDescription>Common Thread Messaging</FileDescription>
        <FileVersionMajor>1</FileVersionMajor>
        <FileVersionMinor>0</FileVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="modula2\modula2;api\clib;API\win32"/>
        <Components Include="modula2\m2rtl;library\ADT"/>
        <Definitions Include="OSALmsg;OSALthread;msghandler;thread;msgqueuethread"/>
        <Modules Include="Win32thread;msgthreadsupport;msgqueue;TimeoutablePtrMap;threadpoolsink;threadpool"/>

        <Modules Include="SCmsg;SCmsgqueuethread"/>

        <!-- Modules Include="Win32msg;Win32msgqueuethread"/ -->
        <!-- Libraries Include="user32"/ -->

    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
