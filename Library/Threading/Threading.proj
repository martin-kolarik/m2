<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <FileDescription>Common Thread Messaging</FileDescription>
        <FileVersionMajor>1</FileVersionMajor>
        <FileVersionMinor>0</FileVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="modula2\modula2;api\clib;API\win32"/>
        <Components Include="modula2\m2rtl;library\ADT;library\messaging"/>
        <Definitions Include="threadOSAL;msgqueuethreadOSAL;thread;msgqueuethread"/>
        <Modules Include="threadWin32;msgqueuethreadWin32;threadpool"/>
        <Libraries Include="user32"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
