DEFINITION MODULE SCmsg;

// DO NOT USE THIS MODULE DIRECTLY, USE msghandler

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   baseobject,
  maps,
  OSALmsg,
  Sync;
  
#save, option( dll_export => on )

(*===============================================================================*)

TYPE
   TPMessage = POINTER TO SCMessage;

CONST
   SC_RAW_MSG_BASE = 1024; // to be compatible with Win32
  
(*===============================================================================*)

PROCEDURE HandleToTarget( CONST Handle : PTR; OUT Handler : OSALmsg.TPMessageTarget ) : BOOLEAN;

(*===============================================================================*)

CONST
   MI_PARAM_1 = 3;
   MI_PARAM_2 = 4;
   MI_PARAM_3 = 5;
   MI_PARAM_4 = 6;

CLASS SCMessage IMPLEMENTS OSALmsg.IMessage;
  PRIVATE VAR
    source : ADDRESS;
    target : OSALmsg.TPMessageTarget;
    message : CARDINAL;
    param1 : PTR;
    param2 : PTR;
    param3 : PTR;
    param4 : PTR;
  PUBLIC VIRTUAL PROPERTY
    Source : ADDRESS;
    Target : OSALmsg.TPMessageTarget;
    Message : CARDINAL;
    Parameter : PTR;
  PUBLIC VIRTUAL READONLY PROPERTY
    ParameterCount : CARDINAL; // including handler and Message
  PUBLIC VIRTUAL
    INDEX( ParameterIndex : CARDINAL ) : PTR;
  PUBLIC VIRTUAL PROCEDURE Clone() : POINTER TO OSALmsg.IMessage;
  PUBLIC VIRTUAL PROCEDURE Release();
  PUBLIC OPERATOR
    :=( CONST MSG : SCMessage );
END SCMessage;

(*===============================================================================*)

CLASS SCMessageHandler( baseobject.CDisposable ) IMPLEMENTS OSALmsg.IMessageHandler;
  INTERNAL VAR
    joinedTo : OSALmsg.TPMessageQueueThread;
  PUBLIC VIRTUAL READONLY PROPERTY
    SelfContext : BOOLEAN;
    Handle : PTR;
    
  PUBLIC VIRTUAL READONLY PROPERTY JoinedTo : OSALmsg.TPMessageQueueThread;

  #save, option( leak_info => on )
  PUBLIC PROCEDURE Init( AutomaticJoin : BOOLEAN ); // AutomaticJoin defaultly calls OnJoin in thread
  PUBLIC VIRTUAL PROCEDURE Dispose();
  #restore

  // IMessageHandler
  PUBLIC VIRTUAL PROCEDURE Message( CONST MSG : OSALmsg.IMessage; Delivery : OSALmsg.TDelivery; Result : PPTR ) : BOOLEAN;
  INTERNAL VIRTUAL PROCEDURE OnMessage( CONST MSG : OSALmsg.IMessage; OUT Result : PTR ) : BOOLEAN;

  PUBLIC VIRTUAL PROCEDURE StartTimer( Timer : PTR; PeriodMS : CARDINAL; Repeat : BOOLEAN );
  PUBLIC VIRTUAL PROCEDURE TimerRunning( Timer : PTR ) : BOOLEAN;
  PUBLIC VIRTUAL PROCEDURE StopTimer( Timer : PTR );
  INTERNAL VIRTUAL PROCEDURE OnTimer( Timer : PTR );

  PUBLIC VIRTUAL PROCEDURE JoinMessageThread( CONST JoinTo : OSALmsg.IMessageQueueThread; CallOnJoinInThread : BOOLEAN );
  PUBLIC VIRTUAL PROCEDURE LeaveMessageThread( CallOnLeaveInThread : BOOLEAN );

  // called from joined IMessageQueueThread etc., do not call directly
  #save, option( leak_info => on )
  PUBLIC VIRTUAL PROCEDURE OnJoin( CONST JoinedTo : OSALmsg.IMessageQueueThread );
  PUBLIC VIRTUAL PROCEDURE OnLeave();
  #restore
  
  VIRTUAL FINALLY SCMessageHandler();
END SCMessageHandler;

(*===============================================================================*)

#restore

END SCmsg.