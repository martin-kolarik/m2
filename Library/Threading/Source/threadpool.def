DEFINITION MODULE threadpool;

IMPORT
  avltree,
  Delegate,
  lists,
  msghandler,
  msgqueue,
  Sync;

#save, option( dll_export => on )

//--------------------------------------------------------------------------------

TYPE
   TPITimeoutSink = POINTER TO ITimeoutSink;
   TPIMessageSink = POINTER TO IMessageSink;
   TPIHandleSink  = POINTER TO IHandleSink;
   TPIWorkerSink  = POINTER TO IWorkerSink;
   
INTERFACE ITimeoutSink; 
  LOCAL PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR );
END ITimeoutSink;

INTERFACE IMessageSink;
  LOCAL PROCEDURE OnMessage( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR; CONST MSG : msghandler.IMessage );
END IMessageSink;

INTERFACE IHandleSink;
  LOCAL PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR );
END IHandleSink;

INTERFACE IWorkerSink;
  LOCAL PROCEDURE OnWorker( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR );
END IWorkerSink;

//--------------------------------------------------------------------------------

TYPE
  TPPoolDelegate = POINTER TO APoolDelegate;

ABSTRACT CLASS APoolDelegate( Delegate.ADelegate ) IMPLEMENTS ITimeoutSink, IMessageSink, IHandleSink, IWorkerSink;
  LOCAL VIRTUAL PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR );
  LOCAL VIRTUAL PROCEDURE OnMessage( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR; CONST MSG : msghandler.IMessage );
  LOCAL VIRTUAL PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR );
  LOCAL VIRTUAL PROCEDURE OnWorker( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR );
END APoolDelegate;

//--------------------------------------------------------------------------------

TYPE
  TPSinkDelegate = POINTER TO CSinkDelegate;
  
CLASS CSinkDelegate( APoolDelegate );
  PUBLIC VAR
    TimeoutSink : TPITimeoutSink;
    MessageSink : TPIMessageSink;
    HandleSink : TPIHandleSink;
    WorkerSink : TPIWorkerSink;
  LOCAL FINAL PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR );
  LOCAL FINAL PROCEDURE OnMessage( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR; CONST MSG : msghandler.IMessage );
  LOCAL FINAL PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR );
  LOCAL FINAL PROCEDURE OnWorker( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR );
END CSinkDelegate;

//--------------------------------------------------------------------------------

TYPE
  TPMessageHandlerDelegate = POINTER TO CMessageHandlerDelegate;
  
CLASS CMessageHandlerDelegate( APoolDelegate );
  PUBLIC VAR
    Handler : msghandler.TPMessageHandler;
    Delivery : msghandler.TDelivery := msghandler.delSynchronous;
  LOCAL FINAL PROCEDURE OnMessage( Result : Sync.TAsyncResult; PoolHandle : Sync.WAITABLE; UserId : PTR; CONST MSG : msghandler.IMessage );
END CMessageHandlerDelegate;

//--------------------------------------------------------------------------------

TYPE
  TPPoolWorker = POINTER TO APoolWorker;

ABSTRACT CLASS APoolWorker( Delegate.ADelegate );
  LOCAL ABSTRACT PROCEDURE Run();
END APoolWorker;

//--------------------------------------------------------------------------------

TYPE
  TPThreadPool = POINTER TO CThreadPool;
  
CLASS CThreadPool( msghandler.MessageHandler );
  PRIVATE VAR
    Threads : lists.CPtrList;
    MQueue : msgqueue.CMessageQueue;
    _MinThreads : CARDINAL := 1;
    _Thread : CARDINAL; // for safety, if interface is singlethread, no call to interface from different threads is allowed
    _Lock : Sync.LOCK; // enumeration is locked (due to multihtreaded Abort)
  PUBLIC READONLY PROPERTY
    UndeliveredMessagesPending : BOOLEAN; // mostly for debug purposes
  PUBLIC PROPERTY
    MinThreads : CARDINAL; // default is 1; moreover, the pool does not allocate all threads on start, the number of them increases lazily
  PUBLIC VAR
    WorkerLoad : CARDINAL := 32; // number of workers in single worker thread
    MaxThreads : CARDINAL := -1; // if there is no space, the RunWorker request is queued
    SingleThreadInterface : BOOLEAN := TRUE;
    CompletionInOwningThread : BOOLEAN := FALSE;
    
  INTERNAL VIRTUAL PROCEDURE OnMessage( CONST MSG : msghandler.IMessage; OUT Result : PTR ) : BOOLEAN;
  PUBLIC PROCEDURE FinishAndWait();

  PUBLIC PROCEDURE WaitTimeout( CONST Delegate : TPPoolDelegate; UserId : PTR; TimeoutMS : CARDINAL; WaitOnce, CompleteInOwningThread : BOOLEAN; OUT PoolHandle : Sync.WAITABLE ) : BOOLEAN;
  PUBLIC PROCEDURE WaitMessage( CONST Delegate : TPPoolDelegate; UserId : PTR; TimeoutMS : CARDINAL; WaitOnce, CompleteInOwningThread : BOOLEAN; OUT Handler : msghandler.TPMessageHandler; OUT Message : msghandler.Message; OUT PoolHandle : Sync.WAITABLE ) : BOOLEAN;
  PUBLIC PROCEDURE WaitHandle( CONST Delegate : TPPoolDelegate; UserId : PTR; TimeoutMS : CARDINAL; WaitOnce, CompleteInOwningThread : BOOLEAN; Handle : Sync.WAITABLE; OUT PoolHandle : Sync.WAITABLE ) : BOOLEAN;
  PUBLIC PROCEDURE RunWorker( CONST Delegate : TPPoolDelegate; UserId : PTR; ForceSelfThread : BOOLEAN; Worker : TPPoolWorker; CompleteInOwningThread : BOOLEAN; OUT PoolHandle : Sync.WAITABLE ) : BOOLEAN;
  PUBLIC PROCEDURE WaitCompletion( PoolHandle : Sync.WAITABLE; Timeout : CARDINAL ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE Abort( REF PoolHandle : Sync.WAITABLE );
  PUBLIC PROCEDURE AbortAll( CONST Delegate : TPPoolDelegate );
  
  LOCAL PROCEDURE OnThreadEmpty();
  LOCAL PROCEDURE OnCompletion( Result : Sync.TAsyncResult; Task : PTR; CONST MSG : msghandler.Message ) : BOOLEAN;
  
  PRIVATE PROCEDURE CheckThreadInterface();
  PRIVATE PROCEDURE LookupThread( WorkerFlag : BOOLEAN; ForceSelfThread : BOOLEAN; OUT PoolThread : PTR ) : BOOLEAN;
  PRIVATE PROCEDURE DisposeThreads( RespectMinThreads : BOOLEAN );
END CThreadPool;

//--------------------------------------------------------------------------------

#restore

END threadpool.
