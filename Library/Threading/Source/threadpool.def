DEFINITION MODULE threadpool;

IMPORT
   avltree,
   Delegate,
   lists,
   msghandler,
   msgqueue,
   Sync;

#save, option( dll_export => on )

//--------------------------------------------------------------------------------

TYPE
   TPoolHandle = PTR;

//--------------------------------------------------------------------------------

TYPE
   TPITimeoutSink = POINTER TO ITimeoutSink;
   TPIMessageSink = POINTER TO IMessageSink;
   TPIHandleSink  = POINTER TO IHandleSink;
   TPIWorkerSink  = POINTER TO IWorkerSink;
   
INTERFACE ITimeoutSink; 
  PUBLIC PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR );
END ITimeoutSink;

INTERFACE IMessageSink;
  PUBLIC PROCEDURE OnMessage( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR; CONST MSG : msghandler.IMessage );
END IMessageSink;

INTERFACE IHandleSink;
  PUBLIC PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR );
END IHandleSink;

INTERFACE IWorkerSink;
  PUBLIC PROCEDURE OnWorker( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR );
END IWorkerSink;

//--------------------------------------------------------------------------------

TYPE
  TPPoolDelegate = POINTER TO APoolDelegate;

ABSTRACT CLASS APoolDelegate( Delegate.ADelegate ) IMPLEMENTS ITimeoutSink, IMessageSink, IHandleSink, IWorkerSink;
  PUBLIC VIRTUAL PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR );
  PUBLIC VIRTUAL PROCEDURE OnMessage( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR; CONST MSG : msghandler.IMessage );
  PUBLIC VIRTUAL PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR );
  PUBLIC VIRTUAL PROCEDURE OnWorker( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR );
END APoolDelegate;

//--------------------------------------------------------------------------------

TYPE
  TPSinkDelegate = POINTER TO CSinkDelegate;
  
CLASS CSinkDelegate( APoolDelegate );
  PUBLIC VAR
    TimeoutSink : TPITimeoutSink;
    MessageSink : TPIMessageSink;
    HandleSink : TPIHandleSink;
    WorkerSink : TPIWorkerSink;
  PUBLIC FINAL PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR );
  PUBLIC FINAL PROCEDURE OnMessage( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR; CONST MSG : msghandler.IMessage );
  PUBLIC FINAL PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR );
  PUBLIC FINAL PROCEDURE OnWorker( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR );
END CSinkDelegate;

//--------------------------------------------------------------------------------

TYPE
  TPMessageHandlerDelegate = POINTER TO CMessageHandlerDelegate;
  
CLASS CMessageHandlerDelegate( APoolDelegate );
  PUBLIC VAR
    Handler : msghandler.TPMessageHandler;
    Delivery : msghandler.TDelivery := msghandler.delSynchronous;
  PUBLIC FINAL PROCEDURE OnMessage( Result : Sync.TAsyncResult; PoolHandle : TPoolHandle; UserId : PTR; CONST MSG : msghandler.IMessage );
END CMessageHandlerDelegate;

//--------------------------------------------------------------------------------

TYPE
  TPPoolWorker = POINTER TO APoolWorker;

ABSTRACT CLASS APoolWorker( Delegate.ADelegate );
  LOCAL ABSTRACT PROCEDURE Run();
END APoolWorker;

//--------------------------------------------------------------------------------

TYPE
  TPThreadPool = POINTER TO CThreadPool;
  
// CThreadPool must be allocated dynamically -- it must not be created as static or inside startup code
CLASS CThreadPool( msghandler.MessageHandler );
  PRIVATE VAR
    Threads : lists.CPtrList;
    MQueue : msgqueue.CMessageQueue;
    _MinThreads : CARDINAL := 1;
    _Lock : Sync.LOCK; // enumeration is locked (due to multihtreaded access)
  PUBLIC READONLY PROPERTY
    UndeliveredMessagesPending : BOOLEAN; // mostly for debug purposes
  PUBLIC PROPERTY
    MinThreads : CARDINAL; // default is 1; moreover, the pool does not allocate all threads on start, the number of them increases lazily
  PUBLIC VAR
    WorkerLoad : CARDINAL := 32; // number of workers in single worker thread
    MaxThreads : CARDINAL := -1; // if there is no space, the RunWorker request is queued
    CompletionInOwningThread : BOOLEAN := FALSE;
    
  INTERNAL VIRTUAL PROCEDURE OnMessage( CONST MSG : msghandler.IMessage; OUT Result : PTR ) : BOOLEAN;
  PUBLIC PROCEDURE FinishAndWait();

  PUBLIC PROCEDURE WaitTimeout( CONST Delegate : TPPoolDelegate; UserId : PTR; TimeoutMS : CARDINAL; WaitOnce, CompleteInOwningThread : BOOLEAN; OUT PoolHandle : TPoolHandle ) : BOOLEAN;
  PUBLIC PROCEDURE WaitMessage( CONST Delegate : TPPoolDelegate; UserId : PTR; TimeoutMS : CARDINAL; WaitOnce, CompleteInOwningThread : BOOLEAN; OUT Target : msghandler.TPMessageTarget; OUT Message : msghandler.IMessage; OUT PoolHandle : TPoolHandle ) : BOOLEAN;
  PUBLIC PROCEDURE WaitHandle( CONST Delegate : TPPoolDelegate; UserId : PTR; TimeoutMS : CARDINAL; WaitOnce, CompleteInOwningThread : BOOLEAN; Handle : Sync.WAITABLE; OUT PoolHandle : TPoolHandle ) : BOOLEAN;
  PUBLIC PROCEDURE RunWorker( CONST Delegate : TPPoolDelegate; UserId : PTR; ForceSelfThread : BOOLEAN; Worker : TPPoolWorker; CompleteInOwningThread : BOOLEAN; OUT PoolHandle : TPoolHandle ) : BOOLEAN;
  PUBLIC PROCEDURE Abort( REF PoolHandle : TPoolHandle );
  PUBLIC PROCEDURE AbortAll( CONST Delegate : TPPoolDelegate );
  
  LOCAL PROCEDURE OnThreadEmpty();
  LOCAL PROCEDURE OnCompletion( Result : Sync.TAsyncResult; Task : PTR; CONST MSG : msghandler.Message ) : BOOLEAN;
  
  PRIVATE PROCEDURE LookupThread( WorkerFlag : BOOLEAN; ForceSelfThread : BOOLEAN; OUT PoolThread : PTR ) : BOOLEAN;
  PRIVATE PROCEDURE DisposeThreads( RespectMinThreads : BOOLEAN );
END CThreadPool;

//--------------------------------------------------------------------------------
// global, universal purpose thread pool

PROCEDURE pool() : TPThreadPool;

#restore

// Startup, Cleanup SHOULD NOT BE CALLED automatically of from init code -- they can operate threads.
// Procedures should not be called from the outside of the module, use threadinit instead.
PROCEDURE Startup();
PROCEDURE Cleanup();

END threadpool.
