DEFINITION MODULE msgqueuethreadOSAL;

(*---------------------------------------------------------------------------*)
  
IMPORT
   msghandler;

#save, option( dll_export => on )

(*===========================================================================*)

INTERFACE IMsgQueueThread( msghandler.IMessageRecipient );

   INTERNAL READONLY PROPERTY
      Root : msghandler.TPMessageHandler;
      
   INTERNAL PROCEDURE OnStart();
   INTERNAL PROCEDURE OnExit();

   INTERNAL PROCEDURE MessageToHandler( CONST Msg : PTR; OUT Handler : msghandler.TPMessageHandler ) : BOOLEAN;

END IMsgQueueThread;

(*===========================================================================*)

#restore

END msgqueuethreadOSAL.