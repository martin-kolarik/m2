DEFINITION MODULE msghandler;

(*===========================================================================*)
// Win32

IMPORT
  OSALmsg,
  Win32msg;

CONST
  TDelivery ::= OSALmsg.TDelivery;
  delUnknown ::= OSALmsg.delUnknown;
  delDefault ::= OSALmsg.delDefault;
  delSynchronous ::= OSALmsg.delSynchronous;
  delSynchronousIfInThread ::= OSALmsg.delSynchronousIfInThread;
  delAsynchronous ::= OSALmsg.delAsynchronous;

CONST
  IMessage ::= OSALmsg.IMessage;
  IMessageRecipient ::= OSALmsg.IMessageRecipient;
  TPIMessage ::= OSALmsg.TPMessage;
  TPMessageRecipient ::= OSALmsg.TPMessageRecipient;
CONST
  RawMsgBase ::= Win32msg.Win32RawMsgBase; // for usage only inside this library
  MsgBase ::= Win32msg.Win32MsgBase;
  Message ::= Win32msg.Win32Message;
  MessageHandler ::= Win32msg.Win32MessageHandler;
TYPE
  TPMessage = POINTER TO Message;
  TPMessageHandler = POINTER TO MessageHandler;

CONST
  HandleToRecipient ::= Win32msg.HandleToRecipient;

(*===========================================================================*)

END msghandler.
