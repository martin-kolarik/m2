DEFINITION MODULE Win32thread;

// DO NOT USE THIS MODULE DIRECTLY, USE thread

FROM Storage IMPORT
  ALLOCATE, DEALLOCATE;

IMPORT
  sync,
  OSALthread;
  
#save, option( dll_export => on )

CLASS Win32Thread IMPLEMENTS OSALthread.IThread;
  INTERNAL READONLY VAR
    _RunLock : CARDINAL;
    _Thread : CARDINAL;
    _HThread : Sync.WAITABLE;
    _HExit : Sync.SIGNAL;
    _WMsg : TRISTATE;
    _Runnable : OSALthread.TPRunnable;
  PUBLIC VIRTUAL READONLY PROPERTY
    SelfContext : BOOLEAN;
  PUBLIC PROPERTY
    WithMessages : BOOLEAN;

  PUBLIC FINAL PROCEDURE Run( Wait : BOOLEAN );
  PUBLIC FINAL PROCEDURE Stop( Wait : BOOLEAN );
  PUBLIC FINAL PROCEDURE WaitStop( Timeout : CARDINAL ) : sync.TAsyncResult;
  
  PUBLIC FINAL PROCEDURE RunWithRunnable( Runnable : OSALthread.TPRunnable );

  INTERNAL VIRTUAL PROCEDURE OnRun() : CARDINAL;

  LOCAL PROCEDURE Exec() : CARDINAL;
  VIRTUAL FINALLY Win32Thread();
END Win32Thread;

#restore

END Win32thread.