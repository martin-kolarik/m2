DEFINITION MODULE OSALmsg;

// DO NOT USE THIS MODULE DIRECTLY, USE msghandler OR msqqueuethread

IMPORT
   OSALthread;

#save, option( dll_export => on )

(*===========================================================================*)

TYPE
  TDelivery = (
    delUnknown,
    delSynchronous, // Message directly calls OnMessage
    delSynchronousIfInThread, // Message directly calls OnMessage if Handler is of the current thread
    delAsynchronous,
    delDefault = delAsynchronous
  );

TYPE
  TPMessage = POINTER TO IMessage;
  TPMessageTarget = POINTER TO IMessageTarget;
  TPMessageHandler = POINTER TO IMessageHandler;
  TPMessageQueueThread = POINTER TO IMessageQueueThread;

(*---------------------------------------------------------------------------*)

CONST
   // RAW messages are system/internal and cannot be used outer of this library
   RAW_MESSAGE_SPACE = 64;

   RAW_PROCESS_QUEUE = 1;
   RAW_MESSAGE_JOIN = 2;
   RAW_MESSAGE_LEAVE = 3;

   RAW_MESSAGE_SETTIMER = 4;
   RAW_MESSAGE_RESETTIMER = 5;
   RAW_MESSAGE_ONTIMER = 6;

CONST
   MI_SOURCE = 0;
   MI_TARGET = 1;
   MI_MESSAGE = 2;
   MI_PARAMETER = 3;
  
(*---------------------------------------------------------------------------*)

INTERFACE IMessage;
  PUBLIC ABSTRACT PROPERTY
    Source : ADDRESS; // can be NIL
    Target : TPMessageTarget; // if Target is NIL the message's target is owner of Message method taking the message
    Message : CARDINAL;
    Parameter : PTR;
  PUBLIC ABSTRACT READONLY PROPERTY
    ParameterCount : CARDINAL; // including MSG and optional Target and Source, message must have AT LEAST 1 parameter
  PUBLIC ABSTRACT 
    INDEX( ParameterIndex : CARDINAL ) : PTR;
  PUBLIC ABSTRACT PROCEDURE
    Clone() : POINTER TO IMessage;
END IMessage;

(*===========================================================================*)

INTERFACE IMessageTarget; // for delivery of messages, now they are IMessageHandler and IMessageQueueThread
  PUBLIC ABSTRACT READONLY PROPERTY
    SelfContext : BOOLEAN;
  PUBLIC ABSTRACT PROCEDURE Message( CONST MSG : IMessage; Delivery : TDelivery; Result : PPTR ) : BOOLEAN;
  INTERNAL ABSTRACT PROCEDURE OnMessage( CONST MSG : IMessage; OUT Result : PTR ) : BOOLEAN;
  INTERNAL ABSTRACT PROCEDURE OnTimer( Timer : PTR );
END IMessageTarget;
  
(*===========================================================================*)

INTERFACE IMessageQueueThread( IMessageTarget );
   INTERNAL READONLY PROPERTY
      Root : TPMessageTarget; // thread can have some special processing
   PUBLIC READONLY PROPERTY
      SelfContext : BOOLEAN;
 
   // to behave as MsgHandler     
   PUBLIC PROCEDURE StartTimer( CONST Target : IMessageTarget; TimerId : PTR; PeriodMS : CARDINAL; Repeat : BOOLEAN );
   PUBLIC PROCEDURE StopTimer( CONST Target : IMessageTarget; TimerId : PTR );
   PUBLIC PROCEDURE TimerRunning( CONST Target : IMessageTarget; TimerId : PTR ) : BOOLEAN;

   // more thread's
   INTERNAL PROCEDURE OnStart();
   INTERNAL PROCEDURE OnExit();

   // helper
   INTERNAL PROCEDURE MessageToTarget( CONST Msg : PTR; OUT Target : TPMessageTarget ) : BOOLEAN;
   
   // called from Target's join/leave, do not call directly
   PUBLIC PROCEDURE Join( Handler : TPMessageHandler; CallOnJoinInThread : BOOLEAN );
   PUBLIC PROCEDURE Leave( Handler : TPMessageHandler; CallOnLeaveInThread : BOOLEAN );
END IMessageQueueThread;

(*===========================================================================*)

INTERFACE IMessageHandler( IMessageTarget );
  PUBLIC ABSTRACT READONLY PROPERTY
    JoinedTo : TPMessageQueueThread;
    Handle : PTR;

  // interface
  // ...IMessageTarget.Message
  // ...IMessageTarget.OnMessage

  PUBLIC ABSTRACT PROCEDURE JoinMessageThread( CONST JoinTo : IMessageQueueThread; CallOnJoinInThread : BOOLEAN );
  PUBLIC ABSTRACT PROCEDURE LeaveMessageThread( CallOnLeaveInThread : BOOLEAN );

  PUBLIC ABSTRACT PROCEDURE StartTimer( Timer : PTR; PeriodMS : CARDINAL; Repeat : BOOLEAN );
  PUBLIC ABSTRACT PROCEDURE TimerRunning( Timer : PTR ) : BOOLEAN;
  PUBLIC ABSTRACT PROCEDURE StopTimer( Timer : PTR );
  // ...IMessageTarget.OnTimer

  // helper -- DO NOT call directly, it is called by joined thread
  PUBLIC ABSTRACT PROCEDURE OnJoin( CONST JoinedTo : IMessageQueueThread );
  PUBLIC ABSTRACT PROCEDURE OnLeave();
END IMessageHandler;

(*===========================================================================*)

#restore

END OSALmsg.