DEFINITION MODULE msgthreadsupport;

(*===========================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   maps,
   OSALmsg,
   Sync;

(*===========================================================================*)

TYPE
   TPSupport = POINTER TO CSupport;
   
// THE CLASS SHOULD BE ALLOCATED DYNAMICALLY TO NOT TO MAKE NEED TO CALL CONTSRUCTOR FROM OTHER DLLs
   
CLASS CSupport;
   PRIVATE VAR
      Joined : maps.CPtrMap;
      Lock : Sync.LOCK;
      OfThread : OSALmsg.TPMessageQueueThread;

   PUBLIC PROCEDURE Init( OfThread : OSALmsg.TPMessageQueueThread );
   PUBLIC PROCEDURE Dispose();
   
   // client (outer) side
   PUBLIC PROCEDURE Join( Recipient : OSALmsg.TPMessageRecipient );
   PUBLIC PROCEDURE Leave( Recipient : OSALmsg.TPMessageRecipient );
   
   // thread (inner) side
   PUBLIC PROCEDURE HandleSupportMessage( CONST Message : OSALmsg.IMessage ) : BOOLEAN; // if it is not support logic message it returns FALSE
   PUBLIC PROCEDURE IsJoined( Recipient : OSALmsg.TPMessageRecipient ) : BOOLEAN;
END CSupport;

(*===========================================================================*)

END msgthreadsupport.