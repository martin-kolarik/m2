DEFINITION MODULE SCmsgqueuethread;

// DO NOT USE THIS MODULE DIRECTLY, USE msqqueuethread

IMPORT
   msgthreadsupport,
   msgqueue,
   OSALmsg,
   Win32thread;
  
(*---------------------------------------------------------------------------*)
  
#save, option( dll_export => on )

CLASS SCMsgQueueThread( Win32thread.Win32Thread ) IMPLEMENTS OSALmsg.IMessageQueueThread;
   INTERNAL VAR
      Support : msgthreadsupport.TPSupport;
      Queue : msgqueue.CMessageQueue;

   // IThread/IRunnable
   INTERNAL VIRTUAL PROCEDURE OnRun() : CARDINAL;
   
   // IMessageQueueThread
   INTERNAL VIRTUAL READONLY PROPERTY Root : OSALmsg.TPMessageRecipient;
   INTERNAL VIRTUAL PROCEDURE OnStart();
   INTERNAL VIRTUAL PROCEDURE OnExit();
   INTERNAL VIRTUAL PROCEDURE MessageToRecipient( CONST Msg : PTR; OUT Handler : OSALmsg.TPMessageRecipient ) : BOOLEAN;

   // IMessageRecipient
   PUBLIC VIRTUAL READONLY PROPERTY SelfContext : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Message( CONST Msg : OSALmsg.IMessage; Delivery : OSALmsg.TDelivery; Result : PPTR ) : BOOLEAN; // if Msg.Target = NIL then the message must be processed by thread itself; Delivery is possible only delSynchronousInThread and delAsynchronous
   INTERNAL VIRTUAL PROCEDURE OnMessage( CONST Msg : OSALmsg.IMessage; OUT Result : PTR ) : BOOLEAN; // thread targetted messages

   // service of IMessageRecipient
   PUBLIC VIRTUAL PROCEDURE Join( Recipient : OSALmsg.TPMessageRecipient );
   PUBLIC VIRTUAL PROCEDURE Leave( Recipient : OSALmsg.TPMessageRecipient );

   // IMessageRecipient dummies
   PUBLIC FINAL READONLY PROPERTY JoinedTo : OSALmsg.TPMessageQueueThread;
   PUBLIC FINAL PROCEDURE JoinMessageThread( JoinTo : OSALmsg.TPMessageQueueThread );
   PUBLIC FINAL PROCEDURE LeaveMessageThread();
   PUBLIC FINAL PROCEDURE OnJoin( JoinedTo : OSALmsg.TPMessageQueueThread );
   PUBLIC FINAL PROCEDURE OnLeave();
END SCMsgQueueThread;

#restore

(*---------------------------------------------------------------------------*)
  
END SCmsgqueuethread.