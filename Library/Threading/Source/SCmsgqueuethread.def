DEFINITION MODULE SCmsgqueuethread;

// DO NOT USE THIS MODULE DIRECTLY, USE msqqueuethread

IMPORT
   msgthreadsupport,
   msgqueue,
   OSALmsg,
   Sync,
   thread,
   threadcall,
   Win32thread;
  
(*---------------------------------------------------------------------------*)
  
#save, option( dll_export => on )

CLASS SCMessageQueueThread( Win32thread.Win32Thread ) IMPLEMENTS threadcall.IThreadProcedureCallHandler, OSALmsg.IMessageQueueThread;
   PRIVATE VAR
      Consume : Sync.SIGNAL;
      Produce : Sync.SIGNAL;
   INTERNAL VAR
      Support : msgthreadsupport.TPSupport;
      Queue : msgqueue.CMessageQueue;

   // IThread/IRunnable
   INTERNAL VIRTUAL PROCEDURE OnRun( CONST Helper : thread.IRunnableHelper ) : CARDINAL;
   
   // IThreadProcedureCallHandler
   PUBLIC FINAL PROCEDURE ThreadCall( Target : threadcall.TPIThreadProcedureCallTarget; Operation : CARDINAL; CONST Parameters : ARRAY OF PTR; PReturnValue : POINTER TO PTR;
                                      WaitForResult : BOOLEAN; WaitTimeoutMS : CARDINAL ) : Sync.TAsyncResult;
   
   // IMessageTarget
   INTERNAL VIRTUAL PROCEDURE OnMessage( CONST Msg : msghandler.IMessage; OUT Result : PTR ) : BOOLEAN; // thread targetted messages
   INTERNAL VIRTUAL PROCEDURE OnTimer( Timer : PTR ); // thread targetted timers

   // IMessageQueueThread
   INTERNAL VIRTUAL READONLY PROPERTY Root : msghandler.TPIMessageHandler;
   PUBLIC VIRTUAL READONLY PROPERTY SelfContext : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Message( CONST Msg : msghandler.IMessage; Delivery : msghandler.TDelivery; Result : PPTR ) : BOOLEAN; // if Msg.Target = NIL then the message must be processed by thread itself
   PUBLIC VIRTUAL PROCEDURE StartTimer( CONST Target : msghandler.IMessageTarget; TimerId : PTR; PeriodMS : CARDINAL; Repeat : BOOLEAN );
   PUBLIC VIRTUAL PROCEDURE StopTimer( CONST Target : msghandler.IMessageTarget; TimerId : PTR );
   PUBLIC VIRTUAL PROCEDURE TimerRunning( CONST Target : msghandler.IMessageTarget; TimerId : PTR ) : BOOLEAN;

   INTERNAL VIRTUAL PROCEDURE OnStart();
   INTERNAL VIRTUAL PROCEDURE OnExit();
   INTERNAL VIRTUAL PROCEDURE MessageToTarget( CONST Msg : PTR; OUT Handler : msghandler.TPIMessageTarget ) : BOOLEAN;

   // service of IMessageTarget
   PUBLIC VIRTUAL PROCEDURE Join( Handler : msghandler.TPIMessageHandler; CallOnJoinInThread : BOOLEAN );
   PUBLIC VIRTUAL PROCEDURE Leave( Handler : msghandler.TPIMessageHandler; CallOnLeaveInThread : BOOLEAN );
END SCMessageQueueThread;

(*---------------------------------------------------------------------------*)
  
PROCEDURE SCGlobalMessageQueueThread() : POINTER TO SCMessageQueueThread;

#restore

// Startup, Cleanup SHOULD NOT BE CALLED automatically of from init code -- they can operate threads.
// Procedures should not be called from the outside of the module, use threadinit instead.
PROCEDURE Startup();
PROCEDURE Cleanup();

(*---------------------------------------------------------------------------*)
  
END SCmsgqueuethread.