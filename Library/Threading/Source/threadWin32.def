DEFINITION MODULE threadWin32;

IMPORT
  sync,
  threadOSAL;
  
TYPE
  THREAD = sync.WAITABLE;

ABSTRACT CLASS Win32Thread IMPLEMENTS threadOSAL.IThread;
  INTERNAL READONLY VAR
    _Thread : CARDINAL;
    _HThread : THREAD;
    _HExit : sync.SIGNAL;
    _WMsg : TRISTATE;
  PUBLIC VIRTUAL READONLY PROPERTY
    Thread : CARDINAL;
  PUBLIC VIRTUAL PROPERTY
    WithMessages : BOOLEAN;

  PUBLIC FINAL PROCEDURE Run( Wait : BOOLEAN );
  PUBLIC FINAL PROCEDURE Stop( Wait : BOOLEAN );
  PUBLIC FINAL PROCEDURE WaitStop( Timeout : CARDINAL ) : sync.TAsyncResult;
  
  INTERNAL VIRTUAL PROCEDURE OnRun() : CARDINAL;

  LOCAL PROCEDURE Exec() : CARDINAL;
  VIRTUAL FINALLY Win32Thread();
END Win32Thread;

END threadWin32.