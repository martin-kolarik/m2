DEFINITION MODULE thread;

(*===========================================================================*)

IMPORT
  OSALthread,
  Win32thread;

CONST
  IRunnableHelper ::= OSALthread.IRunnableHelper;
  IRunnable ::= OSALthread.IRunnable;
  IThread ::= OSALthread.IThread;
CONST
  Thread ::= Win32thread.Win32Thread;
TYPE
  TPThread = POINTER TO Thread;

(*===========================================================================*)

END thread.
