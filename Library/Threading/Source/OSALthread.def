DEFINITION MODULE OSALthread;

// DO NOT USE THIS MODULE DIRECTLY, USE thread

IMPORT
   Sync;

#save, option( dll_export => on )

TYPE
   TPRunnable = POINTER TO IRunnable;
   TPThread = POINTER TO IThread;

INTERFACE IRunnable;
   INTERNAL PROCEDURE OnRun() : CARDINAL;
END IRunnable;

INTERFACE IThread( IRunnable );
   PUBLIC READONLY PROPERTY
      SelfContext : BOOLEAN;

   // controlled thread
   PUBLIC PROCEDURE Run( Wait : BOOLEAN ); // command
   PUBLIC PROCEDURE Stop( Wait : BOOLEAN ); // command
   PUBLIC PROCEDURE WaitStop( Timeout : CARDINAL ) : Sync.TAsyncResult; // wait to exit
   
   // worker thread
   PUBLIC PROCEDURE RunWithRunnable( Runnable : TPRunnable );

   // inherited INTERNAL PROCEDURE OnRun() : CARDINAL; // executive code
END IThread;

#restore

END OSALthread.