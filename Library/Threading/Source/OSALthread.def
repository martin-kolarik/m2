DEFINITION MODULE OSALthread;
// DO NOT USE THIS MODULE DIRECTLY, USE thread

IMPORT
   Sync;

#save, option( dll_export => on )

(*===========================================================================*)

TYPE
   TPRunnable = POINTER TO IRunnable;
   TPThread = POINTER TO IThread;
   TPCrashHandler = POINTER TO ICrashHandler;

(*---------------------------------------------------------------------------*)

INTERFACE IRunnableHelper;
   PROCEDURE WaitForStopRequest( Timeout : CARDINAL ) : Sync.TAsyncResult; // arCompleted for Stop request, arNoData for duty loop, arPending for message (if thread supports them)
   PROCEDURE WaitForStopRequestAndSignal( CONST Signal : Sync.PSIGNAL; Timeout : CARDINAL ) : Sync.TAsyncResult; // arCompleted for Stop request, arPartCompleted for SIGNAL, arNoData for duty loop, arPending for message (if thread supports them)
   PROCEDURE WaitForStopRequestAndSignals( CONST Signal : ARRAY OF Sync.PSIGNAL; Timeout : CARDINAL; OUT IndexOfSignal : CARDINAL ) : Sync.TAsyncResult; // arCompleted for Stop request, arPartCompleted for SIGNAL, arNoData for duty loop, arPending for message (if thread supports them)
END IRunnableHelper;

(*---------------------------------------------------------------------------*)

INTERFACE IRunnable;
   // main run routine
   INTERNAL PROCEDURE OnRun( Restarted : BOOLEAN; CONST Helper : IRunnableHelper ) : CARDINAL; // Restarted is TRUE if recovery from crash has been requested
END IRunnable;

(*---------------------------------------------------------------------------*)

TYPE
   TRecoveryType = (
      recoveryTypeStop,
      recoveryTypeRestart
   );

INTERFACE ICrashHandler;
   // called if unhandled OS exception is catched
   PUBLIC PROCEDURE OnCrash( Thread : TPThread ) : TRecoveryType;
END ICrashHandler;

(*---------------------------------------------------------------------------*)

TYPE
   TInfoType = (
      infoTypeGeneric,
      infoTypeMessage,
      infoTypePool,
      infoTypeWorker
   );

INTERFACE IThread( IRunnable );

   PUBLIC READONLY PROPERTY
      Id : PTR;
      SelfContext : BOOLEAN;
      InfoType : TInfoType;
   PUBLIC PROPERTY
      CrashHandler : TPCrashHandler; // can be NIL, in the case crash notifier is simply not called

   // fully controlled thread approach
   PUBLIC PROCEDURE Start( WaitRun : BOOLEAN ) : Sync.TAsyncResult; // command
   PUBLIC PROCEDURE Stop( WaitStop : BOOLEAN ) : Sync.TAsyncResult; // command, if WaitStop then Stop calls WaitStop internally, otherwise the command is asynchronous
   PUBLIC PROCEDURE WaitStop( Timeout : CARDINAL ) : Sync.TAsyncResult; // waits for stop, cleans resources
   
   // worker thread approach
   PUBLIC PROCEDURE RunWithRunnable( Runnable : TPRunnable ) : Sync.TAsyncResult; // WaitStop or Stop must still be called, because only WaitStop cleans resources

   // inherited INTERNAL PROCEDURE OnRun() : CARDINAL; // executive code
END IThread;

(*===========================================================================*)

TYPE
   TPIThreadProcedureCallTarget = POINTER TO IThreadProcedureCallTarget;

INTERFACE IThreadProcedureCallTarget;
   PUBLIC PROCEDURE Invoke( Operation : CARDINAL; CONST Parameters : ARRAY OF PTR ) : PTR;
END IThreadProcedureCallTarget;

(*---------------------------------------------------------------------------*)

TYPE
   TPIThreadProcedureCallDispatcher = POINTER TO IThreadProcedureCallDispatcher;

INTERFACE IThreadProcedureCallDispatcher;
   PUBLIC PROCEDURE DispatchCall( Target : TPIThreadProcedureCallTarget;
                                  Operation : CARDINAL; CONST Parameters : ARRAY OF PTR; PReturnValue : POINTER TO PTR;
                                  WaitForResult : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
END IThreadProcedureCallDispatcher;

(*===========================================================================*)

#restore

END OSALthread.