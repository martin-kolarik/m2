<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ProjectDescription>Modula 2 Runtime Library</ProjectDescription>
        <ProjectVersionMajor>1</ProjectVersionMajor>
        <ProjectVersionMinor>1</ProjectVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib;API\win32"/>
        <Components Include="Modula2\m2rtl;Library\ADT;Library\Threading;Library\Text"/>
        <Modules Include="netinit;netpool;inetaddr;dns;netsocket;netstream;netsrv;connection;rawconnection;netconndispatch;accesslist"/>
        <Libraries Include="Ws2_32;IPHlpApi"/>
        <InterfaceWithDelayLoad Include="Ws2_32;IPHlpApi"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
