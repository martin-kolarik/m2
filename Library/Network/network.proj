<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <FileDescription>Modula 2 Runtime Library</FileDescription>
        <FileVersionMajor>1</FileVersionMajor>
        <FileVersionMinor>1</FileVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="modula2\modula2;api\clib;API\win32"/>
        <Components Include="modula2\m2rtl;library\ADT;library\threading;library\Text"/>
        <Modules Include="netinit;netpool;inetaddr;dns;netsocket;netstream;netsrv;netconndispatch"/>
        <Libraries Include="Ws2_32;IPHlpApi"/>
        <Interface Include="Ws2_32;IPHlpApi"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
