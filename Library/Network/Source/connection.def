DEFINITION MODULE connection;

(*================================================================================*)

IMPORT
   inetaddr,
   IOO,
   netsocket,
   Sync;
   
#save, option( dll_export => on )

(*================================================================================*)

TYPE
   TPIConnection = POINTER TO IConnection;
   TPIClientConnection = POINTER TO IClientConnection;
   TPIBufferedClientConnection = POINTER TO IBufferedClientConnection;
   TPIServerConnection = POINTER TO IServerConnection;
   TPIBufferedServerConnection = POINTER TO IBufferedServerConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IConnection;

   READONLY PROPERTY
      LocalAddress : inetaddr.INETADDR;
      RemoteAddress : inetaddr.INETADDR;
      Stream : IOO.TPStream;

END IConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IClientConnection( IConnection );
   
   READONLY PROPERTY
      Connected : BOOLEAN;
   PROPERTY
      CallbackMode : IOO.TCallbackMode; // default ioo.cbmPooled
      Notifier : netsocket.TPSocketNotifier;

   PROCEDURE Open( Host : ARRAY OF WCHAR; WaitForResult : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
   PROCEDURE Close();

END IClientConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IBufferedClientConnection( IClientConnection );
   
   READONLY PROPERTY
      BufferedStream : IOO.TPBufferedStream;
      
END IBufferedClientConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IServerConnection( IConnection );
END IServerConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IBufferedServerConnection( IServerConnection );

   READONLY PROPERTY
      BufferedStream : IOO.TPBufferedStream;

END IBufferedServerConnection;

(*================================================================================*)

#restore

END connection.