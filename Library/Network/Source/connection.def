DEFINITION MODULE connection;

(*================================================================================*)

IMPORT
   inetaddr,
   IOO,
   netsocket,
   Sync,
   threadcall;
   
#save, option( dll_export => on )

(*================================================================================*)

TYPE
   TPIConnection = POINTER TO IConnection;
   TPIClientConnection = POINTER TO IClientConnection;
   TPIServerConnection = POINTER TO IServerConnection;
   TPIAsynchronousConnection = POINTER TO IAsynchronousConnection;
   TPIBufferedConnection = POINTER TO IBufferedConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IConnection;

   READONLY PROPERTY
      Connected : BOOLEAN;
      LocalAddress : inetaddr.INETADDR;
      RemoteAddress : inetaddr.INETADDR;
      Stream : IOO.TPStream;

   PROCEDURE Close();

END IConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IClientConnection( IConnection );
   
   PROCEDURE Open( Host : ARRAY OF WCHAR; WaitForResult : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;

END IClientConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IServerConnection( IConnection );
END IServerConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IAsynchronousConnection;

   PROPERTY
      Dispatcher : threadcall.TPIThreadProcedureCallDispatcher; // default NIL, which means notifier is called directly from network thread
      Notifier : netsocket.TPSocketNotifier;

END IAsynchronousConnection;

(*--------------------------------------------------------------------------------*)

INTERFACE IBufferedConnection;
   
   READONLY PROPERTY
      BufferedStream : IOO.TPBufferedStream;
      
END IBufferedConnection;

(*================================================================================*)

#restore

END connection.