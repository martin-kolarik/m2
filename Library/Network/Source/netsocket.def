DEFINITION MODULE netsocket;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
  Delegate,
  inetaddr,
  IOO,
  msghandler,
  StorageO,
  StringsO,
  Sync,
  threadpool;

#save, option( dll_export => on )

(*================================================================================*)

CONST // time	
	FORSAFETY = 34543;

TYPE
  TPSSocket = POINTER TO SSocket;
  TPDSocket = POINTER TO DSocket;
  TPSocketNotifier = POINTER TO ASocketNotifier;
  
TYPE
  TOperation = (
    opUnknown,
    opListen,
    opAccept,
    opConnect,
    opDisconnect,
    opSend,
    opReceive
  );

ABSTRACT CLASS ASocketNotifier( IOO.ADataInfo );
  // common
  // SUPER.OnError
  // SUPER.OnFlowPossible
  // SSocket
  LOCAL VIRTUAL PROCEDURE OnListen( Result : CARDINAL; CONST Socket : TPSSocket );
  LOCAL VIRTUAL PROCEDURE OnDataArrived( Result : CARDINAL; CONST Socket : TPSSocket );
  // DSocket
  LOCAL VIRTUAL PROCEDURE OnAccept( Result : CARDINAL; CONST Socket : TPDSocket ); 
  LOCAL VIRTUAL PROCEDURE OnConnect( Result : CARDINAL; CONST Socket : TPDSocket; Local : BOOLEAN ); 
  LOCAL VIRTUAL PROCEDURE OnDisconnect( Result : CARDINAL; CONST Socket : TPDSocket; Local : BOOLEAN ); // calling Socket^.Release is safe if OnDisconnect is called from OnHandle. Otherwise (when OnDisconnect is called synchronously from Disconnect) it can be dangerous.
END ASocketNotifier;

(*--------------------------------------------------------------------------------*)

TYPE
  TSocketType = (
    stUnknown,
    stStream,
    stDatagram
  );
  
  TV6Mode = (
    v6mUnknown,
    v6mV4,
    v6mPreferV4,
    v6mPreferV6,
    v6mV6
  );
  
  TPendingOperationItem = (
    poUnknown,
    poListen, poConnection,
    poResolveAddress, poResolveName,
    poConnect, poDisconnect, // should be consequent to reserve space
      poConnectResolved, poConnectDisconnected, // temporary statuses driving Connect in connected state. Asynchronous DNS and Disconnect must be handled, only after them I could connect.
      poFinalReadoutPossible, // temporary state allowing reading out data which could be sent from remote side during/after FD_CLOSE signalling
    poReceive, poSend // should be consequent to reserve space
  );
  TPendingOperation = SET OF TPendingOperationItem;

CONST
  posConnectPrerequisities = TPendingOperation{poConnect, poConnectResolved, poConnectDisconnected};
  
CLASS SSocket( threadpool.APoolDelegate );
  PRIVATE VAR
    _Notifier    : TPSocketNotifier;
  INTERNAL VAR
    _Type        : TSocketType;
    _Pending     : TPendingOperation;
    _Lock        : Sync.LOCK; // locks _Pending (poListen, poConnection, poConnect, poDisconnect, poResolve*), others are informative, but for regularity they are locked too
    _FDHandle    : threadpool.TPoolHandle;
    _FDSignal    : Sync.SIGNAL;
    _FDSwitch    : SyncQueue.CDatagramQueue;
    _HSignal     : Sync.SIGNAL;
    _Backlog     : CARDINAL;
    _V6Mode      : TV6Mode := v6mPreferV6;
    _Broadcast   : BOOLEAN := FALSE; // for stDatagram
    Socket       : LONGWORD;
    Local        : inetaddr.INETADDR;
    Remote       : inetaddr.INETADDR; // here in SSocket only for storing mcast data
  PUBLIC READONLY VAR
    Result       : Sync.TAsyncResult; // for WaitCompletion, useless for listen

  PUBLIC PROPERTY
    Type           : TSocketType;
    Backlog        : CARDINAL;
    Notifier       : TPSocketNotifier;
    V6Mode         : TV6Mode;
    LocalAddress   : inetaddr.INETADDR; // setting V4/V6 determines type of socket (also for DSocket and Connect)
    MulticastGroup : inetaddr.INETADDR; // for stDatagram
    Broadcast      : BOOLEAN; // for stDatagram, affects sending
    Waitable       : BOOLEAN;
  PUBLIC READONLY PROPERTY
    Listening      : BOOLEAN;
    DataAvailable  : CARDINAL; // for stDatagram

  PUBLIC PROCEDURE Open( OUT Error : CARDINAL ) : Sync.TAsyncResult; // socket, bind, getlocalname
  PUBLIC PROCEDURE Close( Persist : BOOLEAN ); // closesocket
  PUBLIC PROCEDURE WaitCompletion( TimeoutMS : CARDINAL ) : Sync.TAsyncResult; // for SSocket waits new connection (waits accept availability)

  PUBLIC PROCEDURE Listen( OUT Error : CARDINAL ) : Sync.TAsyncResult; // listen
  PUBLIC PROCEDURE Flush(); // blind recv, accept depending on SSocket.Type, flushes Listen queue
  
	// for stDatagram
  PUBLIC PROCEDURE ReceiveOA( OUT Data : ARRAY OF BYTE; OUT Filled : CARDINAL ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE ReceiveFromOA( OUT Data : ARRAY OF BYTE; OUT Filled : CARDINAL; OUT Address : inetaddr.INETADDR ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE SendOA( CONST Data : ARRAY OF BYTE ) : Sync.TAsyncResult; // uses multicast address
  PUBLIC PROCEDURE SendToOA( CONST Data : ARRAY OF BYTE; CONST Address : inetaddr.INETADDR ) : Sync.TAsyncResult; // uses given address

  LOCAL VIRTUAL PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : threadpool.TPoolHandle; UserId : PTR );
  INTERNAL VIRTUAL PROCEDURE OnFD( Context : CARDINAL; Operation : TPendingOperationItem; ErrorCode : CARDINAL );

  INTERNAL PROCEDURE Select( Events : BITSET ) : CARDINAL;
  INTERNAL PROCEDURE MulticastJoin() : CARDINAL;
  INTERNAL PROCEDURE MulticastLeave() : CARDINAL;
  INTERNAL PROCEDURE GetSafeNotifier() : TPSocketNotifier; // AddRef on _Notifier is called
END SSocket;

(*================================================================================*)

CLASS DSocket( SSocket );
  INTERNAL VAR
    // Remote     : inetaddr.INETADDR; // moved to SSocket due to multicast issues
    RemoteName    : StringsO.CString;
    ResolveAddr   : threadpool.TPoolHandle;
    Timeout       : ARRAY [poConnect..poSend] OF threadpool.TPoolHandle;
    KeepAlive     : CARDINAL;
    Reader        : IOO.TPDataProxy;
    RPending      : IOO.TPDataProxy;
    Writer        : IOO.TPDataProxy;
    WPending      : IOO.TPDataProxy;

  PUBLIC PROPERTY
    RemoteAddress : inetaddr.INETADDR;
    KeepAliveTime : CARDINAL; // timeout after which KA probe is performed, default 300 s, INIFINITE means KA is off
  PUBLIC READONLY PROPERTY
    Connecting    : BOOLEAN;
    Connected     : BOOLEAN;
    Closed        : BOOLEAN;
    Readable      : BOOLEAN; // after remote shutdown the socked is formally closed, but it still can offer data
    DataAvailable : CARDINAL;
    
	// Open, Close pair is in DSocket covered with Connect/Disconnet. Open/Close cannot be used (only as SSocket.Open/Close call)
  PRIVATE PROCEDURE Open( OUT Error : CARDINAL ) : Sync.TAsyncResult; // socket -- modified variant of SSocket.Open
  PRIVATE PROCEDURE Close( Persist : BOOLEAN );
  // WaitCompletion() comes from SSocket

  PUBLIC PROCEDURE Connect( CONST Server : ARRAY OF WCHAR; DefaultPort : CARDINAL; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE ConnectAddress( CONST Server : inetaddr.INETADDR; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE Accept( CONST ServerSocket : TPSSocket; OUT Error : CARDINAL ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE AcceptFrom( REF SourceSocket : TPDSocket; OUT Error : CARDINAL ) : Sync.TAsyncResult; // adopts SourceSocket.Socket and clears it
  PUBLIC PROCEDURE Disconnect( Abortive : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
  
  PUBLIC PROCEDURE Receive( Buffer : IOO.TPDataProxy; TimeoutMS : CARDINAL; WaitForResult : BOOLEAN ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE ReceiveOA( OUT Data : ARRAY OF BYTE; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE AbortReceive();
  PUBLIC PROCEDURE Send( Buffer : IOO.TPDataProxy; TimeoutMS : CARDINAL; WaitForResult : BOOLEAN ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE SendOA( CONST Data : ARRAY OF BYTE; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE AbortSend();

  LOCAL VIRTUAL PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : threadpool.TPoolHandle; UserId : PTR );
  LOCAL VIRTUAL PROCEDURE OnHandle( Result : Sync.TAsyncResult; PoolHandle : threadpool.TPoolHandle; UserId : PTR );
  INTERNAL VIRTUAL PROCEDURE OnFD( Context : CARDINAL; Operation : TPendingOperationItem; ErrorCode : CARDINAL );
  LOCAL PROCEDURE OnAddressFound( Result : CARDINAL; CONST Address : ARRAY OF inetaddr.INETADDR );
  LOCAL PROCEDURE OnNameFound( Result : CARDINAL; CONST Name : StringsO.CString );

  PRIVATE PROCEDURE SwitchContext( FromContext : CARDINAL; Operation : TPendingOperationItem; ErrorCode : CARDINAL );
  PRIVATE PROCEDURE StartConnect();
  PRIVATE PROCEDURE OnConnect( Context : CARDINAL; Error : CARDINAL );
  PRIVATE PROCEDURE DoDisconnect( Abortive, Nested : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
  PRIVATE PROCEDURE OnDisconnect( Context : CARDINAL; Error : CARDINAL; Local : BOOLEAN );
  PRIVATE PROCEDURE StartFlow( Operation : TPendingOperationItem; Buffer : IOO.TPDataProxy; TimeoutMS : CARDINAL; WaitForResult : BOOLEAN ) : Sync.TAsyncResult;
  PRIVATE PROCEDURE OnFlow( Operation : TPendingOperationItem );
  PRIVATE PROCEDURE CompleteFlow( Operation : TPendingOperationItem; Device : BOOLEAN; Result : Sync.TAsyncResult; NResult : CARDINAL );
  PRIVATE PROCEDURE StartKeepAlive() : CARDINAL;
  PRIVATE PROCEDURE Shutdown() : CARDINAL;
  PRIVATE PROCEDURE StartTimeout( Operation : TPendingOperationItem; Timeout : CARDINAL );
  PRIVATE PROCEDURE StopTimeout( Operation : TPendingOperationItem );
END DSocket;

#restore

END netsocket.