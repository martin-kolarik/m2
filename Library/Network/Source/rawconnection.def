DEFINITION MODULE rawconnection;

(*================================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   connection,
   inetaddr,
   IOO,
   netsocket,
   netstream,
   StringsO,
   Sync;
   
TYPE
   TPConnectionNotifier = POINTER TO CConnectionNotifier;

#save, option( dll_export => on )

(*================================================================================*)

ABSTRACT CLASS IPConnection IMPLEMENTS connection.IBufferedClientConnection;
   LOCAL VAR
      _BStream : IOO.CBufferedStream;
      _NStream : netstream.CNetworkStream;
      _Notifier : TPConnectionNotifier;
      _Socket : netsocket.TPDSocket;

   PUBLIC VIRTUAL PROPERTY
      CallbackMode : IOO.TCallbackMode; // default ioo.cbmPooled
      Notifier : netsocket.TPSocketNotifier;

   PUBLIC VIRTUAL READONLY PROPERTY
      Connected : BOOLEAN;
      LocalAddress : inetaddr.INETADDR;
      RemoteAddress : inetaddr.INETADDR;
      Stream : IOO.TPStream;
      BufferedStream : IOO.TPBufferedStream;
   
   PUBLIC VIRTUAL PROCEDURE Open( Host : ARRAY OF WCHAR; WaitForResult : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
   PUBLIC PROCEDURE OpenS( CONST Host : StringsO.IString; WaitForResult : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Close();

END IPConnection;

(*================================================================================*)

TYPE
   TPTCPConnection = POINTER TO TCPConnection;

CLASS TCPConnection( IPConnection );
END TCPConnection;

(*--------------------------------------------------------------------------------*)

TYPE
   TPUDPConnection = POINTER TO UDPConnection;

CLASS UDPConnection( IPConnection );
END UDPConnection;

(*================================================================================*)

#restore

END rawconnection.