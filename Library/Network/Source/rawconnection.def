DEFINITION MODULE rawconnection;

(*================================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   connection,
   inetaddr,
   IOO,
   netsocket,
   netstream,
   StringsO,
   Sync,
   threadcall;
   
TYPE
   TPConnectionNotifier = POINTER TO CConnectionNotifier;

#save, option( dll_export => on )

(*================================================================================*)

LOCAL CLASS IPConnection;
   INTERNAL VAR
      _BStream : IOO.CBufferedStream;
      _NStream : netstream.CNetworkStream;
      _Notifier : TPConnectionNotifier;
   LOCAL VAR
      _Socket : netsocket.TPDSocket;
END IPConnection;

(*--------------------------------------------------------------------------------*)

LOCAL CLASS ClientIPConnection( IPConnection ) IMPLEMENTS connection.IClientConnection, connection.IAsynchronousConnection, connection.IBufferedConnection;

   // IConnection
   PUBLIC VIRTUAL READONLY PROPERTY
      Connected : BOOLEAN;
      LocalAddress : inetaddr.INETADDR;
      RemoteAddress : inetaddr.INETADDR;
      Stream : IOO.TPStream;

   PUBLIC VIRTUAL PROCEDURE Close();

   // IClientConnection
   PUBLIC VIRTUAL PROCEDURE Open( Host : ARRAY OF WCHAR; DefaultPort : CARDINAL; WaitForResult : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;

   // IAsynchronousConnection   
   PUBLIC VIRTUAL PROPERTY
      Dispatcher : threadcall.TPIThreadProcedureCallDispatcher; // default NIL, which means notifier is called directly from network thread
      Notifier : netsocket.TPSocketNotifier;

   // IBufferedConnection   
   PUBLIC VIRTUAL READONLY PROPERTY
      BufferedStream : IOO.TPBufferedStream;

   // own   
   PUBLIC PROCEDURE OpenS( CONST Host : StringsO.IString; DefaultPort : CARDINAL; WaitForResult : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;

END ClientIPConnection;

(*--------------------------------------------------------------------------------*)

TYPE
   TPClientTCPConnection = POINTER TO ClientTCPConnection;

CLASS ClientTCPConnection( ClientIPConnection );
END ClientTCPConnection;

(*--------------------------------------------------------------------------------*)

TYPE
   TPClientUDPConnection = POINTER TO ClientUDPConnection;

CLASS ClientUDPConnection( ClientIPConnection );
END ClientUDPConnection;

(*================================================================================*)

TYPE
   TPServerTCPConnection = POINTER TO ServerTCPConnection;

LOCAL CLASS ServerTCPConnection( IPConnection ) IMPLEMENTS connection.IServerConnection, connection.IAsynchronousConnection, connection.IBufferedConnection;
   
   // IConnection
   PUBLIC VIRTUAL READONLY PROPERTY
      Connected : BOOLEAN;
      LocalAddress : inetaddr.INETADDR;
      RemoteAddress : inetaddr.INETADDR;
      Stream : IOO.TPStream;

   PUBLIC VIRTUAL PROCEDURE Close();

   // IAsynchronousConnection   
   PUBLIC VIRTUAL PROPERTY
      Dispatcher : threadcall.TPIThreadProcedureCallDispatcher; // default NIL, which means notifier is called directly from network thread
      Notifier : netsocket.TPSocketNotifier;

   // IBufferedConnection   
   PUBLIC VIRTUAL READONLY PROPERTY
      BufferedStream : IOO.TPBufferedStream;

   // own   
   PUBLIC PROCEDURE Accept( CONST ListenSocket : netsocket.TPSSocket; WaitForResult : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult; // WaitForResult, TimeoutMS not implemented yet

END ServerTCPConnection;

(*================================================================================*)

#restore

END rawconnection.