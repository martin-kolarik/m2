DEFINITION MODULE netsrv;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
  netsocket;

#save, option( dll_export => on )

(*================================================================================*)

(*  
  Network server enumeration API
*)

TYPE
   TState = (
      stUnknown,
      stUp,
      stDown
   );
   
   TMedium = (
      medUnknown,
      medLoopback,
      medCSMACD,
      med80211,
      medPPP,
      medTunnel,
      medVLAN,
      medOther
   );
   
   TAssignment = (
      assUnknown,
      assFixed,
      assDynamic
   );
   
ABSTRACT CLASS AInterfaceEnumerator; // if single interface has more addresses, they are enumerated using InetAddress itself
   PUBLIC ABSTRACT PROCEDURE Reset();
   PUBLIC ABSTRACT PROCEDURE MoveNext() : BOOLEAN;
   
   PUBLIC ABSTRACT READONLY PROPERTY
      Index : CARDINAL;
      State : TState;
      Medium : TMedium;
      Addresses : CARDINAL;
      
   PUBLIC ABSTRACT PROCEDURE HWAddress( OUT Address : ARRAY OF BYTE; OUT Filled : CARDINAL );
   PUBLIC ABSTRACT PROCEDURE InetAddress( Index : CARDINAL; OUT Address : netsocket.INETADDR; OUT Preferred : BOOLEAN; OUT Scope : netsocket.TScope; OUT Assignment : TAssignment ) : BOOLEAN;
   
   PUBLIC VIRTUAL FINALLY AInterfaceEnumerator();
END AInterfaceEnumerator;

TYPE
   TPInterfaceEnumerator = POINTER TO AInterfaceEnumerator;

PROCEDURE newInterfaceEnumerator( IPV4 : BOOLEAN; IPV6 : BOOLEAN; OUT Enumerator : TPInterfaceEnumerator ) : BOOLEAN;
  
(*================================================================================*)

(*  
  Network listening (TCP) / server receiving (UDP) API.
  It creates self in main thread unless SetCallbackMode( cbmPooled ) procedure is called.
  Using main thread means AStreamCreator calls are dispatched to the main thread where they can be processed synchronously.
*)
  
(*================================================================================*)

TYPE
  TPListener = POINTER TO AListener;

ABSTRACT CLASS AListener( Delegate.ADelegate );
  LOCAL VIRTUAL PROCEDURE OnListen( CONST ServerSocket : netsocket.TPSSocket ); // stStream
  LOCAL VIRTUAL PROCEDURE OnDatagramReceived( CONST ServerSocket : netsocket.TPSSocket ); // stDatagram
  LOCAL VIRTUAL PROCEDURE OnListenSocketClosed( CONST ServerSocket : netsocket.TPSSocket ); // both types
END AListener;

(*================================================================================*)

TYPE
  TCallbackMode = (
    cbmPooled,
    cbmMainThread,
    cbmDefault = cbmMainThread
  );

PROCEDURE SetCallbackMode(
            Mode : TCallbackMode
          );

PROCEDURE StartListen(
            Type : netsocket.TSocketType;
            CONST LocalAddress : netsocket.INETADDR; // can be empty (an ephemeral port is used), can contain port only, can be multicast
            PStreamCreator : TPListener;
            AutomaticCloseTimeMS : CARDINAL;	// can be 0 or INFINITE for INFINITE time
            PCreatedSocket : POINTER TO netsocket.TPSSocket // can be NIL
          ) : CARDINAL;

PROCEDURE StopListenPort(
            Type : netsocket.TSocketType;
            Port : CARDINAL
			);

PROCEDURE StopListenSocket(
				REF Socket : netsocket.TPSSocket
			 );

#restore

(*================================================================================*)

PROCEDURE Cleanup();

(*================================================================================*)

END netsrv.