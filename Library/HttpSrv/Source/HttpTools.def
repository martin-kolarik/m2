DEFINITION MODULE HttpTools;

IMPORT
   HttpCommon,
   Languages,
   lists,
   StringsO,
   time;

(*===========================================================================*)

#save, option( dll_export => on )

TYPE
   TContent = (
      contentUnknown,
      contentApplicationBinary, // default, application/octet-stream
      contentDefault = contentApplicationBinary,

      contentTextPlain,
      contentTextHTML,
      contentTextXHTML,
      contentTextXML,
      contentTextCSS,
      contentTextCSV,
      contentApplicationJS
   );
   
   TContentSet = SET OF TContent;
   
CONST
   ENCODING_SENSITIVE_CONTENT = TContentSet{ contentTextPlain, contentTextHTML, contentTextCSS, contentTextCSV, contentApplicationJS };
   TAGGED_CONTENT = TContentSet{ contentTextHTML, contentTextXHTML, contentTextXML };
   
CONST
   CONTENT_TYPE_TEXT   = L"text/plain";
   CONTENT_TYPE_HTML   = L"text/html";
   CONTENT_TYPE_XHTML  = L"application/xhtml+xml";
   CONTENT_TYPE_XML    = L"text/xml";
   CONTENT_TYPE_CSS    = L"text/css";
   CONTENT_TYPE_CSV    = L"text/csv";
   CONTENT_TYPE_JS     = L"application/javascript";
   CONTENT_TYPE_BINARY = L"application/octet-stream";
   
   CHARSET_PREFIX      = L"charset"; // a part of 'text/html; charset=<charset>'

// if Content = contentUnknown then FileName is used, otherwise not
// if Fallback = FALSE then FALSE is returned when mime type cannot be determined. Fallback MIME is application/octet-stream
PROCEDURE FormatContent( Content : TContent; CONST FileName, RFC1766Code : StringsO.IString; Fallback : BOOLEAN; OUT ContentHeader : StringsO.IString ) : BOOLEAN;
PROCEDURE FormatContentOA( Content : TContent; CONST FileName, RFC1766Code : ARRAY OF WCHAR; Fallback : BOOLEAN; OUT ContentHeader : StringsO.IString ) : BOOLEAN;
PROCEDURE DecodeContent( CONST ContentHeader : StringsO.IString; OUT Content : TContent; OUT RFC1766Code : StringsO.IString ) : BOOLEAN;
PROCEDURE DecodeContentOA( CONST ContentHeader : ARRAY OF WCHAR; OUT Content : TContent; OUT RFC1766Code : ARRAY OF WCHAR ) : BOOLEAN;

(*---------------------------------------------------------------------------*)

PROCEDURE DecodeLanguage( CONST AcceptLanguageHeader : StringsO.IString; OUT language : Languages.TLanguage ) : BOOLEAN;

#restore

(*===========================================================================*)

PROCEDURE FormatDate( CONST Date : time.DateTime ) : StringsO.CString;
PROCEDURE FormatDateJD( Date : time.TJD ) : StringsO.CString;
PROCEDURE DecodeDate( CONST Encoded : StringsO.IString; OUT Date : time.DateTime ) : BOOLEAN;
PROCEDURE DecodeDateJD( CONST Encoded : StringsO.IString; OUT Date : time.TJD ) : BOOLEAN;

(*---------------------------------------------------------------------------*)

PROCEDURE FormatSIDCookie( CONST SID : StringsO.IString; CONST Expires : time.DateTime; CONST Path, Domain : StringsO.IString ) : StringsO.CString;
PROCEDURE DecodeSIDCookie( CONST Cookies : StringsO.IString; OUT SID : StringsO.IString ) : BOOLEAN;

(*---------------------------------------------------------------------------*)

PROCEDURE DecodeURLEncoding( XFormFlag : BOOLEAN; CONST Encoded : ARRAY OF BYTE; OUT Decoded : lists.CStringStringList );

(*===========================================================================*)

TYPE
   TRedirect = (
      redirectUnknown,
      redirectTemporarily,
      redirectPermanently
   );

PROCEDURE GetRedirectCode( Redirect : TRedirect; HTTP10Flag : BOOLEAN ) : HttpCommon.THttpResponse;

(*===========================================================================*)

END HttpTools.