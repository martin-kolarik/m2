DEFINITION MODULE HttpConnection;

(*================================================================================*)

IMPORT
   connection,
   HttpCommon,
   StringsO,
   time;
   
(*================================================================================*)

TYPE
   TPHttpSrvConnection = POINTER TO IHttpSrvConnection;

INTERFACE IHttpSrvConnection( connection.IServerConnection );

   READONLY PROPERTY
      FullURI : StringsO.CString; // absolute URI with protocol and host
      AbsoluteURI : StringsO.CString; // absolute URI, can contain "undistinguishable" prefixes
      URIData : StringsO.CString; // query data

      RequestHeaders : HttpCommon.TPHttpHeaders;
      RequestVerb : HttpCommon.TVerb;
      RequestURI : StringsO.CString; // relative to server's root, if any
      ResponseHeaders : HttpCommon.TPHttpHeaders;

   PROPERTY
      StatusCode : HttpCommon.THttpResponse;
      OverrideStatusResponse : BOOLEAN; // if set then server will not emit self error page and will use data filled by client to the connection. Default = FALSE (use default responses).
      Chunked : BOOLEAN; // set if you want to chunk
      ResponseLength : CARD64; // set if you know it and you do not want to chunk
      AllowCaching : BOOLEAN;
      LastModified : time.DateTime;

END IHttpSrvConnection;

(*================================================================================*)

END HttpConnection.