DEFINITION MODULE HttpSrv;

(*================================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   IOO,
   HttpCommon,
   HttpConnection,
   maps,
   StringsO,
   Sync;

(*================================================================================*)

#save, option( dll_export => on )

TYPE
   TPSession = POINTER TO ISession;
   
(*--------------------------------------------------------------------------------*)

INTERFACE ISession;
   READONLY PROPERTY
      SID : StringsO.CString;

   PROCEDURE Invalidate();
   
   PROCEDURE Add( CONST Key : ARRAY OF WCHAR; Data : PTR );
   PROCEDURE Remove( CONST Key : ARRAY OF WCHAR );
   PROCEDURE Contains( CONST Key : ARRAY OF WCHAR ) : BOOLEAN;
   PROCEDURE Get( CONST Key : ARRAY OF WCHAR; OUT Data : PTR ) : BOOLEAN;
END ISession;

(*--------------------------------------------------------------------------------*)

TYPE
   TPHttpProcessor = POINTER TO IHttpProcessor;

INTERFACE IHttpProcessor;
   PROCEDURE AppliesFor( Verb : HttpCommon.TVerb; CONST URL : ARRAY OF WCHAR; OUT WantsSession : BOOLEAN ) : BOOLEAN;
   PROCEDURE ProcessRequest( Connection : HttpConnection.TPHttpSrvConnection; CONST Session : TPSession );
   PROCEDURE SessionExpired( CONST Session : TPSession );
END IHttpProcessor;

(*--------------------------------------------------------------------------------*)

TYPE
   TMode = (
      mdHttp,
      mdHttps,
      mdBoth
   );

(*--------------------------------------------------------------------------------*)

TYPE
   TPHttpServer = POINTER TO IHttpServer;

INTERFACE IHttpServer;
   READONLY PROPERTY
      Running : BOOLEAN;
   PROPERTY
      Mode : TMode; // default is smHttp
      Port : CARDINAL; // default is 8080
      SslPort : CARDINAL; // default is 8443
      RootPath : StringsO.CString;

   PROCEDURE Start() : Sync.TAsyncResult;
   PROCEDURE Stop();
   
   PROCEDURE RegisterProcessor( Processor : TPHttpProcessor );
   PROCEDURE ForgetProcessor( Processor : TPHttpProcessor );
END IHttpServer;

(*================================================================================*)

PROCEDURE srv() : TPHttpServer;
PROCEDURE Cleanup();

#restore

(*================================================================================*)

END HttpSrv.