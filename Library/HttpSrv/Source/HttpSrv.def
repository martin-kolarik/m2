DEFINITION MODULE HttpSrv;

//================================================================================

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   httpapi,
   IOO,
   maps,
   StringsO,
   Sync;

//================================================================================

TYPE
   TPSession = POINTER TO ISession;
   TPContainer = POINTER TO CContainer; // model container
   TPController = POINTER TO IController;
   TPHttpServer = POINTER TO IHttpServer;
   TPView = POINTER TO IView;
   
//================================================================================

TYPE
   TPHttpHeaders = POINTER TO IHttpHeaders;
   TPHttpRequest = POINTER TO IHttpRequest;
   
//--------------------------------------------------------------------------------

TYPE
   TKnownHeader = (
      Unknown,
   
      // Common Headers
      CacheControl,
      Connection,
      Date,
      KeepAlive,
      Pragma,
      Trailer,
      TransferEncoding,
      Upgrade,
      Via,
      Warning,

      Allow,
      ContentLength,
      ContentType,
      ContentEncoding,
      ContentLanguage,
      ContentLocation,
      ContentMd5,
      ContentRange,
      Expires,
      LastModified,
      
      // Request Headers
      Accept,
      AcceptCharset,
      AcceptEncoding,
      AcceptLanguage,
      Authorization,
      Cookie,
      Expect,
      From,
      Host,
      IfMatch,

      IfModifiedSince,
      IfNoneMatch,
      IfRange,
      IfUnmodifiedSince,
      MaxForwards,
      ProxyAuthorization,
      Referer,
      Range,
      Te,
      Translate,

      UserAgent,

      // Response Headers
      AcceptRanges,
      Age,
      Etag,
      Location,
      ProxyAuthenticate,
      RetryAfter,
      Server,
      SetCookie,
      Vary,
      WwwAuthenticate
   );
   
   TVerb = (
      verbUnknown,
      verbGET,
      verbPOST,
      verbHEAD
   );

//--------------------------------------------------------------------------------

INTERFACE IHttpHeaders;
   PROCEDURE Contains( Header : TKnownHeader ) : BOOLEAN;
   PROCEDURE Get( Header : TKnownHeader; OUT Value : StringsO.IString ) : BOOLEAN;
   PROCEDURE GetOA( Header : TKnownHeader; OUT Value : ARRAY OF WCHAR ) : BOOLEAN;
   PROCEDURE Add( Header : TKnownHeader; CONST Value : StringsO.IString );
   PROCEDURE AddOA( Header : TKnownHeader; CONST Value : ARRAY OF WCHAR );
   
   PROCEDURE Enumerate( Known, Uknown : BOOLEAN; REF ES : PTR; OUT Name, Value : StringsO.IString ) : BOOLEAN;

   PROCEDURE ContainsUnknown( CONST Name : ARRAY OF WCHAR ) : BOOLEAN;
   PROCEDURE GetUnknown( CONST Name : ARRAY OF WCHAR; OUT Value : StringsO.IString ) : BOOLEAN;
   PROCEDURE AddUnknown( CONST Name : ARRAY OF WCHAR; CONST Value : StringsO.IString );
END IHttpHeaders;

//--------------------------------------------------------------------------------

INTERFACE IHttpRequest;
   READONLY PROPERTY
      Headers : TPHttpHeaders;
      Container : TPContainer; // there is model named "" and model named "session"
      Session : TPSession;
END IHttpRequest;

//--------------------------------------------------------------------------------

INTERFACE ISession;
   READONLY PROPERTY
      Data : maps.TPStringMap; // the same as Container["session"]
      SID : StringsO.CString;
   PROCEDURE Invalidate();
END ISession;

//================================================================================

CLASS CContainer;
   PRIVATE VAR
      Models : maps.CStringMap;

   PUBLIC PROCEDURE Clear();

   PUBLIC PROCEDURE AddModel( CONST Name : ARRAY OF WCHAR; REF Model : maps.CStringStringMap );
   PUBLIC PROCEDURE RemoveModel( CONST Name : ARRAY OF WCHAR );

   PUBLIC PROCEDURE GetModelOA( CONST Name : ARRAY OF WCHAR; OUT PModel : maps.TPStringStringMap ) : BOOLEAN;
   PUBLIC PROCEDURE GetModel( CONST Name : StringsO.CString; OUT PModel : maps.TPStringStringMap ) : BOOLEAN;
END CContainer;
   
//--------------------------------------------------------------------------------

INTERFACE IView;
   PROPERTY
      Container : TPContainer;
   PROCEDURE Format() : BOOLEAN;
END IView;

//--------------------------------------------------------------------------------

INTERFACE IController;
   PROCEDURE AppliesFor( Verb : TVerb; CONST URL : ARRAY OF WCHAR ) : BOOLEAN;
   PROCEDURE ProcessRequest( CONST Request : TPHttpRequest; CONST Container : TPContainer; OUT View : TPView ) : BOOLEAN;
END IController;

//--------------------------------------------------------------------------------

TYPE
   TMode = (
      mdHttp,
      mdHttps,
      mdBoth
   );

INTERFACE IHttpServer;
   READONLY PROPERTY
      Running : BOOLEAN;
   PROPERTY
      Mode : TMode; // default is smHttp
      Port : CARDINAL; // default is 8080
      SslPort : CARDINAL; // default is 8443
      RootPath : StringsO.CString;

   PROCEDURE Start() : Sync.TAsyncResult;
   PROCEDURE Stop();
   
   PROCEDURE RegisterController( Controller : TPController );
   PROCEDURE ForgetController( Controller : TPController );
END IHttpServer;

//================================================================================

PROCEDURE srv() : TPHttpServer;
PROCEDURE Cleanup();

//--------------------------------------------------------------------------------

PROCEDURE fileView( CONST Path : ARRAY OF WCHAR ) : TPView;
PROCEDURE redirectView( CONST URL : ARRAY OF WCHAR ) : TPView;
PROCEDURE modelView( CONST viewName : ARRAY OF WCHAR; REF model : maps.CStringStringMap ) : TPView;
PROCEDURE modelViewStream( CONST viewName : ARRAY OF WCHAR; viewSource : IOO.TPStream; REF model : maps.CStringStringMap ) : TPView;
PROCEDURE modelViewContainer( CONST viewName : ARRAY OF WCHAR; REF model : ARRAY OF maps.CStringStringMap ) : TPView;
PROCEDURE modelViewContainerStream( CONST viewName : ARRAY OF WCHAR; viewSource : IOO.TPStream; REF model : ARRAY OF maps.CStringStringMap ) : TPView;

//================================================================================

END HttpSrv.