DEFINITION MODULE MVC;

//================================================================================

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   IOO,
   HttpCommon,
   HttpSrv,
   maps,
   StringsO,
   Sync;

//================================================================================

TYPE
   TPHttpRequest = POINTER TO IHttpRequest;
   TPView = POINTER TO IView;
   TPController = POINTER TO IController;
   
//--------------------------------------------------------------------------------

INTERFACE IHttpRequest;
   READONLY PROPERTY
      RequestHeaders : HttpCommon.TPHttpHeaders;
      ResponseHeaders : HttpCommon.TPHttpHeaders;
      Container : HttpSrv.TPContainer; // there is model named "" and model named "session"
      Session : HttpSrv.TPSession;
END IHttpRequest;

//--------------------------------------------------------------------------------

INTERFACE IView;
   PROPERTY
      Container : HttpSrv.TPContainer;
   PROCEDURE Format() : BOOLEAN;
END IView;

//--------------------------------------------------------------------------------

INTERFACE IController;
   PROCEDURE AppliesFor( Verb : HttpCommon.TVerb; CONST URL : ARRAY OF WCHAR ) : BOOLEAN;
   PROCEDURE ProcessRequest( CONST Request : TPHttpRequest; CONST Container : TPContainer; OUT View : TPView ) : BOOLEAN;
END IController;

//================================================================================

PROCEDURE mvc( CONST Context : ARRAY OF WCHAR ) : TPController; // it is usual to have Context = Application, so typically server will call mvc only single times.
                                                                // More calls to get the same context returns the same pointer.
PROCEDURE Cleanup();

//================================================================================

PROCEDURE fileView( CONST Path : ARRAY OF WCHAR ) : TPView;
PROCEDURE redirectView( CONST URL : ARRAY OF WCHAR ) : TPView;
PROCEDURE modelView( CONST viewName : ARRAY OF WCHAR; REF model : maps.CStringStringMap ) : TPView;
PROCEDURE modelViewStream( CONST viewName : ARRAY OF WCHAR; viewSource : IOO.TPStream; REF model : maps.CStringStringMap ) : TPView;
PROCEDURE modelViewContainer( CONST viewName : ARRAY OF WCHAR; REF model : ARRAY OF maps.CStringStringMap ) : TPView;
PROCEDURE modelViewContainerStream( CONST viewName : ARRAY OF WCHAR; viewSource : IOO.TPStream; REF model : ARRAY OF maps.CStringStringMap ) : TPView;

//================================================================================

END MVC.