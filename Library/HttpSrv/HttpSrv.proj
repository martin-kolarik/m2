<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ProjectDescription>HTTP Server / MVC Controller</ProjectDescription>
        <ProjectVersionMajor>0</ProjectVersionMajor>
        <ProjectVersionMinor>9</ProjectVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib;API\win32;API\httpapi"/>
        <Components Include="Component\sccore;Library\MIME"/>
        <Modules Include="httpcommon;httpconnection;httptools;srvcommon;srvhttpapi;httpsrv"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
