<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <FileDescription>HTTP Server / MVC Controller</FileDescription>
        <FileVersionMajor>0</FileVersionMajor>
        <FileVersionMinor>9</FileVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="modula2\modula2;api\clib;API\win32;API\httpapi"/>
        <Components Include="component\sccore"/>
        <Modules Include="httptools;httpsrv"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
