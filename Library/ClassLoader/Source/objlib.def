DEFINITION MODULE objlib;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   StringsO;

(*===========================================================================*)

TYPE
   TPLibrary = POINTER TO ILibrary;
   TPObject = POINTER TO IObject;

(*---------------------------------------------------------------------------*)

TYPE
   TResult = (
      lrSuccess,
      lrLibraryNotFound,
      lrLibraryFoundButIsUnloadable,
      lrLibraryDisabled,
      lrClassNotFound
   );
   
TYPE
   #save, call( convention => cdecl )
   TFactory = PROCEDURE( CONST ARRAY OF WCHAR, OUT TPObject ) : TResult;
   #restore

(*===========================================================================*)

TYPE
   TObjectType = (
      otSingleton,
      otEphemeral
   );
   
INTERFACE IObject;
   READONLY PROPERTY
      Type : TObjectType;
   PROPERTY
      Library : TPLibrary;
   PROCEDURE Dispose();
END IObject;

(*---------------------------------------------------------------------------*)

CONST
   nLibrary = L"Library";
   
TYPE
   TcllvData = RECORD
      Length    : CARDINAL;
      Data      : ADDRESS;
      Validator : ADDRESS;
   END; // RECORD

INTERFACE ILibrary( IObject );
   READONLY PROPERTY
      Loader : ADDRESS;
      LoaderLibraryHandle : PTR;

   PROCEDURE HostInfo( Loader : ADDRESS; LoaderLibraryHandle : PTR; CONST Host, HostVersionString : ARRAY OF WCHAR ); // usually product id/product version

   PROCEDURE LibraryInfo( OUT Library, LibraryVersionString : ARRAY OF WCHAR ); // usually product id/product version
   PROCEDURE EnumerateClasses( REF EnumerateState : PTR; OUT ClassName : ARRAY OF WCHAR ) : BOOLEAN;
   PROCEDURE GetLECData( OUT cllvData : TcllvData; OUT cllvPath : ARRAY OF WCHAR ) : BOOLEAN;
END ILibrary;

(*===========================================================================*)

// prepared classes to simplify implementation
ABSTRACT CLASS AObject IMPLEMENTS IObject;
   PRIVATE VAR
      _Library : TPLibrary;
   PUBLIC VIRTUAL PROPERTY
      Library : TPLibrary;
   PUBLIC VIRTUAL PROCEDURE Dispose(); // aka destructor
END AObject;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS ACreator( AObject ) IMPLEMENTS ILibrary;
   
   // IObject/ILibrary
   PUBLIC VIRTUAL READONLY PROPERTY
      Type : TObjectType;
   PUBLIC FINAL PROPERTY
      Library : TPLibrary;
   PUBLIC FINAL PROCEDURE Dispose();

   LOCAL VAR
      _Loader : ADDRESS;
      _LoaderLibraryHandle : PTR;
      _Host : StringsO.CString;
      _HostVersion : StringsO.CString;
   PUBLIC FINAL READONLY PROPERTY
      Loader : ADDRESS;
      LoaderLibraryHandle : PTR;
   PUBLIC FINAL PROCEDURE HostInfo( Loader : ADDRESS; LoaderLibraryHandle : PTR; CONST Host, HostVersionString : ARRAY OF WCHAR ); // usually product id/product version

   // ACreator
   ABSTRACT PROCEDURE OnFactory( CONST QName : ARRAY OF WCHAR; OUT Object : TPObject ) : TResult;

   // library caller -- use from procedure GetObject
   PUBLIC PROCEDURE Factory( CONST QName : ARRAY OF WCHAR; OUT Object : TPObject ) : TResult;

END ACreator;

(*===========================================================================*)

END objlib.