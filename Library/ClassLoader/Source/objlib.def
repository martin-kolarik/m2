DEFINITION MODULE objlib;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;
   
IMPORT
   StringsO;

(*===========================================================================*)

TYPE
   TPLoader = POINTER TO ILoader;
   TPLibrary = POINTER TO ILibrary;
   TPObject = POINTER TO IObject;

INTERFACE ILoader;
   LOCAL PROCEDURE ReleaseObject( LibraryHandle : PTR; Object : TPObject );
END ILoader;

(*---------------------------------------------------------------------------*)

TYPE
   TResult = (
      lrSuccess,
      lrLibraryNotFound,
      lrLibraryFoundButIsUnloadable,
      lrLibraryDisabled,
      lrClassNotFound
   );
   
TYPE
   #save, call( convention => cdecl )
   TGetObject = PROCEDURE( CONST ARRAY OF WCHAR, OUT TPObject ) : TResult;
   #restore

(*===========================================================================*)

TYPE
   TObjectType = (
      otSingleton,
      otEphemeral
   );
   
INTERFACE IObject;
   PUBLIC READONLY PROPERTY
      Type : TObjectType;
   PUBLIC WRITEONLY PROPERTY
      Library : TPLibrary;
   PUBLIC PROCEDURE Release();
END IObject;

(*---------------------------------------------------------------------------*)

CONST
   nLibrary = L"Library";
   
TYPE
   TcllvData = RECORD
      Length    : CARDINAL;
      Data      : ADDRESS;
      Validator : ADDRESS;
   END; // RECORD

INTERFACE ILibrary( IObject );
   PROPERTY
      Loader : TPLoader;
      LibraryHandle : PTR;

   PROCEDURE Version( OUT VersionString : ARRAY OF WCHAR );
   PROCEDURE HostInfo( CONST Host, HostVersionString : ARRAY OF WCHAR ); // usually product id/product version

   PROCEDURE EnumerateClasses( REF EnumerateState : PTR; OUT ClassName : ARRAY OF WCHAR ) : BOOLEAN;

   PROCEDURE GetLECData( OUT cllvData : TcllvData; OUT cllvPath : ARRAY OF WCHAR ) : BOOLEAN;
END ILibrary;

(*===========================================================================*)

// prepared classes to simplify implementation
ABSTRACT CLASS AObject IMPLEMENTS IObject;
   PRIVATE VAR
      _Library : TPLibrary;
   PUBLIC VIRTUAL WRITEONLY PROPERTY
      Library : TPLibrary;
   PUBLIC VIRTUAL PROCEDURE Release();
END AObject;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS ACreator( AObject ) IMPLEMENTS ILibrary;
   
   // IObject/ILibrary
   PUBLIC VIRTUAL READONLY PROPERTY
      Type : TObjectType;
   PUBLIC FINAL WRITEONLY PROPERTY
      Library : TPLibrary;
   PUBLIC FINAL PROCEDURE Release();

   LOCAL VAR
      _Loader : TPLoader;
      _Handle : PTR;
   PUBLIC FINAL PROPERTY
      Loader : TPLoader;
      LibraryHandle : PTR;

   LOCAL VAR
      _Host : StringsO.CString;
      _HostVersion : StringsO.CString;
   PUBLIC FINAL PROCEDURE HostInfo( CONST Host, HostVersionString : ARRAY OF WCHAR ); // usually product id/product version

   // ACreator
   ABSTRACT PROCEDURE OnGetObject( CONST QName : ARRAY OF WCHAR; OUT Object : TPObject ) : TResult;

   // library caller -- use from procedure GetObject
   PUBLIC PROCEDURE GetObject( CONST QName : ARRAY OF WCHAR; OUT Object : TPObject ) : TResult;

END ACreator;

(*===========================================================================*)

END objlib.