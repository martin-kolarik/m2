DEFINITION MODULE Event;

IMPORT
   Rtti,
   synclists;
  
#save, option( dll_export => on )

(*================================================================================*)

ABSTRACT CLASS AEvent; // meant to be used: "CLASS EventSource( EVENT ) IMPLEMENTS ISink..."

   // client
   PUBLIC READONLY PROPERTY
      Empty : BOOLEAN;
   PUBLIC PROPERTY
      SinkType : Rtti.CLASSTYPE;

   PUBLIC PROCEDURE Subscribe( Listener : ADDRESS ); // TODO: shall be OBJECT
   PUBLIC PROCEDURE Unsubscribe( Listener : ADDRESS ); // TODO: shall be OBJECT
   
   PUBLIC VIRTUAL Dispose();
   PUBLIC VIRTUAL FINALLY AEvent();

   // for implementors
   INTERNAL PROCEDURE UnsubscribeAll();
   INTERNAL PROCEDURE Reset();
   INTERNAL PROCEDURE MoveNext() : BOOLEAN;
   INTERNAL READONLY PROPERTY
      Listener : ADDRESS;

   // self
   PRIVATE VAR
      _Listeners : synclists.CPtrSyncList;
      _SinkType : Rtti.CLASSTYPE := NIL;

END AEvent;

(*================================================================================*)

#restore

END Event.