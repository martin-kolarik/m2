<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType>External</ComponentType>
        
        <ProjectDescription>COM Low Level Handling</ProjectDescription>
        <ProjectVersionMajor>0</ProjectVersionMajor>
        <ProjectVersionMinor>9</ProjectVersionMinor>

        <Result>Dynamic</Result>

        <ProductM2Control>-DSYNC_COMM:off</ProductM2Control>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPOMENT DEFINITION -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib;API\win32">
            <!-- Parameters>Static</Parameters --><!-- optional, here it has high priority than CLib -->
        </Components>
        <Components Include="Component\sccore;Library\SerialLink"/>
        <Modules Include="btools;comm_;comm"/>
    </ItemGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
