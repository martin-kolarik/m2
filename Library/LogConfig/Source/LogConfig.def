DEFINITION MODULE LogConfig;

IMPORT
   iLog,
   INIFile,
   LogFilter;

#save, option( dll_export => on )

(*================================================================================*)

TYPE
   TConfigureLogResult = (
      clrSuccess,
      clrUnknownSection,
      clrKeyAlreadyKnown,
      clrUnknownTarget,
      clrUnknownLevel,
      clrTargetFileMissingFile,
      clrBadAllowedBits,
      clrBadCachedNumber,
      clfrUnknownPolicy,
      clfrMissingPattern
   );

PROCEDURE ConfigureLog( CONST ini : INIFile.CINIFile; CONST SectionName : ARRAY OF WCHAR; REF logger : iLog.IAppender; REF createdAppenderList : lists.CPtrPtrList; OUT errorLine : CARDINAL ) : TConfigureLogResult;
  // if SectionName is empty, default "log" section name is used
  // configures all known log.* classes
  
PROCEDURE DisposeAppenderList( REF appenderList : lists.CPtrPtrList ); // to clear list returned by ConfigureLog

(*--------------------------------------------------------------------------------*)

PROCEDURE ConfigureLogFilter( CONST ini : INIFile.CINIFile; CONST SectionName : ARRAY OF WCHAR; REF filter : LogFilter.CLogFilter; OUT errorLine : CARDINAL ) : TConfigureLogResult;
  // if SectionName is empty, default "log" section name is used

(*================================================================================*)

#restore

END LogConfig.
