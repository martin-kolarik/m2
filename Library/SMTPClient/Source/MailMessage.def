DEFINITION MODULE Message;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   datetime,
   IOO,
   lists,
   StringsO;

(*================================================================================*)

TYPE
   TPriority = (
      PriorityNormal,
      PriorityLow,
      PriorityHigh
   );

(*================================================================================*)

TYPE
   TPPersons = POINTER TO IPersons;
   TPMailMessage = POINTER TO IMailMessage;

CLASS Person;

   PUBLIC VAR
      Address : StringsO.CString;
      Name : StringsO.CString;

   PUBLIC OPERATOR :=( CONST Source : Person );

END Person;

(*--------------------------------------------------------------------------------*)

INTERFACE IPersons;

   // additions
   PROCEDURE Add( CONST New : Person );
   PROCEDURE AddS( CONST Name, Address : StringsO.IString );
   PROCEDURE Dispose();

   // enumeration
   PROPERTY
      Current : Person;
   PROCEDURE Reset();
   PROCEDURE MoveNext() : BOOLEAN;

END IPersons;

(*--------------------------------------------------------------------------------*)

INTERFACE IMailMessage;

   PROPERTY
      Created : datetime.DateTime;
      Sender : Person;
      ReplyTo : Person; // until set, it shares the value with Sender
      Recipient : Person; // for fast access to single recipient
      Priority : TPriority;
      Subject : StringsO.CString;

   READONLY PROPERTY
      Recipients : TPPersons;
      CCs : TPPersons;
      BCCs : TPPersons;
      Message : IOO.TPStream;
      Attachments : lists.TPStringList; // list of paths

END IMailMessage;

(*================================================================================*)

PROCEDURE New( OUT Message : TPMessage ) : BOOLEAN;
PROCEDURE Dispose( REF Message : TPMessage );

(*================================================================================*)

END MailMessage.