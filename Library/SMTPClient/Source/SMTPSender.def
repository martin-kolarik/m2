DEFINITION MODULE SMTPSender;

IMPORT
   MailMessage,
   Sync,
   threadcall;

(*================================================================================*)

TYPE
   TPNotifier = POINTER TO INotifier;
   TPSender = POINTER TO ISender;

INTERFACE INotifier;

   PROCEDURE OnCompletion( Result : Sync.TAsyncResult; SourceSpecificError : LONGWORD; CONST message : MailMessage.TPMailMessage );

END INotifier;

(*--------------------------------------------------------------------------------*)

INTERFACE ISender;

   // notification
   PROPERTY
      Dispatcher : threadcall.TPIThreadProcedureCallDispatcher; // default NIL, which means notifier is called directly from network thread
      Notifier : TPNotifier;

   // send
   PROCEDURE Send( CONST message : MailMessage.TPMailMessage; takeOwnership : BOOLEAN ) : Sync.TAsyncResult; // synchronous for lightWeight, asynchronous for not lightWeight, arCannotStart means message is incorrect

   // configuration
   PROPERTY
      Server : StringsO.CString; // host:port format
      Mailer : StringsO.CString; // can be empty
      Login : StringsO.CString; // can be empty 
      Password : StringsO.CString; // can be empty
      TimeToLive : CARDINAL; // seconds, the message will stay in the queue for the time; maximal time is year (3*10E7), default is 2 days
      GenerateMessageId : BOOLEAN; // if set, each message will be given own message id; otherwise the header will not be generated
      
END ISender;

(*================================================================================*)

PROCEDURE New( OUT sender : TPSender; lightWeight : BOOLEAN ) : BOOLEAN; // for lightWeight, synchronous not threaded ISender is created, otherwise timeouting, queued and threaded ISender is used
PROCEDURE Dispose( REF sender : TPSender );

(*================================================================================*)

END SMTPSender.