DEFINITION MODULE msgqueue;

IMPORT
  msghandler,
  Sync,
  SyncQueue;

#save, option( dll_export => on )

CONST
  TPMessageRecipient ::= msghandler.TPMessageRecipient;

TYPE
  TPMessageQueue = POINTER TO CMessageQueue;

CONST
  WM_MQ_PROCESS = 4096;

CLASS CMessageQueue( SyncQueue.CDatagramQueue );
   // class dedicated for N to 1 receiving, blocking is usually consumer, so main control is from consumer side and it is
   // done using msghandler.Message. The CLASS FULLY HIDES Flush/Signal semantics offered byt ANCESTOR, the class
   // cannot be degraded to CDatagramQueue (= Consumer MUST NOT be NIL).
   PRIVATE VAR
      LeaveLock   : CARDINAL;
      Msg         : POINTER TO msghandler.Message;
   PUBLIC VAR
      Consumer    : TPMessageRecipient;
   PUBLIC PROPERTY
      ConsumerMsg : POINTER TO msghandler.Message; // if NIL then default WM_MQ_PROCESS is used

  INTERNAL VIRTUAL PROCEDURE Flush() : Sync.TAsyncResult; // completed, timeout, aborted
  INTERNAL VIRTUAL PROCEDURE Signal( What : Sync.TpcqSignal ); // when produced, next producing SHOULD NOT be done (until signalling consumed)
END CMessageQueue;

#restore

END msgqueue.