DEFINITION MODULE View;

(*================================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   FSO,
   IOO,
   lists,
   MVC,
   StorageO,
   StringsO,
   xmlreader,
   xmlwriter;

(*================================================================================*)

TYPE
   TPFileView = POINTER TO CFileView;

CLASS CFileView IMPLEMENTS MVC.IView;
   // IView
   PUBLIC VIRTUAL READONLY PROPERTY
      OutputType : MVC.TViewOutputType;
   PUBLIC VIRTUAL PROCEDURE FormatToBuffer( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OUT Output : StorageO.CMemoryBuffer ) : BOOLEAN; // returning false means 500 response, Output is empty on input
   PUBLIC VIRTUAL PROCEDURE FormatToInputStream( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OUT InputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response, Stream MUST be DISPOSED after usage
   PUBLIC VIRTUAL PROCEDURE FormatToOutputStream( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OutputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // SELF
   PUBLIC PROCEDURE Init( CONST Resolver : FSO.TPFilePathResolver; CONST PathRelativeToContext : ARRAY OF WCHAR );   
   
   PRIVATE VAR
      Resolver : FSO.TPFilePathResolver;
      PathRelativeToContext : StringsO.CString;
END CFileView;

(*--------------------------------------------------------------------------------*)

TYPE
   TPRedirectView = POINTER TO CRedirectView;

CLASS CRedirectView IMPLEMENTS MVC.IView;
   // IView
   PUBLIC VIRTUAL READONLY PROPERTY
      OutputType : MVC.TViewOutputType;
   PUBLIC VIRTUAL PROCEDURE FormatToBuffer( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OUT Output : StorageO.CMemoryBuffer ) : BOOLEAN; // returning false means 500 response, Output is empty on input
   PUBLIC VIRTUAL PROCEDURE FormatToInputStream( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OUT InputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response, Stream MUST be DISPOSED after usage
   PUBLIC VIRTUAL PROCEDURE FormatToOutputStream( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OutputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // SELF
   PUBLIC PROCEDURE Init( CONST URIIsAbsolute : BOOLEAN; URIOrControllerName : ARRAY OF WCHAR );   
   
   PRIVATE VAR
      AbsoluteFlag : BOOLEAN;
      URIOrControllerName : StringsO.CString;
END CRedirectView;

(*--------------------------------------------------------------------------------*)

TYPE
   TPRawHTMLView = POINTER TO CRawHTMLView;

CLASS CRawHTMLView IMPLEMENTS MVC.IView;
   // IView
   PUBLIC VIRTUAL READONLY PROPERTY
      OutputType : MVC.TViewOutputType;
   PUBLIC VIRTUAL PROCEDURE FormatToBuffer( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OUT Output : StorageO.CMemoryBuffer ) : BOOLEAN; // returning false means 500 response, Output is empty on input
   PUBLIC VIRTUAL PROCEDURE FormatToInputStream( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OUT InputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response, Stream MUST be DISPOSED after usage
   PUBLIC VIRTUAL PROCEDURE FormatToOutputStream( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OutputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // SELF
   PUBLIC PROCEDURE Init( CONST HTML : ARRAY OF WCHAR );   
   
   PRIVATE VAR
      HTML : StringsO.CString;
END CRawHTMLView;

(*--------------------------------------------------------------------------------*)

TYPE
   TElementStartAction = (
      esaError,
      esaProcessedInDeep,
      esaProcessedHeader,
      esaUnprocessedPT
   );
   
   TWhere = (
      whInForm,
      whInInput,
      whInSelect,
      whInOption      
   );

TYPE
   TPPageTemplateView = POINTER TO CPageTemplateView;

CLASS CPageTemplateView IMPLEMENTS MVC.IView;
   // IView
   PUBLIC VIRTUAL READONLY PROPERTY
      OutputType : MVC.TViewOutputType;
   PUBLIC VIRTUAL PROCEDURE FormatToBuffer( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OUT Output : StorageO.CMemoryBuffer ) : BOOLEAN; // returning false means 500 response, Output is empty on input
   PUBLIC VIRTUAL PROCEDURE FormatToInputStream( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OUT InputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response, Stream MUST be DISPOSED after usage
   PUBLIC VIRTUAL PROCEDURE FormatToOutputStream( CONST Request : MVC.TPHttpRequest; REF ResponseStatus : HttpCommon.THttpResponse; ResponseHeaders : HttpCommon.TPHttpHeaders; OutputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // SELF
   PUBLIC PROCEDURE Init( CONST Resolver : FSO.TPFilePathResolver; CONST ViewName : ARRAY OF WCHAR );
   
   PRIVATE VAR
      Request : MVC.TPHttpRequest;
      Reader : xmlreader.CXMLReader;
      Writer : xmlwriter.CXMLWriter;
      Resolver : FSO.TPFilePathResolver;
      ViewName : StringsO.CString;

      Prefix : StringsO.CString;
      PrefixCondition : StringsO.CString;
      Sources : stacks.CPtrStack;
      Where : SET OF TWhere;
      FormModel : StringsO.CString;
      CurrentViewNameIndex : CARDINAL;
      
      ErrorElement : StringsO.CString;
      ErrorModel : StringsO.CString;
      ErrorText : StringsO.CString;
      
   PRIVATE PROCEDURE ParseRoot() : BOOLEAN;
   PRIVATE PROCEDURE Parse( emit, limitToPTOnly : BOOLEAN ) : BOOLEAN;
   PRIVATE PROCEDURE HandleElementStart( isEmpty, ptFlag, limitToPTOnly : BOOLEAN; CONST nodeName : StringsO.CString; CONST attributes : lists.CStringStringList ) : TElementStartAction;
   PRIVATE PROCEDURE ParseElement( CONST attributes : lists.CStringStringList; isEmpty, limitToPTOnly : BOOLEAN; CONST ignoreOA1, ignoreOA2 : ARRAY OF WCHAR ) : BOOLEAN;
   PRIVATE PROCEDURE ParseChoose( CONST Request : MVC.TPHttpRequest ) : BOOLEAN;
   PRIVATE PROCEDURE ParseFor( CONST attributes : lists.CStringStringList ) : BOOLEAN;
   PRIVATE PROCEDURE ParseForeach( CONST attributes : lists.CStringStringList ) : BOOLEAN;
   PRIVATE PROCEDURE ParseForm( isEmpty : BOOLEAN; CONST attributes : lists.CStringStringList ) : BOOLEAN;
   PRIVATE PROCEDURE ParseFormInput( isEmpty : BOOLEAN; CONST attributes : lists.CStringStringList; ptype : POINTER TO CONST WCHAR ) : BOOLEAN;
   PRIVATE PROCEDURE ParseFormSelect( isEmpty : BOOLEAN; CONST attributes : lists.CStringStringList ) : BOOLEAN;
   PRIVATE PROCEDURE ParseFormOption( isEmpty : BOOLEAN; CONST attributes : lists.CStringStringList ) : BOOLEAN;
   PRIVATE PROCEDURE ParseText( CONST Text : StringsO.IString; OUT Parsed : StringsO.IString );
   PRIVATE PROCEDURE GetFormModel( CONST attributes : lists.CStringStringList; OUT formModel : StringsO.IString ) : BOOLEAN;
   PRIVATE PROCEDURE MoveNext( OUT nodeType : xmlreader.TNodeType; OUT nodePrefix : StringsO.IString; OUT nodeName : StringsO.IString; OUT isEmpty : BOOLEAN; OUT nodeValue : StringsO.IString; OUT attributes : lists.CStringStringList ) : xmlreader.TXMLError;
   PRIVATE PROCEDURE CopyAttributes( ptFlag : BOOLEAN; CONST attributes : lists.CStringStringList; CONST ignoreOA1, ignoreOA2 : ARRAY OF WCHAR );
   PRIVATE PROCEDURE WriteFormNameAttribute( CONST model : StringsO.IString );

   PRIVATE PROCEDURE SetModelBoolean( CONST model : StringsO.IString; value : BOOLEAN );
   PRIVATE PROCEDURE EvaluateBoolean( CONST Value : StringsO.IString ) : BOOLEAN;
   
   PRIVATE PROCEDURE SetError( CONST Element : StringsO.IString; Model : StringsO.TPString; CONST Text : ARRAY OF WCHAR );
   PRIVATE PROCEDURE FormatError();
END CPageTemplateView;

(*================================================================================*)

END View.