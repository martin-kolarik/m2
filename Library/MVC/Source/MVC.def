DEFINITION MODULE MVC;

//================================================================================

IMPORT
   accesslist,
   FSO,
   IOO,
   inetaddr,
   HttpCommon,
   HttpSrv,
   Languages,
   Log,
   maps,
   StringsO,
   time;

//================================================================================

#save, option( dll_export => on )

TYPE
   TPMessageSource = POINTER TO IMessageSource;
   TPFunctionHandler = POINTER TO IFunctionHandler;
   TPMIMEResolver = POINTER TO IMIMEResolver;
   TPContainer = POINTER TO IContainer;
   TPHttpRequest = POINTER TO IHttpRequest;
   TPHttpResponse = POINTER TO IHttpResponse;
   TPView = POINTER TO IView;
   TPController = POINTER TO IController;
   TPMVC = POINTER TO IMVC;
   
(*--------------------------------------------------------------------------------*)

INTERFACE IMessageSource;
   PROCEDURE GetMessage( language : Languages.TLanguage; CONST Key : StringsO.IString; OUT Message : StringsO.IString ) : BOOLEAN;
   PROCEDURE GetMessageOA( language : Languages.TLanguage; CONST Key : ARRAY OF WCHAR; OUT Message : StringsO.IString ) : BOOLEAN;
END IMessageSource;

(*--------------------------------------------------------------------------------*)

INTERFACE IMIMEResolver;
   PROCEDURE ResolveMIME( ResolveContext : PTR; CONST Source : StringsO.IString; OUT ContentHeader : StringsO.IString ) : BOOLEAN;
END IMIMEResolver;

(*--------------------------------------------------------------------------------*)

INTERFACE IHttpRequest;
   READONLY PROPERTY
      RequestSource : inetaddr.INETADDR;
      RequestVerb : HttpCommon.TVerb;
      FullURI : StringsO.CString;
      AbsoluteURI : StringsO.CString;
      ControllerURI : StringsO.CString;
      RequestHeaders : HttpCommon.TPHttpHeaders;
      Language : Languages.TLanguage;

      ModelContainer : TPContainer;
      Session : HttpSrv.TPSession;
      MessageSource : TPMessageSource; // messages are loaded single time for MVC's context, can be NIL
      
   PROCEDURE TestConditions( CONST ResourceLastModified : time.DateTime; CONST ResourceName : StringsO.IString ) : HttpCommon.THttpResponse; // returns suggested status -- 200, 304 of 412
END IHttpRequest;

(*--------------------------------------------------------------------------------*)

INTERFACE IHttpResponse;
   PROPERTY
      StatusCode : HttpCommon.THttpResponse;
      ContentType : StringsO.CString; // default none
      Length : CARD64; // default none
      Chunked : BOOLEAN; // default FALSE
      OverrideStatusResponse : BOOLEAN; // default FALSE
      AllowCaching : BOOLEAN; // default TRUE
      LastModified : time.DateTime; // default none
   READONLY PROPERTY
      ModelContainer : TPContainer;
      Session : HttpSrv.TPSession;
      ResponseHeaders : HttpCommon.TPHttpHeaders;
END IHttpResponse;

(*--------------------------------------------------------------------------------*)

INTERFACE IFunctionHandler;
   PROCEDURE Call( CONST Request : IHttpRequest; CONST FunctionName : StringsO.IString; REF Parameters : lists.CStringStringList; RetVal : StringsO.TPString ) : BOOLEAN;
END IFunctionHandler;

(*--------------------------------------------------------------------------------*)

CONST
   TRUE_STRING = L"true";
   FALSE_STRING = L"false";

INTERFACE IContainer;
   // control
   PROCEDURE Dispose(); // data, not self
   PROCEDURE RemoveOA( CONST Name : ARRAY OF WCHAR ); // removes all types

   // controller side
   PROCEDURE AddBooleanOA( CONST Name : ARRAY OF WCHAR; Model : BOOLEAN );
   PROCEDURE AddStringOA( CONST Name : ARRAY OF WCHAR; CONST Model : StringsO.IString );
   PROCEDURE AddListOA( CONST Name : ARRAY OF WCHAR; OUT Model : lists.TPStringStringList ); // creates list in model, client uses it to fill data
   PROCEDURE AddMapOA( CONST Name : ARRAY OF WCHAR; OUT Model : maps.TPStringStringMap ); // creates map in model, client uses it to fill data
   PROCEDURE AddFunctionHandlerOA( CONST Name : ARRAY OF WCHAR; Handler : TPFunctionHandler );

   PROCEDURE AddVariable( CONST Name : ARRAY OF WCHAR; CONST Model : StringsO.IString ); // for in-view processing

   PROCEDURE GetBooleanOA( CONST Name : ARRAY OF WCHAR; OUT Model : BOOLEAN ) : BOOLEAN;
   PROCEDURE GetStringOA( CONST Name : ARRAY OF WCHAR; OUT Model : StringsO.IString ) : BOOLEAN; // able to return variables too
   PROCEDURE GetListOA( CONST Name : ARRAY OF WCHAR; OUT Model : lists.TPStringStringList ) : BOOLEAN;
   PROCEDURE GetMapOA( CONST Name : ARRAY OF WCHAR; OUT Model : maps.TPStringStringMap ) : BOOLEAN;
   PROCEDURE GetFunctionHandlerOA( CONST Name : ARRAY OF WCHAR; OUT Handler : TPFunctionHandler ) : BOOLEAN;
   
   PROCEDURE ResetFunctionCallsMemo();
   PROCEDURE GetFunctionCallsMemo() : BOOLEAN; // returns if some function was called after last ResetFunctionCallsMemo
   
   // view side
   PROCEDURE SetModelValue( CONST Request : IHttpRequest; CONST Model, Value : StringsO.IString ) : BOOLEAN; // main methods for accessing, it solves indexes, points, etc. in names
   PROCEDURE GetModelValue( CONST Request : IHttpRequest; CONST Model : StringsO.IString; OUT Value : StringsO.IString ) : BOOLEAN; // main methods for accessing, it solves indexes, points, etc. in names
   PROCEDURE Format( CONST Request : IHttpRequest; FailOnError : BOOLEAN; CONST Source : StringsO.IString; MessageSource : TPMessageSource; language : Languages.TLanguage; OUT Formatted : StringsO.IString ) : BOOLEAN; // main format method, replaces view syntax with model data, including message texts. MessageSource can be NIL.
   
   // There can be more active mappings, each identified by ControllerURI.
   PROCEDURE ResetModelInViewNames( CONST ControllerURI : StringsO.IString ); // clears all mode-view bindings corresponding to ControllerURI
   PROCEDURE SetModelInViewName( CONST ControllerURI, FullModel, InViewName : StringsO.IString ); // stores logical name used in view output together with full model accessor
   PROCEDURE GetModelByInViewName( CONST ControllerURI, InViewName : StringsO.IString; OUT FullModel : StringsO.IString ) : BOOLEAN; // gets model name by logical name used in view
   PROCEDURE ResetModelValues( CONST Request : IHttpRequest; CONST ControllerURI : StringsO.IString );
END IContainer;
   
(*--------------------------------------------------------------------------------*)

TYPE
   TViewOutputType = (
      votBuffer,
      votInputStream,
      votOutputStream
   );

// IView.Format*Stream implementor SHALL set ContentType and ContentLength/Chunked for its content. Higer level has not sufficient information to do it.
// IView.Format*Buffer implementor SHALL set ContentType for its content. Higer level has not sufficient information to do it. ContentLength/Chunk is set by MVC.
INTERFACE IView;

   // formatting
   READONLY PROPERTY
      OutputType : TViewOutputType;
   PROCEDURE FormatToBuffer( CONST Request : IHttpRequest; REF Response : IHttpResponse; OUT Output : StorageO.CMemoryBuffer ) : BOOLEAN; // returning false means 500 response, Output is empty on input
   PROCEDURE FormatToInputStream( CONST Request : IHttpRequest; REF Response : IHttpResponse; OUT InputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response, Stream MUST be DISPOSED after usage
   PROCEDURE FormatToOutputStream( CONST Request : IHttpRequest; REF Response : IHttpResponse; OutputStream : IOO.TPStream ) : BOOLEAN; // returning false means 500 response
   
   // authentication
   PROCEDURE GetAuthenticationInfo( CONST Request : MVC.IHttpRequest; OUT methodName : StringsO.IString; OUT authenticationTokens : lists.CStringStringList ) : BOOLEAN;

   // cleanup, releasing
   PROCEDURE Release();

END IView;

(*--------------------------------------------------------------------------------*)

INTERFACE IController;
   PROCEDURE ProcessRequest( Fallback : BOOLEAN; CONST Request : IHttpRequest; OUT View : TPView ) : BOOLEAN; // returning false means 500 response
END IController;

(*--------------------------------------------------------------------------------*)

INTERFACE IMVC;
   PROCEDURE RegisterController( Controller : TPController; ForVerb : HttpCommon.TVerb; CONST ControllerURI : ARRAY OF WCHAR ); // controller can be registered more times for different Verb and URI
   PROCEDURE ForgetController( Controller : TPController; OfVerb : HttpCommon.TVerb; CONST ControllerURI : ARRAY OF WCHAR );
   PROCEDURE ForgetControllerCompletely( Controller : TPController );

   PROCEDURE RegisterFallbackController( Controller : TPController ); // for GET only, for all URIs, intended mainlt for static sources like files etc.
   PROCEDURE ForgetFallbackController();
   
   PROPERTY
      MessageSourcePath : StringsO.CString;
      Logger : Log.TPILogger;
      AccessList : accesslist.TPAccessList;
END IMVC;

//================================================================================

PROCEDURE mvc( CONST Context : ARRAY OF WCHAR ) : TPMVC; // it is usual to have Context = Application, so typically server will call mvc only single times.
                                                         // More calls to get the same context returns the same pointer.
PROCEDURE Cleanup();

//================================================================================

PROCEDURE httpStatusCodeSystemView( StatusCode : HttpCommon.THttpResponse ) : TPView;
PROCEDURE httpStatusCodeCustomView( CONST resolver : FSO.TPFilePathResolver; StatusCode : HttpCommon.THttpResponse ) : TPView; // specialized for error pages, looks for error.xxx.pt.xml files, if file is not found, default server error page is emitted
PROCEDURE fileView( CONST resolver : FSO.TPFilePathResolver; resolverContext : PTR; CONST PathRelativeToContext : ARRAY OF WCHAR; dispositionFlag : BOOLEAN; CONST mimeResolver : TPMIMEResolver; mimeResolverContext : PTR ) : TPView;
PROCEDURE absoluteRedirectView( CONST FullURI : ARRAY OF WCHAR ) : TPView;
PROCEDURE redirectView( CONST ContextRelativeURI : ARRAY OF WCHAR ) : TPView;
PROCEDURE rawHTMLView( CONST HTML : ARRAY OF WCHAR ) : TPView;
PROCEDURE rawTextView( CONST text, downloadName : ARRAY OF WCHAR; CONST content : StringsO.IString; dispositionFlag : BOOLEAN ) : TPView; // if content is empty, default one is used
PROCEDURE pageTemplateView( CONST resolver : FSO.TPFilePathResolver; CONST viewName : ARRAY OF WCHAR ) : TPView;

#restore

//================================================================================

END MVC.