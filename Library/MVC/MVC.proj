<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <FileDescription>MVC Controller</FileDescription>
        <FileVersionMajor>0</FileVersionMajor>
        <FileVersionMinor>9</FileVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib;API\win32;API\httpapi"/>
        <Components Include="Component\sccore;Library\MIME;Library\httpsrv"/>
        <Modules Include="mvc;nodelist;view"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
