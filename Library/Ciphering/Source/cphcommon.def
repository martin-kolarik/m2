DEFINITION MODULE cphcommon;

(*================================================================================*)

PROCEDURE FromHex( CONST String : ARRAY OF WCHAR; OUT Bin : ARRAY OF BYTE; OUT Filled : CARDINAL ); // expects event number of characters in String
PROCEDURE ToHex( CONST Bin : ARRAY OF BYTE; OUT String : ARRAY OF WCHAR );

(*--------------------------------------------------------------------------------*)

PROCEDURE BASE64CharCount( SrcBytes : CARDINAL ) : CARDINAL;
PROCEDURE BASE64ByteCount( BASE64Chars : CARDINAL ) : CARDINAL; 

PROCEDURE FromBASE64( CONST String : ARRAY OF WCHAR; OUT Bin : ARRAY OF BYTE; OUT Filled : CARDINAL ) : BOOLEAN;
PROCEDURE ToBASE64( CONST Bin : ARRAY OF BYTE; OUT String : ARRAY OF WCHAR ) : BOOLEAN;

(*================================================================================*)

END cphcommon.

