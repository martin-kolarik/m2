		080BE9F5DH, 0937C69D0H, 02DA96FD5H, 012B3CF25H, 0993BC8ACH, 07DA71018H, 0636EE89CH, 0BB7BDB3BH,
		07809CD26H, 018F46E59H, 0B701EC9AH, 09AA8834FH, 06E65E695H, 0E67EAAFFH, 0CF0821BCH, 0E8E6EF15H,
		09BD9BAE7H, 036CE4A6FH, 009D4EA9FH, 07CD629B0H, 0B2AF31A4H, 023312A3FH, 09430C6A5H, 066C035A2H,
		0BC37744EH, 0CAA6FC82H, 0D0B0E090H, 0D81533A7H, 0984AF104H, 0DAF741ECH, 0500E7FCDH, 0F62F1791H,
		0D68D764DH, 0B04D43EFH, 04D54CCAAH, 004DFE496H, 0B5E39ED1H, 0881B4C6AH, 01FB8C12CH, 0517F4665H,
		0EA049D5EH, 0355D018CH, 07473FA87H, 0412EFB0BH, 01D5AB367H, 0D25292DBH, 05633E910H, 047136DD6H,
		0618C9AD7H, 00C7A37A1H, 0148E59F8H, 03C89EB13H, 027EECEA9H, 0C935B761H, 0E5EDE11CH, 0B13C7A47H,
		0DF599CD2H, 0733F55F2H, 0CE791814H, 037BF73C7H, 0CDEA53F7H, 0AA5B5FFDH, 06F14DF3DH, 0DB867844H,
		0F381CAAFH, 0C43EB968H, 0342C3824H, 0405FC2A3H, 0C372161DH, 0250CBCE2H, 0498B283CH, 09541FF0DH,
