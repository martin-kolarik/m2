		04A247D85H, 0BB3DF8D2H, 0F93211AEH, 029A16DC7H, 09E2F4B1DH, 0B230F3DCH, 08652EC0DH, 0C1E3D077H,
		0B3166C2BH, 070B999A9H, 09448FA11H, 0E9642247H, 0FC8CC4A8H, 0F03F1AA0H, 07D2CD856H, 03390EF22H,
		0494EC787H, 038D1C1D9H, 0CAA2FE8CH, 0D40B3698H, 0F581CFA6H, 07ADE28A5H, 0B78E26DAH, 0ADBFA43FH,
		03A9DE42CH, 078920D50H, 05FCC9B6AH, 07E466254H, 08D13C2F6H, 0D8B8E890H, 039F75E2EH, 0C3AFF582H,
