		0EB2807B2H, 0B5C2032FH, 0C57B9A86H, 03708A5D3H, 02887F230H, 0BFA5B223H, 0036ABA02H, 016825CEDH,
		0CF1C2B8AH, 079B492A7H, 007F2F0F3H, 069E2A14EH, 0DAF4CD65H, 005BED506H, 034621FD1H, 0A6FE8AC4H,
		02E539D34H, 0F355A0A2H, 08AE13205H, 0F6EB75A4H, 083EC390BH, 060EFAA40H, 0719F065EH, 06E1051BDH,
		0218AF93EH, 0DD063D96H, 03E05AEDDH, 0E6BD464DH, 0548DB591H, 0C45D0571H, 006D46F04H, 05015FF60H,
		098FB2419H, 0BDE997D6H, 04043CC89H, 0D99E7767H, 0E842BDB0H, 0898B8807H, 0195B38E7H, 0C8EEDB79H,
		07C0A47A1H, 0420FE97CH, 0841EC9F8H, 000000000H, 080868309H, 02BED4832H, 01170AC1EH, 05A724E6CH,
		00EFFFBFDH, 08538560FH, 0AED51E3DH, 02D392736H, 00FD9640AH, 05CA62168H, 05B54D19BH, 0362E3A24H,
