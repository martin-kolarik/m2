		0C2896A75H, 08E7978F4H, 0583E6B99H, 0B971DD27H, 0E14FB6BEH, 088AD17F0H, 020AC66C9H, 0CE3AB47DH,
		0DF4A1863H, 01A3182E5H, 051336097H, 0537F4562H, 06477E0B1H, 06BAE84BBH, 081A01CFEH, 0082B94F9H,
