		04EBC3774H, 082CAA6FCH, 090D0B0E0H, 0A7D81533H, 004984AF1H, 0ECDAF741H, 0CD500E7FH, 091F62F17H,
		04DD68D76H, 0EFB04D43H, 0AA4D54CCH, 09604DFE4H, 0D1B5E39EH, 06A881B4CH, 02C1FB8C1H, 065517F46H,
		05EEA049DH, 08C355D01H, 0877473FAH, 00B412EFBH, 0671D5AB3H, 0DBD25292H, 0105633E9H, 0D647136DH,
		0D7618C9AH, 0A10C7A37H, 0F8148E59H, 0133C89EBH, 0A927EECEH, 061C935B7H, 01CE5EDE1H, 047B13C7AH,
		0D2DF599CH, 0F2733F55H, 014CE7918H, 0C737BF73H, 0F7CDEA53H, 0FDAA5B5FH, 03D6F14DFH, 044DB8678H,
		0AFF381CAH, 068C43EB9H, 024342C38H, 0A3405FC2H, 01DC37216H, 0E2250CBCH, 03C498B28H, 00D9541FFH,
		0A8017139H, 00CB3DE08H, 0B4E49CD8H, 056C19064H, 0CB84617BH, 032B670D5H, 06C5C7448H, 0B85742D0H
	);

	// add round key's Rcon
	Rcon = TRcon(
		001000000H, 002000000H, 004000000H, 008000000H, 010000000H, 020000000H, 040000000H, 080000000H,
		01B000000H, 036000000H
	); // for 128-bit blocks is never needed more

(*================================================================================*)
// helpers and inlined rounds

TYPE
	TPRunKey  = POINTER TO TRunKey;
	TPBlock   = POINTER TO TBlock;
	TBlockLW  = ARRAY [0..3] OF LONGWORD;
	TPBlockLW = POINTER TO TBlockLW;

(*--------------------------------------------------------------------------------*)

INLINE PROCEDURE AES_FROUND( REF pkey : TPRunKey; REF X0, X1, X2, X3 : CARD32; CONST Y0, Y1, Y2, Y3 : CARD32 );
BEGIN
	INC( pkey, 4 * SIZE( pkey^[0] ));

	X0 := pkey^[0] XOR
			FT0[ CARD8( Y0 >> 24 ) ] XOR
			FT1[ CARD8( Y1 >> 16 ) ] XOR
			FT2[ CARD8( Y2 >>  8 ) ] XOR
			FT3[ CARD8( Y3       ) ];

	X1 := pkey^[1] XOR
			FT0[ CARD8( Y1 >> 24 ) ] XOR
			FT1[ CARD8( Y2 >> 16 ) ] XOR
			FT2[ CARD8( Y3 >>  8 ) ] XOR
			FT3[ CARD8( Y0       ) ];

	X2 := pkey^[2] XOR
			FT0[ CARD8( Y2 >> 24 ) ] XOR
			FT1[ CARD8( Y3 >> 16 ) ] XOR
			FT2[ CARD8( Y0 >>  8 ) ] XOR
			FT3[ CARD8( Y1       ) ];

	X3 := pkey^[3] XOR
			FT0[ CARD8( Y3 >> 24 ) ] XOR
			FT1[ CARD8( Y0 >> 16 ) ] XOR
			FT2[ CARD8( Y1 >>  8 ) ] XOR
			FT3[ CARD8( Y2       ) ];
END AES_FROUND;

(*--------------------------------------------------------------------------------*)

INLINE PROCEDURE AES_RROUND( REF pkey : TPRunKey; REF X0, X1, X2, X3 : CARD32; CONST Y0, Y1, Y2, Y3 : CARD32 );
BEGIN
	INC( pkey, 4 * SIZE( pkey^[0] ));

	X0 := pkey^[0] XOR
			RT0[ CARD8( Y0 >> 24 ) ] XOR
			RT1[ CARD8( Y3 >> 16 ) ] XOR
			RT2[ CARD8( Y2 >>  8 ) ] XOR
			RT3[ CARD8( Y1       ) ];

	X1 := pkey^[1] XOR
			RT0[ CARD8( Y1 >> 24 ) ] XOR
			RT1[ CARD8( Y0 >> 16 ) ] XOR
			RT2[ CARD8( Y3 >>  8 ) ] XOR
			RT3[ CARD8( Y2       ) ];

	X2 := pkey^[2] XOR
			RT0[ CARD8( Y2 >> 24 ) ] XOR
			RT1[ CARD8( Y1 >> 16 ) ] XOR
			RT2[ CARD8( Y0 >>  8 ) ] XOR
			RT3[ CARD8( Y3       ) ];

	X3 := pkey^[3] XOR
			RT0[ CARD8( Y3 >> 24 ) ] XOR
			RT1[ CARD8( Y2 >> 16 ) ] XOR
			RT2[ CARD8( Y1 >>  8 ) ] XOR
			RT3[ CARD8( Y0       ) ];
END AES_RROUND;

(*--------------------------------------------------------------------------------*)

INLINE PROCEDURE XORBlock( pi : TPBlockLW; pw : TPBlockLW; po : TPBlockLW );
BEGIN
	po^[0] := pi^[0] XOR pw^[0];
	po^[1] := pi^[1] XOR pw^[1];
	po^[2] := pi^[2] XOR pw^[2];
	po^[3] := pi^[3] XOR pw^[3];
END XORBlock;

(*================================================================================*)

CLASS IMPLEMENTATION CRijndael;

(*--------------------------------------------------------------------------------*)

	PUBLIC PROCEDURE CRijndael.Init( CipherMode : TCipherMode; KeyLen : TRijndaelKeyLen; CONST Key, IV : ARRAY OF BYTE );
	VAR
		i, u : INTEGER;
	BEGIN
		ciphermode := CipherMode;
		// prepare rkey
		KeySchedule( KeyLen, Key );
		// prepare IV for some types
		IF ( ciphermode = cphmECBe ) OR ( ciphermode = cphmECBd ) THEN
			RETURN;
		END;
		// pad IV into rregister
		rposition := 0; // position in register
		IF ADR( IV ) = NIL THEN
			u := -1;
		ELSE
			u := MIN2( HIGH( IV ), HIGH( rregister ));
		END;
		FOR i := 0 TO u DO
			rregister[i] := IV[i];
		END;
		FOR i := u+1 TO HIGH( rregister ) DO
			rregister[i] := 0;
		END;
		CASE ciphermode OF
		| cphmCFB128e, cphmCFB128d, cphmOFBe :
			EncryptBlock( rregister, OUT rregister ); // prepare register
		END;
	END CRijndael.Init;

(*--------------------------------------------------------------------------------*)

	PUBLIC PROCEDURE CRijndael.Encrypt( CONST Input : ARRAY OF BYTE; OUT Output : ARRAY OF BYTE; OUT Filled : CARDINAL ) : BOOLEAN;
	VAR
		i, l : CARDINAL;
	BEGIN
		CASE ciphermode OF
		//-----
		| cphmECBe :
			l := HIGH( Input ) + 1;
			IF l MOD rlen > 0 THEN
				RETURN FALSE;
			END;
			i := HIGH( Output ) + 1;
			IF i < rlen THEN
				RETURN FALSE;
			ELSE
				l := MIN2( l, ( i DIV rlen ) * rlen );
			END;
			i := 0;
			WHILE i < l DO
				EncryptBlock( TPBlock( ADR( Input[i] ))^, OUT TPBlock( ADR( Output[i] ))^ );
				INC( i, rlen );
			END;
			Filled := l;
			RETURN TRUE;
		//-----
		| cphmCBCe :
			l := HIGH( Input ) + 1;
			IF l MOD rlen > 0 THEN
				RETURN FALSE;
			END;
			i := HIGH( Output ) + 1;
			IF i < rlen THEN
				RETURN FALSE;
			ELSE
				l := MIN2( l, ( i DIV rlen ) * rlen );
			END;
			i := 0;
			WHILE i < l DO
				XORBlock( TPBlockLW( ADR( rregister )), TPBlockLW( ADR( Input[i] )), TPBlockLW( ADR( rregister )));
				EncryptBlock( rregister, OUT rregister );
				TPBlock( ADR( Output[i] ))^ := rregister;
				INC( i, rlen );
			END;
			Filled := l;
			RETURN TRUE;
		//-----
		| cphmCFB8e :
			OperateCFB8( Input, OUT Output, OUT Filled );
			RETURN TRUE;
		//-----
		| cphmCFB128e, cphmOFBe :
			OperateXFB( Input, OUT Output, OUT Filled );
			RETURN TRUE;
		//-----
		ELSE
			Filled := 0;
			RETURN FALSE;
		END; // CASE
	END CRijndael.Encrypt;

(*--------------------------------------------------------------------------------*)

	PUBLIC PROCEDURE CRijndael.Decrypt( CONST Input : ARRAY OF BYTE; OUT Output : ARRAY OF BYTE; OUT Filled : CARDINAL ) : BOOLEAN;
	VAR
		i, l : CARDINAL;
		lregister : TBlock;
		output : TPBlock;
	BEGIN
		CASE ciphermode OF
		//-----
		| cphmECBd :
			l := HIGH( Input ) + 1;
			IF l MOD rlen > 0 THEN
				RETURN FALSE;
			END;
			i := HIGH( Output )+1;
			IF i < rlen THEN
				RETURN FALSE;
			ELSE
				l := MIN2( l, ( i DIV rlen ) * rlen );
			END;
			i := 0;
			WHILE i < l DO
				DecryptBlock( TPBlock( ADR( Input[i] ))^, OUT TPBlock( ADR( Output[i] ))^ );
				INC( i, rlen );
			END;
			Filled := l;
			RETURN TRUE;
		//-----
		| cphmCBCd :
			l := HIGH( Input ) + 1;
			IF l MOD rlen > 0 THEN
				RETURN FALSE;
			END;
			i := HIGH( Output ) + 1;
			IF i < rlen THEN
				RETURN FALSE;
			ELSE
				l := MIN2( l, ( i DIV rlen ) * rlen );
			END;
			i := 0;
			output := TPBlock( ADR( Output ));
			WHILE i < l DO
				lregister := TPBlock( ADR( Input[i] ))^;
				DecryptBlock( lregister, OUT output^ );
				XORBlock( TPBlockLW( output ), TPBlockLW( ADR( rregister )), TPBlockLW( output ));
				rregister := lregister;
				INC( i, rlen );
				INC( output, rlen );
			END;
			Filled := l;
			RETURN TRUE;
		//-----
		| cphmCFB8d :
			OperateCFB8( Input, OUT Output, OUT Filled );
			RETURN TRUE;
		//-----
		| cphmCFB128d, cphmOFBd :
			OperateXFB( Input, OUT Output, OUT Filled );
			RETURN TRUE;
		//-----
		ELSE
			Filled := 0;
			RETURN FALSE;
		END; // CASE
	END CRijndael.Decrypt;

(*--------------------------------------------------------------------------------*)

	PRIVATE PROCEDURE CRijndael.KeySchedule( KeyLen : TRijndaelKeyLen; CONST Key : ARRAY OF BYTE );
	TYPE
		TPLWA = POINTER TO ARRAY [0..0] OF LONGWORD;
	VAR
		i, j : CARDINAL;
		pkey : TPRunKey;
		PKey : TPLWA;
		t : CARD32;
	BEGIN
		// set number of rounds
		CASE KeyLen OF 
		| rkl128 : rounds := 10;
		| rkl192 : rounds := 12;
		| rkl256 : rounds := 14;
		END;

		// init key with use Key
		PKey := TPLWA( ADR( Key ));
		FOR i := 0 TO MIN2( HIGH( Key )+1, CARDINAL( KeyLen )) >> 2 - 1 DO
			rkey[i] := REVERSE( PKey^[i] );
		END;

		// setup the key, using key schedule algorithm
		pkey := ADR( rkey );
		CASE KeyLen OF

		//----
		| rkl128 :
			FOR i := 0 TO 9 DO
				pkey^[4] := pkey^[0] XOR Rcon[i] XOR
								( FSb[ CARD8( pkey^[3] >> 16 ) ] << 24 ) XOR
								( FSb[ CARD8( pkey^[3] >>  8 ) ] << 16 ) XOR
								( FSb[ CARD8( pkey^[3]       ) ] <<  8 ) XOR
								( FSb[ CARD8( pkey^[3] >> 24 ) ]       );

				pkey^[5] := pkey^[1] XOR pkey^[4];
				pkey^[6] := pkey^[2] XOR pkey^[5];
				pkey^[7] := pkey^[3] XOR pkey^[6];

				INC( pkey, 4 * SIZE( pkey^[0] )); // increment by 16 bytes
			END; // FOR

		//----
		| rkl192 :
			FOR i := 0 TO 7 DO
				pkey^[6] := pkey^[0] XOR Rcon[i] XOR
								( FSb[ CARD8( pkey^[5] >> 16 ) ] << 24 ) XOR
								( FSb[ CARD8( pkey^[5] >>  8 ) ] << 16 ) XOR
								( FSb[ CARD8( pkey^[5]       ) ] <<  8 ) XOR
								( FSb[ CARD8( pkey^[5] >> 24 ) ]       );

				pkey^[7]  := pkey^[1] XOR pkey^[6];
				pkey^[8]  := pkey^[2] XOR pkey^[7];
				pkey^[9]  := pkey^[3] XOR pkey^[8];
				pkey^[10] := pkey^[4] XOR pkey^[9];
				pkey^[11] := pkey^[5] XOR pkey^[10];

				INC( pkey, 6 * SIZE( pkey^[0] )); // increment by 24 bytes
			END; // FOR

		//----
		| rkl256 :
			FOR i := 0 TO 6 DO
				pkey^[8] := pkey^[0] XOR Rcon[i] XOR
								( FSb[ CARD8( pkey^[7] >> 16 ) ] << 24 ) XOR
								( FSb[ CARD8( pkey^[7] >>  8 ) ] << 16 ) XOR
								( FSb[ CARD8( pkey^[7]       ) ] <<  8 ) XOR
								( FSb[ CARD8( pkey^[7] >> 24 ) ]       );

				pkey^[9]  := pkey^[1] XOR pkey^[8];
				pkey^[10] := pkey^[2] XOR pkey^[9];
				pkey^[11] := pkey^[3] XOR pkey^[10];

				pkey^[12] := pkey^[4] XOR
								( FSb[ CARD8( pkey^[11] >> 24 ) ] << 24 ) XOR
								( FSb[ CARD8( pkey^[11] >> 16 ) ] << 16 ) XOR
								( FSb[ CARD8( pkey^[11] >>  8 ) ] <<  8 ) XOR
								( FSb[ CARD8( pkey^[11]       ) ]       );

				pkey^[13] := pkey^[5] XOR pkey^[12];
				pkey^[14] := pkey^[6] XOR pkey^[13];
				pkey^[15] := pkey^[7] XOR pkey^[14];

				INC( pkey, 8 * SIZE( pkey^[0] )); // increment by 32 bytes
			END; // FOR

		//----
		END; // CASE

		IF ( ciphermode <> cphmECBd ) AND ( ciphermode <> cphmCBCd ) THEN
			RETURN; // nothing to do
		END;

		// setup key for decryption
		// invert the order of the round keys
		i := 0;
		j := 4*rounds;
		WHILE i < j DO
			t := rkey[i    ]; rkey[i    ] := rkey[j    ]; rkey[j    ] := t;
			t := rkey[i + 1]; rkey[i + 1] := rkey[j + 1]; rkey[j + 1] := t;
			t := rkey[i + 2]; rkey[i + 2] := rkey[j + 2]; rkey[j + 2] := t;
			t := rkey[i + 3]; rkey[i + 3] := rkey[j + 3]; rkey[j + 3] := t;
			INC( i, 4 ); DEC( j, 4 );
		END; // WHILE

		// apply the inverse MixColumn transform to all round keys but the first and the last:
		pkey := TPRunKey( ADR( rkey[4] ));
		FOR i := 1 TO rounds-1 DO
			pkey^[0] :=
				RT0[ FSb[ CARD8( pkey^[0] >> 24 ) ] ] XOR
				RT1[ FSb[ CARD8( pkey^[0] >> 16 ) ] ] XOR
				RT2[ FSb[ CARD8( pkey^[0] >>  8 ) ] ] XOR
				RT3[ FSb[ CARD8( pkey^[0]       ) ] ];
			pkey^[1] :=
				RT0[ FSb[ CARD8( pkey^[1] >> 24 ) ] ] XOR
				RT1[ FSb[ CARD8( pkey^[1] >> 16 ) ] ] XOR
				RT2[ FSb[ CARD8( pkey^[1] >>  8 ) ] ] XOR
				RT3[ FSb[ CARD8( pkey^[1]       ) ] ];
			pkey^[2] :=
				RT0[ FSb[ CARD8( pkey^[2] >> 24 ) ] ] XOR
				RT1[ FSb[ CARD8( pkey^[2] >> 16 ) ] ] XOR
				RT2[ FSb[ CARD8( pkey^[2] >>  8 ) ] ] XOR
				RT3[ FSb[ CARD8( pkey^[2]       ) ] ];
			pkey^[3] :=
				RT0[ FSb[ CARD8( pkey^[3] >> 24 ) ] ] XOR
				RT1[ FSb[ CARD8( pkey^[3] >> 16 ) ] ] XOR
				RT2[ FSb[ CARD8( pkey^[3] >>  8 ) ] ] XOR
				RT3[ FSb[ CARD8( pkey^[3]       ) ] ];
			INC( pkey, 4 * SIZE( pkey^[0] )); // by 16 bytes
		END; // FOR

	END CRijndael.KeySchedule;

(*--------------------------------------------------------------------------------*)

	PRIVATE PROCEDURE CRijndael.EncryptBlock( CONST Input : TBlock; OUT Output : TBlock );
	VAR
		pkey : TPRunKey;
		X0, X1, X2, X3 : CARD32;
		Y0, Y1, Y2, Y3 : CARD32 := 0;
	BEGIN
		pkey := ADR( rkey );

		// fetch block
		X0 := pkey^[0] XOR REVERSE( TPBlockLW( ADR( Input ))^[0] );
		X1 := pkey^[1] XOR REVERSE( TPBlockLW( ADR( Input ))^[1] );
		X2 := pkey^[2] XOR REVERSE( TPBlockLW( ADR( Input ))^[2] );
		X3 := pkey^[3] XOR REVERSE( TPBlockLW( ADR( Input ))^[3] );

		AES_FROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 1
		AES_FROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 2
		AES_FROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 3
		AES_FROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 4
		AES_FROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 5
		AES_FROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 6
		AES_FROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 7
		AES_FROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 8
		AES_FROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 9

		IF rounds > 10 THEN
			AES_FROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 10
			AES_FROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 11
		END;

		IF rounds > 12 THEN
			AES_FROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 12
			AES_FROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 13
		END;

		// last round, use s-box
		INC( pkey, 4 * SIZE( pkey^[0] ));

		X0 := pkey^[0] XOR
				( FSb[ CARD8( Y0 >> 24 ) ] << 24 ) XOR
				( FSb[ CARD8( Y1 >> 16 ) ] << 16 ) XOR
				( FSb[ CARD8( Y2 >>  8 ) ] <<  8 ) XOR
				( FSb[ CARD8( Y3       ) ]       );

		X1 := pkey^[1] XOR
				( FSb[ CARD8( Y1 >> 24 ) ] << 24 ) XOR
				( FSb[ CARD8( Y2 >> 16 ) ] << 16 ) XOR
				( FSb[ CARD8( Y3 >>  8 ) ] <<  8 ) XOR
				( FSb[ CARD8( Y0       ) ]       );

		X2 := pkey^[2] XOR
				( FSb[ CARD8( Y2 >> 24 ) ] << 24 ) XOR
				( FSb[ CARD8( Y3 >> 16 ) ] << 16 ) XOR
				( FSb[ CARD8( Y0 >>  8 ) ] <<  8 ) XOR
				( FSb[ CARD8( Y1       ) ]       );

		X3 := pkey^[3] XOR
				( FSb[ CARD8( Y3 >> 24 ) ] << 24 ) XOR
				( FSb[ CARD8( Y0 >> 16 ) ] << 16 ) XOR
				( FSb[ CARD8( Y1 >>  8 ) ] <<  8 ) XOR
				( FSb[ CARD8( Y2       ) ]       );

		TPBlockLW( ADR( Output ))^[0] := REVERSE( X0 );
		TPBlockLW( ADR( Output ))^[1] := REVERSE( X1 );
		TPBlockLW( ADR( Output ))^[2] := REVERSE( X2 );
		TPBlockLW( ADR( Output ))^[3] := REVERSE( X3 );
	END CRijndael.EncryptBlock;

(*--------------------------------------------------------------------------------*)

	PRIVATE PROCEDURE CRijndael.DecryptBlock( CONST Input : TBlock; OUT Output : TBlock );
	VAR
		pkey : TPRunKey;
		X0, X1, X2, X3 : CARD32;
		Y0, Y1, Y2, Y3 : CARD32 := 0;
	BEGIN
		pkey := ADR( rkey );

		X0 := pkey^[0] XOR REVERSE( TPBlockLW( ADR( Input ))^[0] );
		X1 := pkey^[1] XOR REVERSE( TPBlockLW( ADR( Input ))^[1] );
		X2 := pkey^[2] XOR REVERSE( TPBlockLW( ADR( Input ))^[2] );
		X3 := pkey^[3] XOR REVERSE( TPBlockLW( ADR( Input ))^[3] );

		AES_RROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 1
		AES_RROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 2
		AES_RROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 3
		AES_RROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 4
		AES_RROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 5
		AES_RROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 6
		AES_RROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 7
		AES_RROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 8
		AES_RROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 9

		IF rounds > 10 THEN
			AES_RROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 10
			AES_RROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 11
		END;

		IF rounds > 12 THEN
			AES_RROUND( REF pkey, REF X0, REF X1, REF X2, REF X3, Y0, Y1, Y2, Y3 ); // round 12
			AES_RROUND( REF pkey, REF Y0, REF Y1, REF Y2, REF Y3, X0, X1, X2, X3 ); // round 13
		END;

		// last round, use s-box
		INC( pkey, 4 * SIZE( pkey^[0] ));

		X0 := pkey^[0] XOR
				( RSb[ CARD8( Y0 >> 24 ) ] << 24 ) XOR
				( RSb[ CARD8( Y3 >> 16 ) ] << 16 ) XOR
				( RSb[ CARD8( Y2 >>  8 ) ] <<  8 ) XOR
				( RSb[ CARD8( Y1       ) ]       );

		X1 := pkey^[1] XOR
				( RSb[ CARD8( Y1 >> 24 ) ] << 24 ) XOR
				( RSb[ CARD8( Y0 >> 16 ) ] << 16 ) XOR
				( RSb[ CARD8( Y3 >>  8 ) ] <<  8 ) XOR
				( RSb[ CARD8( Y2       ) ]       );

		X2 := pkey^[2] XOR
				( RSb[ CARD8( Y2 >> 24 ) ] << 24 ) XOR
				( RSb[ CARD8( Y1 >> 16 ) ] << 16 ) XOR
				( RSb[ CARD8( Y0 >>  8 ) ] <<  8 ) XOR
				( RSb[ CARD8( Y3       ) ]       );

		X3 := pkey^[3] XOR
				( RSb[ CARD8( Y3 >> 24 ) ] << 24 ) XOR
				( RSb[ CARD8( Y2 >> 16 ) ] << 16 ) XOR
				( RSb[ CARD8( Y1 >>  8 ) ] <<  8 ) XOR
				( RSb[ CARD8( Y0       ) ]       );

		TPBlockLW( ADR( Output ))^[0] := REVERSE( X0 );
		TPBlockLW( ADR( Output ))^[1] := REVERSE( X1 );
		TPBlockLW( ADR( Output ))^[2] := REVERSE( X2 );
		TPBlockLW( ADR( Output ))^[3] := REVERSE( X3 );
	END CRijndael.DecryptBlock;

(*--------------------------------------------------------------------------------*)

	PRIVATE PROCEDURE OperateXFB( CONST Input : ARRAY OF BYTE; OUT Output : ARRAY OF BYTE; OUT Filled : CARDINAL );
	VAR
		io, l : CARDINAL;
		lbyte : BYTE; // lbyte and...
		lregister : TBlock; //...lregister allows for cphmCFB128e/d using in place crypt/encrypt -- undecryped input must be stored for next round
		pi, po, pri, pro : TPBlockLW;
	BEGIN
		l := HIGH( Input ) + 1;
		io := 0;
		IF rposition > 0 THEN
			// process rest of rregister from the previous rouns
			WHILE rposition < rlen DO
				IF ciphermode = cphmCFB128d THEN
					lbyte := Input[io];
			   END;
				Output[io] := Input[io] XOR rregister[rposition];
				IF ciphermode = cphmCFB128e THEN
					rregister[rposition] := Output[io];
				ELSIF ciphermode = cphmCFB128d THEN
					rregister[rposition] := lbyte;
				END;
				INC( rposition );
				INC( io );
			END; // WHILE
			rposition := 0;
			EncryptBlock( rregister, OUT rregister );
		END;
		// process whole blocks
		pro := TPBlockLW( ADR( rregister ));
      IF ciphermode = cphmCFB128d THEN
         pri := TPBlockLW( ADR( lregister ));
      ELSE
         pri := pro;
      END;
		pi := TPBlockLW( ADR( Input[io] ));
		po := TPBlockLW( ADR( Output[io] ));
		WHILE l-io >= rlen DO
			IF ciphermode = cphmCFB128d THEN
			   pri^ := pi^;
			END;
			XORBlock( pi, pro, po );
			IF ciphermode = cphmCFB128e THEN
				pri^ := po^;
			END;
			INC( io, rlen );
			INC( pi, rlen );
			INC( po, rlen );
			EncryptBlock( TPBlock( pri )^, OUT TPBlock( pro )^ );
		END; // while over whole block
		// iterate rest input bytes
		WHILE io < l DO
         IF ciphermode = cphmCFB128d THEN
			   lbyte := Input[io];
			END;
			Output[io] := Input[io] XOR rregister[rposition];
			IF ciphermode = cphmCFB128e THEN
				rregister[rposition] := Output[io];
			ELSIF ciphermode = cphmCFB128d THEN
				rregister[rposition] := lbyte;
			END;
			INC( rposition );
			INC( io );
		END; // while ending bytes
		Filled := l;
	END OperateXFB;

(*--------------------------------------------------------------------------------*)

	PRIVATE PROCEDURE OperateCFB8( CONST Input : ARRAY OF BYTE; OUT Output : ARRAY OF BYTE; OUT Filled : CARDINAL );
	VAR
		i, io, l : CARDINAL;
		lregister : TBlock;
		lbyte : BYTE;
	BEGIN
		l := HIGH( Input ) + 1;
		io := 0;
		WHILE io < l DO
			EncryptBlock( rregister, OUT lregister );
			IF ciphermode = cphmCFB8d THEN // this solves case when input and output are same buffers
			   lbyte := Input[io];
			END;
			Output[io] := Input[io] XOR lregister[0];
			FOR i := 1 TO rlen-1 DO
				rregister[i-1] := rregister[i];
			END;
			IF ciphermode = cphmCFB8e THEN
				rregister[rlen-1] := Output[io];
			ELSE
				rregister[rlen-1] := lbyte;
			END;
			INC( io );
		END; // while ending bytes
		Filled := l;
	END OperateCFB8;

(*--------------------------------------------------------------------------------*)

BEGIN
	ciphermode := cphmECBe;
	rounds := 0;
	rkey[0] := 0;
	rregister[0] := 0;
	rposition := 0;
END CRijndael;

(*================================================================================*)

PROCEDURE Encrypt( CipherMode : TCipherMode; KeyLen : TRijndaelKeyLen; CONST Key, IV, Input : ARRAY OF BYTE; OUT Output : ARRAY OF BYTE; OUT Filled : CARDINAL ) : BOOLEAN;
VAR
	A : CRijndael;
BEGIN
	IF ( CipherMode = cphmECBd ) OR ( CipherMode = cphmCBCd ) OR ( CipherMode = cphmCFB8d ) OR ( CipherMode = cphmCFB128d ) THEN
		RETURN FALSE;
	END;
	A.Init( CipherMode, KeyLen, Key, IV );
	RETURN A.Encrypt( Input, OUT Output, OUT Filled );
END Encrypt;

(*--------------------------------------------------------------------------------*)

PROCEDURE Decrypt( CipherMode : TCipherMode; KeyLen : TRijndaelKeyLen; CONST Key, IV, Input : ARRAY OF BYTE; OUT Output : ARRAY OF BYTE; OUT Filled : CARDINAL ) : BOOLEAN;
VAR
	A : CRijndael;
BEGIN
	IF ( CipherMode = cphmECBe ) OR ( CipherMode = cphmCBCe ) OR ( CipherMode = cphmCFB8e ) OR ( CipherMode = cphmCFB128e ) THEN
		RETURN FALSE;
	END;
	A.Init( CipherMode, KeyLen, Key, IV );
	RETURN A.Decrypt( Input, OUT Output, OUT Filled );
END Decrypt;

(*================================================================================*)

END rijndael.
