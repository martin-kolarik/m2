<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ProjectDescription>Ciphering, Hashing and Message Digesting Support</ProjectDescription>
        <ProjectVersionMajor>0</ProjectVersionMajor>
        <ProjectVersionMinor>9</ProjectVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib;API\win32;Modula2\m2rtl;Modula2\m2ortl"/>
        <Modules Include="cphcommon;crc;digest;sha1;sha256;md5;hash;Rijndael;cphfilter;cphcommonO"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
