DEFINITION MODULE TextWriter;

(*===========================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   Exceptions,
	IOO,
	Languages,
	StringsO,
	Sync;

(*---------------------------------------------------------------------------*)

#save, option( dll_export => on )

TYPE
   TLineEndStyle = (
      lesWindows,
      lesUNIX,
      lesMAC
   );
   
TYPE
   TPTextWriter = POINTER TO CTextWriter;

CLASS CTextWriter;
	INTERNAL VAR
		_Stream : IOO.TPStream;
		_Encoding : CARDINAL := Languages.cp_UTF8;
		_LineEndStyle : TLineEndStyle := lesWindows;
	PUBLIC PROPERTY
		Encoding : CARDINAL;
		Stream : IOO.TPStream;
		LineEndStyle : TLineEndStyle;

   // synchronous interface
	PUBLIC PROCEDURE Write( CONST String : StringsO.IString; LineEnd : BOOLEAN );
	PUBLIC PROCEDURE WriteOA( CONST String : ARRAY OF WCHAR; LineEnd : BOOLEAN );
	PUBLIC PROCEDURE WriteM( CONST String : PWCHAR; Length : CARDINAL; LineEnd : BOOLEAN ); // Length is WCHAR count

	PUBLIC PROCEDURE WriteINT32( I : INT32; Base : CARDINAL; LineEnd : BOOLEAN );
	PUBLIC PROCEDURE WriteExc( CONST e : Exceptions.CException; LineEnd : BOOLEAN );

	PUBLIC PROCEDURE LineEnd();
	
	// timeouted interface
	PUBLIC PROCEDURE WriteTimeout( CONST String : StringsO.IString; LineEnd : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
	PUBLIC PROCEDURE WriteTimeoutOA( CONST String : ARRAY OF WCHAR; LineEnd : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult;
	PUBLIC PROCEDURE WriteTimeoutM( CONST String : PWCHAR; Length : CARDINAL; LineEnd : BOOLEAN; TimeoutMS : CARDINAL ) : Sync.TAsyncResult; // Length is WCHAR count
	
	PUBLIC PROCEDURE LineEndTimeout( TimeoutMS : CARDINAL ) : Sync.TAsyncResult;

END CTextWriter;

(*===========================================================================*)

PROCEDURE stdout() : TPTextWriter;
PROCEDURE errout() : TPTextWriter;

(*===========================================================================*)

#restore

END TextWriter.