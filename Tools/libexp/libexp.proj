<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 PRODUCT NAME -->
    <PropertyGroup>
        <ComponentType>Product</ComponentType>

        <ProductId>SmartControl.LibExp</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>

        <ProjectDescription>Tool to create extract symbols exported by library</ProjectDescription>
    </PropertyGroup>

    <!-- 2 ROOT DIRS (including ProjectBuildDir) -->
    <Import Project="..\..\Build\common.rootdir.proj"/><!-- property CodeRoot affects this -->
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 PRODUCT DEFINITION -->
    <ItemGroup>
        <Components Include="API\CLib;Modula2\modula2;API\win32;Modula2\m2rtl;Modula2\m2ortl;Library\Text"/>
        <Program Include="libexp"/>
    </ItemGroup>

    <!-- 5 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
