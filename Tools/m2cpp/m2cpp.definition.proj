<Project
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <PropertyGroup>
        <Result>Program</Result>
        <Test>off</Test>
        <StackReservation>512000</StackReservation>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName)!='m2cpp'">
        <Result>Static</Result>
    </PropertyGroup>

    <PropertyGroup>
        <ProductM2Control>-SAP</ProductM2Control>
        <ProductCLControl></ProductCLControl>
        <ProductRCControl></ProductRCControl>
        <ProductLNControl></ProductLNControl>
    </PropertyGroup>

</Project>
