MODULE interfaceaccessing;

INTERFACE I1;
  PROCEDURE IA();
END I1;

CLASS C1;
END C1;

CLASS C2( C1 ) IMPLEMENTS I1;
   PUBLIC VIRTUAL PROCEDURE IA();
END C2;

CLASS C3( C2 );
END C3;

CLASS IMPLEMENTATION C1;
END C1;

CLASS IMPLEMENTATION C2;

   PUBLIC VIRTUAL PROCEDURE IA();
   BEGIN
   END IA;

END C2;

CLASS IMPLEMENTATION C3;
END C3;

PROCEDURE X();
VAR
   VC1 : C1;
   VC2 : C2;
   VC3 : C3;
BEGIN
   VC2.IA();
   VC3.IA();
END X;

END interfaceaccessing.