MODULE interfacecompatibility;

INTERFACE I1;
  PROCEDURE IA();
END I1;

INTERFACE I2;
  PROCEDURE IB();
  OPERATOR =( CONST Value : I2 ) : BOOLEAN;
END I2;

INTERFACE I3( I2 );
END I3;

CLASS C1 IMPLEMENTS I1;
   PUBLIC VIRTUAL PROCEDURE IA();
   PUBLIC OPERATOR NEW( size : CARDINAL ) : ADDRESS;
   PUBLIC OPERATOR DISPOSE( a : ADDRESS );
END C1;

CLASS C2 IMPLEMENTS I2;
   PUBLIC VIRTUAL PROCEDURE IB();
   PUBLIC VIRTUAL OPERATOR =( CONST Value : I2 ) : BOOLEAN;
   PUBLIC OPERATOR NEW( size : CARDINAL ) : ADDRESS;
   PUBLIC OPERATOR DISPOSE( a : ADDRESS );
END C2;

CLASS C3 IMPLEMENTS I2;
   PUBLIC VIRTUAL PROCEDURE IB();
   PUBLIC VIRTUAL OPERATOR =( CONST Value : I2 ) : BOOLEAN;
   PUBLIC OPERATOR NEW( size : CARDINAL ) : ADDRESS;
   PUBLIC OPERATOR DISPOSE( a : ADDRESS );
END C3;

CLASS C4( C1 );
END C4;

CLASS C5( C3 );
END C5;

CLASS C6 IMPLEMENTS I3;
   PUBLIC VIRTUAL PROCEDURE IB();
   PUBLIC VIRTUAL OPERATOR =( CONST Value : I2 ) : BOOLEAN;
   PUBLIC OPERATOR NEW( size : CARDINAL ) : ADDRESS;
   PUBLIC OPERATOR DISPOSE( a : ADDRESS );
END C6;

CLASS C7( C3 ) IMPLEMENTS I3;
  PUBLIC VIRTUAL PROCEDURE IB();
  PUBLIC VIRTUAL OPERATOR =( CONST Value : I2 ) : BOOLEAN;
END C7;

CLASS IMPLEMENTATION C1;

   PUBLIC VIRTUAL PROCEDURE IA();
   BEGIN
   END IA;

   PUBLIC OPERATOR NEW( size : CARDINAL ) : ADDRESS;
   BEGIN
      RETURN NIL;
   END NEW;

   PUBLIC OPERATOR DISPOSE( a : ADDRESS );
   BEGIN
   END DISPOSE;

END C1;

CLASS IMPLEMENTATION C2;

   PUBLIC VIRTUAL PROCEDURE IB();
   BEGIN
   END IB;

   PUBLIC VIRTUAL OPERATOR =( CONST Value : I2 ) : BOOLEAN;
   BEGIN
      RETURN FALSE;
   END =;

   PUBLIC OPERATOR NEW( size : CARDINAL ) : ADDRESS;
   BEGIN
      RETURN NIL;
   END NEW;

   PUBLIC OPERATOR DISPOSE( a : ADDRESS );
   BEGIN
   END DISPOSE;

END C2;

CLASS IMPLEMENTATION C3;

   PUBLIC VIRTUAL PROCEDURE IB();
   BEGIN
   END IB;

   PUBLIC VIRTUAL OPERATOR =( CONST Value : I2 ) : BOOLEAN;
   BEGIN
      RETURN FALSE;
   END =;

   PUBLIC OPERATOR NEW( size : CARDINAL ) : ADDRESS;
   BEGIN
      RETURN NIL;
   END NEW;

   PUBLIC OPERATOR DISPOSE( a : ADDRESS );
   BEGIN
   END DISPOSE;

END C3;

CLASS IMPLEMENTATION C4; END C4;

CLASS IMPLEMENTATION C5; END C5;

CLASS IMPLEMENTATION C6;

   PUBLIC VIRTUAL PROCEDURE IB();
   BEGIN
   END IB;

   PUBLIC VIRTUAL OPERATOR =( CONST Value : I2 ) : BOOLEAN;
   BEGIN
      RETURN FALSE;
   END =;

   PUBLIC OPERATOR NEW( size : CARDINAL ) : ADDRESS;
   BEGIN
      RETURN NIL;
   END NEW;

   PUBLIC OPERATOR DISPOSE( a : ADDRESS );
   BEGIN
   END DISPOSE;

END C6;

CLASS IMPLEMENTATION C7;

   PUBLIC VIRTUAL PROCEDURE IB();
   BEGIN
   END IB;

   PUBLIC VIRTUAL OPERATOR =( CONST Value : I2 ) : BOOLEAN;
   BEGIN
      RETURN FALSE;
   END =;

END C7;

PROCEDURE X();
VAR
   PI1 : POINTER TO I1 := NIL;
   PI2 : POINTER TO I2 := NIL;
   PI3 : POINTER TO I3 := NIL;
   PC1 : POINTER TO C1 := NIL;
   PC2 : POINTER TO C2 := NIL;
   PC3 : POINTER TO C3 := NIL;
   PC4 : POINTER TO C4 := NIL;
   PC5 : POINTER TO C5 := NIL;
   PC6 : POINTER TO C6 := NIL;
   VC1 : C1;
   VC2 : C2;
   VC3 : C3;
BEGIN
   // PI1 := PI2; // error
   // PI2 := PI1; // error

   PI1 := PC4; // OK
   PI2 := PI3; // OK
   PI2 := PC5; // OK
   PI2 := PC6; // OK
   PC1 := PC4; // OK
   // PI3 := PI1; // error
   
   // IF PI2 = PC6 THEN END; // error
   
   IF PI2 = PI3 THEN END; // OK
   
   // IF PC2 = PC3 THEN END; // error
   
   IF VC2 = VC3 THEN END; // OK
   // VC2 := VC3; // error
   
   PI2 := PC2;

   VC1 := VC1; // OK  
   IF VC1 = VC1 THEN END; // OK
   VC2 := VC2; // OK
   IF VC2 = VC2 THEN END; // OK
   
   // IF PI1^ = VC1 THEN END; // error
   IF PI2^ = VC2 THEN END; // OK
END X;

END interfacecompatibility.