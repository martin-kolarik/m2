MODULE classcomparemembers;

CLASS C1;
  VIRTUAL PROCEDURE P() : INTEGER;
END C1;

CLASS IMPLEMENTATION C1;

  VIRTUAL PROCEDURE P() : INTEGER;
  BEGIN
    RETURN 0;
  END P;

END C1;

CLASS C2( C1 );
  VIRTUAL PROCEDURE P() : INTEGER;
END C2;

CLASS IMPLEMENTATION C2;

  VIRTUAL PROCEDURE P() : INTEGER;
  BEGIN
    RETURN 0;
  END P;

END C2;

END classcomparemembers.