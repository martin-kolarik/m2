MODULE operators;

CLASS C;
  VIRTUAL OPERATOR +( CONST O : C ) : INTEGER;
  OPERATOR :=( CONST O : C ) : C;
  VIRTUAL PROCEDURE X() : BOOLEAN;
END C;

CLASS IMPLEMENTATION C;

  VIRTUAL OPERATOR C.+( CONST O : C ) : INTEGER;
  BEGIN
    RETURN 0;
  END C.+;

  OPERATOR C.:=( CONST O : C ) : C;
  BEGIN
    RETURN SELF;
  END C.:=;
  
  VIRTUAL PROCEDURE X() : BOOLEAN;
  BEGIN
    RETURN FALSE;
  END X;

END C;

CLASS A( C );
  VIRTUAL OPERATOR +( CONST O : C ) : INTEGER;
  VIRTUAL PROCEDURE X() : BOOLEAN;
END A;

CLASS IMPLEMENTATION A;

  VIRTUAL OPERATOR A.+( CONST O : C ) : INTEGER;
  BEGIN
    RETURN 0;
  END A.+;

  VIRTUAL PROCEDURE A.X() : BOOLEAN;
  BEGIN
    RETURN FALSE;
  END A.X;

END A;

CLASS D;
  VIRTUAL OPERATOR +( CONST O : C ) : INTEGER;
  VIRTUAL PROCEDURE X() : BOOLEAN;
END D;

CLASS IMPLEMENTATION D;

  VIRTUAL OPERATOR D.+( CONST O : C ) : INTEGER;
  BEGIN
    RETURN 0;
  END D.+;

  VIRTUAL PROCEDURE D.X() : BOOLEAN;
  BEGIN
    RETURN FALSE;
  END D.X;

END D;

CLASS E;
END E;

CLASS IMPLEMENTATION E;
BEGIN
END E;

CLASS F;
  INITIALLY F();
END F;

CLASS IMPLEMENTATION F;

  INITIALLY F();
  BEGIN
  END F;

END F;

CLASS EA;
  OPERATOR :=( CONST O : EA ) : EA;
END EA;

CLASS IMPLEMENTATION EA;

  OPERATOR EA.:=( CONST O : EA ) : EA;
  BEGIN
    RETURN SELF;
  END EA.:=;

BEGIN
END EA;

CLASS FA;
  OPERATOR :=( CONST O : FA ) : FA;
  INITIALLY FA();
END FA;

CLASS IMPLEMENTATION FA;

  OPERATOR FA.:=( CONST O : FA ) : FA;
  BEGIN
    RETURN SELF;
  END FA.:=;

  INITIALLY FA();
  BEGIN
  END FA;

END FA;

END operators.