MODULE indexingofsuperclass;

CLASS C;
  PUBLIC READONLY INDEX( I : INTEGER ) : INTEGER;
END C;

CLASS IMPLEMENTATION C;
  PUBLIC READONLY INDEX C GET( I : INTEGER ) : INTEGER;
  BEGIN
    RETURN 0;
  END C;
END C;

CLASS A( C );
  PROCEDURE M();
END A;

CLASS IMPLEMENTATION A;
  PROCEDURE M();
  BEGIN
    IF C[0] = 0 THEN
    END;
  END M;
END A;

END indexingofsuperclass.