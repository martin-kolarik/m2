DEFINITION MODULE implements;

ABSTRACT CLASS C0;
  ABSTRACT PROCEDURE A();
END C0;

INTERFACE I0;
  PROPERTY IP : CARDINAL;
  PROCEDURE IA();
END I0;

INTERFACE I1( I0 );
  PROCEDURE IB();
END I1;

