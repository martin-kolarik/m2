MODULE frames;

(*===========================================================================*)

TYPE
  TPA = POINTER TO CA;

CLASS CA;
  A : CARDINAL;
END CA;

TYPE
  TPB = POINTER TO CB;

CLASS CB;
  PA : TPA;
END CB;

CLASS CMAIN;
  VAR
    A, B : LONGREAL;
    PB : TPB;
  PROCEDURE METHOD1();
  PROCEDURE METHOD2();
END CMAIN;

CLASS IMPLEMENTATION CA;
END CA;

CLASS IMPLEMENTATION CB;
END CB;

CLASS IMPLEMENTATION CMAIN;

  PROCEDURE CMAIN.METHOD1();

    PROCEDURE INNERMETHOD1();
    BEGIN
      A := B;
      WITH PB^.PA^ DO
        IF A = 0 THEN END;
      END; // WITH
    END INNERMETHOD1;

    PROCEDURE INNERMETHOD0();
    BEGIN
      INNERMETHOD0();
      INNERMETHOD1();
    END INNERMETHOD0;

  BEGIN
    INNERMETHOD0();
    INNERMETHOD1();
  END CMAIN.METHOD1;

  PROCEDURE CMAIN.METHOD2();
  BEGIN
    METHOD1();
    IF PB^.PA^.A = 0 THEN END;
  END CMAIN.METHOD2;

END CMAIN;

PROCEDURE MAIN( MAINP : LONGREAL );
VAR
  MAINL : LONGREAL;
  MAINX : LONGREAL;

  PROCEDURE INNER0();
  BEGIN
  END INNER0;

  PROCEDURE INNER1( INNERP : LONGREAL );
  VAR
    INNERL : LONGREAL;
  BEGIN
    INNERL := INNERP;
  END INNER1;

  PROCEDURE INNER2();
  VAR
    INNERL : LONGREAL;
  BEGIN
    INNERL := MAINL;
    INNER1( INNERL + MAINL + MAINP );
  END INNER2;

  PROCEDURE INNER12( INNERP : LONGREAL );
  VAR
    INNERL : LONGREAL;
  BEGIN
    INNERL := INNERP;
    INNER2();
  END INNER12;

  PROCEDURE INNER4( INNERP : LONGREAL );
  VAR
    INNERL : LONGREAL;
  BEGIN
    INNERL := INNERP;
  END INNER4;

  PROCEDURE INNER3( INNERP : LONGREAL );
  VAR
    INNERL : LONGREAL;
  BEGIN
    INNERL := MAINL + INNERP;
    INNER2();
    INNER4( 1.0 );
  END INNER3;

  PROCEDURE INNEREX0();

    PROCEDURE INNEREX01();

      PROCEDURE INNEREX02();
      BEGIN
        MAINL := MAINL;
      END INNEREX02;

    BEGIN
    END INNEREX01;

    PROCEDURE INNEREX02();
    BEGIN
      INNEREX01();
    END INNEREX02;

  BEGIN
  END INNEREX0;

BEGIN
  MAINL := 1.0;
  MAINP := 1.0;
  MAINX := 1.0;
  INNER1( 1.0 );
  INNER12( 1.0 );
  INNER2();
  INNER3( 1.0 );
END MAIN;

(*===========================================================================*)

BEGIN
END frames.