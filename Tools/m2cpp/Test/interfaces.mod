MODULE interfaces;

INTERFACE A;
  COM WRITEONLY
    INDEX( Index : LONGINT ) : CARDINAL;
  VIRTUAL PROPERTY
    P1 : CARDINAL;
    P2 : POINTER TO CARDINAL;
  VIRTUAL READONLY PROPERTY
    R1 : CARDINAL;
    R2 : POINTER TO CARDINAL;
  COM PROPERTY
    S1 : CARDINAL;
    REF S2 : POINTER TO CARDINAL;
  COM READONLY PROPERTY
    T1 : CARDINAL;
    REF T2 : POINTER TO CARDINAL;
  COM PROCEDURE M3() : CARDINAL;
  VIRTUAL PROCEDURE M1() : CARDINAL;
  PROCEDURE M2() : CARDINAL;
END A;

INTERFACE B( A );
END B;

CLASS C( B );
  PUBLIC COM WRITEONLY
    INDEX( Index : LONGINT ) : CARDINAL;
  PUBLIC COM PROPERTY
    S1 : CARDINAL;
    REF S2 : POINTER TO CARDINAL;
    REF S3 : POINTER TO C;
  PUBLIC VIRTUAL PROCEDURE M1() : CARDINAL;
  PUBLIC VIRTUAL PROCEDURE M2() : CARDINAL;
  PUBLIC COM PROCEDURE M3() : CARDINAL;
  PUBLIC COM PROCEDURE M4( BV : BOOLEAN ) : CARDINAL;
  PUBLIC COM PROCEDURE M5( BV : BOOLEAN );
END C;

CLASS IMPLEMENTATION C;

  PUBLIC COM INDEX C SET( Index : LONGINT; Value : CARDINAL );
  VAR
    LC : CARDINAL;
  BEGIN
    SELF[0] := 3 + M3() + M4( FALSE );
    LC := M3();
    LC := M4( FALSE );
    M5( FALSE );
  END C;

  PUBLIC COM PROPERTY S1 GET : CARDINAL;
  BEGIN
    RETURN SELF.P1 + P2^ + SELF.S1 + S2^ + SELF.S2^ + S3^.S2^ + SELF.S3^.S2^;
  END S1;

  PUBLIC COM PROPERTY S1 SET( Value : CARDINAL );
  BEGIN
    P1 := 5;
    Value := -1;
    P2 := S2;
    Value := -1;
    S1 := 5;
    Value := -1;
    S2 := S2;
  END S1;

  PUBLIC COM PROPERTY S2 GET : POINTER TO CARDINAL;
  BEGIN
    RETURN S2;
  END S2;

  PUBLIC COM PROPERTY S2 SET( Value : POINTER TO CARDINAL );
  BEGIN
  END S2;

  PUBLIC COM PROPERTY S3 GET : POINTER TO C;
  BEGIN
    RETURN S3;
  END S3;

  PUBLIC COM PROPERTY S3 SET( Value : POINTER TO C );
  BEGIN
  END S3;

  PUBLIC VIRTUAL PROCEDURE M1() : CARDINAL;
  BEGIN
    RETURN 0;
  END M1;

  PUBLIC VIRTUAL PROCEDURE M2() : CARDINAL;
  BEGIN
    RETURN 0;
  END M2;

  PUBLIC COM PROCEDURE M3() : CARDINAL;
  BEGIN
    RETURN 0;
  END M3;

  PUBLIC COM PROCEDURE M4( BV : BOOLEAN ) : CARDINAL;
  BEGIN
    RETURN 0;
  END M4;

  PUBLIC COM PROCEDURE M5( BV : BOOLEAN );
  BEGIN
  END M5;

END C;

TYPE
  BSTR = ADDRESS;
  TPIXMLNode = POINTER TO IXMLNode;

INTERFACE IXMLDOMSelection;
  COM PROPERTY
    expr : BSTR;
    REF context : TPIXMLNode;
END IXMLDOMSelection;

END interfaces.