DEFINITION MODULE DOM;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

(*# call( o_a_copy => off ) *)

IMPORT
  FIO,
  list,
  lists,
  avltree,
  stacks,
  time;
  
IMPORT
  Strings,
  StringsO;

IMPORT
  Generator,
  Parser,
  Scanner;

//============================================================

TYPE
  TPUnit            = POINTER TO CUnit;
  TPSymbol          = POINTER TO CSymbol;
  TPSymbols         = POINTER TO CSymbols;

  TPLabel           = POINTER TO CLabel;
  TPConstant        = POINTER TO CConstant;
  TPVariable        = POINTER TO CVariable;
  TPTPVariable      = POINTER TO TPVariable;
  TPSelf            = POINTER TO CSelf;

  TPType            = POINTER TO CType;
  TPTPType          = POINTER TO TPType;
  TPArray           = POINTER TO CArray;
  TPSet             = POINTER TO CSet;
  TPRecord          = POINTER TO CRecord;
  TPEnumeration     = POINTER TO CEnumeration;
  TPSubrange        = POINTER TO CSubrange;
  TPProcedureType   = POINTER TO CProcedureType;
  TPProcedure       = POINTER TO CProcedure;
  TPFormalType      = POINTER TO CFormalType;
  TPParameterContainer
                    = POINTER TO CParameterContainer;
  TPNestedParameters= POINTER TO CNestedParameters;
  TPNestedFrames    = POINTER TO CNestedFrames;

  TPClass           = POINTER TO CClass;
  TPClassDecl       = POINTER TO CClassDecl;
  TPMember          = POINTER TO CMember;
  TPMethodDecl      = POINTER TO CMember;
  TPPropertyDecl    = POINTER TO CPropertyDecl;
  TPIndexerDecl     = POINTER TO CIndexerDecl;
  TPOperatorDecl    = POINTER TO COperatorDecl;

  TPModule          = POINTER TO CModule;

  TPVarDeclContainer= POINTER TO CVarDeclContainer;
  TPPropertyDef     = POINTER TO CPropertyDef;
  TPIndexerDef      = POINTER TO CIndexerDef;
  TPOperatorDef     = POINTER TO COperatorDef;

  TPExpression      = POINTER TO CExpression;
  TPENode           = POINTER TO CENode;
  TPEValue          = POINTER TO CEValue;
  TPTypedContainer  = POINTER TO CTypedContainer;
  TPProcedureCall   = POINTER TO CProcedureCall;

  TPDesignator      = POINTER TO CDesignator;
  TPPDesignator     = POINTER TO TPDesignator;

  TPStatement       = POINTER TO CStatement;
  TPSAssignment     = POINTER TO CSAssignment;
  TPSReturn         = POINTER TO CSReturn;
  TPSLabel          = POINTER TO CSLabel;
  TPSLoop           = POINTER TO CSLoop;
  TPSFor            = POINTER TO CSFor;
  TPSGoto           = POINTER TO CSGoto;
  TPSASM            = POINTER TO CSASM;
  TPSTRY            = POINTER TO CSTRY;

//============================================================

TYPE
  TEO = (
    opUnknown, opAssign, opConcat, opNEW, opDISPOSE,
    opAdd, opSub, opDiv, opMult, opIDiv, opRem, opMod, opLShift, opRShift,
    opEQ, opNEQ, opLT, opGT, opLTE, opGTE, opIN, opNotIN, opISExact, opISInherits,
    opORL, opORB, opANDL, opANDB, opEORB,
    opSgnP, opSgnM, opNotL, opNotB,
    opAddSET, opSubSET, opMultSET, opDivSET,
    opSubExpr
  );
  TopS = ARRAY [0..7] OF WCHAR;
  TopSs = ARRAY TEO OF TopS;

CONST
  opString = TopSs(
    TopS( L'?'  ), TopS( L'='  ), TopS( L'?' ), TopS( L'new'  ), TopS( L'delete'  ),
    TopS( L'+'  ), TopS( L'-'  ), TopS( L'/' ), TopS( L'*' ), TopS( L'?'  ), TopS( L'?'  ), TopS( L'%' ), TopS( L'<<' ), TopS( L'>>' ),
    TopS( L'==' ), TopS( L'!=' ), TopS( L'<' ), TopS( L'>' ), TopS( L'<=' ), TopS( L'>=' ), TopS( L'?' ), TopS( L'?'  ), TopS( L'?'  ), TopS( L'?'  ),
    TopS( L'?'  ), TopS( L'|'  ), TopS( L'?' ), TopS( L'&' ), TopS( L'^'  ),
    TopS( L'?'  ), TopS( L'?'  ), TopS( L'!' ), TopS( L'~' ),
    TopS( L'|'  ), TopS( L'&~'  ), TopS( L'&' ), TopS( L'^' ),
    TopS( L'?' )
  );

TYPE
  TUnitKind = (
    ukUnknown,
    ukForwardedTypes,
    ukNestedForwardedFrame,
    ukNestedForwardedSymbols,
    ukNestedForwardedFrames,
    ukNestedForwardedProcedures,
    ukForwardedStatements,

    ukRegionMark,
    
    ukProgram,
    ukDefinition,
    ukImplementation,
      ukModuleInitCode,
      ukModuleFinalCode,

    ukImport,
      ukImportExternal,
    ukLabelDecl,
    ukConstDeclBlock,
      ukCmdLineConstDecl,
      ukSimpleConstDecl,
      ukClassConstDecl,
    ukTypeDefBlock,
      ukSimpleTypeDef,
      ukClassTypeDef,
        ukEnumItemImplicit,
        ukEnumItemExplicit,
      ukOpaqueClassType,
      ukOpaqueTypeDeclaration,
    ukVarDeclBlock,
      ukVarDeclContainer,
        ukSimpleVarDecl,
        ukClassVarDecl,
        ukSelf,
        ukADRSelf,
    ukProcedureDef,
      ukParameterList,
        ukParamDefContainer,
          ukParamDef,
          ukNestedParamDef,
    ukProcedureDecl,
      ukProcedureBlock,
        ukBlockBody,
        ukBlockBodyOfCOMProcedure,
        ukBlockBodyOfReturnInTryProc,
        ukBlockBodyOfReturnInTryFunc,
        ukEntryPointReturnType,
        ukClassInitStart,
    ukProcedureCall,
      ukActualParameterList,
        ukParameterContainer,
    ukNestedProcedureDecl,
      ukNestedParameters,
        ukNestedParameter,
      ukNestedFrames,
        ukNestedFrame,
        ukNestedClassFrame,

    ukSAssignment,
    ukSCall,
    ukSAssignmentByCall1, // without arguments in designator part
    ukSAssignmentByCall2, // with arguments in designator part
    ukSAssignmentByRetvalCall, // with argument of call, which fills the assigned argument
    ukSAssignmentStringByEmbeddedCall,
    ukSAssignmentSetByEmbeddedCall,

    ukReturn,
      ukReturnInCOM,
      ukReturnInThrowing,
      ukReturnInCPPTry,
      ukThrowingInCPPTry,
    ukIf,
      ukIfExpr,
        ukIfBlock,
      ukElsifExpr,
        ukElsifBlock,
      ukElse,

    ukSimpleClassDef,
    ukClassClassDef,
      ukMethodDef,
      ukIndexerDef,
      ukOperatorDef,
      ukPropertyDef,
    ukClassDecl,
      ukClassInitCode,
      ukClassFinalCode,
      ukMethodDecl,
      ukIndexerDeclR,
      ukIndexerDeclW,
      ukOperatorDecl,
      ukPropertyDeclR,
      ukPropertyDeclW,
      ukFriends,
        ukFriendWrapper,

    ukDesignator,
      ukVariableDesignator,
      ukAssignmentDesignator,
      ukWithDesignator,

    ukExpression,
      ukValue,
      ukTypedContainer,
      ukCall,
    
    ukFieldIds,
    ukVariantContainer,
      ukVariantSelector,    
      ukVariantItem,
        ukVariantLabel,
      ukVariantElse,

    ukSCase,
      ukCaseSelector, 
      ukCaseLabel,
      ukCaseItem,
      ukCaseElse,

    ukSWhile,
      ukWhileCondition,
      ukWhileBody,

    ukSRepeat,
      ukRepeatBody,
      ukRepeatCondition,

    ukSLoop,

    ukSFor,
      ukSForBody,
      
    ukSTry,
      ukTryBlock,
      ukTrySEHBlock,
      ukExceptBlock,
      ukExceptSEHExpression,
      ukExceptDoBlock,
      ukFinallyCPPBlock,
      ukFinallySEHBlock,
      ukFinallyDelete,

      ukCatchBlock,
      ukCatchAnyBlock,
      ukCatchVarDecl,
      ukCatchDoBlock,

    ukSThrow
      
  );
  TUnitKindSet = SET OF TUnitKind;
  
CONST
  uksRoutineDef = TUnitKindSet{
    ukProcedureDef,
    ukMethodDef,
    ukIndexerDef,
    ukOperatorDef,
    ukPropertyDef
  };
  uksRoutineDecl = TUnitKindSet{
    ukProcedureDecl,
    ukClassInitCode,
    ukClassFinalCode,
    ukMethodDecl,
    ukIndexerDeclR,
    ukIndexerDeclW,
    ukOperatorDecl,
    ukPropertyDeclR,
    ukPropertyDeclW
  };
  uksMemberDecl = TUnitKindSet{
    ukClassInitCode,
    ukClassFinalCode,
    ukMethodDecl,
    ukIndexerDeclR,
    ukIndexerDeclW,
    ukOperatorDecl,
    ukPropertyDeclR,
    ukPropertyDeclW
  };

TYPE
  TCompileState = (
    csUnknown,
    csPending,
    csCompiled,
    csError
  );

  TImplementationState = (
    isUnknown,
    isDefined,
    isForwarded,
    isImplementedA,
    isImplementedR,
    isImplementedW
  );

  TGenerateUnitMode = (
    gumUnknown,
    gumEmpty, // a separator will be deprecated too

    gumSimple, // GenHead and nothing
    gumSimpleWithTrailing, // GenHead and GenHead

    gumIndent, // GenHead, indent, GenBody, GenTail
    gumNoIndent // GenHead, GenBody, GenTail
  );

  TGenerateControlItem = (
    // main
    gcDefault,
      gcDeferredFromDEF,
    gcExplicitLeading,
      gcForceArraySize,
      gcForceFormalParameterAddOn, // generates * or & according to parameter type
      gcForceFormalFrameAddOn, // generates * according to parameter type (for CONST too)
    gcExplicitTrailing,
    gcName,
      gcLValue,
      gcRValue,
      gcNameNested,
      gcCast,
      gcSimple,

    // helpers
    gcPassNestedTopLevel, // frame or super procedure or element of super procedure is generated as parameter
    gcPassNestedInNested, // frame or super procedure or element of super procedure is generated as parameter
    gcCharLiteralAsStringForOA, // char literals passed into open array will be generated as string
    gcStringLiteralAsChars, // constant of typed array of char is defined using string literal and the literal is length exactly as array is

    // misc
    gcFirst, // generated unit is first in owner
    gcForward, // informational, for indenting and commenting, generates function prototype
    gcLValueType // type container/cast is LValue (for NEW)
  );
  TGenerateControl = SET OF TGenerateControlItem;

CONST
  gcExplicit           ::= gcExplicitLeading;
  gcsDefault           = TGenerateControl{gcDefault};
  gcsExplicit          = TGenerateControl{gcExplicit};
  gcsExplicitArray     = TGenerateControl{gcExplicit, gcForceArraySize};
  gcsExplicitParameter = TGenerateControl{gcExplicit, gcForceFormalParameterAddOn};
  gcsName              = TGenerateControl{gcName};
  gcsCast              = TGenerateControl{gcName, gcCast};
  gcsNameNested        = TGenerateControl{gcName, gcNameNested};
  gcsNameSimple        = TGenerateControl{gcName, gcSimple};
  gcsPassNestedTop     = TGenerateControl{gcPassNestedTopLevel};
  gcsPassNested        = TGenerateControl{gcPassNestedInNested};
  gcsForward           = TGenerateControl{gcForward};
  gcsAssignment        = TGenerateControl{gcName, gcLValue};
  gcsDesignator        = TGenerateControl{gcName, gcRValue};

TYPE
  TEnvironmentOptionsItem = (
    coFileNotFound,
    coSolveTimestamps,
    coDependsOnNewerDEF,
  
    coOASize,
    coVarArg,
    coCArrays,
    coMacro,
    coResultOptional,
    coParamsInFrame,

    cpUndefined,
    cpCDecl,
    cpStdCall,
    cpFastCall,

    eoCPPExceptions, // otherwise self exceptions are used
    eoLeakChecking,
    eoVolatile,
    eoExport,
    eoPublishExports, // -LD
    eoCharEscape,
    eoQualifiedEnum,
    eoWCHAR,
    eoUntypedConstAsDefine,
    eoSizeAsTypes,
    eoRegion,
    eoISOClassImplementation,
    eoAssertAllowed,
    eoDebuggedAllowed,
    eoCOMExtensionAllowed,

    // compile time options
    eoUnnamed, // for structured types
    eoDLLInterface,
    eoReferenced,
    eoInitialized,
      eoClassInitialized, // specially set for class variables
      eoClassInitializedVariables,
    eoClassInner, // type or constant is a part of class
    eoMovedToFrame, // variable became part of frame
    eoForwarded, // type or constant was moved to forwad place
    eoForward, // symbol is forward
    eoProcessed, // symbols is already marked to be generated as forward or to be generated as friend
    eoStringLiteralAsChars, // see gcStringLiteralAsChars
    eoASMBlock, // current ntBlock contains ASM, this controls reporting of uninitalized variables
    // modules, classes
    eoInitially,
    eoFinally,
    eoVirtualFinally, // the class or ancestor defines virtual destructor, so all descendants must have destructor virtual too
    eoVMT, // the class have some virtual member
    eoAssignSelf,
    eoHaveReturnInCPPTry, // proecdure contains TRY in CPP style
      eoInsideCPPTry, // for proper RETURN/FINALLY handling, SEHTry this solves by itself
      eoTryReturnsValue,
    eoReturnInRetval, // COM methods, throwing methods
      eoCOM,
      eoThrowing,
    eoLeakInfo
  );
  TEnvironmentOptions = SET OF TEnvironmentOptionsItem;
  
CONST
  cpsAll         = TEnvironmentOptions{cpUndefined, cpCDecl, cpStdCall, cpFastCall};
  cpsUndefined   = TEnvironmentOptions{cpUndefined};
  cpsCDecl       = TEnvironmentOptions{cpCDecl};
  cpsStdCall     = TEnvironmentOptions{cpStdCall};
  cpsFastCall    = TEnvironmentOptions{cpFastCall};

TYPE  
  TValueInfoItem = (
    viConst, // constant value
    viCONST, // CONST modifier
    viLiteral, // always viConst
    viLValue,
    viClassLValue, // a special syntactical form of LValue
    viAuxiliaryConst,
    viPropertyAssign,
    viOperatorAssign,
    viIndexerAssign,
    viCOMProcedure,
    viStructuredType
  );
  TValueInfo = SET OF TValueInfoItem;
CONST
  visOverwrittenAssignment = TValueInfo{viPropertyAssign, viIndexerAssign, viOperatorAssign};  
  visLValue                = TValueInfo{viLValue, viClassLValue, viPropertyAssign, viIndexerAssign, viOperatorAssign};  

CLASS CUnit( list.CListElem );
  UnitKind            : TUnitKind;
  ImplementationState : TImplementationState;
  CompileState        : TCompileState;
  Options             : TEnvironmentOptions;
  Owner               : TPUnit;
  Childs              : list.CList;
  Current             : TPUnit;
  GenTo               : ARRAY Generator.TGenerate OF BOOLEAN;

  PROCEDURE Add( Unit : TPUnit );
  PROCEDURE GetFirst( VAR Unit : TPUnit ) : BOOLEAN;
  PROCEDURE GetNext( VAR Unit : TPUnit ) : BOOLEAN;
  READONLY PROPERTY Empty : BOOLEAN;
  PROCEDURE Items() : CARDINAL;

  PROCEDURE Generate( G : Generator.TPGenerator; C : TGenerateControl ) : TGenerateUnitMode;

  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;
  VIRTUAL PROCEDURE GenBody( G : Generator.TPGenerator; C : TGenerateControl; Indent : BOOLEAN; Context : CARDINAL );
  VIRTUAL PROCEDURE GenSep( CONST BeforeU : TPUnit; G : Generator.TPGenerator; C : TGenerateControl );
  VIRTUAL PROCEDURE GenTail( G : Generator.TPGenerator; C : TGenerateControl; Context : CARDINAL );

  INITIALLY CUnit();
END CUnit;

//============================================================

TYPE
  TSymbolKind = (
    skUnknown,
    skModule,
    skLabel,
    skConstant,
    skType,
    skVariable,
    skProcedure,
    skClass,
    skProperty,
    skMethod,
    skIndexer,
    skOperator
  );

TYPE
  TSymbolAccess = (
    saUnknown,
    saDirect,
    saParentProcedureVariable,
    saChildProcedureCall,
    saParentObject,
    saParentObjectSymbol,
    saPeerProcedureCall
  );
  TPSymbolAccess = POINTER TO TSymbolAccess;

TYPE
  TAccessModifier = (
    amUnknown,
    amPrivate,
    amInternal,
    amLocal,
    amPublic
  );

TYPE
  TCodeModifierItem = (
    cmRO, cmWO, // disjunct
    cmINLINE,
    cmREF
  );
  TCodeModifier = SET OF TCodeModifierItem;

TYPE
  TInheritanceModifierItem = (
    imAbstract,
    imVirtual,
    imFinal,
    imInterface,
    imCOM
  );
  TInheritanceModifier = SET OF TInheritanceModifierItem;

CLASS CSymbol( CUnit );
  SymbolKind : TSymbolKind;
  N          : StringsO.CString;
  T          : TPType;
  OfSymbol   : TPSymbol; // if symbol is member of complex one
  AM         : TAccessModifier;
  CM         : TCodeModifier;
  NSD        : CUnit; // nested data (constants, types) generated as standalone forward to this unit
  
  PUBLIC VIRTUAL READONLY PROPERTY
    Symbols : TPSymbols;

  VIRTUAL PROCEDURE Done();
  PROCEDURE DoneAndFree();
  PROCEDURE AddForwardedUnit( Unit : TPUnit );

  PROCEDURE IsModule() : BOOLEAN;
  PROCEDURE IsClass() : BOOLEAN;
  PROCEDURE IsProcedure( AllowTypes : BOOLEAN ) : BOOLEAN;

  PROCEDURE GetN( C : TGenerateControl; AppendFlag : BOOLEAN; REF CS : StringsO.CString );
  PROCEDURE GetQN( C : TGenerateControl; REF CS : StringsO.CString );
  PROCEDURE GetSourceQN( OUT CS : StringsO.CString );
  PROCEDURE GetFullSourceQN( OUT CS : StringsO.CString );
  PROCEDURE OutN( G : Generator.TPGenerator; C : TGenerateControl );
  PROCEDURE OutQN( G : Generator.TPGenerator; C : TGenerateControl );

  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;
END CSymbol;

//------------------------------------------------------------

CLASS CSymbols( avltree.CAVLTree );
  OfSymbol : TPSymbol;

  Current : TPSymbol; // for Reset, MoveNext
  CurrentSTE : ADDRESS; // for Reset, MoveNext

  AnonCount : CARDINAL; // anonymous symbols count
  
  StartLine : CARDINAL := 1;
  StartColumn : CARDINAL := 1;
  StopLine : CARDINAL := -1;
  StopColumn : CARDINAL := -1;

  PROCEDURE Knows( Symbol : TPSymbol ) : BOOLEAN;
  PROCEDURE Add( Symbol : TPSymbol );
  PROCEDURE Forget( Symbol : TPSymbol ) : BOOLEAN;
  PROCEDURE Get( CONST Name : StringsO.CString; VAR Symbol : TPSymbol ) : BOOLEAN;
  PROCEDURE GetCI( CONST Name : StringsO.CString; VAR Symbol : TPSymbol ) : BOOLEAN; // CaseInsensitive
  PROCEDURE GetS( Name : ARRAY OF WCHAR; VAR Symbol : TPSymbol ) : BOOLEAN;

  PROCEDURE Reset();
  PROCEDURE MoveNext() : BOOLEAN;
END CSymbols;

//------------------------------------------------------------

CLASS CSymbolsStack( stacks.CPtrStack );
  CurC : TPClass;
  CurP : TPProcedureType;
  PROCEDURE Push( CONST Symbols : TPSymbols; EnterChangesContext : BOOLEAN; WithDesignator : TPDesignator );
  PROCEDURE Pop() : TPSymbols;
END CSymbolsStack;

//============================================================

CLASS CLabel( CSymbol );
  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;
END CLabel;

//============================================================

TYPE
  TOrdinalKind = (
    okUnknown,
    okDecimal,
    okHexadecimal,
    okOctal,
    okBinary,
    okCharacter
  );

CLASS CConstant( CSymbol );
  IsLinkOf              : TPSymbol;
  DeclarationExpression : TPExpression;

  PROCEDURE Init2( T : TPType; DecimalLiteral : ARRAY OF WCHAR );

  PROCEDURE Unwrap() : TPSymbol;

  PROCEDURE LinkOf() : TPSymbol;
  PROCEDURE SetLinkOf( Link : TPSymbol );

  PROCEDURE Expression() : TPExpression;
  PROCEDURE SetExpression( Expression : TPExpression );

  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;
END CConstant;

//============================================================

TYPE
  TTypeKind = (
    tkUnknown,
    tkLink, // this covers language aliases too

    tkOpaqueBase, // TYPE X = POINTER TO opaque;                                  \ must be sequential
      tkOpaqueBaseLink, // firstly opaque types, secondly links to their source   /
    tkOpaqueWhole, // TYPE X;                                                     \ must be sequential
      tkOpaqueWholeLink, // firstly opaque types, secondly links to their source  /
    tkMorphable, // types of literals like OrdinalNumber, etc.

    tkPrimitive,

    tkOpenArray,
    tkStringArray,

    tkArray,
    tkSet,
    tkRecord,
    tkEnumeration,
    tkRange,
    tkReference,
    tkProcedure,
    tkClass
  );

  TTypeKindSet = SET OF TTypeKind;
CONST
  typeLinks = TTypeKindSet{tkLink, tkOpaqueBaseLink, tkOpaqueWholeLink};
  
TYPE
  TPrimitiveType = (
    ptUnknown,
    ptStructure,

    ptINT8,    ptINT16,    ptINT32,    ptINT64,
    ptCARD8,   ptCARD16,   ptCARD32,   ptCARD64,
    ptBCHAR,   ptWCHAR,    ptBOOLEAN,

    ptBITSET8, ptBITSET16, ptBITSET32, ptBITSET64,
    ptBYTE,    ptWORD,     ptLONGWORD, ptQUADWORD,
    ptREAL,    ptLONGREAL, ptTEMPREAL,
    
    ptADDRESS, ptPTR,      ptSIZE,
    ptPROC,    ptOBJECT
  );

  TTypeModifier = (
    tmUnknown,
    tmVAR,
    tmREF,
    tmCONST,
    tmOUT
  );

  TCompatibilityMode = (
    cmOperation,
    cmAssign,
    cmOperatorParameter, // any operator, the parameter is passed into operator function parameter
    cmExact // not implemented
  );

  TCastInfoItem = (
    ciCast, // simple cast applied
    ciCastConstPointer, // (const T&)(...))
    ciStructure, // casted using (*(T*)&(...)) -- !! requires terminating cast after term (using "))")
    ciReference // referenced
  );
  TCastInfo = SET OF TCastInfoItem;

CLASS CType( CSymbol );
  TypeKind : TTypeKind;
  PrimitiveType : TPrimitiveType;
  UW : TPType; // unwrapped shortcut
  Packing : CARDINAL;

  PROCEDURE Init2( Name : ARRAY OF WCHAR; TK : TTypeKind );
  PROCEDURE Init3( Name : ARRAY OF WCHAR; TK : TTypeKind; PT : TPrimitiveType );

  PROCEDURE Unwrap() : TPType;
  PROCEDURE UnwrapToFirstType() : TPType;
  PROCEDURE UnwrapToBaseType() : TPType;

  VIRTUAL PROCEDURE IsFormal() : BOOLEAN;
  VIRTUAL PROCEDURE IsOpenArray() : BOOLEAN;
  VIRTUAL PROCEDURE Compatible( CM : TCompatibilityMode; PWith : TPType ) : BOOLEAN;

  VIRTUAL PROCEDURE FirstOrdinal() : INT64;
  VIRTUAL PROCEDURE LastOrdinal() : INT64;
  VIRTUAL PROCEDURE OrdinalRange() : INT64;
  VIRTUAL PROCEDURE CheckIfExpressionFits( E : TPExpression; VAR Ordinal : INT64 ) : BOOLEAN;
  VIRTUAL PROCEDURE OccupiedMemory() : CARDINAL;

  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;
  VIRTUAL PROCEDURE GenerateOrdinal( G : Generator.TPGenerator; Ord : INT64 );

  PROCEDURE CheckAndGenerateCast( G : Generator.TPGenerator; TargetT : TPType; SourceIsConstant : BOOLEAN; VAR CastInfo : TCastInfo );
END CType;

//============================================================

CLASS CArray( CType );
  I      : TPType;
  _Count : INT64;
  _First : INT64;
  _Last  : INT64;

  VIRTUAL PROCEDURE OccupiedMemory() : CARDINAL;
  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;

  PROCEDURE FirstIndex() : INT64;
  PROCEDURE LastIndex() : INT64;
  PROCEDURE High() : CARDINAL;
  PROCEDURE Count() : CARDINAL;
  PROCEDURE GenerateCount( G : Generator.TPGenerator );
END CArray;

//============================================================

CLASS CSet( CArray );
  TU : TPType;
  VIRTUAL PROCEDURE OccupiedMemory() : CARDINAL;
  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;
  PROCEDURE GetItemType() : TPType;
  PROCEDURE IsLong() : BOOLEAN;
END CSet;

//============================================================

TYPE
  TPOrdinalPresence = POINTER TO COrdinalPresence;

CLASS COrdinalPresence( avltree.CAVLTree );
  PROCEDURE Knows( Ordinal1, Ordinal2 : INT64 ) : BOOLEAN;
  PROCEDURE Add( Ordinal1, Ordinal2 : INT64 );
END COrdinalPresence;

//------------------------------------------------------------

CLASS CRecord( CType );
  S : CSymbols;
  Stack : stacks.CPtrStack; // for Constructor

  PUBLIC VIRTUAL READONLY PROPERTY
    Symbols : TPSymbols;

  VIRTUAL PROCEDURE OccupiedMemory() : CARDINAL;

  PROCEDURE ConstructorGetFirst( VAR T : TPType; VAR VariantSelector, Unnamed : BOOLEAN ) : BOOLEAN;
  PROCEDURE ConstructorGetNext( VariantIndex : INT64; VAR T : TPType; VAR VariantSelector, Unnamed : BOOLEAN ) : BOOLEAN;
  PROCEDURE GetIndexOfField( Field : TPSymbol; OUT ItemIndex : INT64 ) : BOOLEAN;

  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;
  VIRTUAL PROCEDURE GenTail( G : Generator.TPGenerator; C : TGenerateControl; Context : CARDINAL );

  // private
  PROCEDURE Add( Symbol : TPSymbol );
  PROCEDURE HandleNestedTypes( c : TPModule );
  PRIVATE PROCEDURE Parse( FirstFlag : BOOLEAN; VariantIndex : INT64; VAR T : TPType; VAR VariantSelector, Unnamed : BOOLEAN; PField : POINTER TO TPSymbol ) : BOOLEAN;
END CRecord;

//------------------------------------------------------------

CLASS CEnumeration( CType );
  S          : CSymbols; // used if enums are qualified
  First      : INT64;
  Last       : INT64;
  Iteratable : BOOLEAN;

