CLASS CProcedureType( CType );
  IM         : TInheritanceModifier;
  S          : CSymbols;
  Parameters : TPUnit;
  OI         : TPProcedure; // of implementation
  Throws     : lists.CPtrList;

  PUBLIC VIRTUAL READONLY PROPERTY
    Symbols : TPSymbols;

  VIRTUAL PROCEDURE Compatible( CM : TCompatibilityMode; PWith : TPType ) : BOOLEAN;

  PROCEDURE GetFirstFormalType( REF Stack : stacks.CPtrStack; OUT FormalType : TPFormalType ) : BOOLEAN;
  PROCEDURE GetNextFormalType( REF Stack : stacks.CPtrStack; OUT FormalType : TPFormalType ) : BOOLEAN;
  PROCEDURE GetFormalType( FirstFlag : BOOLEAN; REF Stack : stacks.CPtrStack; OUT T : TPFormalType ) : BOOLEAN;
  PROCEDURE CompareHeader( WithP : TPProcedureType; OUT Error : CARDINAL ) : BOOLEAN;
  PROCEDURE CopyThrows( From : TPProcedureType );

  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;
  PROCEDURE GenerateThrow( G : Generator.TPGenerator; C : TGenerateControl );
END CProcedureType;

CLASS CProcedure( CProcedureType );
  OD   : TPProcedureType; // of defintion
  NI   : TPProcedure; // nested in
  // NIMC : TPClass; // nested in method of class

  CTDU : TPUnit; // control data container (frames, withs)
  NSP  : CUnit; // nested procedures generated as standalone

  NFT  : TPClass; // nested frame type, type for nested procedures
  NF   : TPNestedFrames; // frames of procedures in which I am nested in
  NP   : TPNestedParameters; // data of procedures in which I am nested in

  VIRTUAL PROCEDURE GenHead( G : Generator.TPGenerator; C : TGenerateControl; VAR Context : CARDINAL ) : TGenerateUnitMode;
  VIRTUAL PROCEDURE GenTail( G : Generator.TPGenerator; C : TGenerateControl; Context : CARDINAL );
  VIRTUAL PROCEDURE GenParameters( G : Generator.TPGenerator; C : TGenerateControl ) : TGenerateUnitMode;

  PROCEDURE AddNestedSymbol( Symbol, FoundIn : TPSymbol ) : TPSymbol;
END CProcedure;

