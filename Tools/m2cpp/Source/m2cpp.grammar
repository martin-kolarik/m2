COMPILER m2

/*------------------------------------------------------------------------*
 *----- SCANNER DESCRIPTION ----------------------------------------------*
 *------------------------------------------------------------------------*/

CHARACTERS

  tab         = '\u0009'. /*  9 := tabulator */
  eol         = '\u000a'. /* 10 := line feed */
  cr          = '\u000d'. /* 13 := carriage RETURN */
  newLine     = cr + eol. /* Line separator character (U+2028) + Paragraph separator character (U+2029) */
  rpar        = ')'.

  letter      = 'A' .. 'Z' + 'a' .. 'z' + '_'.
  digit       = "0123456789".
  hexAdnex    = "ABCDEF".
  hexDigit    = digit + hexAdnex.
  octalDigit  = "01234567".
  binaryDigit = "01".

  charVarA    = ANY - "'" - newLine.
  charVarB    = ANY - '"' - newLine.
  notNewLine  = ANY - newLine.
  notNot      = ANY - '#'.
  ws          = " " + tab + '\u000b' + '\u000c'. /* Any character with Unicode class Zs */

TOKENS

/* ---------- compound tokens */

  ordinal       = digit { digit }
                | digit { digit } CONTEXT ("..").
  hexadecimal   = ( digit | '0' hexAdnex ) { hexDigit } 'H'.
  octal         = octalDigit { octalDigit } 'B'.
  binary        = binaryDigit { binaryDigit } 'L'.
  real          = digit { digit } "." digit { digit } [ "E" [ '+' | '-' ] digit { digit }].

  character     = digit { digit } 'T'.
  bytecharacter = digit { digit } 'C'.
  wordcharacter = digit { digit } 'W'.

  string        = "'" { charVarA } "'" | '"' { charVarB } '"'.
  bytestring    = "C" ( "'" { charVarA } "'" | '"' { charVarB } '"' )
                // |     ( "'" { charVarA } "'" | '"' { charVarB } '"' ) "C"
                .
  wordstring    = "L" ( "'" { charVarA } "'" | '"' { charVarB } '"' )
                | "W" ( "'" { charVarA } "'" | '"' { charVarB } '"' )
                // |     ( "'" { charVarA } "'" | '"' { charVarB } '"' ) "W"
                .

  id            = letter { letter | digit }.
  
/* ---------- operators and special characters needed in LL(1) resolvers */

  aliases            = "::=".
  ampersant          = "&".
  assignment         = ":=".
  at                 = "@".
  dereferencing      = "^".
  division           = "/".
  equals             = "=".
  ellipsis           = "..".
  greaterThan        = ">".
  greaterThanOrEqual = ">=".
  lbrace             = "{".
  lbracket           = "[".
  lessThan           = "<".
  lessThanOrEqual    = "<=".
  lpar               = "(".
  colon              = ":".
  comma              = ",".
  leftShift          = "<<".
  minus              = "-".
  multiplication     = "*".
  notequalsA         = "#".
  notequalsB         = "<>".
  percent            = "%".
  period             = ".".
  pipe               = "|".
  plus               = "+".
  rbrace             = "}".
  rbracket           = "]".
  rpar               = ")".
  rightShift         = ">>".
  semicolon          = ";".
  tilde              = "~".

  // for pragmas
  pragmaThen         = "#then".
  not                = "#not".
  or                 = "#or".
  and                = "#and".
  true               = "#true".
  false              = "#false".
  defined            = "#defined".
  contains           = "#contains".
  startswith         = "#startswith".
  
  // allow reading out ASM..END block
  kwEND              = "END".

/* ---------- keyword names needed in LL(1) resolvers */
/* ---------- types */

PRAGMAS
  /* Preprocessor directives.
   * The exact parsing of their syntax is left for later processing     */

  ppIf      = "#" {ws} "if".                               (. PragmaIf( FALSE ); .)
  ppElsif   = "#" {ws} "elsif" {ws}.                       (. PragmaElsif(); .) // should not be called from here but only from PragmaIf()
  ppElse    = "#" {ws} "else" {notNewLine} newLine.        (. PragmaElse(); .)
  ppEndif   = "#" {ws} "endif" {notNewLine} newLine.       (. PragmaEndif(); .)

  ppRegion  = "#" {ws} "region" {notNewLine} newLine.      (. Pragma( prgRegion ); .)
  ppEndReg  = "#" {ws} "endregion" {notNewLine} newLine.   (. Pragma( prgEndRegion ); .)

  ppPragma1 = "#" {ws} "begin" ws {notNot} "#" {ws} "end". (. Pragma( prgBlock ); .)

  ppPragma2 = "#" {ws} "save" {notNewLine} newLine.        (. Pragma( prgLine ); .)
  ppPragma3 = "#" {ws} "restore" {notNewLine} newLine.     (. Pragma( prgLine ); .)
  ppPragma4 = "#" {ws} "module" {notNewLine} newLine.      (. Pragma( prgLine ); .)
  ppPragma5 = "#" {ws} "name" {notNewLine} newLine.        (. Pragma( prgLine ); .)
  ppPragma6 = "#" {ws} "call" {notNewLine} newLine.        (. Pragma( prgLine ); .)
  ppPragma7 = "#" {ws} "option" {notNewLine} newLine.      (. Pragma( prgLine ); .)

COMMENTS FROM "(*" TO "*)" NESTED
COMMENTS FROM "//" TO eol

IGNORE
  eol + cr + tab

PRODUCTIONS

/*------------------------------------------------------------------------*
 *--------------------------- Declarations -------------------------------*
 *------------------------------------------------------------------------*/

/* =========GRAMMAR ENTRY */

m2                                                         (. Message : ARRAY [0..255] OF WCHAR;
                                                              sL : ARRAY [0..15] OF WCHAR; .)
  = ntCompilationModule                                    (. WHILE PragmaIfStack.Count > 0 DO
                                                                Strings.FromCARD32W( PragmaIfStack.Peek(), 10, OUT sL );
                                                                Strings.ConcatW( OUT Message, L"#if pragma started at line ", sL );
                                                                Strings.AppendW( REF Message, L" is not terminated" );
                                                                PragmaIfStack.Pop();
                                                              END; .)
.

/* =========modules */

ntCompilationModule // !C.1.1
  =                                                        (. c^.UnitKind := DOM.ukProgram;
                                                              c^.eosIF := DOM.TEnvironmentOptions{}; .)
    ntProgramModule
  |                                                        (. c^.UnitKind := DOM.ukDefinition;
                                                              c^.eosIF := DOM.TEnvironmentOptions{DOM.eoDLLInterface}; .)
    ntDefinitionModule
  |                                                        (. c^.UnitKind := DOM.ukImplementation;
                                                              c^.eosIF := DOM.TEnvironmentOptions{}; .)
    ntImplementationModule
.

ntProgramModule // !C.1.2
  = ntModuleBegin                                          (. IF c^.UnitKind = DOM.ukImplementation THEN
                                                                c^.OD := Project.ImportModule( c, c^.Name, TRUE );
                                                                c^.EnterSymbols( c^.SD()^, FALSE, TRUE, NIL ); // DEF
                                                                c^.ASCount := c^.OD^.ASCount; // anonymous type counter must not overlap with DEF
                                                                IF DOM.coDependsOnNewerDEF IN c^.Options THEN
                                                                  // already set
                                                                ELSIF ( DOM.coDependsOnNewerDEF IN c^.OD^.Options ) OR
                                                                      ( INT64( c^.OD^.MEnv.Timestamp ) > INT64( c^.MEnv.Timestamp )) THEN
                                                                  // I'm importing DEF, which is newer than me
                                                                  INCL( c^.Options, DOM.coDependsOnNewerDEF );
                                                                END;
                                                              END;
                                                              c^.EnterSymbols( c^.SC()^, TRUE, TRUE, NIL ); .)
    ntImports                                              (. IF DOM.coSolveTimestamps IN c^.Options THEN
                                                                RETURN;
                                                              END; .)
    ntModuleBlock                                          (. c^.LeaveSymbols( TRUE );
                                                              IF c^.UnitKind = DOM.ukImplementation THEN
                                                                c^.LeaveSymbols( FALSE );
                                                              END; .)
    SYNC kwEND ntIdExpect<c^.OD, FALSE> period
.

ntModuleBegin
  = "MODULE"
    id                                                     (. IF c^.Name.EqualsIgnoreCase( t.Val ) THEN
                                                                Project.AssignFoundCompiledModuleName( c, t.Val );
                                                                c^.OH.Assign( t.Val );
                                                              ELSE
                                                                c^.SemErr( err._ModuleNameFileMismatch );
                                                              END; .)
    [ "HEADER" id                                          (. IF c^.UnitKind = DOM.ukDefinition THEN
                                                                c^.OH.Assign( t.Val );
                                                              ELSE
                                                                c^.SemErr( err._HeaderValidForDEFOnly );
                                                              END; .)
    ]
    semicolon
.
  
ntDefinitionModule // !C.1.3
  = "DEFINITION" ntModuleBegin                             (. c^.EnterSymbols( c^.SD()^, TRUE, TRUE, NIL ); .)
      ntImports                                            (. IF DOM.coSolveTimestamps IN c^.Options THEN
                                                                RETURN;
                                                              END; .)
      ntDefinitions                                        (. c^.LeaveSymbols( TRUE ); .)
    SYNC kwEND ntIdExpect<c, FALSE> period
.

ntImplementationModule // !C.1.4.1
  = "IMPLEMENTATION" ntProgramModule
.

/* =========imports */

ntImports //!C.1.5
  = { ntImport } // ?
.

ntImport // !C.1.5.1
  = ntSimpleImport // *
  | ntQualifiedImport // ?
.

ntSimpleImport // !C.1.5.2
                                                           (. UK : DOM.TUnitKind; .)
  = "IMPORT"                                               (. UK := DOM.ukImport; .)
      // [
      //   "EXTERNAL"                                         (. UK := DOM.ukImportExternal; .)
      // ]                                                  
                                                           (. c^.EnterNewUnit( UK ); .)
      ntImportModuleIdList
      WEAK semicolon                                       (. c^.LeaveUnit(); .)
.

ntQualifiedImport // !C.1.5.3
                                                           (. IA : TIdAction := iaCheck + TIdAction{iaiNotUnwrap};
                                                              Id : DOM.TPSymbol;
                                                              Module : DOM.TPModule;
                                                              U : DOM.TPUnit; .)
  =                                                        (. U := c^.EnterNewUnit( DOM.ukImport );
                                                              IF DOM.coSolveTimestamps IN c^.Options THEN
                                                                IA := iaCheckNotReport;
                                                              END; .)
    "FROM"
      ntImportModuleId<iaCreateIfNotExistsNotAdd, Module>
    "IMPORT"
      // [
      //   "EXTERNAL"                                         (. U^.UnitKind := DOM.ukImportExternal; .)
      // ]                                                 
                                                           (. c^.LeaveUnit();
                                                              c^.EnterSymbols( Module^.SC()^, FALSE, FALSE, NIL ); .)
      ntId<IA, DOM.skUnknown, Id, FALSE>                   (. IF Id <> NIL THEN
                                                                c^.AddForeignSymbol( Id, FALSE );
                                                              END; .)
      {
        WEAK comma
        ntId<IA, DOM.skUnknown, Id, FALSE>                 (. IF Id <> NIL THEN
                                                                c^.AddForeignSymbol( Id, FALSE );
                                                              END; .)
      }
      WEAK semicolon                                       (. c^.LeaveSymbols( FALSE ); .)
.

/* =========defintions */

ntDefinitions // !C.2.2
  = { ntDefinition } // *
.

ntDefinition // !C.2.2
                                                           (. AM : DOM.TAccessModifier := DOM.amUnknown;
                                                              IM : DOM.TInheritanceModifier := DOM.TInheritanceModifier{};
                                                              CM : DOM.TCodeModifier := DOM.TCodeModifier{}; .)
  =
  ( SYNC "CONST"                                           (. c^.EnterNewUnit( DOM.ukConstDeclBlock ); .)
    {
      ntConstantDeclaration<TRUE, DOM.ukSimpleConstDecl, AM> WEAK semicolon // *
    }                                                      (. c^.LeaveUnit(); .)
  | SYNC "TYPE"                                            (. c^.EnterNewUnit( DOM.ukTypeDefBlock ); .)
    {
      ntTypeDefinition SYNC semicolon // *
    }                                                      (. c^.LeaveUnit(); .)
  | [ ntDataCodeModifier<CM> ] SYNC "VAR"                  (. c^.EnterNewUnit( DOM.ukVarDeclBlock ); .)
    {
      ntVariableDeclaration<TRUE, DOM.ukSimpleVarDecl, DOM.skVariable, AM, IM, CM> WEAK semicolon // *
    }                                                      (. c^.LeaveUnit(); .)
  | [ SYNC ntMemberAccessModifier<REF AM> ]
    [ SYNC ntClassInheritanceModifier<REF IM> ]
    ( SYNC "INTERFACE" 
        ntClassDefinition<TRUE, TRUE, AM, IM>
    | SYNC "CLASS"
        ntClassDefinition<TRUE, FALSE, AM, IM>
    ) WEAK semicolon // *
  | [ ntProcedureCodeModifier<CM> ]
    ( ntProcedureDefinition<CM> // *
    | ntInitiallyFinallyDefinition<CM, c^.InitCode, c^.FinalCode, c^.OD, DOM.TInheritanceModifier{}>
    ) WEAK semicolon // *
  )
.

ntProcedureCodeModifier<VAR CM : DOM.TCodeModifier>
  = SYNC "INLINE"                                          (. CM := DOM.TCodeModifier{DOM.cmINLINE}; .)
.
  
ntDataCodeModifier<VAR CM : DOM.TCodeModifier>
  = SYNC "READONLY"                                        (. CM := DOM.TCodeModifier{DOM.cmRO}; .)
  | SYNC "WRITEONLY"                                       (. CM := DOM.TCodeModifier{DOM.cmWO}; .)
.

/* =========definitions -- types */

ntTypeDefinition // !C.2.3
                                                           (. LType : DOM.TPType;
                                                              RType : DOM.TPType;
                                                              New : BOOLEAN := FALSE;
                                                              Opaque : BOOLEAN := TRUE; .)
  = ntId<iaCreateNotAddNotReportIfOpaque, DOM.skType, LType, FALSE> // *
                                                           (. c^.MarkForwardTypeDeclPlace(); .)  
    [                                                      (. Opaque := FALSE; .)
      equals ntTypeDenoter<RType, TRUE, FALSE, New>
    ]                                                      (. LType := c^.HandleTypeDefDecl( New, Opaque, DOM.ukSimpleTypeDef, DOM.amUnknown, LType, RType );
                                                              IF LType <> NIL THEN
                                                                LType^.Options := LType^.Options + c^.eosIF;
                                                              END;
                                                              IF LType^.TypeKind IN DOM.typeLinks THEN // RType is new, LType stayed as link
                                                                RType^.Options := RType^.Options + c^.eosIF;
                                                              END;
                                                              c^.ForwardOpaqueType( LType ); .) // typedefs must be forwarded always as nobody knows is some following DLL will use it or not

/*
  ntTypeDeclaration
  | ntOpaqueTypeDefinition
*/
.

/* reduced to [ equals ntTypeDenoter ] above to remove LL(1) ambiguity
ntOpaqueTypeDefinition // !C.2.3
  = ntId
.
*/

/* =========defintions -- class */

ntClassDefinition<DLLInterface, ClassInterface : BOOLEAN; AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier>
                                                           (. Class : DOM.TPClass;
                                                              QClass : DOM.TPClass;
                                                              ClassDecl : DOM.TPClassDecl := NEW( DOM.CClassDecl ); .)
  =                                                        (. IF ClassInterface THEN
                                                                INCL( IM, DOM.imInterface );
                                                              END;
                                                              CASE AM OF
                                                              | DOM.amUnknown, DOM.amLocal :
                                                              ELSE
                                                                SemErr( err._ClassCanBeModifiedOnlyAsLocal );
                                                              END;
                                                              c^.MarkForwardTypeDeclPlace(); .)
  ntClassId<iaCreateNotAddNotReportIfOpaque, QClass>       (. IF QClass^.TypeKind = DOM.tkOpaqueBase THEN
                                                                // type defined as opaque, solve this
                                                                NEW( Class );
                                                                Class^.N.Assign( QClass^.N );
                                                                c^.RevertOpaqueClassType( QClass, Class );
                                                              ELSE
                                                                Class := QClass;
                                                              END;
                                                              c^.AddUnit( Class );
                                                              IF DLLInterface THEN
                                                                Class^.Options := Class^.Options + c^.eosIF;
                                                              END;
                                                              IF ClassInterface THEN
                                                                INCL( Class^.Options, DOM.eoVMT );
                                                                ClassDecl^.OfClass := Class;
                                                                c^.InterfaceRTTI.Add( ClassDecl );
                                                              END;
                                                              Class^.Packing := c^.CurE^.Packing;
                                                              Class^.AM := AM;
                                                              Class^.IM := IM;
                                                              c^.AddSymbol( Class, TRUE ); .)
  [ ntInheritClause<ClassInterface, Class> ]
  [                                                        (. IF ClassInterface THEN
                                                                SemErr( err._INTERFACECannotIMPLEMENTAnything );
                                                              END; .)
    ntImplementsClause<Class> ]
    WEAK semicolon                                         (. c^.EnterSymbols( Class^.S, TRUE, TRUE, NIL ); .)
  ( IF( ClassInterface )
      ntInterfaceDefinitionBody<Class>
    | ntClassDefinitionBody<Class> )                        (. c^.LeaveSymbols( TRUE ); .)
  SYNC kwEND ntIdExpect<Class, FALSE>                       (. IF NOT ClassInterface AND ( Class^.I = NIL ) THEN // class inherits OBJECT, which requires ALLOCATE, DEALLOCATE to be imported
                                                                  c^.M2^.ReportAllErrors();
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidAllocate] = NIL THEN
                                                                     IF NOT c^.CheckOverwrittenOperator( Class, DOM.opNEW, TRUE ) THEN
                                                                        SemErr( err._MissingALLOCATEForOBJECT );
                                                                     END;
                                                                  END;
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidDeallocate] = NIL THEN
                                                                     IF NOT c^.CheckOverwrittenOperator( Class, DOM.opDISPOSE, TRUE ) THEN
                                                                        SemErr( err._MissingDEALLOCATEForOBJECT );
                                                                     END;
                                                                  END;
                                                                  c^.M2^.ReportFirstError();
                                                               END;
                                                               Class^.CheckDefinitionSemantics( c ); .)
.
  
ntClassInheritanceModifier<REF IM : DOM.TInheritanceModifier>
  = ntCOM                                                  (. IM := DOM.TInheritanceModifier{DOM.imCOM}; .)
  | ntAbstract                                             (. IM := DOM.TInheritanceModifier{DOM.imAbstract}; .)
  | ntFinal                                                (. IM := DOM.TInheritanceModifier{DOM.imFinal}; .)
.
  
ntClassMemberInheritanceModifier<REF IM : DOM.TInheritanceModifier>
  =                                                        (. IM := DOM.TInheritanceModifier{}; .)
    [ ntCOM                                                (. INCL( IM, DOM.imCOM ); .)
    ]                                              
    ( ntVirtual                                            (. INCL( IM, DOM.imVirtual ); .)
    | ntAbstract                                           (. INCL( IM, DOM.imAbstract ); .)
    )
  | ntFinal                                                (. IM := DOM.TInheritanceModifier{DOM.imFinal}; .)
.

ntInterfaceMemberInheritanceModifier<REF IM : DOM.TInheritanceModifier>
  = [ ntCOM                                                (. INCL( IM, DOM.imCOM ); .)
    ]
    [ ntVirtual                                            (. INCL( IM, DOM.imVirtual ); .)
    | ntAbstract                                           (. INCL( IM, DOM.imAbstract ); .)
    ]
.

ntAbstract = "ABSTRACT".
ntCOM      = "COM".
ntFinal    = "FINAL".
ntVirtual  = "VIRTUAL".
  
ntInheritClause<ClassInterface : BOOLEAN; Class : DOM.TPClass>
  = lpar
      ntAncestor<ClassInterface, Class, OUT Class^.I>      (. IF Class^.I <> NIL THEN
                                                                IF NOT ClassInterface AND ( DOM.imInterface IN Class^.I^.IM ) THEN
                                                                  SemErr( err._InterfaceCannotBeInherited );
                                                                END;
                                                                Class^.Options := Class^.Options + Class^.I^.Options * DOM.TEnvironmentOptions{DOM.eoVirtualFinally, DOM.eoVMT};
                                                              END; .)
    rpar
.

ntImplementsClause<Class : DOM.TPClass>
                                                           (. Ancestor : DOM.TPClass; .)
  = "IMPLEMENTS"
      ntAncestor<FALSE, Class, OUT Ancestor>               (. IF ( Ancestor <> NIL ) AND ( DOM.imCOM IN Ancestor^.IM ) THEN
                                                                // SemErr( err._IMPLEMENTSCannotUseCOMInterfaces );
                                                              END; .)
      { comma
         ntAncestor<FALSE, Class, OUT Ancestor>            (. IF ( Ancestor <> NIL ) AND ( DOM.imCOM IN Ancestor^.IM ) THEN
                                                                // SemErr( err._IMPLEMENTSCannotUseCOMInterfaces );
                                                              END; .)
      }
.
  
ntAncestor<ClassInterface : BOOLEAN; Class : DOM.TPClass; OUT Ancestor : DOM.TPClass>
  = ntQualifiedId<iaCheck, Ancestor, TRUE, FALSE>          (. Ancestor := c^.IdToClass( Ancestor );
                                                              IF Ancestor = Class THEN
                                                                SemErr( err._CannotInheritSelf );
                                                              ELSIF Ancestor <> NIL THEN
                                                                Class^.AddAncestor( Ancestor );
                                                                IF DOM.imFinal IN Ancestor^.IM THEN
                                                                  SemErr( err._CannotInheritFINAL );
                                                                ELSIF ClassInterface THEN
                                                                  IF DOM.TInheritanceModifier{DOM.imInterface} * Ancestor^.IM = DOM.TInheritanceModifier{} THEN
                                                                    IF DOM.imCOM IN Class^.IM THEN
                                                                      SemErr( err._COMCanInheritOnlyCOM );
                                                                    ELSE
                                                                      SemErr( err._InterfaceCanInheritOnlyInterface );
                                                                    END;
                                                                  END;
                                                                END;
                                                              END; .)
.

ntClassDefinitionBody<Class : DOM.TPClass>
  = { ntMemberDefinition<Class> }
.
 
ntMemberDefinition<Class : DOM.TPClass>                    (. AM : DOM.TAccessModifier := DOM.amUnknown;
                                                              IM : DOM.TInheritanceModifier := DOM.TInheritanceModifier{};
                                                              CM : DOM.TCodeModifier := DOM.TCodeModifier{}; .)
  =
  (
    (                                                      (. AM := c^.MEnv.ClassAM; .)
      [ ntMemberAccessModifier<AM> ]
      (
        SYNC "CONST"                                       (. c^.PushOptions( c^.CurE^.Options + DOM.TEnvironmentOptions{DOM.eoClassInner} + Class^.Options * c^.eosIF );
                                                              c^.EnterNewUnit( DOM.ukConstDeclBlock ); .)
        {
          ntConstantDeclaration<FALSE, DOM.ukClassConstDecl, AM> WEAK semicolon
        }                                                  (. c^.LeaveUnit();
                                                              c^.PopOptions(); .)
      | SYNC "TYPE"                                        (. c^.PushOptions( c^.CurE^.Options + DOM.TEnvironmentOptions{DOM.eoClassInner} + Class^.Options * c^.eosIF );
                                                              c^.EnterNewUnit( DOM.ukTypeDefBlock ); .)
        {
          ntTypeDeclaration<DOM.ukClassTypeDef, AM> WEAK semicolon
        }                                                  (. c^.LeaveUnit();
                                                              c^.PopOptions(); .)
      | 
        [ ntClassMemberInheritanceModifier<REF IM>          (. IF ( DOM.imCOM IN IM ) AND ( DOM.cpsStdCall * c^.CurU^.Options = DOM.TEnvironmentOptions{} ) THEN
                                                                  SemErr( err._COMMemberMustBeSTDCall );
                                                               END;
                                                               IF DOM.TInheritanceModifier{DOM.imAbstract, DOM.imVirtual, DOM.imFinal} * IM <> DOM.TInheritanceModifier{} THEN
                                                                  INCL( Class^.Options, DOM.eoVMT );
                                                                  IF ( DOM.imAbstract IN IM ) AND ( DOM.imAbstract NOT IN Class^.IM ) THEN
                                                                     SemErr( err._ABSTRACTInNOTABSTRACTClass );
                                                                  END;
                                                               END; .)
        ]
        ( 
            [ ntProcedureCodeModifier<CM> ]
            ntInheritableMemberDefinition<Class, AM, IM, CM> // including VAR due to LL1 conflicts
          | SYNC "INTERFACE" ntClassDefinition<FALSE, TRUE, AM, IM> WEAK semicolon
          | SYNC "CLASS" ntClassDefinition<FALSE, FALSE, AM, IM> WEAK semicolon
        )
      )
    )
    | ntVariableDeclaration<FALSE, DOM.ukClassVarDecl, DOM.skVariable, DOM.amPublic, DOM.TInheritanceModifier{}, DOM.TCodeModifier{}> WEAK semicolon // compatible
  )
.

/* -- access modifiers */

ntMemberAccessModifier<VAR AM : DOM.TAccessModifier>
  = ntPrivateMember                                        (. AM := DOM.amPrivate; .)
  | ntInternalMember                                       (. AM := DOM.amInternal; .)
  | ntLocalMember                                          (. AM := DOM.amLocal; .)
  | ntPublicMember                                         (. AM := DOM.amPublic; .)
.

ntPrivateMember  = "PRIVATE".
ntInternalMember = "INTERNAL".
ntLocalMember    = "LOCAL".
ntPublicMember   = "PUBLIC".

/* -- members */

ntInheritableMemberDefinition<Class : DOM.TPClass; AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier>
  = ntMethodDefinition<Class, AM, IM, CM> WEAK semicolon
  | ntOperatorDefinition<AM, IM> WEAK semicolon
  | [ ntDataCodeModifier<CM> ] 
    (
      ntIndexerDefinition<AM, IM, CM> WEAK semicolon
    |                                                      (. IF IM <> DOM.TInheritanceModifier{} THEN
                                                                SemErr( err._IMIsNotForVariables );
                                                              END;
                                                              IF ( AM = DOM.amPrivate ) AND ( DOM.cmRO IN CM ) THEN
                                                                SemErr( err._PrivateVariablesCannotBeReadonly );
                                                              END; .)
      ntClassVarDefinition<AM, IM, CM>
    | ntPropertyDefinition<AM, IM, CM>
    )
  | ntInitiallyFinallyDefinition<CM, Class^.InitCode, Class^.FinalCode, Class, IM> WEAK semicolon
.

/* interfaces */

ntInterfaceDefinitionBody<Class : DOM.TPClass>
  = { ntInterfaceMemberDefinition<Class> }
.
 
ntInterfaceMemberDefinition<Class : DOM.TPClass>           (. AM : DOM.TAccessModifier := DOM.amPublic;
                                                              IM : DOM.TInheritanceModifier := DOM.TInheritanceModifier{DOM.imAbstract}; .)
  = [ ntMemberAccessModifier<AM> ]                         (. IF AM = DOM.amPrivate THEN
                                                                SemErr( err._InterfaceMemberCannotBePrivate );
                                                              END;
                                                              IF ( DOM.imCOM IN IM ) AND ( AM <> DOM.amPublic ) THEN
                                                                SemErr( err._COMMemberMustBePUBLIC );
                                                              END; .)
    ntInterfaceMemberInheritanceModifier<REF IM>           (. IM := IM - DOM.TInheritanceModifier{DOM.imAbstract, DOM.imVirtual} + DOM.TInheritanceModifier{DOM.imAbstract}; 
                                                              IF ( DOM.imCOM IN IM ) AND ( DOM.cpsStdCall * c^.CurU^.Options = DOM.TEnvironmentOptions{} ) THEN
                                                                SemErr( err._COMMemberMustBeSTDCall );
                                                              END; .)
    ntInheritableInterfaceMemberDefinition<Class, AM, IM>
.

ntInheritableInterfaceMemberDefinition<Class : DOM.TPClass; AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier>
                                                           (. CM : DOM.TCodeModifier := DOM.TCodeModifier{}; .)
  = ntMethodDefinition<Class, AM, IM, CM> WEAK semicolon
  | ntOperatorDefinition<AM, IM> WEAK semicolon            (. IF DOM.TInheritanceModifier{DOM.imCOM, DOM.imInterface} * Class^.IM = DOM.TInheritanceModifier{DOM.imCOM, DOM.imInterface} THEN
                                                                SemErr( err._COMCannotHaveOperators );
                                                              END; .)
  | [ ntDataCodeModifier<CM> ]
    (
      ntIndexerDefinition<AM, IM, CM> WEAK semicolon
    | ntPropertyDefinition<AM, IM, CM>
    )
  | ntInitiallyFinallyDefinition<CM, Class^.InitCode, Class^.FinalCode, Class, IM> WEAK semicolon
                                                           (. IF DOM.TInheritanceModifier{DOM.imCOM, DOM.imInterface} * Class^.IM = DOM.TInheritanceModifier{DOM.imCOM, DOM.imInterface} THEN
                                                                SemErr( err._COMCannotHaveInitFinal );
                                                              END;
                                                              IF ( AM <> DOM.amUnknown ) AND ( AM <> DOM.amPublic ) THEN
                                                                Warning( wrn._InitiallyFinallyAlwaysPublic );
                                                              END; .)
.

/* =========defintions -- procedure headings */

ntProcedureDefinition<CM : DOM.TCodeModifier> // !C.2.4.1/2
                                                           (. P : DOM.TPProcedure; .)
  = SYNC "PROCEDURE" ntProcedureDefinitionStub<DOM.TInheritanceModifier{}, CM, P>
.

ntProcedureDefinitionStub<IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier; VAR P : DOM.TPProcedure> // !C.2.4.1/2
  = ntProcedureId<iaCreate, P>                             (. c^.MarkForwardTypeDeclPlace();
                                                              c^.AddUnit( P );
                                                              P^.IM := IM;
                                                              P^.CM := CM;
                                                              P^.Options := P^.Options + c^.eosIF;
                                                              P^.ImplementationState := DOM.isDefined;
                                                              c^.EnterSymbols( P^.S, TRUE, TRUE, NIL );
                                                              P^.Parameters := c^.EnterNewUnit( DOM.ukParameterList ); .)
      [ ntFormalParameters<iaCreateNotAdd> ]
      [ ntFunctionTrailing<TRUE, P^.T> ]
      [ ntFunctionThrowInfo<P> ]
                                                            (. c^.LeaveUnit();
                                                               c^.LeaveSymbols( TRUE ); .)
      
                                                              
.

ntFunctionTrailing<CheckInterface : BOOLEAN; VAR RequestedReturnType : DOM.TPType> // !C.2.4.2
                                                           (. C : DOM.TPClass; .)
  = colon ntFunctionResultType<RequestedReturnType>        (. IF CheckInterface AND ( RequestedReturnType^.Unwrap()^.TypeKind = DOM.tkClass ) THEN
                                                                C := DOM.TPClass( RequestedReturnType^.Unwrap());
                                                              END; .)
.

ntFunctionThrowInfo<P : DOM.TPProcedureType>                 (. T : DOM.TPType;
                                                                N : BOOLEAN; .)
  = "THROWS"
    ntTypeDenoter<T, FALSE, FALSE, N>                        (. c^.CheckTypeIsException( T );
                                                                c^.AddThrownType( P, T ); .)
    { comma ntTypeDenoter<T, FALSE, FALSE, N>                (. c^.CheckTypeIsException( T );
                                                                c^.AddThrownType( P, T ); .)
    }
.

ntInitiallyFinallyDefinition<CM : DOM.TCodeModifier; VAR IU, FU : DOM.TPUnit; Df : DOM.TPSymbol; IM : DOM.TInheritanceModifier> // !C.2.4.1/2
                                                           (. P : DOM.TPProcedure := NIL;
                                                              S : stacks.CPtrStack;
                                                              T : DOM.TPFormalType; .)
  =
  ( SYNC "INITIALLY"                                       (. IF IM <> DOM.TInheritanceModifier{} THEN
                                                                SemErr( err._InitiallyMustBeNonVirtual );
                                                              END;
                                                              IF DOM.eoInitially IN Df^.Options THEN
                                                                SemErr( err._InitiallyRedefinition );
                                                              ELSE
                                                                INCL( Df^.Options, DOM.eoInitially );
                                                              END;
                                                              IF ( Df^.SymbolKind = DOM.skClass ) AND ( DOM.cmINLINE IN CM ) THEN
                                                                SemErr( err._ClassInitiallyCannotBeINLINE );
                                                              END; .)
    ntProcedureDefinitionStub<IM, CM, P>                   (. INCL( P^.Options, DOM.eoInitially );
                                                              IU := P;
                                                              IF ( Df^.SymbolKind = DOM.skClass ) AND NOT Df^.N.Equals( P^.N ) THEN
                                                                c^.SemErr( err._ClassInitMustHaveNameOfSelf );
                                                              END;
                                                              IF (*( Df^.SymbolKind <> DOM.skClass ) AND*) P^.GetFirstFormalType( REF S, OUT T ) THEN
                                                                c^.SemErr( err._InitCannotHaveParameters );
                                                              END;
                                                              IF P^.T <> Types.TUnknown THEN
                                                                c^.SemErr( err._InitCannotHaveReturn );
                                                              END; .)
  | SYNC "FINALLY"                                         (. IF IM * DOM.TInheritanceModifier{DOM.imAbstract, DOM.imFinal} <> DOM.TInheritanceModifier{} THEN
                                                                SemErr( err._FinallyMustBeNonVirtual );
                                                              ELSIF DOM.imVirtual IN IM THEN
                                                                INCL( Df^.Options, DOM.eoVirtualFinally );
                                                              END;
                                                              IF DOM.eoFinally IN Df^.Options THEN
                                                                SemErr( err._FinallyRedefinition );
                                                              ELSE
                                                                INCL( Df^.Options, DOM.eoFinally );
                                                              END;
                                                              IF ( Df^.SymbolKind = DOM.skClass ) AND ( DOM.cmINLINE IN CM ) THEN
                                                                SemErr( err._ClassFinallyCannotBeINLINE );
                                                              END; .)
    ntProcedureDefinitionStub<IM, CM, P>                   (. INCL( P^.Options, DOM.eoFinally );
                                                              FU := P;
                                                              IF ( Df^.SymbolKind = DOM.skClass ) AND NOT Df^.N.Equals( P^.N ) THEN
                                                                c^.SemErr( err._ClassFinalMustHaveNameOfSelf );
                                                              END;
                                                              IF P^.GetFirstFormalType( REF S, OUT T ) THEN
                                                                c^.SemErr( err._FinalCannotHaveParameters );
                                                              END;
                                                              IF P^.T <> Types.TUnknown THEN
                                                                c^.SemErr( err._FinalCannotHaveReturn );
                                                              END; .)
  )                                                        (. IF ( Df^.SymbolKind = DOM.skClass ) AND ( P <> NIL ) THEN
                                                                c^.CurS^.Forget( P ); // remove symbol from class scope
                                                                P^.S.Add( P ); // add procedure to self to reach proper end of procedure identifier...
                                                                P^.OfSymbol := Df; // ... but still simulate that owner is the class
                                                                P^.Options := P^.Options - c^.eosIF - DOM.cpsAll + DOM.cpsUndefined;
                                                              END; .)
.

ntMethodDefinition<Class : DOM.TPClass; AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier> // !C.2.4
                                                           (. M : DOM.TPProcedure; .)
  = SYNC "PROCEDURE" ntProcedureDefinitionStub<IM, CM, M>  (. M^.UnitKind := DOM.ukMethodDef;
                                                              M^.AM := AM;
                                                              M^.IM := IM;
                                                              M^.Options := M^.Options - c^.eosIF;
                                                              IF c^.SStack.CurC <> NIL THEN
                                                                c^.CheckClassSymbolSemantics( M, NIL );
                                                              END; .)
.

ntIndexerDefinition<AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier>
                                                           (. Dummy : DOM.TPSymbol;
                                                              Indexer : DOM.TPIndexerDef := NEW( DOM.CIndexerDef );
                                                              TM : DOM.TTypeModifier := DOM.tmUnknown; .)
  =                                                        (. Indexer^.AM := AM;
                                                              Indexer^.IM := IM;
                                                              Indexer^.CM := CM; .)
    SYNC "INDEX"
    lpar
      ntFormalParameterModifier<OUT TM>                    (. IF ( TM = DOM.tmVAR ) OR ( TM = DOM.tmOUT ) THEN
                                                                SemErr( err._IndexCannotBeOUT );
                                                              END; .)
      ntId<iaDummy, DOM.skUnknown, Dummy, TRUE>
      colon
      ntFormalType<Indexer^.IndexType>                     (. Indexer^.IndexType^.TypeModifier := TM; .)
    rpar
    ntFunctionTrailing<TRUE, Indexer^.T>
    [ ntFunctionThrowInfo<Indexer> ]
                                                            (.  Indexer^.N.FromOA( L'[]' );
                                                                c^.AddSymbol( Indexer, TRUE );
                                                                Indexer^.ImplementationState := DOM.isDefined;
                                                                c^.AddUnit( Indexer );
                                                                IF c^.SStack.CurC <> NIL THEN
                                                                    c^.CheckClassSymbolSemantics( Indexer, NIL );
                                                                END; .)
.

ntOperatorDefinition<AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier>       
                                                           (. C : DOM.TPClass;
                                                              Operator : DOM.TPOperatorDef := NEW( DOM.COperatorDef );
                                                              P : DOM.TPSymbol;
                                                              ReturnFlag : BOOLEAN := FALSE; .)
  =                                                        (. Operator^.AM := AM;
                                                              Operator^.IM := IM; .)
    SYNC "OPERATOR"
    ntRewritableOperator<Operator^.O>                      (. Operator^.N.FromOA( DOM.opString[Operator^.O] );
                                                              Operator^.N.PrependOA( L'operator ' ); .)
    lpar
      ntSimpleFormalParameter<FALSE, OUT P>
    rpar                                                   (. Operator^.OperandType := P^.T;
                                                              IF Operator^.O = DOM.opNEW THEN
                                                                IF c^.ExpectType( Types.TCARDINAL, Operator^.OperandType, -1 ) THEN
                                                                  Operator^.OperandType := Types.TFormalSIZE;
                                                                  P^.T := Types.TFormalSIZE;
                                                                END;
                                                              ELSIF Operator^.O = DOM.opDISPOSE THEN
                                                                c^.ExpectType( Types.TADDRESS, Operator^.OperandType, -1 );
                                                              ELSIF Operator^.O = DOM.opAssign THEN
                                                                IF Operator^.OperandType^.T = c^.CurrentC() THEN
                                                                  INCL( c^.CurrentC()^.Options, DOM.eoAssignSelf );
                                                                  IF DOM.TPFormalType( Operator^.OperandType )^.TypeModifier <> DOM.tmCONST THEN
                                                                    SemErr( err._AssignRequiresCONSTOperand );
                                                                  END;
                                                                  // IF IM = DOM.imVirtual, DOM.imCOM THEN
                                                                    // IM := DOM.imUnknown; -- not needed ??
                                                                    // error should be OK, but it would deny to force
                                                                    // using of ABSTRACT/VIRTUAL asignment operator;
                                                                    // so there is imVirtual killed only
                                                                    // SemErr( L"Assign operator cannot be VIRTUAL" );
                                                                  // END;
                                                                END;
                                                              END; .)
    [                                                      (. ReturnFlag := TRUE; .)
      ntFunctionTrailing<FALSE, Operator^.T> ]
    [ ntFunctionThrowInfo<Operator> ]
                                                              (. CASE Operator^.O OF
                                                              | DOM.opAssign, DOM.opDISPOSE :
                                                                IF ReturnFlag THEN
                                                                  SemErr( err._OperatorHasNoReturn );
                                                                END;
                                                              ELSE
                                                                IF NOT ReturnFlag THEN
                                                                  SemErr( err._OperatorRequiresReturn );
                                                                ELSIF ( Operator^.O = DOM.opNEW ) AND ( Operator^.T <> Types.TADDRESS ) THEN
                                                                  SemErr( err._OperatorNEWMustReturnADDRESS );
                                                                END;
                                                              END;
                                                              IF ( Operator^.O <> DOM.opAssign ) AND ( Operator^.T^.Unwrap()^.TypeKind = DOM.tkClass ) THEN
                                                                C := DOM.TPClass( Operator^.T^.Unwrap());
                                                              END;
                                                              c^.AddSymbol( Operator, TRUE );
                                                              Operator^.ImplementationState := DOM.isDefined;
                                                              c^.AddUnit( Operator );
                                                              IF c^.SStack.CurC <> NIL THEN
                                                                c^.CheckClassSymbolSemantics( Operator, NIL );
                                                              END; .)
.

ntClassVarDefinition<AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier>
  = SYNC "VAR"                                             (. c^.EnterNewUnit( DOM.ukVarDeclBlock ); .)
    {
      ntVariableDeclaration<FALSE, DOM.ukClassVarDecl, DOM.skVariable, AM, DOM.TInheritanceModifier{}, CM> WEAK semicolon
    }                                                      (. c^.LeaveUnit(); .)
.

ntPropertyDefinition<AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier>
  = SYNC "PROPERTY"                                        (. c^.EnterNewUnit( DOM.ukVarDeclBlock ); .)
    {                                                      (. EXCL( CM, DOM.cmREF ); .)
      [ SYNC "REF"                                         (. IF DOM.imCOM IN IM THEN
                                                                INCL( CM, DOM.cmREF );
                                                              ELSE
                                                                SemErr( err._REFOnlyForCOM );
                                                              END; .)
      ]
      ntVariableDeclaration<FALSE, DOM.ukPropertyDef, DOM.skProperty, AM, IM, CM> WEAK semicolon
    }                                                      (. c^.LeaveUnit(); .)
.

/* ---------- common part */

ntFormalParameters<IdAction : TIdAction> // !C.2.4.1
  = lpar [ ntFormalParameterList<IdAction> ] rpar
.

ntFormalParameterList<IdAction : TIdAction> // !C.2.4.1
  = ntFormalParameter<IdAction> { WEAK semicolon ntFormalParameter<IdAction> }
.

/* =========defintions -- formal parameters */

ntFormalParameterModifier<OUT TM : DOM.TTypeModifier>
  =                                                        (. TM := DOM.tmUnknown; .)
  [ "VAR"                                                  (. TM := DOM.tmVAR; .)
  | "REF"                                                  (. TM := DOM.tmREF; .)
  | "CONST"                                                (. TM := DOM.tmCONST; .)
  | "OUT"                                                  (. TM := DOM.tmOUT; .)
  ]
.

ntFormalParameter<IdAction : TIdAction> // C.2.4.3.*
                                                           (. TM : DOM.TTypeModifier; .)
  = ntFormalParameterModifier<OUT TM>
    ntFormalParameterSpecification<IdAction, TM>
.

ntFormalParameterSpecification<IdAction : TIdAction; TM : DOM.TTypeModifier> // !C.2.4.3.1
                                                           (. FP : DOM.TPFormalType;
                                                              IdA : DOM.TSymbolAccess;
                                                              U : DOM.TPUnit;
                                                              Variable : DOM.TPVariable;
                                                              b : BOOLEAN; .)
  =                                                        (. U := c^.EnterNewUnit( DOM.ukParamDefContainer ); .)
    ntIdList<IdAction, DOM.skVariable>                      
    colon ntFormalType<FP>                                 (. c^.LeaveUnit();
                                                              c^.HandleNestedSymbol( FP^.T, FP^.T^.OfSymbol, IdA );
                                                              FP^.TypeModifier := TM;
                                                              c^.ForwardOpaqueType( FP );
                                                              b := U^.GetFirst( Variable );
                                                              WHILE b DO
                                                                Variable^.UnitKind := DOM.ukParamDef;
                                                                Variable^.T := FP;
                                                                b := U^.GetNext( Variable );
                                                              END; .)
.

ntSimpleFormalParameter<AddUnit : BOOLEAN; OUT P : DOM.TPSymbol>
                                                           (. FP : DOM.TPFormalType;
                                                              IdAction : TIdAction := iaCreateNotAdd;
                                                              TM : DOM.TTypeModifier; .)
  = ntFormalParameterModifier<OUT TM>                      (. IF AddUnit THEN
                                                                c^.EnterNewUnit( DOM.ukParamDefContainer );
                                                                IdAction := iaCreate;
                                                              END; .)
    ntId<IdAction, DOM.skVariable, P, FALSE>
    colon ntFormalType<FP>                                 (. FP^.TypeModifier := TM;
                                                              IF AddUnit THEN
                                                                c^.AddUnit( P );
                                                                c^.LeaveUnit();
                                                              END;
                                                              P^.UnitKind := DOM.ukParamDef;
                                                              P^.T := FP; .)
.

/* =========declarations */

ntModuleDeclarations // !C.2.5 splitted into MODULE/PROC
  = { ntDeclaration
    | ntInitiallyFinallyDeclaration<DOM.TCodeModifier{}, DOM.ukModuleInitCode, DOM.ukModuleFinalCode, c^.OD^.InitCode, c^.InitCode, c^.OD^.FinalCode, c^.FinalCode, c^.OD, c, DOM.TInheritanceModifier{}>
      WEAK semicolon }
.

ntDeclarations // !C.2.5 splitted into MODULE/PROC
  = { ntDeclaration }
.

ntDeclaration
  = SYNC "LABEL" { ntLabelDeclaration WEAK semicolon }
  | SYNC "CONST" { ntConstantDeclaration<FALSE, DOM.ukSimpleConstDecl, DOM.amUnknown> WEAK semicolon }
  | SYNC "TYPE" { ntTypeDeclaration<DOM.ukSimpleTypeDef, DOM.amUnknown> WEAK semicolon }
  | SYNC "VAR" { ntVariableDeclaration<FALSE, DOM.ukSimpleVarDecl, DOM.skVariable, DOM.amUnknown, DOM.TInheritanceModifier{}, DOM.TCodeModifier{}> WEAK semicolon }
  | ntProcedureDeclaration WEAK semicolon
  | ntClassesDeclaration WEAK semicolon
.

ntClassesDeclaration                                       (. IM : DOM.TInheritanceModifier := DOM.TInheritanceModifier{}; .)
  =
  [ SYNC ntClassInheritanceModifier<REF IM> ]
  ( SYNC "INTERFACE"
      ntClassDefinition<FALSE, TRUE, DOM.amUnknown, IM>
  | SYNC "CLASS"
    ( ntClassDefinition<FALSE, FALSE, DOM.amUnknown, IM>
    | "IMPLEMENTATION" ntClassDeclaration
    )
  )
.

/* =========declarations -- label */

ntLabelDeclaration                                         (. Label : DOM.TPLabel; .)
  = ntLabelId<iaCreate, Label>                             (. c^.AddUnit( Label ); .)
    {
      WEAK comma ntLabelId<iaCreate, Label>                (. c^.AddUnit( Label ); .)
    }
.
  
/* =========declarations -- constant */

ntConstantDeclaration<DLLInterface : BOOLEAN; UK : DOM.TUnitKind; AM : DOM.TAccessModifier> // !C.2.6
                                                           (. Expression : DOM.TPExpression;
                                                              Id : DOM.TPSymbol;
                                                              Constant : DOM.TPConstant; .)
  = ntConstantId<iaCreate, Constant>                       (. Constant^.UnitKind := UK;
                                                              Constant^.AM := AM; .)
    ( 
      equals ntConstantExpression<Expression>              (. Constant^.SetExpression( Expression );
                                                              Constant^.T := Expression^.T; .)
    | aliases ntQualifiedId<iaCheck, Id, TRUE, FALSE>      (. Constant^.SetLinkOf( Id ); .)
    )                                                      (. c^.AddToUnitOrNestedUnit( Constant );
                                                              IF DLLInterface THEN
                                                                Constant^.Options := Constant^.Options + c^.eosIF;
                                                              END; .)
.

/* =========declarations -- types */

ntTypeDeclaration<UK : DOM.TUnitKind; AM : DOM.TAccessModifier> // !C.2.7
                                                           (. LType : DOM.TPType;
                                                              RType : DOM.TPType;
                                                              New : BOOLEAN; .)
  = ntId<iaCreateNotAddNotReportIfOpaque, DOM.skType, LType, FALSE>
                                                           (. c^.MarkForwardTypeDeclPlace(); .)
    equals ntTypeDenoter<RType, FALSE, FALSE, New>         (. IF ( LType^.UnwrapToFirstType()^.TypeKind = DOM.tkOpaqueWhole ) AND ( RType^.Unwrap()^.TypeKind <> DOM.tkReference ) THEN
                                                                SemErr( err._OpaqueTypeMustBePointer );
                                                              END;
                                                              LType := c^.HandleTypeDefDecl( New, FALSE, UK, AM, LType, RType );
                                                              IF UK = DOM.ukClassTypeDef THEN
                                                                IF c^.CurrentC()^.I <> NIL THEN
                                                                  c^.CheckClassSymbolSemantics( LType, c^.CurrentC()^.I );
                                                                END;
                                                                IF ( AM <> DOM.amPrivate ) AND ( AM <> DOM.amInternal ) THEN
                                                                  SemErr( err._NestedTypeMustNotBePublic );
                                                                END;
                                                              END; .)
.

/* =========declarations -- variables */

ntVariableDeclaration<DLLInterface : BOOLEAN; UK : DOM.TUnitKind; SK : DOM.TSymbolKind; AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier> // !C.2.8
                                                           (.  DataType : DOM.TPType := NIL;
                                                               E : DOM.TPExpression := NIL;
                                                               IdA : DOM.TSymbolAccess;
                                                               ThrowP : DOM.CProcedureType;
                                                               VarDecl : DOM.TPVarDeclContainer;
                                                               Variable : DOM.TPVariable;
                                                               b : BOOLEAN;
                                                               ClassFlag : BOOLEAN := FALSE;
                                                               CheckClass : BOOLEAN;
                                                               New : BOOLEAN; .)
  = ntVariableIdList<SK, VarDecl>                          (.  IF UK = DOM.ukSimpleVarDecl THEN
                                                                  c^.MarkForwardTypeDeclPlace();
                                                               END; .)
    colon
    ( IF(UK = DOM.ukPropertyDef)
      ntTypeId<DataType>
    | ntTypeDenoter<DataType, DLLInterface, FALSE, New>
    )                                                      (.  IF DataType = NIL THEN
                                                                  DataType := Types.TUnknown;
                                                               ELSE
                                                                  c^.HandleNestedSymbol( DataType, DataType^.OfSymbol, IdA );
                                                               END;
                                                               ClassFlag := DataType^.Unwrap()^.TypeKind = DOM.tkClass; .)
    [ // ntClassConstructorParameters<DOM.TPClass( DataType^.Unwrap())>
      // |
                                                           (.  CASE UK OF
                                                               | DOM.ukSimpleVarDecl :
                                                               | DOM.ukClassVarDecl :
                                                                   INCL( c^.SStack.CurC^.Options, DOM.eoClassInitializedVariables );
                                                               | DOM.ukPropertyDef :
                                                                   SemErr( err._UnableToInitializeClassProperty );
                                                               ELSE
                                                                   SemErr( err._UnableToInitializeVar );
                                                               END; .)
      ntAssignment ntExpression<E>                         (.  c^.ExpectType( DataType, E^.T, -1 );
                                                               E^.TargetT := DataType; .)
    ]
    [                                                      (.  IF UK <> DOM.ukPropertyDef THEN
                                                                  SemErr( err._SimpleVariableCannotThrowExceptions );
                                                               END; .)
      ntFunctionThrowInfo<ADR( ThrowP )> ]                 (.  IF UK <> DOM.ukPropertyDef THEN
                                                                  c^.ForwardOpaqueType( DataType );
                                                                  c^.ForwardComplexType( DataType );
                                                               END;
                                                               IF NOT ClassFlag THEN
                                                                  // OK
                                                               ELSIF DOM.imInterface IN DOM.TPClass( DataType^.Unwrap())^.IM THEN
                                                                  SemErr( err._InstanceOfInterface );
                                                               ELSIF DOM.imAbstract IN DOM.TPClass( DataType^.Unwrap())^.IM THEN
                                                                  SemErr( err._InstanceOfAbstractClass );
                                                               END;
                                                               CheckClass := (( UK = DOM.ukClassVarDecl ) OR ( UK = DOM.ukPropertyDef )) AND ( c^.SStack.CurC <> NIL );
                                                               b := VarDecl^.GetFirst( Variable );
                                                               WHILE b DO
                                                                  IF DLLInterface THEN
                                                                     Variable^.Options := Variable^.Options + c^.eosIF;
                                                                  END;
                                                                  Variable^.UnitKind := UK;
                                                                  Variable^.ImplementationState := DOM.isDefined;
                                                                  Variable^.T := DataType;
                                                                  Variable^.AM := AM;
                                                                  Variable^.CM := CM;
                                                                  IF E <> NIL THEN
                                                                     Variable^.InitE := E;
                                                                     INCL( Variable^.Options, DOM.eoInitialized );
                                                                     IF UK = DOM.ukClassVarDecl THEN
                                                                        Variable^.Options := Variable^.Options + DOM.TEnvironmentOptions{DOM.eoInitialized, DOM.eoClassInitialized};
                                                                     ELSE
                                                                        Variable^.Options := Variable^.Options + DOM.TEnvironmentOptions{DOM.eoInitialized};
                                                                     END;
                                                                  END;
                                                                  IF SK = DOM.skProperty THEN
                                                                     DOM.TPPropertyDef( Variable )^.IM := IM;
                                                                     DOM.TPPropertyDef( Variable )^.CopyThrows( ADR( ThrowP ));
                                                                  END;
                                                                  IF CheckClass THEN
                                                                     c^.CheckClassSymbolSemantics( Variable, NIL );
                                                                  END;
                                                                  b := VarDecl^.GetNext( Variable );
                                                               END; // WHILE
                                                               c^.AddUnit( VarDecl ); .)
.

// ntClassConstructorParameters<Class : DOM.TPClass>
// =
// 																(.  IF ( Class^.InitCode <> NIL ) AND ( Class^.InitCode^.UnitKind <> DOM.ukProcedureDecl ) THEN
// 																		
// 																	END; .)
// 	ntActualParameters<NIL, vrsDefault>
// .

/* =========declarations -- procedures */
/* ---------- module part, classes members included */

ntClassDeclaration                                         (. Class : DOM.CClass;
                                                              ClassDecl : DOM.TPClassDecl := NEW( DOM.CClassDecl );
                                                              b : BOOLEAN; .)
  =                                                        (. c^.MarkForwardTypeDeclPlace();
                                                              c^.AddUnit( ClassDecl );
                                                              c^.EnterUnit( ClassDecl ); .)
    ntClassId<iaCheck, ClassDecl^.OfClass>                 (. b := ClassDecl^.OfClass <> NIL;
                                                              IF b THEN
                                                                c^.EnterSymbols( ClassDecl^.OfClass^.S, FALSE, TRUE, NIL );
                                                              ELSE
                                                                ClassDecl^.OfClass := ADR( Class );
                                                              END; .)
    WEAK semicolon
      ntClassDeclarations<ClassDecl>                       (. INCL( c^.Options, DOM.eoClassInitialized ); .)
      ntISOInitializationFinalization<DOM.ukClassInitCode, DOM.ukClassFinalCode, ClassDecl^.InitCode, ClassDecl^.FinalCode, ClassDecl^.OfClass, ClassDecl>
    SYNC kwEND
                                                           (. EXCL( c^.Options, DOM.eoClassInitialized );
                                                              IF b THEN
                                                                IF ( ClassDecl^.InitCode = NIL ) AND ( DOM.eoClassInitializedVariables IN ClassDecl^.OfClass^.Options ) THEN
                                                                   SemErr( err._NoInitCodeForClassVariables );
                                                                END;                                                                
                                                                ClassDecl^.OfClass^.ImplementationState := DOM.isImplementedA;
                                                                c^.LeaveSymbols( FALSE );
                                                              END; .)
    ntIdExpect<ClassDecl^.OfClass, FALSE>                  (. c^.LeaveUnit();
                                                              IF b THEN
                                                                 ClassDecl^.OfClass^.CheckImplementationSemantics( c );
                                                              END; .)
.

ntClassDeclarations<ClassDecl : DOM.TPClassDecl>
  = { ntMemberDeclaration<ClassDecl> }
.

ntISOInitializationFinalization<ICUK, FCUK : DOM.TUnitKind; VAR IC, FC : DOM.TPUnit; Df : DOM.TPSymbol; Im : DOM.TPUnit>
  = [ SYNC "BEGIN"                                         (. // INITIALLY allowed by ISO
                                                              // IF NOT( DOM.eoInitially IN DefU^.Options ) THEN
                                                              //   SemErr( L"Class or module does not define initialization code (INITIALLY)" );
                                                              // END;
                                                              INCL( Im^.Options, DOM.eoInitially );
                                                              IF IC <> NIL THEN
                                                                SemErr( err._InitiallyRedeclaration );
                                                              END;
                                                              IC := c^.GetNewUnit( ICUK, Im, TRUE );
                                                              c^.EnterNewCTDeclUnit( Df ); .)
      ntBlockBody<Types.TUnknown, ICUK = DOM.ukClassInitCode>
                                                           (. c^.LeaveCTDeclUnit();
                                                              c^.LeaveUnit(); .)
    // ]
      [ SYNC "FINALLY"                                     (. // FINALLY allowed by ISO
                                                              // IF NOT( DOM.eoFinally IN DefU^.Options ) THEN
                                                              //   SemErr( L"Class or module does not define FINALLY" );
                                                              // END;
                                                              INCL( Im^.Options, DOM.eoFinally );
                                                              IF FC <> NIL THEN
                                                                SemErr( err._FinallyRedeclaration );
                                                              END;
                                                              FC := c^.GetNewUnit( FCUK, Im, TRUE );
                                                              c^.EnterNewCTDeclUnit( Df ); .)
        ntBlockBody<Types.TUnknown, FALSE>                 (. c^.LeaveCTDeclUnit();
                                                              c^.LeaveUnit(); .)
      ]
    ]
.

ntMemberDeclaration<ClassDecl : DOM.TPClassDecl>           (. AM : DOM.TAccessModifier := c^.MEnv.ClassAM;
                                                              IM : DOM.TInheritanceModifier := DOM.TInheritanceModifier{};
                                                              CM : DOM.TCodeModifier := DOM.TCodeModifier{}; .)
  = [ SYNC ntMemberAccessModifier<AM> ] [ SYNC ntClassMemberInheritanceModifier<REF IM> ]
  (
      [ SYNC ntProcedureCodeModifier<CM> ]
      ( 
        SYNC ntMethodDeclaration<AM, IM, CM>
      | SYNC ntInitiallyFinallyDeclaration<CM, DOM.ukClassInitCode, DOM.ukClassFinalCode, ClassDecl^.OfClass^.InitCode, ClassDecl^.InitCode, ClassDecl^.OfClass^.FinalCode, ClassDecl^.FinalCode, ClassDecl^.OfClass, ClassDecl, IM>
      | SYNC ntOperatorDeclaration<AM, IM, CM>
      )
    | [ SYNC ntDataCodeModifier<CM> ]
      ( 
        SYNC ntPropertyDeclaration<AM, IM, CM>
      | SYNC ntIndexerDeclaration<AM, IM, CM>
      )
    | SYNC "CLASS" ntClassDeclaration
  ) WEAK semicolon 
.

ntMethodDeclaration<AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier>
                                                           (. DfM : DOM.TPMember;
                                                              ImM : DOM.TPMember;
                                                              LDfM : DOM.CMember;
                                                              LImM : DOM.CMember; .)
  = SYNC "PROCEDURE" ntMemberDeclId<DfM, FALSE>            (. IF DfM = NIL THEN
                                                                DfM := ADR( LDfM ); LDfM.T := Types.TUnknown;
                                                                ImM := ADR( LImM );
                                                              END;
                                                              IF DfM^.SymbolKind <> DOM.skProcedure THEN
                                                                c^.SemErrCS( err._MemberIsNotProcedure, DfM^.N );
                                                              END;
                                                              c^.CreateProcedureImplementation( DfM, DOM.isImplementedA, AM, IM, CM, ImM ); .)
    [ ntFormalParameters<iaCreate> ]
    ( 
      WEAK semicolon                                       (. c^.EnterProcedureImplementation( DfM ); .)
      ntProperMemberBlock<DfM>
    | ntFunctionTrailing<TRUE, ImM^.T>
      WEAK semicolon                                       (. c^.EnterProcedureImplementation( DfM ); .)
      ntFunctionMemberBlock<DfM>
    )                                                      (. c^.LeaveProcedureImplementation( DfM, DOM.isImplementedA, FALSE );
                                                              c^.CheckProcedureSemantics( DfM ); .)
.

ntPropertyDeclaration<AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier>
                                                           (. DfP : DOM.TPPropertyDef;
                                                              ImP : DOM.TPPropertyDecl;
                                                              ImS : DOM.TImplementationState;
                                                              LDfP : DOM.CPropertyDef;
                                                              LImP : DOM.CMember;
                                                              P : DOM.TPSymbol; .)
  = "PROPERTY" ntMemberDeclId<DfP, FALSE>                  (. IF DfP = NIL THEN
                                                                DfP := ADR( LDfP ); LDfP.T := Types.TUnknown;
                                                                ImP := DOM.TPPropertyDecl( ADR( LImP )); // cross casting !
                                                              END;
                                                              IF DfP^.SymbolKind <> DOM.skProperty THEN
                                                                c^.SemErrCS( err._MemberIsNotProperty, DfP^.N );
                                                              END; .)
    (
      WEAK "GET"                                           (. ImS := DOM.isImplementedR;
                                                              IF DOM.cmWO IN DfP^.CM THEN
                                                                SemErr( err._GETForWriteonlyProperty );
                                                              END;
                                                              c^.CreateProcedureImplementation( DfP, ImS, AM, IM, CM, ImP );
                                                              IF NOT( DOM.imCOM IN DfP^.IM ) THEN
                                                                ImP^.N.AppendOA( L'_get' );
                                                              ELSE
                                                                ImP^.N.PrependOA( L'get_' );
                                                              END;
                                                              ImP^.UnitKind := DOM.ukPropertyDeclR; .)
        ntFunctionTrailing<TRUE, ImP^.T>
        WEAK semicolon                                     (. c^.EnterProcedureImplementation( DfP ); .)
        ntFunctionMemberBlock<DfP>
    | WEAK "SET"                                           (. ImS := DOM.isImplementedW;
                                                              IF DOM.cmRO IN DfP^.CM THEN
                                                                SemErr( err._SETForReadonlyProperty );
                                                              END;
                                                              c^.CreateProcedureImplementation( DfP, ImS, AM, IM, CM, ImP );
                                                              IF NOT( DOM.imCOM IN DfP^.IM ) THEN
                                                                ImP^.N.AppendOA( L'_set' );
                                                              ELSIF DOM.cmREF IN DfP^.CM THEN
                                                                ImP^.N.PrependOA( L'putref_' );
                                                              ELSE
                                                                ImP^.N.PrependOA( L'put_' );
                                                              END;
                                                              ImP^.UnitKind := DOM.ukPropertyDeclW; .)
        lpar ntSimpleFormalParameter<TRUE, OUT P> rpar     (. c^.ExpectType( DfP^.T, P^.T, err._BadPropertyParameterType );
                                                              IF ( DfP^.T^.Unwrap()^.PrimitiveType = DOM.ptStructure ) AND
                                                                 ( NOT P^.T^.IsFormal() OR ( DOM.TPFormalType( P^.T )^.TypeModifier <> DOM.tmCONST )) THEN
                                                                SemErr( err._SETForStructMustBeCONST );
                                                              END; .)
        WEAK semicolon                                     (. c^.EnterProcedureImplementation( DfP );
                                                              ImP^.T := Types.TUnknown; .)
        ntProperMemberBlock<DfP>
    )                                                      (. c^.LeaveProcedureImplementation( DfP, ImS, FALSE );
                                                              c^.CheckProcedureSemantics( DfP ); .)
.

ntIndexerDeclaration<AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier>
                                                           (. Class : DOM.TPClass := NIL;
                                                              DfI : DOM.TPIndexerDef := NIL;
                                                              ImI : DOM.TPMember;
                                                              ImS : DOM.TImplementationState;
                                                              LDfI : DOM.CIndexerDef;
                                                              LImI : DOM.CMember;
                                                              P : DOM.TPSymbol; .)
  = "INDEX" ntMemberDeclId<Class, TRUE>                    (. IF ( Class <> NIL ) AND NOT Class^.S.GetS( L'[]', DfI ) THEN
                                                                SemErr( err._ClassHasNoINDEX );
                                                              END;
                                                              IF DfI = NIL THEN
                                                                DfI := ADR( LDfI ); LDfI.T := Types.TUnknown; LDfI.IndexType := Types.TFormalUnknown;
                                                                ImI := ADR( LImI );
                                                              END; .)
    (
      WEAK "GET"                                           (. ImS := DOM.isImplementedR;
                                                              IF DOM.cmWO IN DfI^.CM THEN
                                                                SemErr( err._GETForWriteonlyIndex );
                                                              END;
                                                              c^.CreateProcedureImplementation( DfI, ImS, AM, IM, CM, ImI );
                                                              IF DOM.imCOM IN DfI^.IM THEN
                                                                ImI^.N.FromOA( L'get_item' );
                                                              ELSE
                                                                ImI^.N.FromOA( L'ix_get' );
                                                              END;
                                                              ImI^.UnitKind := DOM.ukIndexerDeclR; .)
          lpar
            ntSimpleFormalParameter<TRUE, OUT P>           (. c^.ExpectType( DfI^.IndexType, P^.T, err._BadIndexParameterType ); .)
          rpar
        ntFunctionTrailing<TRUE, ImI^.T>
        WEAK semicolon                                     (. c^.EnterProcedureImplementation( DfI ); .)
        ntFunctionClassBlock<DfI>
    | WEAK "SET"                                           (. ImS := DOM.isImplementedW;
                                                              IF DOM.cmRO IN DfI^.CM THEN
                                                                SemErr( err._SETForReadonlyIndex );
                                                              END;
                                                              c^.CreateProcedureImplementation( DfI, ImS, AM, IM, CM, ImI );
                                                              IF DOM.imCOM IN DfI^.IM THEN
                                                                ImI^.N.FromOA( L'set_item' );
                                                              ELSE
                                                                ImI^.N.FromOA( L'ix_set' );
                                                              END;
                                                              ImI^.UnitKind := DOM.ukIndexerDeclW; .)
          lpar
            ntSimpleFormalParameter<TRUE, OUT P>           (. c^.ExpectType( DfI^.IndexType, P^.T, err._BadIndexParameterType ); .)
            WEAK semicolon
            ntSimpleFormalParameter<TRUE, OUT P>           (. c^.ExpectType( DfI^.T, P^.T, err._BadIndexReturnType );
                                                              IF ( DfI^.T^.Unwrap()^.PrimitiveType = DOM.ptStructure ) AND
                                                                 ( NOT P^.T^.IsFormal() OR ( DOM.TPFormalType( P^.T )^.TypeModifier <> DOM.tmCONST )) THEN
                                                                SemErr( err._IndexerSETForStructMustBeCONST );
                                                              END; .)
          rpar
        WEAK semicolon                                     (. c^.EnterProcedureImplementation( DfI );
                                                              ImI^.T := Types.TUnknown; .)
        ntProperClassBlock<DfI>
    )                                                      (. c^.LeaveProcedureImplementation( DfI, ImS, FALSE );
                                                              c^.CheckProcedureSemantics( DfI ); .)
.

ntOperatorDeclaration<AM : DOM.TAccessModifier; IM : DOM.TInheritanceModifier; CM : DOM.TCodeModifier>
                                                           (. DfO : DOM.TPOperatorDef := NIL;
                                                              ImO : DOM.TPOperatorDecl;
                                                              LDfO : DOM.COperatorDef;
                                                              LImO : DOM.COperatorDecl;
                                                              P : DOM.TPSymbol;
                                                              ReturnFlag : BOOLEAN := FALSE; .)
  = "OPERATOR" ntMemberDeclId<DfO, FALSE>                  (. IF DfO = NIL THEN
                                                                DfO := ADR( LDfO ); LDfO.T := Types.TUnknown; LDfO.OperandType := Types.TUnknown;
                                                                ImO := ADR( LImO );
                                                              ELSIF DfO^.SymbolKind <> DOM.skOperator THEN
                                                                c^.SemErr( err._MemberIsNotOperator );
                                                                DfO := ADR( LDfO ); LDfO.T := Types.TUnknown; LDfO.OperandType := Types.TUnknown;
                                                                ImO := ADR( LImO );
                                                              ELSE
                                                                c^.CreateProcedureImplementation( DfO, DOM.isImplementedA, AM, IM, CM, ImO );
                                                              END; .)
    lpar
      ntSimpleFormalParameter<TRUE, OUT P>                 (. IF DfO <> NIL THEN
                                                                IF c^.ExpectType( DfO^.OperandType, P^.T, err._BadOperatorParameterType ) THEN
                                                                  IF DfO^.O = DOM.opNEW THEN
                                                                    P^.T := Types.TFormalSIZE;
                                                                  END;
                                                                  IF ( DfO^.T^.Unwrap()^.PrimitiveType = DOM.ptStructure ) AND
                                                                     ( NOT P^.T^.IsFormal() OR ( DOM.TPFormalType( P^.T )^.TypeModifier <> DOM.tmCONST )) THEN
                                                                    SemErr( err._OperandForStructMustBeCONST );
                                                                  END;
                                                                END;
                                                              END; .)
    rpar
    [                                                      (. ReturnFlag := TRUE; .)
      ntFunctionTrailing<TRUE, ImO^.T> ]
    WEAK semicolon                                         (. c^.EnterProcedureImplementation( DfO ); .)
    ntFunctionMemberBlock<DfO>                             (. c^.LeaveProcedureImplementation( DfO, DOM.isImplementedA, FALSE );
                                                              c^.CheckProcedureSemantics( DfO ); .)
.

/* ---------- procedure part, classes members NOT included */

ntProcedureDeclaration // !C.2.9
                                                           (. CM : DOM.TCodeModifier := DOM.TCodeModifier{};
                                                              DP : DOM.TPProcedure; // definition
                                                              IP : DOM.TPProcedure; .) // implementation
  = [ SYNC ntProcedureCodeModifier<CM> ]
    SYNC "PROCEDURE" ntProcedureId<iaCreateIfNotExists, DP>(. c^.CreateProcedureImplementation( DP, DOM.isImplementedA, DOM.amUnknown, DOM.TInheritanceModifier{}, CM, IP ); .)
    ntProcedureDeclarationStub<DP, IP>
.

ntProcedureDeclarationStub<DP, IP : DOM.TPProcedure> // !C.2.9
                                                           (. OutIMS : DOM.TImplementationState := DOM.isImplementedA; .)
  = [ ntFormalParameters<iaCreate> ]
    ( 
        [ ntFunctionThrowInfo<DP> ]
        WEAK semicolon                                     (. c^.EnterProcedureImplementation( DP ); .)
        (
            ntProperProcedureBlock<DP>
          | "FORWARD"                                      (. OutIMS := DOM.isForwarded;
                                                              CASE DP^.ImplementationState OF
                                                              | DOM.isUnknown :  
                                                                DP^.ImplementationState := DOM.isForwarded;
                                                              | DOM.isDefined :
                                                                SemErrCS( err._ProcedureAlreadyDefined, DP^.N );
                                                              | DOM.isForwarded :
                                                                SemErrCS( err._ProcedureAlreadyForwarded, DP^.N );
                                                              END; .)
        )
      | ntFunctionTrailing<TRUE, IP^.T>                    (. c^.EnterProcedureImplementation( DP ); .)
        [ ntFunctionThrowInfo<DP> ]
        WEAK semicolon
        (
            ntFunctionProcedureBlock<DP>
          | "FORWARD"                                      (. OutIMS := DOM.isForwarded;
                                                              CASE DP^.ImplementationState OF
                                                              | DOM.isUnknown :  
                                                                DP^.ImplementationState := DOM.isForwarded;
                                                              | DOM.isDefined :
                                                                SemErrCS( err._ProcedureAlreadyDefined, DP^.N );
                                                              | DOM.isForwarded :
                                                                SemErrCS( err._ProcedureAlreadyForwarded, DP^.N );
                                                              END; .)
        )
    )                                                      (. c^.LeaveProcedureImplementation( DP, OutIMS, FALSE );
                                                              c^.CheckProcedureSemantics( DP ); .)
.

ntInitiallyFinallyDeclaration<CM : DOM.TCodeModifier; IUK, FUK : DOM.TUnitKind; VAR DFIU, IU, DFFU, FU : DOM.TPUnit; Df : DOM.TPSymbol; Im : DOM.TPUnit; IM : DOM.TInheritanceModifier> // !C.2.9
                                                           (. DP : DOM.TPProcedure; // definition
                                                              IP : DOM.TPProcedure;
                                                              S : stacks.CPtrStack; 
                                                              T : DOM.TPFormalType;
                                                              Entered : BOOLEAN := FALSE; .) // implementation
  =
  ( 
    SYNC "INITIALLY"                                       (. IF DOM.eoInitially IN Im^.Options THEN
                                                                SemErr( err._InitiallyRedeclaration );
                                                              ELSE
                                                                INCL( Im^.Options, DOM.eoInitially );
                                                              END;
                                                              IF DOM.eoInitially IN Df^.Options THEN
                                                                IF IUK = DOM.ukClassInitCode THEN
                                                                  INCL( c^.Options, DOM.eoClassInitialized );
                                                                  Entered := TRUE;
                                                                  c^.EnterSymbols( DOM.TPProcedure( DFIU )^.S, FALSE, FALSE, NIL );
                                                                END;
                                                              ELSIF IUK = DOM.ukClassInitCode THEN
                                                                SemErr( err._ClassHasNoExplicitInitially );
                                                              // ELSE
                                                                // Warning( L"INITIALLY is not defined in DEF" );
                                                              END; .) 
    ntProcedureId<iaCreateIfNotExists, DP>                 (. IF ( DOM.eoInitially IN Df^.Options ) AND ( DFIU <> NIL ) AND NOT DP^.N.Equals( DOM.TPSymbol( DFIU )^.N ) THEN
                                                                c^.SemErr( err._InitiallyNameMismatch );
                                                              END;
                                                              IF IUK = DOM.ukClassInitCode THEN
                                                                DP^.UnitKind := DOM.ukMethodDef;
                                                              END;
                                                              c^.CreateProcedureImplementation( DP, DOM.isImplementedA, DOM.amUnknown, IM, CM, IP );
                                                              INCL( IP^.Options, DOM.eoInitially ); .)
    ntProcedureDeclarationStub<DP, IP>                     (. EXCL( c^.Options, DOM.eoClassInitialized );
                                                              IU := IP;
                                                              IF (*( IUK <> DOM.ukClassInitCode ) AND*) DP^.GetFirstFormalType( REF S, OUT T ) THEN
                                                                c^.SemErr( err._InitCannotHaveParameters );
                                                              END;
                                                              IF DP^.T <> Types.TUnknown THEN
                                                                c^.SemErr( err._InitCannotHaveReturn );
                                                              END; .)
  | SYNC "FINALLY"                                         (. IF DOM.eoFinally IN Im^.Options THEN
                                                                SemErr( err._FinallyRedeclaration );
                                                              ELSE
                                                                INCL( Im^.Options, DOM.eoFinally );
                                                              END;
                                                              IF DOM.eoFinally IN Df^.Options THEN
                                                                IF FUK = DOM.ukClassFinalCode THEN
                                                                  Entered := TRUE;
                                                                  c^.EnterSymbols( DOM.TPProcedure( DFFU )^.S, FALSE, FALSE, NIL );
                                                                END;
                                                              ELSIF FUK = DOM.ukClassFinalCode THEN
                                                                SemErr( err._ClassHasNoExplicitFinally );
                                                              // ELSE
                                                                // Warning( L"FINALLY is not defined in DEF" );
                                                              END; .)
    ntProcedureId<iaCreateIfNotExists, DP>                 (. IF ( DOM.eoFinally IN Df^.Options ) AND ( DFFU <> NIL ) AND NOT DP^.N.Equals( DOM.TPSymbol( DFFU )^.N ) THEN
                                                                c^.SemErr( err._FinallyNameMismatch );
                                                              END;
                                                              IF FUK = DOM.ukClassFinalCode THEN
                                                                DP^.UnitKind := DOM.ukMethodDef;
                                                              END;
                                                              c^.CreateProcedureImplementation( DP, DOM.isImplementedA, DOM.amUnknown, IM, CM, IP );
                                                              INCL( IP^.Options, DOM.eoFinally ); .)
    ntProcedureDeclarationStub<DP, IP>                     (. FU := IP;
                                                              IF DP^.GetFirstFormalType( REF S, OUT T ) THEN
                                                                c^.SemErr( err._FinalCannotHaveParameters );
                                                              END;
                                                              IF DP^.T <> Types.TUnknown THEN
                                                                c^.SemErr( err._FinalCannotHaveReturn );
                                                              END; .)
  )                                                        (. IF Entered THEN
                                                                c^.LeaveSymbols( FALSE );
                                                              END; .)
.

/* =========data types */

ntTypeDenoter<VAR DataType : DOM.TPType; DLLInterface, AllowUnexisting : BOOLEAN; VAR Created : BOOLEAN> // !C.3.1
                                                           (. IdAction : TIdAction; .)
  =                                                        (. DataType := Types.TUnknown;
                                                              Created := FALSE;
                                                              IF AllowUnexisting THEN
                                                                IdAction := iaCheckNotReport;
                                                              ELSE
                                                                IdAction := iaCheck;
                                                              END; .)
  (
    ntTypeConstructor<DataType, DLLInterface, Created> // including ntOrdinalBaseType // *
  | ntNonOrdinalBaseType<DataType> // *
  | ntPointerBaseType<DataType> // *
  | ntExistingTypeId<IdAction, DataType> // *
  )
.

ntOrdinalTypeDenoter<VAR DataType : DOM.TPType> // !C.3.1       
  =                                                        (. DataType := Types.TUnknown; .)
  ( ntOrdinalBaseType<DataType>
    [ ntSubrangeTypeTail<DataType, DataType> // INT8[0..1]
    | ntEnumerationTypeTail<DataType, DataType, FALSE> ] // INT8( enum )
  | ntSubrangeTypeTail<NIL, DataType> // [0..1]
  | ntEnumerationTypeTail<NIL, DataType, FALSE>
  | ntExistingTypeId<iaCheck, DataType>                    (. c^.ExpectType( Types.TOrdinal, DataType, -1 ); .)
  )
.

/* =========data types -- new types */

ntTypeConstructor<VAR DataType : DOM.TPType; DLLInterface : BOOLEAN; VAR Created : BOOLEAN> // !C.3.3
  =                                                        (. DataType := Types.TUnknown;
                                                              Created := TRUE; .)
  ( ntOrdinalBaseType<DataType>                            (. Created := FALSE; .)
    [ ntSubrangeTypeTail<DataType, DataType>               (. Created := TRUE; .) // INT8[0..1]
    | ntEnumerationTypeTail<DataType, DataType, DLLInterface>
                                                           (. Created := TRUE; .) // INT8( enum )
    ] // *
  | ntSubrangeTypeTail<NIL, DataType> // [0..1] // *
  | ntEnumerationTypeTail<NIL, DataType, DLLInterface> // *
  // types above are copied in ntOrdinalTypeDenoter
  | ntSetType<DataType> // *
  | ntPointerType<DataType, DLLInterface> // *
  | ntProcedureType<DataType> // *
  | ntArrayType<DataType, DLLInterface> // *
  | ntRecordType<DataType, DLLInterface> // *
  )                                                        (. IF Created THEN
                                                                DataType^.Packing := c^.CurE^.Packing;
                                                              END; .)
.
  
/* =========data types -- enumerations */

ntEnumerationTypeTail<TypeRequest : DOM.TPType; VAR DataType : DOM.TPType; DLLInterface : BOOLEAN> // !C.3.4
                                                           (. Enumeration : DOM.TPEnumeration := NEW( DOM.CEnumeration ); .)
  =                                                        (. IF TypeRequest <> NIL THEN
                                                                Enumeration^.T := TypeRequest;
                                                              END;
                                                              IF DOM.eoQualifiedEnum IN Enumeration^.Options THEN
                                                                c^.EnterSymbols( Enumeration^.S, FALSE, FALSE, NIL );
                                                              END; .)
    lpar
      ntEnumerationList<Enumeration, DLLInterface>
    SYNC rpar                                              (. DataType := Enumeration;
                                                              DEC( Enumeration^.Last );
                                                              IF DOM.eoQualifiedEnum IN Enumeration^.Options THEN
                                                                c^.LeaveSymbols( FALSE );
                                                              END; .)
.

ntEnumerationList<Enumeration : DOM.TPEnumeration; DLLInterface : BOOLEAN>
  = ntEnumerationItem<Enumeration, DLLInterface>
    {
      WEAK comma ntEnumerationItem<Enumeration, DLLInterface>
    }
.

ntEnumerationItem<E : DOM.TPEnumeration; DLLInterface : BOOLEAN>
                                                           (. Constant : DOM.TPConstant;
                                                              EV : DOM.CEValue;
                                                              EX : DOM.TPExpression := NIL;
                                                              i : INT64 := 0;
                                                              n : ARRAY [0..31] OF WCHAR; .)
  = ntConstantId<iaCreate, Constant>                       (. Constant^.UnitKind := DOM.ukEnumItemImplicit;
                                                              IF DLLInterface THEN
                                                                Constant^.Options := Constant^.Options + c^.eosIF;
                                                              END;
                                                              E^.Add( Constant ); .)
    [ equals
      ntOrdinalExpression<vrsConst, EX>                    (. IF EX <> NIL THEN
                                                                Constant^.UnitKind := DOM.ukEnumItemExplicit;
                                                                Constant^.DeclarationExpression := EX;
                                                                EX^.Evaluate( EV, 0 );
                                                                i := EV.ToInteger();
                                                              END;
                                                              IF i <> E^.Last THEN
                                                                E^.Iteratable := FALSE;
                                                                E^.Last := i;
                                                              END;
                                                              IF ( E^.T <> Types.TUnknown ) AND NOT E^.T^.CheckIfExpressionFits( EX, i ) THEN
                                                                SemErr( err._EnumerationOutOfRange );
                                                              END; .)
    ]                                                      (. IF EX = NIL THEN
                                                                Strings.FromINT64W( E^.Last, 10, OUT n );
                                                                Constant^.Init2( E, n );
                                                              END;
                                                              Constant^.T := E;
                                                              IF E^.Empty THEN
                                                                E^.First := E^.Last;
                                                              END;
                                                              INC( E^.Last ); .)
.
  
/* =========data types -- subrange */

ntSubrangeTypeTail<TypeRequest : DOM.TPType; VAR DataType : DOM.TPType> // !C.3.5
                                                           (. E : DOM.TPExpression;
                                                              I : INT64;
                                                              Subrange : DOM.TPSubrange := NEW( DOM.CSubrange ); .)
  = lbracket
      ntConstantOrdinalExpression<E>                       (. IF TypeRequest = NIL THEN
                                                                Subrange^.N.FromOA( L"ORDINAL" );
                                                                Subrange^.T := E^.T;
                                                              ELSIF c^.ExpectType( TypeRequest, E^.T, -1 ) THEN
                                                                IF NOT TypeRequest^.CheckIfExpressionFits( E, I ) THEN
                                                                  SemErr( err._SubrangeOutOfBorder );
                                                                END;
                                                                Subrange^.T := TypeRequest;
                                                              ELSE
                                                                Subrange^.T := E^.T;
                                                              END;
                                                              Subrange^.Add( E ); .)
      ellipsis
      ntConstantOrdinalExpression<E>                       (. IF TypeRequest = NIL THEN
                                                                c^.CheckTypeMismatch( Subrange^.T, E^.T, FALSE, err._BordersMustHaveSameType );
                                                              ELSIF c^.ExpectType( TypeRequest, E^.T, -1 ) THEN
                                                                IF NOT TypeRequest^.CheckIfExpressionFits( E, I ) THEN
                                                                  SemErr( err._SubrangeOutOfBorder );
                                                                END;
                                                              END;
                                                              Subrange^.Add( E ); .)
    rbracket                                               (. DataType := Subrange; .)
.

/* =========data types -- subrange */

ntSetType<VAR DataType : DOM.TPType> // !C.3.6
                                                           (. R : INT64; .)
  =                                                        (. NEW( DOM.TPSet( DataType )); .)
    "SET"
    [ ntSetUnderlyingType<OUT DOM.TPSet( DataType )^.TU> ]
    "OF"
  ( ntOrdinalTypeDenoter<DataType^.T>
  | ntStorageBaseType<DataType^.T> )                       (. R := DataType^.T^.OrdinalRange();
                                                              IF DOM.TPSet( DataType )^.TU <> Types.TSet THEN
                                                                DOM.TPSet( DataType )^._Count := INT64( DOM.TPSet( DataType )^.TU^.OccupiedMemory());
                                                              // ELSIF ( DataType^.T^.Unwrap()^ IS DOM.CEnumeration ) AND ( DOM.TPEnumeration( DataType^.T^.Unwrap())^.T <> NIL ) THEN
                                                                // inherit size from typed enum
                                                                // DOM.TPSet( DataType )^.TU := DOM.TPEnumeration( DataType^.T^.Unwrap())^.T;
                                                                // DOM.TPSet( DataType )^._Count := INT64( DOM.TPSet( DataType )^.TU^.OccupiedMemory());
                                                              ELSIF R <= 32 THEN
                                                                DOM.TPSet( DataType )^._Count := 4;
                                                              ELSIF R <= 64 THEN
                                                                DOM.TPSet( DataType )^._Count := 8;
                                                              ELSIF R < MAX( CARDINAL ) - 7 THEN
                                                                DataType^.PrimitiveType := DOM.ptStructure;
                                                                DOM.TPSet( DataType )^._Count := ( R + 7 ) DIV 8;
                                                              ELSE
                                                                DataType^.PrimitiveType := DOM.ptStructure;
                                                                DOM.TPSet( DataType )^._Count := R DIV 8;
                                                              END; .)
.

ntSetUnderlyingType<OUT DataType : DOM.TPType>
=   "CARD8"                                                (. DataType := Types.TCARD8; .)
  | "CARD16"                                               (. DataType := Types.TCARD16; .)
  | "CARD32"                                               (. DataType := Types.TCARD32; .)
  | "CARD64"                                               (. DataType := Types.TCARD64; .)
.

/* =========data types -- pointer */

ntPointerType<VAR DataType : DOM.TPType; DLLInterface : BOOLEAN> // !C.3.8
                                                           (. BoundType : DOM.TPType;
                                                              TM : DOM.TTypeModifier := DOM.tmUnknown; .)
  =
    "POINTER" "TO" [ ntBoundTypeModifier<TM> ] ntBoundType<BoundType, DLLInterface>
                                                           (. NEW( DataType );
                                                              DataType^.TypeKind := DOM.tkReference;
                                                              IF BoundType = Types.TUnknown THEN
                                                                BoundType := NEW( DOM.CType );
                                                                BoundType^.TypeKind := DOM.tkOpaqueBase;
                                                                BoundType^.N.Assign( t.Val );
                                                                c^.AddSymbol( BoundType, FALSE );
                                                              END;
                                                              IF TM = DOM.tmUnknown THEN
                                                                DataType^.T := BoundType;
                                                              ELSE
                                                                DataType^.T := NEW( DOM.CFormalType );
                                                                IF DLLInterface THEN
                                                                  DataType^.T^.Options := DataType^.T^.Options + c^.eosIF;
                                                                END;
                                                                DOM.TPFormalType( DataType^.T )^.TypeModifier := TM;
                                                                DataType^.T^.T := BoundType;
                                                              END; .)
.

ntBoundTypeModifier<VAR TM : DOM.TTypeModifier>
  = "CONST"                                                (. TM := DOM.tmCONST; .)
  // | "REF"                                               (. TM := DOM.tmREF; .)
  // | "OUT"                                               (. TM := DOM.tmOUT; .)
.
  
ntBoundType<VAR DataType : DOM.TPType; DLLInterface : BOOLEAN> // !C.3.8
                                                           (. Created : BOOLEAN; .)
  = ntTypeDenoter<DataType, DLLInterface, TRUE, Created>   (. IF DataType = NIL THEN
                                                                DataType := Types.TUnknown; // opaque type will be created
                                                              ELSIF Created THEN
                                                                c^.ForwardComplexType( DataType );
                                                                IF DLLInterface THEN
                                                                  DataType^.OfSymbol := c;
                                                                  DataType^.Options := DataType^.Options + c^.eosIF;
                                                                END;
                                                              END; .)
.

/* =========data types -- procedure */

ntProcedureType<VAR DataType : DOM.TPType> // !C.3.9
  =                                                        (. NEW( DOM.TPProcedureType( DataType )); .)
    "PROCEDURE"                                            (. c^.EnterSymbols( DOM.TPProcedureType( DataType )^.S, TRUE, FALSE, NIL );
                                                              c^.EnterNewUnit( DOM.ukParameterList ); .)
    [
      lpar [ ntFormalParameterTypeList ] SYNC rpar
    ]
    [ ntFunctionTrailing<TRUE, DataType^.T> ]
    [ ntFunctionThrowInfo<DOM.TPProcedureType( DataType )> ]
                                                            (.  c^.LeaveUnit();
                                                                c^.LeaveSymbols( TRUE ); .)
.
  
/* =========data types -- formal type list, formal types */

ntFormalParameterTypeList // !C.3.9.3
  = ntFormalParameterType { WEAK comma ntFormalParameterType }
.
  
ntFormalParameterType // !C.3.9.3
                                                           (. TM : DOM.TTypeModifier; .)
  =                                                        (. TM := DOM.tmUnknown; .)
  [ 
      "VAR"                                                (. TM := DOM.tmVAR; .)
    | "REF"                                                (. TM := DOM.tmREF; .)
    | "CONST"                                              (. TM := DOM.tmCONST; .)
    | "OUT"                                                (. TM := DOM.tmOUT; .)
  ]
  ntFormalParameterTypeSpecification<TM>
.
  
ntFormalParameterTypeSpecification<TM : DOM.TTypeModifier> // !C.3.9.5
                                                           (. FP : DOM.TPFormalType;
                                                              N : StringsO.CString;
                                                              U : DOM.TPUnit;
                                                              Variable : DOM.TPVariable; .)
  =                                                        (. U := c^.EnterNewUnit( DOM.ukParamDefContainer );
                                                              c^.CreateSymbol( N, DOM.skVariable, FALSE, TRUE, Variable );
                                                              c^.AddUnit( Variable );
                                                              c^.LeaveUnit(); .)
    ntFormalType<FP>                                       (. FP^.TypeModifier := TM;
                                                              c^.ForwardOpaqueType( FP );
                                                              Variable^.UnitKind := DOM.ukParamDef;
                                                              Variable^.T := FP; .)
.

ntFormalType<VAR FP : DOM.TPFormalType> // !C.3.10
                                                           (. LFP : DOM.TPFormalType; .)
  =                                                        (. NEW( FP ); .)
  (
    ntTypeId<FP^.T>
  | ntOpenArrayFormalType<LFP>                             (. FP^.T := LFP; .)
  | ntSetFormalType<OUT FP^.T>
  )
.
  
ntOpenArrayFormalType<VAR FP : DOM.TPFormalType> // !C.3.10
                                                           (. ComponentType : DOM.TPFormalType; .)
  = "ARRAY" "OF" ntFormalType<ComponentType>               (. FP := c^.GetOpenArrayFormalType( ComponentType ); .)  
.

ntSetFormalType<OUT T : DOM.TPType>
                                                           (. ComponentType : DOM.TPType; .)
  = "SET" "OF" ntTypeId<ComponentType>                     (. IF Types.TOrdinal^.Compatible( DOM.cmOperation, ComponentType ) THEN
                                                                T := c^.GetSetFormalType( ComponentType );
                                                              ELSIF Types.TStorage^.Compatible( DOM.cmOperation, ComponentType ) THEN
                                                                T := c^.GetSetFormalType( ComponentType );
                                                              ELSE
                                                                SemErr( err._ExpectedOrdinalOrStorageType );
                                                                T := Types.TUnknown;
                                                              END; .)  
.

/* =========data types -- array */

ntArrayType<VAR DataType : DOM.TPType; DLLInterface : BOOLEAN> // !C.3.11
// M2 does not distinguish between ARRAY TypeA, TypeB OF TypeC and ARRAY TypeA OF ARRAY TypeB OF C,
// so all cases are compiled as ARRAY OF ARRAY
                                                           (. LastT, T : DOM.TPType; .)
  =                                                        (. NEW( DOM.TPArray( DataType ));
                                                              LastT := DataType; .)
    "ARRAY" ntIndexType<DOM.TPArray( DataType )^.I>
      {                                                    (. NEW( DOM.TPArray( T ));
                                                              LastT^.T := T;
                                                              LastT := T; .)
        WEAK comma
        ntIndexType<DOM.TPArray( T )^.I>
      }
    "OF" ntComponentType<LastT^.T, DLLInterface>
.
  
ntIndexType<VAR DataType : DOM.TPType> // !C.3.11
  = ntOrdinalTypeDenoter<DataType>
.
  
ntComponentType<VAR DataType : DOM.TPType; DLLInterface : BOOLEAN> // !C.3.11
                                                           (. New : BOOLEAN; .)
  = ntTypeDenoter<DataType, DLLInterface, FALSE, New>      (. IF New AND DLLInterface THEN
                                                                DataType^.OfSymbol := c;
                                                                DataType^.Options := DataType^.Options + c^.eosIF;
                                                              END; .)
.

/* =========data types -- record */

ntRecordType<VAR DataType : DOM.TPType; DLLInterface : BOOLEAN> // !C.3.12
                                                           (. Record : DOM.TPRecord;
                                                              VariantCount : CARDINAL := 0; .)
  =                                                        (. DataType := Types.TUnknown; .)
    SYNC "RECORD"                                          (. NEW( Record );
                                                              c^.EnterSymbols( Record^.S, TRUE, FALSE, NIL );
                                                              c^.PushOptions( c^.CurE^.Options - DOM.TEnvironmentOptions{DOM.eoDLLInterface, DOM.eoExport} ); .)
      ntFields<VariantCount, DLLInterface>                 (. c^.PopOptions();
                                                              c^.LeaveSymbols( TRUE );
                                                              DataType := Record;.)
    SYNC kwEND
.
  
ntFields<VAR VariantCount : CARDINAL; DLLInterface : BOOLEAN> // !C.3.12
  = ntField<VariantCount, DLLInterface>
    {
      WEAK semicolon
      ntField<VariantCount, DLLInterface>
    }
.
  
ntField<VAR VariantCount : CARDINAL; DLLInterface : BOOLEAN> // !C.3.12
  = ntFixedField<DLLInterface>
  | ntVariantField<VariantCount, DLLInterface>
  |
.
  
ntFixedField<DLLInterface : BOOLEAN> // !C.3.12.1
                                                           (. DataType : DOM.TPType;
                                                              U : DOM.TPUnit;
                                                              Variable : DOM.TPVariable;
                                                              b : BOOLEAN; .)
  =                                                        (. c^.EnterNewUnit( DOM.ukFieldIds ); .)
    ntIdList<iaCreate, DOM.skVariable>
    colon ntFieldType<DataType, DLLInterface>              (. U := c^.LeaveUnit();
                                                              c^.ForwardOpaqueType( DataType );
                                                              c^.ForwardComplexType( DataType );
                                                              b := U^.GetFirst( Variable );
                                                              WHILE b DO
                                                                Variable^.T := DataType;
                                                                b := U^.GetNext( Variable );
                                                              END; .)
.
  
ntFieldType<VAR DataType : DOM.TPType; DLLInterface : BOOLEAN> // !C.3.12.1
                                                           (. New : BOOLEAN; .)
  = ntTypeDenoter<DataType, DLLInterface, FALSE, New>
.

ntVariantField<VAR VariantCount : CARDINAL; DLLInterface : BOOLEAN> // !C.3.12.2
                                                           (. CaseT : DOM.TPType; .)
  =                                                        (. c^.EnterNewUnit( DOM.ukVariantContainer ); .)
    "CASE" ntTagField<CaseT, VariantCount> "OF"            (. INC( VariantCount ); .)
      ntVariants<CaseT, VariantCount, DLLInterface>
    SYNC kwEND                                             (. c^.LeaveUnit(); .)
.
  
ntTagField<VAR CaseT : DOM.TPType; VariantCount : CARDINAL> // !C.3.12.2
                                                           (. TagId : DOM.TPSymbol := NIL; .)
  = [
      ntId<iaCreate, DOM.skVariable, TagId, FALSE>
    ]                                                      (. IF TagId = NIL THEN
                                                                NEW( DOM.TPConstant( TagId ));
                                                                INCL( TagId^.Options, DOM.eoUnnamed );
                                                                TagId^.N.FromCARD32( VariantCount, 10 );
                                                                c^.AddSymbol( TagId, FALSE );
                                                              END;
                                                              TagId^.UnitKind := DOM.ukVariantSelector;
                                                              c^.AddUnit( TagId ); .)
    colon ntTypeId<TagId^.T>                               (. c^.ExpectType( Types.TOrdinal, TagId^.T, -1 );
                                                              CaseT := TagId^.T; .)
.

ntVariants<CaseT : DOM.TPType; VAR VariantCount : CARDINAL; DLLInterface : BOOLEAN> // !C.3.12.2
                                                           (. CC : DOM.COrdinalPresence; .)
  =                                                        (. c^.EnterNewUnit( DOM.ukVariantItem ); .)
    ntVariant<ADR( CC ), CaseT, VariantCount, DLLInterface>(. c^.LeaveUnit(); .)
    {                                                      (. c^.EnterNewUnit( DOM.ukVariantItem ); .)
      ntCaseSeparator
      ntVariant<ADR( CC ), CaseT, VariantCount, DLLInterface>
                                                           (. c^.LeaveUnit(); .)
    }
    [                                                      (. c^.EnterNewUnit( DOM.ukVariantElse ); .)
      ntVariantElsePart<VariantCount, DLLInterface>        (. c^.LeaveUnit(); .)
    ]
.

ntVariantElsePart<VAR VariantCount : CARDINAL; DLLInterface : BOOLEAN> // !C.3.12.2
  = "ELSE" ntFields<VariantCount, DLLInterface>
.

ntVariant<CC : DOM.TPOrdinalPresence; CaseT : DOM.TPType; VAR VariantCount : CARDINAL; DLLInterface : BOOLEAN>
// !C.3.12.2 -- ntVariantLabels replaced by the same ntCaseLabels
//  = [ ntVariantLabels<CC, RecordVariant> colon ntFields<RecordVariant, VariantCount> ]
  = [ ntCaseLabels<DOM.ukVariantLabel, CC, CaseT> colon ntFields<VariantCount, DLLInterface> ]
.

// ntVariantLabels replaced by the same ntCaseLabels
// ntVariantLabels // !C.3.12.2
//   = ntVariantLabel
//     { comma ntVariantLabel }
// .
  
// ntVariantLabel replaced by the same ntCaseLabel
// ntVariantLabel
//   = ntConstantOrdinalExpression [ ellipsis ntConstantOrdinalExpression ]
// .

/* =========blocks -- procedures */

ntProperProcedureBlock<ExpectedProcedure : DOM.TPProcedureType> // !C.4.1
                                                           (. Procedure : DOM.TPProcedure; .)
  = ntDeclarations                                         (. c^.EnterNewCTDeclUnit( ExpectedProcedure^.OI ); .)
    [ ntProcedureBody ]                                    (. c^.LeaveCTDeclUnit(); .)
    SYNC kwEND ntProcedureId<iaCheck, Procedure>           (. IF ExpectedProcedure <> Procedure THEN
                                                                c^.SemErrExpectId( ExpectedProcedure );
                                                              END; .)
.
  
ntProperMemberBlock<ExpectedMember : DOM.TPProcedureType>  (. Member : DOM.TPMember; .)
  = ntDeclarations                                         (. c^.EnterNewCTDeclUnit( ExpectedMember^.OI ); .)
    [ ntProcedureBody ]                                    (. c^.LeaveCTDeclUnit(); .)
    SYNC kwEND ntMemberDeclId<Member, FALSE>               (. IF ExpectedMember <> Member THEN
                                                                c^.SemErrExpectId( ExpectedMember );
                                                              END; .)
.

ntProperClassBlock<ExpectedMember : DOM.TPProcedureType>   (. Class : DOM.TPClass; .)
  = ntDeclarations                                         (. c^.EnterNewCTDeclUnit( ExpectedMember^.OI ); .)
    [ ntProcedureBody ]                                    (. c^.LeaveCTDeclUnit(); .)
    SYNC kwEND ntMemberDeclId<Class, TRUE>                 (. IF ExpectedMember^.OfSymbol <> Class THEN
                                                                c^.SemErrExpectId( ExpectedMember );
                                                              END; .)
.

ntProcedureBody // !C.4.1, entrypoint flag
  = "BEGIN" ntBlockBody<Types.TUnknown, FALSE>
.

ntFunctionProcedureBlock<ExpectedProcedure : DOM.TPProcedureType> // !C.4.2
                                                           (. Procedure : DOM.TPProcedure; .)
  = ntDeclarations                                         (. c^.EnterNewCTDeclUnit( ExpectedProcedure^.OI ); .)
    ntFunctionBody<ExpectedProcedure^.T>                   (. c^.LeaveCTDeclUnit(); .)
    SYNC kwEND ntProcedureId<iaCheck, Procedure>           (. IF ExpectedProcedure <> Procedure THEN
                                                                c^.SemErrExpectId( ExpectedProcedure );
                                                              END; .)
.

ntFunctionMemberBlock<ExpectedMember : DOM.TPProcedureType>
                                                           (. Member : DOM.TPMember; .)
  = ntDeclarations                                         (. c^.EnterNewCTDeclUnit( ExpectedMember^.OI ); .)
    ntFunctionBody<ExpectedMember^.T>                      (. c^.LeaveCTDeclUnit(); .)
    SYNC kwEND ntMemberDeclId<Member, FALSE>               (. IF ExpectedMember <> Member THEN
                                                                c^.SemErrExpectId( ExpectedMember );
                                                              END; .)
.

ntFunctionClassBlock<ExpectedMember : DOM.TPProcedureType>
                                                           (. Class : DOM.TPClass; .)
  = ntDeclarations                                         (. c^.EnterNewCTDeclUnit( ExpectedMember^.OI ); .)
    ntFunctionBody<ExpectedMember^.T>                      (. c^.LeaveCTDeclUnit(); .)
    SYNC kwEND ntMemberDeclId<Class, TRUE>                 (. IF ExpectedMember^.OfSymbol <> Class THEN
                                                                c^.SemErrExpectId( ExpectedMember );
                                                              END; .)
.

ntFunctionBody<RequestedReturnType : DOM.TPType> // !C.4.2, entrypoint flag
  = "BEGIN" ntBlockBody<RequestedReturnType, FALSE>
.

/* =========blocks -- modules */

ntModuleBlock // !C.4.3
  = ntModuleDeclarations
    ntISOInitializationFinalization<DOM.ukModuleInitCode, DOM.ukModuleFinalCode, c^.InitCode, c^.FinalCode, c^.OD, c>
.
  
/* =========blocks -- exceptions */

ntBlockBody<RequestedReturnType : DOM.TPType; ClassInitCode : BOOLEAN> // !C.4.4 modified
                                                           (. Df : DOM.TPProcedureType;
                                                              R : TReturn;
                                                              T : DOM.TPType;
                                                              U : DOM.TPUnit; .)
  =                                                        (. EXCL( c^.Options, DOM.eoASMBlock );
                                                              Df := c^.CurrentP();
                                                              IF Df <> NIL THEN
                                                                Df := DOM.TPProcedure( Df )^.OD;
                                                              END;
                                                              IF Df = NIL THEN
                                                                c^.EnterNewUnit( DOM.ukBlockBody );
                                                              ELSIF ( Df^.UnitKind = DOM.ukMethodDef ) AND
                                                                    ( DOM.eoInitially IN Df^.Options ) THEN
                                                                c^.EnterNewUnit( DOM.ukBlockBody );
                                                                ClassInitCode := TRUE;
                                                              ELSIF ( RequestedReturnType = Types.TUnknown ) AND 
                                                                    ( Df^.UnitKind = DOM.ukPropertyDef ) AND
                                                                    ( DOM.imCOM IN Df^.IM ) THEN
                                                                c^.EnterNewUnit( DOM.ukBlockBodyOfCOMProcedure );
                                                              ELSE
                                                                c^.EnterNewUnit( DOM.ukBlockBody );
                                                              END;
                                                              // space for class init code
                                                              IF ClassInitCode THEN
                                                                NEW( U ); U^.UnitKind := DOM.ukClassInitStart; c^.AddUnit( U );
                                                                U^.Owner := c^.CurrentC();
                                                              END;
                                                              // store return type for deferred returns purposes
                                                              NEW( T );
                                                              Storage.Fill( ADR( T^.GenTo ), SIZE( T^.GenTo ), 0 );
                                                              T^.UnitKind := DOM.ukEntryPointReturnType;
                                                              T^.TypeKind := DOM.tkLink;
                                                              T^.T := RequestedReturnType;
                                                              c^.AddUnit( T ); .)
    ntStatements<RequestedReturnType, R>                   (. U := c^.LeaveUnit();
                                                              IF ( Df <> NIL ) AND ( DOM.eoHaveReturnInCPPTry IN c^.CurrentP()^.Options ) THEN
                                                                INCL( U^.Options, DOM.eoHaveReturnInCPPTry );
                                                                IF RequestedReturnType = Types.TUnknown THEN
                                                                  U^.UnitKind := DOM.ukBlockBodyOfReturnInTryProc;
                                                                ELSE
                                                                  U^.UnitKind := DOM.ukBlockBodyOfReturnInTryFunc;
                                                                END;
                                                              END;
                                                              IF RequestedReturnType <> Types.TUnknown THEN
                                                                CASE R OF
                                                                | retUnknown, retUnknownInSomeBranch, retPrematured :
                                                                  SemErr( err._NotAllPathsReturn );
                                                                | retUncertain :
                                                                  // Warning( L"Statements block does not contain RETURN" );
                                                                END;
                                                              END; .).
  
/* =========blocks -- statements */

ntStatements<RequestedReturnType : DOM.TPType; VAR R : TReturn> // !C.5.1
                                                           (. EGL : DOM.TPSLabel;
                                                              Label : DOM.TPLabel;
                                                              LR : TReturn; .)
  = [                                                      (. IF IsLabel( Label ) THEN
                                                                NEW( EGL ); .)
      ntLabelId<iaCheck, EGL^.L> colon                     (.   c^.AddUnit( EGL );
                                                                IF DOM.eoInitialized IN EGL^.L^.Options THEN
                                                                  SemErr( err._LabelDestinationAlreadyKnown );
                                                                END;
                                                                INCL( EGL^.L^.Options, DOM.eoInitialized );
                                                              END; .)
    ]
    ntStatement<RequestedReturnType, R>
    {
      WEAK semicolon
      [                                                    (. IF IsLabel( Label ) THEN
                                                                NEW( EGL ); .)
        ntLabelId<iaCheck, EGL^.L> colon                   (.   c^.AddUnit( EGL );
                                                                IF DOM.eoInitialized IN EGL^.L^.Options THEN
                                                                  SemErr( err._LabelDestinationAlreadyKnown );
                                                                END;
                                                                INCL( EGL^.L^.Options, DOM.eoInitialized );
                                                                LR := retLabel;
                                                                IF R >= retOK THEN
                                                                  R := retUnknown;
                                                                END;
                                                              END; .)
      ]
      ntStatement<RequestedReturnType, LR>                 (. IF ( R >= retOK ) AND ( LR > retUnknownInSomeBranch ) THEN
                                                                R := retPrematured;
                                                                Warning( wrn._CodeAfterRETURNIgnored );
                                                              END;
                                                              IF LR > R THEN
                                                                R := LR;
                                                              END; .)
    }
.
  
ntStatement<RequestedReturnType : DOM.TPType; VAR R : TReturn> // !C.5         
  =                                                        (. R := retUnknown; .)
  (
    ntEmptyStatement // *
  /* grammar modified, procedure and assignment boh starts with designator,
   * so the distinguishing must be done after reading it
  | ntProcedureCall
  | ntAssignmentStatement
   */ 
  | ntAssignmentOrCallStatement // *
  | ntReturnStatement<RequestedReturnType>                 (. R := retOK; .) // *
  | ntWithStatement<RequestedReturnType, R> // *
  | ntIfStatement<RequestedReturnType, R> // *
  | ntCaseStatement<RequestedReturnType, R> // *
  | ntExitStatement                                        (. R := retExit; .) // *
  | ntContinueStatement // *
  | ntWhileStatement<RequestedReturnType> // *
  | ntRepeatStatement<RequestedReturnType> // *
  | ntLoopStatement<RequestedReturnType, R> // *
  | ntForStatement<RequestedReturnType> // *
  | ntGotoStatement                                        (. R := retGOTO; .) // *
  | ntStructuralExceptionHandlingStatement<RequestedReturnType, R> // ?
  | ntThrowStatement                                       (. R := retGOTO; .) // *
  | ntAsmStatement                                         (. R := retUncertain; .) // ?
  )
.
  
/* ---------- */

ntEmptyStatement
  =
.
  
/* ---------- */

ntAssignment
  = equals                                                (. SemErr( err._AssignmentExpected ); .)
  | assignment
.

ntAssignmentOrCallStatement                                (. A : DOM.TPSAssignment := NEW( DOM.CSAssignment );
                                                              C : DOM.TPClass;
                                                              Duplicate : BOOLEAN := FALSE;
                                                              FT : DOM.TPFormalType;
                                                              LD : DOM.TPDesignator;
                                                              Reduce : TRISTATE; // 1 = all, -1 = only Release(), 0 = nothing
                                                              S : stacks.CPtrStack;
                                                              VI : DOM.TValueInfo;
                                                              AssumeCall : BOOLEAN; .)
  =                                                        (. NEW( A^.D );
                                                              c^.AddUnit( A );
                                                              c^.EnterUnit( A );
                                                              c^.SetCurrentStatement( A ); .)
    ntVariableDesignator<vrsDefault + TValueReq{vrAssignment}, A^.D, VI>
                                                           (. A^.D^.UnitKind := DOM.ukAssignmentDesignator;
                                                              AssumeCall := TRUE; .)
  [                                                        (. AssumeCall := FALSE;
                                                              A^.D^.MarkAsInitializedAndCheckRO( c, TRUE, TRUE );
                                                              IF DOM.visLValue * VI = DOM.TValueInfo{} THEN
                                                                SemErr( err._ExpectedLValue );
                                                              END; .)
    ntAssignment                                           (. A^.UnitKind := DOM.ukSAssignment;
                                                              IF DOM.viPropertyAssign IN VI THEN
                                                                A^.UnitKind := DOM.ukSAssignmentByCall1;
                                                              ELSIF DOM.TValueInfo{DOM.viOperatorAssign, DOM.viIndexerAssign} * VI <> DOM.TValueInfo{} THEN
                                                                A^.UnitKind := DOM.ukSAssignmentByCall2;
                                                              ELSIF Types.TTCHAR^.Compatible( DOM.cmAssign, A^.D^.T ) THEN
                                                                // simple CHARs need not to be assigned by call
                                                              ELSIF Types.TString^.Compatible( DOM.cmAssign, A^.D^.T ) THEN
                                                                A^.UnitKind := DOM.ukSAssignmentStringByEmbeddedCall;
                                                              ELSIF A^.D^.T^.Unwrap()^.TypeKind = DOM.tkClass THEN
                                                                C := DOM.TPClass( A^.D^.T^.Unwrap());
                                                              END; .) 
    ntExpression<A^.E>
                                                           (. c^.ExpectType( A^.D^.T, A^.E^.T, -1 );
                                                              c^.CheckCONSTAssignment( VI, A^.E^.VI, A^.D^.T, A^.E^.T );
                                                              IF A^.E^.T^.UnwrapToBaseType()^.IsClass() AND
                                                                 DOM.TPClass( A^.E^.T^.UnwrapToBaseType())^.IsDescendantOf( DOM.TPClass( A^.D^.T^.UnwrapToBaseType()), FALSE, TRUE, OUT Duplicate ) AND
                                                                 Duplicate THEN
                                                                SemErr( err._AmbiguousUsageOfAncestor );
                                                              END;
                                                              IF Types.TSet^.Compatible( DOM.cmAssign, A^.D^.T ) AND DOM.TPSet( A^.D^.T^.Unwrap())^.IsLong() AND
                                                                 (
                                                                   ( A^.E^.T^.Unwrap() = Types.TSet ) OR
                                                                   ( A^.E^.N^.r.N = DOM.enDesignator ) AND ( A^.E^.N^.r.V^.r.DK = DOM.dkType )
                                                                 ) THEN
                                                                        // @@STRUCT SET ASSIGN
                                                                 // So, here we assign TSet to long typed set (something like: LongTypedSetVar = {} is written).
                                                                 // Such assignment will be solved by macro using embedded call.
                                                                A^.UnitKind := DOM.ukSAssignmentSetByEmbeddedCall;
                                                              END;
                                                              IF A^.D^.T^.IsFormal() THEN
                                                                A^.E^.TargetT := A^.D^.T^.Unwrap();
                                                              ELSE
                                                                A^.E^.TargetT := A^.D^.T;
                                                              END;
                                                              //=====
                                                              // simplify and reduce COM members handling
                                                              IF ( A^.E^.N^.r.N = DOM.enDesignator ) AND // expression is designator (factor), no operators found
                                                                 ( A^.UnitKind = DOM.ukSAssignment ) THEN // normal assign, L-Value is variable, not property or index
                                                                Reduce := 0;
                                                                WITH A^.E^.N^.r.V^.r DO
                                                                  IF ( DK = DOM.dkId ) AND ( CD <> NIL ) THEN
                                                                    // designator is immediatelly COM, it has ComDesignator
                                                                    LD := A^.E^.N^.r.V;
                                                                    Reduce := 1;
                                                                  ELSIF ( DK = DOM.dkType ) AND TC^.GetDesignator( OUT LD ) THEN // designator is Type, check to get designator
                                                                    // again, term is T( D ), where D is COM member
                                                                    Reduce := -1;
                                                                  // ELSE // designator cannot be reduced it is not COM
                                                                  END;
                                                                END; // WITH
                                                                IF ( Reduce <> 0 ) AND ( LD^.r.CD = NIL ) THEN
                                                                  Reduce := 0;
                                                                END;
                                                                IF ( Reduce <> 0 ) THEN WITH LD^.r DO
                                                                  // expr ends with COM memeber, the member has CD, preceding statement and following statement stored in CD
                                                                  IF Reduce > 0 THEN
                                                                    // (1) change preceding statement to use A^.D
                                                                    PA^.D^.r.CD := A^.D;
                                                                    // (2) change self to preceding (kill self, leave only the preceding statement)
                                                                    A^.UnitKind := PA^.UnitKind;
                                                                    A^.D := PA^.D;
                                                                    // (3) kill aux variable, preceding and following statement (lower)
                                                                    CD^.r.Id^.GenTo[Generator.genCPP] := FALSE;
                                                                    CD^.r.PA^.GenTo[Generator.genCPP] := FALSE;
                                                                  END;
                                                                  IF CD^.r.FA <> NIL THEN
                                                                    CD^.r.FA^.GenTo[Generator.genCPP] := FALSE;
                                                                  END;
                                                                END; END; // WITH, IF
                                                              END; .)
                                                              //=====
  ]                                                        (. IF AssumeCall THEN
                                                                A^.UnitKind := DOM.ukSCall;
                                                                CASE A^.D^.r.DK OF
                                                                | DOM.dkId :
                                                                  IF ( A^.D^.r.Id = NIL ) OR NOT A^.D^.r.Id^.IsProcedure( TRUE ) THEN
                                                                    SemErr( err._CallNotProcedure );
                                                                  ELSIF ( A^.D^.r.Id^.OfSymbol^.SymbolKind = DOM.skClass ) AND
                                                                        ( A^.D^.r.Id^.Options * DOM.TEnvironmentOptions{DOM.eoInitially} <> DOM.TEnvironmentOptions{} ) THEN
                                                                    SemErr( err._ConstructorCannotBeCalled );
                                                                  ELSIF DOM.TPProcedureType( A^.D^.r.Id )^.GetFirstFormalType( REF S, OUT FT ) THEN
                                                                    SemErr( err._TooFewParameters );
                                                                  ELSE
                                                                    SemErr( err._ParameterListMissing );
                                                                  END;
                                                                | DOM.dkType :
                                                                  SemErr( err._CallProcedureType );
                                                                | DOM.dkOperator :
                                                                  IF A^.D^.r.O <> DOM.doCall THEN
                                                                    SemErr( err._ParameterListMissing );
                                                                  END;
                                                                END; // CASE
                                                              END;
                                                              c^.SetCurrentStatement( NIL );
                                                              c^.LeaveUnit(); .)
.

/* ---------- */

/* Unused in grammar, assignment and call is handled differently to remove LL(1) conflict.
 * ntProcedureDesignator is resolved semantically.
ntProcedureCall                        (. CType[] ParameterTypes; .)
  = ntProcedureDesignator [ ntActualParameters<ParameterTypes> ]
.
  
ntProcedureDesignator
  = ntVariableDesignator
.
 */

/* ---------- */

ntReturnStatement<RequestedReturnType : DOM.TPType>        (. E : DOM.TPExpression;
                                                              P : DOM.TPProcedureType;
                                                              R : DOM.TPSReturn := NEW( DOM.CSReturn );
                                                              b : BOOLEAN; .)
  =                                                        (. P := c^.CurrentP();
                                                              IF P = NIL THEN
                                                                R^.UnitKind := DOM.ukReturn;
                                                              ELSIF DOM.imCOM IN P^.IM THEN
                                                                R^.UnitKind := DOM.ukReturnInCOM;
                                                              ELSIF DOM.eoInsideCPPTry IN P^.Options THEN
                                                                R^.UnitKind := DOM.ukReturnInCPPTry;
                                                                R^.L := DOM.TPLabel( c^.TStack.PeekData());
                                                              ELSE
                                                                R^.UnitKind := DOM.ukReturn;
                                                              END;
                                                              c^.AddUnit( R );
                                                              c^.EnterUnit( R );
                                                              c^.SetCurrentStatement( R ); .)
    "RETURN"
    (                                                      (. IF NOT Types.TUnknown^.Compatible( DOM.cmAssign, RequestedReturnType ) THEN
                                                                SemErr( err._ProcedureMustReturnAValue );
                                                              END; .)
      // ntProcedureReturnStatement
    | // ntFunctionReturnStatement<Expression> is after the reduction the same as:
      ntExpression<E>                                      (. b := c^.ExpectType( RequestedReturnType, E^.T, -1 );
                                                              IF RequestedReturnType^.IsFormal() AND ( DOM.TPFormalType( RequestedReturnType )^.TypeModifier = DOM.tmCONST ) THEN 
                                                                b := c^.CheckCONSTAssignment( DOM.TValueInfo{DOM.viCONST}, E^.VI, RequestedReturnType, E^.T ) AND b;
                                                              ELSE
                                                                b := c^.CheckCONSTAssignment( DOM.TValueInfo{}, E^.VI, RequestedReturnType, E^.T ) AND b;
                                                              END;
                                                              // convert (string) literal to constant, otherwise it cannot be returned
                                                              IF b AND ( DOM.viLiteral IN E^.VI ) AND ( RequestedReturnType^.Unwrap()^.TypeKind = DOM.tkArray ) THEN
                                                                c^.HandleAuxConstantExpressionRequest( RequestedReturnType, E );
                                                              END;
                                                              E^.TargetT := RequestedReturnType;
                                                              c^.AddUnit( E ); .)
    )                                                      (. c^.SetCurrentStatement( NIL );
                                                              c^.LeaveUnit(); .)
.
// ntFunctionReturnStatement<VAR Expression : DOM.TPExpression>
//   = ntExpression<Expression>
// .

/* ---------- */

ntWithStatement<RequestedReturnType : DOM.TPType; VAR R : TReturn> // C.5.7
                                                           (. D : DOM.TPDesignator := NEW( DOM.CDesignator );
                                                              LT : DOM.TPType; .)
  = SYNC "WITH" ntRecordDesignator<D> WEAK "DO"            (. D^.UnitKind := DOM.ukWithDesignator;
                                                              // unsuitable optimalization,
                                                              // D^.W is not written recursively
                                                              // and WITH S DO WITH T DO U = ...
                                                              // outputs T.U only...
                                                              // IF ( D^.r.DK = DOM.dkId ) AND ( D^.r.Id^.SymbolKind = DOM.skVariable ) THEN
                                                              //   // use variable directly
                                                              //   D^.r.WV := DOM.TPVariable( D^.r.Id );
                                                              //   D^.MarkAsInitializedAndCheckRO( c, FALSE, FALSE );
                                                              // ELSE // create special variable
                                                                NEW( DOM.TPVariable( D^.r.WV )); // create with variable
                                                                c^.SetNumId( D^.r.WV, FALSE, L"With_" );
                                                                IF DOM.viConst IN D^.VI THEN
                                                                  LT := NEW( DOM.CFormalType );
                                                                  DOM.TPFormalType( LT )^.TypeModifier := DOM.tmCONST;
                                                                  NEW( LT^.T );
                                                                  D^.r.WV^.T := LT;
                                                                  LT := LT^.T;
                                                                ELSE
                                                                  D^.r.WV^.T := NEW( DOM.CType );
                                                                  LT := D^.r.WV^.T;
                                                                END;
                                                                LT^.TypeKind := DOM.tkReference;
                                                                LT^.T := D^.T;
                                                                c^.AddToCTDeclUnit( D^.r.WV );
                                                                c^.AddUnit( D );
                                                              // END;
                                                              LT := D^.T^.Unwrap();
                                                              IF LT^.TypeKind = DOM.tkRecord THEN
                                                                c^.EnterSymbols( DOM.TPRecord( LT )^.S, FALSE, FALSE, D );
                                                              ELSIF LT^.TypeKind = DOM.tkClass THEN
                                                                c^.EnterSymbols( DOM.TPClass( LT )^.S, FALSE, FALSE, D );
                                                              END; .)
      ntStatements<RequestedReturnType, R>                 (. IF ( LT^.TypeKind = DOM.tkRecord ) OR ( LT^.TypeKind = DOM.tkClass ) THEN
                                                                c^.LeaveSymbols( FALSE );
                                                              END; .)
    SYNC kwEND                          
.
  
ntRecordDesignator<VAR D : DOM.TPDesignator> // C.5.7
                                                           (. VI : DOM.TValueInfo; .)
  = ntVariableDesignator<vrsDefault, D, VI>                (. CASE D^.T^.Unwrap()^.TypeKind OF
                                                              | DOM.tkRecord, DOM.tkClass :
                                                              ELSE
                                                                SemErr( err._RecordOrClassExpected );
                                                              END; .)
/* removed to solve LL(1) ambiguity
  | ntValueDesignator
*/
.

/* ---------- */

ntIfStatement<RequestedReturnType : DOM.TPType; VAR R : TReturn>
                                                           (. LR1, LR2 : TReturn; .)
  =                                                        (. LR2 := retUnknown;
                                                              c^.EnterNewUnit( DOM.ukIf ); .)
    ntGuardedStatements<RequestedReturnType, LR1>
    [
      ntIfElsePart<RequestedReturnType, LR2>               (. IF LR1 = retExit THEN
                                                                // leave LR1 untouched
                                                              ELSIF LR2 = retExit THEN
                                                                LR1 := retExit;
                                                              ELSIF ( LR2 < retPrematured ) AND ( LR2 < LR1 ) THEN
                                                                LR1 := LR2;
                                                              END; .)
    ]
    WEAK kwEND                                             (. c^.LeaveUnit();
                                                              IF LR2 = retUnknown THEN
                                                                IF LR1 = retExit THEN
                                                                  R := retExit;
                                                                ELSIF LR1 > retUnknown THEN
                                                                  R := retUnknownInSomeBranch;
                                                                ELSE
                                                                  R := retUnknown;
                                                                END;
                                                              ELSIF LR1 < retPrematured THEN
                                                                R := LR1;
                                                              ELSIF LR1 < retGOTO THEN
                                                                R := retOK;
                                                              ELSE
                                                                R := retGOTO;
                                                              END; .)
.

ntGuardedStatements<RequestedReturnType : DOM.TPType; VAR R : TReturn>
                                                           (. LR1, LR2 : TReturn; .)
  =                                                        (. LR2 := retUnknown;
                                                              c^.EnterNewUnit( DOM.ukIfExpr ); .)
    SYNC "IF" ntBooleanExpression WEAK "THEN"              (. c^.LeaveUnit();
                                                              c^.EnterNewUnit( DOM.ukIfBlock ); .)
      ntStatements<RequestedReturnType, LR1>               (. c^.LeaveUnit(); .)
    {                                                      (. c^.EnterNewUnit( DOM.ukElsifExpr ); .)
      SYNC "ELSIF" ntBooleanExpression WEAK "THEN"         (. c^.LeaveUnit();
                                                              c^.EnterNewUnit( DOM.ukElsifBlock ); .)
        ntStatements<RequestedReturnType, LR2>             (. c^.LeaveUnit();
                                                              IF LR1 = retExit THEN
                                                                // leave LR1 untouched
                                                              ELSIF ( LR2 < retPrematured ) AND ( LR2 < LR1 ) THEN
                                                                LR1 := LR2;
                                                              END; .)
    }                                                      (. IF LR1 < retPrematured THEN
                                                                R := LR1;
                                                              ELSIF LR1 < retGOTO THEN
                                                                R := retOK;
                                                              ELSE
                                                                R := retGOTO;
                                                              END; .)
.

ntIfElsePart<RequestedReturnType : DOM.TPType; VAR R : TReturn>
  =                                                        (. c^.EnterNewUnit( DOM.ukElse ); .)
    SYNC "ELSE" ntStatements<RequestedReturnType, R>       (. c^.LeaveUnit(); .)
.
  
ntBooleanExpression                                        (. Expression : DOM.TPExpression; .)
  = ntExpression<Expression>                               (. c^.ExpectType( Types.TBOOLEAN, Expression^.T, -1 );
                                                              c^.AddUnit( Expression ); .)
.

/* ---------- */

ntCaseStatement<RequestedReturnType : DOM.TPType; VAR R : TReturn>
                                                           (. T : DOM.TPType; .)
  =                                                        (. c^.EnterNewUnit( DOM.ukSCase ); .)
    SYNC "CASE" ntCaseSelector<T>
    "OF" ntCases<T, RequestedReturnType, R>
    WEAK kwEND                                             (. c^.LeaveUnit(); .)
.
  
ntCaseSelector<VAR CaseT : DOM.TPType>                     (. E : DOM.TPExpression; .)
  =                                                        (. c^.EnterNewUnit( DOM.ukCaseSelector ); .)
    ntOrdinalExpression<vrsDefault, E>                     (. CaseT := E^.T;
                                                              c^.AddUnit( E );
                                                              c^.LeaveUnit(); .)
.
  
ntCases<CaseT, RequestedReturnType : DOM.TPType; VAR R : TReturn>
                                                           (. CC : DOM.COrdinalPresence;
                                                              LR1, LR2 : TReturn := retUnknown; .)
  =                                                        (. c^.EnterNewUnit( DOM.ukCaseItem ); .)
    ntCase<ADR( CC ), CaseT, RequestedReturnType, LR1>     (. c^.LeaveUnit(); .)
    {
      SYNC ntCaseSeparator                                 (. c^.EnterNewUnit( DOM.ukCaseItem ); .)
        ntCase<ADR( CC ), CaseT, RequestedReturnType, LR2> (. c^.LeaveUnit();
                                                              IF LR1 = retExit THEN
                                                                // leave LR1 untouched
                                                              ELSIF LR2 = retExit THEN
                                                                LR1 := retExit;
                                                              ELSIF ( LR2 < retPrematured ) AND ( LR2 < LR1 ) THEN
                                                                LR1 := LR2;
                                                              END; .)
    }                                                      (. IF LR1 = retPrematured THEN
                                                                LR1 := retOK;
                                                              END;
                                                              LR2 := retUnknown; .)
    [                                                      (. c^.EnterNewUnit( DOM.ukCaseElse ); .)
      ntCaseElsePart<RequestedReturnType, LR2>             (. c^.LeaveUnit();
                                                              IF LR1 = retExit THEN
                                                                // leave LR1 untouched
                                                              ELSIF LR2 = retExit THEN
                                                                LR1 := retExit;
                                                              ELSIF ( LR2 < retPrematured ) AND ( LR2 < LR1 ) THEN
                                                                LR1 := LR2;
                                                              END; .)
    ]                                                      (. IF LR2 = retUnknown THEN
                                                                IF LR1 = retExit THEN
                                                                  R := retExit;
                                                                ELSIF LR1 > retUnknown THEN
                                                                  R := retUnknownInSomeBranch;
                                                                ELSE
                                                                  R := retUnknown;
                                                                END;
                                                              ELSIF LR1 < retPrematured THEN
                                                                R := LR1;
                                                              ELSIF LR1 < retGOTO THEN
                                                                R := retOK;
                                                              ELSE
                                                                R := retGOTO;
                                                              END; .)
.
  
ntCaseElsePart<RequestedReturnType : DOM.TPType; VAR R : TReturn>
  = SYNC "ELSE" ntStatements<RequestedReturnType, R>
.

ntCase<CC : DOM.TPOrdinalPresence; CaseT, RequestedReturnType : DOM.TPType; VAR R : TReturn>
  =                                                        (. R := retOK; .)
    [                                                      (. R := retUnknown; .)
      ntCaseLabels<DOM.ukCaseLabel, CC, CaseT> colon ntStatements<RequestedReturnType, R> ]
.
  
ntCaseLabels<LabelKind : DOM.TUnitKind; CC : DOM.TPOrdinalPresence; CaseT : DOM.TPType>
  =                                                        (. c^.EnterNewUnit( LabelKind ); .)
    ntCaseLabel<CC, CaseT>                                 (. c^.LeaveUnit(); .)
    {                                                      (. c^.EnterNewUnit( LabelKind ); .)
      WEAK comma ntCaseLabel<CC, CaseT>                    (. c^.LeaveUnit(); .)
    }
.
  
ntCaseLabel<CC : DOM.TPOrdinalPresence; CaseT : DOM.TPType>(. E : DOM.TPExpression;
                                                              I1, I2 : INT64 := 0;
                                                              Error, Single : BOOLEAN := FALSE; .)
  = ntConstantOrdinalExpression<E>                         (. IF NOT c^.ExpectType( CaseT, E^.T, err._CaseLabelDoesNotMatchSelector ) THEN
                                                                Error := TRUE;
                                                              ELSIF CaseT^.CheckIfExpressionFits( E, I1 ) THEN
                                                                E^.T := CaseT;
                                                              ELSE
                                                                Error := TRUE;
                                                                SemErr( err._CaseLabelIsOutOfTypeRange );
                                                              END;
                                                              c^.AddUnit( E );
                                                              Single := TRUE; .)
    [                                                      (. Single := FALSE; .)
      WEAK ellipsis
      ntConstantOrdinalExpression<E>                       (. IF NOT c^.ExpectType( CaseT, E^.T, err._CaseLabelDoesNotMatchSelector ) THEN
                                                                Error := TRUE;
                                                              ELSIF NOT CaseT^.CheckIfExpressionFits( E, I2 ) THEN
                                                                Error := TRUE;
                                                                SemErr( err._CaseLabelIsOutOfTypeRange );
                                                              ELSIF I2 < I1 THEN
                                                                Error := TRUE;
                                                                SemErr( err._ReversedCaseLabelBorders );
                                                              ELSE
                                                                E^.T := CaseT;
                                                              END;
                                                              c^.AddUnit( E ); .)
    ]                                                      (. IF Single THEN
                                                                I2 := I1;
                                                              END;
                                                              IF CC^.Knows( I1, I2 ) THEN
                                                                SemErr( err._OverlappingCases );
                                                              ELSIF NOT Error THEN
                                                                CC^.Add( I1, I2 );
                                                              END; .)
.

/* ---------- */

ntExitStatement                                            (. EX : DOM.TPSGoto := NEW( DOM.CSGoto ); .)
  = "EXIT"                                                 (. EX^.L := c^.LoopLabel( TRUE );
                                                              IF EX^.L = NIL THEN
                                                                SemErr( err._EXITOutsideOfLoop );
                                                              END;
                                                              c^.AddUnit( EX ); .)
.

/* ---------- */

ntContinueStatement                                        (. EX : DOM.TPSGoto := NEW( DOM.CSGoto ); .)
  = "CONTINUE"                                             (. EX^.L := c^.LoopLabel( FALSE );
                                                              IF EX^.L = NIL THEN
                                                                SemErr( err._CONTINUEOutsideOfLoop );
                                                              END;
                                                              c^.AddUnit( EX ); .)
.

/* ---------- */

ntWhileStatement<RequestedReturnType : DOM.TPType>         (. L : DOM.TPSLoop;
                                                              R : TReturn; .)
  =                                                        (. L := c^.EnterLoop( DOM.ukSWhile ); .)
    SYNC "WHILE"                                           (. c^.EnterNewUnit( DOM.ukWhileCondition ); .)
      ntBooleanExpression                                  (. c^.LeaveUnit(); .)
    WEAK "DO"                                              (. c^.EnterNewUnit( DOM.ukWhileBody )^.Add( ADR( L^.LC )); .)
      ntStatements<RequestedReturnType, R>
    SYNC kwEND                                             (. c^.LeaveUnit();
                                                              c^.LeaveLoop(); .)
.

/* ---------- */

ntRepeatStatement<RequestedReturnType : DOM.TPType>        (. L : DOM.TPSLoop;
                                                              R : TReturn; .)
  =                                                        (. L := c^.EnterLoop( DOM.ukSRepeat ); .)
    SYNC "REPEAT"                                          (. c^.EnterNewUnit( DOM.ukRepeatBody )^.Add( ADR( L^.LC )); .)
      ntStatements<RequestedReturnType, R>                 (. c^.LeaveUnit(); .)
    SYNC "UNTIL"                                           (. c^.EnterNewUnit( DOM.ukRepeatCondition ); .)
      ntBooleanExpression                                  (. c^.LeaveUnit();
                                                              c^.LeaveLoop(); .)
.

/* ---------- */

ntLoopStatement<RequestedReturnType : DOM.TPType; VAR R : TReturn>
                                                           (. L : DOM.TPSLoop;
                                                              LR : TReturn; .)
  = SYNC "LOOP"                                            (. L := c^.EnterLoop( DOM.ukSLoop );
                                                              L^.Add( ADR( L^.LC )); .)
      ntStatements<RequestedReturnType, LR>
    SYNC kwEND                                             (. c^.LeaveLoop();
                                                              IF LR >= retOK THEN // OK
                                                                R := LR;
                                                              ELSIF LR <> retExit THEN // no EXIT found
                                                                R := retOK;
                                                              END; .)
.

/* ---------- */

ntForStatement<RequestedReturnType : DOM.TPType>           (. PreviousCM : DOM.TCodeModifier;
                                                              R : TReturn;
                                                              S : DOM.TPSFor;
                                                              T : DOM.TPType; .)
  =                                                        (. S := DOM.TPSFor( c^.EnterLoop( DOM.ukSFor )); .)
    SYNC "FOR" ntControlVariableId<S^.CV>                  (. IF S^.CV = NIL THEN
                                                                T := Types.TUnknown;
                                                              ELSE
                                                                S^.CV^.Options := S^.CV^.Options + DOM.TEnvironmentOptions{DOM.eoInitialized, DOM.eoReferenced};
                                                                PreviousCM := S^.CV^.CM;
                                                                S^.CV^.CM := DOM.TCodeModifier{DOM.cmRO};
                                                                T := S^.CV^.T;
                                                              END;
                                                              IF ( T^.Unwrap()^.TypeKind = DOM.tkEnumeration ) AND NOT DOM.TPEnumeration( T )^.Iteratable THEN
                                                                SemErr( err._NotSuccessiveEnumeration );
                                                              END; .)
                                                           // variant for self-creating control variable:
                                                           // (. c^.AddToCTDeclUnit( S^.ControlVariable ); .)
      ntAssignment ntInitialValue<T, S^.IV>                // variant for self-creating control variable:
                                                           // (. S^.ControlVariable^.T := S^.InitialValue^.T; .)
    SYNC "TO"
      ntFinalValue<T, S^.FVV, S^.FVE>
      [ "BY" ntStepSize<Types.TOrdinalNumber, S^.SS> ]
    WEAK "DO"                                              (. c^.EnterNewUnit( DOM.ukSForBody )^.Add( ADR( S^.LC )); .)
      ntStatements<RequestedReturnType, R>                 (. c^.LeaveUnit(); .)
    SYNC kwEND                                             (. c^.LeaveLoop();
                                                              IF S^.CV <> NIL THEN
                                                                S^.CV^.CM := PreviousCM;
                                                              END; .)
.
  
ntControlVariableId<VAR Variable : DOM.TPVariable>         (. Id : DOM.TPSymbol; .)
  = ntVariableId<iaCheck, DOM.skVariable, Id>              //  iaCreate -- variant for self-creating control variable
                                                           //  (. IF c^.CurS^.Knows( Variable ) THEN
                                                           //      SemErrCS( L'Identifier redefined: {0}', Variable^.N );
                                                           //    END; .)
                                                           (. IF ( Id <> NIL ) AND NOT Types.TOrdinal^.Compatible( DOM.cmOperation, Id^.T ) THEN
                                                                c^.SemErr( err._FORVarMustBeOrdinal );
                                                              END;
                                                              IF ( c^.CurrentP() = NIL ) OR ( Id = NIL ) OR ( Id^.OfSymbol <> c^.CurrentP()) THEN
                                                                c^.SemErr( err._FORVarMustBeLocal );
                                                              END; .)
                                                           (. Variable := DOM.TPVariable( Id ); .)
.
  
ntInitialValue<T : DOM.TPType; VAR E : DOM.TPExpression>
  = ntOrdinalExpression<vrsDefault, E>                     (. IF T <> Types.TUnknown THEN
                                                                c^.ExpectType( T, E^.T, -1 );
                                                              END; .)
.
  
ntFinalValue<T : DOM.TPType; VAR FV : DOM.TPVariable; VAR FE : DOM.TPExpression>
  = ntOrdinalExpression<vrsDefault, FE>                    (. IF T <> Types.TUnknown THEN
                                                                c^.ExpectType( T, FE^.T, -1 );
                                                              END;
                                                              c^.HandleAuxVariableRequest( T, FV ); .)
.
  
ntStepSize<T : DOM.TPType; VAR E : DOM.TPExpression>
  = ntConstantOrdinalExpression<E>                         (. IF T <> Types.TUnknown THEN
                                                                c^.ExpectType( T, E^.T, -1 );
                                                              END; .)
.

/* ---------- */

ntGotoStatement                                            (. EX : DOM.TPSGoto := NEW( DOM.CSGoto ); .)
  = "GOTO" ntLabelId<iaCheck, EX^.L>                       (. c^.AddUnit( EX );
                                                              IF EX^.L <> NIL THEN
                                                                INCL( EX^.L^.Options, DOM.eoReferenced );
                                                              END; .)
.
  
/* ---------- */

ntStructuralExceptionHandlingStatement<RequestedReturnType : DOM.TPType; VAR R : TReturn>
                                                           (. E : DOM.TPExpression;
                                                              L : DOM.TPLabel;
                                                                LR : TReturn;
                                                              P : DOM.TPProcedureType;
                                                              U : DOM.TPUnit;
                                                              HaveUnhandled : BOOLEAN := FALSE; .)
  =                                                        (.  U := NEW( DOM.CSTRY );
                                                                c^.AddUnit( U );
                                                                c^.EnterUnit( U );
                                                                NEW( L ); c^.SetNumId( L, FALSE, L"_FinallyExit_" );
                                                                c^.TStack.PushEx( U, L ); .)
    SYNC "TRY"                                             (. U := c^.EnterNewUnit( DOM.ukTrySEHBlock );
                                                              P := c^.CurrentP();
                                                              IF P <> NIL THEN
                                                                INCL( P^.Options, DOM.eoInsideCPPTry );
                                                              END; .)
      ntStatements<RequestedReturnType, R>                 (. IF P <> NIL THEN
                                                                EXCL( P^.Options, DOM.eoInsideCPPTry );
                                                              END; .)
  (                                                        (. c^.LeaveUnit(); .)
    // SEH part
    SYNC "EXCEPT"                                          (. c^.EnterNewUnit( DOM.ukExceptBlock ); .)
      ntExpression<E>                                      (. E^.UnitKind := DOM.ukExceptSEHExpression;
                                                              c^.AddUnit( E );
                                                              c^.ExpectType( Types.TTRISTATE, E^.T, err._EXCEPTTypeMustBeTRISTATE );
                                                              c^.EnterNewUnit( DOM.ukExceptDoBlock ); .)
      "DO" ntStatements<RequestedReturnType, R>            (. c^.LeaveUnit();
                                                              c^.LeaveUnit(); .)
  |                                                        (. c^.LeaveUnit();
                                                              IF R > retUnknownInSomeBranch THEN
                                                                c^.Warning( wrn._InaccessibleFINALLY );
                                                              END; .)
    // SEH PART
    SYNC "FINALLY"                                         (. c^.EnterNewUnit( DOM.ukFinallySEHBlock ); .)
      ntStatements<RequestedReturnType, R>                 (. c^.LeaveUnit(); .)
  | // CPP part
                                                           (. U^.UnitKind := DOM.ukTryCPPBlock;
                                                              c^.LeaveUnit();
                                                              IF ( P <> NIL ) AND ( R > retUnknown ) AND ( R < retGOTO ) THEN
                                                                INCL( P^.Options, DOM.eoHaveReturnInCPPTry );
                                                              END; .)
    ntCatchClause<RequestedReturnType, REF HaveUnhandled, P, OUT LR>
      { ntCatchClause<RequestedReturnType, REF HaveUnhandled, P, OUT LR> }
                                                              // code for FINALLY must be generated always
                                                            (.  U := c^.EnterNewUnit( DOM.ukFinallyCPPBlock );
                                                                IF ( P <> NIL ) AND ( DOM.eoHaveReturnInCPPTry IN P^.Options ) THEN
                                                                    INCL( U^.Options, DOM.eoHaveReturnInCPPTry );
                                                                    IF RequestedReturnType <> Types.TUnknown THEN
                                                                        INCL( U^.Options, DOM.eoTryReturnsValue );
                                                                    END;
                                                                    U := NEW( DOM.CSLabel ); DOM.TPSLabel( U )^.L := L; c^.AddUnit( U );
                                                                END; .)
    [ "FINALLY" ntStatements<RequestedReturnType, R> ]      (.  c^.LeaveUnit();
                                                                c^.TryCheckParity(); .)
  )                                                         (.  c^.TStack.Pop();
                                                                c^.LeaveUnit(); .)
  SYNC kwEND
.

ntCatchClause<RequestedReturnType : DOM.TPType; REF HaveUnhandled : BOOLEAN; P : DOM.TPProcedureType; OUT R : TReturn>                     
                                                            (. C : POINTER TO DOM.CCATCH;
                                                               T : DOM.TPType;
                                                               V : DOM.TPVariable := NIL;
                                                               New : BOOLEAN := FALSE; .)
  = "CATCH"                                                 (. IF HaveUnhandled THEN
                                                                 SemErr( err._UNHANDLEDMustBeLast );
                                                               END;
                                                               NEW( C );
                                                               C^.S.OfSymbol := c^.CurrentP();
                                                               c^.AddUnit( C );
                                                               c^.EnterSymbols( C^.S, FALSE, FALSE, NIL );
                                                               c^.EnterUnit( C ); .)
    ( "UNHANDLED"                                           (. c^.AddTryHandleAll();
                                                               C^.UnitKind := DOM.ukCatchAnyBlock;
                                                               HaveUnhandled := TRUE; .)
    | [ ntVariableId<iaCreate, DOM.skVariable, V> ]
      colon ntTypeDenoter<T, FALSE, FALSE, New>             (. c^.CheckTypeIsException( T );
                                                               c^.AddTryHandle( T );
                                                               c^.ForwardOpaqueType( T );
                                                               c^.ForwardComplexType( T );
                                                               IF V = NIL THEN
                                                                  V := NEW( DOM.CVariable );
                                                               END;
                                                               V^.UnitKind := DOM.ukCatchVarDecl;
                                                               V^.T := T;
                                                               c^.AddUnit( V ); .)
    )                                                       (. c^.EnterNewUnit( DOM.ukCatchDoBlock );
                                                               IF P <> NIL THEN
                                                                 INCL( P^.Options, DOM.eoInsideCPPTry );
                                                               END; .)
    "DO" ntStatements<RequestedReturnType, R>               (. IF P <> NIL THEN
                                                                 EXCL( P^.Options, DOM.eoInsideCPPTry );
                                                                 IF ( R > retUnknown ) AND ( R < retGOTO ) THEN
                                                                   INCL( P^.Options, DOM.eoHaveReturnInCPPTry );
                                                                 END;
                                                               END;
                                                               c^.LeaveUnit();
                                                               c^.LeaveUnit();
                                                               c^.LeaveSymbols( FALSE ); .)
.
  
/* ---------- */

ntThrowStatement                                             (. E : DOM.TPExpression; .)
  = "THROW"                                                  (. c^.EnterNewUnit( DOM.ukSThrow ); .)
    [ ntExpression<E>                                        (. c^.AddUnit( E );
                                                                c^.CheckTypeIsException( E^.T );
                                                                c^.CheckIfThrowIsPossible( E^.T ); .)
    ]                                                        (. c^.LeaveUnit(); .)
.

/* ---------- */

ntAsmStatement                                             (. VAR S : DOM.TPSASM := NEW( DOM.CSASM ); .)
  = "ASM"                                                  (. INCL( c^.Options, DOM.eoASMBlock );
                                                              c^.AddUnit( S );
                                                              ReadASM( t.Pos + 3, OUT S^.ASMBlock ); .)
    kwEND
.

/* =========variable designators */

ntVariableDesignator<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo> // L-Value, Overwritten Assignment
/* original normative grammar, which is L-recursive.
   The grammar is modified, incuding removing designators from
   left of descendant rules.
  = ntEntireDesignator
  | ntIndexedDesignator
  | ntSelectedDesignator
  | ntDereferencedDesignator
  */                                                       (. PA : DOM.TPSAssignment; .)
  =                                                        (. INC( c^.DCount );
                                                              VI := DOM.TValueInfo{}; .)
  ( ntEmbeddedProcedure<D> // except NEWProc
  | ( ntEmbeddedNEWProc<D>
    | ntEntireDesignator<VR, D, OUT VI>
    )
    ntNonLRecursiveDesignator<VR, D, VI>                   (. D^.VI := VI;
                                                              IF ( vrConst IN VR ) AND NOT( DOM.viConst IN VI ) THEN
                                                                SemErr( err._DesignatorIsNotConstant );
                                                              END; .)
  )                                                        (. DEC( c^.DCount );
                                                              IF c^.DCount = 0 THEN
                                                                EnableErrors();
                                                              END;
                                                              IF ( D^.r.DK = DOM.dkType ) AND ( D^.r.TC = NIL ) THEN
                                                                // type only read, no checking could be performed
                                                                VR := VR - vrsLValue - TValueReq{vrMarkAsInitialized};
                                                              END;
                                                              // mark as initialized if needed
                                                              IF vrMarkAsInitialized IN VR THEN
                                                                D^.MarkAsInitializedAndCheckRO( c, TRUE, TRUE );
                                                              END;
                                                              // solve REF/OUT properties
                                                              IF vrsLValue * VR <> TValueReq{} THEN
                                                                IF ( DOM.viClassLValue IN VI ) AND ( vrClassLValue IN VR ) THEN
                                                                  // OK
                                                                ELSIF NOT( DOM.viLValue IN VI ) THEN
                                                                  SemErr( err._ExpectedLValue );
                                                                ELSIF ( vrREFValue IN VR ) AND ( DOM.TValueInfo{DOM.viPropertyAssign, DOM.viIndexerAssign} * VI <> DOM.TValueInfo{} ) THEN
                                                                  // vrSLValue does not assign value back
                                                                  NEW( PA );
                                                                  IF DOM.viPropertyAssign IN VI THEN
                                                                    PA^.UnitKind := DOM.ukSAssignmentByCall1;
                                                                  ELSE
                                                                    PA^.UnitKind := DOM.ukSAssignmentByCall2;
                                                                  END;
                                                                  PA^.D := D^.r.OD;
                                                                  c^.CreateExpressionWithDesignator( D, FALSE, OUT PA^.E );
                                                                  c^.AddFollowingStatement( PA );
                                                                END;
                                                              END; .)
.

ntEntireDesignator<VR : TValueReq; VAR D : DOM.TPDesignator; OUT VI : DOM.TValueInfo>
                                                           (. ProcFlag, ExpressionToCastRead : BOOLEAN; .)
  = ntDesignatorLeading<VR - TValueReq{vrCheckIfInitialized}, D, OUT VI>
                                                           (. ExpressionToCastRead := D^.r.DK <> DOM.dkType; .)
    [                                                      (. ProcFlag := ( D^.r.DK = DOM.dkEmbeddedProcedure ) OR
                                                                          ( D^.r.Id = NIL ) OR
                                                                          D^.r.Id^.IsProcedure( FALSE );
                                                              IF NOT ProcFlag THEN  
                                                                ExpressionToCastRead := TRUE;
                                                                IF D^.r.DK <> DOM.dkType THEN
                                                                  SemErr( err._ExpectedTypeName );
                                                                END;
                                                                NEW( D^.r.TC );
                                                                D^.r.TC^.T := D^.T^.Unwrap();
                                                                D^.r.TC^.Cast := TRUE;
                                                                c^.EnterUnit( D^.r.TC ); .)
      lpar
        ntSingleTypeConstructedValue<D^.r.TC^.T, VR - TValueReq{vrCheckIfInitialized}, D^.VI>
      rpar
                                                           (.   c^.LeaveUnit();
                                                              END; .)
    ]                                                      (. IF NOT( vrAllowSingleType IN VR ) AND NOT ExpressionToCastRead THEN
                                                                SemErr( err._ExpressionToCastExpected );
                                                              END; .)
.

ntDesignatorLeading<VR : TValueReq; VAR D : DOM.TPDesignator; OUT VI : DOM.TValueInfo>
                                                           (. FI : DOM.TPSymbol;
                                                              TypeId : DOM.TPType; .)
  =
  ( 
    ntDesignatorId<VR, D, FI>
  | ntOrdinalBaseType<TypeId>                              (. D^.r.Id := TypeId; .)
  | ntNonOrdinalBaseType<TypeId>                           (. D^.r.Id := TypeId; .)
  | ntPointerBaseType<TypeId>                              (. D^.r.Id := TypeId; .)
  )                                                        (. VI := DOM.TValueInfo{};
                                                              IF D^.r.DK = DOM.dkOperator THEN
                                                                ASSERT( D^.r.O = DOM.doSelectingOfSuperClass );
                                                                D^.T := DOM.TPType( D^.r.F );
                                                              ELSIF D^.r.Id = NIL THEN
                                                                D^.T := Types.TUnknown;
                                                              ELSIF D^.r.Id^.SymbolKind = DOM.skType THEN
                                                                D^.r.DK := DOM.dkType;
                                                                D^.r.TC := NIL;
                                                                D^.T := DOM.TPType( D^.r.Id );
                                                              ELSIF D^.r.Id^.SymbolKind = DOM.skClass THEN
                                                                D^.r.DK := DOM.dkType;
                                                                D^.r.TC := NIL;
                                                                D^.T := DOM.TPType( D^.r.Id );
                                                                D^.r.W := c^.GetWithDesignator( FI );
                                                                IF D^.r.W = NIL THEN // only not WITH elements should be handled
                                                                  c^.HandleNestedSymbol( D^.r.Id, FI, D^.r.IdA );
                                                                ELSE
                                                                  VI := D^.r.W^.VI * DOM.TValueInfo{DOM.viConst, DOM.viCONST};
                                                                END;
                                                              ELSE
                                                                D^.r.DK := DOM.dkId;
                                                                IF D^.r.Id^.SymbolKind = DOM.skProcedure THEN
                                                                  D^.T := DOM.TPType( D^.r.Id );
                                                                ELSE
                                                                  D^.T := D^.r.Id^.T;
                                                                END;
                                                                D^.r.GO := FI;
                                                                D^.r.W := c^.GetWithDesignator( FI );
                                                                IF D^.r.W = NIL THEN // only not WITH elements should be handled
                                                                  c^.HandleNestedSymbol( D^.r.Id, FI, D^.r.IdA );
                                                                ELSE
                                                                  VI := D^.r.W^.VI * DOM.TValueInfo{DOM.viConst, DOM.viCONST};
                                                                END;
                                                              END; .) 
.

ntDesignatorId<VR : TValueReq; VAR D : DOM.TPDesignator; VAR FI : DOM.TPSymbol>
                                                           (. Duplicate : BOOLEAN := FALSE;
                                                              EnterCount : CARDINAL := 0;
                                                              Id : DOM.TPSymbol;
                                                              ND : DOM.TPDesignator;
                                                              Super : DOM.TPClass;
                                                              LABEL DoSuper, QNameRead; .)
  =
  (                                                        (. FI := NIL; .)
    ntIdCheck<DOM.skUnknown, FALSE, TRUE, Id, FI>
    {                                                      (. IF Id = NIL THEN
                                                                // OK, error, read out full chain
                                                              ELSIF Id^.SymbolKind = DOM.skModule THEN
                                                                IF ( Id <> c^.OD ) AND ( Id^.OfSymbol <> c^.OD ) AND ( Id^.OfSymbol <> c^.OI ) THEN
                                                                  SemErr( err._ModuleNotImported );
                                                                END;
                                                                INC( EnterCount );
                                                                c^.EnterSymbols( DOM.TPModule( Id )^.SC()^, FALSE, FALSE, NIL );
                                                              ELSE
                                                                GOTO QNameRead;
                                                              END; .)
      period
      ntIdCheck<DOM.skUnknown, TRUE, TRUE, Id, FI>
    }                                                      (. 
                                                            QNameRead:  
                                                              WHILE EnterCount > 0 DO
                                                                c^.LeaveSymbols( FALSE );
                                                                DEC( EnterCount );
                                                              END; // WHILE
                                                              IF Id <> NIL THEN
                                                                IF Id^.SymbolKind = DOM.skClass THEN
                                                                  IF vrAllowSingleType IN VR THEN
                                                                    // not to check
                                                                  ELSIF ( c^.SStack.CurC <> NIL ) AND c^.SStack.CurC^.IsDescendantOf( DOM.TPClass( Id ), FALSE, TRUE, OUT Duplicate ) THEN
                                                                    Super := DOM.TPClass( Id );
                                                                    GOTO DoSuper;
                                                                  ELSIF NOT( vrAllowSingleType IN VR ) THEN
                                                                    SemErr( err._ClassIsNotAncestor );
                                                                  END;
                                                                ELSE
                                                                  INCL( Id^.Options, DOM.eoReferenced );
                                                                END;
                                                                IF ( vrCheckIfInitialized IN VR ) AND
                                                                   ( Id^.OfSymbol = c^.CurrentP()) AND
                                                                   ( Id^.SymbolKind = DOM.skVariable ) AND
                                                                   ( DOM.TEnvironmentOptions{DOM.eoInitialized} * Id^.Options = DOM.TEnvironmentOptions{} ) AND
                                                                   NOT ( DOM.eoASMBlock IN c^.Options ) AND
                                                                   NOT Id^.T^.IsFormal() AND NOT Id^.T^.IsClass() THEN
                                                                  SemErr( err._VariableUsedWithoutInitialization );
                                                                END;
                                                                c^.CheckAccessToSymbol( Id );
                                                              END;
                                                              D^.r.Id := Id; .)
  | "SELF"                                                 (. NEW( DOM.TPSelf( Id ));
                                                              IF c^.SStack.CurC = NIL THEN
                                                                SemErr( err._SELFOusideOfClass );
                                                              ELSE
                                                                Id^.T := c^.SStack.CurC;
                                                                Id^.OfSymbol := c^.SStack.CurC^.OfSymbol;
                                                                FI := c^.SStack.CurC;
                                                              END;
                                                              D^.T := Id^.T;
                                                              D^.r.DK := DOM.dkId;
                                                              D^.r.Id := Id; .)
  | "SUPER"                                                (. Id := NIL;
                                                              IF c^.SStack.CurC = NIL THEN
                                                                SemErr( err._SUPEROutsideOfClass );
                                                              ELSIF c^.SStack.CurC^.I = NIL THEN
                                                                SemErr( err._NoSUPERExists );
                                                              ELSIF DOM.imInterface IN c^.SStack.CurC^.I^.IM THEN
                                                                SemErr( err._NoSUPERUsable );
                                                              ELSE
                                                                Super := c^.SStack.CurC^.I;
                                                              DoSuper:
                                                                NEW( DOM.TPSelf( Id ));
                                                                Id^.T := c^.SStack.CurC;
                                                                Id^.OfSymbol := c^.SStack.CurC^.OfSymbol;
                                                                FI := c^.SStack.CurC;
                                                                D^.T := Id^.T;
                                                                D^.r.DK := DOM.dkId;
                                                                D^.r.Id := Id;
                                                                // construct selecting of super class artifically
                                                                NEW( ND );
                                                                ND^.L := D; D := ND;
                                                                D^.r.DK := DOM.dkOperator;
                                                                D^.r.O := DOM.doSelectingOfSuperClass;
                                                                D^.r.F := Super;
                                                              END; .)
  )                                                        (. IF Id = NIL THEN
                                                                DisableErrors();
                                                              END; .)
.

ntAddressingOffset<VAR E : DOM.TPExpression>               (. ok : BOOLEAN; .)
  = at lbracket
      ntOrdinalNumberExpression<vrsDefault, E, ok>
    rbracket
.  

ntNonLRecursiveDesignator<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. DfI : DOM.TPIndexerDef;
                                                              Duplicate : BOOLEAN := FALSE;
                                                              FI : DOM.TPSymbol;
                                                              IT, RT : DOM.TPType := Types.TUnknown;
                                                              M : DOM.TPSymbol;
                                                              T : DOM.TPType;
                                                              HandleCOM : BOOLEAN := FALSE; // HandleCOM for creating aux variable -- aux variable is needed if the property/indexer is inside of designator chain
                                                              LABEL FSharedWithId; .)
  =                                                        (. T := D^.T^.Unwrap();
                                                              CASE D^.r.DK OF
                                                              //=====
                                                              | DOM.dkId :
                                                            FSharedWithId :
                                                                IF D^.r.Id = NIL THEN
                                                                  VI := VI - DOM.visLValue;
                                                                ELSE CASE D^.r.Id^.SymbolKind OF
                                                                | DOM.skConstant :
                                                                  VI := VI + DOM.TValueInfo{DOM.viLValue, DOM.viCONST, DOM.viConst} - DOM.visOverwrittenAssignment;
                                                                | DOM.skVariable :
                                                                  VI := VI + DOM.TValueInfo{DOM.viLValue} - DOM.visOverwrittenAssignment;
                                                                | DOM.skProperty :
                                                                  IF DOM.cmRO IN D^.r.Id^.CM THEN
                                                                    VI := VI - DOM.visLValue;
                                                                  ELSE
                                                                    VI := VI - DOM.visLValue + DOM.TValueInfo{DOM.viLValue, DOM.viPropertyAssign};
                                                                  END;
                                                                    c^.CheckIfThrowingProcedureIsPossible( D^.r.Id );
                                                                  HandleCOM := ( DOM.imCOM IN DOM.TPProcedureType( D^.r.Id )^.IM ) OR
                                                                               ( vrsLValue * VR <> TValueReq{} ) AND ( DOM.viLValue IN VI );
                                                                | DOM.skProcedure :
                                                                  IF DOM.imCOM IN DOM.TPProcedure( D^.r.Id )^.IM THEN
                                                                    VI := VI - DOM.visLValue + DOM.TValueInfo{DOM.viCOMProcedure};
                                                                  ELSE
                                                                    VI := VI - DOM.visLValue;
                                                                  END;
                                                                | DOM.skClass :
                                                                  VI := VI - DOM.visLValue - DOM.visOverwrittenAssignment + DOM.TValueInfo{DOM.viClassLValue};
                                                                END; END; // CASE, IF
                                                              //=====
                                                              | DOM.dkType :
                                                                IF ( D^.r.TC = NIL ) OR NOT D^.r.TC^.IsLValue() THEN // error or really not L-Value
                                                                  VI := VI - DOM.visLValue;
                                                                ELSIF Types.TADDRESS^.Compatible( DOM.cmOperation, D^.T ) THEN // for casting in L-Value allow only pointer cast
                                                                  VI := VI + DOM.TValueInfo{DOM.viLValue};
                                                                ELSE
                                                                  VI := VI - DOM.visLValue;
                                                                END;
                                                              //=====
                                                              | DOM.dkOperator :
                                                                CASE D^.r.O OF
                                                                //-----
                                                                | DOM.doSelecting :
                                                                  GOTO FSharedWithId;
                                                                //-----
                                                                | DOM.doSelectingOfSuperClass :
                                                                  IF DOM.TPClass( D^.L^.T^.Unwrap())^.IsDescendantOf( DOM.TPClass( D^.r.F ), FALSE, TRUE, OUT Duplicate ) AND Duplicate THEN
                                                                    SemErr( err._AmbiguousUsageOfAncestor );
                                                                  END;
                                                                  GOTO FSharedWithId;
                                                                //-----
                                                                | DOM.doIndexingOfClass :
                                                                  // IF DOM.imAbstract IN D^.r.DfI^.IM THEN
                                                                  //   SemErr( L'ABSTRACT indexer cannot be accessed.' );
                                                                  // END;
                                                                  IF DOM.cmRO IN D^.r.DfI^.CM THEN
                                                                    VI := VI - DOM.visLValue;
                                                                  ELSE
                                                                    VI := VI - DOM.visLValue + DOM.TValueInfo{DOM.viLValue, DOM.viIndexerAssign};
                                                                  END;
                                                                  IF DOM.imCOM IN D^.r.DfI^.IM THEN
                                                                    INCL( VI, DOM.viCOMProcedure );
                                                                  END;
                                                                  HandleCOM := ( DOM.imCOM IN D^.r.DfI^.IM ) OR
                                                                               ( vrsLValue * VR <> TValueReq{} ) AND ( DOM.viLValue IN VI );
                                                                //-----
                                                                | DOM.doCall :
                                                                  VI := VI - DOM.visLValue;
                                                                  // IF DOM.imAbstract IN DOM.TPProcedure( D^.L^.T )^.IM THEN
                                                                  //   SemErr( L'ABSTRACT method cannot be called.' );
                                                                  // END;
                                                                  IF ( T <> Types.TUnknown ) AND ( DOM.imCOM IN DOM.TPProcedure( D^.L^.T )^.IM ) THEN
                                                                    HandleCOM := TRUE;
                                                                  END;
                                                                  IF DOM.TEnvironmentOptions{DOM.eoLeakChecking, DOM.eoLeakInfo} * DOM.TPProcedure( D^.L^.T )^.Options = DOM.TEnvironmentOptions{DOM.eoLeakChecking, DOM.eoLeakInfo} THEN
                                                                    IF c^.CurST = NIL THEN
                                                                      SemErr( err._BadLeakInfoProcPlacement );
                                                                    END;
                                                                    c^.AddLeakInfoPushPop( t.Line );
                                                                  END;
                                                                  IF ( D^.L^.T^.OfSymbol <> NIL ) AND ( D^.L^.T^.OfSymbol^.SymbolKind = DOM.skModule ) THEN
                                                                    IF DOM.eoInitially IN D^.L^.T^.Options THEN
                                                                      c^.GetSymbol( D^.L^.T^.OfSymbol^.N, DOM.skModule, FALSE, FALSE, FALSE, M, FI );
                                                                      INCL( M^.Options, DOM.eoInitially );
                                                                    END;
                                                                    IF DOM.eoFinally IN D^.L^.T^.Options THEN
                                                                      c^.GetSymbol( D^.L^.T^.OfSymbol^.N, DOM.skModule, FALSE, FALSE, FALSE, M, FI );
                                                                      INCL( M^.Options, DOM.eoFinally );
                                                                    END;
                                                                  END;
                                                                //-----
                                                                ELSE
                                                                  VI := VI + DOM.TValueInfo{DOM.viLValue} - DOM.visOverwrittenAssignment;
                                                                END; // CASE r.O
                                                              //=====
                                                              | DOM.dkEmbeddedProcedure :
                                                                VI := VI - DOM.visLValue;
                                                                IF ( D^.r.EP = DOM.epNEWFunc ) AND ( DOM.eoLeakChecking IN D^.Options ) THEN
                                                                  IF c^.CurST = NIL THEN
                                                                    SemErr( err._BadNEWFuncPlacement );
                                                                  END;
                                                                  c^.AddLeakInfoPushPop( t.Line );
                                                                END;
                                                              END;
                                                              IF D^.T^.IsFormal() AND ( DOM.TPFormalType( D^.T )^.TypeModifier = DOM.tmCONST ) THEN
                                                                VI := VI + DOM.TValueInfo{DOM.viCONST, DOM.viConst};
                                                              END;
                                                              IF HandleCOM THEN
                                                                IF c^.CurST = NIL THEN
                                                                  SemErr( err._BadMemberPlacement );
                                                                END;
                                                                c^.HandleCOMPropertyOrFunction( vrAssignment IN VR, REF D );
                                                              END; .)
  (                                                        (. CASE T^.TypeKind OF
                                                              | DOM.tkArray, DOM.tkStringArray, DOM.tkOpenArray :
                                                                IT := DOM.TPArray( T )^.I;
                                                                RT := T^.Unwrap()^.T;
                                                              | DOM.tkClass :
                                                                IF NOT c^.CheckIndexerUsage( DOM.TPClass( T ), OUT DfI, OUT DOM.TPFormalType( IT ), OUT RT ) THEN
                                                                  SemErr( err._UnableToUseClassIndex );
                                                                END;
                                                              ELSE
                                                                SemErr( err._UnableToUseIndex );
                                                              END; .)
    ntNonLRecursiveIndexedDesignator<VR, T, D, VI, IT, RT, DfI>
  |                                                        (. CASE T^.TypeKind OF
                                                              | DOM.tkRecord, DOM.tkClass :
                                                              ELSE
                                                                SemErr( err._UnableToUseSelector );
                                                              END; .)
    ntNonLRecursiveSelectedDesignator<VR, T, D, VI>
  |                                                        (. IF T^.TypeKind <> DOM.tkReference THEN
                                                                SemErr( err._UnableToUseDereferencing );
                                                              END; .)
    ntNonLRecursiveDereferencedDesignator<VR, T, D, VI>
  |                                                        (. IF T^.TypeKind <> DOM.tkReference THEN
                                                                SemErr( err._UnableToUseAddressShift );
                                                              END; .)
    ntNonLRecursiveAddressingOffsetDesignator<VR, T, D, VI>
  |															(.  IF ( D^.r.Id = NIL ) OR NOT D^.r.Id^.IsProcedure( TRUE ) THEN
                                                                    SemErr( err._UnableToUseCall );
                                                                    D^.r.Id := NIL;
                                                                ELSE
                                                                    c^.CheckIfThrowingProcedureIsPossible( D^.r.Id );
                                                                END; .)
    ntNonLRecursiveCallDesignator<VR, T, D, VI>
  | // EMPTY
  )
.  

ntNonLRecursiveIndexedDesignator<VR : TValueReq; DT : DOM.TPType; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo; IT, RT : DOM.TPType; DfI : DOM.TPIndexerDef>
                                                           (. ND : DOM.TPDesignator := NEW( DOM.CDesignator ); .)
  =                                                        (. ND^.L := D; D := ND;
                                                              D^.r.DK := DOM.dkOperator;
                                                              IF DT^.TypeKind <> DOM.tkClass THEN
                                                                D^.r.O := DOM.doIndexing;
                                                              ELSIF ( D^.L^.r.DK = DOM.dkId ) AND D^.L^.r.Id^.IsClass() THEN
                                                                D^.r.O := DOM.doIndexingOfSuperClass;
                                                              ELSIF ( D^.L^.r.DK = DOM.dkOperator ) AND ( D^.L^.r.O = DOM.doSelectingOfSuperClass ) THEN
                                                                D^.r.O := DOM.doIndexingOfSuperClass;
                                                              ELSIF ( D^.L^.r.DK = DOM.dkOperator ) AND ( D^.L^.r.O = DOM.doSelecting ) AND D^.L^.r.F^.IsClass() THEN
                                                                D^.r.O := DOM.doIndexingOfSuperClass;
                                                              ELSE
                                                                D^.r.O := DOM.doIndexingOfClass;
                                                              END;
                                                              IF D^.r.O <> DOM.doIndexing THEN
                                                                D^.r.DfI := DfI;
                                                              END;
                                                              D^.T := RT; .)
    lbracket
      ntIndexExpression<D^.r.Idx>                          (. CASE DT^.TypeKind OF
                                                              | DOM.tkOpenArray :
                                                                c^.ExpectType( Types.TOrdinalNumber, D^.r.Idx^.T, -1 );
                                                              | DOM.tkStringArray :
                                                                c^.ExpectType( Types.TOrdinal, D^.r.Idx^.T, -1 );
                                                              ELSE
                                                                c^.ExpectType( IT, D^.r.Idx^.T, -1 );
                                                              END; .)
      {                                                    (. IF D^.T^.Unwrap()^.TypeKind <> DOM.tkArray THEN
                                                                SemErr( err._TooManyIndexes );
                                                              END;
                                                              DT := D^.T^.Unwrap();
                                                              NEW( ND ); ND^.L := D; D := ND;
                                                              D^.r.DK := DOM.dkOperator;
                                                              D^.r.O := DOM.doIndexing;
                                                              IF DT^.T = NIL THEN
                                                                D^.T := Types.TUnknown;
                                                              ELSE
                                                                D^.T := DT^.T;
                                                              END; .)
        WEAK comma ntIndexExpression<D^.r.Idx>             (. CASE DT^.TypeKind OF
                                                              | DOM.tkOpenArray :
                                                                c^.ExpectType( Types.TOrdinalNumber, D^.r.Idx^.T, -1 );
                                                              | DOM.tkStringArray :
                                                                c^.ExpectType( Types.TOrdinal, D^.r.Idx^.T, -1 );
                                                              | DOM.tkUnknown : // some error
                                                              ELSE
                                                                c^.ExpectType( DOM.TPArray( DT )^.I, D^.r.Idx^.T, -1 );
                                                              END; .)
      }
    rbracket
    ntNonLRecursiveDesignator<VR, D, VI>
.

ntIndexExpression<VAR Expression : DOM.TPExpression>
  = ntOrdinalExpression<vrsDefault, Expression>
.

ntNonLRecursiveSelectedDesignator<VR : TValueReq; DT : DOM.TPType; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. Duplicate : BOOLEAN := FALSE;
                                                              ND : DOM.TPDesignator := NEW( DOM.CDesignator ); .)
  =                                                        (. ND^.L := D; D := ND;
                                                              D^.r.DK := DOM.dkOperator;
                                                              IF DT^.TypeKind <> DOM.tkClass THEN
                                                                D^.r.O := DOM.doSelecting;
                                                              ELSIF ( D^.L^.r.DK = DOM.dkId ) AND D^.L^.r.Id^.IsClass() THEN
                                                                D^.r.O := DOM.doSelectingOfSuperClass;
                                                              ELSIF ( D^.L^.r.DK = DOM.dkOperator ) AND ( D^.L^.r.O = DOM.doSelectingOfSuperClass ) THEN
                                                                D^.r.O := DOM.doSelectingOfSuperClass;
                                                              ELSIF ( D^.L^.r.DK = DOM.dkOperator ) AND ( D^.L^.r.O = DOM.doSelecting ) AND D^.L^.r.F^.IsClass() THEN
                                                                D^.r.O := DOM.doSelectingOfSuperClass;
                                                              ELSE
                                                                D^.r.O := DOM.doSelecting;
                                                              END;
                                                              CASE DT^.TypeKind OF
                                                              | DOM.tkRecord :
                                                                c^.EnterSymbols( DOM.TPRecord( DT )^.S, FALSE, FALSE, NIL );
                                                              | DOM.tkClass :
                                                                c^.EnterSymbols( DOM.TPClass( DT )^.S, FALSE, FALSE, NIL );
                                                              END; .)
    period ( "FINALLY"                                     (. IF DT^.TypeKind <> DOM.tkClass THEN
                                                                c^.SemErr( err._BadFINALLYUsage );
                                                              ELSIF DOM.TPClass( DT )^.FinalCode = NIL THEN
                                                                // create dummy final code, only for designator and simulate that it is owner by Class
                                                                NEW( DOM.TPProcedure( D^.r.F ));
                                                                INCL( D^.r.F^.Options, DOM.eoFinally );
                                                                D^.r.F^.N.Assign( DT^.N );
                                                                D^.r.F^.OfSymbol := DT;
                                                              ELSE
                                                                D^.r.F := DOM.TPSymbol( DOM.TPClass( DT )^.FinalCode );
                                                              END;
                                                              c^.Warning( wrn._ObjectUnusableAfterFINALLY ); .)
           | ntFieldIdentifier<D^.r.F> )                   (. IF D^.r.F = NIL THEN
                                                                D^.T := Types.TUnknown;
                                                                VI := VI - DOM.visLValue;
                                                                DisableErrors();
                                                              ELSE
                                                                IF TValueReq{vrConst, vrAllowSingleType} * VR = TValueReq{vrConst} THEN
                                                                  IF DT^.TypeKind <> DOM.tkRecord THEN
                                                                    c^.SemErr( err._BadRECORDFieldUsage );
                                                                  ELSIF NOT DOM.TPRecord( DT )^.GetIndexOfField( D^.r.F, OUT D^.r.FIdx ) THEN
                                                                    D^.r.FIdx := 0;
                                                                  END;
                                                                END;
                                                                c^.CheckAccessToSymbol( D^.r.F );
                                                                CASE D^.r.F^.SymbolKind OF
                                                                | DOM.skProcedure :
                                                                  D^.T := DOM.TPType( D^.r.F );
                                                                | DOM.skClass :
                                                                  D^.T := DOM.TPType( D^.r.F );
                                                                ELSE
                                                                  D^.T := D^.r.F^.T;
                                                                END;
                                                              END;
                                                              CASE DT^.TypeKind OF
                                                              | DOM.tkRecord, DOM.tkClass :
                                                                c^.LeaveSymbols( FALSE );
                                                              END; .)
    ntNonLRecursiveDesignator<VR, D, VI>
.
                                                           
ntFieldIdentifier<VAR Field : DOM.TPSymbol>                (. FI : DOM.TPSymbol; .)
  // = ntVariableId<iaCheck, DOM.skVariable, Variable> -- field id can be a part of class, so restricting to variable is impossible
  = ntIdCheck<DOM.skUnknown, TRUE, TRUE, Field, FI>
.

ntNonLRecursiveAddressingOffsetDesignator<VR : TValueReq; DT : DOM.TPType; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. ND : DOM.TPDesignator := NEW( DOM.CDesignator ); .)
  =                                                        (. ND^.L := D; D := ND;
                                                              D^.r.DK := DOM.dkOperator;
                                                              D^.r.O := DOM.doAddressingOffset;
                                                              D^.T := DT; .)
    ntAddressingOffset<D^.r.AO> ntNonLRecursiveDesignator<VR, D, VI>
.

ntNonLRecursiveDereferencedDesignator<VR : TValueReq; DT : DOM.TPType; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. ND : DOM.TPDesignator := NEW( DOM.CDesignator ); .)
  =                                                        (. ND^.L := D; D := ND;
                                                              D^.r.DK := DOM.dkOperator;
                                                              D^.r.O := DOM.doDereferencing;
                                                              IF DT^.T = NIL THEN
                                                                D^.T := Types.TUnknown;
                                                              ELSE
                                                                D^.T := DT^.T;
                                                              END; .)
    dereferencing ntNonLRecursiveDesignator<VR, D, VI>
.

ntNonLRecursiveCallDesignator<VR : TValueReq; DT : DOM.TPType; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. ND : DOM.TPDesignator := NEW( DOM.CDesignator ); .)
  =                                                        (. ND^.L := D; D := ND;
                                                              D^.r.DK := DOM.dkOperator;
                                                              D^.r.O := DOM.doCall;
                                                              IF D^.L^.r.Id = NIL THEN
                                                                D^.T := Types.TUnknown;
                                                              ELSE
                                                                D^.T := DT^.T^.Unwrap();
                                                              END;
                                                              NEW( D^.r.P );
                                                              D^.r.P^.C := DOM.TPProcedure( c^.CurrentP());
                                                              IF D^.L^.r.Id = NIL THEN
                                                                D^.r.P^.P := NIL;
                                                              ELSE
                                                                D^.r.P^.P := DOM.TPProcedureType( DOM.TPType( DT )^.Unwrap());
                                                              END;
                                                              VI := VI - DOM.TValueInfo{DOM.viCONST, DOM.viConst}; .)
    ntActualParameters<D^.r.P, vrsDefault>
    ntNonLRecursiveDesignator<VR, D, VI>
.

/* =========expressions */

ntOrdinalNumberExpression<VR : TValueReq; VAR Expression : DOM.TPExpression; VAR ok : BOOLEAN>
                                                           (. VI : DOM.TValueInfo; .)
  = ntCommonExpression<VR, Expression, VI>                 (. ok := c^.ExpectType( Types.TOrdinalNumber, Expression^.T, err._ExpectedOrdinalNumberExpression ); .)
.

ntOrdinalExpression<VR : TValueReq; VAR Expression : DOM.TPExpression>
                                                           (. VI : DOM.TValueInfo; .)
  = ntCommonExpression<VR, Expression, VI>                 (. c^.ExpectType( Types.TOrdinal, Expression^.T, err._ExpectedOrdinalExpression ); .)
.

ntExpression<VAR E : DOM.TPExpression>                     (. VAR VI : DOM.TValueInfo; .)
  = ntCommonExpression<vrsDefault, E, VI>
.  

ntCommonExpression<VR : TValueReq; VAR E : DOM.TPExpression; VAR VI : DOM.TValueInfo>
                                                           (. LVI : DOM.TValueInfo;
                                                              NN : DOM.TPENode;
                                                              RType : DOM.TPType;
                                                              T : DOM.TPType; .)
  =                                                        (. NEW( E ); .)
    ntSimpleExpression<VR, E^.N, VI>
    [                                                      (. NEW( NN );
                                                              NN^.r.N := DOM.enOperation;
                                                              NN^.r.L := E^.N;
                                                              NN^.T := Types.TBOOLEAN;
                                                              E^.N := NN; .)
      ntRelationalOperator<E^.N^.r.O>                      (. RType := E^.N^.r.L^.T;
                                                              IF c^.CheckOperatorUsage( E^.N, OUT RType, OUT E^.N^.T ) THEN
                                                                // OK, class rewrites operator
                                                                E^.N^.r.N := DOM.enClassOperator;
                                                                VI := VI - visConst;
                                                              // only corresponding types can be related
                                                              // ELSIF RType^.Unwrap()^.TypeKind = DOM.tkEnumeration THEN
                                                              //   RType := Types.TOrdinalNumeric;
                                                              ELSIF ( E^.N^.r.O = DOM.opEQ ) OR ( E^.N^.r.O = DOM.opNEQ ) THEN
                                                                // OK, eq and neq are defined for all
                                                              ELSE CASE E^.N^.r.L^.T^.Unwrap()^.TypeKind OF
                                                              | DOM.tkArray, DOM.tkRecord, DOM.tkSet, DOM.tkReference, DOM.tkProcedure :
                                                                SemErr( err._BadRelationalOperand );
                                                              END; END;
                                                                IF ( E^.N^.r.O = DOM.opISExact ) OR ( E^.N^.r.O = DOM.opISInherits ) THEN
                                                                    INCL( c^.Options, DOM.eoIS );
                                                                    INCL( VR, vrAllowSingleType );
                                                                END; .)
      ntSimpleExpression<VR, E^.N^.r.R, LVI>               (. IF E^.N^.r.R <> NIL THEN
                                                                IF E^.N^.r.N = DOM.enClassOperator THEN
                                                                  c^.CheckTypeMismatch( RType, E^.N^.r.R^.T, TRUE, -1 );
                                                                ELSIF ( E^.N^.r.O = DOM.opIN ) OR ( E^.N^.r.O = DOM.opNotIN ) THEN
                                                                  T := E^.N^.r.R^.T^.Unwrap();
                                                                  IF Types.TSet^.Compatible( DOM.cmOperation, T ) THEN
                                                                    c^.ExpectType( DOM.TPSet( T )^.GetItemType(), E^.N^.r.L^.T, err._TestedMemberIsNotMember )
                                                                  ELSE
                                                                    SemErr( err._INExpectsASet );
                                                                  END;
                                                                  IF ( E^.N^.r.L^.r.N = DOM.enOperation ) AND ( E^.N^.r.L^.r.O = DOM.opNotB ) THEN
                                                                    Warning( wrn._PossibleBadNOTUsage );
                                                                  END;
                                                                ELSIF ( E^.N^.r.O = DOM.opISExact ) OR ( E^.N^.r.O = DOM.opISInherits ) THEN
                                                                    T := E^.N^.r.L^.T^.Unwrap();
                                                                    RType := E^.N^.r.R^.T^.Unwrap();
                                                                    IF T^.SymbolKind <> DOM.skClass THEN
                                                                        SemErr( err._ISExpectsClassOnLeft );
                                                                    ELSIF ( RType^.SymbolKind = DOM.skClass ) OR Types.TBString^.Compatible( DOM.cmOperation, RType ) THEN
                                                                        // OK
                                                                    ELSE
                                                                        SemErr( err._ISExpectsClassOrBStringOnRight );
                                                                    END;
                                                                ELSE
                                                                  c^.CheckTypeMismatch( RType, E^.N^.r.R^.T, FALSE, -1 );
                                                                END;
                                                              END;
                                                              IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END;
                                                              IF LVI * DOM.TValueInfo{DOM.viLiteral} = DOM.TValueInfo{} THEN
                                                                VI := VI - DOM.TValueInfo{DOM.viLiteral};
                                                              END;
                                                              c^.AdaptMorphableTypes( E^.N^.T, E^.N^.r.L^.T, E^.N^.r.R^.T ); .)
    ]                                                      (. IF E^.N = NIL THEN
                                                                E^.T := Types.TUnknown;
                                                              ELSE
                                                                E^.T := E^.N^.T;
                                                              END;
                                                              E^.VI := VI; .)
.
  
ntSimpleExpression<VR : TValueReq; VAR N : DOM.TPENode; VAR VI : DOM.TValueInfo>
                                                           (. SGN : DOM.TEO := DOM.opUnknown;
                                                              NN : DOM.TPENode;
                                                              LVI : DOM.TValueInfo;
                                                              RType : DOM.TPType;
                                                              StringFlag : BOOLEAN; .)
  = [
      plus                                                 (. SGN := DOM.opSgnP; .)
    | minus                                                (. SGN := DOM.opSgnM; .)
    ]
    ntMultiplicativeTerm<VR, N, VI>                        (. IF SGN <> DOM.opUnknown THEN
                                                                NEW( NN );
                                                                NN^.T := N^.T;
                                                                NN^.r.N := DOM.enOperation;
                                                                NN^.r.R := N;
                                                                NN^.r.O := SGN;
                                                                N := NN;
                                                              END; .)
    {                                                      (. NEW( NN );
                                                              NN^.T := N^.T;
                                                              NN^.r.N := DOM.enOperation;
                                                              NN^.r.L := N;
                                                              N := NN; .)
      ntAdditiveOperator<N^.r.O>                           (. RType := N^.r.L^.T;
                                                              IF c^.CheckOperatorUsage( N, OUT RType, OUT N^.T ) THEN
                                                                // OK, class rewrites operator
                                                                N^.r.N := DOM.enClassOperator;
                                                                VI := VI - visConst;
                                                              ELSIF N^.r.O = DOM.opORL THEN
                                                                IF NOT c^.ExpectType( Types.TBOOLEAN, N^.r.L^.T, -1 ) THEN
                                                                  N^.T := Types.TBOOLEAN;
                                                                END;
                                                              ELSIF N^.r.L^.T^.Unwrap()^.TypeKind = DOM.tkEnumeration THEN
                                                                RType := Types.TOrdinalNumeric;
                                                              ELSE
                                                                IF NOT c^.ExpectType( Types.TOfAddOp, N^.r.L^.T, -1 ) THEN
                                                                  N^.T := Types.TNumber;
                                                                END;
                                                              END;
                                                              IF N^.r.N = DOM.enClassOperator THEN
                                                                StringFlag := FALSE;
                                                              ELSE
                                                                StringFlag := Types.TString^.Compatible( DOM.cmOperation, N^.T );
                                                              END;
                                                              IF StringFlag THEN
                                                                IF N^.r.O <> DOM.opAdd THEN
                                                                  SemErr( err._StringsCanBeConcatenatedOnly );
                                                                ELSIF VI * visConst = DOM.TValueInfo{} THEN
                                                                  SemErr( err._OnlyConstStringsCanBeConcatenated );
                                                                END;  
                                                                IF Types.TBString^.Compatible( DOM.cmOperation, N^.T ) THEN
                                                                  N^.T := Types.TBString;
                                                                  RType := Types.TBString;
                                                                ELSE
                                                                  N^.T := Types.TWString;
                                                                  RType := Types.TWString;
                                                                END;
                                                              ELSIF Types.TSet^.Compatible( DOM.cmOperation, N^.T ) THEN
                                                                IF N^.r.O = DOM.opAdd THEN
                                                                  N^.r.O := DOM.opAddSET;
                                                                ELSE
                                                                  N^.r.O := DOM.opSubSET;
                                                                END;
                                                                IF DOM.TPSet( N^.T^.Unwrap())^.IsLong() THEN
                                                                  c^.HandleAuxVariableRequest( N^.T, N^.r.SV );
                                                                END;
                                                              END; .)
      ntMultiplicativeTerm<VR, N^.r.R, LVI>                (. IF N^.r.R <> NIL THEN
                                                                c^.CheckTypeMismatch( RType, N^.r.R^.T, N^.r.N = DOM.enClassOperator, -1 );
                                                                c^.AdaptMorphableTypes( N^.T, N^.r.L^.T, N^.r.R^.T );
                                                              END;
                                                              IF StringFlag THEN
                                                                IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                  SemErr( err._OnlyConstStringsCanBeConcatenated );
                                                                END;
                                                                N^.r.O := DOM.opConcat;
                                                              END;
                                                              IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END;
                                                              IF LVI * DOM.TValueInfo{DOM.viLiteral} = DOM.TValueInfo{} THEN
                                                                VI := VI - DOM.TValueInfo{DOM.viLiteral};
                                                              END; .)
    }
.

ntMultiplicativeTerm<VR : TValueReq; VAR N : DOM.TPENode; VAR VI : DOM.TValueInfo>
                                                           (. NN : DOM.TPENode;
                                                              LVI : DOM.TValueInfo;
                                                              RType : DOM.TPType; .)
  = ntBitwiseTerm<VR, N, VI>
    {                                                      (. NEW( NN );
                                                              NN^.T := N^.T;
                                                              NN^.r.N := DOM.enOperation;
                                                              NN^.r.L := N;
                                                              N := NN; .)
      ntMultiplicativeOperator<N^.r.O>                     (. RType := N^.r.L^.T;
                                                              IF c^.CheckOperatorUsage( N, OUT RType, OUT N^.T ) THEN
                                                                // OK, class rewrites operator
                                                                N^.r.N := DOM.enClassOperator;
                                                                VI := VI - visConst;
                                                              ELSIF N^.r.O = DOM.opANDL THEN
                                                                IF NOT c^.ExpectType( Types.TBOOLEAN, N^.r.L^.T, err._ANDExpectsBOOLEAN ) THEN
                                                                  N^.T := Types.TBOOLEAN;
                                                                END;
                                                              ELSIF N^.r.O = DOM.opMult THEN
                                                                IF Types.TSet^.Compatible( DOM.cmOperation, N^.T ) THEN
                                                                  N^.r.O := DOM.opMultSET;
                                                                  IF DOM.TPSet( N^.T^.Unwrap())^.IsLong() THEN
                                                                    c^.HandleAuxVariableRequest( N^.T, N^.r.SV );
                                                                  END;
                                                                // enums cannot be simply multiplied
                                                                // ELSIF N^.r.L^.T^.Unwrap()^.TypeKind = DOM.tkEnumeration THEN
                                                                //   RType := Types.TOrdinalNumeric;
                                                                ELSIF NOT c^.ExpectType( Types.TOfMultOp, N^.r.L^.T, err._MultExpectsNumberOrSet ) THEN
                                                                  N^.T := Types.TNumber;
                                                                END;
                                                              ELSIF N^.r.O = DOM.opDiv THEN
                                                                IF Types.TSet^.Compatible( DOM.cmOperation, N^.T ) THEN
                                                                  N^.r.O := DOM.opDivSET;
                                                                  IF DOM.TPSet( N^.T^.Unwrap())^.IsLong() THEN
                                                                    c^.HandleAuxVariableRequest( N^.T, N^.r.SV );
                                                                  END;
                                                                ELSIF NOT c^.ExpectType( Types.TOfMultOp, N^.r.L^.T, err._MultExpectsNumberOrSet ) THEN
                                                                  N^.T := Types.TNumber;
                                                                END;
                                                              ELSE
                                                                // IF N^.r.L^.T^.Unwrap()^.TypeKind = DOM.tkEnumeration THEN
                                                                //   RType := Types.TOrdinalNumeric;
                                                                // ELSIF
                                                                IF NOT c^.ExpectType( Types.TNumber, N^.r.L^.T, err._DIVMODExpectsNumber ) THEN
                                                                  N^.T := Types.TNumber;
                                                                END;
                                                              END; .)
      ntBitwiseTerm<VR, N^.r.R, LVI>                       (. IF N^.r.R <> NIL THEN
                                                                c^.CheckTypeMismatch( RType, N^.r.R^.T, N^.r.N = DOM.enClassOperator, -1 );
                                                              END;
                                                              IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END;
                                                              IF LVI * DOM.TValueInfo{DOM.viLiteral} = DOM.TValueInfo{} THEN
                                                                VI := VI - DOM.TValueInfo{DOM.viLiteral};
                                                              END; .)
    }
.

ntBitwiseTerm<VR : TValueReq; VAR N : DOM.TPENode; VAR VI : DOM.TValueInfo>
                                                           (. NN : DOM.TPENode;
                                                              LVI : DOM.TValueInfo;
                                                              RType : DOM.TPType;
                                                              DoBitwise : BOOLEAN := TRUE; .)
  = ntFactor<VR, N, VI>                                    (. IF N = NIL THEN
                                                                DoBitwise := FALSE;
                                                              ELSE
                                                                RType := N^.T;
                                                              END;
                                                              IF NOT DoBitwise THEN
                                                                // skip ntBitwiseTerm, some error occured
                                                              ELSIF Types.TOrdinalNumber^.Compatible( DOM.cmOperation, N^.T ) THEN
                                                              ELSIF RType^.Unwrap()^.TypeKind = DOM.tkEnumeration THEN
                                                                RType := Types.TOrdinalNumeric;
                                                              ELSIF Types.TStorage^.Compatible( DOM.cmOperation, N^.T ) THEN
                                                              ELSIF Types.TPTR^.Compatible( DOM.cmOperation, N^.T ) THEN
                                                              ELSE // skip ntBitwiseTerm, AND OR will be logical
                                                                DoBitwise := FALSE;
                                                              END;
                                                              IF DoBitwise THEN .) // validity of left type is checked here
    {                                                      (.   NEW( NN );
                                                                NN^.T := N^.T;
                                                                NN^.r.N := DOM.enOperation;
                                                                NN^.r.L := N;
                                                                N := NN; .)
      ( ntBitwiseOperator<N^.r.O>
      | ntShiftOperator<N^.r.O> )                          (.   IF c^.CheckOperatorUsage( N, OUT RType, OUT N^.T ) THEN
                                                                  // OK, class rewrites operator
                                                                  N^.r.N := DOM.enClassOperator;
                                                                  VI := VI - visConst;
                                                                END; .)
      ntFactor<VR, N^.r.R, LVI>                            (.   IF N^.r.R <> NIL THEN
                                                                  IF N^.r.N = DOM.enClassOperator THEN
                                                                    c^.CheckTypeMismatch( RType, N^.r.R^.T, TRUE, -1 );
                                                                  ELSE CASE N^.r.O OF
                                                                  | DOM.opLShift, DOM.opRShift :
                                                                    c^.ExpectType( Types.TOrdinalNumber, N^.r.R^.T, -1 );
                                                                  ELSE
                                                                    IF N^.r.L^.T^.Compatible( DOM.cmOperation, N^.r.R^.T ) THEN // OK
                                                                    ELSIF Types.TBYTE^.Compatible( DOM.cmOperation, N^.r.L^.T ) AND Types.TBYTE^.Compatible( DOM.cmOperation, N^.r.R^.T ) THEN // OK
                                                                    ELSIF Types.TLONGWORD^.Compatible( DOM.cmOperation, N^.r.L^.T ) AND Types.TLONGWORD^.Compatible( DOM.cmOperation, N^.r.R^.T ) THEN // OK
                                                                    ELSIF Types.TWORD^.Compatible( DOM.cmOperation, N^.r.L^.T ) AND Types.TWORD^.Compatible( DOM.cmOperation, N^.r.R^.T ) THEN // OK
                                                                    ELSIF Types.TQUADWORD^.Compatible( DOM.cmOperation, N^.r.L^.T ) AND Types.TQUADWORD^.Compatible( DOM.cmOperation, N^.r.R^.T ) THEN // OK
                                                                    ELSE
                                                                      SemErr( err._BitANDORXORExpectNumberOrStorageOfSameBitLengths );
                                                                    END;
                                                                  END; END;
                                                                END;
                                                                IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                  VI := VI - visConst;
                                                                END;
                                                                IF LVI * DOM.TValueInfo{DOM.viLiteral} = DOM.TValueInfo{} THEN
                                                                  VI := VI - DOM.TValueInfo{DOM.viLiteral};
                                                                END; .)
    }                                                      (. END; .) // otherwise ntBitwiseTerm is reduced to ntFactor
.

ntFactor<VR : TValueReq; VAR N : DOM.TPENode; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression;
                                                              i : INTEGER; .)
  =
  (
    lpar ntCommonExpression<VR, E, VI> rpar                (. NEW( N );
                                                              N^.T := E^.T;
                                                              N^.r.N := DOM.enOperation;
                                                              N^.r.O := DOM.opSubExpr;
                                                              N^.r.L := E^.N;
                                                              DISPOSE( E ); .)  
  |                                                        (. NEW( N );
                                                              N^.r.N := DOM.enOperation;
                                                              N^.r.O := DOM.opNotB; .)
    ntNegation ntFactor<VR, N^.r.R, VI>                    (. IF c^.ExpectType( Types.TOfNotOp, N^.r.R^.T, err._NOTExpectsBOOLEANOrNumber ) THEN
                                                                N^.T := N^.r.R^.T;
                                                              ELSE
                                                                N^.T := Types.TBOOLEAN;
                                                              END;
                                                              IF Types.TBOOLEAN^.Compatible( DOM.cmOperation, N^.r.R^.T ) THEN
                                                                N^.r.O := DOM.opNotL;
                                                              END; .)
  |                                                        (. NEW( N );
                                                              N^.r.N := DOM.enLiteral; .)
    ntConstantLiteral<TRUE, N^.r.OK, N^.T>                 (. IF N^.r.OK = DOM.okCharacter THEN // numerical character representation
                                                                t.Val.Substring( 0, t.Val.Length - 1, OUT N^.r.S );
                                                                  IF NOT N^.r.S.ToINT32( 10, OUT i ) THEN
                                                                     N^.r.S.FromOA( L"<bad character>" );
                                                                  ELSIF Types.TBCHAR^.Compatible( DOM.cmOperation, N^.T ) THEN
                                                                     N^.r.S.FromOAA( 0, CHAR( i ) );
                                                                  ELSE
                                                                     N^.r.S.FromOA( WCHAR( i ) );
                                                                  END;
                                                              ELSIF ( N^.T = Types.TTCHARW ) OR ( N^.T = Types.TTStringW ) OR ( N^.T = Types.TTCHARB ) OR ( N^.T = Types.TTStringB ) THEN
                                                                t.Val.Substring( 1, t.Val.Length - 2, OUT N^.r.S );
                                                              ELSIF ( N^.T = Types.TWCHAR ) OR ( N^.T = Types.TWString ) THEN
                                                                t.Val.Substring( 2, t.Val.Length - 3, OUT N^.r.S );
                                                              ELSIF ( N^.T = Types.TBCHAR ) OR ( N^.T = Types.TBString ) THEN
                                                                t.Val.Substring( 2, t.Val.Length - 3, OUT N^.r.S );
                                                              ELSE
                                                                N^.r.S.Assign( t.Val );
                                                              END;
                                                              VI := visConstLiteral; .)

/* grammar modified to remove LL(1) conflict, ntFunctionCall, ntValueConstructor and
 * ntValueDesignator
 * must be deistinguished semantically
 * | ntValueDesignator
 * | ntValueConstructor
 * | ntFunctionCall
 */

  |                                                        (. NEW( N ); .)
    ntValueDesignator<VR, N, VI>
  )
.

ntRewritableOperator<VAR O : DOM.TEO>
  = ntRelationalOperator<O>
  | ntAdditiveOperator<O>
  | ntMultiplicativeOperator<O>
  | ntShiftOperator<O>
  | "XOR"                                                  (. O := DOM.opEORB; .)
  | "NEW"                                                  (. O := DOM.opNEW; .)
  | "DISPOSE"                                              (. O := DOM.opDISPOSE; .)
  | assignment                                             (. O := DOM.opAssign; .)
.

ntRelationalOperator<VAR O : DOM.TEO>
  = equals                                                 (. O := DOM.opEQ; .)
  | ntInequality                                           (. O := DOM.opNEQ; .)
  | lessThan                                               (. O := DOM.opLT; .)
  | greaterThan                                            (. O := DOM.opGT; .)
  | lessThanOrEqual                                        (. O := DOM.opLTE; .)
  | greaterThanOrEqual                                     (. O := DOM.opGTE; .)
  | "IN"                                                   (. O := DOM.opIN; .)
  | "NOT" "IN"                                             (. O := DOM.opNotIN; .)
  | "IS"                                                   (. O := DOM.opISExact; .)
  | "INHERITS"                                             (. O := DOM.opISInherits; .)
.
  
ntAdditiveOperator<VAR O : DOM.TEO>
  = plus                                                   (. O := DOM.opAdd; .)
  | minus                                                  (. O := DOM.opSub; .)
  | ntLogicalDisjunction                                   (. O := DOM.opORL; .)
.

ntMultiplicativeOperator<VAR O : DOM.TEO>
  = multiplication                                         (. O := DOM.opMult; .)
  | division                                               (. O := DOM.opDiv; .)
  | "REM"                                                  (. O := DOM.opRem; .)
  | "DIV"                                                  (. O := DOM.opIDiv; .)
  | ntMod                                                  (. O := DOM.opMod; .)
  | ntLogicalConjunction                                   (. O := DOM.opANDL; .)
.

ntBitwiseOperator<VAR O : DOM.TEO>
  = ntBitwiseDisjunction                                   (. O := DOM.opORB; .)
  | ntBitwiseConjunction                                   (. O := DOM.opANDB; .)
  | ntBitwiseSymmetricSetDifference                        (. O := DOM.opEORB; .)
.

ntShiftOperator<VAR O : DOM.TEO>
  = leftShift                                              (. O := DOM.opLShift; .)
  | rightShift                                             (. O := DOM.opRShift; .)
.

/* =========value designators */

ntValueDesignator<VR : TValueReq; N : DOM.TPENode; VAR VI : DOM.TValueInfo>
/* original normative grammar, which is L-recursive.
   The grammar is modified, incuding removing designators from
   left of descendant rules.
  = ntEntireValue<DataType>
  | ntIndexedValue<DataType>
  | ntSelectedValue<DataType>
  | ntDereferencedValue<DataType>
*/
  =                                                        (. INC( c^.DCount );
                                                              N^.r.N := DOM.enDesignator;
                                                              NEW( N^.r.V ); .)
  (
    ntEmbeddedFunction<VR, N^.r.V, VI>
  | ntEntireValue<VR, N, VI>
  ) ntNonLRecursiveDesignator<VR, N^.r.V, VI>              (. DEC( c^.DCount );
                                                              IF c^.DCount = 0 THEN
                                                                EnableErrors();
                                                              END;
                                                              N^.r.V^.VI := VI;
                                                              N^.T := N^.r.V^.T;
                                                              IF ( vrConst IN VR ) AND NOT( DOM.viConst IN VI ) THEN
                                                                SemErr( err._DesignatorIsNotConstant );
                                                              END; .)
.

ntEntireValue<VR : TValueReq; ND : DOM.TPENode; VAR VI : DOM.TValueInfo>
                                                           (. ProcFlag, RequireValueConstructor : BOOLEAN; .)
  =                                                        (. VI := DOM.TValueInfo{};
                                                              WITH ND^.r DO .)
  ( ntDesignatorLeading<VR, V, OUT VI>                     (.   RequireValueConstructor := V^.r.DK = DOM.dkType; .)
    [                                                      (.   ProcFlag := ( V^.r.Id = NIL ) OR V^.r.Id^.IsProcedure( FALSE );
                                                                IF NOT ProcFlag THEN
                                                                  RequireValueConstructor := FALSE;
                                                                  IF V^.r.Id^.SymbolKind <> DOM.skType THEN
                                                                    SemErr( err._ExpectedTypeName );
                                                                  END;
                                                                  NEW( V^.r.TC );
                                                                  V^.r.TC^.T := V^.T^.Unwrap(); .)
      ntValueConstructor<VR + TValueReq{vrAllowCast}, REF V^.r.TC, VI>
                                                           (.     V^.T := V^.r.TC^.T;
                                                                  IF ( DOM.viAuxiliaryConst IN VI ) AND ( TValueReq{vrConst} * VR = TValueReq{} ) THEN
                                                                    // constant constructors can be deffered only if they are used on RSide of VAR, otherwise they can stay in the place
                                                                    c^.HandleAuxConstantDesignatorRequest( V );
                                                                  END;
                                                                END; .)
    ]                                                      (.   IF RequireValueConstructor AND ( vrAllowSingleType NOT IN VR ) THEN
                                                                  SemErr( err._ExpressionToCastExpected );
                                                                END; .)
  |                                                        (.   INCL( VI, DOM.viConst );
                                                                V^.r.DK := DOM.dkType; // set literal
                                                                NEW( V^.r.TC );
                                                                V^.r.TC^.T := Types.TNumericSet; // only sets built over ordinal numerics can be literated without type
                                                                V^.T := Types.TNumericSet; // only sets built over ordinal numerics can be literated without type
                                                                c^.EnterUnit( V^.r.TC ); .)
    ntSetConstructedValue<Types.TNumericSet, VI>           (.   c^.LeaveUnit();
                                                                // TNumericSet must always be examined as long, because the type of RSide here is not known
                                                                // IF ( DOM.viAuxiliaryConst IN VI ) AND ( {vrConst} * VR = {} ) THEN
                                                                IF TValueReq{vrConst} * VR = TValueReq{} THEN
                                                                  // constant constructors can be deffered only if they are used on RSide of VAR, otherwise they can stay in the place
                                                                  c^.HandleAuxConstantDesignatorRequest( V );
                                                                END; .)
  )                                                        (. END; .)
.

/* unused in grammar due to resolving LL(1) conflict  
ntFunctionCall<CType DataType>
  = ntFunctionDesignator ntActualParameters<ParameterTypes>
.
 */
  
/* =========value constructors */

/* unused due to LL(1) conflicts
ntValueConstructor
  = ntSetConstructor
  | ntArrayConstructor
  | ntRecordConstructor
  | ntSingleTypeConstructor
.
*/

ntValueConstructor<VR : TValueReq; REF TC : DOM.TPTypedContainer; VAR VI : DOM.TValueInfo>
  =                                                        (. c^.EnterUnit( TC ); .)
  ( ntKnownTypeValueConstructor<VR, TC^.T, TC^.Cast, VI>
  |                                                        (. IF TC^.T^.Unwrap()^.TypeKind <> DOM.tkSet THEN
                                                                TC^.T := c^.GetSetFormalType( TC^.T );
                                                              END; .)
    ntSetConstructedValue<TC^.T, VI>                       (. INCL( VI, DOM.viConst );
                                                              TC^.Cast := FALSE; .)
  )                                                        (. c^.LeaveUnit();
                                                              EXCL( VI, DOM.viLiteral ); .)
.

ntSetConstructedValue<SetT : DOM.TPType; VAR VI : DOM.TValueInfo>
                                                           (. LVI : DOM.TValueInfo;
                                                              MemberT : DOM.TPType; .)
  =                                                        (. MemberT := DOM.TPSet( SetT )^.GetItemType();
                                                              IF NOT Types.TOrdinal^.Compatible( DOM.cmOperation, MemberT ) AND
                                                                 NOT Types.TSetNumber^.Compatible( DOM.cmOperation, MemberT ) THEN
                                                                SemErr( err._ExpectedOrdinalOrStorageType );
                                                              END; .)
    lbrace
      [
        ntSetMember<MemberT, VI>
        { WEAK comma
          ntSetMember<MemberT, LVI>                        (. IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END; .)
        }
      ]
    SYNC rbrace                                            (. IF DOM.TPSet( SetT )^.IsLong() THEN
                                                                INCL( VI, DOM.viAuxiliaryConst );
                                                              END; .)
.
  
ntKnownTypeValueConstructor<VR : TValueReq; T : DOM.TPType; VAR CastFlag : BOOLEAN; VAR VI : DOM.TValueInfo>
                                                           (. StructureFlag : BOOLEAN := TRUE; .)
  =
  lpar
  (                                                        
    IF ( T^.TypeKind = DOM.tkArray )
      ntArrayConstructedValue<VR, DOM.TPArray( T ), CastFlag, VI>
  | IF ( T^.TypeKind = DOM.tkRecord )
      ntRecordConstructedValue<VR, DOM.TPRecord( T ), CastFlag, VI>
  |                                                        (. StructureFlag := FALSE;
                                                              CastFlag := TRUE; .)
    ntSingleTypeConstructedValue<T, VR, VI>                (. EXCL( VI, DOM.viAuxiliaryConst ); .)
  )                                                        (. IF CastFlag AND StructureFlag AND ( DOM.TValueInfo{DOM.viConst, DOM.viStructuredType} * VI = DOM.TValueInfo{DOM.viConst} ) THEN
                                                                SemErr( err._UnableToCastScalar );
                                                              END;
                                                              // casting modifies CONST information
                                                              IF T^.IsFormal() AND ( DOM.TPFormalType( T )^.TypeModifier = DOM.tmCONST ) THEN
                                                                INCL( VI, DOM.viCONST );
                                                              ELSE
                                                                EXCL( VI, DOM.viCONST );
                                                              END; .)
  rpar
.

ntArrayConstructedValue<VR : TValueReq; Array : DOM.TPArray; VAR Cast : BOOLEAN; VAR VI : DOM.TValueInfo>
// here must be heuristically distinguished between array constructor T( i, j, ... ) and
// array type cast T( i ). CPP does not allows constructed types on R side, so they must be
// declared as constants, which implies M2CPP must not allow non-constant array constructor items too... :-(
                                                           (. Count : CARDINAL := -1;
                                                              E : DOM.TPExpression;
                                                              EV : DOM.CEValue;
                                                              LVI : DOM.TValueInfo;
                                                              RepeatCount : CARDINAL;
                                                              T, DeferredT : DOM.TPType;
                                                              CharArray : BOOLEAN;
                                                              SingleExpression : BOOLEAN := TRUE; .)
  =                                                        (. Cast := vrAllowCast IN VR;
                                                              IF Array^.I <> NIL THEN
                                                                Count := Array^.Count();
                                                              END;
                                                              T := Array^.T;
                                                              CharArray := Types.TTCHAR^.Compatible( DOM.cmOperation, T ); .)
    ntCommonExpression<VR + TValueReq{vrInsideConstructor}, E, VI>
                                                           (. IF T^.Compatible( DOM.cmAssign, E^.T ) THEN // OK, no cast
                                                                Cast := FALSE;
                                                                IF VI * visConst = DOM.TValueInfo{} THEN
                                                                  SemErr( err._ItemOfTypeConstructorMustBeConst );
                                                                END;
                                                              ELSIF CharArray AND E^.T^.Compatible( DOM.cmAssign, T ) THEN
                                                                // array of *char entered as string, do not continue with items
                                                                IF DOM.viConst IN VI THEN
                                                                  E^.Evaluate( EV, 0 );
                                                                  IF EV.S.Empty THEN // OK, empty string
                                                                  ELSIF EV.S.Length = Count THEN // string exactly fills its type
                                                                    INCL( E^.Options, DOM.eoStringLiteralAsChars );
                                                                  ELSIF EV.S.Length > Count THEN
                                                                    SemErr( err._StringTooLong );
                                                                  END;
                                                                END;
                                                                Cast := FALSE;
                                                                Count := 0;
                                                              ELSIF Cast THEN // not compatible, but cast is allowed and this is OK
                                                                DeferredT := T;
                                                                IF E^.T^.Unwrap()^.PrimitiveType = DOM.ptStructure THEN
                                                                  INCL( VI, DOM.viStructuredType );
                                                                END;
                                                              ELSE // cast not allowed report error immediatelly
                                                                c^.ExpectType( T, E^.T, -1 );
                                                              END;  
                                                              E^.TargetT := T;
                                                              c^.AddUnit( E );
                                                              RepeatCount := 1; .)
    [                                                      (. SingleExpression := FALSE;
                                                              IF Cast THEN // field type was not compatible, report deferred error as here is evident that this is not cast
                                                                c^.ExpectType( DeferredT, E^.T, -1 );
                                                                Cast := FALSE;
                                                              END; .)
      "BY" ntRepetitionFactor<RepeatCount>
    ]                                                      (. IF Count = -1 THEN
                                                                // go down
                                                              ELSIF Count > RepeatCount THEN
                                                                DEC( Count, RepeatCount );
                                                              ELSE
                                                                Count := 0;
                                                              END; .)
    {                                                      (. SingleExpression := FALSE;
                                                              IF Cast THEN // field type was not compatible, report deferred error
                                                                c^.ExpectType( DeferredT, E^.T, -1 );
                                                                Cast := FALSE;
                                                              END; .)
      WEAK comma                                           (. Cast := FALSE;
                                                              IF Count = 0 THEN
                                                                Count := -1;
                                                                errDist := -1;
                                                                SemErr( err._TooManyArrayItems );
                                                              END; .)
      ntCommonExpression<VR + TValueReq{vrConst, vrInsideConstructor}, E, LVI>
                                                           (. c^.ExpectType( T, E^.T, -1 );
                                                              E^.TargetT := T;
                                                              IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END;
                                                              c^.AddUnit( E );
                                                              RepeatCount := 1; .)
      [ "BY" ntRepetitionFactor<RepeatCount> ]             (. IF Count = -1 THEN
                                                                // go down
                                                              ELSIF Count > RepeatCount THEN
                                                                DEC( Count, RepeatCount );
                                                              ELSE
                                                                Count := 0;
                                                              END; .)
    }                                                      (. IF SingleExpression AND NOT Cast AND NOT CharArray THEN
                                                                Cast := Array^.Count() > 1; // casting will be applied if more members is expected
                                                              END;
                                                              IF Cast THEN
                                                                EXCL( VI, DOM.viAuxiliaryConst );
                                                                IF E^.T^.Unwrap()^.TypeKind = DOM.tkReference THEN
                                                                  SemErr( err._UnableToCastPointerToArray );
                                                                END;
                                                              ELSIF ( Count <> -1 ) AND ( Count > 0 ) AND NOT CharArray THEN
                                                                // CharArray: for character arrays incomplete is complex: string of length 1 = character = expected
                                                                // more separated character does not imply incomplete array
                                                                SemErr( err._ArrayConstructorIsNotComplete );
                                                              ELSIF vrInsideConstructor IN VR THEN
                                                                EXCL( VI, DOM.viAuxiliaryConst );
                                                              ELSE  
                                                                INCL( VI, DOM.viAuxiliaryConst );
                                                              END; .)
.
  
ntRepetitionFactor<VAR RF : CARDINAL>                      (. EV : DOM.CEValue;
                                                              Expression : DOM.TPExpression;
                                                              ok : BOOLEAN; .)
  = ntOrdinalNumberExpression<vrsDefault, Expression, ok>  (. IF ok THEN
                                                                Expression^.Evaluate( EV, 0 );
                                                                RF := CARDINAL( EV.ToInteger());
                                                              ELSE
                                                                RF := 0;
                                                              END; .)
.
  
ntRecordConstructedValue<VR : TValueReq; Record : DOM.TPRecord; VAR Cast : BOOLEAN; VAR VI : DOM.TValueInfo>                   
// here must be heuristically distinguished between record constructor T( i, j, ... ) and
// record type cast T( i ). CPP does not allows constructed types on R side, so they must be
// declared as constants, which implies M2CPP must not allow non-constant record constructor items too... :-(
                                                           (. E : DOM.TPExpression;
                                                              EV : DOM.CEValue;
                                                              FieldType, DeferredFieldType : DOM.TPType;
                                                              LVI : DOM.TValueInfo;
                                                              VariantIdx : INT64 := 0;
                                                              b, e, VS, UN : BOOLEAN := FALSE;
                                                              SingleExpression : BOOLEAN := TRUE; .)
  =                                                        (. Cast := vrAllowCast IN VR;
                                                              b := Record^.ConstructorGetFirst( FieldType, VS, UN ); .)
    [                                                      (. IF NOT b THEN
                                                                e := TRUE; SemErr( err._TooManyRecordItems );
                                                              END; .)
      ntCommonExpression<VR + TValueReq{vrInsideConstructor}, E, VI>
                                                           (. IF FieldType^.Compatible( DOM.cmAssign, E^.T ) THEN // OK, no cast
                                                                Cast := FALSE;
                                                                IF VI * visConst = DOM.TValueInfo{} THEN
                                                                  SemErr( err._ItemOfTypeConstructorMustBeConst );
                                                                END;
                                                              ELSIF Cast THEN // not compatible, but cast is allowed and this is OK
                                                                DeferredFieldType := FieldType;
                                                                IF E^.T^.Unwrap()^.PrimitiveType = DOM.ptStructure THEN
                                                                  INCL( VI, DOM.viStructuredType );
                                                                END;
                                                              ELSE // cast not allowed report error immediatelly
                                                                c^.ExpectType( FieldType, E^.T, -1 );
                                                              END;  
                                                              IF VS AND NOT Cast THEN
                                                                E^.GenTo[Generator.genCPP] := NOT UN;
                                                                IF b THEN
                                                                  E^.Evaluate( EV, 0 );
                                                                  VariantIdx := EV.ToInteger();
                                                                END;  
                                                              END;
                                                              E^.TargetT := FieldType;
                                                              c^.AddUnit( E );
                                                              b := Record^.ConstructorGetNext( VariantIdx, FieldType, VS, UN ); .)
      {                                                    (. SingleExpression := FALSE;
                                                              IF Cast THEN // field type was not compatible, report deferred error
                                                                c^.ExpectType( DeferredFieldType, E^.T, -1 );
                                                                Cast := FALSE;
                                                              END; .)
        WEAK comma                                         (. IF NOT b THEN
                                                                FieldType := Types.TUnknown;
                                                                IF NOT e THEN
                                                                  errDist := -1;
                                                                  e := TRUE; SemErr( err._TooManyRecordItems );
                                                                END;
                                                              END; .)
        ntCommonExpression<VR + TValueReq{vrConst, vrInsideConstructor}, E, LVI>
                                                           (. b := c^.ExpectType( FieldType, E^.T, -1 );
                                                              E^.TargetT := FieldType;
                                                              IF VS AND b THEN
                                                                E^.GenTo[Generator.genCPP] := NOT UN;
                                                                IF b THEN
                                                                  E^.Evaluate( EV, 0 );
                                                                  VariantIdx := EV.ToInteger();
                                                                END;  
                                                              END;
                                                              c^.AddUnit( E );
                                                              IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END;
                                                              b := Record^.ConstructorGetNext( VariantIdx, FieldType, VS, UN ); .)
      }
    ]                                                      (. IF SingleExpression AND NOT Cast THEN
                                                                Cast := b; // casting will be applied if more members is expected
                                                              END;
                                                              IF Cast THEN
                                                                EXCL( VI, DOM.viAuxiliaryConst );
                                                                IF E^.T^.Unwrap()^.TypeKind = DOM.tkReference THEN
                                                                  SemErr( err._UnableToCastPointerToRecord );
                                                                END;
                                                              ELSIF b THEN
                                                                SemErr( err._RecordConstructorIsNotComplete );
                                                              ELSIF vrInsideConstructor IN VR THEN
                                                                EXCL( VI, DOM.viAuxiliaryConst );
                                                              ELSE  
                                                                INCL( VI, DOM.viAuxiliaryConst );
                                                              END; .)
.

/* changed to remove LL(1) ambiguity  
ntSetMember
  = ntInterval
  | ntSingleton
.
  
ntInterval
  = ntOrdinalExpression<FALSE, out Expression>
    ellipsis ntOrdinalExpression<FALSE, out Expression>
.
  
ntSingleton
  = ntOrdinalExpression<FALSE, out Expression>
.
*/

ntSetMember<MemberT : DOM.TPType; VAR VI : DOM.TValueInfo> (. E : DOM.TPExpression;
                                                              LVI : DOM.TValueInfo; .)
  = ntCommonExpression<vrsConst, E, VI>                    (. c^.AddUnit( E );
                                                              c^.ExpectType( MemberT, E^.T, err._ConstructedMemberIsNotMember ); .)
    [ 
      ellipsis
      ntCommonExpression<vrsConst, E, LVI>                 (. c^.AddUnit( E );
                                                              c^.ExpectType( MemberT, E^.T, err._ConstructedMemberIsNotMember );
                                                              IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END; .)
    ]
.

ntSingleTypeConstructedValue<T : DOM.TPType; VR : TValueReq; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression;
                                                              ET : DOM.TPType; .)
  = ntCommonExpression<VR, E, VI>                          (. c^.AddUnit( E );
                                                              T := T^.Unwrap();
                                                              ET := E^.T^.Unwrap();
                                                              IF ET^.PrimitiveType = DOM.ptStructure THEN
                                                                INCL( VI, DOM.viStructuredType );
                                                              END;
                                                              IF Types.TADDRESS^.Compatible( DOM.cmOperation, T ) OR ( T = Types.TPTR ) THEN
                                                                IF DOM.viStructuredType IN VI THEN
                                                                  Warning( wrn._CastToPointer );
                                                                END;
                                                                IF Types.TADDRESS^.Compatible( DOM.cmOperation, ET ) OR
                                                                   ( ET = Types.TPTR ) OR
                                                                   ( ET = Types.TOrdinalNumber ) OR
                                                                   ( ET^.TypeKind = DOM.tkProcedure ) THEN
                                                                  // compatible
                                                                ELSIF Types.TOrdinal^.Compatible( DOM.cmOperation, ET ) AND ( ET^.Unwrap()^.LastOrdinal() <= MAX( CARD32 )) THEN
                                                                  // not compatible, but trucation cannot occur
                                                                ELSIF ET^.OccupiedMemory() > SIZE( CARD32 ) THEN
                                                                  Warning( wrn._UnsafePointerCast );
                                                                END;
                                                              ELSIF Types.TADDRESS^.Compatible( DOM.cmOperation, ET ) OR ( ET = Types.TPTR ) THEN
                                                                IF NOT Types.TADDRESS^.Compatible( DOM.cmOperation, T ) AND
                                                                   NOT( T = Types.TPTR ) AND
                                                                   NOT( T^.TypeKind = DOM.tkProcedure ) AND
                                                                      ( T^.OccupiedMemory() < SIZE( CARD64 )) THEN
                                                                  Warning( wrn._UnsafePointerCast );
                                                                END;
                                                              END;
                                                              ET := ET^.UnwrapToBaseType(); 
                                                              IF ( ET^.TypeKind = DOM.tkClass ) AND ( DOM.imCOM IN DOM.TPClass( ET )^.IM ) THEN
                                                                SemErr( err._UnableToCastCOMInterface );
                                                              END; .)
.
  
/* original, with LL conflicts
ntArrayConstructor<VAR DataType : DOM.TPType>
  = ntArrayTypeId<DataType> ntArrayConstructedValue
.

ntArrayTypeId<VAR DataType : DOM.TPType>
  = ntTypeId<DataType>
.

ntArrayConstructedValue
                               (. CType ItemType; .)
  = lpar ntRepeatedStructureComponent<ItemType>
    { comma ntRepeatedStructureComponent<ItemType> } rpar
.
  
ntRecordConstructor<VAR DataType : DOM.TPType>
  = ntRecordTypeId<DataType> ntRecordConstructedValue
.

ntRecordTypeId<VAR DataType : DOM.TPType>
  = ntTypeId<DataType>
.

ntRecordConstructedValue
  = lpar [
      ntStructureComponent<DataType>
      { comma ntStructureComponent<DataType> }
    ] rpar
.

ntSetConstructor<VAR DataType : DOM.TPType>
  =
    [
      ntSetTypeId<SetType>
    ]
    ntSetConstructedValue
.

ntSetTypeId<VAR DataType : DOM.TPType>
  = ntTypeId<DataType>
.
*/
  
ntEmbeddedFunction<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
  =                                                        (. D^.r.DK := DOM.dkEmbeddedProcedure; .)
  ( ntEmbeddedABS<VR, D, VI>
  | ntEmbeddedADR<VR, D, VI>
  | ntEmbeddedCAPLOWFunc<VR, D, VI>
  // | "CHR"
  | ntEmbeddedDEBUGGED<VR, D, VI>
  | ntEmbeddedDECINCFunc<VR, D, VI>
  | ntEmbeddedEMIT<D>                                      (. VI := DOM.TValueInfo{DOM.viConst}; .)
  | ntEmbeddedEQUALS<VR, D, VI>
  | ntEmbeddedODDEVEN<VR, D, VI>
  | ntEmbeddedFIELDOFS<VR, D, VI>                          (. VI := DOM.TValueInfo{DOM.viConst}; .)
  | ntEmbeddedFRAC<VR, D, VI>
  | ntEmbeddedHIGH<VR, D, VI>
  | ntEmbeddedINSIDE<VR, D, VI>
  | ntEmbeddedLENGTH<VR, D, VI>
  | ntEmbeddedMINMAX<VR, D, VI>                            (. VI := DOM.TValueInfo{DOM.viConst}; .)
  | ntEmbeddedMIN2MAX2<VR, D, VI>
  | ntEmbeddedOA<VR, D, VI>
  | ntEmbeddedNEWFunc<VR, D, VI>
  | ntEmbeddedORD<VR, D, VI>
  | ntEmbeddedSIZE<VR, D, VI>                              (. VI := DOM.TValueInfo{DOM.viConst}; .)
  | ntEmbeddedTRUNC<VR, D, VI>
  | ntEmbeddedVAL<VR, D, VI>
  | ntEmbeddedSWAPs<VR, D, VI>
  | ntEmbeddedLOHIBs<VR, D, VI>
  | ntEmbeddedLOHIWs<VR, D, VI>
  | ntEmbeddedLOHILWs<VR, D, VI>
  | ntEmbeddedLOHIPTRs<VR, D, VI>
  )                                                        (. VI := VI - DOM.visLValue; .)
.

ntEmbeddedABS<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  =
  "ABS"                                                    (. D^.r.EP := DOM.epABS; .)
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := E^.T;
                                                              c^.ExpectType( Types.TNumber, D^.T, -1 ); .)
  rpar
.

ntEmbeddedADR<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. LD : DOM.TPDesignator := NEW( DOM.CDesignator ); .)
  =
  "ADR"                                                    (. D^.r.EP := DOM.epADR; .)
  lpar
    ntVariableDesignator<VR + TValueReq{vrSLValue, vrClassLValue}, LD, VI>(. D^.r.U1 := LD;
                                                              IF LD^.r.DK = DOM.dkId THEN
                                                                IF LD^.r.Id^.UnitKind = DOM.ukSelf THEN // handle ADR( SELF )
                                                                  D^.r.DK := DOM.dkId;
                                                                  D^.r.Id := LD^.r.Id;
                                                                  D^.r.Id^.UnitKind := DOM.ukADRSelf;
                                                                  D^.r.IdA := LD^.r.IdA;
                                                                  D^.r.GO := LD^.r.GO;
                                                                ELSIF LD^.r.Id^.SymbolKind = DOM.skConstant THEN
                                                                  CASE LD^.T^.TypeKind OF
                                                                  | DOM.tkStringArray, DOM.tkArray, DOM.tkRecord, DOM.tkClass : // structured constant are persistent and have address
                                                                    INCL( VI, DOM.viLValue );
                                                                  END;
                                                                END;
                                                              ELSIF ( LD^.r.DK = DOM.dkOperator ) AND
                                                                    (
                                                                      ( LD^.r.O = DOM.doSelectingOfSuperClass ) OR
                                                                      ( LD^.r.O = DOM.doSelecting ) AND ( LD^.r.F <> NIL ) AND LD^.r.F^.IsClass()
                                                                    ) THEN
                                                                 D^.r.EP := DOM.epADROfSuperClass;
                                                              END;
                                                              NEW( D^.T );
                                                              D^.T^.TypeKind := DOM.tkReference;
                                                              D^.T^.T := LD^.T;
                                                              // duplicate?? to ntVariableDesignator
                                                              // IF ( D^.r.EP = DOM.epADR ) AND NOT( DOM.viLValue IN VI ) THEN
                                                              //   SemErr( err._ExpectedLValue );
                                                              // END;
                                                              .)
  rpar
.

ntEmbeddedCAPLOWFunc<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  =                                                        (. IF vrConst IN VR THEN
                                                                SemErrS( err._IsNotConst, L'CAP/LOW' );  
                                                              END; .)
  ( "CAP"                                                  (. D^.r.EP := DOM.epCAPFunc; .)
  | "LOW"                                                  (. D^.r.EP := DOM.epLOWFunc; .)
  )
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              c^.ExpectType( Types.TTCHAR, E^.T, -1 );
                                                              D^.T := E^.T;
                                                              IF Types.TBCHAR^.Compatible( DOM.cmAssign, D^.T ) THEN
                                                                IF D^.r.EP = DOM.epCAPFunc THEN
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidCapA] = NIL THEN
                                                                    SemErr( err._MissingCapA );
                                                                  END;
                                                                ELSE
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidLowA] = NIL THEN
                                                                    SemErr( err._MissingLowA );
                                                                  END;
                                                                END;
                                                              ELSE
                                                                IF D^.r.EP = DOM.epCAPFunc THEN
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidCapW] = NIL THEN
                                                                    SemErr( err._MissingCapW );
                                                                  END;
                                                                ELSE
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidLowW] = NIL THEN
                                                                    SemErr( err._MissingLowW );
                                                                  END;
                                                                END;
                                                              END; .)
  rpar
.

ntEmbeddedDEBUGGED<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
  = "DEBUGGED"                                             (. D^.r.EP := DOM.epDEBUGGED; 
                                                              D^.T := Types.TBOOLEAN; .)
    lpar rpar
.

ntEmbeddedDECINCFunc<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression;
                                                              LVI : DOM.TValueInfo; .)
  = 
  ( "DEC"                                                  (. D^.r.EP := DOM.epDECFunc; .)
  | "INC"                                                  (. D^.r.EP := DOM.epINCFunc; .)
  )
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := E^.T;
                                                              IF D^.T = NIL THEN // error
                                                                c^.SemErr( err._ExpectedOrdinalStorageOrPointerType );
                                                              ELSIF D^.T^.Unwrap()^.TypeKind = DOM.tkReference THEN // OK
                                                              ELSIF Types.TOrdinal^.Compatible( DOM.cmAssign, D^.T ) THEN // OK
                                                              ELSIF Types.TStorage^.Compatible( DOM.cmAssign, D^.T ) THEN // OK
                                                              ELSIF Types.TPTR^.Compatible( DOM.cmAssign, D^.T ) THEN // OK
                                                              ELSE
                                                                c^.SemErr( err._ExpectedOrdinalStorageOrPointerType );
                                                              END; .)
    [
      comma ntCommonExpression<VR, E, LVI>                 (. D^.r.U2 := E;
                                                              c^.ExpectType( Types.TOrdinalNumber, E^.T, -1 );
                                                              IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END; .)
    ]
  rpar
.

ntEmbeddedEMIT<VAR D : DOM.TPDesignator>
  =                                                          (. D^.r.EP := DOM.epEMIT; .)
  ( "EMITA"                                                  (. D^.T := Types.TBString; .)
  | "EMITW"                                                  (. D^.T := Types.TWString; .)
  | "EMIT"                                                   (. IF DOM.eoWCHAR IN c^.CurE^.Options THEN
                                                                  D^.T := Types.TTStringW;
                                                                ELSE
                                                                  D^.T := Types.TTStringB;
                                                                END; .)
  )
  lpar
    ( // ntConstantExpression<E, VI>                          (. D^.r.D1 := 0;
      //                                                         D^.r.U1 := E;
      //                                                         c^.ExpectType( Types.TString, E^.T, NIL, NIL, FALSE, L"Expected string expression" );
      //                                                         D^.T := E^.T; .)
      "%line"                                              (. D^.r.D1 := 1;
                                                              D^.r.D2 := t.Line;
                                                              D^.T := Types.TOrdinalNumber; .)
    | "%smodule"                                           (. D^.r.D1 := 2;
                                                              D^.r.U1 := c; .)
    | "%lmodule"                                           (. D^.r.D1 := 3;
                                                              D^.r.U1 := c; .)
    | "%sprocedure"                                        (. D^.r.D1 := 4;
                                                              D^.r.U1 := c^.CurrentP(); .)
    | "%class"                                             (. D^.r.D1 := 5;
                                                              D^.r.U1 := c^.CurrentC(); .)
    | "%lprocedure"                                        (. D^.r.D1 := 6;
                                                              D^.r.U1 := c^.CurrentP(); .)
    | "%entry"                                             (. D^.r.D1 := 7;
                                                              D^.r.U1 := c^.CurrentP();
                                                              D^.r.D2 := t.Line; .)
    | "%exit"                                              (. D^.r.D1 := 8;
                                                              D^.r.U1 := c^.CurrentP();
                                                              D^.r.D2 := t.Line; .)
    | "%library"                                           (. D^.r.D1 := 9; .)
    | "%dll"                                               (. D^.r.D1 := 10; .)
    | "%exe"                                               (. D^.r.D1 := 11; .)
    )
  rpar
.

ntEmbeddedEQUALS<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. BW : TRISTATE;
                                                              E : DOM.TPExpression;
                                                              LVI : DOM.TValueInfo; .)
  =                                                        (. IF vrConst IN VR THEN
                                                                SemErrS( err._IsNotConst, L'EQUALS' );  
                                                              END; .)
  "EQUALS"                                                 (. D^.r.EP := DOM.epEQUALS; .)
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := E^.T;
                                                              IF NOT c^.ExpectType( Types.TString, E^.T, -1 ) THEN
                                                                BW := -1;
                                                              ELSIF Types.TBString^.Compatible( DOM.cmOperation, E^.T ) THEN
                                                                BW := 0;
                                                              ELSE
                                                                BW := 1;
                                                              END; .)
    comma
    ntCommonExpression<VR, E, LVI>                         (. D^.r.U2 := E;
                                                              CASE BW OF
                                                              | -1 : c^.ExpectType( Types.TString, E^.T, -1 );
                                                              |  0 : c^.ExpectType( Types.TBString, E^.T, -1 );
                                                              |  1 : c^.ExpectType( Types.TWString, E^.T, -1 );
                                                              END;
                                                              D^.T := Types.TBOOLEAN;
                                                              IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END; .)
  rpar
.

ntEmbeddedODDEVEN<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  = 
  ( "ODD"                                                  (. D^.r.EP := DOM.epODD; .)
  | "EVEN"                                                 (. D^.r.EP := DOM.epEVEN; .)
  )
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := Types.TBOOLEAN;
                                                              c^.ExpectType( Types.TOrdinal, E^.T, -1 ); .)
  rpar
.

ntEmbeddedFIELDOFS<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. FId : DOM.TPSymbol;
                                                              TId : DOM.TPSymbol; .)
  = 
  "FIELDOFS"                                               (. D^.r.EP := DOM.epFIELDOFS; .)
  lpar
    ntIdCheck<DOM.skUnknown, FALSE, TRUE, TId, FId>        (. CASE TId^.SymbolKind OF
                                                              | DOM.skClass, DOM.skType :
                                                              ELSE
                                                                SemErr( err._RecordOrClassTypeExpected );
                                                              END;
                                                              D^.r.U1 := TId;
                                                              D^.T := Types.TCARDINAL;
                                                              CASE DOM.TPType( TId )^.Unwrap()^.TypeKind OF
                                                              | DOM.tkRecord :
                                                                c^.EnterSymbols( DOM.TPRecord( TId )^.S, FALSE, FALSE, NIL );
                                                              | DOM.tkClass :
                                                                c^.EnterSymbols( DOM.TPClass( TId )^.S, FALSE, FALSE, NIL );
                                                              ELSE
                                                                SemErr( err._RecordOrClassTypeExpected );
                                                              END; .)
    WEAK period ntFieldIdentifier<FId>                     (. D^.r.U2 := FId;
                                                              CASE DOM.TPType( TId )^.Unwrap()^.TypeKind OF
                                                              | DOM.tkRecord, DOM.tkClass :
                                                                c^.LeaveSymbols( FALSE );
                                                              END; .)
  rpar
.

ntEmbeddedFRAC<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  = 
  "FRAC"                                                   (. D^.r.EP := DOM.epFRAC; .)
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              IF E^.T = Types.TFloat THEN
                                                                D^.T := Types.TLONGREAL;
                                                              ELSE
                                                                D^.T := E^.T;
                                                                c^.ExpectType( Types.TFloat, E^.T, -1 );
                                                              END; .)
  rpar
.

ntEmbeddedHIGH<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. LD : DOM.TPDesignator; .)
  = 
  "HIGH"                                                   (. D^.r.EP := DOM.epHIGH; .)
  lpar                                                     (. NEW( LD ); .)
    ntVariableDesignator<VR, LD, VI>                       (. D^.r.U1 := LD;
                                                              D^.T := Types.TOrdinalNumber;
                                                              IF LD^.T = NIL THEN
                                                                SemErr( err._ExpectedARRAYParameter );
                                                              ELSE
                                                                CASE LD^.T^.Unwrap()^.TypeKind OF
                                                                | DOM.tkArray, DOM.tkStringArray : // OK
                                                                | DOM.tkOpenArray :
                                                                  IF NOT( DOM.coOASize IN LD^.T^.Options ) THEN
                                                                    SemErr( err._HIGHUnusableForOASizeOff );
                                                                  END;
                                                                ELSE
                                                                  SemErr( err._ExpectedARRAYParameter );
                                                                END;
                                                              END; .)
  rpar
.

ntEmbeddedINSIDE<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  =                                                        (. IF vrConst IN VR THEN
                                                                SemErrS( err._IsNotConst, L'INSIDE' );  
                                                              END; .)
  "INSIDE"                                                 (. D^.r.EP := DOM.epINSIDE;
                                                              D^.T := Types.TBOOLEAN; .)
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              c^.ExpectType( Types.TOrdinalNumber, E^.T, -1 ); .)
    comma
    ntCommonExpression<VR, E, VI>                          (. D^.r.U2 := E;
                                                              c^.ExpectType( Types.TString, E^.T, -1 ); .)
  rpar
.

ntEmbeddedLENGTH<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  =                                                        (. IF vrConst IN VR THEN
                                                                SemErrS( err._IsNotConst, L'LENGTH' );  
                                                              END; .)
  ( "LENGTH"                                               (. D^.r.EP := DOM.epLENGTH; .)
  | "LENGTHsz"                                             (. D^.r.EP := DOM.epLENGTHsz; .)
  )                                                        (. D^.T := Types.TCARDINAL; .)
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              IF D^.r.EP = DOM.epLENGTH THEN
                                                                c^.ExpectType( Types.TString, E^.T, -1 );
                                                              ELSIF Types.TpBCHAR^.Compatible( DOM.cmAssign, E^.T ) THEN // OK
                                                              ELSIF Types.TpWCHAR^.Compatible( DOM.cmAssign, E^.T ) THEN // OK
                                                              ELSE
                                                                SemErr( err._ExpectedPointerToChar );
                                                              END; .)
  rpar
.

ntEmbeddedMINMAX<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. T : DOM.TPType; .)
  = 
  ( "MIN"                                                  (. D^.r.EP := DOM.epMINf; .)
  | "MAX"                                                  (. D^.r.EP := DOM.epMAXf; .)
  )
  lpar
    ntTypeId<T>                                            (. D^.r.U1 := T;
                                                              IF Types.TOrdinal^.Compatible( DOM.cmOperation, T ) THEN
                                                                D^.T := Types.TOrdinalNumber;
                                                                INC( D^.r.EP );
                                                              ELSIF Types.TREAL^.Compatible( DOM.cmOperation, T ) THEN
                                                                D^.T := Types.TREAL;
                                                              ELSIF Types.TLONGREAL^.Compatible( DOM.cmOperation, T ) THEN
                                                                D^.T := Types.TLONGREAL;
                                                              ELSE
                                                                c^.SemErr( err._ExpectedNumberOrOrdinalValue );
                                                              END; .)
  rpar
.

ntEmbeddedMIN2MAX2<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression;
                                                              LVI : DOM.TValueInfo; .)
  = 
  ( "MIN2"                                                 (. D^.r.EP := DOM.epMIN2; .)
  | "MAX2"                                                 (. D^.r.EP := DOM.epMAX2; .)
  )
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := E^.T;
                                                              IF Types.TNumber^.Compatible( DOM.cmOperation, E^.T ) THEN
                                                                // OK
                                                              ELSIF Types.TOrdinal^.Compatible( DOM.cmOperation, E^.T ) THEN
                                                                // OK
                                                              ELSE
                                                                SemErr( err._ExpectedNumberOrOrdinalType );
                                                              END; .)
      comma
      ntCommonExpression<VR, E, LVI>                       (. D^.r.U2 := E;
                                                              c^.ExpectType( D^.T, E^.T, -1 );
                                                              IF LVI * visConst = DOM.TValueInfo{} THEN
                                                                VI := VI - visConst;
                                                              END; .)
  rpar
.

ntEmbeddedOA<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. // A : DOM.TPSAssignment := NEW( DOM.CSAssignment );
                                                              E : DOM.TPExpression;
                                                              T : DOM.TPType; .)
  =                                                        (. D^.r.DK := DOM.dkEmbeddedProcedure; .)
  ( WEAK "OA"                                              (. D^.r.EP := DOM.epOA; .)
  | WEAK "OAsz"                                            (. D^.r.EP := DOM.epOAsz; .)
  )                                                        
  lpar                                                     (. IF D^.r.EP = DOM.epOA THEN .)
    ntCommonExpression<vrsDefault, E, VI>                  (.   D^.r.U1 := E;
                                                                c^.ExpectType( Types.TCARDINAL, E^.T, -1 ); .)
    comma                                                  (. END; .)
    ntCommonExpression<vrsDefault, E, VI>                  (. D^.r.U2 := E;
                                                              T := E^.T^.Unwrap(); // reference
                                                              IF T^.TypeKind <> DOM.tkReference THEN
                                                                SemErr( err._ExpectedPointerExpression );
                                                                D^.T := Types.TUnknown;
                                                              ELSE
                                                                T := T^.T^.Unwrap(); // dereferenced
                                                                CASE T^.TypeKind OF
                                                                | DOM.tkArray, DOM.tkStringArray :
                                                                  D^.T := c^.GetOpenArrayFormalType( T^.T );
                                                                | DOM.tkOpenArray :
                                                                  D^.T := T;
                                                                ELSE
                                                                  D^.T := c^.GetOpenArrayFormalType( T );
                                                                END;
                                                              END;
                                                              // adjust viLValue for ADR( LValue )
                                                              IF NOT( DOM.viLValue IN VI ) AND ( E^.N^.r.N = DOM.enDesignator ) THEN // variable, cast, call
                                                                WITH E^.N^.r DO
                                                                  IF ( V^.r.DK = DOM.dkEmbeddedProcedure ) AND ( V^.r.EP = DOM.epADR ) THEN
                                                                    VI := VI + DOM.TPDesignator( V^.r.U1 )^.VI * DOM.TValueInfo{DOM.viLValue};
                                                                  END;
                                                                END; // WITH
                                                              END;
                                                              IF vrMarkAsInitialized IN VR THEN
                                                                D^.MarkAsInitializedAndCheckRO( c, TRUE, TRUE );
                                                              END;
                                                              IF ( vrsLValue * VR <> TValueReq{} ) AND NOT( DOM.viLValue IN VI ) THEN
                                                                SemErr( err._ExpectedLValue );
                                                              END; .)
  rpar
.

ntEmbeddedNEWFunc<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. Class : DOM.TPClass;
                                                              T : DOM.TPType;
                                                              ClassFlag : BOOLEAN; .)
  =                                                        (. VI := DOM.TValueInfo{}; .)
  "NEW"                                                    (. D^.r.EP := DOM.epNEWFunc;
                                                              D^.r.D1 := t.Line; .)
  lpar
    ntTypeId<T>                                            (. ClassFlag := T^.Unwrap()^.TypeKind = DOM.tkClass;
                                                              IF ClassFlag THEN
                                                                Class := DOM.TPClass( T^.Unwrap());
                                                              END;
                                                              IF c^.OD^.MEnv.MIID[DOM.miidAllocate] = NIL THEN
                                                                IF NOT ClassFlag OR NOT c^.CheckOverwrittenOperator( Class, DOM.opNEW, TRUE ) THEN
                                                                  SemErr( err._MissingALLOCATEForNEW );
                                                                END;
                                                              ELSIF ClassFlag THEN
                                                                c^.CheckOverwrittenOperator( Class, DOM.opNEW, TRUE );
                                                              END;
                                                              IF NOT ClassFlag THEN
                                                                // OK
                                                              ELSIF DOM.imInterface IN Class^.IM THEN
                                                                c^.SemErr( err._InstanceOfInterface );
                                                              ELSIF DOM.imAbstract IN Class^.IM THEN
                                                                c^.SemErr( err._InstanceOfAbstractClass );
                                                              END;
                                                              NEW( D^.T );
                                                              D^.T^.TypeKind := DOM.tkReference;
                                                              D^.T^.T := T;
                                                              c^.HandleAuxVariableRequest( D^.T, DOM.TPTPVariable( ADR( D^.r.U1 ))^ ); .)
  rpar
.

ntEmbeddedORD<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  = 
  "ORD"                                                    (. D^.r.EP := DOM.epORD; .)
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := Types.TOrdinalNumber;
                                                              c^.ExpectType( Types.TOrdinal, E^.T, -1 ); .)
  rpar
.

ntEmbeddedSIZE<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. LD : DOM.TPDesignator;
                                                              TOF : BOOLEAN; .) // TypeOnlyFlag
  = 
  "SIZE"                                                   (. D^.r.EP := DOM.epSIZE;
                                                              D^.T := Types.TOrdinalNumber;
                                                              INC( c^.DCount );
                                                              NEW( LD ); .)
  lpar
    ntEntireDesignator<VR + TValueReq{vrAllowSingleType}, LD, OUT VI> 
                                                           (. TOF := ( LD^.r.DK = DOM.dkType ) AND ( LD^.r.TC = NIL ); .)
    ntNonLRecursiveDesignator<VR + TValueReq{vrAllowSingleType}, LD, VI>
                                                           (. DEC( c^.DCount );
                                                              IF c^.DCount = 0 THEN
                                                                EnableErrors();
                                                              END;
                                                              D^.r.U1 := LD;
                                                              IF NOT( DOM.viLValue IN VI ) AND ( LD^.r.DK <> DOM.dkType ) THEN
                                                                SemErr( err._ExpectedLValueOrSingleType );
                                                              END;
                                                              IF ( vrConst IN VR ) AND ( LD^.T^.OccupiedMemory() = 0 ) THEN
                                                                SemErr( err._UnableToObtainTypeSize );
                                                              END; .)
  rpar
.

ntEmbeddedTRUNC<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  = 
  "TRUNC"                                                  (. D^.r.EP := DOM.epTRUNC; .)
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := Types.TINTEGER;
                                                              c^.ExpectType( Types.TNumber, E^.T, -1 ); .)
  rpar
.

ntEmbeddedVAL<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  = 
  ( "VAL" | "CAST" )                                       (. D^.r.EP := DOM.epVAL; .)
  lpar
    ntTypeId<D^.T>
    comma ntCommonExpression<VR, E, VI>                    (. D^.r.U1 := E;
                                                              c^.ExpectType( Types.TOrdinalNumber, E^.T, -1 ); .)
  rpar
.

ntEmbeddedSWAPs<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  =
  ( "SWAP"                                                 (. D^.r.EP := DOM.epSWAP; .)
  | "REVERSE"                                              (. D^.r.EP := DOM.epSWAPBytes; .)
  )
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := E^.T;
                                                              IF Types.TStorage^.Compatible( DOM.cmOperation, D^.T ) OR
                                                                 Types.TOrdinal^.Compatible( DOM.cmOperation, D^.T ) OR
                                                                 Types.TPTR^.Compatible( DOM.cmOperation, D^.T ) THEN
                                                                // OK, they are swappable
                                                              ELSE
                                                                c^.SemErr( err._ExpectedOrdinalStorageOrPointerType );
                                                              END; .)
  rpar
.

ntEmbeddedLOHIBs<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  =
  ( "LOBYTE"                                               (. D^.r.EP := DOM.epLOBYTE; .)
  | "HIBYTE"                                               (. D^.r.EP := DOM.epHIBYTE; .)
  )
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := Types.TBYTE;
                                                              c^.ExpectType( Types.TWORD, E^.T, -1 ); .)
  rpar
.

ntEmbeddedLOHIWs<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  =
  ( "LOWORD"                                               (. D^.r.EP := DOM.epLOWORD; .)
  | "HIWORD"                                               (. D^.r.EP := DOM.epHIWORD; .)
  )
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := Types.TWORD;
                                                              c^.ExpectType( Types.TLONGWORD, E^.T, -1 ); .)
  rpar
.

ntEmbeddedLOHILWs<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  =
  ( "LOLONGWORD"                                           (. D^.r.EP := DOM.epLOLONGWORD; .)
  | "HILONGWORD"                                           (. D^.r.EP := DOM.epHILONGWORD; .)
  )
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := Types.TLONGWORD;
                                                              c^.ExpectType( Types.TQUADWORD, E^.T, -1 ); .)
  rpar
.

ntEmbeddedLOHIPTRs<VR : TValueReq; VAR D : DOM.TPDesignator; VAR VI : DOM.TValueInfo>
                                                           (. E : DOM.TPExpression; .)
  =
  ( "LOPTRLONGWORD"                                        (. D^.r.EP := DOM.epLOPTR; .)
  | "HIPTRLONGWORD"                                        (. D^.r.EP := DOM.epHIPTR; .)
  )
  lpar
    ntCommonExpression<VR, E, VI>                          (. D^.r.U1 := E;
                                                              D^.T := Types.TLONGWORD;
                                                              c^.ExpectType( Types.TPTR, E^.T, -1 ); .)
  rpar
.

ntEmbeddedProcedure<VAR D : DOM.TPDesignator>
  =                                                        (. D^.T := Types.TUnknown;
                                                              D^.r.DK := DOM.dkEmbeddedProcedure; .)
  ( ntEmbeddedASSERT<D>
  | ntEmbeddedASSERTLOG<D>
  | ntEmbeddedASSIGN<D>
  | ntEmbeddedCAPLOWProc<D>
  | ntEmbeddedDECINCProc<D>
  | ntEmbeddedDISPOSEProc<D>
  // | ntEmbeddedEMIT<D>
  | ntEmbeddedEXCLINCL<D>
  // | ntEmbeddedNEWProc<D> -- handled directly in ntVariableDesignator
  | ntEmbeddedLeakINFO<D>
  | ntEmbeddedLeakALLOCATE<D>
  | ntEmbeddedLeakREALLOCATE<D>
  | ntEmbeddedLeakDEALLOCATE<D>
  | ntEmbeddedLeakSWITCH<D>
  )
.

ntEmbeddedASSERT<VAR D : DOM.TPDesignator>                 (. E : DOM.TPExpression; .)
  = "ASSERT"                                               (. D^.r.EP := DOM.epASSERT;
                                                              IF c^.OD^.MEnv.MIID[DOM.miidAssertion] = NIL THEN
                                                                SemErr( err._MissingAssertion );
                                                              END; .)
    lpar
      ntExpression<E>                                      (. D^.r.U1 := E;
                                                              D^.r.D1 := t.Line;
                                                              c^.ExpectType( Types.TBOOLEAN, E^.T, -1 ); .)
    rpar
.

ntEmbeddedASSERTLOG<VAR D : DOM.TPDesignator>              (. E : DOM.TPExpression; .)
  = "ASSERTLOG"                                            (. D^.r.EP := DOM.epASSERTLOG;
                                                              IF c^.OD^.MEnv.MIID[DOM.miidAssertion] = NIL THEN
                                                                SemErr( err._MissingAssertion );
                                                              END; .)
    lpar
      ntExpression<E>                                      (. D^.r.U1 := E;
                                                              D^.r.U2 := NIL;
                                                              D^.r.D1 := t.Line;
                                                              c^.ExpectType( Types.TBOOLEAN, E^.T, -1 ); .)
      [
        comma ntExpression<E>                              (. D^.r.U2 := E;
                                                              c^.ExpectType( Types.TString, E^.T, -1 ); .)
      ]
    rpar                                                   (. IF ( D^.r.U2 <> NIL ) AND Types.TBCHAR^.Compatible( DOM.cmOperation, DOM.TPExpression( D^.r.U2 )^.T ) THEN
                                                                IF c^.OD^.MEnv.MIID[DOM.miidLogAssertionA] = NIL THEN
                                                                  SemErr( err._MissingLogAssertionA );
                                                                END;
                                                              ELSE
                                                                IF c^.OD^.MEnv.MIID[DOM.miidLogAssertionW] = NIL THEN
                                                                  SemErr( err._MissingLogAssertionW );
                                                                END;
                                                              END; .)
.

ntEmbeddedASSIGN<VAR D : DOM.TPDesignator>                 (. E : DOM.TPExpression;
                                                              LD : DOM.TPDesignator := NEW( DOM.CDesignator );
                                                              VI : DOM.TValueInfo;
                                                              WFlag : TRISTATE := -1; .)
= ( "ASSIGN"                                               (. D^.r.EP := DOM.epASSIGN; .)
  | "ASSIGNsz"                                             (. D^.r.EP := DOM.epASSIGNsz; .)
  )
  lpar
    ( ntVariableDesignator<vrsInitREFValue, LD, VI> 
    | ntEmbeddedOA<vrsInitREFValue, LD, VI> )              (. IF Types.TBString^.Compatible( DOM.cmAssign, LD^.T ) THEN
                                                                WFlag := 0;
                                                              ELSIF Types.TWString^.Compatible( DOM.cmAssign, LD^.T ) THEN
                                                                WFlag := 1;
                                                              ELSE
                                                                c^.ExpectType( Types.TString, LD^.T, -1 );
                                                              END;
                                                              D^.r.U1 := LD; .)
    comma
    ntExpression<E>                                        (. D^.r.U2 := E;
                                                              IF D^.r.EP = DOM.epASSIGNsz THEN // parameter is pointer
                                                                CASE WFlag OF
                                                                | -1 : IF DOM.eoWCHAR IN c^.CurE^.Options THEN
                                                                         c^.ExpectType( Types.TpWCHAR, E^.T, -1 );
                                                                       ELSE
                                                                         c^.ExpectType( Types.TpBCHAR, E^.T, -1 );
                                                                       END;
                                                                | 0  : c^.ExpectType( Types.TpBCHAR, E^.T, -1 );
                                                                | 1  : c^.ExpectType( Types.TpWCHAR, E^.T, -1 );
                                                                END;
                                                              ELSE
                                                                CASE WFlag OF
                                                                | -1 : IF DOM.eoWCHAR IN c^.CurE^.Options THEN
                                                                         c^.ExpectType( Types.TTStringW, E^.T, -1 );
                                                                       ELSE
                                                                         c^.ExpectType( Types.TTStringB, E^.T, -1 );
                                                                       END;
                                                                | 0  : c^.ExpectType( Types.TBString, E^.T, -1 );
                                                                | 1  : c^.ExpectType( Types.TWString, E^.T, -1 );
                                                                END;
                                                              END; .)
  rpar
.

ntEmbeddedCAPLOWProc<VAR D : DOM.TPDesignator>             (. LD : DOM.TPDesignator;
                                                              VI : DOM.TValueInfo; .)
= ( "CAP"                                                  (. D^.r.EP := DOM.epCAP; .)
  | "LOW"                                                  (. D^.r.EP := DOM.epLOW; .)
  )
  lpar                                                     (. NEW( LD ); .)
    ( ntVariableDesignator<vrsLValue, LD, VI> 
    | ntEmbeddedOA<vrsLValue, LD, VI> )                    (. D^.r.U1 := LD;
                                                              D^.T := LD^.T;
                                                              c^.ExpectType( Types.TString, D^.T, -1 );
                                                              IF Types.TBCHAR^.Compatible( DOM.cmAssign, D^.T ) THEN
                                                                IF D^.r.EP = DOM.epCAP THEN
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidCapA] = NIL THEN
                                                                    SemErr( err._MissingCapA );
                                                                  END;
                                                                ELSE
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidLowA] = NIL THEN
                                                                    SemErr( err._MissingLowA );
                                                                  END;
                                                                END;
                                                              ELSE
                                                                IF D^.r.EP = DOM.epCAP THEN
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidCapW] = NIL THEN
                                                                    SemErr( err._MissingCapW );
                                                                  END;
                                                                ELSE
                                                                  IF c^.OD^.MEnv.MIID[DOM.miidLowW] = NIL THEN
                                                                    SemErr( err._MissingLowW );
                                                                  END;
                                                                END;
                                                              END; .)
  rpar
.

ntEmbeddedDECINCProc<VAR D : DOM.TPDesignator>             (. E : DOM.TPExpression;
                                                              LD : DOM.TPDesignator;
                                                              VI : DOM.TValueInfo; .)
= ( "DEC"                                                  (. D^.r.EP := DOM.epDEC; .)
  | "INC"                                                  (. D^.r.EP := DOM.epINC; .)
  )
  lpar                                                     (. NEW( LD ); .)
    ntVariableDesignator<vrsLValue, LD, VI>                (. D^.r.U1 := LD;
                                                              D^.T := LD^.T;
                                                              IF D^.T = NIL THEN // error
                                                                c^.SemErr( err._ExpectedOrdinalStorageOrPointerType );
                                                              ELSIF D^.T^.Unwrap()^.TypeKind = DOM.tkReference THEN // OK
                                                              ELSIF Types.TOrdinal^.Compatible( DOM.cmAssign, D^.T ) THEN // OK
                                                              ELSIF Types.TStorage^.Compatible( DOM.cmAssign, D^.T ) THEN // OK
                                                              ELSIF Types.TPTR^.Compatible( DOM.cmAssign, D^.T ) THEN // OK
                                                              ELSE
                                                                c^.SemErr( err._ExpectedOrdinalStorageOrPointerType );
                                                              END; .)
    [
      comma ntExpression<E>                                (. D^.r.U2 := E;
                                                              c^.ExpectType( Types.TOrdinalNumber, E^.T, -1 ); .)
    ]
  rpar
.

ntEmbeddedDISPOSEProc<VAR D : DOM.TPDesignator>            (. Class : DOM.TPClass;
                                                              LD : DOM.TPDesignator;
                                                              VI : DOM.TValueInfo;
                                                              ClassFlag : BOOLEAN; .)
= "DISPOSE"                                                (. D^.r.EP := DOM.epDISPOSE;
                                                              D^.r.D1 := t.Line; .)
  lpar                                                     (. NEW( LD ); .)
    ntVariableDesignator<vrsLValue, LD, VI>                (. ClassFlag := LD^.T^.UnwrapToBaseType()^.TypeKind = DOM.tkClass;
                                                              IF ClassFlag THEN
                                                                Class := DOM.TPClass( LD^.T^.UnwrapToBaseType());
                                                              END;
                                                              IF c^.OD^.MEnv.MIID[DOM.miidDeallocate] = NIL THEN
                                                                IF NOT ClassFlag OR NOT c^.CheckOverwrittenOperator( Class, DOM.opDISPOSE, TRUE ) THEN
                                                                  SemErr( err._MissingDEALLOCATEForDISPOSE );
                                                                END;
                                                              ELSIF ClassFlag THEN
                                                                c^.CheckOverwrittenOperator( Class, DOM.opDISPOSE, TRUE ); // to check if DISPOSE is accessible
                                                              END;
                                                              IF NOT ClassFlag THEN
                                                                // OK
                                                              ELSIF DOM.imInterface IN Class^.IM THEN
                                                                SemErr( err._UnableToDisposeInterface );
                                                              END;
                                                              D^.r.U1 := LD;
                                                              D^.T := LD^.T;
                                                              c^.ExpectType( Types.TADDRESS, D^.T, err._ExpectedPointerVariable ); .)
  rpar
.

ntEmbeddedEXCLINCL<VAR D : DOM.TPDesignator>               (. E : DOM.TPExpression;
                                                              LD : DOM.TPDesignator;
                                                              R : CARDINAL;
                                                              VI : DOM.TValueInfo; .)
= ( "INCL"                                                 (. D^.r.EP := DOM.epINCL32; .)
  | "EXCL"                                                 (. D^.r.EP := DOM.epEXCL32; .)
  )
  lpar                                                     (. NEW( LD ); .)
    ntVariableDesignator<vrsLValue, LD, VI>                (. D^.r.U1 := LD;
                                                              D^.T := LD^.T;
                                                              IF ( D^.T = NIL ) OR ( D^.T^.Unwrap()^.TypeKind <> DOM.tkSet ) THEN
                                                                SemErr( err._ExpectedSetType );
                                                              END;
                                                              R := DOM.TPArray( D^.T^.Unwrap())^.Count();
                                                              CASE R OF
                                                              | 1 : DEC( D^.r.EP, 2 );
                                                              | 2 : DEC( D^.r.EP );
                                                              | 3..4 : // OK
                                                              | 5..8 : INC( D^.r.EP );
                                                              ELSE
                                                                INC( D^.r.EP, 2 );
                                                              END; .)
    comma ntExpression<E>                                  (. D^.r.U2 := E;
                                                              c^.ExpectType( D^.T^.Unwrap()^.T, E^.T, err._ExpectedMemberOfTheSet ); .)
  rpar
.

ntEmbeddedNEWProc<VAR D : DOM.TPDesignator>                (. Class : DOM.TPClass;
                                                              LD : DOM.TPDesignator;
                                                              VI : DOM.TValueInfo;
                                                              ClassFlag : BOOLEAN; .)
= "NEW"                                                    (. D^.r.DK := DOM.dkEmbeddedProcedure;
                                                              D^.r.D1 := t.Line; .)
  lpar                                                     (. NEW( LD ); .)
    ntVariableDesignator<vrsInitREFValue + TValueReq{vrAllowSingleType}, LD, VI>
                                                           (. ClassFlag := LD^.T^.UnwrapToBaseType()^.TypeKind = DOM.tkClass;
                                                              IF ClassFlag THEN
                                                                Class := DOM.TPClass( LD^.T^.UnwrapToBaseType());
                                                              END;
                                                              IF c^.OD^.MEnv.MIID[DOM.miidAllocate] = NIL THEN
                                                                IF NOT ClassFlag OR NOT c^.CheckOverwrittenOperator( Class, DOM.opNEW, TRUE ) THEN
                                                                  SemErr( err._MissingALLOCATEForNEW );
                                                                END;
                                                              ELSIF ClassFlag THEN
                                                                c^.CheckOverwrittenOperator( Class, DOM.opNEW, TRUE );
                                                              END;
                                                              IF NOT ClassFlag THEN
                                                                // OK
                                                              ELSIF DOM.imInterface IN Class^.IM THEN
                                                                c^.SemErr( err._InstanceOfInterface );
                                                              ELSIF DOM.imAbstract IN Class^.IM THEN
                                                                c^.SemErr( err._InstanceOfAbstractClass );
                                                              END;
                                                              IF ( LD^.r.DK = DOM.dkType ) AND ( LD^.r.TC = NIL ) THEN // type only read
                                                                D^.r.EP := DOM.epNEWFunc;
                                                                NEW( D^.T );
                                                                D^.T^.TypeKind := DOM.tkReference;
                                                                D^.T^.T := LD^.T;
                                                                c^.HandleAuxVariableRequest( D^.T, DOM.TPTPVariable( ADR( D^.r.U1 ))^ );
                                                              ELSE // pointer designator read
                                                                D^.r.EP := DOM.epNEW;
                                                                D^.r.U1 := LD;
                                                                D^.T := LD^.T;
                                                              END;
                                                              c^.ExpectType( Types.TADDRESS, D^.T, err._ExpectedPointerVariableOrTypeName ); .)
  rpar
.

ntEmbeddedLeakINFO<VAR D : DOM.TPDesignator>
= ( "LeakINFOPush"                                         (. D^.r.EP := DOM.epLeakINFOPush; .)
  | "LeakINFOPop"                                          (. D^.r.EP := DOM.epLeakINFOPop; .)
  ) lpar rpar                                              (. D^.r.U1 := c;
                                                              D^.r.D1 := t.Line; .)
.

ntEmbeddedLeakALLOCATE<VAR D : DOM.TPDesignator>           (. E : DOM.TPExpression; .)
  = "LeakALLOCATE"                                         (. D^.r.EP := DOM.epLeakALLOCATE; .)
    lpar
      ntExpression<E>                                      (. D^.r.U1 := E;
                                                              c^.ExpectType( Types.TADDRESS, E^.T, -1 ); .)
      comma ntExpression<E>                                (. D^.r.U2 := E;
                                                              c^.ExpectType( Types.TSIZE, E^.T, -1 ); .)
    rpar
.

ntEmbeddedLeakREALLOCATE<VAR D : DOM.TPDesignator>         (. E : DOM.TPExpression; .)
  = "LeakREALLOCATE"                                       (. D^.r.EP := DOM.epLeakREALLOCATE; .)
    lpar
      ntExpression<E>                                      (. D^.r.U1 := E;
                                                              c^.ExpectType( Types.TADDRESS, E^.T, -1 ); .)
      comma ntExpression<E>                                (. D^.r.U2 := E;
                                                              c^.ExpectType( Types.TADDRESS, E^.T, -1 ); .)
      comma ntExpression<E>                                (. D^.r.D1 := E;
                                                              c^.ExpectType( Types.TSIZE, E^.T, -1 ); .)
    rpar
.

ntEmbeddedLeakDEALLOCATE<VAR D : DOM.TPDesignator>         (. E : DOM.TPExpression; .)
  = "LeakDEALLOCATE"                                       (. D^.r.EP := DOM.epLeakDEALLOCATE; .)
    lpar
      ntExpression<E>                                      (. D^.r.U1 := E;
                                                              c^.ExpectType( Types.TADDRESS, E^.T, -1 ); .)
    rpar
.

ntEmbeddedLeakSWITCH<VAR D : DOM.TPDesignator>
  =
  ( "LeakSTART"                                            (. D^.r.EP := DOM.epLeakSTART; .)
  | "LeakSTOP"                                             (. D^.r.EP := DOM.epLeakSTOP; .)
  | "LeakRESET"                                            (. D^.r.EP := DOM.epLeakRESET; .)
  )
    lpar rpar                                              
.

ntConstantLiteral<OrdinalRequest : BOOLEAN; VAR OK : DOM.TOrdinalKind; VAR DataType : DOM.TPType>
  =                                                        (. DataType := Types.TUnknown; .)
    ntOrdinalLiteral<Types.TAny, OK, DataType>
  | ntRealLiteral                                          (. DataType := Types.TFloat; .)
  | ntStringLiteral<DataType>
  | "NIL"                                                  (. DataType := Types.TADDRESS; .)
.

ntConstantExpression<VAR E : DOM.TPExpression>             (. VI : DOM.TValueInfo; .)
  = ntCommonExpression<vrsConst, E, VI>
.
  
ntConstantOrdinalExpression<VAR Expression : DOM.TPExpression>
  = ntOrdinalExpression<vrsConst, Expression>
.

ntActualParameters<P : DOM.TPProcedureCall; VR : TValueReq>
                                                           (. FT : DOM.TPFormalType;
                                                              S : stacks.CPtrStack; 
                                                              EmptyCall : BOOLEAN; .)
  =                                                        (. EmptyCall := TRUE;
                                                              c^.EnterUnit( P );
                                                              c^.EnterNewUnit( DOM.ukActualParameterList ); .)
    lpar
      [                                                    (. EmptyCall := FALSE; .)
        ntActualParameterList<P, S, VR>
      ]
    WEAK rpar                                              (. IF EmptyCall AND ( P^.P <> NIL ) AND P^.P^.GetFirstFormalType( REF S, OUT FT ) THEN
                                                                SemErr( err._TooFewParametersInACall );
                                                              END;
                                                              c^.LeaveUnit();
                                                              c^.LeaveUnit(); .)
.
  
ntActualParameterList<P : DOM.TPProcedureCall; VAR S : stacks.CPtrStack; VR : TValueReq>
                                                           (. Count : CARDINAL := 1;
                                                              FormalType : DOM.TPFormalType;
                                                              PC : DOM.TPParameterContainer;
                                                              ErrorTooManyReported, VarArg : BOOLEAN := FALSE; .)
  =                                                        (. IF ( P^.P = NIL ) OR NOT P^.P^.GetFirstFormalType( REF S, OUT FormalType ) THEN
                                                                VarArg := ( P^.P <> NIL ) AND ( DOM.coVarArg IN P^.P^.Options );
                                                                FormalType := NIL;
                                                                IF NOT VarArg THEN
                                                                  SemErr( err._TooManyParametersInACall );
                                                                  ErrorTooManyReported := TRUE;
                                                                END;  
                                                              END;
                                                              NEW( PC );
                                                              c^.AddUnit( PC );
                                                              IF FormalType = NIL THEN
                                                                PC^.PT := Types.TFormalUnknown;
                                                              ELSE
                                                                PC^.PT := FormalType;
                                                              END;
                                                              c^.EnterUnit( PC ); .)
    ntActualParameter<Count, PC, VarArg>                   (. c^.LeaveUnit();
                                                              INC( Count );
                                                              IF ( FormalType <> NIL ) AND NOT P^.P^.GetNextFormalType( REF S, OUT FormalType ) THEN
                                                                FormalType := NIL;
                                                              END; .)
  {                                                        (. NEW( PC );
                                                              c^.AddUnit( PC );
                                                              IF FormalType = NIL THEN
                                                                PC^.PT := Types.TFormalUnknown;
                                                              ELSE
                                                                PC^.PT := FormalType;
                                                              END;
                                                              c^.EnterUnit( PC ); .)
    WEAK comma ntActualParameter<Count, PC, VarArg>        (. c^.LeaveUnit();
                                                              INC( Count );
                                                              IF FormalType = NIL THEN
                                                                IF NOT VarArg AND NOT ErrorTooManyReported THEN
                                                                  SemErr( err._TooManyParametersInACall );
                                                                  ErrorTooManyReported := TRUE;
                                                                END;
                                                              ELSIF NOT P^.P^.GetNextFormalType( REF S, OUT FormalType ) THEN
                                                                VarArg := DOM.coVarArg IN P^.P^.Options;
                                                                FormalType := NIL;
                                                              END; .)
  }                                                        (. IF FormalType <> NIL THEN
                                                                SemErr( err._TooFewParametersInACall );
                                                              END; .)
.
  
ntActualParameter<Count : CARDINAL; PC : DOM.TPParameterContainer; VarArg : BOOLEAN>
                                                           (. D : DOM.TPDesignator;
                                                              E : DOM.TPExpression;
                                                              PTUW : DOM.TPType;
                                                              TM : DOM.TTypeModifier := DOM.tmUnknown;
                                                              VI : DOM.TValueInfo;
                                                              VR : TValueReq := vrsInitREFValue;
                                                              CONSTAllowedFlag : BOOLEAN := FALSE;
                                                              LVREQ : BOOLEAN;
                                                              OAConstructorFlag : BOOLEAN := FALSE; .)
  =                                                        (. PC^.AT := Types.TUnknown;
                                                              PTUW := PC^.PT^.Unwrap();
                                                              IF PC^.PT = Types.TFormalUnknown THEN
                                                                LVREQ := FALSE;
                                                              ELSIF PC^.PT^.TypeModifier = DOM.tmUnknown THEN 
                                                                LVREQ := FALSE;
                                                              ELSIF PC^.PT^.TypeModifier = DOM.tmCONST THEN // CONST Id
                                                                CONSTAllowedFlag := TRUE;
                                                                LVREQ := PTUW^.PrimitiveType = DOM.ptStructure;
                                                                LVREQ := FALSE; (*?*) // ptStructure typy maji vzdy pomocnou konstantu, takze splnuji podminku LVREQ ??
                                                              ELSE
                                                                LVREQ := TRUE;
                                                              END;
                                                              IF NOT CONSTAllowedFlag THEN
                                                                IF ( PTUW^.TypeKind = DOM.tkReference ) AND PTUW^.T^.IsFormal() AND
                                                                   ( DOM.TPFormalType( PTUW^.T )^.TypeModifier = DOM.tmCONST ) THEN // POINTER TO CONST Id
                                                                  CONSTAllowedFlag := TRUE;
                                                                ELSIF ( PTUW = Types.TADDRESS ) OR // ADDRESS := PTR is possible even if PTR is CONST
                                                                      ( PTUW^.TypeKind <> DOM.tkReference ) AND
                                                                      ( PC^.PT^.TypeModifier = DOM.tmUnknown ) THEN 
                                                                  CONSTAllowedFlag := TRUE;
                                                                END;
                                                              END; .)
  [ 
    "VAR"                                                  (. TM := DOM.tmVAR; .)
  | "REF"                                                  (. TM := DOM.tmREF;
                                                              EXCL( VR, vrMarkAsInitialized ); .)
  | "OUT"                                                  (. TM := DOM.tmOUT; .)
  ]                                                        
  (
    IF( NOT LVREQ AND (( PC^.PT = Types.TUnknown ) OR ( TM = DOM.tmUnknown )) )   
      ntCommonExpression<vrsDefault, E, VI>                (. PC^.CU := E;
                                                              PC^.AT := E^.T;
                                                              IF E^.N^.r.N = DOM.enDesignator THEN // variable, cast, call
                                                                WITH E^.N^.r.V^ DO
                                                                  CASE r.DK OF
                                                                  | DOM.dkType :
                                                                    // passing expression casted to open array component type must be generated using AuxVariable
                                                                    IF r.TC^.Cast AND PC^.PT^.IsOpenArray() THEN
                                                                      c^.HandleAuxVariableRequest( E^.T, PC^.CV );
                                                                    END;
                                                                    r.TC^.MarkAsInitializedAndCheckRO( c, TRUE, FALSE );
                                                                  | DOM.dkId : // do nothing
                                                                  | DOM.dkEmbeddedProcedure :
                                                                    IF r.EP = DOM.epADR THEN
                                                                      DOM.TPDesignator( r.U1 )^.MarkAsInitializedAndCheckRO( c, TRUE, FALSE );
                                                                    END;
                                                                  ELSE // any operator or call
                                                                    // passing expression casted to open array component type must be generated using AuxVariable
                                                                    IF ( DOM.TValueInfo{DOM.viLValue} * E^.VI = DOM.TValueInfo{} ) AND PC^.PT^.IsOpenArray() THEN
                                                                      c^.HandleAuxVariableRequest( E^.T, PC^.CV );
                                                                    END;
                                                                  END; // CASE
                                                                END; // WITH
                                                              END; .)
  |                                                        (. NEW( D ); .)
    ntVariableDesignator<VR, D, VI>                        (. PC^.CU := D;
                                                              PC^.AT := D^.T; .)
  |                                                        (. NEW( D ); .)
    ntEmbeddedOA<VR, D, VI>                                (. PC^.CU := D;
                                                              PC^.AT := D^.T;
                                                              OAConstructorFlag := DOM.viLValue IN VI; .)
  )                                                        (. IF LVREQ THEN
                                                                IF NOT( DOM.viLValue IN VI ) THEN
                                                                  CASE PC^.PT^.TypeModifier OF
                                                                  | DOM.tmVAR, DOM.tmREF, DOM.tmOUT, DOM.tmCONST :
                                                                    // duplicite to normal Expected L-Value
                                                                    SemErr( err._ExpectedParameterLValue );
                                                                  END;
                                                                END;
                                                                CASE PC^.PT^.TypeModifier OF
                                                                | DOM.tmREF :
                                                                  IF TM <> DOM.tmREF THEN
                                                                    SemErr( err._ExpectedREF );
                                                                  END;
                                                                | DOM.tmOUT :
                                                                  IF TM <> DOM.tmOUT THEN
                                                                    SemErr( err._ExpectedOUT );
                                                                  END;
                                                                END; // CASE
                                                              ELSE
                                                                CASE TM OF
                                                                | DOM.tmREF, DOM.tmOUT, DOM.tmVAR :
                                                                  SemErr( err._NotExpectedVARREFOUT );
                                                                END; // CASE
                                                              END;
                                                              IF NOT VarArg THEN
                                                                c^.ExpectType( PC^.PT, PC^.AT, -1 );
                                                                IF NOT CONSTAllowedFlag AND ( DOM.viCONST IN VI ) THEN
                                                                  SemErr( err._UnableToPassCONSTIntoReference );
                                                                END;
                                                                IF PC^.PT^.IsOpenArray() AND PC^.AT^.IsFormal() THEN // passing not OA parameter into OA parameter is always OK
                                                                  IF OAConstructorFlag THEN
                                                                    // OK, constructed LValue
                                                                  ELSIF PC^.PT^.TypeModifier = DOM.tmUnknown THEN
                                                                    // OK, OA can always be passed as value, pass down
                                                                  ELSIF PC^.PT^.TypeModifier = DOM.tmCONST THEN
                                                                    // OK, OA can always be passed as value to CONST, pass down
                                                                  ELSIF DOM.TPFormalType( PC^.AT )^.TypeModifier = DOM.tmUnknown THEN
                                                                    // value OA array cannot be passed into VAR/REF/OUT parameter
                                                                    SemErr( err._UnableToPassValueOAIntoReference );
                                                                  END;
                                                                END;
                                                              END; .)
.

/* =========literals */

ntOrdinalLiteral<RequiredType : DOM.TPType; VAR OK : DOM.TOrdinalKind; VAR DataType : DOM.TPType>
  =                                                        (. DataType := Types.TUnknown;
                                                              OK := DOM.okUnknown; .)
  ( 
    ordinal                                                (. OK := DOM.okDecimal;
                                                              DataType := Types.TOrdinalNumber; .)
  | character                                              (. OK := DOM.okCharacter;
                                                              IF DOM.eoWCHAR IN c^.CurE^.Options THEN
                                                                DataType := Types.TTCHARW;
                                                              ELSE
                                                                DataType := Types.TTCHARB;
                                                              END; .)
  | bytecharacter                                          (. OK := DOM.okCharacter;
                                                              DataType := Types.TBCHAR; .)
  | wordcharacter                                          (. OK := DOM.okCharacter;
                                                              DataType := Types.TWCHAR; .)
  | hexadecimal                                            (. OK := DOM.okHexadecimal;
                                                              DataType := Types.TOrdinalNumber; .)
  | octal                                                  (. OK := DOM.okOctal;
                                                              DataType := Types.TOrdinalNumber; .)
  | binary                                                 (. OK := DOM.okBinary;
                                                              DataType := Types.TOrdinalNumber; .)
  | "FALSE"                                                (. DataType := Types.TBOOLEAN; .)
  | "TRUE"                                                 (. DataType := Types.TBOOLEAN; .)
  )                                                        (. IF RequiredType <> NIL THEN
                                                                c^.ExpectType( RequiredType, DataType, -1 );
                                                              END; .)
.

ntRealLiteral
  = real
.
  
ntStringLiteral<VAR DataType : DOM.TPType>
  =                                                        (. DataType := Types.TUnknown; .)
    string                                                 (. IF DOM.eoWCHAR IN c^.CurE^.Options THEN
                                                                IF t.Val.Length <= 3 THEN
                                                                  DataType := Types.TTCHARW;
                                                                ELSE
                                                                  DataType := Types.TTStringW;
                                                                END;
                                                              ELSE
                                                                IF t.Val.Length <= 3 THEN
                                                                  DataType := Types.TTCHARB;
                                                                ELSE
                                                                  DataType := Types.TTStringB;
                                                                END;
                                                              END; .)
  | bytestring                                             (. IF t.Val.Length <= 4 THEN
                                                                DataType := Types.TBCHAR;
                                                              ELSE
                                                                DataType := Types.TBString;
                                                              END; .)
  | wordstring                                             (. IF t.Val.Length <= 4 THEN
                                                                DataType := Types.TWCHAR;
                                                              ELSE
                                                                DataType := Types.TWString;
                                                              END; .)
.

/* =========identifiers */

ntFunctionResultType<VAR RequestedReturnType : DOM.TPType> // !C.2.4.2
  = ntTypeId<RequestedReturnType>
.

ntIdList<IdAction : TIdAction; SymbolKind : DOM.TSymbolKind>
                                                           (. Id : DOM.TPSymbol; .)
  = ntId<IdAction, SymbolKind, Id, FALSE>                  (. IF Id <> NIL THEN
                                                                c^.AddUnit( Id );
                                                              END; .)
    {
      WEAK comma ntId<IdAction, SymbolKind, Id, FALSE>     (. IF Id <> NIL THEN
                                                                c^.AddUnit( Id );
                                                              END; .)
    }
.

ntImportModuleIdList                                       (. M : DOM.TPModule; .)
  = ntImportModuleId<iaCreateIfNotExists, M>
    {
      WEAK comma
      ntImportModuleId<iaCreateIfNotExists, M>
    }
.

ntImportModuleId<IdAction : TIdAction; VAR Module : DOM.TPModule>
                                                           (. Id : DOM.TPSymbol; .)
  = ntId<IdAction, DOM.skModule, Id, TRUE>                 (. Module := DOM.TPModule( Id );
                                                              Module^.OD := Project.ImportModule( c, Module^.N, TRUE );
                                                              Module^.CU := Module^.OD;
                                                              IF NOT Module^.InList THEN // add the same module only if it is not added somewhere yet
                                                                c^.AddUnit( Module );
                                                              END;
                                                              IF DOM.coDependsOnNewerDEF IN c^.Options THEN
                                                                // already set
                                                              ELSIF ( DOM.coDependsOnNewerDEF IN Module^.OD^.Options ) OR
                                                                    ( INT64( Module^.OD^.MEnv.Timestamp ) > INT64( c^.MEnv.Timestamp )) THEN
                                                                // I'm importing DEF, which is newer than me
                                                                IF c^.Emit THEN
                                                                  INCL( c^.Options, DOM.coDependsOnNewerDEF );
                                                                ELSIF c^.UnitKind <> DOM.ukDefinition THEN // AND NOT( DOM.coSolveTimestamps IN c^.Options )
                                                                  c^.WarningCS( wrn._ImportedModuleIsNewer, Module^.N );
                                                                END;
                                                              END; .)
.

ntVariableIdList<SK : DOM.TSymbolKind; VAR VarDecl : DOM.TPVarDeclContainer> // !C.2.8
                                                           (. Variable : DOM.TPSymbol; .)
  =                                                        (. NEW( VarDecl ); .)
    ntVariableId<iaCreate, SK, Variable>                   (. VarDecl^.Add( Variable ); .)
    {
      WEAK comma ntVariableId<iaCreate, SK, Variable>      (. VarDecl^.Add( Variable ); .)
    }
.

ntLabelId<IdAction : TIdAction; VAR Label : DOM.TPLabel>   (. Id : DOM.TPSymbol; .)
  = ntId<IdAction, DOM.skLabel, Id, FALSE>                 (. Label := DOM.TPLabel( Id ); .)
.

ntConstantId<IdAction : TIdAction; VAR Constant : DOM.TPConstant>
                                                           (. Id : DOM.TPSymbol; .)
  = ntId<IdAction, DOM.skConstant, Id, FALSE>              (. Constant := DOM.TPConstant( Id ); .)
.

ntTypeId<VAR IdType : DOM.TPType> // !C.3.2
  =                                                        (. IdType := Types.TUnknown; .)
  (                              
    ntOrdinalBaseType<IdType>
  | ntNonOrdinalBaseType<IdType>
  | ntPointerBaseType<IdType>
  | ntExistingTypeId<iaCheck, IdType>
  | ntPointerType<IdType, FALSE>                           (. c^.ForwardOpaqueType( IdType );
                                                              c^.ForwardComplexType( IdType ); .)
  )
.

ntExistingTypeId<IdAction : TIdAction; VAR IdType : DOM.TPType> // !C.3.2
                                                           (. Id : DOM.TPSymbol; .)
  = ntQualifiedId<IdAction, Id, TRUE, FALSE>               (. IF Id <> NIL THEN
                                                                IdType := c^.IdToType( Id );
                                                              END; .)
.

ntOrdinalBaseType<VAR IdType : DOM.TPType>
  = "INT8"                                                 (. IdType := Types.TINT8; .)
  | "INT16"                                                (. IdType := Types.TINT16; .)
  | "INT32"                                                (. IdType := Types.TINT32; .)
  | "INT64"                                                (. IdType := Types.TINT64; .)
  | "SHORTINT"                                             (. IdType := Types.TSHORTINT; .)
  | "INTEGER"                                              (. IdType := Types.TINTEGER; .)
  | "LONGINT"                                              (. IdType := Types.TLONGINT; .)
  | "CARD8"                                                (. IdType := Types.TCARD8; .)
  | "CARD16"                                               (. IdType := Types.TCARD16; .)
  | "CARD32"                                               (. IdType := Types.TCARD32; .)
  | "CARD64"                                               (. IdType := Types.TCARD64; .)
  | "SHORTCARD"                                            (. IdType := Types.TSHORTCARD; .)
  | "CARDINAL"                                             (. IdType := Types.TCARDINAL; .)
  | "LONGCARD"                                             (. IdType := Types.TLONGCARD; .)
  | "WCHAR"                                                (. IdType := Types.TWCHAR; .)
  | "CHAR"                                                 (. IdType := Types.TBCHAR; .)
  | "BCHAR"                                                (. IdType := Types.TBCHAR; .)
  | "TCHAR"                                                (. IF DOM.eoWCHAR IN c^.CurE^.Options THEN
                                                                IdType := Types.TTCHARW;
                                                              ELSE
                                                                IdType := Types.TTCHARB;
                                                              END; .)
  | "BOOLEAN"                                              (. IdType := Types.TBOOLEAN; .)
  | "TRISTATE"                                             (. IdType := Types.TTRISTATE; .)
.

ntStorageBaseType<VAR IdType : DOM.TPType>
  = "BYTE"                                                 (. IdType := Types.TBYTE; .)
  | "WORD"                                                 (. IdType := Types.TWORD; .)
  | "LONGWORD"                                             (. IdType := Types.TLONGWORD; .)
  | "QUADWORD"                                             (. IdType := Types.TQUADWORD; .)
.

ntSetBaseType<VAR IdType : DOM.TPType>
  = "BITSET8"                                              (. IdType := Types.TBITSET8; .)
  | "BITSET16"                                             (. IdType := Types.TBITSET16; .)
  | "BITSET32"                                             (. IdType := Types.TBITSET32; .)
  | "BITSET64"                                             (. IdType := Types.TBITSET64; .)
  | "BITSET"                                               (. IdType := Types.TBITSET; .)
.

ntFloatAndProcBaseType<VAR IdType : DOM.TPType>
  = "ADDRESS"                                              (. IdType := Types.TADDRESS; .)
  | "PTR"                                                  (. IdType := Types.TPTR; .)
  | "REAL"                                                 (. IdType := Types.TREAL; .)
  | "LONGREAL"                                             (. IdType := Types.TLONGREAL; .)
  | "PROC"                                                 (. IdType := Types.TPROC; .)
.

ntNonOrdinalBaseType<VAR IdType : DOM.TPType>
  = ntStorageBaseType<IdType>
  | ntSetBaseType<IdType>
  | ntFloatAndProcBaseType<IdType>
.

ntPointerBaseType<VAR IdType : DOM.TPType>
  = "PINT8"                                                (. IdType := Types.TpINT8; .)
  | "PINT16"                                               (. IdType := Types.TpINT16; .)
  | "PINT32"                                               (. IdType := Types.TpINT32; .)
  | "PINT64"                                               (. IdType := Types.TpINT64; .)
  | "PSHORTINT"                                            (. IdType := Types.TpSHORTINT; .)
  | "PINTEGER"                                             (. IdType := Types.TpINTEGER; .)
  | "PLONGINT"                                             (. IdType := Types.TpLONGINT; .)
  | "PCARD8"                                               (. IdType := Types.TpCARD8; .)
  | "PCARD16"                                              (. IdType := Types.TpCARD16; .)
  | "PCARD32"                                              (. IdType := Types.TpCARD32; .)
  | "PCARD64"                                              (. IdType := Types.TpCARD64; .)
  | "PSHORTCARD"                                           (. IdType := Types.TpSHORTCARD; .)
  | "PCARDINAL"                                            (. IdType := Types.TpCARDINAL; .)
  | "PLONGCARD"                                            (. IdType := Types.TpLONGCARD; .)
  | "PWCHAR"                                               (. IdType := Types.TpWCHAR; .)
  | "PCHAR"                                                (. IdType := Types.TpBCHAR; .)
  | "PBCHAR"                                               (. IdType := Types.TpBCHAR; .)
  | "PTCHAR"                                               (. IF DOM.eoWCHAR IN c^.CurE^.Options THEN
                                                                IdType := Types.TpTCHARW;
                                                              ELSE
                                                                IdType := Types.TpTCHARB;
                                                              END; .)
  | "PBOOLEAN"                                             (. IdType := Types.TpBOOLEAN; .)
  | "PTRISTATE"                                            (. IdType := Types.TpTRISTATE; .)
    "PBITSET8"                                             (. IdType := Types.TpBITSET8; .)
  | "PBITSET16"                                            (. IdType := Types.TpBITSET16; .)
  | "PBITSET32"                                            (. IdType := Types.TpBITSET32; .)
  | "PBITSET64"                                            (. IdType := Types.TpBITSET64; .)
  | "PBITSET"                                              (. IdType := Types.TpBITSET; .)
  | "PBYTE"                                                (. IdType := Types.TpBYTE; .)
  | "PWORD"                                                (. IdType := Types.TpWORD; .)
  | "PLONGWORD"                                            (. IdType := Types.TpLONGWORD; .)
  | "PQUADWORD"                                            (. IdType := Types.TpQUADWORD; .)
  | "PADDRESS"                                             (. IdType := Types.TpADDRESS; .)
  | "PPTR"                                                 (. IdType := Types.TpPTR; .)
  | "PREAL"                                                (. IdType := Types.TpREAL; .)
  | "PLONGREAL"                                            (. IdType := Types.TpLONGREAL; .)
  | "PPROC"                                                (. IdType := Types.TpPROC; .)
.

ntQualifiedId<IdAction : TIdAction; VAR Id : DOM.TPSymbol; AllowClassWOMember, SearchOnlyTopLevel : BOOLEAN> // !C.2.1
                                                           (. InSymbols : BOOLEAN;
                                                              WithoutMember : BOOLEAN := TRUE; .)
  = ntId<IdAction, DOM.skUnknown, Id, SearchOnlyTopLevel>
    [                                                      (. WithoutMember := FALSE;
                                                              InSymbols := FALSE;
                                                              IF Id <> NIL THEN
                                                                CASE Id^.SymbolKind OF
                                                                | DOM.skModule :
                                                                   IF Id = c^.OD THEN
                                                                      // fall down
                                                                   ELSIF ( c^.UnitKind = DOM.ukDefinition ) AND ( Id^.OfSymbol <> c^.OD ) OR
                                                                         ( c^.UnitKind <> DOM.ukDefinition ) AND ( Id^.OfSymbol <> c^.OI ) THEN
                                                                      SemErr( err._ModuleNotImported );
                                                                   END;
                                                                   InSymbols := TRUE;
                                                                   c^.EnterSymbols( DOM.TPModule( Id )^.SC()^, FALSE, FALSE, NIL );
                                                                | DOM.skClass :
                                                                  InSymbols := TRUE;
                                                                  c^.EnterSymbols( DOM.TPClass( Id )^.S, FALSE, FALSE, NIL );
                                                                ELSE
                                                                  SemErr( err._ExpectedModuleOrClass );
                                                                END; // CASE
                                                              END; .)
      period
      ntQualifiedId<IdAction, Id, AllowClassWOMember, TRUE>(. IF InSymbols THEN
                                                                c^.LeaveSymbols( FALSE );
                                                              END; .)
    ]                                                      (. IF WithoutMember AND ( Id <> NIL ) THEN
                                                                CASE Id^.SymbolKind OF
                                                                | DOM.skModule :
                                                                  IF ( Id <> c^.OD ) AND ( Id^.OfSymbol <> c^.OD ) AND ( Id^.OfSymbol <> c^.OI ) THEN
                                                                    SemErr( err._ModuleNotImported );
                                                                  END;
                                                                  SemErr( err._ExpectedModuleMember );
                                                                | DOM.skClass :
                                                                  IF NOT AllowClassWOMember THEN
                                                                    SemErr( err._ExpectedClassMember );
                                                                  END;
                                                                END; // CASE
                                                              END; .)
.

ntVariableId<IdAction : TIdAction; SK : DOM.TSymbolKind; VAR Variable : DOM.TPSymbol>
  = ntId<IdAction, SK, Variable, FALSE>
.

ntProcedureId<IdAction : TIdAction; VAR Procedure : DOM.TPProcedure> // !C.2.9.1
                                                           (. Id : DOM.TPSymbol; .)
  = ntId<IdAction, DOM.skProcedure, Id, FALSE>             (. Procedure := DOM.TPProcedure( Id ); .)
.

ntClassId<IdAction : TIdAction; VAR Class : DOM.TPClass>   (. Id : DOM.TPSymbol; .)
  = ntId<IdAction, DOM.skClass, Id, FALSE>                 (. Class := DOM.TPClass( Id ); .)
.

ntMemberDeclId<VAR Id : DOM.TPSymbol; SimpleClassFlag : BOOLEAN>
                                                           (. Class : DOM.TPClass := c^.CurrentC();
                                                              EnterCount : CARDINAL := 0;
                                                              FI : DOM.TPSymbol;
                                                              O : DOM.TEO := DOM.opUnknown;
                                                              s : ARRAY [0..31] OF WCHAR;
                                                              Found : BOOLEAN := FALSE; .)
  = 
    ( ntRewritableOperator<O>                              (. Strings.ConcatW( OUT s, L'operator ', DOM.opString[O] );
                                                              Id := NIL;
                                                              IF Class = NIL THEN
                                                                c^.SemErr( err._OperatorOutsideOfClass );
                                                              ELSIF Class^.S.GetS( s, Id ) THEN
                                                                FI := Class;
                                                              ELSE
                                                                c^.SemErrS( err._ClassDoesNotDefineOperator, DOM.opString[O] );
                                                              END; .)
    | ntIdCheck<DOM.skUnknown, FALSE, TRUE, Id, FI> )      (. IF Id <> NIL THEN
                                                                IF DOM.eoISOClassImplementation IN c^.CurE^.Options THEN
                                                                  IF Id^.SymbolKind = DOM.skClass THEN // not OK
                                                                    SemErr( err._ExpectedMemberFoundClass );
                                                                  ELSIF Id^.OfSymbol <> c^.CurrentC() THEN
                                                                    IF O = DOM.opUnknown THEN
                                                                      SemErr( err._MemberNotFound );
                                                                    ELSE
                                                                      SemErr( err._OperatorNotFound );
                                                                    END;
                                                                  ELSE
                                                                    Found := TRUE;
                                                                    INC( EnterCount );
                                                                    c^.EnterSymbols( Class^.S, FALSE, FALSE, NIL );
                                                                  END;
                                                                ELSE
                                                                  IF Id^.SymbolKind = DOM.skClass THEN // here OK
                                                                    Class := DOM.TPClass( Id );
                                                                    INC( EnterCount );
                                                                    c^.EnterSymbols( Class^.S, FALSE, FALSE, NIL );
                                                                  ELSIF Id^.OfSymbol <> c^.CurrentC() THEN
                                                                    IF O = DOM.opUnknown THEN
                                                                      SemErr( err._MemberNotFoundExpectedClassMember );
                                                                    ELSE
                                                                      SemErr( err._OperatorNotFoundExpectedClassMember );
                                                                    END;
                                                                  ELSE
                                                                    Found := TRUE;
                                                                    CASE Id^.SymbolKind OF
                                                                    | DOM.skProcedure, DOM.skProperty, DOM.skOperator :
                                                                    ELSE
                                                                      SemErr( err._MemberHasNoDeclaration );
                                                                    END;
                                                                  END;
                                                                END;
                                                              END; .)
    {
      period                                               (. O := DOM.opUnknown; .)
     ( ntRewritableOperator<O>                             (. Strings.ConcatW( OUT s, L'operator ', DOM.opString[O] );
                                                              Id := NIL;
                                                              IF Class = NIL THEN
                                                                c^.SemErr( err._OperatorOutsideOfClass );
                                                              ELSIF Class^.S.GetS( s, Id ) THEN
                                                                FI := Class;
                                                              ELSE
                                                                c^.SemErrS( err._ClassDoesNotDefineOperator, DOM.opString[O] );
                                                              END; .)
      | ntIdCheck<DOM.skUnknown, TRUE, TRUE, Id, FI> )     (. IF Id <> NIL THEN
                                                                IF Found THEN
                                                                  SemErr( err._InvalidMemberOwnerIsNotClass );
                                                                ELSIF Id^.SymbolKind = DOM.skClass THEN // OK, enter it
                                                                  Class := DOM.TPClass( Id );
                                                                  INC( EnterCount );
                                                                  c^.EnterSymbols( Class^.S, FALSE, FALSE, NIL );
                                                                ELSIF Id^.OfSymbol <> Class THEN
                                                                  IF O = DOM.opUnknown THEN
                                                                    SemErr( err._MemberNotFoundExpectedClassMember );
                                                                  ELSE
                                                                    SemErr( err._OperatorNotFoundExpectedClassMember );
                                                                  END;
                                                                ELSE
                                                                  Found := TRUE;
                                                                  CASE Id^.SymbolKind OF
                                                                  | DOM.skProcedure, DOM.skProperty, DOM.skOperator :
                                                                  ELSE
                                                                    SemErr( err._MemberHasNoDeclaration );
                                                                  END;
                                                                END;
                                                              END; .)
    }                                                      (. WHILE EnterCount > 0 DO
                                                                c^.LeaveSymbols( FALSE );
                                                                DEC( EnterCount );
                                                              END;
                                                              IF Found THEN // OK
                                                                IF SimpleClassFlag THEN
                                                                  Id := NIL;
                                                                  SemErr( err._ClassNameExpected );
                                                                ELSIF Id^.OfSymbol <> c^.CurrentC() THEN
                                                                  SemErr( err._ExpectedMemberOfImplementedClass );
                                                                END;
                                                              ELSIF NOT SimpleClassFlag THEN
                                                                Id := NIL;
                                                                SemErr( err._ClassMemberOrOperatorExpected );
                                                              ELSIF ( Id = NIL ) OR ( Id^.SymbolKind <> DOM.skClass ) THEN 
                                                                SemErr( err._ClassNameExpected );
                                                              ELSIF Id <> c^.CurrentC() THEN
                                                                SemErr( err._ExpectedMemberOfImplementedClass );
                                                              END; .)
.

ntId<IdAction : TIdAction; SymbolKind : DOM.TSymbolKind; VAR Id : DOM.TPSymbol; CheckOnlyInTop : BOOLEAN>
                                                           (. FI : DOM.TPSymbol;
                                                              b : BOOLEAN := FALSE; .)
  = id                                                     (. Id := NIL;
                                                              IF iaiCheck IN IdAction THEN
                                                                b := c^.GetSymbol( t.Val, SymbolKind, TIdAction{iaiCreate, iaiNotReport} * IdAction = TIdAction{}, CheckOnlyInTop, TIdAction{iaiNotUnwrap} * IdAction = TIdAction{}, Id, FI );
                                                              ELSIF iaiNotReportIfOpaque IN IdAction THEN
                                                                b := c^.GetSymbol( t.Val, DOM.skType, FALSE, CheckOnlyInTop, TIdAction{iaiNotUnwrap} * IdAction = TIdAction{}, Id, FI );
                                                                IF NOT b THEN
                                                                  // OK, not found
                                                                ELSIF ( DOM.TPType( Id )^.TypeKind <> DOM.tkOpaqueWhole ) AND ( DOM.TPType( Id )^.TypeKind <> DOM.tkOpaqueBase ) THEN
                                                                  b := FALSE;
                                                                END;
                                                              END;
                                                              IF NOT b AND ( iaiCreate IN IdAction ) THEN
                                                                b := c^.CreateSymbol( t.Val, SymbolKind, TIdAction{iaiNotAdd} * IdAction = TIdAction{}, TRUE, Id );
                                                              END; .)
.

ntIdCheck<SymbolKind : DOM.TSymbolKind; CheckOnlyInTop, Unwrap : BOOLEAN; VAR Id, FI : DOM.TPSymbol>
  = id                                                     (. IF NOT c^.GetSymbol( t.Val, SymbolKind, TRUE, CheckOnlyInTop, Unwrap, Id, FI ) THEN
                                                                Id := NIL;
                                                              END; .)
.

ntIdExpect<ExpectId : DOM.TPSymbol; CheckOnlyInTop : BOOLEAN>
                                                           (. Id, FI : DOM.TPSymbol; .)
  = id                                                     (. IF ExpectId = NIL THEN
                                                                c^.SemErrExpectId( ExpectId );
                                                              ELSIF NOT c^.GetSymbol( t.Val, ExpectId^.SymbolKind, TRUE, CheckOnlyInTop, TRUE, Id, FI ) THEN
                                                                c^.SemErrExpectId( ExpectId );
                                                              ELSIF ExpectId <> Id THEN
                                                                c^.SemErrExpectId( ExpectId );
                                                              END; .)
.

/* =========operators, separators */

ntCaseSeparator
  = pipe
.

ntNegation
  = "NOT" 
.

ntInequality
  = notequalsA
  | notequalsB
.
  
ntLogicalDisjunction
  = "OR"
.

ntLogicalConjunction
  = "AND"
.
  
ntBitwiseDisjunction
  = "OR"
.

ntBitwiseConjunction
  = "AND"
.

ntBitwiseSymmetricSetDifference
  = "XOR"
.

ntMod
  = "MOD"
  | percent
.
  
END m2.
