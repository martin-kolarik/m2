DEFINITION MODULE SyncQueue;

IMPORT
   Sync;

#save, option( dll_export => on )

(*================================================================================*)

TYPE
   TPRingBuffer = POINTER TO RingBuffer;

CLASS RingBuffer( Sync.OneToOneQueue ); // SIGNALLING and FLUSHING, if needed, should be done using VIRTUAL PROCEDURE Flush/Signal.
  INTERNAL VAR
     Data        : ADDRESS;
     DataDoubled : BOOLEAN;
  PUBLIC VIRTUAL PROPERTY
     Size        : CARDINAL;
  PUBLIC VAR
     Consume     : Sync.RAWSIGNAL := NIL;
     Produce     : Sync.RAWSIGNAL := NIL;

  // asynchronous GET API
  PUBLIC PROCEDURE StartReading( WantsRead : CARDINAL; OUT BufferToReadFrom : ADDRESS; OUT AllowedToRead : CARDINAL ) : BOOLEAN;
  PUBLIC PROCEDURE CommitReading( Read : CARDINAL );
  PUBLIC PROCEDURE StartWriting( WantsWrite : CARDINAL; OUT BufferToWriteTo : ADDRESS; OUT AllowedToWrite : CARDINAL ) : BOOLEAN;
  PUBLIC PROCEDURE CommitWriting( Written : CARDINAL );

  // sychronous PUSH noblocking API
  PUBLIC PROCEDURE Read( BufferToWriteTo : ADDRESS; BufferLength : CARDINAL; OUT Read : CARDINAL ) : BOOLEAN;
  PUBLIC PROCEDURE Write( BufferToReadFrom : ADDRESS; BufferLength : CARDINAL; OUT Written : CARDINAL ) : BOOLEAN;

  // sychronous PUSH blocking API
  PUBLIC PROCEDURE ReadOA( OUT Data : ARRAY OF BYTE );
  PUBLIC PROCEDURE WriteOA( CONST Data : ARRAY OF BYTE );
  
  // synchronous peek API
  PUBLIC PROCEDURE Peek( OUT Data : ADDRESS; OUT Length : CARDINAL ) : BOOLEAN; // allocates 2x more memory and moves!
  PUBLIC PROCEDURE Peek2( OUT Data1 : ADDRESS; OUT Length1 : CARDINAL; OUT Data2 : ADDRESS; OUT Length2 : CARDINAL ) : BOOLEAN; // does not allocate, does not move, returns two areas if data are splitted
  // use CommitReading for flushing out

  INTERNAL VIRTUAL PROCEDURE Signal( What : Sync.TpcqSignal ); // when produced, next producing SHOULD NOT be signalled (until signalling consumed)
  INTERNAL VIRTUAL PROCEDURE Flush( ForWhat : Sync.TpcqSignal; Wait : BOOLEAN; Timeout : CARDINAL; OUT SpentTime : CARDINAL ) : Sync.TAsyncResult;
END RingBuffer;

(*================================================================================*)

TYPE
   TPIntegerQueue = POINTER TO IntegerQueue;

CLASS IntegerQueue( RingBuffer ); // Size must not be < 4, Consume and Produce event should not be set, they are handled internally
   PUBLIC PROCEDURE Enqueue( I : INTEGER; Wait : BOOLEAN; Timeout : CARDINAL ) : Sync.TAsyncResult;
   PUBLIC PROCEDURE Dequeue( OUT I : INTEGER; Wait : BOOLEAN; Timeout : CARDINAL ) : Sync.TAsyncResult;
END IntegerQueue;

(*--------------------------------------------------------------------------------*)

TYPE
   TPQuadwordQueue = POINTER TO QuadwordQueue;

CLASS QuadwordQueue( RingBuffer ); // Size must not be < 8, Consume and Produce event should not be set, they are handled internally
   PUBLIC PROCEDURE Enqueue( CONST Q : QUADWORD; Wait : BOOLEAN; Timeout : CARDINAL ) : Sync.TAsyncResult; // if Wait is FALSE, alwasy is possible to wait in caller code
   PUBLIC PROCEDURE Dequeue( OUT Q : QUADWORD; Wait : BOOLEAN; Timeout : CARDINAL ) : Sync.TAsyncResult;
END QuadwordQueue;

(*================================================================================*)

CLASS CDatagramQueue( Sync.NToOneQueue );
  // class dedicated for N to 1 receiving, usually consumer has more to do. It is better to leave CONSUMER to control
  // flow (using Produce signal without defining Consume signal (delayed flush is automatic)) even if the problem
  // is symmetric and control by Consume or Consume/Produce will work (less efficiently) too
  INTERNAL VAR
     Data      : ADDRESS;
     ItemISize : CARDINAL; // internal length, including length friend
  PUBLIC VIRTUAL PROPERTY
     Size      : CARDINAL;
     ItemSize  : CARDINAL;
  PUBLIC VAR
     Consume   : Sync.RAWSIGNAL := NIL;
     Produce   : Sync.RAWSIGNAL := NIL;

  // consumer
  PUBLIC PROCEDURE Init( QueueSize, MessageSize : CARDINAL );
  PUBLIC PROCEDURE Dequeue( MessageBuffer : ADDRESS; MessageBufferSize : CARDINAL; Wait : BOOLEAN; Timeout : CARDINAL ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE DequeueOA( OUT Message : ARRAY OF BYTE; Wait : BOOLEAN; Timeout : CARDINAL ) : Sync.TAsyncResult; // if HIGH is less than MessageLen the message is trimmed
    // returns if data get

  // producers
  PUBLIC PROCEDURE Enqueue( Message : ADDRESS; MessageSize : CARDINAL; Wait : BOOLEAN; Timeout : CARDINAL ) : Sync.TAsyncResult;
  PUBLIC PROCEDURE EnqueueOA( CONST Message : ARRAY OF BYTE; Wait : BOOLEAN; Timeout : CARDINAL ) : Sync.TAsyncResult;
    // returns if added, for ANY thread
  PUBLIC PROCEDURE PushToConsumer( Wait : BOOLEAN; Timeout : CARDINAL ) : Sync.TAsyncResult;

  INTERNAL VIRTUAL PROCEDURE Validate( Block : CARDINAL );
  INTERNAL VIRTUAL PROCEDURE IsValid( Block : CARDINAL ) : BOOLEAN;
  INTERNAL VIRTUAL PROCEDURE Invalidate( Block : CARDINAL );
  INTERNAL VIRTUAL PROCEDURE Signal( What : Sync.TpcqSignal ); // when produced, next producing SHOULD NOT be done (until signalling consumed)

  INTERNAL VIRTUAL PROCEDURE Flush( ForWhat : Sync.TpcqSignal; Wait : BOOLEAN; Timeout : CARDINAL; OUT SpentTime : CARDINAL ) : Sync.TAsyncResult;
END CDatagramQueue;

(*================================================================================*)

#restore

END SyncQueue.