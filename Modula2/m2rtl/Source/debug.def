DEFINITION MODULE Debug;
// Modula2 Debug module -- ASSERT etc.

#save, option( dll_export => on )

//--------------------------------------------------------------------------------

PROCEDURE AssertA( ContinueWithRun, Condition : BOOLEAN; ModuleLine, CPPLine : CARDINAL; CONST Module, Text : ARRAY OF CHAR );
PROCEDURE AssertW( ContinueWithRun, Condition : BOOLEAN; ModuleLine, CPPLine : CARDINAL; CONST Module, Text : ARRAY OF WCHAR );

PROCEDURE WaitUsingDialog();
PROCEDURE WaitUsingLoop();

// Mainly for test purposes, but for others it works too. When hooked LogAssert outputs nothing.
TYPE
   TAssertHook = PROCEDURE( PTR, ARRAY OF WCHAR ) : TRISTATE; // 0 = ignore, 1 = abort, -1 = debug

PROCEDURE SetAssertHook( hook : TAssertHook; userData : PTR ); // userData is passed to the first parameter TAssertHook
PROCEDURE GetAssertHook() : TAssertHook;

//--------------------------------------------------------------------------------

PROCEDURE Dump( path : ARRAY OF WCHAR; exceptionPointers : ADDRESS ) : BOOLEAN; // writes a minidump, if path is empty default one is used (AppData and name by time). exceptionPointers = windows.PEXCEPTION_POINTERS

PROCEDURE InstallCrashHandler();
PROCEDURE UninstallCrashHandler();

//--------------------------------------------------------------------------------

CONST
   AssertionA ::= AssertA;
   AssertionW ::= AssertW;

//--------------------------------------------------------------------------------

#restore

END Debug.
