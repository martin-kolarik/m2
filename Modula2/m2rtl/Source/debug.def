DEFINITION MODULE Debug;
// Modula2 Debug module -- ASSERT etc.

#save, option( dll_export => on )

//--------------------------------------------------------------------------------

PROCEDURE Assert( CONST Module : ARRAY OF WCHAR; ModuleLine, CPPLine : CARDINAL ) : BOOLEAN; // returns if debug break is required

PROCEDURE LogAssertA( CONST Text, Module : ARRAY OF CHAR; ModuleLine : CARDINAL );
PROCEDURE LogAssertW( CONST Text, Module : ARRAY OF WCHAR; ModuleLine : CARDINAL );

// Mainly for test purposes, but for others it works too. When hooked LogAssert outputs nothing.
TYPE
   TAssertHook = PROCEDURE( ARRAY OF WCHAR ) : TRISTATE; // 0 = ignore, 1 = abort, -1 = debug

PROCEDURE SetAssertHook( hook : TAssertHook );
PROCEDURE GetAssertHook() : TAssertHook;

//--------------------------------------------------------------------------------

PROCEDURE Dump( path : ARRAY OF WCHAR; exceptionPointers : ADDRESS ) : BOOLEAN; // writes a minidump, if path is empty default one is used (AppData and name by time). exceptionPointers = windows.PEXCEPTION_POINTERS

PROCEDURE InstallCrashHandler();
PROCEDURE UninstallCrashHandler();

//--------------------------------------------------------------------------------

CONST
   Assertion ::= Assert;
   LogAssertionA ::= LogAssertA;
   LogAssertionW ::= LogAssertW;

//--------------------------------------------------------------------------------

#restore

END Debug.
