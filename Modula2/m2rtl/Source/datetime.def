DEFINITION MODULE datetime;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   Languages;

#save, option( dll_export => on )

(*================================================================================================*)
// common

TYPE
   TDayOfWeek = (
      UnknownDay = 0,
      Monday,
      Tuesday,
      Wednesday,
      Thursday,
      Friday,
      Saturday,
      Sunday
   ); // TDayOfWeek

(*================================================================================================*)
// uptime OS counters

PROCEDURE UptimeMS32() : CARD32; // returns time from system startup in ms
PROCEDURE UptimeMS64() : CARD64; // returns time from system startup in ms

CONST
   UptimeMS ::= UptimeMS32;

(*================================================================================================*)
// time span

CLASS TimeSpan; // unit is 100 ns

   PUBLIC READONLY PROPERTY
      Precision : CARD64; // hertz
      Negative : BOOLEAN;

   PUBLIC PROPERTY
      Value : INT64; // raw value, e.g. for transport purposes
      Microseconds : LONGREAL;
      Milliseconds : LONGREAL;
      Seconds : LONGREAL;
      Minutes : LONGREAL;
      Hours : LONGREAL;
      Days : LONGREAL; // usable for a fraction of the day too, of course

   PUBLIC INLINE OPERATOR :=( CONST Source : TimeSpan );
   PUBLIC OPERATOR =( CONST Comperand : TimeSpan ) : BOOLEAN;
   PUBLIC OPERATOR <>( CONST Comperand : TimeSpan ) : BOOLEAN;
   PUBLIC OPERATOR <( CONST Comperand : TimeSpan ) : BOOLEAN;
   PUBLIC OPERATOR <=( CONST Comperand : TimeSpan ) : BOOLEAN;
   PUBLIC OPERATOR >( CONST Comperand : TimeSpan ) : BOOLEAN;
   PUBLIC OPERATOR >=( CONST Comperand : TimeSpan ) : BOOLEAN;
   PUBLIC OPERATOR +( CONST Addend : TimeSpan ) : TimeSpan;
   PUBLIC OPERATOR -( CONST Addend : TimeSpan ) : TimeSpan;

   PUBLIC PROCEDURE Add( CONST Addend : TimeSpan );
   PUBLIC PROCEDURE Subtract( CONST Addend : TimeSpan );
   PUBLIC PROCEDURE FromDHMS( D, H, M, S, MS : CARDINAL );
   PUBLIC PROCEDURE ToDHMS( OUT D, H, M, S, MS : CARDINAL ); // returns always positive values, even if the span is negative

   PRIVATE VAR
      _Value : INT64 := 0;

END TimeSpan;

PROCEDURE TimeSpanZero() : TimeSpan;
PROCEDURE TimeSpanMS32( Milliseconds : INT32 ) : TimeSpan;
PROCEDURE TimeSpanS( Seconds : LONGREAL ) : TimeSpan;
PROCEDURE TimeSpanD( Days : LONGREAL ) : TimeSpan;

(*================================================================================================*)
// high resolution timer

CLASS HighResolutionTime; // unit is 1/Frequency
   
   PUBLIC READONLY PROPERTY
      Precision : CARD64; // hertz
      Value : CARD64; // raw value, e.g. for transport purposes

   PUBLIC INLINE OPERATOR :=( CONST Source : HighResolutionTime );
   // PUBLIC OPERATOR =( CONST Comperand : HighResolutionTime ) : BOOLEAN;
   // PUBLIC OPERATOR <>( CONST Comperand : HighResolutionTime ) : BOOLEAN;
   // PUBLIC OPERATOR <( CONST Comperand : HighResolutionTime ) : BOOLEAN;
   // PUBLIC OPERATOR <=( CONST Comperand : HighResolutionTime ) : BOOLEAN;
   // PUBLIC OPERATOR >( CONST Comperand : HighResolutionTime ) : BOOLEAN;
   // PUBLIC OPERATOR >=( CONST Comperand : HighResolutionTime ) : BOOLEAN;
   // PUBLIC OPERATOR +( CONST Addend : TimeSpan ) : HighResolutionTime;
   // PUBLIC OPERATOR -( CONST Addend : TimeSpan ) : HighResolutionTime;
   PUBLIC OPERATOR -( CONST Addend : HighResolutionTime ) : TimeSpan;

   PUBLIC PROCEDURE SetNow();

   PRIVATE VAR
      _Value : CARD64 := 0;

END HighResolutionTime;

PROCEDURE NowHR() : HighResolutionTime;

(*================================================================================================*)
// DayCount routines, continuous time based on Julian Date. Internally stored as 100-us fixed poing.

CLASS DayCount;
   
   PUBLIC READONLY PROPERTY
      Precision : CARD64; // hertz
      DayOfWeek : TDayOfWeek;
      IsLowBound : BOOLEAN; // pair to SetLowBound
      IsHighBound : BOOLEAN; // pair to SetHighBound

   PUBLIC PROPERTY
      Value : INT64; // raw value, e.g. for transport purposes
      FractionOfTheDay : TimeSpan; // values greater than 1 D are trimmed (only the fraction is used)
      JulianDate : LONGREAL; // scientific value

   PUBLIC INLINE OPERATOR :=( CONST Source : DayCount );

   PUBLIC OPERATOR =( CONST Comperand : DayCount ) : BOOLEAN;
   PUBLIC OPERATOR <>( CONST Comperand : DayCount ) : BOOLEAN;
   PUBLIC OPERATOR <( CONST Comperand : DayCount ) : BOOLEAN;
   PUBLIC OPERATOR <=( CONST Comperand : DayCount ) : BOOLEAN;
   PUBLIC OPERATOR >( CONST Comperand : DayCount ) : BOOLEAN;
   PUBLIC OPERATOR >=( CONST Comperand : DayCount ) : BOOLEAN;
   PUBLIC OPERATOR +( CONST Addend : TimeSpan ) : DayCount;
   PUBLIC OPERATOR -( CONST Addend : TimeSpan ) : DayCount;

   PUBLIC PROCEDURE SetNow();
   PUBLIC PROCEDURE SetLowBound(); // pair to IsLowBound
   PUBLIC PROCEDURE SetHighBound(); // pair to IsHighBound
   
   PUBLIC PROCEDURE Add( CONST Addend : TimeSpan );
   PUBLIC PROCEDURE Subtract( CONST Addend : TimeSpan );
   PUBLIC PROCEDURE Difference( CONST Operand : DayCount ) : TimeSpan; // SELF - Operand

   PUBLIC PROCEDURE FromYMD( y : INTEGER; m, d : CARDINAL; CONST fd : TimeSpan );
   PUBLIC PROCEDURE ToYMD( OUT y : INTEGER; OUT m, d : CARDINAL; OUT fd : TimeSpan );

   PRIVATE VAR
      _Value : INT64 := 0;

END DayCount;

PROCEDURE NowDC() : DayCount;
PROCEDURE NowDCDayOnly() : DayCount;
PROCEDURE DayCountYMD( y : INTEGER; m, d : CARDINAL ) : DayCount;
PROCEDURE DayCountYMDfd( y : INTEGER; m, d : CARDINAL; CONST fd : TimeSpan ) : DayCount;

(*================================================================================================*)
// UTCBias always represents zone time only, thus,
// real bias of UTC is to be counted as addition of both UTCBias and DSTBias

PROCEDURE GetZonalUTCBias() : INTEGER; // MINUTES!!
  // returns bias according to system time zone
PROCEDURE GetZonalDSTBias() : INTEGER; // MINUTES!!
  // returns bias according to current time zone ignoring current DST state
PROCEDURE GetCurrentUTCBias() : INTEGER; // MINUTES!! 
  // returns whole local bias, including DST bias
PROCEDURE GetCurrentDSTBias() : INTEGER; // MINUTES;
  // returns only DST bias

(*================================================================================================*)
// date and time support

TYPE
   TPDateTime = POINTER TO DateTime;

CLASS DateTime;

   PUBLIC READONLY PROPERTY
      Precision : CARD64; // hertz

   PUBLIC PROPERTY
      Millisecond : CARDINAL;
      Second : CARDINAL;
      Minute : CARDINAL;
      Hour : CARDINAL;
      Day : CARDINAL;
      Month : CARDINAL;
      Year : INTEGER;
      UTCBias : INTEGER;
      DSTBias : INTEGER;
   PUBLIC READONLY PROPERTY
      Empty : BOOLEAN;
      DstActive : BOOLEAN;
      DayOfWeek : TDayOfWeek;
   PUBLIC PROPERTY
      DayCount : datetime.DayCount; // set sets biases to UTC, for another biases use FromDC
      
   PUBLIC OPERATOR :=( CONST Source : DateTime );

   PUBLIC OPERATOR =( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR <>( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR <( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR <=( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR >( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR >=( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR +( CONST Addend : TimeSpan ) : DateTime;
   PUBLIC OPERATOR -( CONST Addend : TimeSpan ) : DateTime;
        
   PUBLIC PROCEDURE Clear();
   PUBLIC PROCEDURE TrimDate();
   PUBLIC PROCEDURE TrimTime();
   PUBLIC PROCEDURE SetNowLocal();
   PUBLIC PROCEDURE SetNowUTC();
   PUBLIC PROCEDURE SetZoneToLocal();
   PUBLIC PROCEDURE SetZoneToUTC();
   PUBLIC PROCEDURE SetZone( UTCBias, DSTBias : INTEGER ); // sets both biases in single call
   PUBLIC PROCEDURE FromDCToLocal( CONST DC : datetime.DayCount ); // JD is missing time zone information, local one will be set
   PUBLIC PROCEDURE FromDC( CONST DC : datetime.DayCount; UTCBias, DSTBias : INTEGER ); // JD is missing time zone information
   
   PUBLIC PROCEDURE Add( Addend : TimeSpan );
   PUBLIC PROCEDURE Subtract( Addend : TimeSpan );
   PUBLIC PROCEDURE Difference( CONST Operand : DateTime ) : TimeSpan;
   
   PUBLIC PROCEDURE FromStringOA( CONST String, Format : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE FromLanguageStringOA( Language : Languages.TLanguage; CONST String, Format : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE ToStringOA( Format : ARRAY OF WCHAR; FormatDate : BOOLEAN; FormatTime : BOOLEAN; OUT String : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE ToLanguageStringOA( Language : Languages.TLanguage; Format : ARRAY OF WCHAR; FormatDate : BOOLEAN; FormatTime : BOOLEAN; OUT String : ARRAY OF WCHAR ) : BOOLEAN;

   PRIVATE VAR
      _Empty       : BOOLEAN;
      _Millisecond : CARDINAL;
      _Second      : CARDINAL;
      _Minute      : CARDINAL;
      _Hour        : CARDINAL;
      _Day         : CARDINAL;
      _Month       : CARDINAL;
      _Year        : INTEGER;
      _DayOfWeek   : TDayOfWeek;
      _DayOfWeekDirty : BOOLEAN;
      // UTC = LocalTime + UTCBias + DSTBias
      // biases are in minutes
      _UTCBias     : INTEGER;  // if DateTime contains system (UTC) time, the UTCBias is 0
      _DSTBias     : INTEGER;  // if DateTime contains system (UTC) time, the DSTBias is 0

END DateTime;

PROCEDURE NowLocal() : DateTime;
PROCEDURE NowUTC() : DateTime;

(*================================================================================================*)

INITIALLY __I();

(*================================================================================================*)

#restore

END datetime.