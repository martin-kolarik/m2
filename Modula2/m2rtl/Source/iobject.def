DEFINITION MODULE iobject;

// Classes prepared to simplify implementation are in: ClassLoader\Helper.def

(*===========================================================================*)

TYPE
   TPLibraryObject = POINTER TO ILibraryObject;
   TPLibrary = POINTER TO ILibrary;

(*---------------------------------------------------------------------------*)

TYPE
   TResult = (
      lrSuccess,
      lrLibraryNotFound,
      lrLibraryFoundButIsUnloadable,
      lrLibraryFoundButLoadUnauthorized,
      lrLibraryDisabled,
      lrClassNotFound
   );
   
TYPE
   #save, call( convention => cdecl )
   TFactory = PROCEDURE( CONST ARRAY OF WCHAR, OUT TPLibraryObject ) : TResult;
   #restore

(*===========================================================================*)

TYPE
   TObjectType = (
      otSingleton,
      otEphemeral
   );
   
#save, option( dll_export => on )

INTERFACE ILibraryObject;

   READONLY PROPERTY
      Type : TObjectType;
   PROPERTY
      Library : TPLibrary;

   PROCEDURE Destroy(); // Cleans internal dynamic data, deallocates implementor memory (of course it depends on implementation. A pair to Factory method of the DLL.

END ILibraryObject;

(*---------------------------------------------------------------------------*)

CONST
   cidLibrary = L"Library";

TYPE
   TcllvData = RECORD
      Length    : CARDINAL;
      Data      : ADDRESS;
      Validator : ADDRESS;
   END; // RECORD

INTERFACE ILibrary( ILibraryObject );
   
   // host -> library interaction
   READONLY PROPERTY
      HostHandle : PTR;
      LibraryHandle : PTR;

   PROCEDURE HostInfo( CONST HostHandle, LibraryHandle : PTR; CONST Host, HostVersionString : ARRAY OF WCHAR ); // usually product id/product version

   // library -> host interaction
   PROCEDURE LibraryInfo( OUT Library, LibraryVersionString : ARRAY OF WCHAR ); // usually product id/product version
   PROCEDURE EnumerateClasses( REF EnumerateState : PTR; OUT ClassName : ARRAY OF WCHAR ) : BOOLEAN;
   PROCEDURE GetLECData( OUT cllvData : TcllvData; OUT cllvPath : ARRAY OF WCHAR ) : BOOLEAN;

   // client interaction, the factory
   PROCEDURE CreateObject( CONST ClassPath : ARRAY OF WCHAR; OUT Object : iobject.TPLibraryObject ) : iobject.TResult;
   PROCEDURE DestroyObject( Object : TPLibraryObject ) : iobject.TResult;

END ILibrary;

#restore   

(*===========================================================================*)

END iobject.