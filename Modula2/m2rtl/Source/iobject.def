DEFINITION MODULE iobject;

// Classes prepared to simplify implementation are in: ClassLoader\Helper.def

(*===========================================================================*)

TYPE
   TPLibrary = POINTER TO ILibrary;
   TPObject = POINTER TO IObject;

(*---------------------------------------------------------------------------*)

TYPE
   TResult = (
      lrSuccess,
      lrLibraryNotFound,
      lrLibraryFoundButIsUnloadable,
      lrLibraryFoundButLoadUnauthorized,
      lrLibraryDisabled,
      lrClassNotFound
   );
   
TYPE
   #save, call( convention => cdecl )
   TFactory = PROCEDURE( CONST ARRAY OF WCHAR, OUT TPObject ) : TResult;
   TFactoryUntyped = PROCEDURE( CONST ARRAY OF WCHAR, OUT ADDRESS ) : TResult;
   #restore

(*===========================================================================*)

TYPE
   TObjectType = (
      otSingleton,
      otEphemeral
   );
   
#save, option( dll_export => on )

INTERFACE IObject;
   READONLY PROPERTY
      Type : TObjectType;
   PROPERTY
      Library : TPLibrary;
   PROCEDURE OnDispose(); // meant not as Command, but as Callback, usually, destroying of object is done with ReleaseObject of some loader.
END IObject;

(*---------------------------------------------------------------------------*)

CONST
   cidLibrary = L"Library";

TYPE
   TcllvData = RECORD
      Length    : CARDINAL;
      Data      : ADDRESS;
      Validator : ADDRESS;
   END; // RECORD

INTERFACE ILibrary( IObject );
   READONLY PROPERTY
      Loader : ADDRESS;
      LoaderLibraryHandle : PTR;

   PROCEDURE HostInfo( Loader : ADDRESS; LoaderLibraryHandle : PTR; CONST Host, HostVersionString : ARRAY OF WCHAR ); // usually product id/product version

   PROCEDURE LibraryInfo( OUT Library, LibraryVersionString : ARRAY OF WCHAR ); // usually product id/product version
   PROCEDURE EnumerateClasses( REF EnumerateState : PTR; OUT ClassName : ARRAY OF WCHAR ) : BOOLEAN;
   PROCEDURE GetLECData( OUT cllvData : TcllvData; OUT cllvPath : ARRAY OF WCHAR ) : BOOLEAN;
END ILibrary;

#restore   

(*===========================================================================*)

END iobject.