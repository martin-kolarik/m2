DEFINITION MODULE Sync;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

#save, option( dll_export => on )

(*================================================================================*)

// generic types
TYPE
   WAITABLE = ADDRESS;
  
TYPE
   // main success: arCompleted
   // main error: arCannotStart

   TAsyncResult = ( // Sync this with IDLs !!!
      // initial, undefined value
      arUnknown,
         arInitial = arUnknown,

      // successes
      arCompleted, // whole sucessfull completion
        arSucceeded = arCompleted,
      arPartCompleted, // partial sucessfull completion
        arCompletedFromCache = arPartCompleted,
      arAlreadyCompleted, // required state already achieved

      // processing
      arNoData, // success, but nothing
      arPending, // sucesfully started
      arTimeout, // completed after timeout
      arAborted, // abortion, the operation was stopped

      // errors
      arAlreadyPending, // not started -- something is pending now (= busy)
         arBusy = arAlreadyPending,
      arCannotStart, // not started, no resources
         arFailed = arCannotStart,
      arUnsupportedDirection // e.g. read only
   );
   TAsyncResults = SET OF TAsyncResult;

CONST
   arsCompletions = TAsyncResults{arCompleted, arPartCompleted, arAlreadyCompleted};
   arsStarts = arsCompletions + TAsyncResults{arPending};

PROCEDURE ResultToName( Result : TAsyncResult; OUT Name : ARRAY OF WCHAR ) : BOOLEAN;
  
(*================================================================================*)

CONST
   FOREVER   = CARDINAL( 0FFFFFFFFH );
   FORSAFETY = 12321;

PROCEDURE Sleep( Time : CARDINAL );
PROCEDURE NumberOfProcessors() : CARDINAL;

// use these preferably to have identical system-wide behavior
PROCEDURE SpinLockAcquire( REF Data : PTR; SpinCount : CARDINAL; Timeout : CARDINAL ) : TAsyncResult;
PROCEDURE SpinLockLeave( REF Data : PTR );

(*================================================================================*)
// generic interfaces

TYPE
   PILock = POINTER TO ILock;

INTERFACE ILock; // for any two way lock, ILock means stronger locking
   PROCEDURE Lock() : TAsyncResult;
   PROCEDURE LockTimeout( Timeout : CARDINAL ) : TAsyncResult;
   PROCEDURE Unlock();
END ILock;

(*--------------------------------------------------------------------------------*)

TYPE
   PIRLock = POINTER TO IRLock;

INTERFACE IRLock( ILock );
   PROCEDURE LockRead( Timeout : CARDINAL ) : TAsyncResult;
   PROCEDURE UnlockRead();
END IRLock;

(*================================================================================*)
// locking

TYPE
   TLockType = ( ltILock, ltSpin, ltCS, ltMutex ); // interlocked (effectively for Get/Incl only), nonreentrant (default), reentrant, interprocess
   PLOCK = POINTER TO LOCK;

CLASS LOCK IMPLEMENTS ILock;
   PRIVATE VAR
      Type : TLockType := ltSpin;
      Spin : CARDINAL;
      Data : PTR; // initially unlocked
   PUBLIC READONLY PROPERTY
      RawHandle : WAITABLE;

   // ILock
   PUBLIC VIRTUAL PROCEDURE Lock() : TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE LockTimeout( Timeout : CARDINAL ) : TAsyncResult; // not applicable for CS if Timeout > 0
   PUBLIC VIRTUAL PROCEDURE Unlock();

   PUBLIC PROCEDURE Init( Type : TLockType; CONST Name : ARRAY OF WCHAR; InitiallyLocked : BOOLEAN );

   // primitive operations done in LOCKed context  
   PUBLIC PROCEDURE Get( REF Operand : LONGWORD ) : CARDINAL; // current value
   PUBLIC PROCEDURE GetPtr( REF Operand : ADDRESS ) : ADDRESS; // current value
   PUBLIC PROCEDURE Inc( REF Operand : LONGWORD; Increment : CARDINAL ) : CARDINAL; // resulting value
   PUBLIC PROCEDURE Dec( REF Operand : LONGWORD; Decrement : CARDINAL ) : CARDINAL; // resulting value
   PUBLIC PROCEDURE Exchg( REF Operand : LONGWORD; Value : LONGWORD ) : CARDINAL; // previous value
   PUBLIC PROCEDURE ExchgPtr( REF Operand : ADDRESS; Value : ADDRESS ) : ADDRESS; // previous value
   PUBLIC PROCEDURE ExchgAdd( REF Operand : LONGWORD; Addition : INTEGER ) : CARDINAL; // previous value
   PUBLIC PROCEDURE CmpExchg( REF Operand : LONGWORD; Value : LONGWORD; Comparand : LONGWORD ) : CARDINAL; // previous value
   PUBLIC PROCEDURE CmpExchgPtr( REF Operand : ADDRESS; Value : ADDRESS; Comparand : ADDRESS ) : ADDRESS; // previous value
   // 32bits sets
   PUBLIC PROCEDURE Incl( REF Operand : LONGWORD; IncludedBit : LONGWORD ) : BITSET32; // previous value
   PUBLIC PROCEDURE Excl( REF Operand : LONGWORD; ExcludedBit : LONGWORD ) : BITSET32; // previous value
   PUBLIC PROCEDURE InclExcl( REF Operand : LONGWORD; IncludedSet, ExcludedSet : BITSET32 ) : BITSET32; // previous value
   PUBLIC PROCEDURE In( REF Operand : LONGWORD; TestBit : LONGWORD ) : BOOLEAN;
   PUBLIC PROCEDURE InSet( REF Operand : LONGWORD; TestSet : BITSET32 ) : BOOLEAN;
   PUBLIC PROCEDURE NotInSet( REF Operand : LONGWORD; TestSet : BITSET32 ) : BOOLEAN;
   PUBLIC PROCEDURE AndCmp( REF Operand : LONGWORD; AndSet, CmpSet : BITSET32 ) : BOOLEAN;
  
   PUBLIC PROCEDURE Dispose(); // not required, implicit
END LOCK;

(*================================================================================*)
// raw signalling, mainly for handles coming from OS

PROCEDURE RawSignal( S : WAITABLE );
PROCEDURE RawSignalAndReset( S : WAITABLE );
PROCEDURE RawReset( S : WAITABLE );

// waiting
PROCEDURE RawWait( W : WAITABLE; Timeout : CARDINAL ) : TAsyncResult;
PROCEDURE RawState( W : WAITABLE ) : BOOLEAN; // TRUE = Signalled, FALSE = Nonsignalled

// primitive atomic operations
CONST
   ivSET = 1; // interlocked value
   ivNOTSET = 0;

// for synchronization issues preferably use SpinLock* procedures above to leave system-wide compatible behavior
PROCEDURE ICmpExchg( REF Variable : INT32; Exchange : INT32; Comperand : INT32 ) : INT32;
PROCEDURE ICmpExchgPtr( REF Variable : ADDRESS; Exchange : ADDRESS; Comperand : ADDRESS ) : ADDRESS;
PROCEDURE IDec( REF Variable : INT32 ) : INT32;
PROCEDURE IExchg( REF Variable : INT32; Value : INT32 ) : INT32;
PROCEDURE IExchgAdd( REF Variable : INT32; Value : INT32 ) : INT32;
PROCEDURE IExchgPtr( REF Variable : ADDRESS; Value : ADDRESS ) : ADDRESS;
PROCEDURE IInc( REF Variable : INT32 ) : INT32;
PROCEDURE IGet( REF Variable : INT32 ) : INT32;
PROCEDURE IGetPtr( REF Variable : ADDRESS ) : ADDRESS;

// synchronized access to typed values
PROCEDURE IGetAR( REF Variable : TAsyncResult ) : TAsyncResult;
PROCEDURE ISetAR( REF Variable : TAsyncResult; NewValue : TAsyncResult );
PROCEDURE IExchgAR( REF Variable : TAsyncResult; NewValue : TAsyncResult; OUT PreviousValue : TAsyncResult ) : BOOLEAN; // returns if value changed

(*--------------------------------------------------------------------------------*)
// atomic signalling

TYPE
   TSignalType = ( stSpin, stSpinAutoreset, stEvent, stEventAutoreset, stForeign ); // Autoreset types resets signal after successful wait
   PSIGNAL = POINTER TO SIGNAL;

CLASS SIGNAL IMPLEMENTS ILock;
   PRIVATE VAR
      Type : TSignalType := stSpin;
      Spin : CARDINAL;
      Data : PTR; // initially reset
      _Lock : LOCK;
   PUBLIC PROPERTY
      State : BOOLEAN;
   PUBLIC READONLY PROPERTY
      RawHandle : WAITABLE;

   // ILock
   PUBLIC VIRTUAL PROCEDURE Lock() : TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE LockTimeout( Timeout : CARDINAL ) : TAsyncResult; // not applicable for CS if Timeout > 0
   PUBLIC VIRTUAL PROCEDURE Unlock();

   // own
   PUBLIC PROCEDURE Init( Type : TSignalType; CONST Name : ARRAY OF WCHAR; InitiallySignaled : BOOLEAN );
   PUBLIC PROCEDURE InitForeign( EventHandle : WAITABLE; InitiallySignalled : BOOLEAN ); // EventHandle will not be closed

   PUBLIC PROCEDURE Signal() : BOOLEAN; // returns if state was SWITCHED
   PUBLIC PROCEDURE SignalAndReset();
   PUBLIC PROCEDURE Reset() : BOOLEAN; // returns if state was SWITCHED
   PUBLIC PROCEDURE Test() : BOOLEAN;
   PUBLIC PROCEDURE Wait( Timeout : CARDINAL ) : TAsyncResult;

   PUBLIC PROCEDURE Dispose(); // not required, implicit
END SIGNAL;

// "static" methods
CONST
   sgSET = TRISTATE( 1 );
   sgNOTSET = TRISTATE( 0 );
   sgINVALID = TRISTATE( -1 );

PROCEDURE CreateSignal( Type : TSignalType; CONST Name : ARRAY OF WCHAR; InitialState : BOOLEAN ) : PSIGNAL;
PROCEDURE DeleteSignal( REF Signal : PSIGNAL );
PROCEDURE SafeSignal( Signal : PSIGNAL ) : TRISTATE;
PROCEDURE SafeReset( Signal : PSIGNAL ) : TRISTATE;
PROCEDURE SafeWait( Signal : PSIGNAL; Timeout : CARDINAL ) : TAsyncResult;
PROCEDURE SafeState( Signal : PSIGNAL ) : TRISTATE;

(*================================================================================*)
// continuation of locking
// only ltILock has no effect

TYPE
   PRWLOCK = POINTER TO RWLOCK;

CLASS RWLOCK IMPLEMENTS IRLock; // single writer, multiple readers, fast; inspired from: http://blogs.msdn.com/vancem/attachment/563180.ashx

   // ILock, locks for writing
   PUBLIC VIRTUAL PROCEDURE Lock() : TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE LockTimeout( Timeout : CARDINAL ) : TAsyncResult; // not applicable for CS if Timeout > 0
   PUBLIC VIRTUAL PROCEDURE Unlock();

   // IRLock, locks for reading
   PUBLIC VIRTUAL PROCEDURE LockRead( Timeout : CARDINAL ) : TAsyncResult; // not applicable for CS if Timeout > 0
   PUBLIC VIRTUAL PROCEDURE UnlockRead();

   // SELF
   PUBLIC PROCEDURE Init( Type : TLockType; CONST Name : ARRAY OF WCHAR ); // if lock time is expected to be short, use ltSpin, otherwise consider using of ltCS/ltMutex (they are the same for RWLock)
   
   PUBLIC PROCEDURE LockWrite( Timeout : CARDINAL ) : TAsyncResult;
   PUBLIC PROCEDURE UnlockWrite();
   
   PRIVATE PROCEDURE WaitOnSignal( REF Signal : SIGNAL; REF Waiters : CARDINAL; Timeout : CARDINAL ) : TAsyncResult;
   PRIVATE PROCEDURE UnlockAndWakeUpAppropriateWaiters();

   PRIVATE VAR
      _Lock : LOCK;
      Owners : INTEGER;
      WriteSignal : SIGNAL;
      WriteWaiters : CARDINAL;
      ReadSignal : SIGNAL;
      ReadWaiters : CARDINAL;

END RWLOCK;

(*================================================================================*)
// continuation of locking
// automatic lock

CLASS AutoLock IMPLEMENTS IRLock; // gets outer ILock, locks it inside Take, unlocks it inside FINALLY

   // ILock, locks for writing
   PUBLIC VIRTUAL PROCEDURE Lock() : TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE LockTimeout( Timeout : CARDINAL ) : TAsyncResult; // not applicable for CS if Timeout > 0
   PUBLIC VIRTUAL PROCEDURE Unlock();

   // IRLock, locks for reading
   PUBLIC VIRTUAL PROCEDURE LockRead( Timeout : CARDINAL ) : TAsyncResult; // not applicable for CS if Timeout > 0
   PUBLIC VIRTUAL PROCEDURE UnlockRead();

   // SELF
   PUBLIC PROCEDURE Take( REF LockToOwn : ILock; Timeout : CARDINAL ) : Sync.TAsyncResult; // locks for write
   PUBLIC PROCEDURE TakeSafe( REF LockToOwn : ILock; CONST FailureDescription : ARRAY OF WCHAR ) : Sync.TAsyncResult; // locks for write, uses FORSAFETY

   PUBLIC PROCEDURE TakeRead( REF LockToOwn : ILock; Timeout : CARDINAL ) : Sync.TAsyncResult; // effective for RWLOCK, locks for READ
   PUBLIC PROCEDURE TakeReadSafe( REF LockToOwn : ILock; CONST FailureDescription : ARRAY OF WCHAR ) : Sync.TAsyncResult; // effective for RWLOCK, locks for READ, uses FORSAFETY

   PUBLIC PROCEDURE Attach( REF LockToOwn : ILock ); // does not lock
   PUBLIC PROCEDURE Detach() : PILock; // does not unlock

   PUBLIC FINALLY AutoLock();

   PRIVATE VAR
      _OwnedLock : PILock;
      _Read : BOOLEAN;

   PRIVATE OPERATOR NEW( size : CARDINAL ) : ADDRESS; // the class cannot exist on the heap

END AutoLock;

(*================================================================================*)
// queuing

TYPE
  TpcqSignal = (
    pcqProduced, pcqConsumed, // normal signals
    pcqProducedFlush, pcqConsumedFlush // emergency signals called from Flush
  );

(*--------------------------------------------------------------------------------*)
// OneToOneQueue: single producer, single consumer, variable length blocks

TYPE
  TPOneToOneQueue = POINTER TO OneToOneQueue;

CLASS OneToOneQueue;
  INTERNAL READONLY VAR
    _Head : CARDINAL;
    _Tail : CARDINAL;
    _Size : CARDINAL := 4096;
  PUBLIC READONLY PROPERTY
    Count : CARDINAL; // occupied
    Empty : BOOLEAN;
    Full : BOOLEAN;
  PUBLIC VIRTUAL PROPERTY
    Size : CARDINAL;

  // common
  PUBLIC PROCEDURE Clear();

  // producer
  PUBLIC PROCEDURE StartProducing( LengthToProduce : CARDINAL; OUT ProduceTo : CARDINAL; OUT AllowedToProduce : CARDINAL ) : BOOLEAN;
  PUBLIC PROCEDURE CommitProducing( Produced : CARDINAL );

  // consumer
  PUBLIC PROCEDURE StartConsuming( LengthToConsume : CARDINAL; OUT ConsumeFrom : CARDINAL; OUT AllowedToConsume : CARDINAL ) : BOOLEAN;
  PUBLIC PROCEDURE CommitConsuming( Consumed : CARDINAL );

  // both side, usualy implemented using ONE signal/message
  INTERNAL VIRTUAL PROCEDURE Signal( What : TpcqSignal ); // when produced, next producing SHOULD NOT be signalled (until signalling consumed)

  // helper
  INTERNAL INLINE PROCEDURE ToOutIndex( Index : CARDINAL ) : CARDINAL;
END OneToOneQueue;

(*--------------------------------------------------------------------------------*)
// NToOneQueue: multiple producers, single consumer, single length (1) blocks

TYPE
  TPNToOneQueue = POINTER TO NToOneQueue;

ABSTRACT CLASS NToOneQueue;
  INTERNAL READONLY VAR
    _Head : CARDINAL;
    _Tail : CARDINAL;
    _Size : CARDINAL := 256;
    _Lock : CARDINAL;
  PUBLIC READONLY PROPERTY
    Count : CARDINAL;
    Empty : BOOLEAN;
    Full : BOOLEAN;
  PUBLIC VIRTUAL PROPERTY
    Size : CARDINAL;

  // common
  PUBLIC PROCEDURE Clear();

  // producer
  PUBLIC PROCEDURE StartProducing( OUT ProduceTo : CARDINAL ) : BOOLEAN;
  PUBLIC PROCEDURE CommitProducing( Produced : CARDINAL );
  INTERNAL ABSTRACT PROCEDURE Validate( Block : CARDINAL );

  // consumer
  PUBLIC PROCEDURE StartConsuming( OUT ConsumeFrom : CARDINAL ) : BOOLEAN;
  PUBLIC PROCEDURE CommitConsuming();
  INTERNAL ABSTRACT PROCEDURE IsValid( Block : CARDINAL ) : BOOLEAN;
  INTERNAL ABSTRACT PROCEDURE Invalidate( Block : CARDINAL );

  // both side, usualy implemented using ONE signal/message
  INTERNAL VIRTUAL PROCEDURE Signal( What : TpcqSignal ); // when produced, next producing SHOULD NOT be done (until signalling consumed)

  // helper
  INTERNAL INLINE PROCEDURE ToOutIndex( Index : CARDINAL ) : CARDINAL;
END NToOneQueue;

(*--------------------------------------------------------------------------------*)
// WriteBuffer: multiple producers, indexes turn around Size, single length (1) blocks

TYPE
   TPWriteBuffer = POINTER TO WriteBuffer;
   
CLASS WriteBuffer; // in-process only
  INTERNAL READONLY VAR
    _Head : CARDINAL;
    _Tail : CARDINAL;
    _Lock : RWLOCK;
  INTERNAL VAR
    _Size : CARDINAL := 256;
  PUBLIC READONLY PROPERTY
    Count : CARDINAL;
    Empty : BOOLEAN;
    Full : BOOLEAN;
  PUBLIC VIRTUAL PROPERTY
    Size : CARDINAL;

  // common
  PUBLIC PROCEDURE Clear();

  // writers
  PUBLIC PROCEDURE StartProducing( Overwrite : BOOLEAN; OUT ProduceTo : CARDINAL ) : BOOLEAN; // Overwrite in case of fill buffer rewrites first item, NOT Overwrite in that case returns FALSE
  PUBLIC PROCEDURE CommitProducing();

  // readers
  PUBLIC PROCEDURE StartReading( Index : CARDINAL; OUT ReadFrom : CARDINAL ) : BOOLEAN;
  PUBLIC PROCEDURE CommitReading();

  // helper
  INTERNAL INLINE PROCEDURE ToOutIndex( Index : CARDINAL ) : CARDINAL;
END WriteBuffer;

(*================================================================================*)

#restore

END Sync.
