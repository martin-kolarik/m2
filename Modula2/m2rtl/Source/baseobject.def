DEFINITION MODULE baseobject;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

// Ancestors having specialized some common behavior

(*===========================================================================*)

#save, option( dll_export => on )

TYPE
   PBASE = POINTER TO BASE;

CLASS BASE;
   // intentionally empty
END BASE;

(*---------------------------------------------------------------------------*)

TYPE
   TPIDisposable = POINTER TO IDisposable;

INTERFACE IDisposable; // interface with Dispose, the method disposing all implementor's data

   PROCEDURE Dispose();

END IDisposable;

(*---------------------------------------------------------------------------*)

TYPE
   TPDisposable = POINTER TO CDisposable;

CLASS CDisposable( BASE ) IMPLEMENTS IDisposable; // class with Dispose and destructor linked to it. The class should be seen as base of reference types.

   // IDisposable
   PUBLIC VIRTUAL PROCEDURE Dispose();

   // CDisposable
   PUBLIC VIRTUAL FINALLY CDisposable();

END CDisposable;

#restore   

(*===========================================================================*)

END baseobject.