DEFINITION MODULE delegate;
// Modula2 Delegates handling module -- Delegate is an object, which is shared between more owners.
// The object solves race condition during finishing/deallocating.

IMPORT
   basecompletion,
   baseobject,
   Sync;

#save, option( dll_export => on )

(*================================================================================*)

CLASS Delegate( baseobject.CRefcounted );
// AFTER CREATION (either static or NEW) THE _References = 1, see CRefcounted !!
// This simplifies usage to NEW/Release only and solves problems with static instances,
// for which AddRef/Release is used.

   // CRefcounted
   // AddRef
   // Release

   // SELF
   PUBLIC PROPERTY
      Value : PTR; // to store user data

   PRIVATE VAR
      _Value : PTR := 0;

END Delegate;

(*================================================================================*)

#restore

END delegate.
