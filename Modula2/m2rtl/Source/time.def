DEFINITION MODULE Time;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   Languages;

(*================================================================================================*)

#save, option( dll_export => on )

TYPE
  TTime64  = INT64;
  TPTime64 = POINTER TO TTime64;

PROCEDURE UptimeMS(): CARDINAL; // returns time from system startup in ms
PROCEDURE UptimeMS64(): TTime64; // returns time from system startup in ms

// high resolution timer
PROCEDURE GetHiResHz() : TTime64;
PROCEDURE GetHiResTicks() : TTime64;
PROCEDURE GetHiResDifference( REF fromTick : TTime64 ) : TTime64; // returns amount of ticks and sets fromTime to the current ticks
PROCEDURE HiResTicksToLRS( ticks : TTime64 ) : LONGREAL; // converts ticks to seconds
PROCEDURE HiResTicksToLRMS( ticks : TTime64 ) : LONGREAL; // converts ticks to miliseconds
PROCEDURE HiResTicksToMS( ticks : TTime64 ) : TTime64; // converts ticks to miliseconds

// like c/time
CONST
  time ::= GetHiResTicks;
PROCEDURE difftime( CONST StopTime, StartTime : TTime64 ) : LONGREAL; // seconds

(*================================================================================================*)
// JulianDate routines

TYPE
   TJD  = INT64; // unit is 100 us
   TPJD = POINTER TO INT64;

   TJDC = TJD; // type interpreted as count of 100 us unit, not as whole JD

CONST
   unitsInMillisecond = TJD( 10 );
   unitsInSecond = TJD( 10000 );
   unitsInDay = TJD( 864000000 ); 

PROCEDURE fd( ri : TJD ) : CARDINAL;
PROCEDURE HMS2fd( H, M, S, MS : CARDINAL ) : CARDINAL;
PROCEDURE fd2HMS( fd : CARDINAL; OUT H, M, S, MS : CARDINAL ) : BOOLEAN;

PROCEDURE JD( y : INTEGER; m, d, fd : CARDINAL ) : TJD;
PROCEDURE iJD( CONST jd : TJD; OUT y : INTEGER; OUT m, d, fd : CARDINAL );
PROCEDURE DayOfWeek( CONST jd : TJD ) : CARDINAL; // 0 is monday, 6 is sunday
PROCEDURE TrimFD( CONST jd : TJD ) : TJD;

PROCEDURE JDCToMS( CONST jd : TJDC ) : CARDINAL;
PROCEDURE MSToJDC( ms : CARDINAL ) : TJDC;
PROCEDURE JDCToDays( CONST jd : TJDC ) : CARDINAL;
PROCEDURE DaysToJDC( days : CARDINAL ) : TJDC;
PROCEDURE JDCToDaysLR( CONST jd : TJDC ) : LONGREAL;
PROCEDURE DaysLRToJDC( days : LONGREAL ) : TJDC;

PROCEDURE ToSJD( CONST jd : TJD ) : LONGREAL; // correct scientific Julian date
PROCEDURE FromSJD( sjd : LONGREAL ) : TJD; // correct scientific Julian date

(*================================================================================================*)
// UTCBias always represents zone time only, thus,
// real bias of UTC is to be counted as addition of both UTCBias and DSTBias

PROCEDURE GetZonalUTCBias() : INTEGER; // MINUTES!!
  // returns bias according to system time zone
PROCEDURE GetZonalDSTBias() : INTEGER; // MINUTES!!
  // returns bias according to current time zone ignoring current DST state
PROCEDURE GetCurrentUTCBias() : INTEGER; // MINUTES!! 
  // returns whole local bias
PROCEDURE GetCurrentDSTBias() : INTEGER; // MINUTES;
  // returns bias in current zone according to current DST state

// procedures return current local/system datetime in requested format
PROCEDURE GetCurrentJD() : TJD; // JD is by definition UTC

(*================================================================================================*)
// date and time support

TYPE
   TPDateTime  = POINTER TO DateTime;

CLASS DateTime;

   PUBLIC PROPERTY
      Millisecond : CARDINAL;
      Second      : CARDINAL;
      Minute      : CARDINAL;
      Hour        : CARDINAL;
      Day         : CARDINAL;
      Month       : CARDINAL;
      Year        : INTEGER;
      UTCBias     : INTEGER;
      DSTBias     : INTEGER;
   PUBLIC READONLY PROPERTY
      Empty : BOOLEAN;
      DstActive : BOOLEAN;
      DayOfWeek : CARDINAL; // 0 is Sunday
   PUBLIC PROPERTY
      JulianDate : TJD; // set sets biases to UTC, for another biases use FromJD
      
   PUBLIC OPERATOR =( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR <>( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR <( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR <=( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR >( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR >=( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC OPERATOR +( Addend : TJDC ) : DateTime;
   PUBLIC OPERATOR -( Addend : TJDC ) : DateTime;
        
   PUBLIC PROCEDURE Clear();
   PUBLIC PROCEDURE TrimDate();
   PUBLIC PROCEDURE TrimTime();
   PUBLIC PROCEDURE SetNowLocal();
   PUBLIC PROCEDURE SetNowUTC();
   PUBLIC PROCEDURE SetZoneToLocal();
   PUBLIC PROCEDURE SetZoneToUTC();
   PUBLIC PROCEDURE SetZone( UTCBias, DSTBias : INTEGER ); // sets both biases in single call
   PUBLIC PROCEDURE FromJDToLocal( JD : TJD ); // JD is missing time zone information, local one will be set
   PUBLIC PROCEDURE FromJD( JD : TJD; UTCBias, DSTBias : INTEGER ); // JD is missing time zone information
   
   PUBLIC PROCEDURE Less( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC PROCEDURE Greater( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC PROCEDURE Equals( CONST Comperand : DateTime ) : BOOLEAN;
   PUBLIC PROCEDURE Add( Addend : TJDC );
   PUBLIC PROCEDURE Subtract( Addend : TJDC );
   PUBLIC PROCEDURE Difference( CONST Operand : DateTime ) : TJDC;
   
   PUBLIC PROCEDURE FromStringOA( CONST String, Format : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE FromLanguageStringOA( Language : Languages.TLanguage; CONST String, Format : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE ToStringOA( Format : ARRAY OF WCHAR; FormatDate : BOOLEAN; FormatTime : BOOLEAN; OUT String : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE ToLanguageStringOA( Language : Languages.TLanguage; Format : ARRAY OF WCHAR; FormatDate : BOOLEAN; FormatTime : BOOLEAN; OUT String : ARRAY OF WCHAR ) : BOOLEAN;

   PRIVATE VAR
      _Empty       : BOOLEAN;
      _Millisecond : CARDINAL;
      _Second      : CARDINAL;
      _Minute      : CARDINAL;
      _Hour        : CARDINAL;
      _Day         : CARDINAL;
      _Month       : CARDINAL;
      _Year        : INTEGER;
      _DayOfWeek   : CARDINAL;
      _DayOfWeekDirty : BOOLEAN;
      // UTC = LocalTime + UTCBias + DSTBias
      // biases are in minutes
      _UTCBias     : INTEGER;  // if DateTime contains system (UTC) time, the UTCBias is 0
      _DSTBias     : INTEGER;  // if DateTime contains system (UTC) time, the DSTBias is 0
END DateTime;

(*================================================================================================*)

INITIALLY __I();

(*================================================================================================*)

#restore

END Time.