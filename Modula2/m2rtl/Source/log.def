DEFINITION MODULE log;

(*===========================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   Exceptions,
   iLog,
   Sync;

(*===========================================================================*)

#save, option( dll_export => on )

TYPE
   TRStatusItem = (
      rsDebugFile,
      rsDebugKernel,
      rsTimeStamps,
      rsLocalTime,
      rsLevelInfo,
      rsNameInfo,
      rsInject
   );
   TRStatus = SET OF TRStatusItem;

   TOutputItem = (
      outFile, // uses no CFileOutput
      outKernel // uses CKernelOutput
   );
   TOutput = SET OF TOutputItem;
   
   TPLevelFilter = POINTER TO CLevelFilter;
   TPALogger = POINTER TO ALogger;
   TPLogger = POINTER TO CRedirectableLogger;
   TPBufferedLogger = POINTER TO CBufferedLogger;
   
CONST
   TPIFilter   ::= iLog.TPFilter;
   TPILogger   ::= iLog.TPLogger;

   TLevel ::= iLog.TLevel;   

   lcSysError ::= iLog.lcSysError; // critical severity, Fatal
   lcError    ::= iLog.lcError; // Error
   lcWarning  ::= iLog.lcWarning; // Warning
   lcInfo     ::= iLog.lcInfo; // very low severity, Info

   ldError    ::= iLog.ldError; // brief, debug Xtra problem
   ldMessage  ::= iLog.ldMessage; // debug Message
   ldTrace    ::= iLog.ldTrace; // debug Trace
   ldDebug    ::= iLog.ldDebug; // exhaustive, Debug

(*---------------------------------------------------------------------------*)

// global system instances
PROCEDURE logger() : TPBufferedLogger;

(*---------------------------------------------------------------------------*)

CLASS CLevelFilter IMPLEMENTS iLog.IFilter;

   // IFilter
   PROCEDURE FilteredFastCheck( Level : TDebugLevel ) : BOOLEAN;
   PROCEDURE FilteredFullCheck( Level : TDebugLevel; UserData : PTR; CONST Logger, Prefix, Message : ARRAY OF WCHAR ) : BOOLEAN;

   // SELF
   PUBLIC PROPERTY
      Level : TDebugLevel;
      
   PRIVATE VAR
      _Level : TLevel;

END CLevelFilter;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS AFormatter IMPLEMENTS iLog.IOutput;

   // IOutput
   PUBLIC FINAL PROCEDURE Append( Level : TDebugLevel; UserData : PTR; CONST Logger, Prefix, Message : ARRAY OF WCHAR );
   
   // SELF
   INTERNAL VIRTUAL PROCEDURE Output( CONST Message : ARRAY OF WCHAR );  // to rewrite

   LOCAL VAR
      TimeStamps : BOOLEAN := TRUE; // prints timestamps
      Levels : BOOLEAN := TRUE; // prints debug level of message
      Names : BOOLEAN := TRUE; // prints names/prefixes of message
      LocalTime : BOOLEAN := FALSE; // uses local time instead of UTC

END AFormatter;

(*---------------------------------------------------------------------------*)

CLASS CKernelOutput( AFormatter );

   // AFormatter
   INTERNAL VIRTUAL PROCEDURE Output( CONST Message : ARRAY OF WCHAR );

END CKernelOutput;

(*---------------------------------------------------------------------------*)

CLASS CFileOutput( AFormatter );

   // AFormatter
   INTERNAL VIRTUAL PROCEDURE Output( CONST Message : ARRAY OF WCHAR );
   
   // self
   PUBLIC PROCEDURE SetFile( CONST File : ARRAY OF WCHAR );
   PUBLIC PROCEDURE GetFile( OUT File : ARRAY OF WCHAR ) : BOOLEAN;

   PRIVATE VAR
      _FileNameLength : CARDINAL;
      _FileName : PWCHAR; // to handle long paths in the future
      _Lock : Sync.LOCK;

   PRIVATE PROCEDURE TrySetFileToDefault();

END CFileOutput;

(*---------------------------------------------------------------------------*)

TYPE
   TBufferMode = (
      bmStoreFirst, // messages up to BufferLength will be stored
      bmStoreLast // last BufferLength messages will be stored
   );
   
   TPBuffer = POINTER TO CBuffer;

CLASS CBufferOutput( AFormatter );

   // AFormatter
   INTERNAL VIRTUAL PROCEDURE Output( CONST Message : ARRAY OF WCHAR );
   
   // SELF
   PUBLIC PROPERTY
      Size : CARDINAL; // default 256
      Mode : TBufferMode;
   PUBLIC READONLY PROPERTY
      Count : CARDINAL;

   PUBLIC PROCEDURE GetItem( Index : CARDINAL; OUT S : ARRAY OF WCHAR ) : BOOLEAN; // Index = 0 means first
   PUBLIC PROCEDURE Clear();

   PRIVATE VAR
      _Buffer : TPBuffer;
      _Mode : TBufferMode := bmStoreLast;

END CBufferOutput;

(*---------------------------------------------------------------------------*)

CLASS CAppenderOutput IMPLEMENTS iLog.IOutput;

   // IOutput
   PUBLIC VIRTUAL PROCEDURE Append( Level : TDebugLevel; UserData : PTR; CONST Logger, Prefix, Message : ARRAY OF WCHAR );
   
   // SELF
   PUBLIC PROPERTY
      Appender : iLog.TPIAppender;
   
   PRIVATE VAR
      _Appender : ilog.TPIAppender;

END CAppenderOutput;

(*===========================================================================*)

TYPE
   TPOutputs = POINTER TO COutputs;

CLASS CBaseLogger IMPLEMENTS iLog.ILogger, iLog.IAppender;

   // ILogger -- should check filter level (only roughly)
   PUBLIC VIRTUAL PROCEDURE LogS( Level : TDebugLevel; CONST Prefix, S : ARRAY OF WCHAR );
   PUBLIC VIRTUAL PROCEDURE LogSS( Level : TDebugLevel; CONST Prefix, S1, S2 : ARRAY OF WCHAR );
   PUBLIC VIRTUAL PROCEDURE LogSSC( Level : TDebugLevel; CONST Prefix, S1, S2 : ARRAY OF WCHAR; C : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSC( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; C : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSCC( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; C1, C2 : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSH( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; H : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSP( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; P : PTR );
   PUBLIC VIRTUAL PROCEDURE LogSCP( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; C : CARDINAL; P : PTR );
   PUBLIC VIRTUAL PROCEDURE LogSHP( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; H : CARDINAL; P : PTR );
   PUBLIC VIRTUAL PROCEDURE LogSB( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; A : ADDRESS; Bytes : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSCB( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; C : CARDINAL; A : ADDRESS; Bytes : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSSS( Level : TDebugLevel; CONST Prefix, S1, S2, S3 : ARRAY OF WCHAR );
   PUBLIC VIRTUAL PROCEDURE LogSSSS( Level : TDebugLevel; CONST Prefix, S1, S2, S3, S4 : ARRAY OF WCHAR );
  
   PUBLIC VIRTUAL PROCEDURE LogSE( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; ErrorCode : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSR( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; Result : Sync.TAsyncResult );
   PUBLIC VIRTUAL PROCEDURE LogExc( Level : TDebugLevel; CONST Prefix : ARRAY OF WCHAR; CONST e : Exceptions.CException );
   PUBLIC VIRTUAL PROCEDURE LogFilePos( Level : TDebugLevel; CONST Prefix : ARRAY OF WCHAR; CONST Path, S1 : ARRAY OF WCHAR; Line, Col : CARDINAL ); // Line, Col = 0/-1 means unused, unknown
   
   // IAppender -- should check filter thoroughly
   PUBLIC VIRTUAL PROCEDURE Append( Level : TDebugLevel; UserData : PTR; CONST Logger, Prefix, Message : ARRAY OF WCHAR );

   PUBLIC VIRTUAL PROCEDURE SetName( CONST Name : ARRAY OF WCHAR );
   PUBLIC VIRTUAL PROCEDURE GetName( OUT Name : ARRAY OF WCHAR );

   PUBLIC VIRTUAL PROCEDURE AddOutput( Output : TPIOutput );
   PUBLIC VIRTUAL PROCEDURE RemoveOutput( Output : TPIOutput );

   // SELF
   PUBLIC VIRTUAL PROCEDURE SetUpByRegistry( CONST LibraryName : ARRAY OF WCHAR ) : BOOLEAN; // gets config from registry
   PUBLIC VIRTUAL PROCEDURE SetUpByLogger( CONST Logger : CBaseLogger ) : BOOLEAN; // gets config from another existing logger

   PUBLIC PROPERTY
      Filter : TPIFilter;

   PRIVATE VAR
      _Outputs : TPOutputs;
      _Name : ARRAY [0..63] OF WCHAR;
      _Filter : TPIFilter;
  
   PRIVATE PROCEDURE LoadByRegistry( CONST LibraryName : ARRAY OF WCHAR ) : BOOLEAN;
   PRIVATE INLINE PROCEDURE Filtered( Level : TLevel ) : BOOLEAN; // fast check
END CBaseLogger;

(*---------------------------------------------------------------------------*)

LOCAL CLASS CPlainLogger( CBaseLogger );

   // SELF
   PUBLIC VIRTUAL PROCEDURE SetUpByRegistry( CONST LibraryName : ARRAY OF WCHAR ) : BOOLEAN; // gets config from registry
   PUBLIC VIRTUAL PROCEDURE SetUpByLogger( CONST Logger : CBaseLogger ) : BOOLEAN; // gets config from another existing logger

   PUBLIC PROPERTY
      Output : TOutput; // switches output to single output (leaves only single appender)
      Level : TDebugLevel;
      TimeStamps : BOOLEAN; // prints timestamps, default TRUE --> AFormatter
      Levels : BOOLEAN; // prints debug level of message, default TRUE --> AFormatter
      Names : BOOLEAN; // prints names/prefixes of message, default TRUE --> AFormatter
      LocalTime : BOOLEAN; // uses local time instead of UTC --> AFormatter

   PUBLIC PROCEDURE SetLogFile( CONST LogFile : ARRAY OF WCHAR );
   PUBLIC PROCEDURE GetLogFile( OUT LogFile : ARRAY OF WCHAR ) : BOOLEAN;

   // privates
   PRIVATE VAR
      _Output : TOutput; // default is no output
      _LevelFilter : CLevelFilter;
      _KernelOutput : CKernelOutput;
      _FileOutput : CFileOutput;
  
   PRIVATE PROCEDURE LoadByRegistry( CONST LibraryName : ARRAY OF WCHAR ) : BOOLEAN;
   PRIVATE PROCEDURE TrySetFileToDefault();
END CPlainLogger;

CONST
   CLogger ::= CRedirectableLogger;

(*===========================================================================*)

CLASS CBufferedLogger( CPlainLogger );
  
   // SELF
   PUBLIC VIRTUAL PROCEDURE SetUpByLogger( CONST Logger : CBaseLogger ) : BOOLEAN; // gets config from another existing logger

   PUBLIC PROPERTY
      BufferSize : CARDINAL; // default 256
      BufferMode : TBufferMode;
   PUBLIC READONLY PROPERTY
      BufferCount : CARDINAL;

   // buffer read
   PUBLIC PROCEDURE BufferGetItem( Index : CARDINAL; OUT S : ARRAY OF WCHAR ) : BOOLEAN; // Index = 0 means first
   PUBLIC PROCEDURE BufferClear();
   
   // privates
   PRIVATE VAR
      _BufferOutput : CBufferOutput;

END CBufferedLogger;

(*===========================================================================*)
// internally, map of loggers is maintained to be able to connects logger outputs by name for everybody

// Classes derived from CBaseLogger MUST NOT be registered, they are registered automatically
PROCEDURE RegisterAppender( Appender : iLog.TPIAppender );
PROCEDURE ForgetAppender( Appender : iLog.TPIAppender );
PROCEDURE GetAppender( CONST Name : ARRAY OF WCHAR; Appender : iLog.TPIAppender ) : BOOLEAN;

(*===========================================================================*)

END log.