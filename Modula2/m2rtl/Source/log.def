DEFINITION MODULE log;

(*===========================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   Exceptions,
   iLog,
   Sync;

(*===========================================================================*)

#save, option( dll_export => on )

TYPE
   TRStatusItem = (
      rsDebugFile,
      rsDebugKernel,
      rsTimeStamps,
      rsLocalTime,
      rsLevelInfo,
      rsNameInfo,
      rsInject
   );
   TRStatus = SET OF TRStatusItem;

   TDebugMethod = (
      dmNone,
      dmFile,
      dmKernel
   );
   
   TPALogger = POINTER TO ALogger;
   TPLogger = POINTER TO CRedirectableLogger;
   TPBufferedLogger = POINTER TO CBufferedLogger;
   
CONST
   TPIFilter   ::= iLog.TPFilter;
   TPILogger   ::= iLog.TPLogger;

   TDebugLevel ::= iLog.TDebugLevel;   

   dlcSysError ::= iLog.dlcSysError; // critical severity, Fatal
   dlcError    ::= iLog.dlcError; // Error
   dlcWarning  ::= iLog.dlcWarning; // Warning
   dlcInfo     ::= iLog.dlcInfo; // very low severity, Info

   dldError    ::= iLog.dldError; // brief, debug Xtra problem
   dldMessage  ::= iLog.dldMessage; // debug Message
   dldTrace    ::= iLog.dldTrace; // debug Trace
   dldDebug    ::= iLog.dldDebug; // exhaustive, Debug

(*---------------------------------------------------------------------------*)

// global system LOG
PROCEDURE logger() : TPBufferedLogger;

(*---------------------------------------------------------------------------*)

ABSTRACT CLASS ALogger IMPLEMENTS iLog.ILogger;

   // IFilter
   PUBLIC VIRTUAL PROPERTY
      Level : TDebugLevel; // what (and less) will be present in log

   PUBLIC VIRTUAL PROCEDURE Filtered( Level : TDebugLevel; CONST Prefix : ARRAY OF WCHAR ) : BOOLEAN;

   // ILogger
   PUBLIC VIRTUAL PROCEDURE LogS( Level : TDebugLevel; CONST Prefix, S : ARRAY OF WCHAR );
   PUBLIC VIRTUAL PROCEDURE LogSS( Level : TDebugLevel; CONST Prefix, S1, S2 : ARRAY OF WCHAR );
   PUBLIC VIRTUAL PROCEDURE LogSSC( Level : TDebugLevel; CONST Prefix, S1, S2 : ARRAY OF WCHAR; C : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSC( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; C : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSCC( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; C1, C2 : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSH( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; H : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSP( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; P : PTR );
   PUBLIC VIRTUAL PROCEDURE LogSCP( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; C : CARDINAL; P : PTR );
   PUBLIC VIRTUAL PROCEDURE LogSHP( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; H : CARDINAL; P : PTR );
   PUBLIC VIRTUAL PROCEDURE LogSB( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; A : ADDRESS; Bytes : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSCB( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; C : CARDINAL; A : ADDRESS; Bytes : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSSS( Level : TDebugLevel; CONST Prefix, S1, S2, S3 : ARRAY OF WCHAR );
   PUBLIC VIRTUAL PROCEDURE LogSSSS( Level : TDebugLevel; CONST Prefix, S1, S2, S3, S4 : ARRAY OF WCHAR );
  
   PUBLIC VIRTUAL PROCEDURE LogSE( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; ErrorCode : CARDINAL );
   PUBLIC VIRTUAL PROCEDURE LogSR( Level : TDebugLevel; CONST Prefix, S1 : ARRAY OF WCHAR; Result : Sync.TAsyncResult );
   PUBLIC VIRTUAL PROCEDURE LogExc( Level : TDebugLevel; CONST Prefix : ARRAY OF WCHAR; CONST e : Exceptions.CException );
   PUBLIC VIRTUAL PROCEDURE LogFilePos( Level : TDebugLevel; CONST Prefix : ARRAY OF WCHAR; CONST Path, S1 : ARRAY OF WCHAR; Line, Col : CARDINAL ); // Line, Col = 0/-1 means unused, unknown
   
   INTERNAL VIRTUAL PROCEDURE Log( Level : TDebugLevel; CONST Name, Prefix, S : ARRAY OF WCHAR ); // Log does not filter!

   // SELF
   PUBLIC PROPERTY
      Method : TDebugMethod;
      Filter : TPIFilter;
      TimeStamps : BOOLEAN; // prints timestamps, default TRUE
      Levels : BOOLEAN; // prints debug level of message, default TRUE
      Names : BOOLEAN; // prints names/prefixes of message, default TRUE
      LocalTime : BOOLEAN; // uses local time instead of UTC

   PUBLIC PROCEDURE SetLogName( CONST Name : ARRAY OF WCHAR );
   PUBLIC PROCEDURE GetLogName( OUT Name : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE SetLogFile( CONST LogFile : ARRAY OF WCHAR );
   PUBLIC PROCEDURE GetLogFile( OUT LogFile : ARRAY OF WCHAR ) : BOOLEAN;

   PUBLIC PROCEDURE SetUpByRegistry( CONST LibraryName : ARRAY OF WCHAR ) : BOOLEAN; // gets config from registry
   PUBLIC PROCEDURE SetUpByLogger( CONST Logger : ALogger ) : BOOLEAN; // gets config from another existing logger

   // for internal rewritting
   INTERNAL VIRTUAL PROCEDURE EmitLog( REF OutputString : ARRAY OF WCHAR );
   // for user rewritting
   INTERNAL VIRTUAL PROCEDURE OnLogOutputString( CONST OutputString : ARRAY OF WCHAR );

   // privates
   PRIVATE VAR
      RStatus    : TRStatus;
      Name       : ARRAY [0..63] OF WCHAR;
      LogFilter  : TPIFilter;
      DebugLevel : TDebugLevel;
      DebugFile  : ARRAY [0..260] OF WCHAR;
      DebugLock  : Sync.LOCK;
  
   PRIVATE PROCEDURE LoadByRegistry( CONST LibraryName : ARRAY OF WCHAR ) : BOOLEAN;
   PRIVATE PROCEDURE TrySetFileToDefault();
END ALogger;

(*===========================================================================*)

CLASS CRedirectableLogger( ALogger );

   // ALogger
   INTERNAL VIRTUAL PROCEDURE Log( LoggedLevel : TDebugLevel; CONST Name, Prefix, S : ARRAY OF WCHAR );

   // SELF
   PUBLIC PROPERTY
      RedirectTo : TPALogger; // all output will be passed to another log respecting its level settins -- level is driven by destination logger, mutually exclusive with InjectTo
      InjectTo : TPALogger;  // all output will be passed to another log NOT respecting its level settings -- level is driven by source logger, mutually exclusive with RedirectTo

   // privates
   PRIVATE VAR
      _Injecting : BOOLEAN := FALSE;
      _PassTo : TPALogger := NIL;
END CRedirectableLogger;

CONST
   CLogger ::= CRedirectableLogger;

(*===========================================================================*)

TYPE
   TBufferMode = (
      bmStoreFirst, // messages up to BufferLength will be stored
      bmStoreLast // last BufferLength messages will be stored
   );
   
   TPBuffer = POINTER TO CBuffer;

(*---------------------------------------------------------------------------*)

CLASS CBufferedLogger( CRedirectableLogger );
  
   // ALogger
   INTERNAL VIRTUAL PROCEDURE EmitLog( REF OutputString : ARRAY OF WCHAR );

   // SELF
   PUBLIC PROCEDURE SetUpByLogger( CONST Logger : CBufferedLogger ) : BOOLEAN; // gets config from another existing logger

   PUBLIC PROPERTY
      Buffered : BOOLEAN;
      BufferSize : CARDINAL; // default 256
      BufferMode : TBufferMode;
   PUBLIC READONLY PROPERTY
      BufferCount : CARDINAL;

   // buffer read
   PUBLIC PROCEDURE BufferGetItem( Index : CARDINAL; OUT S : ARRAY OF WCHAR ) : BOOLEAN; // Index = 0 means first
   PUBLIC PROCEDURE BufferClear();

   // privates
   PRIVATE VAR
      _Buffer : TPBuffer;
      _BufferMode : TBufferMode := bmStoreLast;
END CBufferedLogger;

(*===========================================================================*)

END log.