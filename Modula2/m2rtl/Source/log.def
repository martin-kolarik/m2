DEFINITION MODULE log;

(*===========================================================================*)

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   Exceptions,
   Sync;

(*===========================================================================*)

TYPE
   TRStatusItem = (
      rsDebugFile,
      rsDebugKernel,
      rsTimeStamps,
      rsLevelInfo,
      rsNameInfo,
      rsInject
   );
   TRStatus = SET OF TRStatusItem;

   TDebugMethod = (
      dmNone,
      dmFile,
      dmKernel
   );

   TDebugLevel = (
      dlcSysError, dldError, // critical severity OR brief         // Fatal,   debug Xtra problem
      dlcError,    dldMessage,                                     // Error,   debug Message
      dlcWarning,  dldTrace,                                       // Warning, debug Trace
      dlcInfo,     dldDebug // very low severity OR exhaustive     // Info,    debug Debug
   );

TYPE
   TPLogger = POINTER TO CLogger;
   TPBuffer = POINTER TO CBuffer;

TYPE
   TBufferMode = (
      bmStoreFirst, // messages up to BufferLength will be stored
      bmStoreLast // last BufferLength messages will be stored
   );

#save, option( dll_export => on )

CLASS CLogger;
   PRIVATE VAR
      RStatus     : TRStatus;
      Name        : ARRAY [0..63] OF WCHAR;
      DebugLevel  : TDebugLevel;
      DebugFile   : ARRAY [0..260] OF WCHAR;
      DebugLock   : Sync.LOCK;
      Buffer      : TPBuffer;
      _BufferMode : TBufferMode := bmStoreLast;
      _PassTo     : TPLogger := NIL;
  
   PUBLIC PROPERTY
      Method : TDebugMethod;
      Level : TDebugLevel; // what (and less) will be present in log
      TimeStamps : BOOLEAN; // prints timestamps, default TRUE
      Levels : BOOLEAN; // prints debug level of message, default TRUE
      Names : BOOLEAN; // prints names/prefixes of message, default TRUE
      Buffered : BOOLEAN;
      BufferSize : CARDINAL; // default 256
      BufferMode : TBufferMode;
      RedirectTo : TPLogger; // all output will be passed to another log respecting its level settins -- level is driven by destination logger, mutually exclusive with InjectTo
      InjectTo : TPLogger;  // all output will be passed to another log NOT respecting its level settings -- level is driven by source logger, mutually exclusive with RedirectTo

   PUBLIC PROCEDURE SetLogName( CONST Name : ARRAY OF WCHAR );
   PUBLIC PROCEDURE GetLogName( OUT Name : ARRAY OF WCHAR ) : BOOLEAN;
   PUBLIC PROCEDURE SetLogFile( CONST LogFile : ARRAY OF WCHAR );
   PUBLIC PROCEDURE GetLogFile( OUT LogFile : ARRAY OF WCHAR ) : BOOLEAN;

   PUBLIC PROCEDURE SetUpByRegistry( CONST LibraryName : ARRAY OF WCHAR ) : BOOLEAN; // gets config from registry
   PUBLIC PROCEDURE SetUpByLogger( CONST Logger : CLogger ) : BOOLEAN; // gets config from another existing logger

   PUBLIC PROCEDURE Filtered( Level : TDebugLevel ) : BOOLEAN;

   PUBLIC PROCEDURE LogS( Level : TDebugLevel; Prefix, S : ARRAY OF WCHAR );
   PUBLIC PROCEDURE LogSS( Level : TDebugLevel; Prefix, S1, S2 : ARRAY OF WCHAR );
   PUBLIC PROCEDURE LogSE( Level : TDebugLevel; Prefix, S1 : ARRAY OF WCHAR; ErrorCode : CARDINAL );
   PUBLIC PROCEDURE LogSR( Level : TDebugLevel; Prefix, S1 : ARRAY OF WCHAR; Result : Sync.TAsyncResult );
   PUBLIC PROCEDURE LogSC( Level : TDebugLevel; Prefix, S1 : ARRAY OF WCHAR; C : CARDINAL );
   PUBLIC PROCEDURE LogSH( Level : TDebugLevel; Prefix, S1 : ARRAY OF WCHAR; H : CARDINAL );
   PUBLIC PROCEDURE LogSP( Level : TDebugLevel; Prefix, S1 : ARRAY OF WCHAR; P : PTR );
   PUBLIC PROCEDURE LogSCP( Level : TDebugLevel; Prefix, S1 : ARRAY OF WCHAR; C : CARDINAL; P : PTR );
   PUBLIC PROCEDURE LogSHP( Level : TDebugLevel; Prefix, S1 : ARRAY OF WCHAR; H : CARDINAL; P : PTR );
   PUBLIC PROCEDURE LogSB( Level : TDebugLevel; Prefix, S1 : ARRAY OF WCHAR; A : ADDRESS; Bytes : CARDINAL );
   PUBLIC PROCEDURE LogSCB( Level : TDebugLevel; Prefix, S1 : ARRAY OF WCHAR; C : CARDINAL; A : ADDRESS; Bytes : CARDINAL );
   PUBLIC PROCEDURE LogSSS( Level : TDebugLevel; Prefix, S1, S2, S3 : ARRAY OF WCHAR );
   PUBLIC PROCEDURE LogSSSS( Level : TDebugLevel; Prefix, S1, S2, S3, S4 : ARRAY OF WCHAR );
  
   PUBLIC PROCEDURE LogExc( Level : TDebugLevel; Prefix : ARRAY OF WCHAR; CONST e : Exceptions.CException );
   PUBLIC PROCEDURE LogFilePos( Level : TDebugLevel; Prefix : ARRAY OF WCHAR; Path, S1 : ARRAY OF WCHAR; Line, Col : CARDINAL ); // Line, Col = 0/-1 means unused, unknown
   
   // buffer read
   PUBLIC READONLY PROPERTY
      BufferCount : CARDINAL;
   PUBLIC PROCEDURE BufferGetItem( Index : CARDINAL; OUT S : ARRAY OF WCHAR ) : BOOLEAN; // Index = 0 means first
   PUBLIC PROCEDURE BufferClear();

   // for internal rewrite
   INTERNAL VIRTUAL PROCEDURE Log( LoggedLevel : TDebugLevel; CONST Name, Prefix, S : ARRAY OF WCHAR );
   // for user rewrite
   INTERNAL VIRTUAL PROCEDURE OnLogOutputString( CONST OutputString : ARRAY OF WCHAR );

   PRIVATE PROCEDURE LoadByRegistry( CONST LibraryName : ARRAY OF WCHAR ) : BOOLEAN;
   PRIVATE PROCEDURE LoadByLogger( CONST Logger : CLogger ) : BOOLEAN;
   PRIVATE PROCEDURE TrySetFileToDefault();
END CLogger;

// global system LOG
PROCEDURE logger() : TPLogger;

#restore

(*===========================================================================*)

END log.