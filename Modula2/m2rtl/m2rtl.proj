<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ProjectDescription>Modula 2 Runtime Library</ProjectDescription>
        <ProjectVersionMajor>1</ProjectVersionMajor>
        <ProjectVersionMinor>1</ProjectVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib;API\win32;API\yeppp"/>
        <Definitions Include="Rtti"/>
        <Modules Include="Exceptions;Storage;lr;lrconv;Strings;FIO;datetime;MathYep;Mathematics;Languages;Sync;SyncQueue;iLog;Log;iPlugin;Folders;Debug;Tls;baseobject;basecompletion;collection;delegate;Request"/>
        <!-- Messages Include="XX1;XX2"/ -->
        <Library Include="advapi32.lib"/><!-- needed for Log -->
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
