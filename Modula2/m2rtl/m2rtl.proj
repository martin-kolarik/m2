<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets = "Build" >

    <!-- 1 -->
    <PropertyGroup>
        <ProjectDescription>Modula 2 Runtime Library</ProjectDescription>
        <ProjectVersionMajor>1</ProjectVersionMajor>
        <ProjectVersionMinor>1</ProjectVersionMinor>
    </PropertyGroup>

    <!-- 2 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 -->
    <ItemGroup>
        <Components Include="Modula2\modula2;API\CLib;API\win32"/>
        <Definitions Include="Rtti"/>
        <Modules Include="Exceptions;Storage;lrconv;Strings;FIO;datetime;Mathematics;Languages;Sync;SyncQueue;Delegate;iLog;Log;iPlugin;Folders;Debug;Tls;baseobject;collection"/>
        <!-- Messages Include="XX1;XX2"/ -->
        <Libraries Include="advapi32"/>
        <Interface Include="advapi32"/>
    </ItemGroup>

    <!-- 4 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
