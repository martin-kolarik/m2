<?xml version="1.0" encoding="utf-8"?>
<pageTemplate xmlns:pt="http://www.smartcontrol.cz/2008/XML/Web/PageTemplate" contenttype="text/html">

    <html>
        <head>
            <title>11 intervals.pt.xml</title>
        </head>
        <body>
            <h1>Coloring by values interval</h1>

            <pt:variable model="value" source="${get(5/0/0)}" />

            <pt:choose>
                <pt:when condition="less(value,10)">
                    <p style="color: blue;">Cold</p>
                </pt:when>
                <pt:when condition="less(value,15)">
                    <p style="color: cyan;">Getting warmer</p>
                </pt:when>
                <pt:when condition="less(value,20)">
                    <p style="color: yellow;">Warm</p>
                </pt:when>
                <pt:when condition="less(value,25)">
                    <p style="color: orange;">Still not hot</p>
                </pt:when>
                <pt:otherwise>
                    <p style="color: red;">Hot</p>
                </pt:otherwise>
            </pt:choose>
        </body>
    </html>

</pageTemplate>
