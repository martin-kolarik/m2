<?xml version="1.0" encoding="utf-8"?>
<pageTemplate xmlns:pt="http://www.smartcontrol.cz/2008/XML/Web/PageTemplate" contenttype="text/html">
    <html>
        <head>
            <title>NeNo KNXSrv</title>
            <link rel="StyleSheet" type="text/css" href="NeNo.css" />
        </head>
        <body>
            <div class="shell">
                <div class="shell-topstrip"></div>
                <div class="canvas">

                    <div class="top">
                    </div>

                    <div class="middle">

                        <div class="content">

                            <h1 class="mainTitle">${msg.index.text}</h1>

                            <h2>
                                <pt:choose>
                                    <pt:when condition="${isLogged}"><a href="status">${msg.index.private}</a></pt:when>
                                    <pt:otherwise><a href="login">${msg.index.private}</a></pt:otherwise>
                                </pt:choose>
                            </h2>
                            <h2><a href="User/index.html">${msg.index.user}</a></h2>

                        </div>
                    </div>

                    <div class="bottom">
                        <p>KNX SmartServer © NeNo ver. ${version}</p>
                    </div>

                </div>
            </div>
        </body>
    </html>
</pageTemplate>
