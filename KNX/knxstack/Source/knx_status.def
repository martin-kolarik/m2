DEFINITION MODULE knx_status;

(*================================================================================*)
// common

TYPE
  TEIBStackStatus = (
    // common
    essOK,
    essConError,
    essConnectError,

    // physical
    essLineBusy,
    essLineCollision,
    essTransceiverFault,
    essBitError,
    essParityError,

    // physical, link
    essL_Layer_Undefined,
    essL_Bad_Address_Type,
    essFrameError,
    essL_Timeout,
    essL_OutputQueueOverflow,

    // transport
    essT_Bad_Address_Type,
    essT_Connection_Already_Exists,
    essT_Connection_Bad_State,

    // application
    essA_Layer_Undefined,
    essA_Bad_Address_Type,
    essA_AlreadyPending,
    essA_Timeout,
    essA_ReadQueueOverflow,
    essA_WriteQueueOverflow,
    essA_PromiscuousSubscribeDisallowed,

    // user
    essAU_NoAddress,
    essAU_Pending,
    essAU_TransmitDisallowed,

    // stack
    essUnableToCreateLayer,
    essAlreadyConnected,
    essNotConnected,
    essAlreadyFinalized,
    addFinalized
  );

  TEIBStackLayerType = (
    eltUndefined,
    eltAbstract,
    eltPhysical,
    eltLink,
    eltNetwork,
    eltTransport,
    eltApplication,
    eltUser
  );

END knx_status.