DEFINITION MODULE knxcore;

FROM Storage IMPORT
   ALLOCATE, DEALLOCATE;

IMPORT
   arrays,
   device,
   Event,
   knx_def,
   knx_stack,
   knx_status,
   knx_user,
   io,
   iobject,
   iovalue,
   lec,
   list,
   lists,
   log,
   msghandler,
   ns,
   nsimpl,
   Resources,
   StringsO;

//================================================================================

TYPE
   TPKNXServer = POINTER TO CKNXServer;
   TPObject = POINTER TO CObject;
   
TYPE
   TObjectTypeItem = (
      objtLogNoChange, // behavior
      objtLogOnChange, // behavior
      objtMultipleAddresses, // read helper
      objtESFStrict, // read helper
      objtESFAdapt, // read helper
      objtESFIgnore, // read helper
      objtDate, // read helper
      objtTime // read helper
   );
   TObjectType = SET OF TObjectTypeItem;

//--------------------------------------------------------------------------------

CLASS CObject( knx_user.CUserObject );
   Server             : TPKNXServer;

   Name               : StringsO.CString;
   Comment            : StringsO.CString;
   StringValue        : StringsO.CString; // to accomodate strings longer than 14 bytes

   RSStatus           : knx_status.TKNXStackStatus;
   WSStatus           : knx_status.TKNXStackStatus;
   ReadRepeatCount    : CARDINAL;
   RecoveryExpiration : CARDINAL;
   _ObjectType        : TObjectType;
   _ChangedOnWrite    : TRISTATE;
   _Pairs             : ns.TPNameValuePairs;
   
   PUBLIC PROPERTY
      ObjectType : TObjectType;
      ChangedOnWrite : TRISTATE;
      Pairs : ns.TPNameValuePairs;

   PUBLIC PROCEDURE LogNumber() : CARDINAL;

   // rewritten due to locking
   INTERNAL VIRTUAL PROCEDURE Lock();
   INTERNAL VIRTUAL PROCEDURE Unlock();

   // handling events, NOT synchronized, if there is a need (e.g. if synchronized helper is not called) accessing object data inside MUST be synchronized
   INTERNAL VIRTUAL PROCEDURE ValueReadRequestSent( Status : knx_status.TKNXStackStatus; CurrentState : knx_user.TObjectState );
   INTERNAL VIRTUAL PROCEDURE ValueRead( Status : knx_status.TKNXStackStatus; CurrentState : knx_user.TObjectState; CurrentInitReadState : knx_user.TInitReadState );
   INTERNAL VIRTUAL PROCEDURE ValueUpdated( Status : knx_status.TKNXStackStatus; CurrentState : knx_user.TObjectState );
   INTERNAL VIRTUAL PROCEDURE ValueWritten( Status : knx_status.TKNXStackStatus; CurrentState : knx_user.TObjectState );
END CObject;

//--------------------------------------------------------------------------------

CLASS CStackSink IMPLEMENTS knx_stack.IKNXStackEventSink;
   Server : TPKNXServer;
   PUBLIC VIRTUAL PROCEDURE OnDeviceConnected();
   PUBLIC VIRTUAL PROCEDURE OnDeviceDisconnected();
END CStackSink;

//--------------------------------------------------------------------------------

TYPE
   TPPromiscuousData = POINTER TO PromiscuousData;

CLASS PromiscuousData;
   Status  : knx_status.TKNXStackStatus;
   Address : knx_def.CAddress;
   Value   : knx_def.CValue;
END PromiscuousData;

//--------------------------------------------------------------------------------

TYPE
   TStack = (
      stackUnknown,
      stackUSB,
      stackFalcon,
      stackKNXnet
   );

   TRStatusItem = (
      rsRunning,
      rsInitReadPending,
      rsInitReadRepeat,
      rsInitReadFinished,
      rsProcessingOOB,
      rsEnumeratingObject,
      rsPromiscuousInQueue,
      rsEXEFlag
   );
   TRStatus = SET OF TRStatusItem;

   TReadParameters = RECORD
                        Timeout      : CARDINAL;
                        RepeatCount  : CARDINAL;
                        Delay        : CARDINAL;
                        RecoveryTime : CARDINAL;
                     END;

TYPE
   TPKNXServerSink = POINTER TO IKNXServerSink;
   
INTERFACE IKNXServerSink;
   PROCEDURE OnConnect();
   PROCEDURE OnDisconnect();
   PROCEDURE OnInitReadCompleted();
   PROCEDURE OnRead( PObject : TPObject );
   PROCEDURE OnWritten( PObject : TPObject );
   PROCEDURE OnInputQueueAdd( OOBQueue, PromiscuousQueue : BOOLEAN );
   PROCEDURE OnInputQueueOverflow( OOBQueue, PromiscuousQueue : BOOLEAN );
END IKNXServerSink;

CLASS KNXServerEvent( Event.AEvent ) IMPLEMENTS IKNXServerSink;
   PUBLIC VIRTUAL PROCEDURE OnConnect();
   PUBLIC VIRTUAL PROCEDURE OnDisconnect();
   PUBLIC VIRTUAL PROCEDURE OnInitReadCompleted();
   PUBLIC VIRTUAL PROCEDURE OnRead( PObject : TPObject );
   PUBLIC VIRTUAL PROCEDURE OnWritten( PObject : TPObject );
   PUBLIC VIRTUAL PROCEDURE OnInputQueueAdd( OOBQueue, PromiscuousQueue : BOOLEAN );
   PUBLIC VIRTUAL PROCEDURE OnInputQueueOverflow( OOBQueue, PromiscuousQueue : BOOLEAN );
END KNXServerEvent;

CLASS CKNXServer( msghandler.MessageHandler ) IMPLEMENTS device.IDevice, ns.IOriginator, ns.IValueIO, io.IIO;
   RStatus                  : TRStatus;

   Stack                    : TStack;
   KNX                      : knx_stack.TPKNXStack;
   KNXBoundaryLock          : Sync.LOCK;
   Sink                     : CStackSink;
   EventSinks               : KNXServerEvent;
   Logger                   : log.CLogger;
   R                        : Resources.CResources;
   _Result                  : lec.TPResult;
   _AdviseSource            : nsimpl.SimpleAdviseSource;
   _DataLogger              : log.TPLogger;

   DeviceId                 : LONGWORD;
   PromiscuousMode          : BOOLEAN;
   _CacheOnlyMode           : BOOLEAN;

   InputQueueLength         : CARDINAL;
   Address                  : knx_def.CAddress;
   ACKTimeout               : CARDINAL;
   BUSYDelay                : CARDINAL;
   SendDelay                : CARDINAL;
   IgnoreRepeated           : BOOLEAN;
   WriteDelay               : CARDINAL;

   DateAsString             : BOOLEAN;
   DateFormat               : StringsO.CString;
   TimeAsString             : BOOLEAN;
   TimeFormat               : StringsO.CString;

   ReadOnStart              : TReadParameters;
   ReadDuringRun            : TReadParameters;
   InitReadRepeatDelay      : CARDINAL;
   InitReadRepeatCount      : CARDINAL;

   Behaviours               : list.CList;
   _ForceReadPeriod         : CARDINAL;
   _ReadersCount            : CARDINAL;
   ObjectTypes              : lists.CStringList;

   ObjectLock               : Sync.LOCK;
   Namespace                : nsimpl.Namespace;
   Groups                   : ARRAY CARD16 OF CARD16; // maps group addresses to object indexes
   Objects                  : arrays.CPtrArray;
   prObjects                : ARRAY knx_def.TKNXType OF CObject; // promiscuous objects
   DateAndTimeObjects       : arrays.CPtrArray;
   _DateAndTimePushPeriod   : CARDINAL;

   InitReadItems            : CARDINAL;
   InitReadRepeat           : CARDINAL;

   QueueLock                : Sync.LOCK;
   // OOB management
   oobData                  : lists.CBufferList;
   // promiscuous data management
   prData                   : lists.CBufferList;

   PUBLIC WRITEONLY PROPERTY
     Result                 : lec.TPResult;
   PUBLIC PROPERTY
     DataLogger             : log.TPLogger;
     EXEFlag                : BOOLEAN;

   // inherited
   INTERNAL VIRTUAL PROCEDURE OnTimer( TimerId : PTR );

   // IDataSource
   PUBLIC VIRTUAL READONLY PROPERTY
      DataSourceCapabilities : device.TCapabilities;
   PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE NS() : ns.TPNamespace;
   PUBLIC VIRTUAL PROCEDURE AdviseSource() : ns.TPAdviseSource;

   // IDevice
   PUBLIC VIRTUAL PROCEDURE StartStop() : io.TPStartStopControl;
   PUBLIC VIRTUAL PROCEDURE IO() : io.TPIO;

   // IOriginator
   PUBLIC VIRTUAL READONLY PROPERTY
      Description : StringsO.CString;

   // IValueIO
   PUBLIC VIRTUAL PROCEDURE ValueIO( CONST Originator : ns.TPOriginator; CONST NameValuePairs : ns.TPNameValuePairs; Direction : IOO.TDirection; REF Value : iovalue.Value ) : Sync.TAsyncResult;
   
   // IIO
   PUBLIC VIRTUAL READONLY PROPERTY
      IOCapabilities : io.TCapabilities;
      Pending : BOOLEAN;
      Running : BOOLEAN;

   PUBLIC VIRTUAL PROCEDURE Start() : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE Stop();

   PUBLIC VIRTUAL PROCEDURE IOh( CONST Originator : ns.TPOriginator; Direction : IOO.TDirection; Item : ns.THash; REF Value : iovalue.Value; Callback : io.TPDataInfo ) : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE IOha( CONST Originator : ns.TPOriginator; Direction : IOO.TDirection; Item : ARRAY OF ns.THash; REF Value : ARRAY OF iovalue.Value; Callback : io.TPDataInfo ) : Sync.TAsyncResult;
   PUBLIC VIRTUAL PROCEDURE AbortAll();

   // self
   PUBLIC READONLY PROPERTY
      Connection : StringsO.CString; // information about device connection, read from configuration
      CacheOnlyMode : BOOLEAN;
   PUBLIC PROCEDURE LoadConfiguration( CONST ConfigurationFile : StringsO.IString; OUT ErrorMessage : StringsO.CString; OUT ErrorLine : CARDINAL ) : BOOLEAN;
   PUBLIC VIRTUAL PROCEDURE Dispose();

   PUBLIC PROCEDURE OnDeviceConnect();
   PUBLIC PROCEDURE OnDeviceDisconnect();
   
   PUBLIC PROCEDURE GetObject( CONST Address : knx_def.TAddress; OUT PObject : TPObject ) : BOOLEAN;
   
   // internal
   PROCEDURE FindBehaviour( CONST BehaviourName : StringsO.IString; VAR Priority : knx_def.TPriority; VAR Flags : knx_def.TA_ObjectFlags ) : BOOLEAN;
   PROCEDURE FindObjectType( CONST ObjectTypeName : StringsO.IString; OUT ObjectType : TObjectType ) : BOOLEAN;
   PROCEDURE AddObject( Class : knx_def.TPriority; Flags : knx_def.TA_ObjectFlags; Type : knx_def.TKNXType; ObjectType : TObjectType ) : TPObject;
   PROCEDURE DoneObjects( NILExecutive : BOOLEAN );

   // object callbacks
   LOCAL PROCEDURE ValueReadRequestSent( PObject : TPObject; CurrentState : knx_user.TObjectState ); // ObjectState is a synchronous copy
   LOCAL PROCEDURE ValueRead( PObject : TPObject; CurrentState : knx_user.TObjectState; CurrentInitReadState : knx_user.TInitReadState ); // dtto
   LOCAL PROCEDURE ValueUpdated( Direction : IOO.TDirection; PObject : TPObject; CurrentState : knx_user.TObjectState ); // dtto
   LOCAL PROCEDURE ValueWritten( PObject : TPObject; CurrentState : knx_user.TObjectState ); // dtto
   PRIVATE PROCEDURE EnqueuePromiscuous( Status : knx_status.TKNXStackStatus; PObject : TPObject );

   // helpers
   PROCEDURE DoInitRead( RepeatFlag : BOOLEAN );
   PROCEDURE DoForceRead();
   PRIVATE PROCEDURE DoPushDateAndTime();
   PROCEDURE InitToDefault();
   PROCEDURE InitReadFinished();
   
   LOCAL PROCEDURE LockObjects();
   LOCAL PROCEDURE UnlockObjects();

   LOCAL PROCEDURE IOValue2KNXValue( CONST Value : iovalue.Value; DestEVType : knx_def.TKNXType; OUT EV : knx_def.TValue; OUT SupportingStringData : StringsO.IString );
   LOCAL PROCEDURE KNXValue2IOValue( CONST EV : knx_def.TValue; CONST SupportingStringData : StringsO.IString; OUT Value : iovalue.Value );
END CKNXServer;

//================================================================================

END knxcore.
