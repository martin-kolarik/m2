<?xml version="1.0" encoding="utf-8"?>
<resources>
    <strings version="1.0">

        <comment>CFG errors</comment>
        <string name="_CannotOpenPar">
            <item lang="en-US">Error during opening configuration file</item>
            <item lang="cs-CZ">Chyba při otevření konfiguračního souboru</item>
        </string>
        <string name="_ConfigurationLoadSuccessfully">
            <item xml:space="preserve" lang="en-US">Configuration loaded successfully, file: </item>
            <item xml:space="preserve" lang="cs-CZ">Konfigurace byla načtena úspěšně, soubor: </item>
        </string>
        <string name="_ConfigurationLoadUnsuccessfully">
            <item xml:space="preserve" lang="en-US">Configuration was not loaded, file: </item>
