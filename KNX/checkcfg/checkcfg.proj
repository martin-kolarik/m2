<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <PropertyGroup>
        <ComponentType>Product</ComponentType>

        <ProductGUID>C016DBAB-2F26-46ad-8B12-12C5C79D4B2A</ProductGUID>
        <ProductUpgradeGUID>3A80E4D6-DBDF-4ca6-8100-7E513A139764</ProductUpgradeGUID>

        <ProductId>SmartControl.KnxSvcCheckCfg</ProductId>
        <ProductVersionMajor>1</ProductVersionMajor>
        <ProductVersionMinor>0</ProductVersionMinor>
        <ProductNote></ProductNote>

        <ProjectDisplayName>KNX Configuration Checker</ProjectDisplayName>
        <ProjectDescription>KNX Object Server Configuration Checker</ProjectDescription>
    </PropertyGroup>

    <!-- 2 INCLUDE DEFINITION -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 3 COMPONENT DEFINITION -->
    <ItemGroup>
        <BuildVersionSource Include="$(RootPath)\Component\sccore;$(RootPath)\KNX\knxcore"/>

        <Components Include="Modula2\modula2;API\CLib;API\win32"/>
        <Components Include="Component\sccore;KNX\knxcore"/>
        <Messages Include="Texts"/>
        <Program Include="checkcfg"/>
    </ItemGroup>

    <!-- 5 LAST INCLUDE COMPILATION CODE ITSELF -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

</Project>
