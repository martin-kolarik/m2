DEFINITION MODULE EquithermicCurve;

IMPORT
   adviser,
   device,
   functionbase,
   iovalue,
   lists,
   log,
   msghandler,
   msgqueue,
   ns,
   Sync;

FROM Storage IMPORT
  ALLOCATE, DEALLOCATE;

(*# call( o_a_copy => off ) *)

(*================================================================================*)

TYPE
   TPEquithermicCurveFunction = POINTER TO CEquithermicCurveFunction;
   TPCurve = POINTER TO CCurve;

CLASS CEquithermicCurveFunction( functionbase.CFunctionBase ) IMPLEMENTS io.IAdviseInfo;

   // MessageHandler
   INTERNAL VIRTUAL PROCEDURE OnMessage( CONST Message : msghandler.IMessage; OUT Result : PTR ) : BOOLEAN;

   // IAdviseInfo
   PUBLIC VIRTUAL PROCEDURE OnAdvise( Source : io.TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST Value : ARRAY OF iovalue.Value );

   // SELF
   PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult; // accepts citINIFile or citINIFileSection
   PUBLIC VIRTUAL PROCEDURE Dispose();
   
   // SELF
   INTERNAL VIRTUAL PROCEDURE OnStart();
   INTERNAL VIRTUAL PROCEDURE OnStop();

   PRIVATE VAR
      _Curves : lists.CPtrList; // list of CCurve
      _SendQueue : msgqueue.CPtrQueue;

   PRIVATE PROCEDURE Enqueue( curve : TPCurve );
   PRIVATE PROCEDURE Compute( curve : TPCurve );

   INITIALLY CEquithermicCurveFunction();
   FINALLY CEquithermicCurveFunction();

END CEquithermicCurveFunction;

(*================================================================================*)

END EquithermicCurve.