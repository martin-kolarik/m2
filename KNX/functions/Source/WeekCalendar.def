DEFINITION MODULE WeekCalendar;

IMPORT
   adviser,
   functionbase,
   INIFile,
   io,
   log,
   msghandler,
   msgqueue,
   StringsO,
   Sync,
   threadpool;

FROM Storage IMPORT
  ALLOCATE, DEALLOCATE;

(*# call( o_a_copy => off ) *)

(*================================================================================*)

TYPE
   TPWeekCalendarFunction = POINTER TO CWeekCalendarFunction;
   TPItem = POINTER TO CItem;

CLASS CWeekCalendarFunction( functionbase.CFunctionBase ) IMPLEMENTS threadpool.ITimeoutSink;

   // MessageHandler
   INTERNAL VIRTUAL PROCEDURE OnMessage( CONST Message : msghandler.IMessage; OUT Result : PTR ) : BOOLEAN;

   // ITimeoutSink
   LOCAL VIRTUAL PROCEDURE OnTimeout( Result : Sync.TAsyncResult; PoolHandle : threadpool.TPoolHandle; UserId : PTR );

   // CFunctionBase
   PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult; // accepts citINIFile or citINIFileSection
   PUBLIC VIRTUAL PROCEDURE Dispose();
   
   // SELF
   INTERNAL VIRTUAL PROCEDURE OnStart();
   INTERNAL VIRTUAL PROCEDURE OnStop();

   PRIVATE VAR
      _Items : lists.CPtrList; // list of CItem
		_CalendarPeriod : threadpool.TPoolHandle := NIL;
		_PoolDelegate : threadpool.CSinkDelegate;
      _WriteQueue : msgqueue.CPtrQueue;

   PRIVATE PROCEDURE EvaluateItems();
   PRIVATE PROCEDURE Enqueue( item : TPItem );
   PRIVATE PROCEDURE Write();

   PRIVATE PROCEDURE DetermineLastPassedWeekStart() : datetime.DateTime;
   PRIVATE PROCEDURE StartTimeout( TimeoutMS : CARDINAL; WaitOnce : BOOLEAN; REF Handle : threadpool.TPoolHandle );
   PRIVATE PROCEDURE StopTimeout( REF Handle : threadpool.TPoolHandle );

   INITIALLY CWeekCalendarFunction();
   FINALLY CWeekCalendarFunction();

END CWeekCalendarFunction;

(*================================================================================*)

END WeekCalendar.