DEFINITION MODULE WeekCalendar;

IMPORT
   adviser,
   functionbase,
   INIFile,
   io,
   log,
   msghandler,
   msgqueue,
   StringsO,
   Sync;

FROM Storage IMPORT
  ALLOCATE, DEALLOCATE;

(*# call( o_a_copy => off ) *)

(*================================================================================*)

TYPE
   TPWeekCalendarFunction = POINTER TO CWeekCalendarFunction;
   TPItem = POINTER TO CItem;

CLASS CWeekCalendarFunction( functionbase.CFunctionBase );

   // MessageHandler
   INTERNAL VIRTUAL PROCEDURE OnMessage( CONST Message : msghandler.IMessage; OUT Result : PTR ) : BOOLEAN;

   PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult; // accepts citINIFile or citINIFileSection
   PUBLIC VIRTUAL PROCEDURE Dispose();
   
   // SELF
   INTERNAL VIRTUAL PROCEDURE OnStart();
   INTERNAL VIRTUAL PROCEDURE OnStop();

   PRIVATE VAR
      _Items : lists.CPtrList; // list of CItem
      _SendQueue : msgqueue.CPtrQueue;

   PRIVATE PROCEDURE LoadData( CONST iniFile : INIFile.TPINIFile; section : ARRAY OF WCHAR; CONST Log : log.TPLogger; acceptConfigurationKeys : BOOLEAN ) : Sync.TAsyncResult;
   PRIVATE PROCEDURE Enqueue( item : TPItem );
   PRIVATE PROCEDURE Write();

   INITIALLY CWeekCalendarFunction();
   FINALLY CWeekCalendarFunction();

END CWeekCalendarFunction;

(*================================================================================*)

END WeekCalendar.