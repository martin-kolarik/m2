DEFINITION MODULE PersistentStorage;

IMPORT
   adviser,
   functionbase,
   INIFile,
   io,
   knxcore,
   log,
   msghandler,
   msgqueue,
   StringsO,
   Sync;

FROM Storage IMPORT
  ALLOCATE, DEALLOCATE;

(*# call( o_a_copy => off ) *)

(*================================================================================*)

TYPE
   TPPersistentStorageFunction = POINTER TO CPersistentStorageFunction;
   TPItem = POINTER TO CItem;

CLASS CPersistentStorageFunction( functionbase.CFunctionBase ) IMPLEMENTS io.IAdviseInfo, knxcore.IKNXServerSink;

   // MessageHandler
   INTERNAL VIRTUAL PROCEDURE OnTimer( Timer : PTR );

   // IAdviseInfo
   PUBLIC VIRTUAL PROCEDURE OnAdvise( Source : io.TPIO; CONST Result : ARRAY OF Sync.TAsyncResult; CONST Item : ARRAY OF ns.THash; CONST Value : ARRAY OF iovalue.Value );

   // IKNXServerSink;
   PUBLIC VIRTUAL PROCEDURE OnConnect();
   PUBLIC VIRTUAL PROCEDURE OnDisconnect();
   PUBLIC VIRTUAL PROCEDURE OnInitReadCompleted();
   PUBLIC VIRTUAL PROCEDURE OnRead( PObject : knxcore.TPObject );
   PUBLIC VIRTUAL PROCEDURE OnWritten( PObject : knxcore.TPObject );
   PUBLIC VIRTUAL PROCEDURE OnInputQueueAdd( OOBQueue, PromiscuousQueue : BOOLEAN );
   PUBLIC VIRTUAL PROCEDURE OnInputQueueOverflow( OOBQueue, PromiscuousQueue : BOOLEAN );

   // SELF
   PUBLIC PROPERTY
      DefaultStorageFolder : StringsO.CString;
      
   PUBLIC VIRTUAL PROCEDURE Configure( CONST Source : ARRAY OF device.TConfigureItem; CONST Log : log.TPLogger ) : Sync.TAsyncResult; // accepts citINIFile or citINIFileSection
   PUBLIC VIRTUAL PROCEDURE Dispose();
   
   // SELF
   INTERNAL VIRTUAL PROCEDURE OnStart();
   INTERNAL VIRTUAL PROCEDURE OnStop();

   PRIVATE VAR
      _Items : lists.CPtrList; // list of CItem
      _WriteDelay : CARDINAL := 10000;
      _WriteQueue : msgqueue.CPtrQueue;
      _DefaultStorageFolder : StringsO.CString;
      _Storage : INIFile.CINIFile;
      _StoragePath : StringsO.CString;

   PRIVATE PROCEDURE LoadData( CONST iniFile : INIFile.TPINIFile; section : ARRAY OF WCHAR; CONST Log : log.TPLogger; acceptConfigurationKeys : BOOLEAN ) : Sync.TAsyncResult;
   PRIVATE PROCEDURE Mark( item : TPItem );
   PRIVATE PROCEDURE Write();

   INITIALLY CPersistentStorageFunction();
   FINALLY CPersistentStorageFunction();

END CPersistentStorageFunction;

(*================================================================================*)

END PersistentStorage.