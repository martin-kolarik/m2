                                dwFlags : windows.DWORD; pdwRegister : windows.PDWORD ) : wtypes.HRESULT;
PROCEDURE RevokeActiveObject( dwRegister : windows.DWORD; pvReserved : ADDRESS ) : wtypes.HRESULT;
PROCEDURE GetActiveObject( CONST rclsid : guiddef.CLSID; pvReserved : ADDRESS; VAR ppunk : unknwn.TPIUnknown ) : wtypes.HRESULT;

