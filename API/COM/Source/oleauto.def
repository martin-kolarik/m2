DEFINITION MODULE oleauto;

(*# name(   decoration      => c ) *)

(*# module( header          => off ) *)

(*# call(   o_a_size        => off,
            o_a_copy        => off,
            c_arrays        => on,
            result_optional => on,
            convention      => stdcall ) *)

(*/*

//  Definition of the OLE Automation APIs, and macros.

#ifdef _OLEAUT32_
#define WINOLEAUTAPI        STDAPI
#define WINOLEAUTAPI_(type) STDAPI_(type)
#else
#define WINOLEAUTAPI        EXTERN_C DECLSPEC_IMPORT wtypes.HRESULT STDAPICALLTYPE
#define WINOLEAUTAPI_(type) EXTERN_C DECLSPEC_IMPORT type STDAPICALLTYPE
#endif
*/*)

IMPORT
  guiddef,
  oaidl,
  unknwn,
  windows,
  wtypes;

(*# option( pack => 8 ) *)

VAR
  IID_StdOle : guiddef.IID;

CONST
  STDOLE_MAJORVERNUM =     01H;
  STDOLE_MINORVERNUM =     00H;
  STDOLE_LCID        =  00000H;

// Version # of stdole2.tlb
  STDOLE2_MAJORVERNUM =    02H;
  STDOLE2_MINORVERNUM =    00H;
  STDOLE2_LCID        = 00000H;

(*/* if not already picked up from olenls.h */*)
(*/*
#ifndef _LCID_DEFINED
typedef windows.DWORD LCID;
# define _LCID_DEFINED
#endif
*/*)
TYPE
  LCID = windows.DWORD;

(*
/*---------------------------------------------------------------------*/
/*                            wtypes.BSTR API                                 */
/*---------------------------------------------------------------------*/
*)

PROCEDURE SysAllocString( _ : wtypes.POLECHAR ) : wtypes.BSTR;
PROCEDURE SysReAllocString( _ : wtypes.PBSTR; _ : wtypes.POLECHAR ) : windows.INT;
PROCEDURE SysAllocStringLen( _ : wtypes.POLECHAR; _ : windows.UINT) : wtypes.BSTR;
PROCEDURE SysReAllocStringLen( _ : wtypes.PBSTR; _ : wtypes.POLECHAR; _ : windows.UINT ) : windows.INT;
PROCEDURE SysFreeString( _ : wtypes.BSTR );
PROCEDURE SysStringLen( _ : wtypes.BSTR) : windows.UINT;

PROCEDURE SysStringByteLen( bstr : wtypes.BSTR ) : windows.UINT;
PROCEDURE SysAllocStringByteLen( psz : windows.PCSTR; len : windows.UINT ) : wtypes.BSTR;

(*
/*---------------------------------------------------------------------*/
/*                            Time API                                 */
/*---------------------------------------------------------------------*/
*)

PROCEDURE DosDateTimeToVariantTime( wDosDate : windows.USHORT; wDosTime : windows.USHORT; VAR pvtime : wtypes.DOUBLE ) : windows.INT;
PROCEDURE VariantTimeToDosDateTime( vtime : wtypes.DOUBLE; VAR pwDosData : windows.USHORT; VAR pwDosTime : windows.USHORT ) : windows.INT;
PROCEDURE SystemTimeToVariantTime( lpSystemTime : windows.PSYSTEMTIME; VAR pvtime : wtypes.DOUBLE ) : windows.INT;
PROCEDURE VariantTimeToSystemTime( vtime : wtypes.DOUBLE; lpSystemTime : windows.PSYSTEMTIME ) : windows.INT;

(*
/*---------------------------------------------------------------------*/
/*                          SafeArray API                              */
/*---------------------------------------------------------------------*/
*)

PROCEDURE SafeArrayAllocDescriptor( cDims : windows.UINT; VAR ppsaOut : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayAllocData( psa : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayCreate( vt : wtypes.VARTYPE; cDims : windows.UINT; rgsabound : oaidl.PSAFEARRAYBOUND ) : oaidl.PSAFEARRAY;
PROCEDURE SafeArrayCreateVector( vt : wtypes.VARTYPE; lLbound : windows.LONG; cElements : windows.ULONG ) : oaidl.PSAFEARRAY;
PROCEDURE SafeArrayCopyData( psaSource : oaidl.PSAFEARRAY; psaTarget : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayDestroyDescriptor( psa : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayDestroyData( psa : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayDestroy( psa : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayRedim( psa : oaidl.PSAFEARRAY; psaboundNew : oaidl.PSAFEARRAYBOUND ) : wtypes.HRESULT;
PROCEDURE SafeArrayGetDim( psa : oaidl.PSAFEARRAY ) : windows.UINT;
PROCEDURE SafeArrayGetElemsize( psa : oaidl.PSAFEARRAY ) : windows.UINT;
PROCEDURE SafeArrayGetUBound( psa : oaidl.PSAFEARRAY; nDim : windows.UINT; VAR plUbound : windows.LONG) : wtypes.HRESULT;
PROCEDURE SafeArrayGetLBound( psa : oaidl.PSAFEARRAY; nDim : windows.UINT; VAR plLbound : windows.LONG ) : wtypes.HRESULT;
PROCEDURE SafeArrayLock( psa : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayUnlock( psa : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayAccessData( psa : oaidl.PSAFEARRAY; VAR ppvData : ADDRESS ) : wtypes.HRESULT;
PROCEDURE SafeArrayUnaccessData( psa : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayGetElement( psa : oaidl.PSAFEARRAY; rgIndices : windows.PLONG; pv : ADDRESS ) : wtypes.HRESULT;
PROCEDURE SafeArrayPutElement( psa : oaidl.PSAFEARRAY; rgIndices : windows.PLONG; pv : ADDRESS ) : wtypes.HRESULT;
PROCEDURE SafeArrayCopy( psa : oaidl.PSAFEARRAY; VAR ppsaOut : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE SafeArrayPtrOfIndex( psa : oaidl.PSAFEARRAY; rgIndices : windows.PLONG; VAR ppvData : ADDRESS ) : wtypes.HRESULT;

(*
/*---------------------------------------------------------------------*/
/*                           oaidl.VARIANT API                         */
/*---------------------------------------------------------------------*/
*)

PROCEDURE VariantInit( pvarg : oaidl.PVARIANTARG );
PROCEDURE VariantClear( pvarg : oaidl.PVARIANTARG ) : wtypes.HRESULT;
PROCEDURE VariantCopy( pvargDest : oaidl.PVARIANTARG; pvargSrc : oaidl.PVARIANTARG ) : wtypes.HRESULT;
PROCEDURE VariantCopyInd( pvarDest : oaidl.PVARIANT; pvargSrc : oaidl.PVARIANTARG ) : wtypes.HRESULT;
PROCEDURE VariantChangeType( pvargDest, pvarSrc : oaidl.PVARIANTARG; wFlags : windows.USHORT; vt : wtypes.VARTYPE ) : wtypes.HRESULT;
PROCEDURE VariantChangeTypeEx( pvargDest, pvarSrc : oaidl.PVARIANTARG; lcid : LCID; wFlags : windows.USHORT; vt : wtypes.VARTYPE ) : wtypes.HRESULT;

CONST
// Flags for VariantChangeType/VariantChangeTypeEx
  VARIANT_NOVALUEPROP    = 01H;
  VARIANT_ALPHABOOL      = 02H; // For VT_BOOL to VT_BSTR conversions,
                                // convert to "True"/"False" instead of
                                // "-1"/"0"
  VARIANT_NOUSEROVERRIDE = 04H;	// For conversions to/from VT_BSTR,
					// passes LOCALE_NOUSEROVERRIDE
					// to core coercion routines

(*
/*---------------------------------------------------------------------*/
/*                Vector <-> Bstr conversion APIs                      */
/*---------------------------------------------------------------------*/
*)

PROCEDURE VectorFromBstr ( bstr : wtypes.BSTR; VAR ppsa : oaidl.PSAFEARRAY ) : wtypes.HRESULT;
PROCEDURE BstrFromVector ( psa : oaidl.PSAFEARRAY; pbstr : wtypes.PBSTR ) : wtypes.HRESULT;

(*
/*---------------------------------------------------------------------*/
/*                     wtypes.VARTYPE Coercion API                            */
/*---------------------------------------------------------------------*/
*)

(*
/* Note: The routines that convert *from* a string are defined
 * to take a OLECHAR* rather than a wtypes.BSTR because no allocation is
 * required, and this makes the routines a bit more generic.
 * They may of course still be passed a wtypes.BSTR as the strIn param.
 */

/* Any of the coercion functions that converts either from or to a string
 * takes an additional lcid and dwFlags arguments. The lcid argument allows
 * locale specific parsing to occur.  The dwFlags allow additional function
 * specific condition to occur.  All function that accept the dwFlags argument
 * can include either 0 or LOCALE_NOUSEROVERRIDE flag. In addition, the
 * VarDateFromStr functions also accepts the VAR_TIMEVALUEONLY and
 * VAR_DATEVALUEONLY flags
 */
*)

CONST
  VAR_TIMEVALUEONLY = windows.DWORD( 000000001H );    ///* return time value */
  VAR_DATEVALUEONLY = windows.DWORD( 000000002H );    ///* return date value */

PROCEDURE VarUI1FromI2( sIn : windows.SHORT; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromI4( lIn : windows.LONG; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromR4( fltIn : windows.FLOAT; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromR8( dblIn : wtypes.DOUBLE; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromCy( cyIn : wtypes.CY; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromDate( dateIn : wtypes.DATE; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromStr( strIn : wtypes.POLECHAR; lcid : LCID; dwFlags : windows.ULONG; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromDisp( pdispIn : oaidl.TPIDispatch; lcid : LCID; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromBool( boolIn : wtypes.VARIANT_BOOL; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromI1( cIn : CHAR; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromUI2( uiIn : windows.USHORT; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromUI4( ulIn : windows.ULONG; pbOut : PBYTE ) : wtypes.HRESULT;
PROCEDURE VarUI1FromDec( pdecIn : wtypes.PDECIMAL; pbOut : PBYTE ) : wtypes.HRESULT;

