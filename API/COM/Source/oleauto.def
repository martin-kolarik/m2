TYPE
  DISPID     = windows.LONG;
  MEMBERID   = DISPID;

CONST
  MEMBERID_NIL   = oaidl.DISPID_UNKNOWN;
  ID_DEFAULTINST = -2;

CONST
///* Flags for IDispatch::Invoke */
  DISPATCH_METHOD         = 01H;
  DISPATCH_PROPERTYGET    = 02H;
  DISPATCH_PROPERTYPUT    = 04H;
  DISPATCH_PROPERTYPUTREF = 08H;

CONST
  TPITypeInfo ::= oaidl.TPITypeInfo;

