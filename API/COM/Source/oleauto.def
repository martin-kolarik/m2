(*  
/* Mac Note: On the Mac, the coercion functions support the
 * Symantec C++ calling convention for float/double. To support
 * float/double arguments compiled with the MPW C compiler,
 * use the following APIs to move MPW float/double values into
 * a oaidl.VARIANT.
 */
*)

(*
/*---------------------------------------------------------------------*/
/*            New oaidl.VARIANT <-> string parsing functions                 */
/*---------------------------------------------------------------------*/
*)

TYPE
  NUMPARSE  = RECORD 
                cDig       : windows.INT;
                dwInFlags  : windows.ULONG;
                dwOutFlags : windows.ULONG;
                cchUsed    : windows.INT;
                nBaseShift : windows.INT;
                nPwr10     : windows.INT;
              END;
  PNUMPARSE = POINTER TO NUMPARSE;

(*
/* flags used by both dwInFlags and dwOutFlags:
 */
*)
CONST
  NUMPRS_LEADING_WHITE    = 00001H;
  NUMPRS_TRAILING_WHITE   = 00002H;
  NUMPRS_LEADING_PLUS     = 00004H;
  NUMPRS_TRAILING_PLUS    = 00008H;
  NUMPRS_LEADING_MINUS    = 00010H;
  NUMPRS_TRAILING_MINUS   = 00020H;
  NUMPRS_HEX_OCT          = 00040H;
  NUMPRS_PARENS           = 00080H;
  NUMPRS_DECIMAL          = 00100H;
  NUMPRS_THOUSANDS        = 00200H;
  NUMPRS_CURRENCY         = 00400H;
  NUMPRS_EXPONENT         = 00800H;
  NUMPRS_USE_ALL          = 01000H;
  NUMPRS_STD              = 01FFFH;

(*
/* flags used by dwOutFlags only:
 */
*)
  NUMPRS_NEG              = 010000H;
  NUMPRS_INEXACT          = 020000H;

(*
/* flags used by VarNumFromParseNum to indicate acceptable result types:
 */
*)
  VTBIT_I1        = (1 << ORD(wtypes.VT_I1));
  VTBIT_UI1       = (1 << ORD(wtypes.VT_UI1));
  VTBIT_I2        = (1 << ORD(wtypes.VT_I2));
  VTBIT_UI2       = (1 << ORD(wtypes.VT_UI2));
  VTBIT_I4        = (1 << ORD(wtypes.VT_I4));
  VTBIT_UI4       = (1 << ORD(wtypes.VT_UI4));
  VTBIT_R4        = (1 << ORD(wtypes.VT_R4));
  VTBIT_R8        = (1 << ORD(wtypes.VT_R8));
  VTBIT_CY        = (1 << ORD(wtypes.VT_CY));
  VTBIT_DECIMAL   = (1 << ORD(wtypes.VT_DECIMAL));


PROCEDURE VarParseNumFromStr(
  strIn : wtypes.POLECHAR; lcid : LCID; dwFlags : windows.ULONG;
  pnumprs : PNUMPARSE; rgbDig : PBYTE ) : wtypes.HRESULT;

PROCEDURE VarNumFromParseNum( pnumprs : PNUMPARSE; rgbDig : PBYTE;
            dwVtBits : windows.ULONG; pvar : oaidl.PVARIANT ) : wtypes.HRESULT;


(*
/*---------------------------------------------------------------------*/
/*                   New date functions                                */
/*---------------------------------------------------------------------*/
*)

CONST
  VAR_VALIDDATE          = 00004H;    ///* VarDateFromUdate() only */
  VAR_CALENDAR_HIJRI     = 00008H;    ///* use Hijri calender */
  VARIANT_CALENDAR_HIJRI = VAR_CALENDAR_HIJRI;

(*
/* The UDATE structure is used with VarDateFromUdate() and VarUdateFromDate().
 * It represents an "unpacked date".
 */
*)
TYPE
  UDATE  = RECORD 
             st         : windows.SYSTEMTIME;
             wDayOfYear : windows.USHORT;
           END;
  PUDATE = POINTER TO UDATE;

(*
/* APIs to "pack" and "unpack" dates.
 */
*)
PROCEDURE VarDateFromUdate( pudateIn : PUDATE; dwFlags : windows.ULONG; pdateOut : PUDATE ) : wtypes.HRESULT;
PROCEDURE VarUdateFromDate( dateIn : wtypes.DATE; dwFlags : windows.ULONG; pudateOut : PUDATE ) : wtypes.HRESULT;

(*
/* API to retrieve the secondary(altername) month names
   Useful for Hijri, Polish and Russian alternate month names
*/
*)   
PROCEDURE GetAltMonthNames( lcid : LCID; VAR prgp : wtypes.POLESTR ) : wtypes.HRESULT;


