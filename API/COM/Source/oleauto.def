(*
/*---------------------------------------------------------------------*/
/*             TypeInfo API                                            */
/*---------------------------------------------------------------------*/

/* compute a 16bit hash value for the given name
 */
*)
PROCEDURE LHashValOfNameSys( syskind : oaidl.SYSKIND; lcid : LCID; szName : wtypes.POLECHAR ) : windows.ULONG;

(*/*
#define LHashValOfName(lcid, szName) \
            LHashValOfNameSys(SYS_WIN32, lcid, szName)

#define WHashValOfLHashVal(lhashval) \
            ((windows.USHORT) (0x0000ffff & (lhashval)))

#define IsHashValCompatible(lhashval1, lhashval2) \
            ((BOOL) ((0x00ff0000 & (lhashval1)) == (0x00ff0000 & (lhashval2))))
*/*)
(*# save, call( macro => on ) *)
PROCEDURE LHashValOfName( lcid : LCID; szName : windows.PCSTR );
PROCEDURE WHashValOfName( lhashval : windows.ULONG );
PROCEDURE IsHashCompatible( lhasval1, lhasval2 : windows.ULONG );
(*# restore *)

(*
/* load the typelib from the file with the given filename
 */
*)
PROCEDURE LoadTypeLib( szFile : wtypes.POLECHAR; VAR pptLib : TPITypeLib ) : wtypes.HRESULT;

(*
/* Control how a type library is registered
 */
*)
// typedef enum tagREGKIND
//{
//    REGKIND_DEFAULT,
//    REGKIND_REGISTER,
//    REGKIND_NONE
//} REGKIND;
TYPE
  REGKIND = ( REGKIND_DEFAULT,
              REGKIND_REGISTER,
              REGKIND_NONE );

PROCEDURE LoadTypeLibEx( szFile : wtypes.PCOLESTR; regkind : REGKIND; VAR pptlib : TPITypeLib ) : wtypes.HRESULT;

(*
/* load registered typelib
 */
*)
PROCEDURE LoadRegTypeLib( CONST rguid : guiddef.GUID; wVerMajor : WORD; wVerMinor : WORD; lcid : LCID; VAR pptlib : TPITypeLib ) : wtypes.HRESULT;

(*
/* get path to registered typelib
 */
*)
PROCEDURE QueryPathOfRegTypeLib( CONST guid : guiddef.GUID; wMaj : windows.USHORT; wMin : windows.USHORT; lcid : LCID; lpbstrPathName : wtypes.PBSTR ) : wtypes.HRESULT;

(*
/* add typelib to registry
 */
*)
PROCEDURE RegisterTypeLib( ptlib : TPITypeLib; szFullPath : wtypes.POLECHAR; szHelpDir : wtypes.POLECHAR ) : wtypes.HRESULT;

(*
/* remove typelib from registry
 */
*)
PROCEDURE UnRegisterTypeLib( CONST libID : guiddef.GUID; wVerMajor : WORD; wVerMinor : WORD; lcid : LCID; syskind : oaidl.SYSKIND ) : wtypes.HRESULT;
PROCEDURE CreateTypeLib( syskind : oaidl.SYSKIND; szFile : wtypes.POLECHAR; VAR ppctlib : TPICreateTypeLib ) : wtypes.HRESULT;
PROCEDURE CreateTypeLib2( syskind : oaidl.SYSKIND; szFile : wtypes.PCOLESTR; VAR ppctlib : oaidl.TPICreateTypeLib2 ) : wtypes.HRESULT;

(*
/*---------------------------------------------------------------------*/
/*           IDispatch implementation support                          */
/*---------------------------------------------------------------------*/
*)

CONST
  TPIDispatch ::= oaidl.TPIDispatch;

TYPE
  PARAMDATA   = RECORD
                  szName : wtypes.POLECHAR;   ///* parameter name */
                  vt     : wtypes.VARTYPE;    ///* parameter type */
                END;
  PPARAMDATA  = POINTER TO PARAMDATA;

  METHODDATA  = RECORD
                  szName   : wtypes.POLECHAR; ///* method name */
                  ppdata   : PPARAMDATA;      ///* pointer to an array of PARAMDATAs */
                  dispid   : DISPID;          ///* method ID */
                  iMeth    : windows.UINT;    ///* method index */
                  cc       : oaidl.CALLCONV;  ///* calling convention */
                  cArgs    : windows.UINT;    ///* count of arguments */
                  wFlags   : WORD;            ///* same wFlags as on IDispatch::Invoke() */
                  vtReturn : wtypes.VARTYPE;
                END;
  PMETHODDATA = POINTER TO METHODDATA;

  INTERFACEDATA  = RECORD
                     pmethdata : PMETHODDATA;  ///* pointer to an array of METHODDATAs */
                     cMembers  : windows.UINT;         ///* count of members */
                   END;
  PINTERFACEDATA = POINTER TO INTERFACEDATA;

(*
/* Locate the parameter indicated by the given position, and
 * return it coerced to the given target wtypes.VARTYPE (vtTarg).
 */
*)
PROCEDURE DispGetParam( pdispparams : oaidl.PDISPPARAMS; position : windows.UINT; vtTarg : wtypes.VARTYPE; pvarResult : oaidl.PVARIANT; puArgErr : windows.PUINT ) : wtypes.HRESULT;

(*
/* Automatic TypeInfo driven implementation of IDispatch::GetIDsOfNames()
 */
*)
PROCEDURE DispGetIDsOfNames( ptinfo : TPITypeInfo; VAR rgszNames : wtypes.POLECHAR; cNames : windows.UINT; rgdispid : oaidl.PDISPID ) : wtypes.HRESULT;

(*
/* Automatic TypeInfo driven implementation of IDispatch::Invoke()
 */
*)
PROCEDURE DispInvoke( _this : ADDRESS; ptinfo : TPITypeInfo; dispidMember : DISPID;
                      wFlags : WORD; pparams : oaidl.PDISPPARAMS; pvarResult : oaidl.PVARIANT;
                      pexcepinfo : oaidl.PEXCEPINFO; puArgErr : windows.PUINT ) : wtypes.HRESULT;

(*
/* Construct a TypeInfo from an interface data description
 */
*)
PROCEDURE CreateDispTypeInfo( pidata : INTERFACEDATA; lcid : LCID; VAR pptinfo : TPITypeInfo ) : wtypes.HRESULT;

(*
/* Create an instance of the standard TypeInfo driven IDispatch
 * implementation.
 */
*)
PROCEDURE CreateStdDispatch( punkOuter : unknwn.TPIUnknown; pvThis : ADDRESS;
                             ptinfo : TPITypeInfo; VAR ppunkStdDisp : unknwn.TPIUnknown ) : wtypes.HRESULT;

(*
/* Low-level helper for IDispatch::Invoke() provides machine independence
 * for customized Invoke().
 */
*)
PROCEDURE DispCallFunc( pvInstance : ADDRESS; oVft : windows.ULONG; cc : oaidl.CALLCONV;
                        vtReturn : wtypes.VARTYPE; cActuals : windows.UINT; prgvt : wtypes.PVARTYPE;
                        VAR prgpvarg : oaidl.PVARIANTARG; pvargResult : oaidl.PVARIANT ) : wtypes.HRESULT;

