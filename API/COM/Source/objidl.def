DEFINITION MODULE objidl;

(*# name( decoration => c ) *)

(*# call( o_a_size => off,
          c_arrays => on,
          result_optional => on,
          convention => stdcall ) *)

IMPORT 
  windows,
  unknwn,
  wtypes;
  
FROM guiddef IMPORT
  CLSID, FMTID, GUID, IID, PCLSID, PIID;

CONST 
  HRESULT ::= wtypes.HRESULT;

TYPE
  TPIMarshal            = POINTER TO IMarshal;
  TPIMalloc             = POINTER TO IMalloc;
  TPIMallocSpy          = POINTER TO IMallocSpy;
  TPIGetClassForHandler = POINTER TO IGetClassForHandler;
  TPIStdMarshalInfo     = POINTER TO IStdMarshalInfo;
  TPIExternalConnection = POINTER TO IExternalConnection;
  TPIStream             = POINTER TO IStream;
  TPIRpcChannelBuffer   = POINTER TO IRpcChannelBuffer;
  TPIRpcStubBuffer      = POINTER TO IRpcStubBuffer;
  TPIEnumString         = POINTER TO IEnumString;
  TPPIEnumString        = POINTER TO TPIEnumString;
  TPIAdviseSink         = POINTER TO IAdviseSink;

TYPE
  TPPVOID = POINTER TO windows.PVOID;
  ULONGLONG = CARD64;
  PULONGLONG = POINTER TO CARD64;
  PULARGE_INTEGER = POINTER TO ULARGE_INTEGER;
  TPIRunningObjectTable = POINTER TO IRunningObjectTable;
  
  ULARGE_INTEGER = RECORD
     QuadPart : ULONGLONG;
  END;

//===== IMarshal
VAR 
  IID_IMarshal : IID;

INTERFACE IMarshal( unknwn.IUnknown );

  VIRTUAL PROCEDURE GetUnmarshalClass( 
    (* [in] *) CONST riid : IID;
    (* [unique][in] *) pv : windows.PVOID;
    (* [in] *) dwDestContext : windows.DWORD;
    (* [unique][in] *) pvDestContext : windows.PVOID;
    (* [in] *)mshlflags : windows.DWORD;
    (* [out] *) pCid : PCLSID ): HRESULT;

  VIRTUAL PROCEDURE GetMarshalSizeMax( 
    (* [in] *) CONST riid : IID;
    (* [unique][in] *) pv : windows.PVOID;
    (* [in] *) dwDestContext : windows.DWORD;
    (* [unique][in] *) pvDestContext : windows.PVOID;
    (* [in] *)mshlflags : windows.DWORD;
    (* [out] *)pSize : windows.PDWORD ): HRESULT;

  VIRTUAL PROCEDURE MarshalInterface( 
    (* [unique][in] *) pStm : TPIStream;
    (* [in] *) CONST riid : IID;
    (* [unique][in] *) pv : windows.PVOID;
    (* [in] *) dwDestContext : windows.DWORD;
    (* [unique][in] *) pvDestContext : windows.PVOID;
    (* [in] *)mshlflags : windows.DWORD ): HRESULT;

  VIRTUAL PROCEDURE UnmarshalInterface( 
    (* [unique][in] *) pStm : TPIStream;
    (* [in] *) CONST riid : IID;
    (* [out] *) ppv : TPPVOID ): HRESULT;

  VIRTUAL PROCEDURE ReleaseMarshalData( 
    (* [unique][in] *) pStm : TPIStream ): HRESULT;

  VIRTUAL PROCEDURE DisconnectObject( 
    (* [in] *)dwReserved : windows.DWORD ): HRESULT;

END IMarshal;
  
//===== IMalloc
VAR 
  IID_IMalloc : IID;

INTERFACE IMalloc( unknwn.IUnknown );

  VIRTUAL PROCEDURE Alloc( 
    (* [in] *) cb : windows.ULONG ): windows.PVOID;

  VIRTUAL PROCEDURE Realloc( 
    (* [in] *) pv : windows.PVOID;
    (* [in] *) cb : windows.ULONG ): windows.PVOID;

  VIRTUAL PROCEDURE Free( 
    (* [in] *) pv : windows.PVOID );

  VIRTUAL PROCEDURE GetSize( 
    (* [in] *) pv : windows.PVOID ): windows.ULONG;

  VIRTUAL PROCEDURE DidAlloc( 
    pv : windows.PVOID ): windows.INT;

  VIRTUAL PROCEDURE HeapMinimize();

END IMalloc;

//===== IMallocSpy
VAR 
  IID_IMallocSpy : IID;

INTERFACE IMallocSpy( unknwn.IUnknown );
  
  VIRTUAL PROCEDURE  PreAlloc( 
      (* [in] *) cbRequest : windows.ULONG ): windows.ULONG;
  
  VIRTUAL PROCEDURE PostAlloc( 
      (* [in] *) pActual : windows.PVOID ): windows.PVOID;
  
  VIRTUAL PROCEDURE PreFree( 
      (* [in] *) pRequest : windows.PVOID;
      (* [in] *) fSpyed : windows.BOOL ): HRESULT;
  
  VIRTUAL PROCEDURE  PostFree( 
      (* [in] *) fSpyed : windows.BOOL );
  
  VIRTUAL PROCEDURE  PreRealloc( 
      (* [in] *) pRequest : windows.PVOID;
      (* [in] *) cbRequest : windows.ULONG;
      (* [out] *) ppNewRequest : windows.PPVOID;
      (* [in] *) fSpyed : windows.BOOL ): windows.ULONG;
  
  VIRTUAL PROCEDURE PostRealloc( 
      (* [in] *) pActual : ADDRESS;
      (* [in] *) fSpyed : windows.BOOL ): windows.PVOID;
  
  VIRTUAL PROCEDURE PreGetSize( 
      (* [in] *) pRequest : windows.PVOID;
      (* [in] *) fSpyed : windows.BOOL ): windows.PVOID;
  
  VIRTUAL PROCEDURE PostGetSize( 
      (* [in] *) cbActual : windows.ULONG;
      (* [in] *) fSpyed : windows.BOOL ): windows.ULONG;
  
  VIRTUAL PROCEDURE PreDidAlloc( 
      (* [in] *) pRequest : windows.PVOID;
      (* [in] *) fSpyed : windows.BOOL ): windows.PVOID;
  
  VIRTUAL PROCEDURE PostDidAlloc( 
      (* [in] *) pRequest : windows.PVOID;
      (* [in] *) fSpyed : windows.BOOL;
      (* [in] *) fActual : windows.INT ): windows.INT;
  
  VIRTUAL PROCEDURE PreHeapMinimize( );
  
  VIRTUAL PROCEDURE PostHeapMinimize( );
  
END IMallocSpy;

//===== IStdMarshalInfo 
VAR 
  IID_IStdMarshalInfo : IID;

INTERFACE IStdMarshalInfo( unknwn.IUnknown );

  VIRTUAL PROCEDURE GetClassForHandler( 
      (* [in] *) dwDestContext : windows.DWORD;
      (* [unique][in] *) pvDestContext : windows.PVOID;
      (* [out] *) pClsid : PCLSID ): HRESULT;
  
END IStdMarshalInfo;

//===== IExternalConnection
VAR 
  IID_IExternalConnection : IID;

TYPE
  EXTCONN = (
    EXTCONN_STRONG   = 1,
	  EXTCONN_WEAK     = 2,
	  EXTCONN_CALLABLE = 4
	);

INTERFACE IExternalConnection( unknwn.IUnknown );
 
  VIRTUAL PROCEDURE AddConnection( 
      (* [in] *)extconn : windows.DWORD;
      (* [in] *)reserved : windows.DWORD ): windows.DWORD;
  
  VIRTUAL PROCEDURE ReleaseConnection( 
      (* [in] *)extconn : windows.DWORD;
      (* [in] *)reserved : windows.DWORD;
      (* [in] *) fLastReleaseCloses : windows.BOOL ): windows.DWORD;
      
END IExternalConnection;

//===== IMultiQI
VAR 
  IID_IMultiQI : IID;

TYPE 
  TPIID = POINTER TO IID;
  MULTI_QI = RECORD
    pIID : TPIID;
    pItf : unknwn.TPIUnknown;
    hr : wtypes.HRESULT;
  END;
  PMULTI_QI = POINTER TO MULTI_QI;

TYPE
  TPIMultiQI = POINTER TO IMultiQI; 
  
INTERFACE IMultiQI( unknwn.IUnknown );

  VIRTUAL PROCEDURE QueryMultipleInterfaces( 
    (* [in] *) cMQIs : windows.ULONG;
    (* [out][in] *) pMQIs : PMULTI_QI ): HRESULT;

END IMultiQI;

//===== IEnumUnknown  
VAR 
  IID_IEnumUnknown : IID;

TYPE
  TPIEnumUnknown = POINTER TO IEnumUnknown;
  TPPIEnumUnknown = POINTER TO TPIEnumUnknown;
  TPPIUnknown = POINTER TO unknwn.TPIUnknown;
  
INTERFACE IEnumUnknown( unknwn.IUnknown );

  (* [local] *)VIRTUAL PROCEDURE Next( 
    (* [in] *) celt : windows.ULONG;
    (* [out] *) rgelt : TPPIUnknown;
    (* [out] *) pceltFetched : windows.PULONG ): HRESULT;

  VIRTUAL PROCEDURE Skip( 
    (* [in] *) celt : windows.ULONG ): HRESULT;

  VIRTUAL PROCEDURE Reset() : HRESULT;

  VIRTUAL PROCEDURE Clone( 
    (* [out] *)ppenum : TPPIEnumUnknown ): HRESULT;

END IEnumUnknown;      

TYPE

  (* [unique] *) PBC = POINTER TO IBindCtx;

  BIND_OPTS = RECORD
    cbStruct : windows.DWORD;
    grfFlags : windows.DWORD;
    grfMode : windows.DWORD;
    dwTickCountDeadline : windows.DWORD;
  END;

  PBIND_OPTS = POINTER TO BIND_OPTS;

  BIND_OPTS2 = RECORD
    cbStruct : windows.DWORD;
    grfFlags : windows.DWORD;
    grfMode : windows.DWORD;
    dwTickCountDeadline : windows.DWORD;
    dwTrackFlags : windows.DWORD;
    dwClassContext : windows.DWORD;
    locale : wtypes.LCID;
    pServerInfo : wtypes.COSERVERINFO;
  END;
  PBIND_OPTS2 = POINTER TO BIND_OPTS2;

TYPE
  BIND_FLAGS = (
    BIND_MAYBOTHERUSER      = 1,
    BIND_JUSTTESTEXISTENCE  = 2
  );

//===== IID_IBindCtx 
VAR 
  IID_IBindCtx : IID;

TYPE
  TPIBindCtx = POINTER TO IBindCtx;
  TPPOLESTR = POINTER TO wtypes.POLESTR;
  TPPIRunningObjectTable = POINTER TO TPIRunningObjectTable;

INTERFACE IBindCtx( unknwn.IUnknown );

  VIRTUAL PROCEDURE RegisterObjectBound( 
    (* [unique][in] *) punk : unknwn.TPIUnknown ): HRESULT;

  VIRTUAL PROCEDURE RevokeObjectBound( 
    (* [unique][in] *) punk : unknwn.TPIUnknown ): HRESULT;

  VIRTUAL PROCEDURE ReleaseBoundObjects( ): HRESULT;

  (* [local] *)  VIRTUAL PROCEDURE SetBindOptions( 
    (* [in] *) pbindopts : PBIND_OPTS ): HRESULT;

  (* [local] *)  VIRTUAL PROCEDURE GetBindOptions( 
    (* [out][in] *) pbindopts : PBIND_OPTS ): HRESULT;

  VIRTUAL  PROCEDURE GetRunningObjectTable( 
    (* [out] *) pprot : TPPIRunningObjectTable ): HRESULT;

  VIRTUAL  PROCEDURE RegisterObjectParam( 
    (* [in] *) pszKey : wtypes.POLESTR;
    (* [unique][in] *) punk : unknwn.TPIUnknown ): HRESULT;

  VIRTUAL  PROCEDURE GetObjectParam( 
    (* [in] *) pszKey : wtypes.POLESTR;
    (* [out] *) ppunk : TPPIUnknown ): HRESULT;

  VIRTUAL  PROCEDURE EnumObjectParam( 
    (* [out] *) ppenum : TPPIEnumString ): HRESULT;

  VIRTUAL PROCEDURE RevokeObjectParam( 
    (* [in] *) pszKey : wtypes.POLESTR ): HRESULT;

END IBindCtx;

TYPE
  TPIEnumMoniker  = POINTER TO IEnumMoniker;
  TPPIEnumMoniker = POINTER TO TPIEnumMoniker;

  TPIMoniker  = POINTER TO IMoniker;
  TPPIMoniker = POINTER TO TPIMoniker;
  
VAR 
  IID_IEnumMoniker : IID;
  
INTERFACE IEnumMoniker( unknwn.IUnknown );

  (* [local] *) VIRTUAL PROCEDURE Next( 
    (* [in] *) celt : windows.ULONG;
    (* [length_is][size_is][out] *)rgelt : TPPIMoniker;
    (* [out] *) pceltFetched : windows.ULONG ): HRESULT;

  VIRTUAL PROCEDURE Skip( 
    (* [in] *) celt : windows.ULONG ): HRESULT;

  VIRTUAL PROCEDURE Reset( ): HRESULT;

  VIRTUAL PROCEDURE Clone( 
    (* [out] *) ppenum : TPPIEnumMoniker ): HRESULT;

END IEnumMoniker;

VAR 
  IID_IRunnableObject : IID;

TYPE
  TPIRunnableObject = POINTER TO IRunnableObject;

INTERFACE IRunnableObject( unknwn.IUnknown );

  VIRTUAL PROCEDURE GetRunningClass( 
    (* [out] *) lpClsid : PCLSID ): HRESULT;

  VIRTUAL PROCEDURE Run( 
    (* [in] *) pbc : TPIBindCtx ): HRESULT;

  VIRTUAL PROCEDURE IsRunning( ): windows.BOOL;

  VIRTUAL PROCEDURE LockRunning( 
    (* [in] *) fLock : windows.BOOL;
    (* [in] *) fLastUnlockCloses : windows.BOOL ): HRESULT;

  VIRTUAL PROCEDURE SetContainedObject( 
    (* [in] *) fContained : windows.BOOL ): HRESULT;

END IRunnableObject;

VAR 
  IID_IRunningObjectTable : IID;
  
INTERFACE IRunningObjectTable( unknwn.IUnknown );

  VIRTUAL PROCEDURE Register( 
    (* [in] *)grfFlags : windows.DWORD;
    (* [unique][in] *) punkObject : unknwn.TPIUnknown;
    (* [unique][in] *) pmkObjectName : TPIMoniker;
    (* [out] *)pdwRegister : windows.DWORD ): HRESULT;

  VIRTUAL PROCEDURE Revoke( 
    (* [in] *)dwRegister : windows.DWORD ): HRESULT;

  VIRTUAL PROCEDURE IsRunning( 
    (* [unique][in] *) pmkObjectName : TPIMoniker ): HRESULT;

  VIRTUAL PROCEDURE GetObject( 
    (* [unique][in] *) pmkObjectName : TPIMoniker;
    (* [out] *) ppunkObject : TPPIUnknown ): HRESULT;

  VIRTUAL PROCEDURE NoteChangeTime( 
    (* [in] *)dwRegister : windows.DWORD;
    (* [in] *) pfiletime : windows.PFILETIME ): HRESULT;

  VIRTUAL PROCEDURE GetTimeOfLastChange( 
    (* [unique][in] *) pmkObjectName : TPIMoniker;
    (* [out] *) pfiletime : windows.PFILETIME ): HRESULT;

  VIRTUAL PROCEDURE EnumRunning( 
    (* [out] *) ppenumMoniker : TPPIEnumMoniker ): HRESULT;

END IRunningObjectTable;

VAR 
  IID_IPersist : IID;

TYPE
  TPIPersist = POINTER TO IPetrsist;

INTERFACE IPersist( unknwn.IUnknown );

  VIRTUAL  PROCEDURE GetClassID( 
      (* [out] *) pClassID : PCLSID ): HRESULT;

END IPersist;
  
TYPE
  TPIPersistStream = POINTER TO IPersistStream;

VAR 
  IID_IPersistStream : IID;

INTERFACE IPersistStream (IPersist);

  VIRTUAL PROCEDURE IsDirty( ): HRESULT;

  VIRTUAL PROCEDURE Load( 
    (* [unique][in] *) pStm : TPIStream ): HRESULT;

  VIRTUAL PROCEDURE Save( 
    (* [unique][in] *) pStm : TPIStream;
    (* [in] *) fClearDirty : windows.BOOL ): HRESULT;

  VIRTUAL PROCEDURE GetSizeMax( 
    (* [out] *) pcbSize : PULARGE_INTEGER ): HRESULT;

END IPersistStream;

TYPE
  MKSYS = (
    MKSYS_NONE	= 0,
	  MKSYS_GENERICCOMPOSITE	= 1,
	  MKSYS_FILEMONIKER	= 2,
	  MKSYS_ANTIMONIKER	= 3,
	  MKSYS_ITEMMONIKER	= 4,
	  MKSYS_POINTERMONIKER	= 5,
	  MKSYS_CLASSMONIKER	= 7
	);

  MKRREDUCE = (
    MKRREDUCE_ONE	= 3 << 16,
	  MKRREDUCE_TOUSER	= 2 << 16,
	  MKRREDUCE_THROUGHUSER	= 1 << 16,
	  MKRREDUCE_ALL	= 0
	);

VAR 
  IID_IMoniker : IID;
    
INTERFACE IMoniker( IPersistStream );

  (* [local] *) VIRTUAL PROCEDURE BindToObject( 
    (* [unique][in] *) pbc : TPIBindCtx;
    (* [unique][in] *) pmkToLeft : TPIMoniker;
    (* [in] *) CONST riidResult : IID;
    (* [VAR IID_is][out] *) ppvResult :TPPVOID ): HRESULT;

  (* [local] *) VIRTUAL PROCEDURE BindToStorage( 
    (* [unique][in] *) pbc : TPIBindCtx;
    (* [unique][in] *) pmkToLeft : TPIMoniker;
    (* [in] *) CONST riid : IID;
    (* [VAR IID_is][out] *) ppvObj :TPPVOID ): HRESULT;

  VIRTUAL PROCEDURE Reduce( 
    (* [unique][in] *) pbc : TPIBindCtx;
    (* [in] *)dwReduceHowFar : windows.DWORD;
    (* [unique][out][in] *) ppmkToLeft : TPPIMoniker;
    (* [out] *) ppmkReduced : TPPIMoniker ): HRESULT;

  VIRTUAL PROCEDURE ComposeWith( 
    (* [unique][in] *) pmkRight : TPIMoniker;
    (* [in] *) fOnlyIfNotGeneric : windows.BOOL;
    (* [out] *) ppmkComposite : TPPIMoniker ): HRESULT;

  VIRTUAL PROCEDURE Enum( 
    (* [in] *) fForward : windows.BOOL;
    (* [out] *) ppenumMoniker : TPPIEnumMoniker ): HRESULT;

  VIRTUAL PROCEDURE IsEqual( 
    (* [unique][in] *) pmkOtherMoniker : TPIMoniker ): HRESULT;

  VIRTUAL PROCEDURE Hash( 
    (* [out] *)pdwHash : windows.PDWORD ): HRESULT;

  VIRTUAL PROCEDURE IsRunning( 
    (* [unique][in] *) pbc : TPIBindCtx;
    (* [unique][in] *) pmkToLeft : TPIMoniker;
    (* [unique][in] *) pmkNewlyRunning : TPIMoniker ): HRESULT;

  VIRTUAL PROCEDURE GetTimeOfLastChange( 
    (* [unique][in] *) pbc : TPIBindCtx;
    (* [unique][in] *) pmkToLeft : TPIMoniker;
    (* [out] *) pfiletime : windows.PFILETIME ): HRESULT;

  VIRTUAL PROCEDURE Inverse( 
    (* [out] *) ppmk : TPPIMoniker ): HRESULT;

  VIRTUAL PROCEDURE CommonPrefixWith( 
    (* [unique][in] *) pmkOther : TPIMoniker;
    (* [out] *) ppmkPrefix : TPPIMoniker ): HRESULT;

  VIRTUAL PROCEDURE RelativePathTo( 
    (* [unique][in] *) pmkOther : TPIMoniker;
    (* [out] *) ppmkRelPath : TPPIMoniker ): HRESULT;

  VIRTUAL PROCEDURE GetDisplayName( 
    (* [unique][in] *) pbc : TPIBindCtx;
    (* [unique][in] *) pmkToLeft : TPIMoniker;
    (* [out] *) ppszDisplayName : TPPOLESTR ): HRESULT;

  VIRTUAL PROCEDURE ParseDisplayName( 
    (* [unique][in] *) pbc : TPIBindCtx;
    (* [unique][in] *) pmkToLeft : TPIMoniker;
    (* [in] *) pszDisplayName : wtypes.POLESTR;
    (* [out] *) pchEaten : windows.PULONG;
    (* [out] *) ppmkOut : TPPIMoniker ): HRESULT;

  VIRTUAL PROCEDURE IsSystemMoniker( 
    (* [out] *)pdwMksys : windows.PDWORD ): HRESULT;

END IMoniker;

VAR 
  IID_IROTData : IID;

TYPE
  TPIROTData = POINTER TO IROTData;

INTERFACE IROTData( unknwn.IUnknown );

    VIRTUAL PROCEDURE GetComparisonData( 
          (* [size_is][out] *) pbData : PBYTE;
          (* [in] *) cbMax : windows.ULONG;
          (* [out] *) pcbData : windows.PULONG ): HRESULT;
      
END IROTData;

VAR 
  IID_IEnumString : IID;
  
INTERFACE IEnumString( unknwn.IUnknown );

  (* [local] *)VIRTUAL PROCEDURE Next( 
    (* [in] *) celt : windows.ULONG;
    (* [length_is][size_is][out] *) rgelt : TPPOLESTR;
    (* [out] *) pceltFetched : windows.PULONG ): HRESULT;

  VIRTUAL PROCEDURE Skip( 
    (* [in] *) celt : windows.ULONG ): HRESULT;

  VIRTUAL PROCEDURE Reset( ): HRESULT;

  VIRTUAL PROCEDURE Clone( 
    (* [out] *) ppenum : TPPIEnumString ): HRESULT;

END IEnumString;

VAR 
  IID_ISequentialStream : IID;

TYPE
  TPISequentialStream = POINTER TO ISequentialStream;  
  
INTERFACE ISequentialStream( unknwn.IUnknown );

(* [local] *) VIRTUAL PROCEDURE Read( 
  (* [length_is][size_is][out] *) pv : ADDRESS;
  (* [in] *) cb : windows.ULONG;
  (* [out] *) pcbRead : windows.PULONG ): HRESULT;

(* [local] *) VIRTUAL PROCEDURE  Write( 
  (* [size_is][in] *) CONST pv : ADDRESS;
  (* [in] *) cb : windows.ULONG;
  (* [out] *) pcbWritten : windows.PULONG ): HRESULT;

END ISequentialStream;

TYPE
  PSTATSTG = POINTER TO STATSTG;
  STATSTG = RECORD
    pwcsName : wtypes.POLESTR;
    type : windows.DWORD;
    cbSize : ULARGE_INTEGER;
    mtime : windows.FILETIME;
    ctime : windows.FILETIME;
    atime : windows.FILETIME;
    grfMode : windows.DWORD;
    grfLocksSupported : windows.DWORD;
    clsid : CLSID;
    grfStateBits : windows.DWORD;
    reserved : windows.DWORD;
  END;

VAR 
  IID_IStream : IID;

TYPE
  STGTY = (
    STGTY_STORAGE	= 1,
	  STGTY_STREAM,
	  STGTY_LOCKBYTES,
	  STGTY_PROPERTY
	);

  STREAM_SEEK = (
    STREAM_SEEK_SET,
	  STREAM_SEEK_CUR,
	  STREAM_SEEK_END
	);

  LOCKTYPE = (
    LOCK_WRITE	= 1,
	  LOCK_EXCLUSIVE	= 2,
	  LOCK_ONLYONCE	= 4
	);

TYPE
  TPPIStream = POINTER TO TPIStream;

INTERFACE IStream( ISequentialStream );

  (* [local] *) VIRTUAL PROCEDURE Seek( 
    (* [in] *) dlibMove : windows.LARGE_INTEGER;
    (* [in] *)dwOrigin : windows.DWORD;
    (* [out] *)plibNewPosition : PULARGE_INTEGER ): HRESULT;

  VIRTUAL PROCEDURE SetSize( 
    (* [in] *)libNewSize : ULARGE_INTEGER ): HRESULT;

  (* [local] *)  VIRTUAL  PROCEDURE CopyTo( 
    (* [unique][in] *) pstm : TPIStream;
    (* [in] *) cb : ULARGE_INTEGER;
    (* [out] *) pcbRead : PULARGE_INTEGER;
    (* [out] *) pcbWritten : PULARGE_INTEGER ): HRESULT;

  VIRTUAL PROCEDURE Commit( 
    (* [in] *)grfCommitFlags : windows.DWORD ): HRESULT;

  VIRTUAL PROCEDURE Revert( ): HRESULT;

  VIRTUAL PROCEDURE LockRegion( 
    (* [in] *) libOffset : ULARGE_INTEGER;
    (* [in] *) cb : ULARGE_INTEGER;
    (* [in] *)dwLockType : windows.DWORD ): HRESULT;

  VIRTUAL PROCEDURE UnlockRegion( 
    (* [in] *)libOffset : ULARGE_INTEGER;
    (* [in] *) cb : ULARGE_INTEGER;
    (* [in] *)dwLockType : windows.DWORD ): HRESULT;

  VIRTUAL PROCEDURE Stat( 
    (* [out] *) pstatstg : PSTATSTG;
    (* [in] *)grfStatFlag : windows.DWORD ): HRESULT;

  VIRTUAL PROCEDURE Clone( 
    (* [out] *) ppstm : TPPIStream ): HRESULT;

END IStream;

VAR 
  IID_IEnumSTATSTG : IID;

TYPE
  TPIEnumSTATSTG = POINTER TO IEnumSTATSTG;
  TPPIEnumSTATSTG = POINTER TO TPIEnumSTATSTG;

INTERFACE IEnumSTATSTG( unknwn.IUnknown );

  (* [local] *) VIRTUAL PROCEDURE Next( 
    (* [in] *) celt : windows.ULONG;
    (* [length_is][size_is][out] *) rgelt : PSTATSTG;
    (* [out] *) pceltFetched : windows.PULONG ): HRESULT;

  VIRTUAL PROCEDURE Skip( 
    (* [in] *) celt : windows.ULONG ): HRESULT;

  VIRTUAL PROCEDURE Reset( ): HRESULT;

  VIRTUAL PROCEDURE Clone( 
    (* [out] *) ppenum : TPPIEnumSTATSTG ): HRESULT;

END IEnumSTATSTG;

TYPE 
  RemSNB = RECORD
    
    ulCntStr : windows.ULONG;
    ulCntChar : windows.ULONG;
    //?????
    rgString : ARRAY [0..0] OF wtypes.OLECHAR;

  END;
  
  wireSNB = POINTER TO RemSNB;
  TPRemSNB = POINTER TO RemSNB;

VAR 
  IID_IStorage : IID;

TYPE
  TPIStorage = POINTER TO IStorage;
  TPPIStorage = POINTER TO TPIStorage;
  SNB = POINTER TO wtypes.POLECHAR;
  PSNB = POINTER TO SNB;

INTERFACE IStorage( unknwn.IUnknown );

  VIRTUAL PROCEDURE CreateStream( 
    (* [string][in] *) pwcsName : wtypes.POLECHAR;
    (* [in] *)grfMode : windows.DWORD;
    (* [in] *)reserved1 : windows.DWORD;
    (* [in] *)reserved2 : windows.DWORD;
    (* [out] *) ppstm : TPPIStream ): HRESULT;

  (* [local] *) VIRTUAL PROCEDURE OpenStream( 
    (* [string][in] *) pwcsName : wtypes.POLECHAR;
    (* [unique][in] *) reserved1 : windows.PVOID;
    (* [in] *)grfMode : windows.DWORD;
    (* [in] *)reserved2 : windows.DWORD;
    (* [out] *) ppstm : TPPIStream ): HRESULT;

  VIRTUAL PROCEDURE CreateStorage( 
    (* [string][in] *) pwcsName : wtypes.POLECHAR;
    (* [in] *)grfMode : windows.DWORD;
    (* [in] *)dwStgFmt : windows.DWORD;
    (* [in] *)reserved2 : windows.DWORD;
    (* [out] *)ppstg : TPPIStorage ): HRESULT;

  VIRTUAL PROCEDURE OpenStorage( 
    (* [string][unique][in] *) pwcsName : wtypes.POLECHAR;
    (* [unique][in] *) pstgPriority : TPIStorage;
    (* [in] *)grfMode : windows.DWORD;
    (* [unique][in] *) snbExclude : SNB;
    (* [in] *)reserved : windows.DWORD;
    (* [out] *) ppstg : TPPIStorage ): HRESULT;

