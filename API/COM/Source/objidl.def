TYPE
  STGMEDIUM = RECORD
    tymed : windows.DWORD;
//    (* [switch_is][switch_type] *) union
      CASE : CARDINAL OF     
      (* [case()] *) | 0: hBitmap : windows.HBITMAP;
      (* [case()] *) | 1: hMetaFilePict : wtypes.HMETAFILEPICT;
      (* [case()] *) | 2: hEnhMetaFile : windows.HENHMETAFILE;
      (* [case()] *) | 3: hGlobal : windows.HGLOBAL;
      (* [case()] *) | 4: lpszFileName : wtypes.POLESTR;
      (* [case()] *) | 5: pstm : TPIStream;
      (* [case()] *) | 6: pstg : TPIStorage;
      (* [default] *)  (* Empty union arm *) 
      END;
    pUnkForRelease : unknwn.TPIUnknown;
  END;
  PSTGMEDIUM = POINTER TO STGMEDIUM; 
  
  GDI_OBJECT = RECORD
    ObjectType : windows.DWORD;
  //  (* [switch_is] *) (* [switch_type] *) union __MIDL_IAdviseSink_0002
    u : RECORD
      CASE : CARDINAL OF 
        | 0 :(* [case()] *) hBitmap : wtypes.wireHBITMAP;
        | 1 :(* [case()] *) hPalette : wtypes.wireHPALETTE;
        | 2 :(* [default] *) hGeneric : wtypes.wireHGLOBAL;
      END;
    END;
  END;
  PGDI_OBJECT = POINTER TO GDI_OBJECT;

  userSTGMEDIUM = RECORD
    tymed : windows.DWORD;
    u : RECORD
      CASE : CARDINAL OF
            (* [case()] *)  (* Empty union arm *) 
         | 0:(* [case()] *) hMetaFilePict : wtypes.wireHMETAFILEPICT;
         | 1:(* [case()] *)  hHEnhMetaFile : wtypes.wireHENHMETAFILE;
         | 2:(* [case()] *) hGdiHandle : PGDI_OBJECT;
         | 3:(* [case()] *) hGlobal : wtypes.wireHGLOBAL;
         | 4:(* [case()] *) lpszFileName : wtypes.POLESTR;
         | 5:(* [case()] *) pstm : wtypes.UP_BYTE_BLOB;
         | 6:(* [case()] *) pstg : wtypes.UP_BYTE_BLOB;
      END;
    END;
    pUnkForRelease : unknwn.TPIUnknown;
  END;

TYPE
  wireSTGMEDIUM = POINTER TO userSTGMEDIUM;

