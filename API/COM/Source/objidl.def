        (* [case()] *)|46: cauuid : CACLSID;
        (* [case()] *)|47: caclipdata : CACLIPDATA;
        (* [case()] *)|48: cabstr : CABSTR;
        (* [case()] *)|49: calpstr : CALPSTR;
        (* [case()] *)|50: calpwstr : CALPWSTR;
        (* [case()] *)|51: capropvar : CAPROPVARIANT;
    END;
 END;

// Reserved global Property IDs
CONST

  PID_DICTIONARY	= 0;
	PID_CODEPAGE	= 1;
	PID_FIRST_USABLE	= 2;
	PID_FIRST_NAME_DEFAULT	= 0FFFH;
	PID_LOCALE	= 080000000H;
	PID_MODIFY_TIME	= 080000001H;
	PID_SECURITY	= 080000002H;
	PID_ILLEGAL	= 0FFFFFFFFH;

// Property IDs for the SummaryInformation Property Set

  PIDSI_TITLE           =    000000002;  // VT_LPSTR
  PIDSI_SUBJECT         =    000000003;  // VT_LPSTR
  PIDSI_AUTHOR          =    000000004;  // VT_LPSTR
  PIDSI_KEYWORDS        =    000000005;  // VT_LPSTR
  PIDSI_COMMENTS        =    000000006;  // VT_LPSTR
  PIDSI_TEMPLATE        =    000000007;  // VT_LPSTR
  PIDSI_LASTAUTHOR      =    000000008;  // VT_LPSTR
  PIDSI_REVNUMBER       =    000000009;  // VT_LPSTR
  PIDSI_EDITTIME        =    00000000AH;  // VT_FILETIME =UTC;
  PIDSI_LASTPRINTED     =    00000000BH;  // VT_FILETIME =UTC;
  PIDSI_CREATE_DTM      =    00000000CH;  // VT_FILETIME =UTC;
  PIDSI_LASTSAVE_DTM    =    00000000DH;  // VT_FILETIME =UTC;
  PIDSI_PAGECOUNT       =    00000000EH;  // VT_I4
  PIDSI_WORDCOUNT       =    00000000FH;  // VT_I4
  PIDSI_CHARCOUNT       =    000000010H;  // VT_I4
  PIDSI_THUMBNAIL       =    000000011H;  // VT_CF
  PIDSI_APPNAME         =    000000012H;  // VT_LPSTR
  PIDSI_DOC_SECURITY    =    000000013H;  // VT_I4
  PRSPEC_INVALID	= 0FFFFFFFFH;
  PRSPEC_LPWSTR	= 0;
  PRSPEC_PROPID	= 1;

TYPE

  PROPSPEC = RECORD
    ulKind : windows.ULONG;
    CASE : CARDINAL OF 
      | 0: propid : wtypes.PROPID;
      | 1: lpwstr : wtypes.POLESTR;
    (* [default] *)  (* Empty union arm *) 
    END;
  END;

  PPROSPEC = POINTER TO PROPSPEC;

  STATPROPSTG = RECORD
    lpwstrName : wtypes.POLESTR;
    propid : wtypes.PROPID;
    vt : wtypes.VARTYPE;
  END;

// Macros for parsing the OS Version of the Property Set Header
(*
PROPSETHDR_OSVER_KIND(dwOSVer)      HIWORD( (dwOSVer) )
PROPSETHDR_OSVER_MAJOR(dwOSVer)     LOBYTE(LOWORD( (dwOSVer) ))
PROPSETHDR_OSVER_MINOR(dwOSVer)     HIBYTE(LOWORD( (dwOSVer) ))
PROPSETHDR_OSVERSION_UNKNOWN        0xFFFFFFFF
*)
(*# call( macro => on ) *)
PROCEDURE PROPSETHDR_OSVER_KIND (dwOSVer : windows.DWORD ): CARD16;
PROCEDURE PROPSETHDR_OSVER_MAJOR (dwOSVer : windows.DWORD ): CARD8;
PROCEDURE PROPSETHDR_OSVER_MINOR (dwOSVer : windows.DWORD ): CARD8;
(*# call( macro => off ) *)

CONST
  PROPSETHDR_OSVERSION_UNKNOWN  = 0FFFFFFFFH;

TYPE
  STATPROPSETSTG = RECORD
    fmtid : FMTID;
    clsid : CLSID;
    grfFlags : windows.DWORD;
    mtime : windows.FILETIME;
    ctime : windows.FILETIME;
    atime : windows.FILETIME;
    dwOSVersion : windows.DWORD;
  END;

VAR 
  IID_IPropertyStorage : IID;

TYPE
  TPIPropertyStorage = POINTER TO IPropertyStorage;
  Trgpspec = ARRAY [0..0] OF PROPSPEC;
  Trgpropvar = ARRAY [0..0] OF PROPVARIANT;
  Trgpropid = ARRAY [0..0] OF wtypes.PROPID;
  TrglpwstrName = ARRAY [0..0] OF wtypes.POLESTR;
  TPIEnumSTATPROPSTG = POINTER TO IEnumSTATPROPSTG;  
  TPPIEnumSTATPROPSTG = POINTER TO TPIEnumSTATPROPSTG;
  TPIEnumSTATPROPSETSTG = POINTER TO IEnumSTATPROPSETSTG;
  TPPIEnumSTATPROPSETSTG = POINTER TO TPIEnumSTATPROPSETSTG;
  TPIPropertySetStorage = POINTER TO IPropertySetStorage;  
  TPPIPropertySetStorage = POINTER TO TPIPropertySetStorage;
  
INTERFACE IPropertyStorage( unknwn.IUnknown );

  VIRTUAL PROCEDURE ReadMultiple( 
    (* [in] *) cpspec : windows.ULONG;
    (* [size_is][in] *) rgpspec : Trgpspec;
    (* [size_is][out] *) rgpropvar : Trgpropvar  ): HRESULT;

  VIRTUAL PROCEDURE WriteMultiple( 
    (* [in] *) cpspec : windows.ULONG;
    (* [size_is][in] *) rgpspec : Trgpspec;
    (* [size_is][in] *)  rgpropvar : Trgpropvar;
    (* [in] *)   propidNameFirst : wtypes.PROPID ): HRESULT;

  VIRTUAL PROCEDURE DeleteMultiple( 
    (* [in] *) cpspec : windows.ULONG;
    (* [size_is][in] *) rgpspec : Trgpspec  ): HRESULT;

  VIRTUAL PROCEDURE ReadPropertyNames( 
    (* [in] *) cpropid : windows.ULONG;
    (* [size_is][in] *) rgpropid : Trgpropid;
    (* [size_is][out] *) rglpwstrName : TrglpwstrName  ): HRESULT;

  VIRTUAL PROCEDURE WritePropertyNames( 
    (* [in] *) cpropid : windows.ULONG;
    (* [size_is][in] *) rgpropid : Trgpropid;
    (* [size_is][in] *) rglpwstrName : TrglpwstrName  ): HRESULT;

  VIRTUAL PROCEDURE DeletePropertyNames( 
    (* [in] *) cpropid : windows.ULONG;
    (* [size_is][in] *) rgpropid : Trgpropid  ): HRESULT;

  VIRTUAL PROCEDURE Commit( 
    (* [in] *)grfCommitFlags : windows.DWORD ): HRESULT;

  VIRTUAL PROCEDURE Revert( ): HRESULT;

  VIRTUAL PROCEDURE Enum( 
    (* [out] *) ppenum : TPPIEnumSTATPROPSTG ): HRESULT;

  VIRTUAL PROCEDURE SetTimes( 
    (* [in] *)  pctime : windows.PFILETIME;
    (* [in] *)  patime : windows.PFILETIME;
    (* [in] *)  pmtime : windows.PFILETIME ): HRESULT;

  VIRTUAL PROCEDURE SetClass( 
    (* [in] *)  CONST clsid : CLSID ): HRESULT;

  VIRTUAL PROCEDURE Stat( 
    (* [out] *) pstatpsstg : PSTATPROPSETSTG ): HRESULT;
  
END IPropertyStorage;

VAR 
  IID_IPropertySetStorage : IID;

INTERFACE IPropertySetStorage( unknwn.IUnknown );

  VIRTUAL PROCEDURE Create( 
    (* [in] *) CONST rfmtid : FMTID;
    (* [unique][in] *) pClsid : PCLSID;
    (* [in] *)grfFlags : windows.DWORD;
    (* [in] *)grfMode : windows.DWORD;
    (* [out] *) VAR ppprstg : TPIPropertyStorage ): HRESULT;

  VIRTUAL PROCEDURE Open( 
    (* [in] *) CONST rfmtid : FMTID;
    (* [in] *)grfMode : windows.DWORD;
    (* [out] *) VAR ppprstg : TPIPropertyStorage ): HRESULT;

  VIRTUAL PROCEDURE Delete( 
    (* [in] *) CONST rfmtid : FMTID  ): HRESULT;

  VIRTUAL PROCEDURE Enum( 
    (* [out] *) ppenum : TPPIEnumSTATPROPSETSTG ): HRESULT;

END IPropertySetStorage;

VAR 
  IID_IEnumSTATPROPSTG : IID;

INTERFACE IEnumSTATPROPSTG( unknwn.IUnknown );

  VIRTUAL (* [local] *)   PROCEDURE Next( 
    (* [in] *) celt : windows.ULONG;
    (* [length_is][size_is][out] *) rgelt : STATPROPSTG;
    (* [out] *) pceltFetched : windows.PULONG ): HRESULT;

  VIRTUAL PROCEDURE Skip( 
    (* [in] *) celt : windows.ULONG ): HRESULT;

  VIRTUAL PROCEDURE Reset( ): HRESULT;

  VIRTUAL PROCEDURE Clone( 
    (* [out] *) ppenum : TPPIEnumSTATPROPSTG ): HRESULT;
  
END IEnumSTATPROPSTG;

VAR 
  IID_IEnumSTATPROPSETSTG : IID;

INTERFACE IEnumSTATPROPSETSTG( unknwn.IUnknown );

  VIRTUAL (* [local] *)   PROCEDURE Next( 
    (* [in] *) celt : windows.ULONG;
    (* [length_is][size_is][out] *) rgelt : PSTATPROPSETSTG;
    (* [out] *) pceltFetched : windows.PULONG ): HRESULT;

  VIRTUAL PROCEDURE Skip( 
    (* [in] *) celt : windows.ULONG ): HRESULT;

  VIRTUAL PROCEDURE Reset( ): HRESULT;

  VIRTUAL PROCEDURE Clone( 
    (* [out] *) ppenum : TPPIEnumSTATPROPSETSTG ): HRESULT;

END IEnumSTATPROPSETSTG;

PROCEDURE PropVariantCopy ( pvarDest : PPROPVARIANT ; pvarSrc : PPROPVARIANT  ): HRESULT;
PROCEDURE PropVariantClear ( pvar : PPROPVARIANT  ): HRESULT;

//inline void PropVariantInit ( PROPVARIANT * pvar )
PROCEDURE PropVariantInit ( pvar : PPROPVARIANT );  
PROCEDURE FreePropVariantArray (cVariants : windows.ULONG ;rgvars : PPROPVARIANT ): HRESULT;

VAR
  IID_IFillLockBytes : IID;

TYPE
  TPIFillLockBytes = POINTER TO IFillLockBytes;
  
INTERFACE IFillLockBytes( unknwn.IUnknown );

  (* [local] *) VIRTUAL PROCEDURE FillAppend( 
    (* [size_is][in] *) pv : windows.PVOID;
    (* [in] *) cb : windows.ULONG;
    (* [out] *) pcbWritten : windows.PULONG ): HRESULT;

  (* [local] *) VIRTUAL PROCEDURE FillAt( 
    (* [in] *) ulOffset : ULARGE_INTEGER;
    (* [size_is][in] *)  pv : windows.PVOID;
    (* [in] *) cb : windows.ULONG;
    (* [out] *) pcbWritten : windows.PULONG ): HRESULT;

  VIRTUAL PROCEDURE SetFillSize( 
    (* [in] *) ulSize : ULARGE_INTEGER ): HRESULT;

  VIRTUAL PROCEDURE Terminate( 
    (* [in] *) bCanceled : windows.BOOL ): HRESULT;

END IFillLockBytes;

VAR 
  IID_IProgressNotify : IID;

TYPE
  TPIProgressNotify = POINTER TO IProgresNotify;

INTERFACE IProgressNotify( unknwn.IUnknown );

  VIRTUAL PROCEDURE OnProgress( 
    (* [in] *)dwProgressCurrent : windows.DWORD;
    (* [in] *)dwProgressMaximum : windows.DWORD;
    (* [in] *) fAccurate : windows.BOOL;
    (* [in] *) fOwner : windows.BOOL ): HRESULT;
      
END IProgressNotify;

TYPE
  PStorageLayout = POINTER TO StorageLayout;
  StorageLayout = RECORD
    LayoutType : windows.DWORD;
    pwcsElementName : wtypes.POLECHAR;
    cOffset : windows.LARGE_INTEGER;
    cBytes : windows.LARGE_INTEGER;
  END;

VAR 
  IID_ILayoutStorage : IID;

TYPE
  TPILayoutStorage = POINTER TO ILayoutStorage;

INTERFACE ILayoutStorage( unknwn.IUnknown );

  VIRTUAL PROCEDURE  LayoutScript( 
    (* [in] *) pStorageLayout : PStorageLayout;
    (* [in] *)nEntries : windows.DWORD;
    (* [in] *)glfInterleavedFlag : windows.DWORD ): HRESULT;
  
  VIRTUAL PROCEDURE  BeginMonitor( ): HRESULT;
  
  VIRTUAL PROCEDURE  EndMonitor( ): HRESULT;
  
  VIRTUAL PROCEDURE  ReLayoutDocfile( 
    (* [in] *) pwcsNewDfName : wtypes.POLECHAR ): HRESULT;
  
  VIRTUAL PROCEDURE  ReLayoutDocfileOnILockBytes( 
    (* [in] *) pILockBytes : TPILockBytes ): HRESULT;
  
END ILayoutStorage;

TYPE
  TPCLIPFORMAT = POINTER TO wtypes.userCLIPFORMAT; 

  ASYNC_STGMEDIUM_UserSize = PROCEDURE (windows.PULONG, windows.ULONG, PASYNC_STGMEDIUM ): windows.ULONG; 
  ASYNC_STGMEDIUM_UserMarshal = PROCEDURE ( windows.PULONG, windows.PUCHAR, PASYNC_STGMEDIUM ): windows.PUCHAR; 
  ASYNC_STGMEDIUM_UserUnmarshal = PROCEDURE (windows.PULONG, windows.PUCHAR, PASYNC_STGMEDIUM ): windows.PUCHAR; 
  ASYNC_STGMEDIUM_UserFree = PROCEDURE (windows.PULONG, PASYNC_STGMEDIUM ); 

  BSTR_UserSize = PROCEDURE (windows.PULONG, windows.ULONG, wtypes.PBSTR  ): windows.ULONG; 
  BSTR_UserMarshal = PROCEDURE ( windows.PULONG, windows.PUCHAR, wtypes.PBSTR  ): windows.PUCHAR; 
  BSTR_UserUnmarshal = PROCEDURE (windows.PULONG, windows.PUCHAR, wtypes.PBSTR  ): windows.PUCHAR; 
  BSTR_UserFree = PROCEDURE (windows.PULONG, wtypes.PBSTR  ); 

  CLIPFORMAT_UserSize = PROCEDURE (windows.PULONG, windows.ULONG,TPCLIPFORMAT ): windows.ULONG; 
  CLIPFORMAT_UserMarshal = PROCEDURE ( windows.PULONG, windows.PUCHAR,TPCLIPFORMAT ): windows.PUCHAR; 
  CLIPFORMAT_UserUnmarshal = PROCEDURE (windows.PULONG, windows.PUCHAR,TPCLIPFORMAT ): windows.PUCHAR; 
  CLIPFORMAT_UserFree = PROCEDURE (windows.PULONG,TPCLIPFORMAT ); 

  FLAG_STGMEDIUM_UserSize = PROCEDURE (windows.PULONG, windows.ULONG, PFLAG_STGMEDIUM ): windows.ULONG; 
  FLAG_STGMEDIUM_UserMarshal = PROCEDURE ( windows.PULONG, windows.PUCHAR, PFLAG_STGMEDIUM ): windows.PUCHAR; 
  FLAG_STGMEDIUM_UserUnmarshal = PROCEDURE (windows.PULONG, windows.PUCHAR, PFLAG_STGMEDIUM ): windows.PUCHAR; 
  FLAG_STGMEDIUM_UserFree = PROCEDURE (windows.PULONG, PFLAG_STGMEDIUM ); 

  SNB_UserSize = PROCEDURE (windows.PULONG, windows.ULONG, PSNB ): windows.ULONG; 
  SNB_UserMarshal = PROCEDURE ( windows.PULONG, windows.PUCHAR, PSNB ): windows.PUCHAR; 
  SNB_UserUnmarshal = PROCEDURE (windows.PULONG, windows.PUCHAR, PSNB ): windows.PUCHAR; 
  SNB_UserFree = PROCEDURE (windows.PULONG, PSNB); 

  STGMEDIUM_UserSize = PROCEDURE (windows.PULONG,windows.ULONG, PSTGMEDIUM  ): windows.ULONG; 
  STGMEDIUM_UserMarshal = PROCEDURE ( windows.PULONG, windows.PUCHAR, PSTGMEDIUM  ): windows.PUCHAR; 
  STGMEDIUM_UserUnmarshal = PROCEDURE (windows.PULONG, windows.PUCHAR, PSTGMEDIUM  ): windows.PUCHAR; 
  STGMEDIUM_UserFree = PROCEDURE (windows.PULONG, PSTGMEDIUM  ); 

END objidl.

