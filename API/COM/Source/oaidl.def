//===== ITypeLib
VAR
  IID_ITypeLib : IID;

TYPE
  SYSKIND = (
    SYS_WIN16,
    SYS_WIN32,
    SYS_MAC
  );

  LIBFLAGS = (
    LIBFLAG_FRESTRICTED	= 01H,
    LIBFLAG_FCONTROL	= 02H,
    LIBFLAG_FHIDDEN	= 04H,
    LIBFLAG_FHASDISKIMAGE	= 08H
  );

  TLIBATTR = RECORD
    guid : GUID;
    lcid : wtypes.LCID;
    syskind : SYSKIND;
    wMajorVerNum : WORD;
    wMinorVerNum : WORD;
    wLibFlags : WORD;
  END;
  PTLIBATTR = POINTER TO TLIBATTR;

COM INTERFACE ITypeLib( unknwn.IUnknown );

  VIRTUAL PROCEDURE (* [local] *) GetTypeInfoCount(): windows.UINT;
  
  VIRTUAL PROCEDURE GetTypeInfo( 
      (* [in] *) index : windows.UINT;
      (* [out] *) VAR ppTInfo : TPITypeInfo ): HRESULT;
  
