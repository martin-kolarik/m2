      (* [in] *) index : windows.UINT;
      (* [out] *) pTKind : PTYPEKIND ): HRESULT;
  
  VIRTUAL PROCEDURE GetTypeInfoOfGuid( 
      (* [in] *) CONST guid : GUID;
      (* [out] *) VAR ppTinfo : TPITypeInfo ): HRESULT;
  
  VIRTUAL PROCEDURE (* [local] *) GetLibAttr( 
      (* [out] *) VAR ppTLibAttr : PTLIBATTR ): HRESULT;
  
  VIRTUAL PROCEDURE GetTypeComp( 
      (* [out] *) VAR ppTComp : TPITypeComp ): HRESULT;
  
  VIRTUAL PROCEDURE (* [local] *) GetDocumentation( 
      (* [in] *) index : windows.INT;
      (* [out] *) pBstrName : wtypes.PBSTR;
      (* [out] *) pBstrDocString : wtypes.PBSTR;
      (* [out] *) pdwHelpContext : windows.PDWORD;
      (* [out] *) pBstrHelpFile : wtypes.PBSTR ): HRESULT;
  
  VIRTUAL PROCEDURE (* [local] *) IsName( 
      (* [out][in] *) szNameBuf : wtypes.POLESTR;
      (* [in] *) lHashVal : windows.ULONG;
      (* [out] *) pfName : windows.PBOOL ): HRESULT;
  
  VIRTUAL PROCEDURE (* [local] *) FindName( 
      (* [out][in] *) szNameBuf : wtypes.POLESTR;
      (* [in] *) lHashVal : windows.ULONG;
      (* [length_is][size_is][out] *) VAR ppTInfo : TPITypeInfo;
      (* [length_is][size_is][out] *) rgMemId : PMEMBERID;
      (* [out][in] *) pcFound : windows.PUSHORT ): HRESULT;
  
  VIRTUAL PROCEDURE (* [local] *) ReleaseTLibAttr( 
      (* [in] *) pTLibAttr : PTLIBATTR );
  
END ITypeLib;

