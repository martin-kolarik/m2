//===== IDispatch
VAR
  IID_IDispatch : IID;

CONST
  // DISPID reserved to indicate an "unknown" name
  // only reserved for data members (properties); reused as a method dispid below
  DISPID_UNKNOWN     = -1;
  // DISPID reserved for the "value" property
  DISPID_VALUE = 0;
  // The following DISPID is reserved to indicate the param
  // that is the right-hand-side (or "put" value) of a PropertyPut
  DISPID_PROPERTYPUT = -3;
  // DISPID reserved for the standard "NewEnum" method
  DISPID_NEWENUM     = -4;
  // DISPID reserved for the standard "Evaluate" method
  DISPID_EVALUATE    = -5;
  DISPID_CONSTRUCTOR = -6;
  DISPID_DESTRUCTOR  = -7;
  DISPID_COLLECT     = -8;

  // The range -500 through -999 is reserved for Controls
  // The range 0x80010000 through 0x8001FFFF is reserved for Controls
  // The range -5000 through -5499 is reserved for ActiveX Accessibility
  // The remainder of the negative DISPIDs are reserved for future use

COM INTERFACE IDispatch( unknwn.IUnknown );

  VIRTUAL PROCEDURE GetTypeInfoCount( 
      (* [out] *) pctinfo : windows.PUINT ): HRESULT;
  
  VIRTUAL PROCEDURE GetTypeInfo( 
      (* [in] *) iTInfo : windows.UINT;
      (* [in] *) lcid : wtypes.LCID;
      (* [out] *) VAR ppTInfo : TPITypeInfo ): HRESULT;
  
  VIRTUAL PROCEDURE GetIDsOfNames( 
      (* [in] *) CONST riid : IID;
      (* [size_is][in] *) rgszNames : wtypes.PPOLESTR;
      (* [in] *) cNames : windows.UINT;
      (* [in] *) lcid : wtypes.LCID;
      (* [size_is][out] *) rgDispId : PDISPID ): HRESULT;
  
  (* [local] *) VIRTUAL PROCEDURE Invoke( 
      (* [in] *) dispIdMember : DISPID;
      (* [in] *) CONST riid : IID;
      (* [in] *) lcid : wtypes.LCID;
      (* [in] *) wFlags : WORD;
      (* [out][in] *) pDispParams : PDISPPARAMS;
      (* [out] *) pVarResult : PVARIANT;
      (* [out] *) pExcepInfo : PEXCEPINFO;
      (* [out] *) puArgErr : windows.PUINT ): HRESULT;
  
END IDispatch;    

