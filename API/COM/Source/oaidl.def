//===== ITypeChangeEvents;
VAR
  IID_ITypeChangeEvents : IID;

TYPE
  CHANGEKIND = (
    CHANGEKIND_ADDMEMBER,
    CHANGEKIND_DELETEMEMBER	= CHANGEKIND_ADDMEMBER + 1,
    CHANGEKIND_SETNAMES	= CHANGEKIND_DELETEMEMBER + 1,
    CHANGEKIND_SETDOCUMENTATION	= CHANGEKIND_SETNAMES + 1,
    CHANGEKIND_GENERAL	= CHANGEKIND_SETDOCUMENTATION + 1,
    CHANGEKIND_INVALIDATE	= CHANGEKIND_GENERAL + 1,
    CHANGEKIND_CHANGEFAILED	= CHANGEKIND_INVALIDATE + 1,
    CHANGEKIND_MAX	= CHANGEKIND_CHANGEFAILED + 1
  );

COM INTERFACE ITypeChangeEvents( unknwn.IUnknown );

  VIRTUAL PROCEDURE RequestTypeChange( 
      (* [in] *) changeKind : CHANGEKIND;
      (* [in] *) pTInfoBefore : TPITypeInfo;
      (* [in] *) pStrName : wtypes.POLESTR;
      (* [out] *) pfCancel : windows.PINT ): HRESULT;
  
  VIRTUAL PROCEDURE AfterTypeChange( 
      (* [in] *) changeKind : CHANGEKIND;
      (* [in] *) pTInfoAfter : TPITypeInfo;
      (* [in] *) pStrName : wtypes.POLESTR ): HRESULT;
  
END ITypeChangeEvents;
    
