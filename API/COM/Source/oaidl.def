    DESCKIND_TYPECOMP,
    DESCKIND_IMPLICITAPPOBJ,
    DESCKIND_MAX
  );
  PDESCKIND = POINTER TO DESCKIND;

  BINDPTR = RECORD
    lpfuncdesc : PFUNCDESC;
    lpvardesc : PVARDESC;
    lptcomp : TPITypeComp;
  END;
  PBINDPTR = POINTER TO BINDPTR;

