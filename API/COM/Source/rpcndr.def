PROCEDURE RpcSmEnableAllocate(): rpcdce.RPC_STATUS;

PROCEDURE RpcSmFree(
      NodeToFree : ADDRESS
    ): rpcdce.RPC_STATUS;

PROCEDURE RpcSmGetThreadHandle(
     VAR pStatus :  rpcdce.RPC_STATUS
    ): RPC_SS_THREAD_HANDLE;

PROCEDURE RpcSmSetClientAllocFree (
     ClientAlloc : RPC_CLIENT_ALLOC;
     ClientFree : RPC_CLIENT_FREE
    ): rpcdce.RPC_STATUS;

PROCEDURE RpcSmSetThreadHandle (
     Id : RPC_SS_THREAD_HANDLE
    ): rpcdce.RPC_STATUS;

PROCEDURE RpcSmSwapClientAllocFree (
     ClientAlloc : RPC_CLIENT_ALLOC;
     ClientFree : RPC_CLIENT_FREE;
     OldClientAlloc : PRPC_CLIENT_ALLOC;
     OldClientFree : PRPC_CLIENT_FREE
    ): rpcdce.RPC_STATUS;

