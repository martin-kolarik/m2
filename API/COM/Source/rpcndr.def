(*/**************************************************************************
 * Context handle management related definitions:
 *
 * Client and Server Contexts.
 *
 **************************************************************************/*)

TYPE

  NDR_CCONTEXT = ADDRESS;
  PNDR_CCONTEXT = POINTER TO NDR_CCONTEXT;

  TContext = RECORD
    pad : ARRAY [0..1] OF ADDRESS;
    userContext : ADDRESS;
  END;
  NDR_SCONTEXT = POINTER TO TContext;

//#define NDRSContextValue(hContext) (&(hContext)->userContext)
