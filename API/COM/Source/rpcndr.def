PROCEDURE NDRSContextValue( _ : TContext ): ADDRESS;
(*# call( macro => off ) *)

CONST
  cbNDRContext = 20;         // size of context on WIRE

TYPE

  NDR_RUNDOWN = PROCEDURE( (* context : *) ADDRESS );

  SCONTEXT_QUEUE = RECORD
    NumberOfObjects : LONGCARD;
    ArrayOfObjects : POINTER TO NDR_RUNDOWN;
  END;
  PSCONTEXT_QUEUE = POINTER TO SCONTEXT_QUEUE;

PROCEDURE NDRCContextBinding(
          CContext : NDR_CCONTEXT
        ): rpcdce.RPC_BINDING_HANDLE;

PROCEDURE NDRCContextMarshall(
          CContext : NDR_CCONTEXT;
          pBuff : ADDRESS
        );

PROCEDURE NDRCContextUnmarshall(
          pCContext : PNDR_CCONTEXT;
          hBinding : rpcdce.RPC_BINDING_HANDLE;
          pBuff : ADDRESS;
          DataRepresentation : LONGCARD
        );

PROCEDURE NDRSContextMarshall(
          CContext : NDR_SCONTEXT;
          pBuff : ADDRESS;
          userRunDownIn : NDR_RUNDOWN
        );

PROCEDURE NDRSContextUnmarshall(
          pBuff : ADDRESS;
          DataRepresentation : LONGCARD
        ): NDR_SCONTEXT;

PROCEDURE RpcSsDestroyClientContext(
          VAR ContextHandle : ADDRESS
        );


