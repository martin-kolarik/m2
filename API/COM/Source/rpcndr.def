/////////////////////////////////////////////////////////////////////////////
// Some stub helper functions.
/////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////
// Stub helper structures.
////////////////////////////////////////////////////////////////////////////

TYPE

  PMIDL_STUB_MESSAGE    = POINTER TO MIDL_STUB_MESSAGE;
  PMIDL_STUB_DESC       = POINTER TO MIDL_STUB_DESC;
  PFULL_PTR_XLAT_TABLES = POINTER TO FULL_PTR_XLAT_TABLES;


  RPC_BUFPTR = POINTER TO CHAR;
  RPC_LENGTH = LONGCARD;

// Expression evaluation callback routine prototype.
  EXPR_EVAL = PROCEDURE( PMIDL_STUB_MESSAGE );

  PFORMAT_STRING = POINTER TO CHAR;

//
// Multidimensional conformant/varying array struct.
//

  ARRAY_INFO = RECORD
    Dimension : LONGINT;

    // These fields MUST be (unsigned long *)
    BufferConformanceMark : PLONGCARD;
    BufferVarianceMark : PLONGCARD;

    // Count arrays, used for top level arrays in -Os stubs
    MaxCountArray : PLONGCARD;
    OffsetArray : PLONGCARD;
    ActualCountArray : PLONGCARD;
  END;
  PARRAY_INFO = POINTER TO ARRAY_INFO;

//
//  Pipe related definitions.
//

  NDR_PIPE_PULL_RTN = PROCEDURE(
        PCHAR (* state *),
        ADDRESS (* buf *),
        LONGCARD (* esize *),
        PLONGCARD (* ecount *) 
      );

  NDR_PIPE_PUSH_RTN = PROCEDURE(
        PCHAR (* state *),
        ADDRESS (* buf *),
        LONGCARD (* count *)
      );

  NDR_PIPE_ALLOC_RTN = PROCEDURE(
        PCHAR (* state *),
        LONGCARD (* bsize *),
        VAR ADDRESS (* buf *),
        PLONGCARD (* bcount *)
      );

  GENERIC_PIPE_TYPE = RECORD
    pfnPull : NDR_PIPE_PULL_RTN;
    pfnPush : NDR_PIPE_PUSH_RTN;
    pfnAlloc : NDR_PIPE_ALLOC_RTN;
    pState : PCHAR;
  END;

  PNDR_PIPE_DESC    = POINTER TO NDR_PIPE_DESC;
  PNDR_PIPE_MESSAGE = POINTER TO NDR_PIPE_MESSAGE;

//
// MIDL Stub Message
//

//#include <pshpack4.h>
(*# option( pack => 4 ) *)

  MIDL_STUB_MESSAGE = RECORD
    // RPC message structure.
    RpcMsg : rpcdcep.PRPC_MESSAGE;

    // Pointer into RPC message buffer.
    Buffer : PCHAR;

    // These are used internally by the Ndr routines to mark the beginning
    // and end of an incoming RPC buffer.
    BufferStart : PCHAR;
    BufferEnd : PCHAR;

    // Used internally by the Ndr routines as a place holder in the buffer.
    // On the marshalling side it's used to mark the location where conformance
    // size should be marshalled.
    // On the unmarshalling side it's used to mark the location in the buffer
    // used during pointer unmarshalling to base pointer offsets off of.
    BufferMark : PCHAR;

    // Set by the buffer sizing routines.
    BufferLength : LONGCARD;

    // Set by the memory sizing routines.
    MemorySize : LONGCARD;

    // Pointer to user memory.
    Memory : PCHAR;

    // Is the Ndr routine begin called from a client side stub.
    IsClient : INTEGER;

    // Can the buffer be re-used for memory on unmarshalling.
    ReuseBuffer : INTEGER;

    // Holds the current pointer to an allocate all nodes memory block.
    AllocAllNodesMemory : PCHAR;

    // Used for debugging asserts only, remove later.
    AllocAllNodesMemoryEnd : PCHAR;

    //
    // Stuff needed while handling complex structures
    //

    // Ignore imbeded pointers while computing buffer or memory sizes.
    IgnoreEmbeddedPointers : INTEGER;

    // This marks the location in the buffer where pointees of a complex
    // struct reside.
    PointerBufferMark : PCHAR;

    // Used to catch errors in SendReceive.
    fBufferValid : CHAR;

    // Obsolete unused field (formerly MaxContextHandleNumber).
    Unused : CHAR;

    // Used internally by the Ndr routines.  Holds the max counts for
    // a conformant array.
    MaxCount : LONGCARD;

    // Used internally by the Ndr routines.  Holds the offsets for a varying
    // array.
    Offset : LONGCARD;

    // Used internally by the Ndr routines.  Holds the actual counts for
    // a varying array.
    ActualCount : LONGCARD;

    // Allocation and Free routine to be used by the Ndr routines.
    pfnAllocate : PROCEDURE( size_t ): ADDRESS;
    pfnFree : PROCEDURE( ADDRESS );

    // Top of parameter stack.  Used for "single call" stubs during marshalling
    // to hold the beginning of the parameter list on the stack.  Needed to
    // extract parameters which hold attribute values for top level arrays and
    // pointers.
    StackTop : PCHAR;

    // Fields used for the transmit_as and represent_as objects.
    // For represent_as the mapping is: presented=local, transmit=named.
    pPresentedType : PCHAR;
    pTransmitType : PCHAR;

    // When we first construct a binding on the client side, stick it
    // in the rpcmessage and later call RpcGetBuffer, the handle field
    // in the rpcmessage is changed. That's fine except that we need to
    // have that original handle for use in unmarshalling context handles
    // (the second argument in NDRCContextUnmarshall to be exact). So
    // stash the contructed handle here and extract it when needed.
    SavedHandle : rpcdce.handle_t;

    // Pointer back to the stub descriptor.  Use this to get all handle info.
    StubDesc : PMIDL_STUB_DESC;

    // Full pointer stuff.
    FullPtrXlatTables : PFULL_PTR_XLAT_TABLES;

    FullPtrRefId : LONGCARD;

    //
    // flags
    //

    fCheckBounds : INTEGER;

    //int                             fInDontFree       :1;
    //int                             fDontCallFreeInst :1;
    //int                             fInOnlyParam      :1;
    //int                             fHasReturn        :1;
    CASE : CARDINAL OF
    | 0: fInDontFree       : INTEGER;
    | 1: fDontCallFreeInst : INTEGER;
    | 2: fInOnlyParam      : INTEGER;
    | 3: fHasReturn        : INTEGER;
    END;

    dwDestContext : LONGCARD;
    pvDestContext : ADDRESS;

    SavedContextHandles : POINTER TO NDR_SCONTEXT;

    ParamNumber : LONGINT;

    pRpcChannelBuffer : TPIRpcChannelBuffer;

    pArrayInfo : PARRAY_INFO;

    //
    // This is where the Beta2 stub message ends.
    //

    SizePtrCountArray : PLONGCARD;
    SizePtrOffsetArray : PLONGCARD;
    SizePtrLengthArray : PLONGCARD;

    // Interpreter argument queue.  Used on server side only.
    pArgQueue : ADDRESS;

    dwStubPhase : LONGCARD;

    // Pipe descriptor, defined for the 4.0 release.
    pPipeDesc : PNDR_PIPE_DESC;

    Reserved : ARRAY [0..3] OF LONGCARD;

    // Fields up to this point present since the 3.50 release.

  END;

(*# option( pack => 1 ) *)

//
// Generic handle bind/unbind routine pair.
//
  GENERIC_BINDING_ROUTINE = PROCEDURE( ADDRESS ): ADDRESS;

  GENERIC_UNBIND_ROUTINE  = PROCEDURE( ADDRESS, PCHAR );

  GENERIC_BINDING_ROUTINE_PAIR = RECORD
    pfnBind : GENERIC_BINDING_ROUTINE;
    pfnUnbind : GENERIC_UNBIND_ROUTINE;
  END;
  PGENERIC_BINDING_ROUTINE_PAIR = POINTER TO GENERIC_BINDING_ROUTINE_PAIR;

  GENERIC_BINDING_INFO = RECORD
    pObj : ADDRESS;
    Size : CARDINAL;
    pfnBind : GENERIC_BINDING_ROUTINE;
    pfnUnbind : GENERIC_UNBIND_ROUTINE;
  END;
  PGENERIC_BINDING_INFO = POINTER TO GENERIC_BINDING_INFO;

// typedef EXPR_EVAL - see above
// typedefs for xmit_as

//#if (defined(_MSC_VER)) && !defined(MIDL_PASS)
// // a Microsoft C++ compiler
//#define NDR_SHAREABLE __inline
//#else
//#define NDR_SHAREABLE static
//#endif

  XMIT_HELPER_ROUTINE = PROCEDURE( PMIDL_STUB_MESSAGE );

  XMIT_ROUTINE_QUINTUPLE = RECORD
    pfnTranslateToXmit : XMIT_HELPER_ROUTINE;
    pfnTranslateFromXmit : XMIT_HELPER_ROUTINE;
    pfnFreeXmit : XMIT_HELPER_ROUTINE;
    pfnFreeInst : XMIT_HELPER_ROUTINE;
  END;
  PXMIT_ROUTINE_QUINTUPLE = POINTER TO XMIT_ROUTINE_QUINTUPLE;

  USER_MARSHAL_SIZING_ROUTINE = PROCEDURE( PLONGCARD, LONGCARD, ADDRESS ): LONGCARD;

  USER_MARSHAL_MARSHALLING_ROUTINE = PROCEDURE( PLONGCARD, PCHAR, ADDRESS ): PCHAR;

  USER_MARSHAL_UNMARSHALLING_ROUTINE = PROCEDURE( PLONGCARD, PCHAR, ADDRESS ): PCHAR;

  USER_MARSHAL_FREEING_ROUTINE = PROCEDURE( PLONGCARD, ADDRESS );

  USER_MARSHAL_ROUTINE_QUADRUPLE = RECORD
    pfnBufferSize : USER_MARSHAL_SIZING_ROUTINE;
    pfnMarshall   : USER_MARSHAL_MARSHALLING_ROUTINE;
    pfnUnmarshall : USER_MARSHAL_UNMARSHALLING_ROUTINE;
    pfnFree       : USER_MARSHAL_FREEING_ROUTINE;
  END;
  PUSER_MARSHAL_ROUTINE_QUADRUPLE = POINTER TO USER_MARSHAL_ROUTINE_QUADRUPLE;

  USER_MARSHAL_CB = RECORD
    Flags : LONGCARD;
    pStubMsg : PMIDL_STUB_MESSAGE;
    pReserve : PFORMAT_STRING;
  END;
  PUSER_MARSHAL_CB = POINTER TO USER_MARSHAL_CB;

(*# call( macro => on ) *)

PROCEDURE USER_CALL_CTXT_MASK( f : LONGWORD ): LONGWORD;
//#define USER_CALL_CTXT_MASK(f)	((f) & 0xff)

PROCEDURE GET_USER_DATA_REP( f : LONGWORD ): LONGWORD;
//#define GET_USER_DATA_REP(f)    ((f) >> 16)

(*# call( macro => off ) *)

TYPE

  MALLOC_FREE_STRUCT = RECORD
    pfnAllocate : PROCEDURE( size_t ): ADDRESS;
    pfnFree : PROCEDURE ( ADDRESS );
  END;
  PMALLOC_FREE_STRUCT = POINTER TO MALLOC_FREE_STRUCT;

  COMM_FAULT_OFFSETS = RECORD
    CommOffset : SHORT;
    FaultOffset : SHORT;
  END;
  PCOMM_FAULT_OFFSETS = POINTER TO COMM_FAULT_OFFSETS;

//
// MIDL Stub Descriptor
//

  MIDL_STUB_DESC = RECORD

    RpcInterfaceInformation : ADDRESS;

    pfnAllocate : PROCEDURE( size_t ): ADDRESS;
    pfnFree : PROCEDURE ( ADDRESS );

    CASE : CARDINAL OF
    | 0: pAutoHandle : POINTER TO handle_t;
    | 1: pPrimitiveHandle : POINTER TO handle_t;
    | 2: pGenericBindingInfo : PGENERIC_BINDING_INFO;
    END; // IMPLICIT_HANDLE_INFO;

    apfnNdrRundownRoutines : NDR_RUNDOWN;
    aGenericBindingRoutinePairs : PGENERIC_BINDING_ROUTINE_PAIR;

    apfnExprEval : EXPR_EVAL;

    aXmitQuintuple : PXMIT_ROUTINE_QUINTUPLE;

    pFormatTypes : PCHAR;

    fCheckBounds : INTEGER;

    // Ndr library version.
    Version : LONGCARD;

    //
    // Reserved for future use. (no reserves )
    //

    pMallocFreeStruct : PMALLOC_FREE_STRUCT;

    MIDLVersion : LONGINT;

    CommFaultOffsets : PCOMM_FAULT_OFFSETS;

    // New fields for version 3.0+

    aUserMarshalQuadruple : PUSER_MARSHAL_ROUTINE_QUADRUPLE;

    Reserved1 : LONGINT;
    Reserved2 : LONGINT;
    Reserved3 : LONGINT;
    Reserved4 : LONGINT;
    Reserved5 : LONGINT;

  END;

  PMIDL_XMIT_TYPE = ADDRESS;

//
// MIDL Stub Format String.  This is a const in the stub.
//
  MIDL_FORMAT_STRING = RECORD
    Pad : SHORT;
    Format : PCHAR; // unsigned char Format[]
  END;

//
// Stub thunk used for some interpreted server stubs.
//
  STUB_THUNK = PROCEDURE( PMIDL_STUB_MESSAGE );

  SERVER_ROUTINE = PROCEDURE(): LONGINT;

//
// Server Interpreter's information strucuture.
//
  MIDL_SERVER_INFO = RECORD
    pStubDesc : PMIDL_STUB_DESC;
    DispatchTable : SERVER_ROUTINE;
    ProcString : PFORMAT_STRING;
    FmtStringOffset : PSHORTCARD;
    ThunkTable : POINTER TO STUB_THUNK;
    LocalFormatTypes : PFORMAT_STRING;
    LocalProcString : PFORMAT_STRING;
    LocalFmtStringOffset : PSHORTCARD;
  END;
  PMIDL_SERVER_INFO = POINTER TO MIDL_SERVER_INFO;

//
// Stubless object proxy information structure.
//
  MIDL_STUBLESS_PROXY_INFO = RECORD
    pStubDesc : PMIDL_STUB_DESC;
    ProcFormatString : PFORMAT_STRING;
    FormatStringOffset : PSHORTCARD;
    LocalFormatTypes : PFORMAT_STRING;
    LocalProcString : PFORMAT_STRING;
    LocalFmtStringOffset : PSHORTCARD;
  END;
  PMIDL_STUBLESS_PROXY_INFO = POINTER TO MIDL_STUBLESS_PROXY_INFO;

//
// This is the return value from NdrClientCall.
//
  CLIENT_CALL_RETURN = RECORD
    CASE : CARDINAL OF
    | 0: Pointer : ADDRESS;
    | 1: Simple  : LONGINT;
    END;
  END;

//
// Full pointer data structures.
//

(*/*typedef enum
        {
        XLAT_SERVER = 1,
        XLAT_CLIENT
        } XLAT_SIDE;
*/*)

CONST

  XLAT_SERVER = 1;
  XLAT_CLIENT = 2;

TYPE

  XLAT_SIDE = CARDINAL;

//
// Stores the translation for the conversion from a full pointer into it's
// corresponding ref id.
//
  PFULL_PTR_TO_REFID_ELEMENT = POINTER TO FULL_PTR_TO_REFID_ELEMENT;
  FULL_PTR_TO_REFID_ELEMENT = RECORD
    Next : PFULL_PTR_TO_REFID_ELEMENT;
    Pointer : ADDRESS;
    RefId : LONGCARD;
    State : CHAR;
  END;

//
// Full pointer translation tables.
//
  FULL_PTR_XLAT_TABLES = RECORD
    //
    // Ref id to pointer translation information.
    //
    RefIdToPointer : RECORD
      XlatTable : POINTER TO ADDRESS;
      StateTable : PCHAR;
      NumberOfEntries :   LONGCARD;
    END;

    //
    // Pointer to ref id translation information.
    //
    PointerToRefId : RECORD
      XlatTable : POINTER TO PFULL_PTR_TO_REFID_ELEMENT;
      NumberOfBuckets : LONGCARD;
      HashMask : LONGCARD;
    END;

    //
    // Next ref id to use.
    //
    NextRefId : LONGCARD;

    //
    // Keep track of the translation size we're handling : server or client.
    // This tells us when we have to do reverse translations when we insert
    // new translations.  On the server we must insert a pointer-to-refid
    // translation whenever we insert a refid-to-pointer translation, and
    // vica versa for the client.
    XlatSide : XLAT_SIDE;
  END;

