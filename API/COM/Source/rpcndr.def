(*/**************************************************************************
    MIDL 2.0 memory package: rpc_ss_* rpc_sm_*
 **************************************************************************/*)

TYPE

  RPC_SS_THREAD_HANDLE = ADDRESS;

  RPC_CLIENT_ALLOC = PROCEDURE( size_t (* Size *)): ADDRESS;
  PRPC_CLIENT_ALLOC = POINTER TO RPC_CLIENT_ALLOC;

  RPC_CLIENT_FREE = PROCEDURE( ADDRESS (* Ptr *) );
  PRPC_CLIENT_FREE = POINTER TO RPC_CLIENT_FREE;

(*/*++
     RpcSs* package
--*/*)

PROCEDURE RpcSsAllocate(
      Size : size_t
    ): ADDRESS;

