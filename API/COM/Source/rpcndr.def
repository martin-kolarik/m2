      ClientAlloc : RPC_CLIENT_ALLOC;
      ClientFree : RPC_CLIENT_FREE
    );

PROCEDURE RpcSsSetThreadHandle (
      Id : RPC_SS_THREAD_HANDLE
    );

PROCEDURE RpcSsSwapClientAllocFree (
     ClientAlloc : RPC_CLIENT_ALLOC;
     ClientFree : RPC_CLIENT_FREE;
     OldClientAlloc : PRPC_CLIENT_ALLOC;
     OldClientFree : PRPC_CLIENT_FREE
    );

(*/*++
     RpcSm* package
--*/*)

PROCEDURE RpcSmAllocate(
      Size : size_t;
      VAR pStatus : rpcdce.RPC_STATUS
    ): ADDRESS;

