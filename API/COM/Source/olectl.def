/////////////////////////////////////////////////////////////////////////////
// FACILITY_CONTROL status codes
CONST
  FACILITY_CONTROL = 0AH;

(*# call( macro => on ) *)
PROCEDURE STD_CTL_SCODE( n : LONGWORD ): wtypes.SCODE;
(*# call( macro => off ) *)

//#define CTL_E_ILLEGALFUNCTIONCALL       STD_CTL_SCODE(5)
CONST
  CTL_E_ILLEGALFUNCTIONCALL       = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (5);
  CTL_E_OVERFLOW                  = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (6);
  CTL_E_OUTOFMEMORY               = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (7);
  CTL_E_DIVISIONBYZERO            = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (11);
  CTL_E_OUTOFSTRINGSPACE          = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (14);
  CTL_E_OUTOFSTACKSPACE           = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (28);
  CTL_E_BADFILENAMEORNUMBER       = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (52);
  CTL_E_FILENOTFOUND              = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (53);
  CTL_E_BADFILEMODE               = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (54);
  CTL_E_FILEALREADYOPEN           = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (55);
  CTL_E_DEVICEIOERROR             = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (57);
  CTL_E_FILEALREADYEXISTS         = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (58);
  CTL_E_BADRECORDLENGTH           = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (59);
  CTL_E_DISKFULL                  = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (61);
  CTL_E_BADRECORDNUMBER           = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (63);
  CTL_E_BADFILENAME               = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (64);
  CTL_E_TOOMANYFILES              = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (67);
  CTL_E_DEVICEUNAVAILABLE         = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (68);
  CTL_E_PERMISSIONDENIED          = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (70);
  CTL_E_DISKNOTREADY              = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (71);
  CTL_E_PATHFILEACCESSERROR       = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (75);
  CTL_E_PATHNOTFOUND              = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (76);
  CTL_E_INVALIDPATTERNSTRING      = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (93);
  CTL_E_INVALIDUSEOFNULL          = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (94);
  CTL_E_INVALIDFILEFORMAT         = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (321);
  CTL_E_INVALIDPROPERTYVALUE      = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (380);
  CTL_E_INVALIDPROPERTYARRAYINDEX = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (381);
  CTL_E_SETNOTSUPPORTEDATRUNTIME  = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (382);
  CTL_E_SETNOTSUPPORTED           = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (383);
  CTL_E_NEEDPROPERTYARRAYINDEX    = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (385);
  CTL_E_SETNOTPERMITTED           = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (387);
  CTL_E_GETNOTSUPPORTEDATRUNTIME  = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (393);
  CTL_E_GETNOTSUPPORTED           = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (394);
  CTL_E_PROPERTYNOTFOUND          = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (422);
  CTL_E_INVALIDCLIPBOARDFORMAT    = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (460);
  CTL_E_INVALIDPICTURE            = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (481);
  CTL_E_PRINTERERROR              = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (482);
  CTL_E_CANTSAVEFILETOTEMP        = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (735);
  CTL_E_SEARCHTEXTNOTFOUND        = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (744);
  CTL_E_REPLACEMENTSTOOLONG       = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (746);

(*# call( macro => on ) *)
//#define CUSTOM_CTL_SCODE(n) MAKE_SCODE(SEVERITY_ERROR, FACILITY_CONTROL, n)
TYPE
  PROCEDURE CUSTOM_CTL_SCODE( n : LONGWORD ): wtypes.SCODE;
(*# call( macro => off ) *)

CONST
  CTL_E_CUSTOM_FIRST              = (winerror.SEVERITY_ERROR << 31) OR (FACILITY_CONTROL << 16) OR (600);


/////////////////////////////////////////////////////////////////////////////
// IClassFactory2 status codes

  CLASS_E_NOTLICENSED         = winerror.CLASSFACTORY_E_FIRST + 2;
// class is not licensed for use


/////////////////////////////////////////////////////////////////////////////
// IConnectionPoint status codes

  CONNECT_E_FIRST    = (winerror.SEVERITY_ERROR << 31) OR (winerror.FACILITY_ITF << 16) OR (00200H);
  CONNECT_E_LAST     = (winerror.SEVERITY_ERROR << 31) OR (winerror.FACILITY_ITF << 16) OR (0020FH);
  CONNECT_S_FIRST    = (winerror.SEVERITY_SUCCESS << 31) OR (winerror.FACILITY_ITF << 16) OR (00200H);
  CONNECT_S_LAST     = (winerror.SEVERITY_SUCCESS << 31) OR (winerror.FACILITY_ITF << 16) OR (0020FH);

  CONNECT_E_NOCONNECTION      = CONNECT_E_FIRST + 0;
// there is no connection for this connection id

  CONNECT_E_ADVISELIMIT       = CONNECT_E_FIRST + 1;
// this implementation's limit for advisory connections has been reached

  CONNECT_E_CANNOTCONNECT     = CONNECT_E_FIRST + 2;
// connection attempt failed

  CONNECT_E_OVERRIDDEN        = CONNECT_E_FIRST + 3;
// must use a derived interface to connect


/////////////////////////////////////////////////////////////////////////////
// DllRegisterServer/DllUnregisterServer status codes

  SELFREG_E_FIRST    = (winerror.SEVERITY_ERROR << 31) OR (winerror.FACILITY_ITF << 16) OR (00200H);
  SELFREG_E_LAST     = (winerror.SEVERITY_ERROR << 31) OR (winerror.FACILITY_ITF << 16) OR (0020FH);
  SELFREG_S_FIRST    = (winerror.SEVERITY_SUCCESS << 31) OR (winerror.FACILITY_ITF << 16) OR (00200H);
  SELFREG_S_LAST     = (winerror.SEVERITY_SUCCESS << 31) OR (winerror.FACILITY_ITF << 16) OR (0020FH);

  SELFREG_E_TYPELIB  = SELFREG_E_FIRST + 0;
// failed to register/unregister type library

  SELFREG_E_CLASS    = SELFREG_E_FIRST + 1;
// failed to register/unregister class


/////////////////////////////////////////////////////////////////////////////
// IPerPropertyBrowsing status codes

  PERPROP_E_FIRST    = (winerror.SEVERITY_ERROR << 31) OR (winerror.FACILITY_ITF << 16) OR (00200H);
  PERPROP_E_LAST     = (winerror.SEVERITY_ERROR << 31) OR (winerror.FACILITY_ITF << 16) OR (0020FH);
  PERPROP_S_FIRST    = (winerror.SEVERITY_SUCCESS << 31) OR (winerror.FACILITY_ITF << 16) OR (00200H);
  PERPROP_S_LAST     = (winerror.SEVERITY_SUCCESS << 31) OR (winerror.FACILITY_ITF << 16) OR (0020FH);

  PERPROP_E_NOPAGEAVAILABLE  = PERPROP_E_FIRST + 0;
// no page available for requested property


/////////////////////////////////////////////////////////////////////////////
// OLEMISC_ constants (they are also defined in the latest oleidl.h)

  OLEMISC_INVISIBLEATRUNTIME  = 000000400H;
  OLEMISC_ALWAYSRUN           = 000000800H;
  OLEMISC_ACTSLIKEBUTTON      = 000001000H;
  OLEMISC_ACTSLIKELABEL       = 000002000H;
  OLEMISC_NOUIACTIVATE        = 000004000H;
  OLEMISC_ALIGNABLE           = 000008000H;
  OLEMISC_SIMPLEFRAME         = 000010000H;
  OLEMISC_SETCLIENTSITEFIRST  = 000020000H;
  OLEMISC_IMEMODE             = 000040000H;


/////////////////////////////////////////////////////////////////////////////
// OLEIVERB_ constants

  OLEIVERB_PROPERTIES = -7;


/////////////////////////////////////////////////////////////////////////////
// Variant type (VT_) tags for property sets

  VT_STREAMED_PROPSET = 73;  //       [P]  Stream contains a property set
  VT_STORED_PROPSET   = 74;  //       [P]  Storage contains a property set
  VT_BLOB_PROPSET     = 75;  //       [P]  Blob contains a property set
  VT_VERBOSE_ENUM     = 76;  //       [P]  Enum value with text string


/////////////////////////////////////////////////////////////////////////////
// Variant type (VT_) tags that are just aliases for others

  VT_COLOR            = wtypes.VT_I4;
  VT_XPOS_PIXELS      = wtypes.VT_I4;
  VT_YPOS_PIXELS      = wtypes.VT_I4;
  VT_XSIZE_PIXELS     = wtypes.VT_I4;
  VT_YSIZE_PIXELS     = wtypes.VT_I4;
  VT_XPOS_HIMETRIC    = wtypes.VT_I4;
  VT_YPOS_HIMETRIC    = wtypes.VT_I4;
  VT_XSIZE_HIMETRIC   = wtypes.VT_I4;
  VT_YSIZE_HIMETRIC   = wtypes.VT_I4;
  VT_TRISTATE         = wtypes.VT_I2;
  VT_OPTEXCLUSIVE     = wtypes.VT_BOOL;
  VT_FONT             = wtypes.VT_DISPATCH;
  VT_PICTURE          = wtypes.VT_DISPATCH;

  VT_HANDLE           = wtypes.VT_I4;


/////////////////////////////////////////////////////////////////////////////
// Reflected Window Message IDs

  OCM__BASE           = windows.WM_USER + 01C00H;
  OCM_COMMAND         = OCM__BASE + windows.WM_COMMAND;

  OCM_CTLCOLORBTN     = OCM__BASE + windows.WM_CTLCOLORBTN;
  OCM_CTLCOLOREDIT    = OCM__BASE + windows.WM_CTLCOLOREDIT;
  OCM_CTLCOLORDLG     = OCM__BASE + windows.WM_CTLCOLORDLG;
  OCM_CTLCOLORLISTBOX = OCM__BASE + windows.WM_CTLCOLORLISTBOX;
  OCM_CTLCOLORMSGBOX  = OCM__BASE + windows.WM_CTLCOLORMSGBOX;
  OCM_CTLCOLORSCROLLBAR   = OCM__BASE + windows.WM_CTLCOLORSCROLLBAR;
  OCM_CTLCOLORSTATIC  = OCM__BASE + windows.WM_CTLCOLORSTATIC;

  OCM_DRAWITEM        = OCM__BASE + windows.WM_DRAWITEM;
  OCM_MEASUREITEM     = OCM__BASE + windows.WM_MEASUREITEM;
  OCM_DELETEITEM      = OCM__BASE + windows.WM_DELETEITEM;
  OCM_VKEYTOITEM      = OCM__BASE + windows.WM_VKEYTOITEM;
  OCM_CHARTOITEM      = OCM__BASE + windows.WM_CHARTOITEM;
  OCM_COMPAREITEM     = OCM__BASE + windows.WM_COMPAREITEM;
  OCM_HSCROLL         = OCM__BASE + windows.WM_HSCROLL;
  OCM_VSCROLL         = OCM__BASE + windows.WM_VSCROLL;
  OCM_PARENTNOTIFY    = OCM__BASE + windows.WM_PARENTNOTIFY;

  OCM_NOTIFY          = OCM__BASE + windows.WM_NOTIFY;


/////////////////////////////////////////////////////////////////////////////
// Self-registration APIs (to be implemented by server DLL)

PROCEDURE DllRegisterServer(): wtypes.HRESULT;
PROCEDURE DllUnregisterServer(): wtypes.HRESULT;

