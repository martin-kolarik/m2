(* Additional Prototypes for ALL interfaces *)
TYPE
  TPCLIPFORMAT = POINTER TO CLIPFORMAT;  
  PHACCEL = POINTER TO windows.HACCEL;
  PHGLOBAL = POINTER TO windows.HGLOBAL;
  PHMENU = POINTER TO windows.HMENU;
  PHWND = POINTER TO windows.HWND;

  CLIPFORMAT_UserSize = PROCEDURE ( windows.PULONG, CLIPFORMAT ): windows.ULONG; 
  CLIPFORMAT_UserMarshal = PROCEDURE ( windows.PULONG, windows.UCHAR, TPCLIPFORMAT ): windows.PUCHAR; 
  CLIPFORMAT_UserUnmarshal = PROCEDURE ( windows.PULONG,windows.PUCHAR, TPCLIPFORMAT ): windows.PUCHAR; 
  CLIPFORMAT_UserFree = PROCEDURE ( windows.PULONG, TPCLIPFORMAT); 

  HACCEL_UserSize = PROCEDURE (windows.PULONG,windows.ULONG , PHACCEL ): windows.ULONG; 
  HACCEL_UserMarshal = PROCEDURE (  windows.PULONG ,windows.PUCHAR, PHACCEL ): windows.PUCHAR; 
  HACCEL_UserUnmarshal = PROCEDURE (windows.PULONG, windows.PUCHAR, PHACCEL ): windows.PUCHAR; 
  HACCEL_UserFree = PROCEDURE (windows.PULONG,PHACCEL); 

  HGLOBAL_UserSize = PROCEDURE (windows.PULONG, windows.ULONG, PHGLOBAL ): windows.ULONG; 
  HGLOBAL_UserMarshal = PROCEDURE (  windows.PULONG , windows.PUCHAR, PHGLOBAL ): windows.PUCHAR; 
  HGLOBAL_UserUnmarshal = PROCEDURE (windows.PULONG,windows.PUCHAR, PHGLOBAL ): windows.PUCHAR; 
  HGLOBAL_UserFree = PROCEDURE (windows.PULONG, PHGLOBAL ); 

  HMENU_UserSize = PROCEDURE (windows.PULONG, windows.ULONG, PHMENU ): windows.ULONG; 
  HMENU_UserMarshal = PROCEDURE (  windows.PULONG, windows.PUCHAR, PHMENU ): windows.PUCHAR; 
  HMENU_UserUnmarshal = PROCEDURE (windows.PULONG , windows.PUCHAR, PHMENU ): windows.PUCHAR ; 
  HMENU_UserFree = PROCEDURE  (windows.PULONG, PHMENU ); 

  HWND_UserSize = PROCEDURE (windows.PULONG, windows.ULONG, PHWND ): windows.ULONG; 
  HWND_UserMarshal = PROCEDURE (  windows.PULONG, windows.PUCHAR, PHWND ): windows.PUCHAR; 
  HWND_UserUnmarshal = PROCEDURE (windows.PULONG, windows.PUCHAR, PHWND  ): windows.PUCHAR; 
  HWND_UserFree = PROCEDURE (windows.PULONG, PHWND); 

  STGMEDIUM_UserSize = PROCEDURE  (windows.PULONG, windows.ULONG, objidl.PSTGMEDIUM ): windows.ULONG; 
  STGMEDIUM_UserMarshal = PROCEDURE (  windows.PULONG, windows.PUCHAR, objidl.PSTGMEDIUM ): windows.PUCHAR ; 
  STGMEDIUM_UserUnmarshal = PROCEDURE (windows.PULONG,windows.PUCHAR,objidl.PSTGMEDIUM ): windows.PUCHAR ; 
  STGMEDIUM_UserFree = PROCEDURE (windows.ULONG, objidl.PSTGMEDIUM); 

  PPVOID = POINTER TO windows.PVOID;

