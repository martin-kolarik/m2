<Project
    DefaultTargets = "Build"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <!-- 1 -->
    <Import Project="..\..\Build\common.rootdir.proj"/>
    <Import Project="$(RootBuildDir)\common.definition.proj"/>

    <!-- 2 -->
    <ItemGroup>
        <Definitions Condition="$(M2Compiler)=='Old'" Include="math;float;ctype;stdio;string;stdlib"/>
    </ItemGroup>

    <!-- 3 -->
    <Import Project="$(RootBuildDir)\common.build.proj"/>

    <!-- 4 -->
    <Choose>
        <When Condition="$(Parameters)=='Private'">
            <ItemGroup>
                <Components Include="API\CRtl"/>
            </ItemGroup>
        </When>
        <When Condition="$(Parameters)=='Dynamic' And $(Debug)=='On'">
            <ItemGroup>
                <Interface Include="msvcrtd"/>
            </ItemGroup>
        </When>
        <When Condition="$(Parameters)=='Dynamic' And $(Debug)=='Off'">
            <ItemGroup>
                <Interface Include="msvcrt"/>
            </ItemGroup>
        </When>
        <When Condition="$(Parameters)=='Static' And $(Debug)=='On'">
            <ItemGroup>
                <Interface Include="libcmtd"/>
            </ItemGroup>
        </When>
        <When Condition="$(Parameters)=='Static' And $(Debug)=='Off'">
            <ItemGroup>
                <Interface Include="libcmt"/>
            </ItemGroup>
        </When>
        <When Condition="$(CLib)=='Private'">
            <ItemGroup>
                <Components Include="API\CRtl"/>
            </ItemGroup>
        </When>
        <When Condition="$(CLib)=='Dynamic' And $(Debug)=='On'">
            <ItemGroup>
                <Interface Include="msvcrtd"/>
            </ItemGroup>
        </When>
        <When Condition="$(CLib)=='Dynamic' And $(Debug)=='Off'">
            <ItemGroup>
                <Interface Include="msvcrt"/>
            </ItemGroup>
        </When>
        <When Condition="$(CLib)=='Static' And $(Debug)=='On'">
            <ItemGroup>
                <Interface Include="libcmtd"/>
            </ItemGroup>
        </When>
        <When Condition="$(CLib)=='Static' And $(Debug)=='Off'">
            <ItemGroup>
                <Interface Include="libcmt"/>
            </ItemGroup>
        </When>
    </Choose>

</Project>
