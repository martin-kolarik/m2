DEFINITION MODULE dbghelp; (* heavily incomplete *)

(*# name( decoration => c ) *)
(*# module( header => off ) *)
(*# call( o_a_size => off, convention => stdcall ) *)

IMPORT
   windows,
   winver;

(*# save, option( pack => 4 ) *)

TYPE
   MINIDUMP_EXCEPTION_INFORMATION = RECORD
      ThreadId : windows.DWORD;
      ExceptionPointers : windows.PEXCEPTION_POINTERS;
      ClientPointers : windows.BOOL;
   END;
   PMINIDUMP_EXCEPTION_INFORMATION = POINTER TO MINIDUMP_EXCEPTION_INFORMATION;

   MINIDUMP_USER_STREAM = RECORD
      Type : CARD32;
      BufferSize : windows.ULONG;
      Buffer : windows.PVOID;
   END;
   PMINIDUMP_USER_STREAM = POINTER TO MINIDUMP_USER_STREAM;

   MINIDUMP_USER_STREAM_INFORMATION = RECORD 
      UserStreamCount : windows.ULONG;
      UserStreamArray : PMINIDUMP_USER_STREAM;
   END;
   PMINIDUMP_USER_STREAM_INFORMATION = POINTER TO MINIDUMP_USER_STREAM_INFORMATION;

   MINIDUMP_CALLBACK_TYPE = (
      ModuleCallback,
      ThreadCallback,
      ThreadExCallback,
      IncludeThreadCallback,
      IncludeModuleCallback,
      MemoryCallback
   );

   MINIDUMP_THREAD_CALLBACK = RECORD
      ThreadId : windows.ULONG;
      ThreadHandle : windows.HANDLE;
      Context : windows.CONTEXT;
      SizeOfContext : windows.ULONG;
      StackBase : CARD64;
      StackEnd : CARD64;
   END;
   PMINIDUMP_THREAD_CALLBACK = POINTER TO MINIDUMP_THREAD_CALLBACK;

   MINIDUMP_THREAD_EX_CALLBACK = RECORD
      ThreadId : windows.ULONG;
      ThreadHandle : windows.HANDLE;
      Context : windows.CONTEXT;
      SizeOfContext : windows.ULONG;
      StackBase : CARD64;
      StackEnd : CARD64;
      BackingStoreBase : CARD64;
      BackingStoreEnd : CARD64;
   END;
   PMINIDUMP_THREAD_EX_CALLBACK = POINTER TO MINIDUMP_THREAD_EX_CALLBACK;

   MINIDUMP_INCLUDE_THREAD_CALLBACK = RECORD
      ThreadId : windows.ULONG;
   END;
   PMINIDUMP_INCLUDE_THREAD_CALLBACK = POINTER TO MINIDUMP_INCLUDE_THREAD_CALLBACK;

   MINIDUMP_MODULE_CALLBACK = RECORD
      FullPath : PWCHAR;
      BaseOfImage : CARD64;
      SizeOfImage : windows.ULONG;
      CheckSum : windows.ULONG;
      TimeDateStamp : windows.ULONG;
      VersionInfo : winver.VS_FIXEDFILEINFO;
      CvRecord : windows.PVOID;
      SizeOfCvRecord : windows.ULONG;
      MiscRecord : windows.PVOID;
      SizeOfMiscRecord : windows.ULONG;
   END;
   PMINIDUMP_MODULE_CALLBACK = POINTER TO MINIDUMP_MODULE_CALLBACK;

   MINIDUMP_INCLUDE_MODULE_CALLBACK = RECORD
      BaseOfImage : CARD64;
   END;
   PMINIDUMP_INCLUDE_MODULE_CALLBACK = POINTER TO MINIDUMP_INCLUDE_MODULE_CALLBACK;

   MODULE_WRITE_FLAGS = (
      ModuleWriteModule        = 00001H,
      ModuleWriteDataSeg       = 00002H,
      ModuleWriteMiscRecord    = 00004H,
      ModuleWriteCvRecord      = 00008H,
      ModuleReferencedByMemory = 00010H
   );

   MINIDUMP_CALLBACK_INPUT = RECORD
      ProcessId : windows.ULONG;
      ProcessHandle : windows.HANDLE;
      CallbackType : windows.ULONG;
      CASE : INTEGER OF
      | 0: Thread : MINIDUMP_THREAD_CALLBACK;
      | 1: ThreadEx : MINIDUMP_THREAD_EX_CALLBACK;
      | 2: Module : MINIDUMP_MODULE_CALLBACK;
      | 3: IncludeThread : MINIDUMP_INCLUDE_THREAD_CALLBACK;
      | 4: IncludeModule : MINIDUMP_INCLUDE_MODULE_CALLBACK;
      END;
   END;
   PMINIDUMP_CALLBACK_INPUT = POINTER TO MINIDUMP_CALLBACK_INPUT;

   MINIDUMP_CALLBACK_OUTPUT = RECORD
      CASE : INTEGER OF
      | 0: ModuleWriteFlags : windows.ULONG;
      | 1: ThreadWriteFlags : windows.ULONG;
      | 2: MemoryBase : CARD64;
           MemorySize : windows.ULONG;
      END;
   END;
   PMINIDUMP_CALLBACK_OUTPUT = POINTER TO MINIDUMP_CALLBACK_OUTPUT;

   MINIDUMP_TYPE = (
      MiniDumpNormal                         = 0000H,
      MiniDumpWithDataSegs                   = 0001H,
      MiniDumpWithFullMemory                 = 0002H,
      MiniDumpWithHandleData                 = 0004H,
      MiniDumpFilterMemory                   = 0008H,
      MiniDumpScanMemory                     = 0010H,
      MiniDumpWithUnloadedModules            = 0020H,
      MiniDumpWithIndirectlyReferencedMemory = 0040H,
      MiniDumpFilterModulePaths              = 0080H,
      MiniDumpWithProcessThreadData          = 0100H,
      MiniDumpWithPrivateReadWriteMemory     = 0200H,
      MiniDumpWithoutOptionalData            = 0400H
   );

TYPE
   MINIDUMP_CALLBACK_ROUTINE = PROCEDURE( windows.PVOID, CONST PMINIDUMP_CALLBACK_INPUT, PMINIDUMP_CALLBACK_OUTPUT ) : windows.BOOL;

   MINIDUMP_CALLBACK_INFORMATION = RECORD 
      CallbackRoutine : MINIDUMP_CALLBACK_ROUTINE;
      CallbackParam : windows.PVOID;
   END;
   PMINIDUMP_CALLBACK_INFORMATION = POINTER TO MINIDUMP_CALLBACK_INFORMATION;

PROCEDURE MiniDumpWriteDump(
    hProcess : windows.HANDLE;
    ProcessId : windows.DWORD;
    hFile : windows.HANDLE;
    DumpType : MINIDUMP_TYPE;
    ExceptionParam : PMINIDUMP_EXCEPTION_INFORMATION;
    UserStreamParam : PMINIDUMP_USER_STREAM_INFORMATION;
    CallbackParam : PMINIDUMP_CALLBACK_INFORMATION ) : windows.BOOL;

(*# restore *)

END dbghelp.