(*# name(   prefix          => c ) *)

(*# module( header          => off,
            init_code       => off ) *)

(*# call(   o_a_size        => off,
            o_a_copy        => off,
            c_arrays        => on,
            result_optional => on,
            prefix          => stdcall ) *)

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// Additional Header Files                                                   //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

IMPORT
  windows;

FROM windows IMPORT BOOL, PHANDLE, DWORD;

CONST
///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// ASN/BER Base Types                                                        //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////
                                        
  ASN_UNIVERSAL                   = 000H;
  ASN_APPLICATION                 = 040H;
  ASN_CONTEXT                     = 080H;
  ASN_PRIVATE                     = 0C0H;

  ASN_PRIMITIVE                   = 000H;
  ASN_CONSTRUCTOR                 = 020H;

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// PDU Type Values                                                           //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

  SNMP_PDU_GET                = (ASN_CONTEXT OR ASN_CONSTRUCTOR OR 00H);
  SNMP_PDU_GETNEXT            = (ASN_CONTEXT OR ASN_CONSTRUCTOR OR 01H);
  SNMP_PDU_RESPONSE           = (ASN_CONTEXT OR ASN_CONSTRUCTOR OR 02H);
  SNMP_PDU_SET                = (ASN_CONTEXT OR ASN_CONSTRUCTOR OR 03H);
  SNMP_PDU_V1TRAP             = (ASN_CONTEXT OR ASN_CONSTRUCTOR OR 04H);
  SNMP_PDU_GETBULK            = (ASN_CONTEXT OR ASN_CONSTRUCTOR OR 05H);
  SNMP_PDU_INFORM             = (ASN_CONTEXT OR ASN_CONSTRUCTOR OR 06H);
  SNMP_PDU_TRAP               = (ASN_CONTEXT OR ASN_CONSTRUCTOR OR 07H);


///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Simple Syntax Values                                                 //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

  ASN_INTEGER                 = (ASN_UNIVERSAL OR ASN_PRIMITIVE OR 002H);
  ASN_BITS                    = (ASN_UNIVERSAL OR ASN_PRIMITIVE OR 003H);
  ASN_OCTETSTRING             = (ASN_UNIVERSAL OR ASN_PRIMITIVE OR 004H);
  ASN_NULL                    = (ASN_UNIVERSAL OR ASN_PRIMITIVE OR 005H);
  ASN_OBJECTIDENTIFIER        = (ASN_UNIVERSAL OR ASN_PRIMITIVE OR 006H);
  ASN_INTEGER32               = ASN_INTEGER;

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Constructor Syntax Values                                            //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////
                                
  ASN_SEQUENCE                = (ASN_UNIVERSAL OR ASN_CONSTRUCTOR OR 010H);
  ASN_SEQUENCEOF              = ASN_SEQUENCE;

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Application Syntax Values                                            //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

  ASN_IPADDRESS               = (ASN_APPLICATION OR ASN_PRIMITIVE OR 000H);
  ASN_COUNTER32               = (ASN_APPLICATION OR ASN_PRIMITIVE OR 001H);
  ASN_GAUGE32                 = (ASN_APPLICATION OR ASN_PRIMITIVE OR 002H);
  ASN_TIMETICKS               = (ASN_APPLICATION OR ASN_PRIMITIVE OR 003H);
  ASN_OPAQUE                  = (ASN_APPLICATION OR ASN_PRIMITIVE OR 004H);
  ASN_COUNTER64               = (ASN_APPLICATION OR ASN_PRIMITIVE OR 006H);
  ASN_UNSIGNED32              = (ASN_APPLICATION OR ASN_PRIMITIVE OR 007H);

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Exception Conditions                                                 //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////
                                        
  SNMP_EXCEPTION_NOSUCHOBJECT     = (ASN_CONTEXT OR ASN_PRIMITIVE OR 000H);
  SNMP_EXCEPTION_NOSUCHINSTANCE   = (ASN_CONTEXT OR ASN_PRIMITIVE OR 001H);
  SNMP_EXCEPTION_ENDOFMIBVIEW     = (ASN_CONTEXT OR ASN_PRIMITIVE OR 002H);

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Request Types (used in SnmpExtensionQueryEx)                         //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////
                                    
  SNMP_EXTENSION_GET          = SNMP_PDU_GET;
  SNMP_EXTENSION_GET_NEXT     = SNMP_PDU_GETNEXT;
  SNMP_EXTENSION_GET_BULK     = SNMP_PDU_GETBULK;
  SNMP_EXTENSION_SET_TEST     = (ASN_PRIVATE OR ASN_CONSTRUCTOR OR 00H);
  SNMP_EXTENSION_SET_COMMIT   = SNMP_PDU_SET;
  SNMP_EXTENSION_SET_UNDO     = (ASN_PRIVATE OR ASN_CONSTRUCTOR OR 01H);
  SNMP_EXTENSION_SET_CLEANUP  = (ASN_PRIVATE OR ASN_CONSTRUCTOR OR 02H);

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Error Codes                                                          //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

  SNMP_ERRORSTATUS_NOERROR                = 0;
  SNMP_ERRORSTATUS_TOOBIG                 = 1;
  SNMP_ERRORSTATUS_NOSUCHNAME             = 2;
  SNMP_ERRORSTATUS_BADVALUE               = 3;
  SNMP_ERRORSTATUS_READONLY               = 4;
  SNMP_ERRORSTATUS_GENERR                 = 5;
  SNMP_ERRORSTATUS_NOACCESS               = 6;
  SNMP_ERRORSTATUS_WRONGTYPE              = 7;
  SNMP_ERRORSTATUS_WRONGLENGTH            = 8;
  SNMP_ERRORSTATUS_WRONGENCODING          = 9;
  SNMP_ERRORSTATUS_WRONGVALUE             = 10;
  SNMP_ERRORSTATUS_NOCREATION             = 11;
  SNMP_ERRORSTATUS_INCONSISTENTVALUE      = 12;
  SNMP_ERRORSTATUS_RESOURCEUNAVAILABLE    = 13;
  SNMP_ERRORSTATUS_COMMITFAILED           = 14;
  SNMP_ERRORSTATUS_UNDOFAILED             = 15;
  SNMP_ERRORSTATUS_AUTHORIZATIONERROR     = 16;
  SNMP_ERRORSTATUS_NOTWRITABLE            = 17;
  SNMP_ERRORSTATUS_INCONSISTENTNAME       = 18;

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMPv1 Trap Types                                                         //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

  SNMP_GENERICTRAP_COLDSTART              = 0;
  SNMP_GENERICTRAP_WARMSTART              = 1;
  SNMP_GENERICTRAP_LINKDOWN               = 2;
  SNMP_GENERICTRAP_LINKUP                 = 3;
  SNMP_GENERICTRAP_AUTHFAILURE            = 4;
  SNMP_GENERICTRAP_EGPNEIGHLOSS           = 5;
  SNMP_GENERICTRAP_ENTERSPECIFIC          = 6;

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Access Types                                                         //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

  SNMP_ACCESS_NONE                        = 0;
  SNMP_ACCESS_NOTIFY                      = 1;
  SNMP_ACCESS_READ_ONLY                   = 2;
  SNMP_ACCESS_READ_WRITE                  = 3;
  SNMP_ACCESS_READ_CREATE                 = 4;

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP API Return Code Definitions                                          //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

CONST
  SNMPAPI ::= windows.INT;
  //SNMP_FUNC_TYPE                          WINAPI

  SNMPAPI_NOERROR  ::= windows.True;
  SNMPAPI_ERROR    ::= windows.False;


///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Type Definitions                                                     //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

(*# save, option( pack => 4 ) *)

TYPE
  AsnOctetString = RECORD
    stream : windows.PBYTE;     
    length : windows.UINT;
    dynamic: windows.BOOL;
  END;
  PAsnOctetString = POINTER TO AsnOctetString;

  AsnObjectIdentifier = RECORD
    idLength : windows.UINT;
    ids      : windows.PUINT;
  END;
  PAsnObjectIdentifier = POINTER TO AsnObjectIdentifier;

  ULARGE_INTEGER = RECORD
    CASE :BOOLEAN OF
    | FALSE: LowPart, HighPart : CARDINAL;
    | TRUE:  i : CARD64;
    END;
  END;

CONST
  AsnInteger32        ::= windows.LONG;
  AsnUnsigned32       ::= windows.ULONG;
  AsnCounter64        ::= ULARGE_INTEGER;
  AsnCounter32        ::= AsnUnsigned32;
  AsnGauge32          ::= AsnUnsigned32;
  AsnTimeticks        ::= AsnUnsigned32;
  AsnBits             ::= AsnOctetString;
  AsnSequence         ::= AsnOctetString;
  AsnImplicitSequence ::= AsnOctetString;
  AsnIPAddress        ::= AsnOctetString;
  AsnNetworkAddress   ::= AsnOctetString;
  AsnDisplayString    ::= AsnOctetString;
  AsnOpaque           ::= AsnOctetString;

TYPE
  PAsnInteger32       = POINTER TO AsnInteger32;
  PAsnUnsigned32      = POINTER TO AsnUnsigned32;
  PAsnCounter64       = POINTER TO AsnCounter64;
  PAsnCounter32       = POINTER TO AsnCounter32;
  PAsnGauge32         = POINTER TO AsnGauge32;
  PAsnTimeticks       = POINTER TO AsnTimeticks;
  PAsnBits            = POINTER TO AsnBits;
  PAsnSequence        = POINTER TO AsnSequence;
  PAsnImplicitSequence= POINTER TO AsnImplicitSequence;
  PAsnIPAddress       = POINTER TO AsnIPAddress;
  PAsnNetworkAddress  = POINTER TO AsnNetworkAddress;
  PAsnDisplayString   = POINTER TO AsnDisplayString;
  PAsnOpaque          = POINTER TO AsnOpaque;

TYPE
  TasnValue = RECORD
    CASE :BYTE OF
    | ASN_INTEGER32       : number        : AsnInteger32;   // ASN_INTEGER, ASN_INTEGER32
    | ASN_UNSIGNED32      : unsigned32    : AsnUnsigned32;  // ASN_UNSIGNED32      
    | ASN_COUNTER64       : counter64     : AsnCounter64;   // ASN_COUNTER64       
    | ASN_OCTETSTRING     : string        : AsnOctetString; // ASN_OCTETSTRING     
    | ASN_BITS            : bits          : AsnBits;        // ASN_BITS            
    | ASN_OBJECTIDENTIFIER: object        : AsnObjectIdentifier;     // ASN_OBJECTIDENTIFIER
    | ASN_SEQUENCE        : sequence      : AsnSequence;    // ASN_SEQUENCE        
    | ASN_IPADDRESS       : address       : AsnIPAddress;   // ASN_IPADDRESS       
    | ASN_COUNTER32       : counter       : AsnCounter32;   // ASN_COUNTER32       
    | ASN_GAUGE32         : gauge         : AsnGauge32;     // ASN_GAUGE32         
    | ASN_TIMETICKS       : ticks         : AsnTimeticks;   // ASN_TIMETICKS       
    | ASN_OPAQUE          : arbitrary     : AsnOpaque;      // ASN_OPAQUE          
    END;
  END;

  AsnAny = RECORD
    asnType  : BYTE;
    asnValue : TasnValue;
  END;
  PAsnAny = POINTER TO AsnAny;

  AsnObjectName     = AsnObjectIdentifier;
  AsnObjectSyntax   = AsnAny;
  PAsnObjectName    = PAsnObjectIdentifier;
  PAsnObjectSyntax  = PAsnAny;

  SnmpVarBind = RECORD
    name  : AsnObjectName;
    value : AsnObjectSyntax;
  END;
  PSnmpVarBind = POINTER TO SnmpVarBind;

  SnmpVarBindList = RECORD
    list : POINTER TO SnmpVarBind;
    len  : windows.UINT;
  END;
  PSnmpVarBindList = POINTER TO SnmpVarBindList;

(*# restore *)


///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Extension API Prototypes                                             //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////


  PROCEDURE SnmpExtensionInit(
    dwUptimeReference     : LONGWORD;
    phSubagentTrapEvent   : PHANDLE;
    pFirstSupportedRegion : PAsnObjectIdentifier
  ) : BOOL;

  PROCEDURE SnmpExtensionInitEx(
    pNextSupportedRegion  : PAsnObjectIdentifier
  ) : BOOL;

  PROCEDURE SnmpExtensionQuery(
    bPduType              : BYTE;
    pVarBindList          : PSnmpVarBindList;
    pErrorStatus          : PAsnInteger32;
    pErrorIndex           : PAsnInteger32
  ) : BOOL;

  PROCEDURE SnmpExtensionQueryEx(
    nRequestType          : windows.UINT;
    nTransactionId        : windows.UINT;
    pVarBindList          : PSnmpVarBindList;
    pContextInfo          : PAsnOctetString;
    pErrorStatus          : PAsnInteger32;
    pErrorIndex           : PAsnInteger32
  ) : BOOL;

  PROCEDURE SnmpExtensionTrap(
    pEnterpriseOid        : PAsnObjectIdentifier;
    pGenericTrapId        : PAsnInteger32;
    pSpecificTrapId       : PAsnInteger32;
    pTimeStamp            : PAsnTimeticks;
    pVarBindList          : PSnmpVarBindList
  ) : BOOL;

  PROCEDURE SnmpExtensionClose();

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Extension API Type Definitions                                       //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

TYPE
  PFNSNMPEXTENSIONINIT = PROCEDURE(
    DWORD,                  // dwUpTimeReference
    PHANDLE,                // phSubagentTrapEvent
    PAsnObjectIdentifier    // pFirstSupportedRegion
  ) : BOOL;

  PFNSNMPEXTENSIONINITEX = PROCEDURE(
    PAsnObjectIdentifier    // pNextSupportedRegion
  ) : BOOL;

  PFNSNMPEXTENSIONQUERY = PROCEDURE(
    BYTE,                   // bPduType
    PSnmpVarBindList,       // pVarBindList
    PAsnInteger32,          // pErrorStatus
    PAsnInteger32           // pErrorIndex
  ) : BOOL;

  PFNSNMPEXTENSIONQUERYEX = PROCEDURE(
    windows.UINT,           // nRequestType
    windows.UINT,           // nTransactionId
    PSnmpVarBindList,       // pVarBindList
    PAsnOctetString,        // pContextInfo
    PAsnInteger32,          // pErrorStatus
    PAsnInteger32           // pErrorIndex
  ) : BOOL;

  PFNSNMPEXTENSIONTRAP = PROCEDURE(
    PAsnObjectIdentifier,   // pEnterpriseOid
    PAsnInteger32,          // pGenericTrapId
    PAsnInteger32,          // pSpecificTrapId
    PAsnTimeticks,          // pTimeStamp
    PSnmpVarBindList        // pVarBindList
  );

  PFNSNMPEXTENSIONCLOSE = PROCEDURE();

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP API Prototypes                                                       //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

  PROCEDURE SnmpUtilOidCpy(
    pOidDst : PAsnObjectIdentifier;
    pOidSrc : PAsnObjectIdentifier
  ) : SNMPAPI;

  PROCEDURE SnmpUtilOidAppend(
    pOidDst : PAsnObjectIdentifier;
    pOidSrc : PAsnObjectIdentifier
  ) : SNMPAPI;

  PROCEDURE SnmpUtilOidNCmp(
    pOid1   : PAsnObjectIdentifier;
    pOid2   : PAsnObjectIdentifier;
    nSubIds : windows.UINT
  ) : SNMPAPI;

  PROCEDURE SnmpUtilOidCmp(
    pOid1   : PAsnObjectIdentifier;
    pOid2   : PAsnObjectIdentifier
  ) : SNMPAPI;

  PROCEDURE SnmpUtilOidFree(
    pOid    : PAsnObjectIdentifier
  );

  PROCEDURE SnmpUtilOctetsCmp(
    pOctets1  : PAsnOctetString;
    pOctets2  : PAsnOctetString
  ) : SNMPAPI;

  PROCEDURE SnmpUtilOctetsNCmp(
    pOctets1  : PAsnOctetString;
    pOctets2  : PAsnOctetString;
    nChars    : windows.UINT
  ) : SNMPAPI;

  PROCEDURE SnmpUtilOctetsCpy(
    pOctetsDst  : PAsnOctetString;
    pOctetsSrc  : PAsnOctetString
  ) : SNMPAPI;

  PROCEDURE SnmpUtilOctetsFree(
    pOctets : AsnOctetString
  ) : SNMPAPI;

  PROCEDURE SnmpUtilAsnAnyCpy(
    pAnyDst : PAsnAny;
    pAnySrc : PAsnAny
  ) : SNMPAPI;

  PROCEDURE SnmpUtilAsnAnyFree(
    pAny    : PAsnAny
    );

  PROCEDURE SnmpUtilVarBindCpy(
    pVbDst  : PSnmpVarBind;
    pVbSrc  : SnmpVarBind
  ) : SNMPAPI;

  PROCEDURE SnmpUtilVarBindFree(
    pVb : PSnmpVarBind
  );

  PROCEDURE SnmpUtilVarBindListCpy(
    pVblDst : PSnmpVarBindList;
    pVblSrc : PSnmpVarBindList
  ) : SNMPAPI;

  PROCEDURE SnmpUtilVarBindListFree(
    pVbl    : SnmpVarBindList
  );

  PROCEDURE SnmpUtilMemFree(
    pMem    : ADDRESS
  );

  PROCEDURE SnmpUtilMemAlloc(
    nBytes  : windows.UINT
  ) : ADDRESS;

  PROCEDURE SnmpUtilMemReAlloc(
    pMem    : ADDRESS;
    nBytes  : windows.UINT
  ) : ADDRESS;

  PROCEDURE SnmpUtilOidToA(
    Oid : PAsnObjectIdentifier
  ) : windows.PSTR;

  PROCEDURE SnmpUtilIdsToA(
    Ids       : windows.PUINT;
    IdLength  : windows.UINT
  ) : windows.PSTR;

  PROCEDURE SnmpUtilPrintOid(
    Oid   : PAsnObjectIdentifier
  );

  PROCEDURE SnmpUtilPrintAsnAny(
    pAny  : PAsnAny
  );

  PROCEDURE SnmpSvcGetUptime(
  ) : windows.DWORD;

  PROCEDURE SnmpSvcSetLogLevel(
    nLogLevel : windows.INT
  );

  PROCEDURE SnmpSvcSetLogType(
    nLogType  : windows.INT
  );

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Debugging Definitions                                                //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////
CONST
  SNMP_LOG_SILENT                 = 00H;
  SNMP_LOG_FATAL                  = 01H;
  SNMP_LOG_ERROR                  = 02H;
  SNMP_LOG_WARNING                = 03H;
  SNMP_LOG_TRACE                  = 04H;
  SNMP_LOG_VERBOSE                = 05H;

  SNMP_OUTPUT_TO_CONSOLE          = 01H;
  SNMP_OUTPUT_TO_LOGFILE          = 02H;
  SNMP_OUTPUT_TO_EVENTLOG         = 04H;  // no longer supported
  SNMP_OUTPUT_TO_DEBUGGER         = 08H;

///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// SNMP Debugging Prototypes                                                 //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////

(*/*
VOID
SNMP_FUNC_TYPE
SnmpUtilDbgPrint(
    IN INT nLogLevel,   // see log levels above...
    IN LPSTR szFormat,
    IN ...
    );

#if DBG
#define SNMPDBG(_x_)                    SnmpUtilDbgPrint _x_
#else
#define SNMPDBG(_x_)
#endif
*/*)

