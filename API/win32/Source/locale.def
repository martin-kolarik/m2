DEFINITION MODULE locale;

(*==============================================================

                Win32 API Modula-2 to C++ interface

       32-bit version for M2CPP Modula-2 to C++ compiler

      Copyright (c) 1996, 1997 Moravian Instruments, Inc.

==============================================================*)

(*# name(   prefix         => c ) *)

(*# module( header         => off,
            init_code      => off ) *)

(*# call(   o_a_size       => off,
            o_a_copy       => off,
            c_arrays       => on,
            prefix=>stdcall ) *)

FROM windows IMPORT PCSTR, PCWSTR;

(* Locale categories *)

CONST
  LC_ALL                = 0;
  LC_COLLATE            = 1;
  LC_CTYPE              = 2;
  LC_MONETARY           = 3;
  LC_NUMERIC            = 4;
  LC_TIME               = 5;

  LC_MIN                = LC_ALL;
  LC_MAX                = LC_TIME;

(* Locale convention structure *)

TYPE
  TPString = POINTER TO ARRAY [0..0] OF CHAR;
  TPlconv  = POINTER TO lconv;
  lconv   = RECORD
              decimal_point,
              thousands_sep,
              grouping,
              int_curr_symbol,
              currency_symbol,
              mon_decimal_point,
              mon_thousands_sep,
              mon_grouping,
              positive_sign,
              negative_sign       : TPString;
              int_frac_digits     : SHORTCARD;
              frac_digits         : SHORTCARD;
              p_cs_precedes       : BOOLEAN;
              p_sep_by_space      : BOOLEAN;
              n_cs_precedes       : BOOLEAN;
              n_sep_by_space      : BOOLEAN;
              p_sign_posn         : SHORTCARD;
              n_sign_posn         : SHORTCARD;
            END;

(* ANSI: char lconv members default is CHAR_MAX which is compile time
   dependent. Defining and using _charmax here causes CRT startup code
   to initialize lconv members properly *)

VAR 
  _charmax : INTEGER;

(* function prototypes *)
(*_CRTIMP char * __cdecl setlocale(int, const char * ); *)

PROCEDURE setlocale( cathegory : INTEGER; locale_string : PCSTR ) : PCSTR;

(*_CRTIMP struct lconv * __cdecl localeconv(void); *)

PROCEDURE localeconv() : TPlconv;

(*_CRTIMP wchar_t * __cdecl _wsetlocale(int, const wchar_t * ); *)
PROCEDURE _wsetlocale( cathegory : INTEGER; locale_string : PCWSTR ) : PCWSTR;

END locale.