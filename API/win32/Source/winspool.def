  PRINTER_ATTRIBUTE_LOCAL             = 00000040H;

  PRINTER_ATTRIBUTE_ENABLE_DEVQ       = 00000080H;
  PRINTER_ATTRIBUTE_KEEPPRINTEDJOBS   = 00000100H;
  PRINTER_ATTRIBUTE_DO_COMPLETE_FIRST = 00000200H;

  PRINTER_ATTRIBUTE_WORK_OFFLINE      = 00000400H;
  PRINTER_ATTRIBUTE_ENABLE_BIDI       = 00000800H;
  PRINTER_ATTRIBUTE_RAW_ONLY          = 00001000H;

  NO_PRIORITY  = 0;
  MAX_PRIORITY = 99;
  MIN_PRIORITY = 1;
  DEF_PRIORITY = 1;


TYPE
  PJOB_INFO_1A = POINTER TO JOB_INFO_1A;
  JOB_INFO_1A  = RECORD
                   JobId        : windows.DWORD;
                   pPrinterName : windows.PTSTR;
                   pMachineName : windows.PTSTR;
                   pUserName    : windows.PTSTR;
                   pDocument    : windows.PTSTR;
                   pDatatype    : windows.PTSTR;
                   pStatus      : windows.PTSTR;
                   Status       : windows.DWORD;
                   Priority     : windows.DWORD;
                   Position     : windows.DWORD;
                   TotalPages   : windows.DWORD;
                   PagesPrinted : windows.DWORD;
                   Submitted    : windows.SYSTEMTIME;
                 END;

  PJOB_INFO_2 = POINTER TO JOB_INFO_2;
  JOB_INFO_2  = RECORD
                  JobId               : windows.DWORD;
                  pPrinterName        : windows.PTSTR;
                  pMachineName        : windows.PTSTR;
                  pUserName           : windows.PTSTR;
                  pDocument           : windows.PTSTR;
                  pNotifyName         : windows.PTSTR;
                  pDatatype           : windows.PTSTR;
                  pPrintProcessor     : windows.PTSTR;
                  pParameters         : windows.PTSTR;
                  pDriverName         : windows.PTSTR;
                  pDevMode            : windows.PDEVMODE;
                  pStatus             : windows.PTSTR;
                  pSecurityDescriptor : windows.PSECURITY_DESCRIPTOR;
                  Status              : windows.DWORD;
                  Priority            : windows.DWORD;
                  Position            : windows.DWORD;
                  StartTime           : windows.DWORD;
                  UntilTime           : windows.DWORD;
                  TotalPages          : windows.DWORD;
                  Size                : windows.DWORD;
                  Submitted           : windows.SYSTEMTIME;  // Time the job was spooled
                  Time                : windows.DWORD;       // How many seconds the job has been printing
                  PagesPrinted        : windows.DWORD;
               END;

  PJOB_INFO_3 = POINTER TO JOB_INFO_3;
  JOB_INFO_3  = RECORD
                  JobId     : windows.DWORD;
                  NextJobId : windows.DWORD;
                  Reserved  : windows.DWORD;
                END;

CONST
  JOB_CONTROL_PAUSE              = 1;
  JOB_CONTROL_RESUME             = 2;
  JOB_CONTROL_CANCEL             = 3;
  JOB_CONTROL_RESTART            = 4;
  JOB_CONTROL_DELETE             = 5;
  JOB_CONTROL_SENT_TO_PRINTER    = 6;
  JOB_CONTROL_LAST_PAGE_EJECTED  = 7;

  JOB_STATUS_PAUSED              = 00000001H;
  JOB_STATUS_ERROR               = 00000002H;
  JOB_STATUS_DELETING            = 00000004H;
  JOB_STATUS_SPOOLING            = 00000008H;
  JOB_STATUS_PRINTING            = 00000010H;
  JOB_STATUS_OFFLINE             = 00000020H;
  JOB_STATUS_PAPEROUT            = 00000040H;
  JOB_STATUS_PRINTED             = 00000080H;
  JOB_STATUS_DELETED             = 00000100H;
  JOB_STATUS_BLOCKED_DEVQ        = 00000200H;
  JOB_STATUS_USER_INTERVENTION   = 00000400H;
  JOB_STATUS_RESTART             = 00000800H;

  JOB_POSITION_UNSPECIFIED       = 0;


TYPE
  PADDJOB_INFO_1 = POINTER TO ADDJOB_INFO_1;
  ADDJOB_INFO_1  = RECORD
                     Path  : windows.PTSTR;
                     JobId : windows.DWORD;
                   END;

  PDRIVER_INFO_1 = POINTER TO DRIVER_INFO_1;
  DRIVER_INFO_1  = RECORD
                     pName : windows.PTSTR;  // QMS 810
                   END;


  PDRIVER_INFO_2 = POINTER TO DRIVER_INFO_2;
  DRIVER_INFO_2  = RECORD
                     cVersion     : windows.DWORD;
                     pName        : windows.PTSTR;  // QMS 810
                     pEnvironment : windows.PTSTR;  // Win32 x86
                     pDriverPath  : windows.PTSTR;  // c:\drivers\pscript.dll
                     pDataFile    : windows.PTSTR;  // c:\drivers\QMS810.PPD
                     pConfigFile  : windows.PTSTR;  // c:\drivers\PSCRPTUI.DLL
                   END;


  PDRIVER_INFO_3 = POINTER TO DRIVER_INFO_3;
  DRIVER_INFO_3  = RECORD
                     cVersion         : windows.DWORD;
                     pName            : windows.PTSTR;  // QMS 810
                     pEnvironment     : windows.PTSTR;  // Win32 x86
                     pDriverPath      : windows.PTSTR;  // c:\drivers\pscript.dll
                     pDataFile        : windows.PTSTR;  // c:\drivers\QMS810.PPD
                     pConfigFile      : windows.PTSTR;  // c:\drivers\PSCRPTUI.DLL
                     pHelpFile        : windows.PTSTR;  // c:\drivers\PSCRPTUI.HLP
                     pDependentFiles  : windows.PTSTR;  // PSCRIPT.DLL\0QMS810.PPD\0PSCRIPTUI.DLL\0PSCRIPTUI.HLP\0PSTEST.TXT\0\0
                     pMonitorName     : windows.PTSTR;  // "PJL monitor"
                     pDefaultDataType : windows.PTSTR;  // "EMF"
                   END;

  PDOC_INFO_1 = POINTER TO DOC_INFO_1;
  DOC_INFO_1  = RECORD
                  pDocName    : windows.PTSTR;
                  pOutputFile : windows.PTSTR;
                  pDatatype   : windows.PTSTR;
                END;

  PFORM_INFO_1 = POINTER TO FORM_INFO_1;
  FORM_INFO_1  = RECORD
                   Flags         : windows.DWORD;
                   pName         : windows.PTSTR;
                   Size          : windows.SIZEL;
                   ImageableArea : windows.RECTL;
                 END;

  PDOC_INFO_2 = POINTER TO DOC_INFO_2;
  DOC_INFO_2  = RECORD
                  pDocName    : windows.PTSTR;
                  pOutputFile : windows.PTSTR;
                  pDatatype   : windows.PTSTR;
                  dwMode      : windows.DWORD;
                  JobId       : windows.DWORD;
                END;  


CONST
  DI_CHANNEL        = 1;    // start direct read/write channel,

  DI_READ_SPOOL_JOB = 3;

  FORM_USER         = 00000000H;
