CONST
// SetPrinterData and GetPrinterData Server Handle Key values

  SPLREG_DEFAULT_SPOOL_DIRECTORY             = "DefaultSpoolDirectory";
  SPLREG_PORT_THREAD_PRIORITY_DEFAULT        = "PortThreadPriorityDefault";
  SPLREG_PORT_THREAD_PRIORITY                = "PortThreadPriority";
  SPLREG_SCHEDULER_THREAD_PRIORITY_DEFAULT   = "SchedulerThreadPriorityDefault";
  SPLREG_SCHEDULER_THREAD_PRIORITY           = "SchedulerThreadPriority";
  SPLREG_BEEP_ENABLED                        = "BeepEnabled";
  SPLREG_NET_POPUP                           = "NetPopup";
  SPLREG_EVENT_LOG                           = "EventLog";
  SPLREG_MAJOR_VERSION                       = "MajorVersion";
  SPLREG_MINOR_VERSION                       = "MinorVersion";
  SPLREG_ARCHITECTURE                        = "Architecture";


  SERVER_ACCESS_ADMINISTER    = 00000001H;
  SERVER_ACCESS_ENUMERATE     = 00000002H;

  PRINTER_ACCESS_ADMINISTER   = 00000004H;
  PRINTER_ACCESS_USE          = 00000008H;

  JOB_ACCESS_ADMINISTER       = 00000010H;


// Access rights for print servers

  SERVER_ALL_ACCESS    = windows.STANDARD_RIGHTS_REQUIRED OR SERVER_ACCESS_ADMINISTER OR SERVER_ACCESS_ENUMERATE;

  SERVER_READ          = windows.STANDARD_RIGHTS_READ OR SERVER_ACCESS_ENUMERATE;

  SERVER_WRITE         = windows.STANDARD_RIGHTS_WRITE OR SERVER_ACCESS_ADMINISTER OR SERVER_ACCESS_ENUMERATE;

  SERVER_EXECUTE       = windows.STANDARD_RIGHTS_EXECUTE OR SERVER_ACCESS_ENUMERATE;

// Access rights for printers

  PRINTER_ALL_ACCESS    = windows.STANDARD_RIGHTS_REQUIRED OR PRINTER_ACCESS_ADMINISTER OR PRINTER_ACCESS_USE;

  PRINTER_READ          = windows.STANDARD_RIGHTS_READ OR PRINTER_ACCESS_USE;

  PRINTER_WRITE         = windows.STANDARD_RIGHTS_WRITE OR PRINTER_ACCESS_USE;

  PRINTER_EXECUTE       = windows.STANDARD_RIGHTS_EXECUTE OR PRINTER_ACCESS_USE;
  
// Access rights for jobs

  JOB_ALL_ACCESS         = windows.STANDARD_RIGHTS_REQUIRED OR JOB_ACCESS_ADMINISTER;

  JOB_READ               = windows.STANDARD_RIGHTS_READ OR JOB_ACCESS_ADMINISTER;

  JOB_WRITE              = windows.STANDARD_RIGHTS_WRITE OR JOB_ACCESS_ADMINISTER;

  JOB_EXECUTE            = windows.STANDARD_RIGHTS_EXECUTE OR JOB_ACCESS_ADMINISTER;


END winspool.