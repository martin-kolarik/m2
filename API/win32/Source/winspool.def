                       pPrinterEnum : windows.PBYTE;
                       cbBuf        : windows.DWORD;
                       pcbNeeded    : windows.PDWORD;
                       pcReturned   : windows.PDWORD ) : windows.BOOL;

CONST
  PRINTER_ENUM_DEFAULT     = 00000001H;
  PRINTER_ENUM_LOCAL       = 00000002H;
  PRINTER_ENUM_CONNECTIONS = 00000004H;
