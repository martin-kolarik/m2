IMPORT
  windows,
  prsht;

TYPE
  PPRINTER_INFO_1 = POINTER TO PRINTER_INFO_1;
  PRINTER_INFO_1  = RECORD
                      Flags        : windows.DWORD;
                      pDescription : windows.PTSTR;
                      pName        : windows.PTSTR;
                      pComment     : windows.PTSTR;
                    END;


  PPRINTER_INFO_2 = POINTER TO PRINTER_INFO_2;
  PRINTER_INFO_2  = RECORD
                      pServerName         : windows.PTSTR;
                      pPrinterName        : windows.PTSTR;
                      pShareName          : windows.PTSTR;
                      pPortName           : windows.PTSTR;
                      pDriverName         : windows.PTSTR;
                      pComment            : windows.PTSTR;
                      pLocation           : windows.PTSTR;
                      pDevMode            : windows.PDEVMODE;
                      pSepFile            : windows.PTSTR;
                      pPrintProcessor     : windows.PTSTR;
                      pDatatype           : windows.PTSTR;
                      pParameters         : windows.PTSTR;
                      pSecurityDescriptor : windows.PSECURITY_DESCRIPTOR ;
                      Attributes          : windows.DWORD;
                      Priority            : windows.DWORD;
                      DefaultPriority     : windows.DWORD;
                      StartTime           : windows.DWORD;
                      UntilTime           : windows.DWORD;
                      Status              : windows.DWORD;
                      cJobs               : windows.DWORD;
                      AveragePPM          : windows.DWORD;
                    END;


  PPRINTER_INFO_3 = POINTER TO PRINTER_INFO_3;
  PRINTER_INFO_3  = RECORD
                      pSecurityDescriptor : windows.PSECURITY_DESCRIPTOR;
                    END;

  PPRINTER_INFO_4 = POINTER TO PRINTER_INFO_4;
  PRINTER_INFO_4  = RECORD
                      pPrinterName : windows.PTSTR;
                      pServerName  : windows.PTSTR;
                      Attributes   : windows.DWORD;
                    END;

  PPRINTER_INFO_5 = POINTER TO PRINTER_INFO_5;
  PRINTER_INFO_5  = RECORD
                      pPrinterName             : windows.PTSTR;
                      pPortName                : windows.PTSTR;
                      Attributes               : windows.DWORD;
                      DeviceNotSelectedTimeout : windows.DWORD;
                      TransmissionRetryTimeout : windows.DWORD;
                    END;

  PPRINTER_INFO_6 = POINTER TO PRINTER_INFO_6;
  PRINTER_INFO_6  = RECORD
                      dwStatus : windows.DWORD;
                    END;

CONST
  PRINTER_CONTROL_PAUSE               = 1;
  PRINTER_CONTROL_RESUME              = 2;
  PRINTER_CONTROL_PURGE               = 3;
  PRINTER_CONTROL_SET_STATUS          = 4;

  PRINTER_STATUS_PAUSED               = 00000001H;
  PRINTER_STATUS_ERROR                = 00000002H;
  PRINTER_STATUS_PENDING_DELETION     = 00000004H;
  PRINTER_STATUS_PAPER_JAM            = 00000008H;
  PRINTER_STATUS_PAPER_OUT            = 00000010H;
