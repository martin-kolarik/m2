  JOB_NOTIFY_FIELD_BYTES_PRINTED               = 17H;

TYPE
  PPRINTER_NOTIFY_OPTIONS_TYPE = POINTER TO PRINTER_NOTIFY_OPTIONS_TYPE;
  PRINTER_NOTIFY_OPTIONS_TYPE  = RECORD
                                   Type      : WORD ;
                                   Reserved0 : WORD;
                                   Reserved1 : windows.DWORD;
                                   Reserved2 : windows.DWORD;
                                   Count     : windows.DWORD;
                                   pFields   : windows.PWORD;
                                 END; 


CONST
  PRINTER_NOTIFY_OPTIONS_REFRESH = 01H;

TYPE
  PPRINTER_NOTIFY_OPTIONS = POINTER TO PRINTER_NOTIFY_OPTIONS;
  PRINTER_NOTIFY_OPTIONS  = RECORD 
                              Version : windows.DWORD;
                              Flags   : windows.DWORD;
                              Count   : windows.DWORD;
                              pTypes  : PPRINTER_NOTIFY_OPTIONS_TYPE;
                            END;


CONST
  PRINTER_NOTIFY_INFO_DISCARDED       = 01H;

TYPE
  PPRINTER_NOTIFY_INFO_DATA = POINTER TO PRINTER_NOTIFY_INFO_DATA;
  PRINTER_NOTIFY_INFO_DATA  = RECORD
                                Type     : WORD;
                                Field    : WORD;
                                Reserved : windows.DWORD;
                                Id       : windows.DWORD;
                                CASE : BYTE OF
                                | 0 : adwData : ARRAY [0..1] OF windows.DWORD;
                                | 1 : cbBuf   : windows.DWORD;
                                      pBuf    : windows.PVOID;
                                END;
                              END;

  PPRINTER_NOTIFY_INFO = POINTER TO PRINTER_NOTIFY_INFO;
  PRINTER_NOTIFY_INFO  = RECORD
                           Version : windows.DWORD;
                           Flags   : windows.DWORD;
                           Count   : windows.DWORD;
                           aData   : ARRAY [0..0] OF PRINTER_NOTIFY_INFO_DATA ;
                         END;

