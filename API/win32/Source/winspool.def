PROCEDURE OpenPrinter( pPrinterName : windows.PTSTR;
                       phPrinter    : windows.PHANDLE;
                       pDefault     : PPRINTER_DEFAULTS ) : windows.BOOL ;

PROCEDURE ResetPrinter( hPrinter : windows.HANDLE;
                        pDefault : PPRINTER_DEFAULTS ) : windows.BOOL;

PROCEDURE SetJob( hPrinter : windows.HANDLE;
                  JobId    : windows.DWORD;
                  Level    : windows.DWORD;
                  pJob     : windows.PBYTE;
                  Command  : windows.DWORD ) : windows.BOOL;

