(* parameter block for MCI_WHERE, MCI_PUT, MCI_FREEZE, MCI_UNFREEZE cmds *)

TYPE
  MCI_DGV_RECT_PARMS = RECORD
    dwCallback : windows.DWORD;
    rc         : windows.RECT;
  END;

  PMCI_DGV_RECT_PARMS = POINTER TO MCI_DGV_RECT_PARMS;

(* parameter block for MCI_CAPTURE command message *)

  MCI_DGV_CAPTURE_PARMS = RECORD
    dwCallback    : windows.DWORD;
    lpstrFileName : windows.PTSTR;
    rc            : windows.RECT;
  END; 
  PMCI_DGV_CAPTURE_PARMS = POINTER TO MCI_DGV_CAPTURE_PARMS;

(* parameter block for MCI_CLOSE command message *)

  MCI_CLOSE_PARMS = mmsystem.MCI_GENERIC_PARMS;
  PMCI_CLOSE_PARMS = POINTER TO MCI_CLOSE_PARMS;

(* parameter block for MCI_COPY command message *)

  MCI_DGV_COPY_PARMS = RECORD
    dwCallback    : windows.DWORD;
