    dwTo          : windows.DWORD;
    rc            : windows.RECT;
    dwAudioStream : windows.DWORD;
    dwVideoStream : windows.DWORD;
  END;
  PMCI_DGV_COPY_PARMS = POINTER TO MCI_DGV_COPY_PARMS;

(* parameter block for MCI_CUE command message *)

