DEFINITION MODULE sqltypes;

(*==============================================================

           This file defines the types used in ODBC

       32-bit version for M2CPP Modula-2 to C++ compiler

      Copyright (c) 1996, 1997 Moravian Instruments, Inc.

==============================================================*)

(*# name(   prefix          => c ) *)

(*# module( header          => off,
            init_code       => off ) *)

(*# call(   o_a_size        => off,
            o_a_copy        => off,
            c_arrays        => on,
            result_optional => on,
            prefix=>stdcall ) *)

(*==============================================================

  History: Created: 10.11.1997
           Build 0: **.**.****

==============================================================*)

IMPORT
  windows;

CONST
  ODBCVER = 0300H;

(* API declaration data types *)
TYPE
  SQLCHAR      = BYTE;            // unsigned char

  SQLSCHAR     = INT8;            // signed char
  SQLDATE      = BYTE;            // unsigned char
  SQLDECIMAL   = BYTE;            // unsigned char
  SQLDOUBLE    = LONGREAL;
  SQLFLOAT     = LONGREAL;

  SQLINTEGER   = windows.LONG;
  SQLUINTEGER  = windows.ULONG;

  SQLNUMERIC   = BYTE;
  SQLPOINTER   = windows.PVOID;
  SQLREAL      = windows.FLOAT;

  SQLSMALLINT  = windows.SHORT;
  SQLUSMALLINT = windows.USHORT;
  SQLTIME      = BYTE;            // unsigned char
  SQLTIMESTAMP = BYTE;            // unsigned char
  SQLVARCHAR   = BYTE;            // unsigned char


(* function return type *)
  SQLRETURN = SQLSMALLINT;

(* generic data structures *)
  SQLHANDLE = windows.PVOID;

  SQLHENV  = SQLHANDLE;
  SQLHDBC  = SQLHANDLE;
  SQLHSTMT = SQLHANDLE;
  SQLHDESC = SQLHANDLE;

(* SQL portable types for C *)
  UCHAR       = windows.UCHAR;
  SCHAR       = INT8;           // signed char
  SDWORD      = windows.DWORD;
  SWORD       = windows.SHORT;
  UDWORD      = windows.ULONG;
  UWORD       = windows.USHORT;
  PUWORD      = POINTER TO UWORD;

  SLONG       = windows.LONG;
  SSHORT      = windows.SHORT;
  ULONG       = windows.ULONG;
  USHORT      = windows.USHORT;
  SDOUBLE     = LONGREAL;
  LDOUBLE     = LONGREAL; 
  SFLOAT      = windows.FLOAT;

  PTR         = windows.PVOID;

  HENV        = windows.PVOID;
  HDBC        = windows.PVOID;
  HSTMT       = windows.PVOID;


  RETCODE     = windows.SHORT;


  SQLHWND     = windows.HWND;


(* transfer types for DATE, TIME, TIMESTAMP *)
  DATE_STRUCT = RECORD
                  year  : SQLSMALLINT;
                  month : SQLUSMALLINT;
                  day   : SQLUSMALLINT;
                END;

  SQL_DATE_STRUCT = DATE_STRUCT;

  TIME_STRUCT = RECORD
                  hour   : SQLUSMALLINT;
                  minute : SQLUSMALLINT;
                  second : SQLUSMALLINT;
                END;

  SQL_TIME_STRUCT = TIME_STRUCT;

  TIMESTAMP_STRUCT = RECORD
                       year     : SQLSMALLINT;
                       month    : SQLUSMALLINT;
                       day      : SQLUSMALLINT;
                       hour     : SQLUSMALLINT;
                       minute   : SQLUSMALLINT;
                       second   : SQLUSMALLINT;
                       fraction : SQLUINTEGER;
                     END;

 SQL_TIMESTAMP_STRUCT = TIMESTAMP_STRUCT	;


(*
 * enumerations for DATETIME_INTERVAL_SUBCODE values for interval data types
 * these values are from SQL-92
 *)

  SQLINTERVAL = (
    SQL_IS_DUMMY,            (*  0 *)  // force for MODULA-2
	  SQL_IS_YEAR,						 (*  1 *)
	  SQL_IS_MONTH,				  	 (*  2 *)
	  SQL_IS_DAY,				  		 (*  3 *)
	  SQL_IS_HOUR,			  		 (*  4 *)
	  SQL_IS_MINUTE,	  			 (*  5 *)
	  SQL_IS_SECOND,				   (*  6 *)
	  SQL_IS_YEAR_TO_MONTH,		 (*  7 *)
	  SQL_IS_DAY_TO_HOUR,			 (*  8 *)
	  SQL_IS_DAY_TO_MINUTE,		 (*  9 *)
	  SQL_IS_DAY_TO_SECOND,		 (* 10 *)
	  SQL_IS_HOUR_TO_MINUTE,	 (* 11 *)
	  SQL_IS_HOUR_TO_SECOND,	 (* 12 *)
	  SQL_IS_MINUTE_TO_SECOND	 (* 13 *)
  );

  SQL_YEAR_MONTH_STRUCT = RECORD
                            year  : SQLUINTEGER;
                            month : SQLUINTEGER;
                          END;

  SQL_DAY_SECOND_STRUCT = RECORD
                            day      : SQLUINTEGER;
                            hour     : SQLUINTEGER;
                            minute   : SQLUINTEGER;
                            second   : SQLUINTEGER;
                            fraction : SQLUINTEGER;
                          END;


  SQL_INTERVAL_STRUCT = RECORD
	                        interval_type : SQLINTERVAL;
	                        interval_sign : SQLSMALLINT;
	                        CASE : CARDINAL OF
		                      | 1 : year_month : SQL_YEAR_MONTH_STRUCT;
		                      | 2 : day_second : SQL_DAY_SECOND_STRUCT;
                          END;
                        END;

(* the ODBC C types for SQL_C_SBIGINT and SQL_C_UBIGINT *)
TYPE
(* Add by White 10.11.1997 *)
  TSint64 = RECORD
              L, H : INTEGER;
            END;
  TUint64 = RECORD
              L, H : CARDINAL;
            END;

  ODBCINT64	= TUint64;

(* If using other compilers, define ODBCINT64 to the approriate 64 bit integer type *)
  SQLBIGINT  = ODBCINT64;
  SQLUBIGINT = TUint64;   // unsigned ODBCINT64;

CONST
(* internal representation of numeric data type *)
  SQL_MAX_NUMERIC_LEN	= 16;

TYPE
  SQL_NUMERIC_STRUCT = RECORD
                         precision : SQLCHAR;
                         scale     : SQLSCHAR;
                         sign      : SQLCHAR;  (* 1 if positive, 0 if negative *)
                         val       : ARRAY [0..SQL_MAX_NUMERIC_LEN - 1] OF SQLCHAR;
                       END;

  BOOKMARK = CARDINAL;

  SQLWCHAR = CARD16;  // wchar_t;

(*%F UNICODE *)  
  SQLTCHAR = SQLCHAR;
(*%E UNICODE *)  
(*%T UNICODE *)  
  SQLTCHAR = SQLWCHAR;
(*%E UNICODE *)  


(*============================================================*)

(* Add by White 11.11.1997 *)
TYPE
  TPSQLHDBC      = POINTER TO SQLHDBC;
  TPSQLHENV      = POINTER TO SQLHENV;
  TPSQLHANDLE    = POINTER TO SQLHANDLE;
  TPSQLHSTMT     = POINTER TO SQLHSTMT;
  TPSQLINTEGER   = POINTER TO SQLINTEGER;
  TPSQLUINTEGER  = POINTER TO SQLUINTEGER;
  TPSQLSMALLINT  = POINTER TO SQLSMALLINT;
  TPSQLUSMALLINT = POINTER TO SQLUSMALLINT;
  TPSQLCHAR      = POINTER TO SQLCHAR;
  TPSQLPOINTER   = POINTER TO SQLPOINTER;
  TPSQLTCHAR     = POINTER TO SQLTCHAR;


END sqltypes.