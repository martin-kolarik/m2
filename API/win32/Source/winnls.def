* Copyright (c) 1991-1995, Microsoft Corp. All rights reserved.           *
*                                                                         *
**************************************************************************)


(***************************************************************************\
* Constants
*
* Define all constants for the NLS component here.
\***************************************************************************)

CONST

(*
 *  String Length Maximums.
 *)
  MAX_LEADBYTES        = 12;            (* 5 ranges, 2 bytes ea., 0 term. *)
  MAX_DEFAULTCHAR      = 2;             (* single or double byte *)


(*
 *  MBCS and Unicode Translation Flags.
 *)
  MB_PRECOMPOSED       = 000000001H;    (* use precomposed chars *)
  MB_COMPOSITE         = 000000002H;    (* use composite chars *)
  MB_USEGLYPHCHARS     = 000000004H;    (* use glyph chars, not ctrl chars *)
  MB_ERR_INVALID_CHARS = 000000008H;    (* error for invalid chars *)

  WC_DEFAULTCHECK      = 000000100H;    (* check for default char *)
  WC_COMPOSITECHECK    = 000000200H;    (* convert composite to precomposed *)
  WC_DISCARDNS         = 000000010H;    (* discard non-spacing chars *)
  WC_SEPCHARS          = 000000020H;    (* generate separate chars *)
  WC_DEFAULTCHAR       = 000000040H;    (* replace w/ default char *)



(*
 *  Character Type Flags.
 *)
  CT_CTYPE1            = 000000001H;    (* ctype 1 information *)
  CT_CTYPE2            = 000000002H;    (* ctype 2 information *)
  CT_CTYPE3            = 000000004H;    (* ctype 3 information *)

(*
 *  CType 1 Flag Bits.
 *)
  C1_UPPER             = 00001H;        (* upper case *)
  C1_LOWER             = 00002H;        (* lower case *)
  C1_DIGIT             = 00004H;        (* decimal digits *)
  C1_SPACE             = 00008H;        (* spacing characters *)
  C1_PUNCT             = 00010H;        (* punctuation characters *)
  C1_CNTRL             = 00020H;        (* control characters *)
  C1_BLANK             = 00040H;        (* blank characters *)
  C1_XDIGIT            = 00080H;        (* other digits *)
  C1_ALPHA             = 00100H;        (* any linguistic character *)

(*
 *  CType 2 Flag Bits.
 *)
  C2_LEFTTORIGHT       = 00001H;        (* left to right *)
  C2_RIGHTTOLEFT       = 00002H;        (* right to left *)

  C2_EUROPENUMBER      = 00003H;        (* European number, digit *)
  C2_EUROPESEPARATOR   = 00004H;        (* European numeric separator *)
  C2_EUROPETERMINATOR  = 00005H;        (* European numeric terminator *)
  C2_ARABICNUMBER      = 00006H;        (* Arabic number *)
  C2_COMMONSEPARATOR   = 00007H;        (* common numeric separator *)

  C2_BLOCKSEPARATOR    = 00008H;        (* block separator *)
  C2_SEGMENTSEPARATOR  = 00009H;        (* segment separator *)
  C2_WHITESPACE        = 0000AH;        (* white space *)
  C2_OTHERNEUTRAL      = 0000BH;        (* other neutrals *)

  C2_NOTAPPLICABLE     = 00000H;        (* no implicit directionality *)

(*
 *  CType 3 Flag Bits.
 *)
  C3_NONSPACING        = 00001H;        (* nonspacing character *)
  C3_DIACRITIC         = 00002H;        (* diacritic mark *)
  C3_VOWELMARK         = 00004H;        (* vowel mark *)
  C3_SYMBOL            = 00008H;        (* symbols *)

  C3_KATAKANA          = 00010H;        (* katakana character *)
  C3_HIRAGANA          = 00020H;        (* hiragana character *)
  C3_HALFWIDTH         = 00040H;        (* half width character *)
  C3_FULLWIDTH         = 00080H;        (* full width character *)
  C3_IDEOGRAPH         = 00100H;        (* ideographic character *)
  C3_KASHIDA           = 00200H;        (* Arabic kashida character *)
  C3_LEXICAL           = 00400H;        (* lexical character *)

  C3_ALPHA             = 08000H;        (* any linguistic char (C1_ALPHA) *)

  C3_NOTAPPLICABLE     = 00000H;        (* ctype 3 is not applicable *)


(*
 *  String Flags.
 *)
  NORM_IGNORECASE         = 000000001H; (* ignore case *)
  NORM_IGNORENONSPACE     = 000000002H; (* ignore nonspacing chars *)
  NORM_IGNORESYMBOLS      = 000000004H; (* ignore symbols *)

  NORM_IGNOREKANATYPE     = 000010000H; (* ignore kanatype *)
  NORM_IGNOREWIDTH        = 000020000H; (* ignore width *)


(*
 *  Locale Independent Mapping Flags.
 *)
  MAP_FOLDCZONE           = 000000010H; // fold compatibility zone chars
  MAP_PRECOMPOSED         = 000000020H; // convert to precomposed chars
  MAP_COMPOSITE           = 000000040H; // convert to composite chars
  MAP_FOLDDIGITS          = 000000080H; // all digits to ASCII 0-9
  MAP_EXPAND_LIGATURES    = 000002000H; // expand all ligatures


(*
 *  Locale Dependent Mapping Flags.
 *)
  LCMAP_LOWERCASE         = 000000100H; (* lower case letters *)
  LCMAP_UPPERCASE         = 000000200H; (* upper case letters *)
  LCMAP_SORTKEY           = 000000400H; (* WC sort key (normalize) *)
  LCMAP_BYTEREV           = 000000800H; (* byte reversal *)

  LCMAP_HIRAGANA          = 000100000H; (* map katakana to hiragana *)
  LCMAP_KATAKANA          = 000200000H; (* map hiragana to katakana *)
  LCMAP_HALFWIDTH         = 000400000H; (* map double byte to single byte *)
  LCMAP_FULLWIDTH         = 000800000H; (* map single byte to double byte *)

  LCMAP_LINGUISTIC_CASING = 001000000H; // use linguistic rules for casing

  LCMAP_SIMPLIFIED_CHINESE= 002000000H; // map traditional chinese to simplified chinese
  LCMAP_TRADITIONAL_CHINESE
                          = 004000000H; // map simplified chinese to traditional chinese


(*
 *  Locale Enumeration Flags.
 *)
  LCID_INSTALLED          = 000000001H; (* installed locale ids *)
  LCID_SUPPORTED          = 000000002H; (* supported locale ids *)
  LCID_ALTERNATE_SORTS    = 000000004H; // alternate sort locale ids

(*
 *  Code Page Enumeration Flags.
 *)
  CP_INSTALLED            = 000000001H; (* installed code page ids *)
  CP_SUPPORTED            = 000000002H; (* supported code page ids *)


(*
 *  Sorting Flags.
 *
 *    WORD Sort:    culturally correct sort
 *                  hyphen and apostrophe are special cased
 *                  example: "coop" and "co-op" will sort together in a list
 *
 *                        co_op     <-------  underscore (symbol)
 *                        coat
 *                        comb
 *                        coop
 *                        co-op     <-------  hyphen (punctuation)
 *                        cork
 *                        went
 *                        were
 *                        we're     <-------  apostrophe (punctuation)
 *
 *
 *    STRING Sort:  hyphen and apostrophe will sort with all other symbols
 *
 *                        co-op     <-------  hyphen (punctuation)
 *                        co_op     <-------  underscore (symbol)
 *                        coat
 *                        comb
 *                        coop
 *                        cork
 *                        we're     <-------  apostrophe (punctuation)
 *                        went
 *                        were
 *)
  SORT_STRINGSORT         = 000001000H; (* use string sort method *)


//
//  Compare String Return Values.
//
  CSTR_LESS_THAN          = 1;           // string 1 less than string 2
  CSTR_EQUAL              = 2;           // string 1 equal to string 2
  CSTR_GREATER_THAN       = 3;           // string 1 greater than string 2


(*
 *  Code Page Default Values.
 *)
  CP_ACP               = 0;             (* default to ANSI code page *)
  CP_OEMCP             = 1;             (* default to OEM  code page *)
  CP_MACCP             = 2;             (* default to MAC  code page *)
  CP_THREAD_ACP        = 3;             // current thread's ANSI code page
  CP_SYMBOL            = 42;            // SYMBOL translations

  CP_UTF7              = 65000;         // UTF-7 translation
  CP_UTF8              = 65001;         // UTF-8 translation
  
  // special addendum -- see m2cpp.h
  CP_UTF16             = 1200; // little endian
  CP_UTF16_BIG_ENDIAN  = 1201;

(*
 *  Country Codes.
 *)
  CTRY_DEFAULT                     = 0;

  CTRY_ALBANIA              = 355;         // Albania
  CTRY_ALGERIA              = 213;         // Algeria
  CTRY_ARGENTINA            = 54;          // Argentina
  CTRY_AUSTRALIA            = 61;          // Australia
  CTRY_AUSTRIA              = 43;          // Austria
  CTRY_BAHRAIN              = 973;         // Bahrain
