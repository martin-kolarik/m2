==============================================================*)

(*# name(   decoration     => c ) *)

(*# module( header         => off ) *)

(*# call(   o_a_size       => off,
            c_arrays       => on,
            convention     => stdcall ) *)

IMPORT
  windows;

(**************************************************************************
*                                                                         *
* winnls.h -- NLS procedure declarations, constant definitions and macros *
