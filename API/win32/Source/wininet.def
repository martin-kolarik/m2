//
// Autodial APIs
//

PROCEDURE InternetDial(
    hwndParent : windows.HWND;
    lpszConnectoid : windows.PTSTR;
    dwFlags : windows.DWORD;
    lpdwConnection : windows.PDWORD;
    dwReserved : windows.DWORD
    ) : windows.DWORD;

// Flags for InternetDial - must not conflict with InternetAutodial flags
//                          as they are valid here also.
CONST
  INTERNET_DIAL_FORCE_PROMPT     = 2000H;
  INTERNET_DIAL_SHOW_OFFLINE     = 4000H;
  INTERNET_DIAL_UNATTENDED       = 8000H;

PROCEDURE InternetHangUp(
    dwConnection : windows.DWORD;
    dwReserved : windows.DWORD    
    ) : windows.DWORD;

CONST
  INTERENT_GOONLINE_REFRESH = 00000001H;
  INTERENT_GOONLINE_MASK    = 00000001H;

PROCEDURE InternetGoOnline(
    lpszURL : windows.PTSTR;
    hwndParent : windows.HWND;
    dwFlags : windows.DWORD   
    ) : windows.BOOL;

PROCEDURE InternetAutodial(
    dwFlags : windows.DWORD;
    dwReserved : windows.DWORD   
    ) : windows.BOOL;

// Flags for InternetAutodial
CONST
  INTERNET_AUTODIAL_FORCE_ONLINE          = 1;
  INTERNET_AUTODIAL_FORCE_UNATTENDED      = 2;
  INTERNET_AUTODIAL_FAILIFSECURITYCHECK   = 4;

  INTERNET_AUTODIAL_FLAGS_MASK  = INTERNET_AUTODIAL_FORCE_ONLINE OR
                                  INTERNET_AUTODIAL_FORCE_UNATTENDED OR 
                                  INTERNET_AUTODIAL_FAILIFSECURITYCHECK;

PROCEDURE InternetAutodialHangup(
    dwReserved : windows.DWORD   
    ) : windows.BOOL;

PROCEDURE InternetGetConnectedState(
    lpdwFlags : windows.PDWORD;
    dwReserved : windows.DWORD   
    ) : windows.BOOL;

// Flags for InternetGetConnectedState
CONST
  INTERNET_CONNECTION_MODEM           = 001H;
  INTERNET_CONNECTION_LAN             = 002H;
  INTERNET_CONNECTION_PROXY           = 004H;
  INTERNET_CONNECTION_MODEM_BUSY      = 008H;  // no longer used
  INTERNET_RAS_INSTALLED              = 010H;
  INTERNET_CONNECTION_OFFLINE         = 020H;
  INTERNET_CONNECTION_CONFIGURED      = 040H;

//
// Custom dial handler functions
//

// Custom dial handler prototype

(*# save, call( prefix=>stdcall ) *)
TYPE
  PFN_DIAL_HANDLER = PROCEDURE( windows.HWND, windows.PCSTR, windows.DWORD, windows.PDWORD ) : windows.DWORD;
(*# restore *)

// Flags for custom dial handler
CONST
  INTERNET_CUSTOMDIAL_CONNECT         = 0;
  INTERNET_CUSTOMDIAL_UNATTENDED      = 1;
  INTERNET_CUSTOMDIAL_DISCONNECT      = 2;
  INTERNET_CUSTOMDIAL_SHOWOFFLINE     = 4;

// Custom dial handler supported functionality flags
CONST
  INTERNET_CUSTOMDIAL_SAFE_FOR_UNATTENDED = 1;
  INTERNET_CUSTOMDIAL_WILL_SUPPLY_STATE   = 2;
  INTERNET_CUSTOMDIAL_CAN_HANGUP          = 4;

PROCEDURE InternetSetDialState(
    lpszConnectoid : windows.PCTSTR;
    dwState : windows.DWORD;
    dwReserved : windows.DWORD   
    ) : windows.BOOL;

// States for InternetSetDialState
CONST
  INTERNET_DIALSTATE_DISCONNECTED     = 1;


END wininet.
