(*# option( pack => 4 ) *)


//#if !defined(_WINX32_)
//#define INTERNETAPI DECLSPEC_IMPORT
//#define URLCACHEAPI DECLSPEC_IMPORT
//#else
//#define INTERNETAPI
//#define URLCACHEAPI
//#endif

//#define BOOLAPI INTERNETAPI BOOL WINAPI

//
// internet types
//
TYPE
  HINTERNET       = windows.PVOID;
  LPHINTERNET     = POINTER TO HINTERNET;

  INTERNET_PORT   = WORD;
  LPINTERNET_PORT = POINTER TO INTERNET_PORT;

  PPCSTR          = POINTER TO windows.PCSTR;
  PPCWSTR         = POINTER TO windows.PCWSTR;

//
// Internet APIs
//

//
// manifests
//
CONST
  INTERNET_INVALID_PORT_NUMBER          = 0;           // use the protocol-specific default
                                        
  INTERNET_DEFAULT_FTP_PORT             = 21;          // default for FTP servers
  INTERNET_DEFAULT_GOPHER_PORT          = 70;          //    "     "  gopher "
  INTERNET_DEFAULT_HTTP_PORT            = 80;          //    "     "  HTTP   "
  INTERNET_DEFAULT_HTTPS_PORT           = 443;         //    "     "  HTTPS  "
  INTERNET_DEFAULT_SOCKS_PORT           = 1080;        // default for SOCKS firewall servers.

//
// maximum field lengths (arbitrary)
//
  PROTOCOL_SEPARATOR                    = C'://';

  INTERNET_MAX_HOST_NAME_LENGTH         = 256;
  INTERNET_MAX_USER_NAME_LENGTH         = 128;
  INTERNET_MAX_PASSWORD_LENGTH          = 128;
  INTERNET_MAX_PORT_NUMBER_LENGTH       = 5;           // INTERNET_PORT is unsigned short
  INTERNET_MAX_PORT_NUMBER_VALUE        = 65535;       // maximum unsigned short value
  INTERNET_MAX_PATH_LENGTH              = 2048;
  INTERNET_MAX_SCHEME_LENGTH            = 32;          // longest protocol name length
  INTERNET_MAX_URL_LENGTH               = INTERNET_MAX_SCHEME_LENGTH +
                                          SIZE( PROTOCOL_SEPARATOR ) +
                                          INTERNET_MAX_PATH_LENGTH;

//
// values returned by InternetQueryOption() with INTERNET_OPTION_KEEP_CONNECTION:
//

  INTERNET_KEEP_ALIVE_UNKNOWN           = windows.DWORD( -1 );
  INTERNET_KEEP_ALIVE_ENABLED           = 1;
  INTERNET_KEEP_ALIVE_DISABLED          = 0;

//
// flags returned by InternetQueryOption() with INTERNET_OPTION_REQUEST_FLAGS
//

  INTERNET_REQFLAG_FROM_CACHE           = 00000001H;  // response came from cache
  INTERNET_REQFLAG_ASYNC                = 00000002H;  // request was made asynchronously
  INTERNET_REQFLAG_VIA_PROXY            = 00000004H;  // request was made via a proxy
  INTERNET_REQFLAG_NO_HEADERS           = 00000008H;  // orginal response contained no headers
  INTERNET_REQFLAG_PASSIVE              = 00000010H;  // FTP: passive-mode connection
  INTERNET_REQFLAG_CACHE_WRITE_DISABLED = 00000040H;  // HTTPS: this request not cacheable

//
// flags common to open functions (not InternetOpen()):
//

  INTERNET_FLAG_RELOAD                  = 80000000H;  // retrieve the original item

//
// flags for InternetOpenUrl():
//

  INTERNET_FLAG_RAW_DATA                = 40000000H;  // FTP/gopher find: receive the item as raw (structured) data
  INTERNET_FLAG_EXISTING_CONNECT        = 20000000H;  // FTP: use existing InternetConnect handle for server if possible

//
// flags for InternetOpen():
//

  INTERNET_FLAG_ASYNC                   = 10000000H;  // this request is asynchronous (where supported)

//
// protocol-specific flags:
//

  INTERNET_FLAG_PASSIVE                 = 08000000H;  // used for FTP connections

//
// additional cache flags
//

  INTERNET_FLAG_NO_CACHE_WRITE          = 04000000H;  // don't write this item to the cache
  INTERNET_FLAG_DONT_CACHE              = INTERNET_FLAG_NO_CACHE_WRITE;
  INTERNET_FLAG_MAKE_PERSISTENT         = 02000000H;  // make this item persistent in cache
  INTERNET_FLAG_FROM_CACHE              = 01000000H;  // use offline semantics
  INTERNET_FLAG_OFFLINE                 = INTERNET_FLAG_FROM_CACHE;

//
// additional flags
//

  INTERNET_FLAG_SECURE                  = 00800000H;  // use PCT/SSL if applicable (HTTP)
  INTERNET_FLAG_KEEP_CONNECTION         = 00400000H;  // use keep-alive semantics
  INTERNET_FLAG_NO_AUTO_REDIRECT        = 00200000H;  // don't handle redirections automatically
  INTERNET_FLAG_READ_PREFETCH           = 00100000H;  // do background read prefetch
  INTERNET_FLAG_NO_COOKIES              = 00080000H;  // no automatic cookie handling
  INTERNET_FLAG_NO_AUTH                 = 00040000H;  // no automatic authentication handling
  INTERNET_FLAG_CACHE_IF_NET_FAIL       = 00010000H;  // return cache file if net request fails

//
// Security Ignore Flags, Allow HttpOpenRequest to overide
//  Secure Channel (SSL/PCT) failures of the following types.
//

  INTERNET_FLAG_IGNORE_REDIRECT_TO_HTTP   = 00008000H; // ex: https:// to http://
  INTERNET_FLAG_IGNORE_REDIRECT_TO_HTTPS  = 00004000H; // ex: http:// to https://
  INTERNET_FLAG_IGNORE_CERT_DATE_INVALID  = 00002000H; // expired X509 Cert.
  INTERNET_FLAG_IGNORE_CERT_CN_INVALID    = 00001000H; // bad common name in X509 Cert.

//
// more caching flags
//

  INTERNET_FLAG_RESYNCHRONIZE           = 00000800H;  // asking wininet to update an item if it is newer
  INTERNET_FLAG_HYPERLINK               = 00000400H;  // asking wininet to do hyperlinking semantic which works right for scripts
  INTERNET_FLAG_NO_UI                   = 00000200H;  // no cookie popup
  INTERNET_FLAG_PRAGMA_NOCACHE          = 00000100H;  // asking wininet to add "pragma: no-cache"
  INTERNET_FLAG_CACHE_ASYNC             = 00000080H;  // ok to perform lazy cache-write
  INTERNET_FLAG_FORMS_SUBMIT            = 00000040H;  // this is a forms submit
  INTERNET_FLAG_NEED_FILE               = 00000010H;  // need a file for this request
  INTERNET_FLAG_MUST_CACHE_REQUEST      = INTERNET_FLAG_NEED_FILE;

//
// flags for FTP
//
  FTP_TRANSFER_TYPE_UNKNOWN             = 00000000H;
  FTP_TRANSFER_TYPE_ASCII               = 00000001H;
  FTP_TRANSFER_TYPE_BINARY              = 00000002H;

  FTP_TRANSFER_TYPE_MASK                = FTP_TRANSFER_TYPE_ASCII OR FTP_TRANSFER_TYPE_BINARY;

  INTERNET_FLAG_TRANSFER_ASCII          = FTP_TRANSFER_TYPE_ASCII;     // 0x00000001
  INTERNET_FLAG_TRANSFER_BINARY         = FTP_TRANSFER_TYPE_BINARY;    // 0x00000002


//
// flags field masks
//

  SECURITY_INTERNET_MASK   = INTERNET_FLAG_IGNORE_CERT_CN_INVALID   OR
                             INTERNET_FLAG_IGNORE_CERT_DATE_INVALID OR
                             INTERNET_FLAG_IGNORE_REDIRECT_TO_HTTPS OR
                             INTERNET_FLAG_IGNORE_REDIRECT_TO_HTTP;

  INTERNET_FLAGS_MASK      = INTERNET_FLAG_RELOAD            OR
                             INTERNET_FLAG_RAW_DATA          OR
                             INTERNET_FLAG_EXISTING_CONNECT  OR
                             INTERNET_FLAG_ASYNC             OR
                             INTERNET_FLAG_PASSIVE           OR
                             INTERNET_FLAG_NO_CACHE_WRITE    OR
                             INTERNET_FLAG_MAKE_PERSISTENT   OR
                             INTERNET_FLAG_FROM_CACHE        OR
                             INTERNET_FLAG_SECURE            OR
                             INTERNET_FLAG_KEEP_CONNECTION   OR
                             INTERNET_FLAG_NO_AUTO_REDIRECT  OR
                             INTERNET_FLAG_READ_PREFETCH     OR
                             INTERNET_FLAG_NO_COOKIES        OR
                             INTERNET_FLAG_NO_AUTH           OR
                             INTERNET_FLAG_CACHE_IF_NET_FAIL OR
                             SECURITY_INTERNET_MASK          OR
                             INTERNET_FLAG_RESYNCHRONIZE     OR
                             INTERNET_FLAG_HYPERLINK         OR
                             INTERNET_FLAG_NO_UI             OR
                             INTERNET_FLAG_PRAGMA_NOCACHE    OR
                             INTERNET_FLAG_CACHE_ASYNC       OR
                             INTERNET_FLAG_FORMS_SUBMIT      OR
                             INTERNET_FLAG_NEED_FILE         OR
                             INTERNET_FLAG_TRANSFER_BINARY   OR
                             INTERNET_FLAG_TRANSFER_ASCII;    
                             

  INTERNET_ERROR_MASK_INSERT_CDROM = 1H;

  INTERNET_OPTIONS_MASK            = NOT INTERNET_FLAGS_MASK;

//
// common per-API flags (new APIs)
//

  WININET_API_FLAG_ASYNC           = 00000001H;  // force async operation
  WININET_API_FLAG_SYNC            = 00000004H;  // force sync operation
  WININET_API_FLAG_USE_CONTEXT     = 00000008H;  // use value supplied in dwContext (even if 0)

//
// INTERNET_NO_CALLBACK - if this value is presented as the dwContext parameter
// then no call-backs will be made for that API
//

  INTERNET_NO_CALLBACK             = 0;

//
// structures/types
//

//
// INTERNET_SCHEME - enumerated URL scheme type
//
// typedef enum {
//     INTERNET_SCHEME_PARTIAL = -2,
//     INTERNET_SCHEME_UNKNOWN = -1,
//     INTERNET_SCHEME_DEFAULT = 0,
//     INTERNET_SCHEME_FTP,
//     INTERNET_SCHEME_GOPHER,
//     INTERNET_SCHEME_HTTP,
//     INTERNET_SCHEME_HTTPS,
//     INTERNET_SCHEME_FILE,
//     INTERNET_SCHEME_NEWS,
//     INTERNET_SCHEME_MAILTO,
//     INTERNET_SCHEME_SOCKS,
//     INTERNET_SCHEME_FIRST = INTERNET_SCHEME_FTP,
//     INTERNET_SCHEME_LAST = INTERNET_SCHEME_SOCKS
// } INTERNET_SCHEME, * LPINTERNET_SCHEME;

TYPE
  INTERNET_SCHEME = ( INTERNET_SCHEME_PARTIAL = -2,
                      INTERNET_SCHEME_UNKNOWN = -1,
                      INTERNET_SCHEME_DEFAULT = 0,
                      INTERNET_SCHEME_FTP,
                      INTERNET_SCHEME_GOPHER,
                      INTERNET_SCHEME_HTTP,
                      INTERNET_SCHEME_HTTPS,
                      INTERNET_SCHEME_FILE,
                      INTERNET_SCHEME_NEWS,
                      INTERNET_SCHEME_MAILTO,
                      INTERNET_SCHEME_SOCKS );

CONST
  INTERNET_SCHEME_FIRST ::= INTERNET_SCHEME_FTP;
  INTERNET_SCHEME_LAST  ::= INTERNET_SCHEME_SOCKS;

TYPE
  LPINTERNET_SCHEME = POINTER TO INTERNET_SCHEME;

//
// INTERNET_ASYNC_RESULT - this structure is returned to the application via
// the callback with INTERNET_STATUS_REQUEST_COMPLETE. It is not sufficient to
// just return the result of the async operation. If the API failed then the
// app cannot call GetLastError() because the thread context will be incorrect.
// Both the value returned by the async API and any resultant error code are
// made available. The app need not check dwError if dwResult indicates that
// the API succeeded (in this case dwError will be ERROR_SUCCESS)
//

TYPE
  INTERNET_ASYNC_RESULT = RECORD
    //
    // dwResult - the HINTERNET, DWORD or BOOL return code from an async API
    //

    dwResult : windows.DWORD;

    //
    // dwError - the error code if the API failed
    //

    dwError : windows.DWORD;
  END;

  LPINTERNET_ASYNC_RESULT = POINTER TO INTERNET_ASYNC_RESULT;


//
// INTERNET_PROXY_INFO - structure supplied with INTERNET_OPTION_PROXY to get/
// set proxy information on a InternetOpen() handle
//

TYPE
  INTERNET_PROXY_INFO = RECORD
    //
    // dwAccessType - INTERNET_OPEN_TYPE_DIRECT, INTERNET_OPEN_TYPE_PROXY, or
    // INTERNET_OPEN_TYPE_PRECONFIG (set only)
    //

     dwAccessType : windows.DWORD;

    //
    // lpszProxy - proxy server list
    //

    lpszProxy : windows.PCTSTR;

    //
    // lpszProxyBypass - proxy bypass list
    //

    lpszProxyBypass : windows.PCTSTR;
  END;

  LPINTERNET_PROXY_INFO = POINTER TO INTERNET_PROXY_INFO;

//
// INTERNET_VERSION_INFO - version information returned via
// InternetQueryOption(..., INTERNET_OPTION_VERSION, ...)
//

TYPE
  INTERNET_VERSION_INFO = RECORD
    dwMajorVersion : windows.DWORD;
    dwMinorVersion : windows.DWORD;
  END;

  LPINTERNET_VERSION_INFO = POINTER TO INTERNET_VERSION_INFO;

//
// HTTP_VERSION_INFO - query or set global HTTP version (1.0 or 1.1)
//

TYPE
  HTTP_VERSION_INFO = RECORD
    dwMajorVersion : windows.DWORD;
    dwMinorVersion : windows.DWORD;
  END;

  LPHTTP_VERSION_INFO = POINTER TO HTTP_VERSION_INFO;

//
// INTERNET_CONNECTED_INFO - information used to set the global connected state
//

TYPE
  INTERNET_CONNECTED_INFO = RECORD
    //
    // dwConnectedState - new connected/disconnected state.
    // See INTERNET_STATE_CONNECTED, etc.
    //

    dwConnectedState : windows.DWORD;

    //
    // dwFlags - flags controlling connected->disconnected (or disconnected->
    // connected) transition. See below
    //

    dwFlags : windows.DWORD;
  END;

  LPINTERNET_CONNECTED_INFO = POINTER TO INTERNET_CONNECTED_INFO;


//
// flags for INTERNET_CONNECTED_INFO dwFlags
//

//
// ISO_FORCE_DISCONNECTED - if set when putting Wininet into disconnected mode,
// all outstanding requests will be aborted with a cancelled error
//

CONST
  ISO_FORCE_DISCONNECTED  = 00000001H;


//
// URL_COMPONENTS - the constituent parts of an URL. Used in InternetCrackUrl()
// and InternetCreateUrl()
//
// For InternetCrackUrl(), if a pointer field and its corresponding length field
// are both 0 then that component is not returned. If the pointer field is NULL
// but the length field is not zero, then both the pointer and length fields are
// returned if both pointer and corresponding length fields are non-zero then
// the pointer field points to a buffer where the component is copied. The
// component may be un-escaped, depending on dwFlags
//
// For InternetCreateUrl(), the pointer fields should be NULL if the component
// is not required. If the corresponding length field is zero then the pointer
// field is the address of a zero-terminated string. If the length field is not
// zero then it is the string length of the corresponding pointer field
//

TYPE
  URL_COMPONENTSA = RECORD
    dwStructSize      : windows.DWORD;       // size of this structure. Used in version check
    lpszScheme        : windows.PSTR;        // pointer to scheme name
    dwSchemeLength    : windows.DWORD;       // length of scheme name
    nScheme           : INTERNET_SCHEME ;    // enumerated scheme type (if known)
    lpszHostName      : windows.PSTR;        // pointer to host name
    dwHostNameLength  : windows.DWORD;       // length of host name
    nPort             : INTERNET_PORT ;      // converted port number
    lpszUserName      : windows.PSTR;        // pointer to user name
    dwUserNameLength  : windows.DWORD;       // length of user name
    lpszPassword      : windows.PSTR;        // pointer to password
    dwPasswordLength  : windows.DWORD;       // length of password
    lpszUrlPath       : windows.PSTR;        // pointer to URL-path
    dwUrlPathLength   : windows.DWORD;       // length of URL-path
    lpszExtraInfo     : windows.PSTR;        // pointer to extra information (e.g. ?foo or #foo)
    dwExtraInfoLength : windows.DWORD;       // length of extra information
  END;

  LPURL_COMPONENTSA = POINTER TO URL_COMPONENTSA;

TYPE
  URL_COMPONENTSW = RECORD
    dwStructSize      : windows.DWORD;       // size of this structure. Used in version check
    lpszScheme        : windows.PWSTR;       // pointer to scheme name
    dwSchemeLength    : windows.DWORD;       // length of scheme name
    nScheme           : INTERNET_SCHEME ;    // enumerated scheme type (if known)
    lpszHostName      : windows.PWSTR;       // pointer to host name
    dwHostNameLength  : windows.DWORD;       // length of host name
    nPort             : INTERNET_PORT ;      // converted port number
    lpszUserName      : windows.PWSTR;       // pointer to user name
    dwUserNameLength  : windows.DWORD;       // length of user name
    lpszPassword      : windows.PWSTR;       // pointer to password
    dwPasswordLength  : windows.DWORD;       // length of password
    lpszUrlPath       : windows.PWSTR;       // pointer to URL-path
    dwUrlPathLength   : windows.DWORD;       // length of URL-path
    lpszExtraInfo     : windows.PWSTR;       // pointer to extra information (e.g. ?foo or #foo)
    dwExtraInfoLength : windows.DWORD;       // length of extra information
  END;

  LPURL_COMPONENTSW = POINTER TO URL_COMPONENTSW;

CONST
(*%T UNICODE *)
  URL_COMPONENTS   ::= URL_COMPONENTSW;
  LPURL_COMPONENTS ::= LPURL_COMPONENTSW;
(*%E UNICODE *)
(*%F UNICODE *)
  URL_COMPONENTS   ::= URL_COMPONENTSA;
  LPURL_COMPONENTS ::= LPURL_COMPONENTSA;
(*%E UNICODE *)


//
// INTERNET_CERTIFICATE_INFO lpBuffer - contains the certificate returned from
// the server
//

TYPE
  INTERNET_CERTIFICATE_INFO = RECORD
    //
    // ftExpiry - date the certificate expires.
    //
    ftExpiry : windows.FILETIME;
    //
    // ftStart - date the certificate becomes valid.
    //
    ftStart : windows.FILETIME;
    //
    // lpszSubjectInfo - the name of organization, site, and server
    //   the cert. was issued for.
    //
    lpszSubjectInfo : windows.PTSTR;
    //
    // lpszIssuerInfo - the name of orgainzation, site, and server
    //   the cert was issues by.
    //
    lpszIssuerInfo : windows.PTSTR;
    //
    // lpszProtocolName - the name of the protocol used to provide the secure
    //   connection.
    //
    lpszProtocolName : windows.PTSTR;
    //
    // lpszSignatureAlgName - the name of the algorithm used for signing
    //  the certificate.
    //
    lpszSignatureAlgName : windows.PTSTR;
    //
    // lpszEncryptionAlgName - the name of the algorithm used for
    //  doing encryption over the secure channel (SSL/PCT) connection.
    //
    lpszEncryptionAlgName : windows.PTSTR;
    //
    // dwKeySize - size of the key.
    //
    dwKeySize : windows.DWORD;
  END;

  LPINTERNET_CERTIFICATE_INFO = POINTER TO INTERNET_CERTIFICATE_INFO;


//
// INTERNET_BUFFERS - combines headers and data. May be chained for e.g. file
// upload or scatter/gather operations. For chunked read/write, lpcszHeader
// contains the chunked-ext
//

TYPE
  LPINTERNET_BUFFERSA = POINTER TO INTERNET_BUFFERSA;

  INTERNET_BUFFERSA = RECORD
    dwStructSize    : windows.DWORD;         // used for API versioning. Set to sizeof(INTERNET_BUFFERS)
    Next            : LPINTERNET_BUFFERSA;   // chain of buffers
    lpcszHeader     : windows.PCSTR;         // pointer to headers (may be NULL)
    dwHeadersLength : windows.DWORD;         // length of headers if not NULL
    dwHeadersTotal  : windows.DWORD;         // size of headers if not enough buffer
    lpvBuffer       : ADDRESS;               // pointer to data buffer (may be NULL)
    dwBufferLength  : windows.DWORD;         // length of data buffer if not NULL
    dwBufferTotal   : windows.DWORD;         // total size of chunk, or content-length if not chunked
    dwOffsetLow     : windows.DWORD;         // used for read-ranges (only used in HttpSendRequest2)
    dwOffsetHigh    : windows.DWORD;
  END;


TYPE
  LPINTERNET_BUFFERSW = POINTER TO INTERNET_BUFFERSW;

  INTERNET_BUFFERSW = RECORD
    dwStructSize    : windows.DWORD;         // used for API versioning. Set to sizeof(INTERNET_BUFFERS)
    Next            : LPINTERNET_BUFFERSW;   // chain of buffers
    lpcszHeader     : windows.PCWSTR;        // pointer to headers (may be NULL)
    dwHeadersLength : windows.DWORD;         // length of headers if not NULL
    dwHeadersTotal  : windows.DWORD;         // size of headers if not enough buffer
    lpvBuffer       : ADDRESS;               // pointer to data buffer (may be NULL)
    dwBufferLength  : windows.DWORD;         // length of data buffer if not NULL
    dwBufferTotal   : windows.DWORD;         // total size of chunk, or content-length if not chunked
    dwOffsetLow     : windows.DWORD;         // used for read-ranges (only used in HttpSendRequest2)
    dwOffsetHigh    : windows.DWORD;
  END;

CONST
(*%T UNICODE *)
  INTERNET_BUFFERS   ::= INTERNET_BUFFERSW;
  LPINTERNET_BUFFERS ::= LPINTERNET_BUFFERSW;
(*%E UNICODE *)
(*%F UNICODE *)
  INTERNET_BUFFERS   ::= INTERNET_BUFFERSA;
  LPINTERNET_BUFFERS ::= LPINTERNET_BUFFERSA;
(*%E UNICODE *)

//
// prototypes
//

PROCEDURE InternetTimeFromSystemTime(
    CONST pst : windows.PSYSTEMTIME;         // input GMT time
    dwRFC : windows.DWORD;                   // RFC format
    lpszTime : windows.PSTR;                 // output string buffer
    cbTime : windows.DWORD                   // output buffer size
    ) : windows.BOOL;

//
// constants for InternetTimeFromSystemTime
//

CONST
  INTERNET_RFC1123_FORMAT     = 0;
  INTERNET_RFC1123_BUFSIZE    = 30;

PROCEDURE InternetTimeToSystemTime(
    lpszTime : windows.PCSTR;         // NULL terminated string
    pst : windows.PSYSTEMTIME;         // output in GMT time
    dwReserved : windows.DWORD
    ) : windows.BOOL;


PROCEDURE InternetCrackUrlA(
    lpszUrl : windows.PCSTR;
    dwUrlLength : windows.DWORD;
    dwFlags : windows.DWORD;
    lpUrlComponents : LPURL_COMPONENTSA
    ) : windows.BOOL;

PROCEDURE InternetCrackUrlW(
    lpszUrl : windows.PCWSTR;
    dwUrlLength : windows.DWORD;
    dwFlags : windows.DWORD;
    lpUrlComponents : LPURL_COMPONENTSW
    ) : windows.BOOL;

CONST
(*%T UNICODE *)
  InternetCrackUrl ::= InternetCrackUrlW;
(*%E UNICODE *)
(*%F UNICODE *)
  InternetCrackUrl ::= InternetCrackUrlA;
(*%E UNICODE *)


PROCEDURE InternetCreateUrlA(
    lpUrlComponents : LPURL_COMPONENTSA;
    dwFlags : windows.DWORD;
    lpszUrl : windows.PSTR;
    lpdwUrlLength : windows.PDWORD
    ) : windows.BOOL;

PROCEDURE InternetCreateUrlW(
    lpUrlComponents : LPURL_COMPONENTSW;
    dwFlags : windows.DWORD;
    lpszUrl : windows.PWSTR;
    lpdwUrlLength : windows.PDWORD
    ) : windows.BOOL;

CONST
(*%T UNICODE *)
  InternetCreateUrl ::= InternetCreateUrlW;
(*%E UNICODE *)
(*%F UNICODE *)
  InternetCreateUrl ::= InternetCreateUrlA;
(*%E UNICODE *)

PROCEDURE InternetCanonicalizeUrlA(
    lpszUrl : windows.PCSTR;
    lpszBuffer : windows.PSTR;
    lpdwBufferLength : windows.PDWORD;
    dwFlags : windows.DWORD
    ) : windows.BOOL;

PROCEDURE InternetCanonicalizeUrlW(
    lpszUrl : windows.PCWSTR;
