    ) : windows.BOOL;

CONST
(*%T UNICODE *)
  FtpCreateDirectory ::= FtpCreateDirectoryW;
(*%E UNICODE *)
(*%F UNICODE *)
  FtpCreateDirectory ::= FtpCreateDirectoryA;
(*%E UNICODE *)

