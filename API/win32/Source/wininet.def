PROCEDURE InternetAuthNotifyCallback(
    dwContext : windows.DWORD;              // as passed to InternetErrorDlg
    dwReturn : windows.DWORD;               // error code: success, resend, or cancel
    lpReserved : ADDRESS                    // reserved: will be set to null
