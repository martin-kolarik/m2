    ) : windows.BOOL;

CONST
(*%T UNICODE *)
  FtpSetCurrentDirectory ::= FtpSetCurrentDirectoryW;
(*%E UNICODE *)
(*%F UNICODE *)
  FtpSetCurrentDirectory ::= FtpSetCurrentDirectoryA;
(*%E UNICODE *)

