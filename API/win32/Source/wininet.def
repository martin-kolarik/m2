//
// URLCACHE APIs
//

//
// datatype definitions.
//

//
// cache entry type flags.
//

CONST
  NORMAL_CACHE_ENTRY              = 00000001H;
  COOKIE_CACHE_ENTRY              = 00100000H;
  URLHISTORY_CACHE_ENTRY          = 00200000H;
  TRACK_OFFLINE_CACHE_ENTRY       = 00000010H;
  TRACK_ONLINE_CACHE_ENTRY        = 00000020H;
  STICKY_CACHE_ENTRY              = 00000004H;
  SPARSE_CACHE_ENTRY              = 00010000H;



  URLCACHE_FIND_DEFAULT_FILTER    = NORMAL_CACHE_ENTRY OR 
                                    COOKIE_CACHE_ENTRY OR 
                                    URLHISTORY_CACHE_ENTRY OR 
                                    TRACK_OFFLINE_CACHE_ENTRY OR 
                                    TRACK_ONLINE_CACHE_ENTRY OR 
                                    STICKY_CACHE_ENTRY;



//
// INTERNET_CACHE_ENTRY_INFO -
//


TYPE
  INTERNET_CACHE_ENTRY_INFOA = RECORD
    dwStructSize        : windows.DWORD;     // version of cache system.
    lpszSourceUrlName   : windows.PSTR;      // embedded pointer to the URL name string.
    lpszLocalFileName   : windows.PSTR;      // embedded pointer to the local file name.
    CacheEntryType      : windows.DWORD;     // cache type bit mask.
    dwUseCount          : windows.DWORD;     // current users count of the cache entry.
    dwHitRate           : windows.DWORD;     // num of times the cache entry was retrieved.
    dwSizeLow           : windows.DWORD;     // low DWORD of the file size.
    dwSizeHigh          : windows.DWORD;     // high DWORD of the file size.
    LastModifiedTime    : windows.FILETIME;  // last modified time of the file in GMT format.
    ExpireTime          : windows.FILETIME;  // expire time of the file in GMT format
    LastAccessTime      : windows.FILETIME;  // last accessed time in GMT format
    LastSyncTime        : windows.FILETIME;  // last time the URL was synchronized
                                             // with the source
    lpHeaderInfo        : windows.PBYTE;     // embedded pointer to the header info.
    dwHeaderInfoSize    : windows.DWORD;     // size of the above header.
    lpszFileExtension   : windows.PSTR;      // File extension used to retrive the urldata as a file.
    CASE : BYTE OF                           // Exemption delta from last access time. 
    | 0 : dwReserved    : windows.DWORD;
    | 1 : dwExemptDelta : windows.DWORD;
    END;                                     // Exemption delta from last access
  END;

  LPINTERNET_CACHE_ENTRY_INFOA = POINTER TO INTERNET_CACHE_ENTRY_INFOA;

  INTERNET_CACHE_ENTRY_INFOW = RECORD
    dwStructSize        : windows.DWORD;     // version of cache system.
    lpszSourceUrlName   : windows.PSTR;      // embedded pointer to the URL name string.
    lpszLocalFileName   : windows.PWSTR;     // embedded pointer to the local file name.
    CacheEntryType      : windows.DWORD;     // cache type bit mask.
    dwUseCount          : windows.DWORD;     // current users count of the cache entry.
    dwHitRate           : windows.DWORD;     // num of times the cache entry was retrieved.
    dwSizeLow           : windows.DWORD;     // low DWORD of the file size.
    dwSizeHigh          : windows.DWORD;     // high DWORD of the file size.
    LastModifiedTime    : windows.FILETIME;  // last modified time of the file in GMT format.
    ExpireTime          : windows.FILETIME;  // expire time of the file in GMT format
    LastAccessTime      : windows.FILETIME;  // last accessed time in GMT format
    LastSyncTime        : windows.FILETIME;  // last time the URL was synchronized
                                             // with the source
    lpHeaderInfo        : windows.PBYTE;     // embedded pointer to the header info.
    dwHeaderInfoSize    : windows.DWORD;     // size of the above header.
    lpszFileExtension   : windows.PWSTR;     // File extension used to retrive the urldata as a file.
    CASE : BYTE OF                           // Exemption delta from last access time. 
    | 0 : dwReserved    : windows.DWORD;
    | 1 : dwExemptDelta : windows.DWORD;
    END;                                     // Exemption delta from last access
  END;

  LPINTERNET_CACHE_ENTRY_INFOW = POINTER TO INTERNET_CACHE_ENTRY_INFOW;

CONST
(*%T UNICODE *)
  INTERNET_CACHE_ENTRY_INFO   ::= INTERNET_CACHE_ENTRY_INFOW;
  LPINTERNET_CACHE_ENTRY_INFO ::= LPINTERNET_CACHE_ENTRY_INFOW;
(*%E UNICODE *)
(*%F UNICODE *)
  INTERNET_CACHE_ENTRY_INFO   ::= INTERNET_CACHE_ENTRY_INFOA;
  LPINTERNET_CACHE_ENTRY_INFO ::= LPINTERNET_CACHE_ENTRY_INFOA;
(*%E UNICODE *)


