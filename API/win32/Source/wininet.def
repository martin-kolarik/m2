//
// ... and last parameter of InternetErrorDlg should point to...
//

TYPE
  INTERNET_AUTH_NOTIFY_DATA = RECORD
    cbStruct  : windows.DWORD;              // size of this structure
    dwOptions : windows.DWORD;              // reserved: must set to 0
    pfnNotify : PFN_AUTH_NOTIFY;            // notification callback to retry InternetErrorDlg
    dwContext : windows.DWORD;              // context to pass to to notification function
  END;

