PROCEDURE ImmGetImeMenuItemsW( _ : HIMC; _ : windows.DWORD; _ : windows.DWORD; _ : PIMEMENUITEMINFOW; _ : PIMEMENUITEMINFOW; _ : windows.DWORD): windows.DWORD;

