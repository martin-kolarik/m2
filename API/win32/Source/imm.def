(*# name(   prefix          => c ) *)

(*# module( header          => off,
            init_code       => off ) *)

(*# call(   o_a_size        => off,
            o_a_copy        => off,
            c_arrays        => on,
            result_optional => on,
            prefix=>stdcall ) *)

IMPORT
  windows;

TYPE
//#if (WINVER >= 0x40A)
//  HIMC  = windows.HANDLE;
//  HIMCC = windows.HANDLE;
//#else
  HIMC  = windows.DWORD;
  HIMCC = windows.DWORD;
//#endif

  PHKL = POINTER TO windows.HKL;
  PUINT = POINTER TO windows.UINT;

  COMPOSITIONFORM = RECORD
    dwStyle : windows.DWORD;
    ptCurrentPos : windows.POINT;
    rcArea : windows.RECT;
  END;
  PCOMPOSITIONFORM = POINTER TO COMPOSITIONFORM;

  CANDIDATEFORM = RECORD
    dwIndex : windows.DWORD;
    dwStyle : windows.DWORD;
    ptCurrentPos : windows.POINT;
    rcArea : windows.RECT;
  END;
  PCANDIDATEFORM = POINTER TO CANDIDATEFORM;

  CANDIDATELIST = RECORD
    dwSize : windows.DWORD;
    dwStyle : windows.DWORD;
    dwCount : windows.DWORD;
    dwSelection : windows.DWORD;
    dwPageStart : windows.DWORD;
    dwPageSize : windows.DWORD;
    dwOffset : ARRAY [0..0] OF windows.DWORD;
  END;
  PCANDIDATELIST = POINTER TO CANDIDATELIST;

  REGISTERWORDA = RECORD
    lpReading : windows.PSTR;
    lpWord : windows.PSTR;
  END;
  PREGISTERWORDA = POINTER TO REGISTERWORDA;

  REGISTERWORDW = RECORD
    lpReading : windows.PWSTR;
    lpWord : windows.PWSTR;
  END;
  PREGISTERWORDW = POINTER TO REGISTERWORDW;

CONST
(*%T UNICODE *)
  REGISTERWORD ::= REGISTERWORDW;
  PREGISTERWORD ::= PREGISTERWORDW;
(*%E *)
(*%F UNICODE *)
  REGISTERWORD ::= REGISTERWORDA;
  PREGISTERWORD ::= PREGISTERWORDA;
(*%E *)

// #if(WINVER >= 0x040A)
TYPE
  RECONVERTSTRING = RECORD
    dwSize : windows.DWORD;
    dwVersion : windows.DWORD;
    dwStrLen : windows.DWORD;
    dwStrOffset : windows.DWORD;
    dwCompStrLen : windows.DWORD;
    dwCompStrOffset : windows.DWORD;
    dwTargetStrLen : windows.DWORD;
    dwTargetStrOffset : windows.DWORD;
  END;
  PRECONVERTSTRING = POINTER TO RECONVERTSTRING;
//#endif

CONST
  STYLE_DESCRIPTION_SIZE  = 32;

TYPE
  STYLEBUFA = RECORD
    dwStyle : windows.DWORD;
    szDescription : ARRAY [0..STYLE_DESCRIPTION_SIZE-1] OF CHAR;
  END;
  PSTYLEBUFA = POINTER TO STYLEBUFA;

  STYLEBUFW = RECORD
    dwStyle : windows.DWORD;
    szDescription : ARRAY [0..STYLE_DESCRIPTION_SIZE-1] OF WCHAR;
  END;
  PSTYLEBUFW = POINTER TO STYLEBUFW;

CONST
(*%T UNICODE *)
  STYLEBUF  ::= STYLEBUFW;
  PSTYLEBUF ::= PSTYLEBUFW;
(*%E *)
(*%F UNICODE *)
  STYLEBUF  ::= STYLEBUFA;
  PSTYLEBUF ::= PSTYLEBUFA;
(*%E *)


//#if(WINVER >= 0x040A)

CONST
  IMEMENUITEM_STRING_SIZE = 80;

TYPE
  IMEMENUITEMINFOA = RECORD
    cbSize : windows.UINT;
    fType : windows.UINT;
    fState : windows.UINT;
    wID : windows.UINT;
    hbmpChecked : windows.HBITMAP;
    hbmpUnchecked : windows.HBITMAP;
    dwItemData : windows.DWORD;
    szString : ARRAY [0..IMEMENUITEM_STRING_SIZE-1] OF CHAR;
    hbmpItem : windows.HBITMAP;
  END;
  PIMEMENUITEMINFOA = POINTER TO IMEMENUITEMINFOA;

  IMEMENUITEMINFOW = RECORD
    cbSize : windows.UINT;
    fType : windows.UINT;
    fState : windows.UINT;
    wID : windows.UINT;
    hbmpChecked : windows.HBITMAP;
    hbmpUnchecked : windows.HBITMAP;
    dwItemData : windows.DWORD;
    szString : ARRAY [0..IMEMENUITEM_STRING_SIZE-1] OF WCHAR;
    hbmpItem : windows.HBITMAP;
  END;
  PIMEMENUITEMINFOW = POINTER TO IMEMENUITEMINFOW;

CONST
(*%T UNICODE *)
  IMEMENUITEMINFO  ::= IMEMENUITEMINFOW;
  PIMEMENUITEMINFO ::= PIMEMENUITEMINFOW;
(*%E *)
(*%F UNICODE *)
  IMEMENUITEMINFO  ::= IMEMENUITEMINFOA;
  PIMEMENUITEMINFO ::= PIMEMENUITEMINFOA;
(*%E *)

//#endif  /* WINVER >= 0x040A */

