// wParam for WM_IME_CONTROL
  IMC_GETCANDIDATEPOS             = 00007H;
  IMC_SETCANDIDATEPOS             = 00008H;
  IMC_GETCOMPOSITIONFONT          = 00009H;
  IMC_SETCOMPOSITIONFONT          = 0000AH;
  IMC_GETCOMPOSITIONWINDOW        = 0000BH;
  IMC_SETCOMPOSITIONWINDOW        = 0000CH;
  IMC_GETSTATUSWINDOWPOS          = 0000FH;
  IMC_SETSTATUSWINDOWPOS          = 00010H;
  IMC_CLOSESTATUSWINDOW           = 00021H;
  IMC_OPENSTATUSWINDOW            = 00022H;

// dwAction for ImmNotifyIME
  NI_OPENCANDIDATE                = 00010H;
  NI_CLOSECANDIDATE               = 00011H;
  NI_SELECTCANDIDATESTR           = 00012H;
  NI_CHANGECANDIDATELIST          = 00013H;
  NI_FINALIZECONVERSIONRESULT     = 00014H;
  NI_COMPOSITIONSTR               = 00015H;
  NI_SETCANDIDATE_PAGESTART       = 00016H;
  NI_SETCANDIDATE_PAGESIZE        = 00017H;
  NI_IMEMENUSELECTED              = 00018H;

// lParam for WM_IME_SETCONTEXT
  ISC_SHOWUICANDIDATEWINDOW       = 000000001H;
  ISC_SHOWUICOMPOSITIONWINDOW     = 080000000H;
  ISC_SHOWUIGUIDELINE             = 040000000H;
  ISC_SHOWUIALLCANDIDATEWINDOW    = 00000000FH;
  ISC_SHOWUIALL                   = 0C000000FH;

// dwIndex for ImmNotifyIME/NI_COMPOSITIONSTR
  CPS_COMPLETE                    = 00001H;
  CPS_CONVERT                     = 00002H;
  CPS_REVERT                      = 00003H;
  CPS_CANCEL                      = 00004H;

// the modifiers of hot key
  MOD_ALT                         = 00001H;
  MOD_CONTROL                     = 00002H;
  MOD_SHIFT                       = 00004H;

  MOD_LEFT                        = 08000H;
  MOD_RIGHT                       = 04000H;

  MOD_ON_KEYUP                    = 00800H;
  MOD_IGNORE_ALL_MODIFIER         = 00400H;

// Windows for Simplified Chinese Edition hot key ID from 0x10 - 0x2F
  IME_CHOTKEY_IME_NONIME_TOGGLE           = 010H;
  IME_CHOTKEY_SHAPE_TOGGLE                = 011H;
  IME_CHOTKEY_SYMBOL_TOGGLE               = 012H;

// Windows for Japanese Edition hot key ID from 0x30 - 0x4F
  IME_JHOTKEY_CLOSE_OPEN                  = 030H;

// Windows for Korean Edition hot key ID from 0x50 - 0x6F
  IME_KHOTKEY_SHAPE_TOGGLE                = 050H;
  IME_KHOTKEY_HANJACONVERT                = 051H;
  IME_KHOTKEY_ENGLISH                     = 052H;

// Windows for Traditional Chinese Edition hot key ID from 0x70 - 0x8F
  IME_THOTKEY_IME_NONIME_TOGGLE           = 070H;
  IME_THOTKEY_SHAPE_TOGGLE                = 071H;
  IME_THOTKEY_SYMBOL_TOGGLE               = 072H;

// direct switch hot key ID from 0x100 - 0x11F
  IME_HOTKEY_DSWITCH_FIRST                = 0100H;
  IME_HOTKEY_DSWITCH_LAST                 = 011FH;

// IME private hot key from 0x200 - 0x21F
  IME_HOTKEY_PRIVATE_FIRST                = 0200H;
  IME_ITHOTKEY_RESEND_RESULTSTR           = 0200H;
  IME_ITHOTKEY_PREVIOUS_COMPOSITION       = 0201H;
  IME_ITHOTKEY_UISTYLE_TOGGLE             = 0202H;
  IME_ITHOTKEY_RECONVERTSTRING            = 0203H;
  IME_HOTKEY_PRIVATE_LAST                 = 021FH;

// dwSystemInfoFlags bits

// parameter of ImmGetCompositionString
  GCS_COMPREADSTR                 = 00001H;
  GCS_COMPREADATTR                = 00002H;
  GCS_COMPREADCLAUSE              = 00004H;
  GCS_COMPSTR                     = 00008H;
  GCS_COMPATTR                    = 00010H;
  GCS_COMPCLAUSE                  = 00020H;
  GCS_CURSORPOS                   = 00080H;
  GCS_DELTASTART                  = 00100H;
  GCS_RESULTREADSTR               = 00200H;
  GCS_RESULTREADCLAUSE            = 00400H;
  GCS_RESULTSTR                   = 00800H;
  GCS_RESULTCLAUSE                = 01000H;

// style bit flags for WM_IME_COMPOSITION
  CS_INSERTCHAR                   = 02000H;
  CS_NOMOVECARET                  = 04000H;

// bits of fdwInit of INPUTCONTEXT
// IME version constants
  IMEVER_0310                     = 00003000AH;
  IMEVER_0400                     = 000040000H;

// IME property bits
  IME_PROP_AT_CARET               = 000010000H;
  IME_PROP_SPECIAL_UI             = 000020000H;
  IME_PROP_CANDLIST_START_FROM_1  = 000040000H;
  IME_PROP_UNICODE                = 000080000H;
  IME_PROP_COMPLETE_ON_UNSELECT   = 000100000H;

// IME UICapability bits
  UI_CAP_2700                     = 000000001H;
  UI_CAP_ROT90                    = 000000002H;
  UI_CAP_ROTANY                   = 000000004H;

// ImmSetCompositionString Capability bits
  SCS_CAP_COMPSTR                 = 000000001H;
  SCS_CAP_MAKEREAD                = 000000002H;
  SCS_CAP_SETRECONVERTSTRING      = 000000004H;

// IME WM_IME_SELECT inheritance Capability bits
  SELECT_CAP_CONVERSION           = 000000001H;
  SELECT_CAP_SENTENCE             = 000000002H;

// ID for deIndex of ImmGetGuideLine
  GGL_LEVEL                       = 000000001H;
  GGL_INDEX                       = 000000002H;
  GGL_STRING                      = 000000003H;
  GGL_PRIVATE                     = 000000004H;

// ID for dwLevel of GUIDELINE Structure
  GL_LEVEL_NOGUIDELINE            = 000000000H;
  GL_LEVEL_FATAL                  = 000000001H;
  GL_LEVEL_ERROR                  = 000000002H;
  GL_LEVEL_WARNING                = 000000003H;
  GL_LEVEL_INFORMATION            = 000000004H;

// ID for dwIndex of GUIDELINE Structure
  GL_ID_UNKNOWN                   = 000000000H;
  GL_ID_NOMODULE                  = 000000001H;
  GL_ID_NODICTIONARY              = 000000010H;
  GL_ID_CANNOTSAVE                = 000000011H;
  GL_ID_NOCONVERT                 = 000000020H;
  GL_ID_TYPINGERROR               = 000000021H;
  GL_ID_TOOMANYSTROKE             = 000000022H;
  GL_ID_READINGCONFLICT           = 000000023H;
  GL_ID_INPUTREADING              = 000000024H;
  GL_ID_INPUTRADICAL              = 000000025H;
  GL_ID_INPUTCODE                 = 000000026H;
  GL_ID_INPUTSYMBOL               = 000000027H;
  GL_ID_CHOOSECANDIDATE           = 000000028H;
  GL_ID_REVERSECONVERSION         = 000000029H;
  GL_ID_PRIVATE_FIRST             = 000008000H;
  GL_ID_PRIVATE_LAST              = 00000FFFFH;

// ID for dwIndex of ImmGetProperty
  IGP_GETIMEVERSION               = windows.DWORD(-4);
  IGP_PROPERTY                    = 000000004H;
  IGP_CONVERSION                  = 000000008H;
  IGP_SENTENCE                    = 00000000CH;
  IGP_UI                          = 000000010H;
  IGP_SETCOMPSTR                  = 000000014H;
  IGP_SELECT                      = 000000018H;

// dwIndex for ImmSetCompositionString API
  SCS_SETSTR                      = GCS_COMPREADSTR OR GCS_COMPSTR;
  SCS_CHANGEATTR                  = GCS_COMPREADATTR OR GCS_COMPATTR;
  SCS_CHANGECLAUSE                = GCS_COMPREADCLAUSE OR GCS_COMPCLAUSE;
  SCS_SETRECONVERTSTRING          = 000010000H;
  SCS_QUERYRECONVERTSTRING        = 000020000H;

// attribute for COMPOSITIONSTRING Structure
  ATTR_INPUT                      = 000H;
  ATTR_TARGET_CONVERTED           = 001H;
  ATTR_CONVERTED                  = 002H;
  ATTR_TARGET_NOTCONVERTED        = 003H;
  ATTR_INPUT_ERROR                = 004H;
  ATTR_FIXEDCONVERTED             = 005H;

// bit field for IMC_SETCOMPOSITIONWINDOW, IMC_SETCANDIDATEWINDOW
  CFS_DEFAULT                     = 00000H;
  CFS_RECT                        = 00001H;
  CFS_POINT                       = 00002H;
  CFS_FORCE_POSITION              = 00020H;
  CFS_CANDIDATEPOS                = 00040H;
  CFS_EXCLUDE                     = 00080H;

// conversion direction for ImmGetConversionList
  GCL_CONVERSION                  = 00001H;
  GCL_REVERSECONVERSION           = 00002H;
  GCL_REVERSE_LENGTH              = 00003H;

// bit field for conversion mode
  IME_CMODE_ALPHANUMERIC          = 00000H;
  IME_CMODE_NATIVE                = 00001H;
  IME_CMODE_CHINESE               = IME_CMODE_NATIVE;
