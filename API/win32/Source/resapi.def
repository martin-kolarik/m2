TYPE
  RESID           = windows.PVOID;

//
// Define a RESOURCE_HANDLE
//

TYPE
  RESOURCE_HANDLE = windows.HANDLE;

//
// Define the Resource Status structure.
//

  
  RESOURCE_STATUS  = RECORD
                       ResourceState : clusapi.CLUSTER_RESOURCE_STATE;
                       CheckPoint    : windows.DWORD;
                       WaitHint      : windows.DWORD;
                       EventHandle   : windows.HANDLE;
                     END;
  PRESOURCE_STATUS = POINTER TO RESOURCE_STATUS;

(*# save, call( macro => on ) *)
PROCEDURE ResUtilInitializeResourceStatus( _resource_status_ : PRESOURCE_STATUS );
(*# restore *)

//
// Define Resource DLL callback method for updating the state of a resource.
//

TYPE
  PSET_RESOURCE_STATUS_ROUTINE = PROCEDURE( RESOURCE_HANDLE, PRESOURCE_STATUS );

//
// Define Resource DLL callback method for notifying that a quorum
// resource DLL failed to hold the quorum resource.
//
  PQUORUM_RESOURCE_LOST = PROCEDURE( RESOURCE_HANDLE );

//
// Define Resource DLL callback method for logging events.
//
// typedef enum LOG_LEVEL {
//    LOG_INFORMATION,
//    LOG_WARNING,
//    LOG_ERROR,
//    LOG_SEVERE
// } LOG_LEVEL, *PLOG_LEVEL;
CONST
  LOG_INFORMATION = 0;
  LOG_WARNING     = 0;
  LOG_ERROR       = 0;
  LOG_SEVERE      = 0;

TYPE
  LOG_LEVEL = windows.DWORD;

  PLOG_EVENT_ROUTINE = PROCEDURE( RESOURCE_HANDLE, LOG_LEVEL, windows.PCWSTR );

  POPEN_ROUTINE = PROCEDURE( windows.PCWSTR, winreg.HKEY, RESOURCE_HANDLE ) : RESID;

  PCLOSE_ROUTINE = PROCEDURE( RESID );

  PONLINE_ROUTINE = PROCEDURE( RESID, windows.PHANDLE ) : windows.DWORD;

  POFFLINE_ROUTINE = PROCEDURE( RESID ) : windows.DWORD;

  PTERMINATE_ROUTINE = PROCEDURE( RESID );

  PIS_ALIVE_ROUTINE = PROCEDURE( RESID ) : windows.BOOL;

  PLOOKS_ALIVE_ROUTINE = PROCEDURE( RESID ) : windows.BOOL;

  PARBITRATE_ROUTINE = PROCEDURE( RESID, PQUORUM_RESOURCE_LOST ) : windows.DWORD;

  PRELEASE_ROUTINE = PROCEDURE( RESID ) : windows.DWORD;

  PRESOURCE_CONTROL_ROUTINE = PROCEDURE( 
    RESID, windows.DWORD, windows.PVOID,windows.DWORD,
    windows.PVOID, windows.DWORD, windows.PDWORD ) : windows.DWORD;

  PRESOURCE_TYPE_CONTROL_ROUTINE = PROCEDURE( 
    windows.PCWSTR, windows.DWORD, windows.PVOID, windows.DWORD, 
    windows.PVOID, windows.DWORD,windows.PDWORD ) : windows.DWORD;

//***************************************************************
//
// Define the Function Table Format
//
//***************************************************************

//
// Version 1 Resource DLL Interface definition
//
  CLRES_V1_FUNCTIONS  = RECORD
                          Open                : POPEN_ROUTINE;
                          Close               : PCLOSE_ROUTINE;
                          Online              : PONLINE_ROUTINE;
                          Offline             : POFFLINE_ROUTINE;
                          Terminate           : PTERMINATE_ROUTINE;
                          LooksAlive          : PLOOKS_ALIVE_ROUTINE;
                          IsAlive             : PIS_ALIVE_ROUTINE;
                          Arbitrate           : PARBITRATE_ROUTINE;
                          Release             : PRELEASE_ROUTINE;
                          ResourceControl     : PRESOURCE_CONTROL_ROUTINE;
                          ResourceTypeControl : PRESOURCE_TYPE_CONTROL_ROUTINE;
                        END; 
  PCLRES_V1_FUNCTIONS = POINTER TO CLRES_V1_FUNCTIONS;

CONST
  CLRES_V1_FUNCTION_SIZE = SIZE( CLRES_V1_FUNCTIONS );

TYPE

//
// Resource DLL Function Table definition
//
  CLRES_FUNCTION_TABLE  = RECORD
                            TableSize : windows.DWORD;
                            Version   : windows.DWORD;
                            CASE : BOOLEAN OF
                            | FALSE : V1Functions : CLRES_V1_FUNCTIONS;
                            | TRUE :
                            END;
                          END;
  PCLRES_FUNCTION_TABLE = POINTER TO CLRES_FUNCTION_TABLE;

//
// Define the Resource DLL Startup routine. This is the only routine
// that should be exported from a resource DLL.
//

//
// Calculate the byte offset of a field in a structure of type type.
//

// !! not converted to Modula-2
// #ifndef FIELD_OFFSET
// #define FIELD_OFFSET(type, field)    ((LONG)&(((type *)0)->field))
// #endif

//
// Property list structures and functions
//
  RESUTIL_PROPERTY_ITEM  = RECORD
                             Name    : windows.PWSTR; // Property name
                             KeyName : windows.PWSTR; // Name of value in cluster database
                             Format  : windows.DWORD; // Format: REG_SZ, REG_DWORD, etc.
                             Default : windows.DWORD; // Default value
                             Minimum : windows.DWORD; // Minimum value
                             Maximum : windows.DWORD; // Maximum value
                             Flags   : windows.DWORD; // Flags for this item
                             Offset  : windows.DWORD; // Byte offset to value in parameter block
                                                      // Assumes MULTI_SZ and BINARY parameters
                                                      // are PWSTRs followed by DWORDs for length
                           END;      
  PRESUTIL_PROPERTY_ITEM = POINTER TO RESUTIL_PROPERTY_ITEM;

CONST
  RESUTIL_PROPITEM_READ_ONLY = 000000001H;  // Property is read-only
  RESUTIL_PROPITEM_REQUIRED  = 000000002H;  // Property is required
  RESUTIL_PROPITEM_SIGNED    = 000000004H;  // Numeric property is signed (defaults to unsigned)

TYPE
  PSTARTUP_ROUTINE = PROCEDURE( windows.PCWSTR, windows.DWORD, windows.DWORD,
    PSET_RESOURCE_STATUS_ROUTINE, PLOG_EVENT_ROUTINE, PCLRES_FUNCTION_TABLE ) : windows.DWORD;

//
// Define layout of shared memory used for tracking Resource Monitor state.
//
// typedef enum RESOURCE_MONITOR_STATE {
//     RmonInitializing,
//     RmonIdle,
//     RmonStartingResource,
//     RmonInitializingResource,
//     RmonOnlineResource,
//     RmonOfflineResource,
//     RmonShutdownResource,
//     RmonDeletingResource,
//     RmonIsAlivePoll,
//     RmonLooksAlivePoll,
//     RmonArbitrateResource,
//     RmonReleaseResource,
//     RmonResourceControl,
//     RmonResourceTypeControl
// } RESOURCE_MONITOR_STATE;
  RESOURCE_MONITOR_STATE = windows.DWORD;

CONST
  RmonInitializing         = 0;
  RmonIdle                 = 1;
  RmonStartingResource     = 2;
  RmonInitializingResource = 3;
  RmonOnlineResource       = 4;
  RmonOfflineResource      = 5;
  RmonShutdownResource     = 6;
  RmonDeletingResource     = 7;
  RmonIsAlivePoll          = 8;
  RmonLooksAlivePoll       = 9;
  RmonArbitrateResource    = 10;
  RmonReleaseResource      = 11;
  RmonResourceControl      = 12;
  RmonResourceTypeControl  = 13;

TYPE
  MONITOR_STATE  = RECORD
                     LastUpdate     : windows.LARGE_INTEGER;
                     State          : RESOURCE_MONITOR_STATE;
                     ActiveResource : windows.HANDLE;
                     ResmonStop     : windows.BOOL;
                   END;
  PMONITOR_STATE = POINTER TO MONITOR_STATE;

//
// Resource Utility Routines
//

PROCEDURE ResUtilStartResourceService( ServiceName   : windows.PCTSTR;
                                       ServiceHandle : windows.PHANDLE ) : windows.DWORD;

PROCEDURE ResUtilVerifyResourceService( ServiceName : windows.PCTSTR ) : windows.DWORD;

PROCEDURE ResUtilStopResourceService( ServiceName : windows.PCTSTR ) : windows.DWORD;

PROCEDURE ResUtilVerifyService( ServiceHandle : windows.HANDLE ) : windows.DWORD;

PROCEDURE ResUtilStopService( ServiceHandle : windows.HANDLE ) : windows.DWORD;

PROCEDURE ResUtilIsPathValid( Path : windows.PCWSTR ) : windows.BOOL;

PROCEDURE ResUtilEnumProperties( CONST PropertyTable : PRESUTIL_PROPERTY_ITEM;
                                       OutBuffer     : windows.PWSTR;
                                       OutBufferSize : windows.DWORD;
                                       BytesReturned : windows.PDWORD;
                                       Required      : windows.PDWORD ) : windows.DWORD;

PROCEDURE ResUtilEnumPrivateProperties( ClusterKey    : windows.PVOID;
                                        OutBuffer     : windows.PWSTR;
                                        OutBufferSize : windows.DWORD;
                                        BytesReturned : windows.PDWORD;
                                        Required      : windows.PDWORD ) : windows.DWORD;

PROCEDURE ResUtilGetProperties(       ClusterKey    : windows.PDWORD;
                                CONST PropertyTable : PRESUTIL_PROPERTY_ITEM;
                                      OutBuffer     : windows.PVOID;
                                      OutBufferSize : windows.DWORD;
                                      BytesReturned : windows.PDWORD;
                                      Required      : windows.PDWORD ) : windows.DWORD;

PROCEDURE ResUtilGetAllProperties(       ClusterKey    : windows.PDWORD;
                                   CONST PropertyTable : PRESUTIL_PROPERTY_ITEM;
                                         OutBuffer     : windows.PVOID;
                                         OutBufferSize : windows.DWORD;
                                         BytesReturned : windows.PDWORD;
                                         Required      : windows.PDWORD ) : windows.DWORD;

PROCEDURE ResUtilGetPrivateProperties( ClusterKey    : windows.PVOID;
                                       OutBuffer     : windows.PVOID;
                                       OutBufferSize : windows.DWORD;
                                       BytesReturned : windows.PDWORD;
                                       Required      : windows.PDWORD ) : windows.DWORD;

PROCEDURE ResUtilGetPropertySize(       ClusterKey : windows.PVOID;
                                  CONST Property   : PRESUTIL_PROPERTY_ITEM;
                                        BufferSize : windows.PDWORD;
                                        ItemCount  : windows.PDWORD ) : windows.DWORD;

PROCEDURE ResUtilGetProperty(       ClusterKey    : windows.PVOID;
                              CONST Property      : PRESUTIL_PROPERTY_ITEM;
                                VAR OutBuffer     : ADDRESS;
                                    OutBufferSize : windows.PDWORD ) : windows.DWORD;

