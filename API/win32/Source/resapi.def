//
// Common worker thread routines that allow a pending operation to
// be cancelled with CORRECT synchronization.
//
TYPE
  CLUS_WORKER  = RECORD
                   hThread   : windows.HANDLE;
                   Terminate : windows.BOOL;
                 END;
  PCLUS_WORKER = POINTER TO CLUS_WORKER;

  PWORKER_START_ROUTINE = PROCEDURE ( PCLUS_WORKER, windows.PVOID ) : windows.DWORD;

PROCEDURE ClusWorkerCreate( Worker         : PCLUS_WORKER;
                            lpStartAddress : PWORKER_START_ROUTINE;
                            lpParameter    : windows.PVOID ) : windows.DWORD;

PROCEDURE ClusWorkerCheckTerminate( Worker : PCLUS_WORKER ) : windows.BOOL;

PROCEDURE ClusWorkerTerminate( Worker : PCLUS_WORKER );


//Define enumerate resource callback function. This gets called for each resource enumerated
//by ResUtilEnumResources
TYPE
  LPRESOURCE_CALLBACK = PROCEDURE( clusapi.HRESOURCE, clusapi.HRESOURCE, windows.PVOID ) : windows.DWORD;

PROCEDURE ResUtilResourcesEqual( hSelf     : clusapi.HRESOURCE;
                                 hResource : clusapi.HRESOURCE ) : windows.BOOL;


PROCEDURE ResUtilResourceTypesEqual( lpszResourceTypeName : windows.PCWSTR;
                                     hResource            : clusapi.HRESOURCE ) : windows.BOOL;

PROCEDURE ResUtilEnumResources( hSelf           : clusapi.HRESOURCE;
                                lpszResTypeName : windows.PCWSTR;
                                pResCallBack    : LPRESOURCE_CALLBACK;
                                pParameter      : windows.PVOID ) : windows.DWORD;

PROCEDURE ResUtilGetResourceDependency( hSelf            : windows.HANDLE;
                                        lpszResourceType : windows.PCWSTR ) : clusapi.HRESOURCE;

PROCEDURE ResUtilGetResourceNameDependency( lpszResourceName : windows.PCWSTR;
                                            lpszResourceType : windows.PCWSTR ) : clusapi.HRESOURCE;

END resapi.