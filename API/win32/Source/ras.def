DEFINITION MODULE ras;

(*==============================================================

       Remote Access Services API for Modula-2

       32-bit version for M2CPP Modula-2 to C++ compiler

       Copyright (c) 1999 Moravian Instruments, Inc.

==============================================================*)

(*============================================================*)
(* Includes:                                                  *)
(*           ras.h                                            *)
(*           raserror.h                                       *)
(*           lmcons.h     (only a part)                       *)
(*============================================================*)


(* Copyright (c) 1992-1996, Microsoft Corporation, all rights reserved
**
** ras.h
** Remote Access external API
** Public header for external API clients
**
** WINVER values in this file:
**      WINVER < 0x400 = Windows NT 3.5, Windows NT 3.51
**      WINVER = 0x400 = Windows 95, Windows NT SUR (default)
**      WINVER > 0x400 = Windows NT SUR enhancements
*)

// !!! We use all structures only for version 400H !!!

(*# name(   prefix          => c ) *)

(*# module( header          => off,
            init_code       => off ) *)

(*# call(   o_a_size        => off,
            o_a_copy        => off,
            c_arrays        => on,
            result_optional => on,
            prefix=>stdcall ) *)


IMPORT
  windows;

FROM windows IMPORT
  BOOL, DWORD, HANDLE, HWND, LONG, PBOOL, PBYTE, PDWORD, 
  PTSTR, PCTSTR, UINT, PWSTR, PCWSTR;

(*# option( pack => 4 ) *)

CONST

// These are from lmcons.h

  DNLEN                 = 15;  // Maximum domain name length
  UNLEN                 = 256; // Maximum user name length
  PWLEN                 = 256; // Maximum password length
  NETBIOS_NAME_LEN      = 16;  // NetBIOS net name (bytes)


  RAS_MaxDeviceType     = 16;
  RAS_MaxPhoneNumber    = 128;
  RAS_MaxIpAddress      = 15;
  RAS_MaxIpxAddress     = 21;

  RAS_MaxEntryName      = 256;                 // 20 in WinCE
  RAS_MaxDeviceName     = 128;                 // 32 in WinCE
  RAS_MaxCallbackNumber = RAS_MaxPhoneNumber;  // 48 in WinCE

  RAS_MaxAreaCode       = 10;
  RAS_MaxPadType        = 32;
  RAS_MaxX25Address     = 200;
  RAS_MaxFacilities     = 200;
  RAS_MaxUserData       = 200;

TYPE
  HRASCONN  = windows.HANDLE;
  PHRASCONN = POINTER TO HRASCONN;

// Identifies an active RAS connection.  (See RasEnumConnections)

(*# data( macro => on ) *)
  RASCONN = RECORD
    dwSize       : DWORD;
    hrasconn     : HRASCONN;
    szEntryName  : ARRAY[ 0..RAS_MaxEntryName ] OF TCHAR;
// WINVER >= 400H 
    szDeviceType : ARRAY[ 0..RAS_MaxDeviceType ] OF TCHAR;
    szDeviceName : ARRAY[ 0..RAS_MaxDeviceName ] OF TCHAR;
// WINVER >= 401H
//    szPhonebook  : ARRAY[ 0..windows.MAX_PATH - 1 ] OF TCHAR;
//    dwSubEntry   : DWORD;
  END;
(*# data( macro => off ) *)

  PRASCONN = POINTER TO RASCONN;

CONST

// Enumerates intermediate states to a connection.  (See RasDial)

  RASCS_PAUSED = 1000H;
  RASCS_DONE   = 2000H;

TYPE
  RASCONNSTATE = INTEGER;

CONST
  RASCS_OpenPort            = 0;
  RASCS_PortOpened          = 1;
  RASCS_ConnectDevice       = 2;
  RASCS_DeviceConnected     = 3;
  RASCS_AllDevicesConnected = 4;
  RASCS_Authenticate        = 5;
  RASCS_AuthNotify          = 6;
  RASCS_AuthRetry           = 7;
  RASCS_AuthCallback        = 8;
  RASCS_AuthChangePassword  = 9;
  RASCS_AuthProject         = 10;
  RASCS_AuthLinkSpeed       = 11;
  RASCS_AuthAck             = 12;
  RASCS_ReAuthenticate      = 13;
  RASCS_Authenticated       = 14;
  RASCS_PrepareForCallback  = 15;
  RASCS_WaitForModemReset   = 16;
  RASCS_WaitForCallback     = 17;
  RASCS_Projected           = 18;
  RASCS_StartAuthentication = 19;
  RASCS_CallbackComplete    = 20;
  RASCS_LogonNetwork        = 21;

  RASCS_Interactive         = RASCS_PAUSED;
  RASCS_RetryAuthentication = RASCS_PAUSED + 1;
  RASCS_CallbackSetByCaller = RASCS_PAUSED + 2;
  RASCS_PasswordExpired     = RASCS_PAUSED + 3;

  RASCS_Connected           = RASCS_DONE;
  RASCS_Disconnected        = RASCS_DONE + 1;

TYPE
  PRASCONNSTATE = POINTER TO RASCONNSTATE;

TYPE

// Describes the status of a RAS connection.  (See RasConnectionStatus)

(*# data( macro => on ) *)
  RASCONNSTATUS = RECORD
    dwSize       : DWORD;
    rasconnstate : RASCONNSTATE;
    dwError      : DWORD;
    szDeviceType : ARRAY[ 0..RAS_MaxDeviceType ] OF TCHAR;
    szDeviceName : ARRAY[ 0..RAS_MaxDeviceName ] OF TCHAR;
// WINVER >= 401H
//    swPhoneNumber: ARRAY[ 0..RAS_MaxPhoneNumber ] OF TCHAR;
  END;
(*# data( macro => off ) *)

  PRASCONNSTATUS = POINTER TO RASCONNSTATUS;


TYPE
// Describes connection establishment parameters.  (See RasDial)

(*# data( macro => on ) *)
  RASDIALPARAMS = RECORD
    dwSize           : DWORD;
    szEntryName      : ARRAY[ 0..RAS_MaxEntryName ] OF TCHAR;
    szPhoneNumber    : ARRAY[ 0..RAS_MaxPhoneNumber ] OF TCHAR;
    szCallbackNumber : ARRAY[ 0..RAS_MaxCallbackNumber ] OF TCHAR;
    szUserName       : ARRAY[ 0..UNLEN ] OF TCHAR;
    szPassword       : ARRAY[ 0..PWLEN ] OF TCHAR;
    szDomain         : ARRAY[ 0..DNLEN ] OF TCHAR;
// WINVER >= 401H
//    dwSubEntry       : DWORD;
//    dwCallbackId     : DWORD;
  END;
(*# data( macro => off ) *)

  PRASDIALPARAMS = POINTER TO RASDIALPARAMS;


TYPE
// Describes extended connection establishment options.  (See RasDial)

(*# data( macro => on ) *)
  RASDIALEXTENSIONS = RECORD
    dwSize     : DWORD;
    dwfOptions : DWORD;
    hwndParent : HWND;
    reserved   : DWORD;
  END;
(*# data( macro => off ) *)

  PRASDIALEXTENSIONS = POINTER TO RASDIALEXTENSIONS;

CONST

// 'dwfOptions' bit flags.

  RDEOPT_UsePrefixSuffix           = 00000001H;
  RDEOPT_PausedStates              = 00000002H;
  RDEOPT_IgnoreModemSpeaker        = 00000004H;
  RDEOPT_SetModemSpeaker           = 00000008H;
  RDEOPT_IgnoreSoftwareCompression = 00000010H;
  RDEOPT_SetSoftwareCompression    = 00000020H;
  RDEOPT_DisableConnectedUI        = 00000040H;
  RDEOPT_DisableReconnectUI        = 00000080H;
  RDEOPT_DisableReconnect          = 00000100H;
  RDEOPT_NoUser                    = 00000200H;
  RDEOPT_PauseOnScript             = 00000400H;


TYPE

// Describes an enumerated RAS phone book entry name.  (See RasEntryEnum)

(*# data( macro => on ) *)
  RASENTRYNAME = RECORD
    dwSize      : DWORD;
    szEntryName : ARRAY[ 0..RAS_MaxEntryName ] OF TCHAR;
  END;

  PRASENTRYNAME = POINTER TO RASENTRYNAME;
(*# data( macro => off ) *)



// Protocol code to projection data structure mapping.

//  RASPROJECTION = INTEGER;
//  PRASPROJECTION = POINTER TO RASPROJECTION;
//
//CONST
//  RASP_Amb    = 10000H;
//  RASP_PppNbf = 0803FH;
//  RASP_PppIpx = 0802BH;
//  RASP_PppIp  = 08021H;
//  RASP_PppLcp = 0C021H;
//  RASP_Slip   = 20000H;

TYPE
(*# data( macro => on ) *)
  RASPROJECTION = ( RASP_Amb, 
                    RASP_PppNbf, 
                    RASP_PppIpx,
                    RASP_PppIp,
                    RASP_PppLcp,     // not in WinCE
                    RASP_Slip );     // not in WinCE
(*# data( macro => off ) *)

  PRASPROJECTION = POINTER TO RASPROJECTION;

TYPE

// Describes the result of a RAS AMB (Authentication Message Block)
// projection.  This protocol is used with NT 3.1 and OS/2 1.3 downlevel
// RAS servers.

(*# data( macro => on ) *)
  RASAMB = RECORD
    dwSize         : DWORD;
    dwError        : DWORD;
    szNetBiosError : ARRAY[ 0..NETBIOS_NAME_LEN ] OF TCHAR;
    bLana          : BYTE;
  END;
(*# data( macro => off ) *)

  PRASAMB = POINTER TO RASAMB;


// Describes the result of a PPP NBF (NetBEUI) projection.

(*# data( macro => on ) *)
  RASPPPNBF = RECORD
    dwSize            : DWORD;
    dwError           : DWORD;
    dwNetBiosError    : DWORD;
    szNetBiosError    : ARRAY[ 0..NETBIOS_NAME_LEN ] OF TCHAR;
    szWorkstationName : ARRAY[ 0..NETBIOS_NAME_LEN ] OF TCHAR;
    bLana             : BYTE;
  END;
(*# data( macro => off ) *)

  PRASPPPNBF = POINTER TO RASPPPNBF;

// Describes the results of a PPP IPX (Internetwork Packet Exchange)
// projection.

(*# data( macro => on ) *)
  RASPPPIPX = RECORD
    dwSize       : DWORD;
    dwError      : DWORD;
    szIpxAddress : ARRAY[ 0..RAS_MaxIpxAddress ] OF TCHAR;
  END;
(*# data( macro => off ) *)

  PRASPPPIPX = POINTER TO RASPPPIPX;


// Describes the results of a PPP IP (Internet) projection.

(*# data( macro => on ) *)
  RASPPPIP = RECORD
    dwSize            : DWORD;
    dwError           : DWORD;
    szIpAddress       : ARRAY[ 0..RAS_MaxIpAddress ] OF TCHAR;
    szServerIpAddress : ARRAY[ 0..RAS_MaxIpAddress ] OF TCHAR;
  END;
(*# data( macro => off ) *)

  PRASPPPIP = POINTER TO RASPPPIP;


// Describes results of a GET_WINS/DNS I/O control. If
// the requested address has been negotiated the boolean
// valid is TRUE and the IpAddress contains the address of
// the requested server.  If Valid is false IpAddress is
// zero.

(*# data( macro => on ) *)
  RASPPPADDR = RECORD
    dwSize    : DWORD;
    dwError   : DWORD;
    Valid     : BOOL;
    IpAddress : DWORD;
  END;
(*# data( macro => off ) *)



// Describes the results of a PPP LCP/multi-link negotiation.

(*# data( macro => on ) *)
  RASPPPLCP = RECORD
    dwSize   : DWORD;
    fBundled : BOOL;
  END;
(*# data( macro => off ) *)

  PRASPPPLCP = POINTER TO RASPPPLCP;


// Describes the results of a SLIP (Serial Line IP) projection.

(*# data( macro => on ) *)
  RASSLIP = RECORD
    dwSize      : DWORD;
    dwError     : DWORD;
    szIpAddress : ARRAY[ 0..RAS_MaxIpAddress ] OF TCHAR;
  END;
(*# data( macro => off ) *)

  PRASSLIP = POINTER TO RASSLIP;


// RAS Control Structures
//
// Control Request Enumeration

TYPE
  RasCntlEnum_t = INTEGER;

CONST
  RASCNTL_SET_DEBUG           = 0;  // set debug control params
  RASCNTL_LOCK_STATUS         = 1;  // get session's lock status
  RASCNTL_PRINT_CS            = 2;  // print cs info
  RASCNTL_STATISTICS          = 3;  // Get statistics
  RASCNTL_ENUMDEV             = 4;  // Enum Devices
  RASCNTL_GETPROJINFO         = 5;  // RasGetProjectionInfoW
  RASCNTL_GETDISPPHONE        = 6;  // RasGetDispPhoneNumW
  RASCNTL_DEVCONFIGDIALOGEDIT = 7;  // RasDevConfigDialogEditW
  // Add others here
(*# data( macro => off ) *)


TYPE
(*# data( macro => on ) *)
  RASCNTL_DEVCFGDLGED = RECORD
    szDeviceName : ARRAY[ 0..RAS_MaxDeviceName ] OF WCHAR;
    szDeviceType : ARRAY[ 0..RAS_MaxDeviceType ] OF WCHAR;
    hWndOwner    : HWND;
    dwSize       : DWORD;
    DataBuf      : ARRAY[ 0..0 ] OF BYTE;
  END;
(*# data( macro => off ) *)

  PRASCNTL_DEVCFGDLGED = POINTER TO RASCNTL_DEVCFGDLGED;




CONST

// If using RasDial message notifications, get the notification message code
// by passing this string to the RegisterWindowMessageA() API.
// WM_RASDIALEVENT is used only if a unique message cannot be registered.

(*# data( macro => on ) *)
  RASDIALEVENT    = C'RasDialEvent';
(*# data( macro => off ) *)
  WM_RASDIALEVENT = 0CCCDH;


// Prototypes for caller's RasDial callback handler.  Arguments are the
// message ID (currently always WM_RASDIALEVENT), the current RASCONNSTATE and
// the error that has occurred (or 0 if none).  Extended arguments are the
// handle of the RAS connection and an extended error code.
//
// For RASDIALFUNC2, subsequent callback notifications for all
// subentries can be cancelled by returning FALSE.
  
(* /*
typedef VOID (WINAPI *RASDIALFUNC)( UINT, RASCONNSTATE, DWORD );
typedef VOID (WINAPI *RASDIALFUNC1)( HRASCONN, UINT, RASCONNSTATE, DWORD, DWORD );
typedef DWORD (WINAPI *RASDIALFUNC2)( DWORD, DWORD, HRASCONN, UINT, RASCONNSTATE, DWORD, DWORD );

For Modula2: Just define the callback as:
*/ *)

TYPE
  RASDIALFUNC  = PROCEDURE( UINT, RASCONNSTATE, DWORD );
  RASDIALFUNC1 = PROCEDURE( HRASCONN, UINT, RASCONNSTATE, DWORD, DWORD );
  RASDIALFUNC2 = PROCEDURE( DWORD, DWORD, HRASCONN, UINT, RASCONNSTATE, DWORD, DWORD ) : DWORD;


TYPE
(*# data( macro => on ) *)
  RAS_STATS = RECORD
    dwSize                : DWORD;
    dwBytesXmited         : DWORD;
    dwBytesRcved          : DWORD;
    dwFramesXmited        : DWORD;
    dwFramesRcved         : DWORD;
    dwCrcErr              : DWORD;
    dwTimeoutErr          : DWORD;
    dwAlignmentErr        : DWORD;
    dwHardwareOverrunErr  : DWORD;
    dwFramingErr          : DWORD;
    dwBufferOverrunErr    : DWORD;
    dwCompressionRatioIn  : DWORD;
    dwCompressionRatioOut : DWORD;
    dwBps                 : DWORD;
    dwConnectDuration     : DWORD;
  END;
(*# data( macro => off ) *)

  PRAS_STATS = POINTER TO RAS_STATS;


TYPE

// Information describing a RAS-capable device.

(*# data( macro => on ) *)
  RASDEVINFO = RECORD
    dwSize       : DWORD;
    szDeviceType : ARRAY[ 0..RAS_MaxDeviceType ] OF TCHAR;
    szDeviceName : ARRAY[ 0..RAS_MaxDeviceName ] OF TCHAR;
  END;
(*# data( macro => off ) *)

  PRASDEVINFO = POINTER TO RASDEVINFO;


// RAS Country Information (currently retreieved from TAPI).

  PRASCTRYINFO = POINTER TO RASCTRYINFO;
(*# data( macro => on ) *)
  RASCTRYINFO = RECORD
    dwSize              : DWORD;
    dwCountryID         : DWORD;
    dwNextCountryID     : DWORD;
    dwCountryCode       : DWORD;
    dwCountryNameOffset : DWORD;
  END;
(*# data( macro => off ) *)

// There is currently no difference between
// RASCTRYINFOA and RASCTRYINFOW.  This may
// change in the future.

(* /*
#define RASCTRYINFOW   RASCTRYINFO
#define RASCTRYINFOA   RASCTRYINFO

#define LPRASCTRYINFOW RASCTRYINFOW*
#define LPRASCTRYINFOA RASCTRYINFOW*
#define LPRASCTRYINFO  RASCTRYINFO*
*/ *)

// A RAS IP Address.

//  PRASIPADDR = POINTER TO RASIPADDR;
(*# data( macro => on ) *)
  RASIPADDR = RECORD
    a : BYTE;
    b : BYTE;
    c : BYTE;
    d : BYTE;
  END;
(*# data( macro => off ) *)


// A RAS phonebook entry.

(*# data( macro => on ) *)
  RASENTRY = RECORD
    dwSize             : DWORD;
    dwfOptions         : DWORD;
    //
    // Location/phone number.
    //
    dwCountryID        : DWORD;
    dwCountryCode      : DWORD;
    szAreaCode         : ARRAY[ 0.. RAS_MaxAreaCode ] OF TCHAR;
    szLocalPhoneNumber : ARRAY[ 0..RAS_MaxPhoneNumber ] OF TCHAR;
    dwAlternatesOffset : DWORD;
    //
    // PPP/Ip
    //
    ipaddr             : RASIPADDR;
    ipaddrDns          : RASIPADDR;
    ipaddrDnsAlt       : RASIPADDR;
    ipaddrWins         : RASIPADDR;
    ipaddrWinsAlt      : RASIPADDR;
    //
    // Framing
    //
    dwFrameSize        : DWORD;
    dwfNetProtocols    : DWORD;
    dwFramingProtocol  : DWORD;
    //
    // Scripting
    //
    szScript           : ARRAY[ 0..windows.MAX_PATH - 1 ] OF TCHAR;
    //
    // AutoDial
    //
    szAutodialDll      : ARRAY[ 0..windows.MAX_PATH - 1 ] OF TCHAR;
    szAutodialFunc     : ARRAY[ 0..windows.MAX_PATH - 1 ] OF TCHAR;
    //
    // Device
    //
    szDeviceType       : ARRAY[ 0..RAS_MaxDeviceType ] OF TCHAR;
    szDeviceName       : ARRAY[ 0..RAS_MaxDeviceName ] OF TCHAR;
    //
    // X.25
    //
    szX25PadType       : ARRAY[ 0..RAS_MaxPadType ] OF TCHAR;
    szX25Address       : ARRAY[ 0..RAS_MaxX25Address ] OF TCHAR;
    szX25Facilities    : ARRAY[ 0..RAS_MaxFacilities ] OF TCHAR;
    szX25UserData      : ARRAY[ 0..RAS_MaxUserData ] OF TCHAR;
    dwChannels         : DWORD;
    //
    // Reserved
    //
    dwReserved1        : DWORD;
    dwReserved2        : DWORD;
// WINVER >= 401H
    //
    // Multilink
    //
//    dwSubEntries               : DWORD;
//    dwDialMode                 : DWORD;
//    dwDialExtraPercent         : DWORD;
//    dwDialExtraSampleSeconds   : DWORD;
//    dwHangUpExtraPercent       : DWORD;
//    dwHangUpExtraSampleSeconds : DWORD;
    //
    // Idle timeout
    //
//    dwIdleDisconnectSeconds    : DWORD;
  END;
(*# data( macro => off ) *)

  PRASENTRY = POINTER TO RASENTRY;


CONST

// TRasEntry 'dwfOptions' bit flags.

  RASEO_UseCountryAndAreaCodes = 00000001H;
  RASEO_SpecificIpAddr         = 00000002H;
  RASEO_SpecificNameServers    = 00000004H;
  RASEO_IpHeaderCompression    = 00000008H;
  RASEO_RemoteDefaultGateway   = 00000010H;
  RASEO_DisableLcpExtensions   = 00000020H;
  RASEO_TerminalBeforeDial     = 00000040H;
  RASEO_TerminalAfterDial      = 00000080H;
  RASEO_ModemLights            = 00000100H;
  RASEO_SwCompression          = 00000200H;
  RASEO_RequireEncryptedPw     = 00000400H;
  RASEO_RequireMsEncryptedPw   = 00000800H;
  RASEO_RequireDataEncryption  = 00001000H;
  RASEO_NetworkLogon           = 00002000H;
  RASEO_UseLogonCredentials    = 00004000H;
  RASEO_PromoteAlternates      = 00008000H;
  RASEO_SecureLocalFiles       = 00010000H;
  RASEO_DialAsLocalCall        = 00020000H;

///TRasEntry 'dwfNetProtocols' bit flags. (session negotiated protocols)

  RASNP_Netbeui = 00000001H;  // Negotiate NetBEUI
  RASNP_Ipx     = 00000002H;  // Negotiate IPX
  RASNP_Ip      = 00000004H;  // Negotiate TCP/IP

// TRasEntry 'dwFramingProtocols' (framing protocols used by the server)

  RASFP_Ppp  = 00000001H;     // Point-to-Point Protocol (PPP)
  RASFP_Slip = 00000002H;     // Serial Line Internet Protocol (SLIP)
  RASFP_Ras  = 00000004H;     // Microsoft proprietary protocol

// TRasEntry 'szDeviceType' strings

  RASDT_Direct = 'direct';     // Direct Connect (WINCE Extension)
  RASDT_Modem  = 'modem';      // Modem
  RASDT_Isdn   = 'isdn';       // ISDN
  RASDT_X25    = 'x25';        // X.25
  RASDT_Vpn    = 'vpn';        // PPTP


// Old AutoDial DLL function prototype.
//**
//** This prototype is documented for backward-compatibility
//** purposes only.  It is superceded by the RASADFUNCA
//** and RASADFUNCW definitions below.  DO NOT USE THIS
//** PROTOTYPE IN NEW CODE.  SUPPORT FOR IT MAY BE REMOVED
//** IN FUTURE VERSIONS OF RAS.
(* /*
typedef BOOL (WINAPI *ORASADFUNC)( HWND, LPSTR, DWORD, LPDWORD );
*/ *)

// Flags for RasConnectionNotification().

  RASCN_Connection       = 00000001H;
  RASCN_Disconnection    = 00000002H;
  RASCN_BandwidthAdded   = 00000004H;
  RASCN_BandwidthRemoved = 00000008H;

// TRasEntry 'dwDialMode' values.

  RASEDM_DialAll      = 1;
  RASEDM_DialAsNeeded = 2;

// TRasEntry 'dwIdleDisconnectSeconds' constants.

  RASIDS_Disabled       = 0FFFFFFFFH;
  RASIDS_UseGlobalValue = 0;

TYPE

// AutoDial DLL function parameter block.

(*# data( macro => on ) *)
  RASADPARAMS = RECORD
    dwSize    : DWORD;
    hwndOwner : HWND;
    dwFlags   : DWORD;
    xDlg      : LONG;
    yDlg      : LONG;
  END;
(*# data( macro => off ) *)

  PRASADPARAMS = POINTER TO RASADPARAMS;

CONST

// AutoDial DLL function parameter block 'dwFlags.'

  RASADFLG_PositionDlg = 00000001H;

// Prototype AutoDial DLL function.

(* /*
typedef BOOL (WINAPI *RASADFUNCA)( LPSTR, LPSTR, LPRASADPARAMS, LPDWORD );
typedef BOOL (WINAPI *RASADFUNCW)( LPWSTR, LPWSTR, LPRASADPARAMS, LPDWORD );
*/ *)
TYPE
  RASADFUNC = PROCEDURE( PTSTR, PTSTR, PRASADPARAMS, PDWORD ) : BOOL;

TYPE

// A RAS phone book multilinked sub-entry.

(*# data( macro => on ) *)
  RASSUBENTRY = RECORD
    dwSize   : DWORD;
    dwfFlags : DWORD;
    //
    // Device
    //
    szDeviceType : ARRAY[ 0..RAS_MaxDeviceType ] OF TCHAR;
    szDeviceName : ARRAY[ 0..RAS_MaxDeviceName ] OF TCHAR;
    //
    // Phone numbers
    //
    szLocalPhoneNumber : ARRAY[ 0..RAS_MaxPhoneNumber ] OF TCHAR;
    dwAlternateOffset  : DWORD;
  END;
(*# data( macro => off ) *)

  PRASSUBENTRY = POINTER TO RASSUBENTRY;

// Ras(Get,Set)Credentials structure.  These calls
// supercede Ras(Get,Set)EntryDialParams.

(*# data( macro => on ) *)
  RASCREDENTIALS = RECORD
    dwSize     : DWORD;
    dwMask     : DWORD;
    szUserName : ARRAY[ 0..UNLEN ] OF TCHAR;
    zPassword  : ARRAY[ 0..PWLEN ] OF TCHAR;
    szDomain   : ARRAY[ 0..DNLEN ] OF TCHAR;
  END;
(*# data( macro => off ) *)

  PRASCREDENTIALS = POINTER TO RASCREDENTIALS;

CONST

// TRasCredentials 'dwMask' values.

  RASCM_UserName = 00000001H;
  RASCM_Password = 00000002H;
  RASCM_Domain   = 00000004H;


TYPE

// AutoDial address properties.

(*# data( macro => on ) *)
  RASAUTODIALENTRY = RECORD
    dwSize            : DWORD;
    dwFlags           : DWORD;
    dwDialingLocation : DWORD;
    szEntry           : ARRAY[ 0..RAS_MaxEntryName ] OF TCHAR;
  END;
(*# data( macro => off ) *)

  PRASAUTODIALENTRY = POINTER TO RASAUTODIALENTRY;

CONST

// AutoDial control parameter values for
// Ras(Get,Set)AutodialParam.

  RASADP_DisableConnectionQuery  = 0;
  RASADP_LoginSessionDisable     = 1;
  RASADP_SavedAddressesLimit     = 2;
  RASADP_FailedConnectionTimeout = 3;
  RASADP_ConnectionQueryTimeout  = 4;


(* /*
#ifdef UNDER_CE
*/ *)

// This structure is used by the RnaApp application on WINCE
// to signal when a connection has occured.

TYPE
(*# data( macro => on ) *)
  RNAAPP_INFO = RECORD
	  dwSize       : DWORD;				// The size of this structure
    hWndRNAApp   : DWORD;				// The handle of the RNAApp window
    Context      : DWORD;				// Context value specified on CmdLine
    ErrorCode    : DWORD;				// Last error code
    RasEntryName : ARRAY[ 0..RAS_MaxEntryName ] OF TCHAR;
  END;
(*# data( macro => off ) *)

  PRNAAPP_INFO = POINTER TO RNAAPP_INFO;


CONST
  RNA_RASCMD    = windows.WM_USER + 1;
  RNA_ADDREF    = 1;
  RNA_DELREF    = 2;

(* /*
#endif   // UNDER_CE
*/ *)

(* /*
#include "poppack.h"
*/ *)



// External RAS API function prototypes.


PROCEDURE RasDial( _ : PRASDIALEXTENSIONS;
                   _ : PTSTR;
                   _ : PRASDIALPARAMS;
                   _ : DWORD;
                   _ : ADDRESS;
                   _ : PHRASCONN ) : DWORD;

PROCEDURE RasEnumConnections( _ : PRASCONN;
                              _ : PDWORD;
                              _ : PDWORD ) : DWORD;

PROCEDURE RasEnumEntries( _ : PCTSTR;
                          _ : PCTSTR;
                          _ : PRASENTRYNAME;
                          _ : PDWORD;
                          _ : PDWORD ) : DWORD;

PROCEDURE RasGetConnectStatus( _ : HRASCONN;
                               _ : PRASCONNSTATUS ) : DWORD;

// not in WinCE
PROCEDURE RasGetErrorString( _ : UINT;
                             _ : PTSTR;
                             _ : DWORD ) : DWORD;

PROCEDURE RasHangUp( _ : HRASCONN ) : DWORD;

PROCEDURE RasGetProjectionInfo( _ : HRASCONN;
                                _ : RASPROJECTION;
