DEFINITION MODULE dde;

(*==============================================================

                  DDE Connectivity to Modula-2
       Dynamic Data Exchange structures and definitions

       32-bit version for M2CPP Modula-2 to C++ compiler

      Copyright (c) 1996, 1997 Moravian Instruments, Inc.

==============================================================*)

(*# name(   prefix          => c ) *)

(*# module( header          => off,
            init_code       => off ) *)

(*# call(   o_a_size        => off,
            o_a_copy        => off,
            c_arrays        => on,
            result_optional => on,
            prefix=>stdcall ) *)

(*==============================================================

  History: Created: 09.11.1997
           Build 0: **********

==============================================================*)

(*============================================================*)
(* Windows header:           dde.h                            *)
(*============================================================*)

IMPORT
  windows;

(*// begin_r_dde *)

(*// DDE window messages *)

CONST
  WM_DDE_FIRST        = 03E0H;
  WM_DDE_INITIATE     = WM_DDE_FIRST;
  WM_DDE_TERMINATE    = WM_DDE_FIRST+1;
  WM_DDE_ADVISE	      = WM_DDE_FIRST+2;
  WM_DDE_UNADVISE     = WM_DDE_FIRST+3;
  WM_DDE_ACK          = WM_DDE_FIRST+4;
  WM_DDE_DATA         = WM_DDE_FIRST+5;
  WM_DDE_REQUEST      = WM_DDE_FIRST+6;
  WM_DDE_POKE         = WM_DDE_FIRST+7;
  WM_DDE_EXECUTE      = WM_DDE_FIRST+8;
  WM_DDE_LAST         = WM_DDE_FIRST+8;

(*// end_r_dde *)

TYPE

(*//--------------------------------------------------------------------------
//       DDEACK structure
//
//	Structure of wStatus (LOWORD(lParam)) in WM_DDE_ACK message
//      sent in response to a WM_DDE_DATA, WM_DDE_REQUEST, WM_DDE_POKE,
//      WM_DDE_ADVISE, or WM_DDE_UNADVISE message.
//
      typedef struct {
              unsigned short bAppReturnCode:8,
                       reserved:6,
                       fBusy:1,
		       fAck:1;
      } DDEACK;
//--------------------------------------------------------------------------*)

  DDEACK = RECORD
             bAppReturnCode : BYTE;
             CASE :CARDINAL OF
             | 0: reserved  : BYTE;
             | 1: fBusy     : BYTE;
             | 2: fAck      : BYTE;
             END;
           END;

(*//--------------------------------------------------------------------------
//      DDEADVISE structure
//	WM_DDE_ADVISE parameter structure for hOptions (LOWORD(lParam))
//
      typedef struct {
              unsigned short reserved:14,
                       fDeferUpd:1,
		       fAckReq:1;
	      short     cfFormat;
      } DDEADVISE;
//--------------------------------------------------------------------------*)

  DDEADVISE = RECORD
                CASE :CARDINAL OF
                | 0: reserved   : WORD;
                | 1: fDeferUpd  : BYTE;
                | 2: fAckReq    : BYTE;
                END;
                cfFormat        : WORD;
              END;

(*//--------------------------------------------------------------------------
//      DDEDATA structure
//      WM_DDE_DATA parameter structure for hData (LOWORD(lParam)).
//      The actual size of this structure depends on the size of
//      the Value array.
//
      typedef struct {
	      unsigned short unused:12,
                       fResponse:1,
                       fRelease:1,
                       reserved:1,
                       fAckReq:1;
	      short	 cfFormat;
	      BYTE	 Value[1];
      } DDEDATA;
//--------------------------------------------------------------------------*)

  DDEDATA = RECORD
              CASE :CARDINAL OF
              | 0: unused     : WORD;
              | 1: fResponse  : BYTE;
              | 2: fRelease   : BYTE;
              | 3: reserved   : BYTE;
              | 4: fAckReq    : BYTE;
              END;
              cfFormat        : WORD;
              Value           : ARRAY [0..0] OF BYTE;
            END;

(*//--------------------------------------------------------------------------
//      DDEPOKE structure
// 	WM_DDE_POKE parameter structure for hData (LOWORD(lParam)).
//      The actual size of this structure depends on the size of
//      the Value array.
//
      typedef struct {
	      unsigned short unused:13,  /* Earlier versions of DDE.H incorrectly */
                                         /* 12 unused bits.                       */
		       fRelease:1,
		       fReserved:2;
	      short    cfFormat;
	      BYTE	 Value[1];  /* This member was named rgb[1] in previous */
                                    /* versions of DDE.H                        */

      } DDEPOKE;
//--------------------------------------------------------------------------*)

  DDEPOKE = RECORD
              CASE :CARDINAL OF
              | 0: unused     : WORD;
              | 1: fRelease   : BYTE;
              | 2: fReserved  : BYTE;
              END;
              cfFormat        : WORD;
              Value           : ARRAY [0..0] OF BYTE;
            END;

(*//--------------------------------------------------------------------------
The following typedef's were used in previous versions of the Windows SDK.
They are still valid.  The above typedef's define exactly the same structures
as those below.  The above typedef names are recommended, however, as they
are more meaningful.

Note that the DDEPOKE structure typedef'ed in earlier versions of DDE.H did
not correctly define the bit positions.
//--------------------------------------------------------------------------*)

(*//--------------------------------------------------------------------------
      typedef struct {
              unsigned short unused:13,
                       fRelease:1,
                       fDeferUpd:1,
		       fAckReq:1;
	      short	 cfFormat;
      } DDELN;

      typedef struct {
	      unsigned short unused:12,
                       fAck:1,
                       fRelease:1,
                       fReserved:1,
                       fAckReq:1;
	      short	 cfFormat;
	      BYTE	 rgb[1];   // Value[1]; in Modula-2
      } DDEUP;
//--------------------------------------------------------------------------*)

  DDELN = RECORD
            CASE :CARDINAL OF
            | 0: unused     : WORD;
            | 1: fRelease   : BYTE;
            | 2: fDeferUpd  : BYTE;
            | 3: fAckReq    : BYTE;
            END;
            cfFormat        : WORD;
          END;
  DDEUP = RECORD
            CASE :CARDINAL OF
            | 0: unused     : BYTE;
            | 1: fAck       : BYTE;
            | 2: fRelease   : BYTE;
            | 3: fReserved  : BYTE;
            | 4: fAckReq    : BYTE;
            END;
            cfFormat        : WORD;
            rgb             : ARRAY [0..0] OF BYTE;
          END;

(*
 *// DDE SECURITY
 *)

PROCEDURE DdeSetQualityOfService( hwndClient : windows.HWND;
                                  pqosNew, 
                                  pqosPrev : windows.PSECURITY_QUALITY_OF_SERVICE ) : windows.BOOL;

PROCEDURE ImpersonateDdeClientWindow( hWndClient, hWndServer : windows.HWND ) : windows.BOOL;

(*
 *// DDE message packing APIs
 *)

PROCEDURE PackDDElParam( msg, uiLo, uiHi : windows.UINT ) : windows.LONG;

PROCEDURE UnpackDDElParam( msg    : windows.UINT; 
                           lParam : windows.LONG;
                           puiLo, 
                           puiHi  : windows.PUINT ) : windows.BOOL;

PROCEDURE FreeDDElParam( msg    : windows.UINT;
                         lParam : windows.LONG ) : windows.BOOL;

PROCEDURE ReuseDDElParam( lParam : windows.LONG; 
                          msgIn, msgOut, 
                          uiLo, uiHi : windows.UINT ) : windows.LONG;

END dde.
