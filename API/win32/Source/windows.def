CONST

(* Binary raster ops *)

  R2_BLACK            = 1;   (* 0        *)
  R2_NOTMERGEPEN      = 2;   (* DPon     *)
  R2_MASKNOTPEN       = 3;   (* DPna     *)
  R2_NOTCOPYPEN       = 4;   (* PN       *)
  R2_MASKPENNOT       = 5;   (* PDna     *)
  R2_NOT              = 6;   (* Dn       *)
  R2_XORPEN           = 7;   (* DPx      *)
  R2_NOTMASKPEN       = 8;   (* DPan     *)
  R2_MASKPEN          = 9;   (* DPa      *)
  R2_NOTXORPEN        = 10;  (* DPxn     *)
  R2_NOP              = 11;  (* D        *)
  R2_MERGENOTPEN      = 12;  (* DPno     *)
  R2_COPYPEN          = 13;  (* P        *)
  R2_MERGEPENNOT      = 14;  (* PDno     *)
  R2_MERGEPEN         = 15;  (* DPo      *)
  R2_WHITE            = 16;  (*  1       *)
  R2_LAST             = 16;

(* Ternary raster operations *)

  SRCCOPY             = DWORD( 000CC0020H ); (* dest = source                   *)
  SRCPAINT            = DWORD( 000EE0086H ); (* dest = source OR dest           *)
  SRCAND              = DWORD( 0008800C6H ); (* dest = source AND dest          *)
  SRCINVERT           = DWORD( 000660046H ); (* dest = source XOR dest          *)
  SRCERASE            = DWORD( 000440328H ); (* dest = source AND (NOT dest )   *)
  NOTSRCCOPY          = DWORD( 000330008H ); (* dest = (NOT source)             *)
  NOTSRCERASE         = DWORD( 0001100A6H ); (* dest = (NOT src) AND (NOT dest) *)
  MERGECOPY           = DWORD( 000C000CAH ); (* dest = (source AND pattern)     *)
  MERGEPAINT          = DWORD( 000BB0226H ); (* dest = (NOT source) OR dest     *)
  PATCOPY             = DWORD( 000F00021H ); (* dest = pattern                  *)
  PATPAINT            = DWORD( 000FB0A09H ); (* dest = DPSnoo                   *)
  PATINVERT           = DWORD( 0005A0049H ); (* dest = pattern XOR dest         *)
  DSTINVERT           = DWORD( 000550009H ); (* dest = (NOT dest)               *)
  BLACKNESS           = DWORD( 000000042H ); (* dest = BLACK                    *)
  WHITENESS           = DWORD( 000FF0062H ); (* dest = WHITE                    *)

(* Quaternary raster codes *)

(*
#define MAKEROP4(fore,back) (DWORD)((((back) << 8) & 0xFF000000) | (fore))
*)
(*# call( macro => on ) *)
PROCEDURE MAKEROP4( fore, back : DWORD ): DWORD;
(*# call( macro => off ) *)

