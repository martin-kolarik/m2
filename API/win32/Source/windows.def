(*
// Base record type for the enhanced metafile.
*)

TYPE

  EMR = RECORD
    iType : DWORD;              (* Enhanced metafile record type *)
    nSIze : DWORD;              (* Length of the record in bytes.
                                   This must be a multiple of 4. *)
  END;
  PEMR = POINTER TO EMR;

(*
// Base text record type for the enhanced metafile.
*)

  EMRTEXT = RECORD
    ptlReference : POINTL;
    nChars : DWORD;
    offString : DWORD;          (* Offset to the string *)
    fOptions : DWORD;
    rcl : RECTL;
    offDx : DWORD;              (* Offset to the inter-character spacing array.
                                   This is always given. *)
  END;
  PEMRTEXT = POINTER TO EMRTEXT;

(*
// Record structures for the enhanced metafile.
*)

  EMRABORTPATH = RECORD
    emr : EMR;
  END;
  //EMRABORTPATH      = _ABORTPATH;
  PEMRABORTPATH     = POINTER TO EMRABORTPATH;
  EMRBEGINPATH      = EMRABORTPATH;
  PEMRBEGINPATH     = POINTER TO EMRBEGINPATH;
  EMRENDPATH        = EMRABORTPATH;
  PEMRENDPATH       = POINTER TO EMRENDPATH;
