//#if(WINVER >= 0x0500)
(*
 * Multimonitor API.
 *)

CONST

  MONITOR_DEFAULTTONULL    = 00000000H;
  MONITOR_DEFAULTTOPRIMARY = 00000001H;
  MONITOR_DEFAULTTONEAREST = 00000002H;

PROCEDURE MonitorFromPoint( pt : POINT; dwFlags : DWORD ): HMONITOR;
PROCEDURE MonitorFromRect( lprc : PCRECT; dwFlags : DWORD ): HMONITOR;
PROCEDURE MonitorFromWindow( hend : HWND; dwFlags : DWORD ): HMONITOR;

CONST
  MONITORINFOF_PRIMARY     = 00000001H;
  //CCHDEVICENAME            = 32; // defined above

TYPE
  MONITORINFO = RECORD
    cbSize    : DWORD;
    rcMonitor : RECT;
    rcWork    : RECT;
    dwFlags   : DWORD;
  END;

  MONITORINFOEXA = RECORD
    mi : MONITORINFO;
    szDevice : ARRAY [0..CCHDEVICENAME - 1] OF CHAR;
  END;

  MONITORINFOEXW = RECORD
    mi : MONITORINFO;
    szDevice : ARRAY [0..CCHDEVICENAME - 1] OF WCHAR;
  END;

TYPE
  PMONITORINFO    = POINTER TO MONITORINFO;
  PMONITORINFOEXA = POINTER TO MONITORINFOEXA;
  PMONITORINFOEXW = POINTER TO MONITORINFOEXW;

CONST
(*%T UNICODE *)
  MONITORINFOEX ::= MONITORINFOEXW;
  PMONITORINFOEX ::= PMONITORINFOEXW;
(*%E *)
(*%F UNICODE *)
  MONITORINFOEX ::= MONITORINFOEXA;
  PMONITORINFOEX ::= PMONITORINFOEXA;
(*%E *)

PROCEDURE GetMonitorInfoA( hMonitor : HMONITOR; pmi : PMONITORINFO ): BOOL;
PROCEDURE GetMonitorInfoW( hMonitor : HMONITOR; pmi : PMONITORINFO ): BOOL;

CONST
(*%T UNICODE *)
  GetMonitorInfo ::= GetMonitorInfoW;
(*%E *)
(*%F UNICODE *)
  GetMonitorInfo ::= GetMonitorInfoA;
(*%E *)

TYPE
  MONITORENUMPROC = PROCEDURE( HMONITOR, HDC, PRECT, LPARAM ): BOOL;

PROCEDURE EnumDisplayMonitors(
    hdc      : HDC;
    lprcClip : PCRECT;
    pfnEnum  : MONITORENUMPROC;
    dwData   : LPARAM ): BOOL;

//#endif /* WINVER >= 0x0500 */

END windows.
