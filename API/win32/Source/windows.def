TYPE

  HDWP              = HANDLE;
  PMENUTEMPLATE     = PVOID;

  WNDPROC           = PROCEDURE( HWND, UINT, WPARAM, LPARAM ): LRESULT;

#if PlatformName #startswith L"WinCE" #then
  DLGPROC           = PROCEDURE( HWND, UINT, WPARAM, LPARAM ): BOOL;
  GRAYSTRINGPROC    = PROCEDURE( HDC, LPARAM, INTEGER ): BOOL;
  WNDENUMPROC       = PROCEDURE( HWND, LPARAM ): BOOL;
  HOOKPROC          = PROCEDURE( INTEGER, WPARAM, LPARAM ): LRESULT;
  SENDASYNCPROC     = PROCEDURE( HWND, UINT, DWORD, LRESULT );
  TIMERPROC         = PROCEDURE( HWND, UINT, UINT, DWORD );
#else
  DLGPROC           = FARPROC;
  GRAYSTRINGPROC    = FARPROC;
  WNDENUMPROC       = FARPROC;
  HOOKPROC          = FARPROC;
  SENDASYNCPROC     = FARPROC;
  TIMERPROC         = FARPROC;
#endif

  PROPENUMPROC      = PROCEDURE( HWND, PCTSTR, HANDLE ): BOOL;
  PROPENUMPROCEX    = PROCEDURE( HWND, PTSTR, HANDLE, DWORD ): BOOL;
  EDITWORDBREAKPROC = PROCEDURE( PTSTR, INTEGER, INTEGER, INTEGER ): INTEGER;

  DRAWSTATEPROC     = PROCEDURE( HDC, LPARAM, WPARAM, INTEGER, INTEGER ): BOOL;

  NAMEENUMPROC      = PROCEDURE( PTSTR, LPARAM ): BOOL;

  WINSTAENUMPROC    = NAMEENUMPROC;
  DESKTOPENUMPROC   = NAMEENUMPROC;

