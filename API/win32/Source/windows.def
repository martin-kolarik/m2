CONST

  MAX_PATH = 260;
  NULL     = 0;

  True     = 1;
  False    = 0;

TYPE
  BOOL    = INTEGER;
  PBOOL   = POINTER TO BOOL;

  INT     = INTEGER;
  PINT    = POINTER TO INT;

  LONG    = LONGINT;
  PLONG   = POINTER TO LONG;

  SHORT   = INT16;
  PSHORT  = POINTER TO SHORT;

  UINT    = CARDINAL;
  PUINT   = POINTER TO UINT;

  ULONG   = LONGCARD;
  PULONG  = POINTER TO ULONG;

  USHORT  = CARD16;
  PUSHORT = POINTER TO USHORT;

  UCHAR   = CHAR;
  PUCHAR  = POINTER TO UCHAR;

  // WCHAR   = USHORT;   // UNICODE two byte character -- defined in m2defs.h as wchar_t
  // PWCHAR  = POINTER TO WCHAR;

  DWORD   = LONGWORD;
  PDWORD  = POINTER TO DWORD;

  FLOAT   = REAL;
  PFLOAT  = POINTER TO FLOAT;

  DOUBLE  = LONGREAL;
  PDOUBLE = POINTER TO DOUBLE;

  PPBYTE  = POINTER TO PBYTE;
  PVOID   = ADDRESS;
  LPCVOID  = ADDRESS;
  PPVOID  = POINTER TO ADDRESS;

  PULARGE_INTEGER = POINTER TO ULARGE_INTEGER;

// from BASETSD.H
#if PlatformName #startswith L"WinCE" #then
  INT_PTR         = PTR;
  PINT_PTR        = POINTER TO INT_PTR;
  UINT_PTR        = PTR;
  PUINT_PTR       = POINTER TO UINT_PTR;

  HALF_PTR        = SHORT;
  PHALF_PTR       = POINTER TO HALF_PTR;
  UHALF_PTR       = USHORT;
  PUHALF_PTR      = POINTER TO UHALF_PTR;
#else
  INT_PTR         = PTR;
  PINT_PTR        = POINTER TO INT_PTR;
  LONG_PTR        = PTR;
  PLONG_PTR       = POINTER TO LONG_PTR;
  UINT_PTR        = PTR;
  PUINT_PTR       = POINTER TO UINT_PTR;
  ULONG_PTR       = PTR;
  PULONG_PTR      = POINTER TO ULONG_PTR;

  HALF_PTR        = SHORT;
  PHALF_PTR       = POINTER TO HALF_PTR;
  UHALF_PTR       = USHORT;
  PUHALF_PTR      = POINTER TO UHALF_PTR;
#endif

CONST
  MAXINT_PTR      = INT_PTR(07FFFFFFFH);
  MININT_PTR      = INT_PTR(080000000H);
  MAXUINT_PTR     = UINT_PTR(0FFFFFFFFH);

  MAXUHALF_PTR    = UHALF_PTR(0FFFFH);
  MAXHALF_PTR     = HALF_PTR(07FFFH);
  MINHALF_PTR     = HALF_PTR(08000H);

(* Types use for passing & returning polymorphic values *)
TYPE
  WPARAM  = PTR;
  LPARAM  = PTR;
  LRESULT = PTR;

(* NONSTRICT  Extension *)
  FARPROC           = PROCEDURE(): INTEGER;

PROCEDURE MAKEWORD( a, b : BYTE ): WORD;
PROCEDURE MAKELONG( a, b : WORD ): LONG;

TYPE
  ATOM = WORD;

  HANDLE       = PVOID;  (**** from winnt.h ****)
  PHANDLE      = POINTER TO HANDLE;

  HWND         = HANDLE;
  PHWND        = POINTER TO HWND;

  HHOOK        = HANDLE;
  PHHOOK       = POINTER TO HHOOK;

  HGLOBAL      = HANDLE;
  HLOCAL       = HANDLE;
  GLOBALHANDLE = HANDLE;
  LOCALHANDLE  = HANDLE;

  _PROC        = PROCEDURE(): INTEGER; // original type name PROC cannot be used, it is Modula-2 keyword

  HGDIOBJ      = HANDLE;

  HACCEL       = HANDLE;
  HBITMAP      = HANDLE;
  HBRUSH       = HANDLE;
  HCOLORSPACE  = HANDLE;
  HDC          = HANDLE;
  HGLRC        = HANDLE; // OpenGL
  HDESK        = HANDLE;
  HENHMETAFILE = HANDLE;
  HFONT        = HANDLE;
  HICON        = HANDLE;
  HMENU        = HANDLE;
  HMETAFILE    = HANDLE;
  HINSTANCE    = HANDLE;
  HMODULE      = HINSTANCE; // HMODULEs can be used in place of HINSTANCEs
  HPALETTE     = HANDLE;
  HPEN         = HANDLE;
  HRGN         = HANDLE;
  HRSRC        = HANDLE;
  HSTR         = HANDLE;
  HTASK        = HANDLE;
  HWINSTA      = HANDLE;
  HKL          = HANDLE;
  PHKL         = POINTER TO HKL;
  HCURSOR      = HICON; // HICONs and HCURSORs are polymorphic

//#if(WINVER >= 0x0500)
  HMONITOR      = HANDLE;
  HTERMINAL     = HANDLE;
  HWINEVENTHOOK = HANDLE;
//#endif /* WINVER >= 0x0500 */

  HFILE        = INT;

  COLORREF     = DWORD;
  PCOLORREF    = POINTER TO COLORREF;

CONST
  HFILE_ERROR  = HFILE( -1 );

TYPE
  RECT = RECORD
    left   : LONG;
    top    : LONG;
    right  : LONG;
    bottom : LONG;
  END;
  PRECT = POINTER TO RECT;
  PCRECT = POINTER TO CONST RECT;

  RECTL = RECORD
    left   : LONG;
    top    : LONG;
    right  : LONG;
    bottom : LONG;
  END;
  PRECTL = POINTER TO RECTL;
  PCRECTL = POINTER TO CONST RECTL;

  POINT = RECORD
    x : LONG;
    y : LONG;
  END;
  PPOINT = POINTER TO POINT;

  POINTL  = RECORD
    x : LONG;
    y : LONG;
  END;
  PPOINTL = POINTER TO POINTL;

  SIZEL = RECORD
    cx : LONG;
    cy : LONG;
  END;
  PSIZEL = POINTER TO SIZEL;
  PSIZE = PSIZEL;

  POINTS = RECORD
    x : SHORT;
    y : SHORT;
  END;
  PPOINTS = POINTER TO POINTS;

CONST

(* mode selections for the device mode function *)

  DM_UPDATE           = 1;
  DM_COPY             = 2;
  DM_PROMPT           = 4;
  DM_MODIFY           = 8;

  DM_IN_BUFFER        = DM_MODIFY;
  DM_IN_PROMPT        = DM_PROMPT;
  DM_OUT_BUFFER       = DM_COPY;
  DM_OUT_DEFAULT      = DM_UPDATE;

(* device capabilities indices *)

  DC_FIELDS           = 1;
  DC_PAPERS           = 2;
  DC_PAPERSIZE        = 3;
  DC_MINEXTENT        = 4;
  DC_MAXEXTENT        = 5;
  DC_BINS             = 6;
  DC_DUPLEX           = 7;
  DC_SIZE             = 8;
  DC_EXTRA            = 9;
  DC_VERSION          = 10;
  DC_DRIVER           = 11;
  DC_BINNAMES         = 12;
  DC_ENUMRESOLUTIONS  = 13;
  DC_FILEDEPENDENCIES = 14;
  DC_TRUETYPE         = 15;
  DC_PAPERNAMES       = 16;
  DC_ORIENTATION      = 17;
  DC_COPIES           = 18;

