    code : UINT;         (* NM_ code *)
  END;
  PNMHDR = POINTER TO NMHDR;

  STYLESTRUCT = RECORD
    styleOld : DWORD;
    styleNew : DWORD;
  END;
  PSTYLESTRUCT = POINTER TO STYLESTRUCT;

CONST

(*
