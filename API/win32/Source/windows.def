  WS_EX_LAYERED           = 00080000H;
//#endif /* _WIN32_WINNT >= 0x0500 */

(*
 * Class styles
 *)
  CS_VREDRAW          = 00001H;
  CS_HREDRAW          = 00002H;
  CS_KEYCVTWINDOW     = 00004H;
  CS_DBLCLKS          = 00008H;
  CS_OWNDC            = 00020H;
  CS_CLASSDC          = 00040H;
  CS_PARENTDC         = 00080H;
  CS_NOKEYCVT         = 00100H;
  CS_NOCLOSE          = 00200H;
  CS_SAVEBITS         = 00800H;
