CONST

  MIIM_STATE       = 000000001H;
  MIIM_ID          = 000000002H;
  MIIM_SUBMENU     = 000000004H;
  MIIM_CHECKMARKS  = 000000008H;
  MIIM_TYPE        = 000000010H;
  MIIM_DATA        = 000000020H;

TYPE

  MENUITEMINFO = RECORD
    cbSize : UINT;
    fMask : UINT;
    fType: UINT;             (* used if MIIM_TYPE *)
    fState : UINT;           (* used if MIIM_STATE *)
    wID : UINT;              (* used if MIIM_ID *)
    hSubMenu : HMENU;        (* used if MIIM_SUBMENU *)
    hbmpChecked : HBITMAP;   (* used if MIIM_CHECKMARKS *)
    hbmpUnchecked : HBITMAP; (* used if MIIM_CHECKMARKS *)
    dwItemData : DWORD;      (* used if MIIM_DATA *)
    dwTypeData : PTSTR;      (* used if MIIM_TYPE *)
    cch : UINT;              (* used if MIIM_TYPE *)
  END;
  PMENUITEMINFO = POINTER TO MENUITEMINFO;
  PCMENUITEMINFO = PMENUITEMINFO;

