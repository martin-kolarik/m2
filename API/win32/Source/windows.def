  ARW_LEFT                    = LONG( 00000H );
  ARW_RIGHT                   = LONG( 00000H );
  ARW_UP                      = LONG( 00004H );
  ARW_DOWN                    = LONG( 00004H );
  ARW_HIDE                    = LONG( 00008H );
  ARW_VALID                   = LONG( 0000FH );

TYPE

  MINIMIZEDMETRICS = RECORD
    cbSize : UINT;
    iWidth : INTEGER;
    iHorzGap : INTEGER;
    iVertGap : INTEGER;
    iArrange : INTEGER;
  END;
  PMINIMIZEDMETRICS = POINTER TO MINIMIZEDMETRICS;

  ICONMETRICS = RECORD
    cbSize : UINT;
    iHorzSpacing : INTEGER;
    iVertSpacing : INTEGER;
    iTitleWrap : INTEGER;
    lfFont : LOGFONT;
  END;
  PICONMETRICS = POINTER TO ICONMETRICS;

  ANIMATIONINFO = RECORD
    cbSize : UINT;
    iMinAnimate : INTEGER;
  END;
  PANIMATIONINFO = POINTER TO ANIMATIONINFO;

  SERIALKEYS = RECORD
    cbSize : UINT;
    dwFlags : DWORD;
    lpszActivePort : PTSTR;
    lpszPort : PTSTR;
    iBaudRate : UINT;
    iPortState : UINT;
    iActive : UINT;
  END;
  PSERIALKEYS = POINTER TO SERIALKEYS;

CONST

(* flags for SERIALKEYS dwFlags field *)
  SERKF_SERIALKEYSON  = 000000001H;
  SERKF_AVAILABLE     = 000000002H;
  SERKF_INDICATOR     = 000000004H;

TYPE

  HIGHCONTRAST = RECORD
    cbSize : UINT;
    dwFlags : DWORD;
    lpszDefaultScheme : PTSTR;
  END;
  PHIGHCONTRAST = POINTER TO HIGHCONTRAST;

CONST

(* flags for HIGHCONTRAST dwFlags field *)
  HCF_HIGHCONTRASTON  = 000000001H;
  HCF_AVAILABLE       = 000000002H;
  HCF_HOTKEYACTIVE    = 000000004H;
  HCF_CONFIRMHOTKEY   = 000000008H;
  HCF_HOTKEYSOUND     = 000000010H;
  HCF_INDICATOR       = 000000020H;
  HCF_HOTKEYAVAILABLE = 000000040H;

(* Flags for ChangeDisplaySettings *)
  CDS_UPDATEREGISTRY  = 000000001H;
  CDS_TEST            = 000000002H;
  CDS_FULLSCREEN      = 000000004H;

(* Return values *)
  DISP_CHANGE_SUCCESSFUL       = 0;
  DISP_CHANGE_RESTART          = 1;
  DISP_CHANGE_FAILED           = -1;
  DISP_CHANGE_BADMODE          = -2;
  DISP_CHANGE_NOTUPDATED       = -3;
  DISP_CHANGE_BADFLAGS         = -4;

PROCEDURE ChangeDisplaySettings(
    lpDevMode : PDEVMODE;
