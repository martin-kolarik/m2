TYPE
  COLOR16 = USHORT;

  _TRIVERTEX = RECORD
    x       : LONG;
    y       : LONG;
    Red,
    Green,
    Blue,
    Alpha   : COLOR16;
  END;
  TRIVERTEX   = _TRIVERTEX;
  PTRIVERTEX  = POINTER TO TRIVERTEX;

  _GRADIENT_TRIANGLE = RECORD
    Vertex1,
    Vertex2,
    Vertex3   : ULONG;
  END;
  GRADIENT_TRIANGLE   = _GRADIENT_TRIANGLE;
  PGRADIENT_TRIANGLE  = POINTER TO GRADIENT_TRIANGLE;

  _GRADIENT_RECT = RECORD
    UpperLeft   : ULONG;
    LowerRight  : ULONG;
  END;
  GRADIENT_RECT   = _GRADIENT_RECT;
  PGRADIENT_RECT  = POINTER TO GRADIENT_RECT;

  _BLENDFUNCTION = RECORD
    BlendOp,
    BlendFlags,
    SourceConstantAlpha,
    AlphaFormat : BYTE;
  END;
  BLENDFUNCTION   = _BLENDFUNCTION;
  PBLENDFUNCTION  = POINTER TO BLENDFUNCTION;

