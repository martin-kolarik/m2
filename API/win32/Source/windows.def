TYPE (* Window CLASS structure *)

  WNDCLASSEX = RECORD
    cbSize        : UINT;
    (* Win 3.x *)
    style : UINT;
    lpfnWndProc   : WNDPROC;
    cbClsExtra    : INTEGER;
    cbWndExtra    : INTEGER;
    hInstance     : HINSTANCE;
    hIcon         : HICON;
    hCursor       : HCURSOR;
    hbrBackground : HBRUSH;
    lpszMenuName  : PCTSTR;
    lpszClassName : PCTSTR;
    (* Win 4.0 *)
    hIconSm       : HICON;
  END;
  PWNDCLASSEX = POINTER TO WNDCLASSEX;

  WNDCLASS = RECORD
    style         : UINT;
    lpfnWndProc   : WNDPROC;
    cbClsExtra    : INTEGER;
    cbWndExtra    : INTEGER;
    hInstance     : HINSTANCE;
    hIcon         : HICON;
    hCursor       : HCURSOR;
    hbrBackground : HBRUSH;
    lpszMenuName  : PCTSTR;
    lpszClassName : PCTSTR;
  END;
  PWNDCLASS = POINTER TO WNDCLASS;

(*
 * Message structure
 *)
  MSG = RECORD
    hwnd    : HWND;
    message : UINT;
    wParam  : WPARAM;
    lParam  : LPARAM;
    time    : DWORD;
    pt      : POINT;
  END;
  PMSG = POINTER TO MSG;

