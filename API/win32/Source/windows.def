CONST

(*
 * Predefined Clipboard Formats
 *)
  CF_TEXT             = 1;
  CF_BITMAP           = 2;
  CF_METAFILEPICT     = 3;
  CF_SYLK             = 4;
  CF_DIF              = 5;
  CF_TIFF             = 6;
  CF_OEMTEXT          = 7;
  CF_DIB              = 8;
  CF_PALETTE          = 9;
  CF_PENDATA          = 10;
  CF_RIFF             = 11;
  CF_WAVE             = 12;
  CF_UNICODETEXT      = 13;
  CF_ENHMETAFILE      = 14;
  CF_HDROP            = 15;
  CF_LOCALE           = 16;
  CF_MAX              = 17;

  CF_OWNERDISPLAY     = 00080H;
  CF_DSPTEXT          = 00081H;
  CF_DSPBITMAP        = 00082H;
  CF_DSPMETAFILEPICT  = 00083H;
  CF_DSPENHMETAFILE   = 0008EH;

(*
 * "Private" formats don't get GlobalFree()'d
 *)
  CF_PRIVATEFIRST     = 00200H;
  CF_PRIVATELAST      = 002FFH;

(*
 * "GDIOBJ" formats do get DeleteObject()'d
 *)
  CF_GDIOBJFIRST      = 00300H;
  CF_GDIOBJLAST       = 003FFH;

(*
 * Defines for the fVirt field of the Accelerator table structure.
 *)
  FVIRTKEY  = TRUE;          (* Assumed to be == TRUE *)
  FNOINVERT = 002H;
  FSHIFT    = 004H;
  FCONTROL  = 008H;
  FALT      = 010H;

TYPE

  ACCEL = RECORD
    fVirt : BYTE;               (* Also called the flags field *)
    key : WORD;
    cmd : WORD;
  END;
  PACCEL = POINTER TO ACCEL;

  PAINTSTRUCT = RECORD
    hdc : HDC;
    fErase : BOOL;
    rcPaint : RECT;
    fRestore : BOOL;
    fIncUpdate : BOOL;
    rgbReserved : ARRAY [0..31] OF BYTE;
  END;
  PPAINTSTRUCT = POINTER TO PAINTSTRUCT;

  CREATESTRUCT = RECORD
    lpCreateParams : PVOID;
    hInstance : HINSTANCE;
    hMenu : HMENU;
    hwndParent : HWND;
    cy : INTEGER;
    cx : INTEGER;
    y : INTEGER;
    x : INTEGER;
    style : LONG;
    lpszName : PCTSTR;
    lpszClass : PCTSTR;
    dwExStyle : DWORD;
  END;
(* created in forward
  PCREATESTRUCT = POINTER TO CREATESTRUCT;
*)

  WINDOWPLACEMENT = RECORD
    length : UINT;
    flags : UINT;
    showCmd : UINT;
    ptMinPosition : POINT;
    ptMaxPosition : POINT;
    rcNormalPosition : RECT;
  END;
  PWINDOWPLACEMENT = POINTER TO WINDOWPLACEMENT;

CONST

  WPF_SETMINPOSITION      = 00001H;
  WPF_RESTORETOMAXIMIZED  = 00002H;

TYPE

