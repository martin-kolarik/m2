    TYPE
      VS_FIXEDFILEINFO  = RECORD
                            dwSignature        : windows.DWORD;  //* e.g. 0xfeef04bd */
                            dwStrucVersion     : windows.DWORD;  //* e.g. 0x00000042 = "0.42" */
                            dwFileVersionMS    : windows.DWORD;  //* e.g. 0x00030075 = "3.75" */
                            dwFileVersionLS    : windows.DWORD;  //* e.g. 0x00000031 = "0.31" */
                            dwProductVersionMS : windows.DWORD;  //* e.g. 0x00030010 = "3.10" */
                            dwProductVersionLS : windows.DWORD;  //* e.g. 0x00000031 = "0.31" */
                            dwFileFlagsMask    : windows.DWORD;  //* = 0x3F for version "0.42" */
                            dwFileFlags        : windows.DWORD;  //* e.g. VFF_DEBUG | VFF_PRERELEASE */
                            dwFileOS           : windows.DWORD;  //* e.g. VOS_DOS_WINDOWS16 */
                            dwFileType         : windows.DWORD;  //* e.g. VFT_DRIVER */
                            dwFileSubtype      : windows.DWORD;  //* e.g. VFT2_DRV_KEYBOARD */
                            dwFileDateMS       : windows.DWORD;  //* e.g. 0 */
                            dwFileDateLS       : windows.DWORD;  //* e.g. 0 */
                          END;
      PVS_FIXEDFILEINFO = POINTER TO VS_FIXEDFILEINFO;

    //* ----- Function prototypes ----- */

    //* Returns size of version info in bytes */
    PROCEDURE GetFileVersionInfoSize( lptstrFilename : windows.PTSTR;   //* Filename of version stamped file */
                                      lpdwHandle     : windows.PDWORD   //* Information for use by GetFileVersionInfo */
                                    ) : windows.DWORD; 

    //* Read version info into buffer */
    PROCEDURE GetFileVersionInfo( lptstrFilename : windows.PTSTR; //* Filename of version stamped file */
                                  dwHandle       : windows.DWORD; //* Information from GetFileVersionSize */
                                  dwLen          : windows.DWORD; //* Length of buffer for info */
                                  lpData         : ADDRESS        //* Buffer to place the data structure */
                                ) : windows.BOOL;

    PROCEDURE VerLanguageName( wLang  : windows.DWORD;
                               szLang : windows.PTSTR;
                               nSize  : windows.DWORD
                             ) : windows.DWORD;

    PROCEDURE VerQueryValue( pBlock         : ADDRESS;
                             lpSubBlock     : windows.PTSTR;
                             VAR lplpBuffer : ADDRESS;
                             puLen          : windows.PUINT ) : windows.BOOL;
