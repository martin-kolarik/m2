  MCIERR_CANNOT_LOAD_DRIVER        = MCIERR_BASE + 10;
  MCIERR_MISSING_COMMAND_STRING    = MCIERR_BASE + 11;
  MCIERR_PARAM_OVERFLOW            = MCIERR_BASE + 12;
