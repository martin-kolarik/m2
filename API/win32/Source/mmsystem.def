(* parameter block for MCI_SAVE command message *)

  MCI_OVLY_SAVE_PARMS = RECORD
    dwCallback : windows.DWORD;
    lpfilename : windows.PCTSTR;
    rc         : windows.RECT;
  END;
  PMCI_OVLY_SAVE_PARMS = POINTER TO MCI_OVLY_SAVE_PARMS;

(* parameter block for MCI_LOAD command message *)

  MCI_OVLY_LOAD_PARMS = RECORD
    dwCallback : windows.DWORD;
    lpfilename : windows.PCTSTR;
    rc         : windows.RECT;
  END;
  PMCI_OVLY_LOAD_PARMS = POINTER TO MCI_OVLY_LOAD_PARMS;

(****************************************************************************

      DISPLAY Driver extensions

****************************************************************************)

CONST
  NEWTRANSPARENT   = 3;          (* use with SetBkMode() *)

  QUERYROPSUPPORT  = 40;         (* use to determine ROP support *)

(****************************************************************************

      DIB Driver extensions

****************************************************************************)

  SELECTDIB        = 41;                     (* DIB.DRV select dib escape *)
(*# save, call( macro => on ) *)
PROCEDURE DIBINDEX( n : WORD ) : windows.DWORD;
(* #define DIBINDEX(n)     MAKELONG((n),0x10FF) *)
(*# restore *)

(****************************************************************************

      ScreenSaver support

    The current application will receive a syscommand of SC_SCREENSAVE just
    before the screen saver is invoked.  If the app wishes to prevent a
    screen save, return non-zero value, otherwise call DefWindowProc().

****************************************************************************)

CONST
  SC_SCREENSAVE  = 0F140H;


END mmsystem.

