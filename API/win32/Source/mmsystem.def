(*# module( header          => off,
            init_code       => off ) *)

(*# call(   o_a_size        => off,
            o_a_copy        => off,
            c_arrays        => on,
            result_optional => on,
            prefix=>stdcall ) *)

(*============================================================*)
(* Windows header:           mmsystem.h                       *)
(*============================================================*)

(*==========================================================================
 *
 *  mmsystem.h -- Include file for Multimedia API's
 *
 *  Version 4.00
 *
 *  Copyright (C) 1992-1995 Microsoft Corporation.  All Rights Reserved.
 *
 *--------------------------------------------------------------------------
 *
 *  Define:         Prevent inclusion of:
 *  --------------  --------------------------------------------------------
 *  MMNODRV         Installable driver support
 *  MMNOSOUND       Sound support
 *  MMNOWAVE        Waveform support
 *  MMNOMIDI        MIDI support
 *  MMNOAUX         Auxiliary audio support
 *  MMNOMIXER       Mixer support
 *  MMNOTIMER       Timer support
 *  MMNOJOY         Joystick support
 *  MMNOMCI         MCI support
 *  MMNOMMIO        Multimedia file I/O support
 *  MMNOMMSYSTEM    General MMSYSTEM functions
 *
 *==========================================================================
 *)

IMPORT
  windows;

(****************************************************************************

        General constants and data types

****************************************************************************)

CONST
(* general constants *)

  MAXPNAMELEN             = 32;     (* max product name length (including NULL) *)
  MAXERRORLENGTH          = 256;    (* max error text length (including NULL) *)
  MAX_JOYSTICKOEMVXDNAME  = 260;    (* max oem vxd name length (including NULL) *)

TYPE
(* general data types *)

  MMVERSION   = windows.UINT;  (* major (high byte), minor (low byte) *)
  MMRESULT    = windows.UINT;  (* error return code, 0 means no error *)
        (* call as if(err=xxxx(...)) Error(err); else *)

  PUINT       = POINTER TO windows.UINT;

(* MMTIME data structure *)
  MMTIME = RECORD
    wType : windows.UINT;      (* indicates the contents of the union *)
    CASE : CARDINAL OF (* u *)
    | 1 :
      ms       : windows.DWORD;     (* milliseconds *)
    | 2 :
      sample   : windows.DWORD;     (* samples *)
    | 3 :
      cb       : windows.DWORD;     (* byte count *)
    | 4 :
      ticks    : windows.DWORD;     (* ticks in MIDI stream *)
    | 5 :
      (* SMPTE *)
      hour   : BYTE;      (* hours *)
      min    : BYTE;      (* minutes *)
      sec    : BYTE;      (* seconds *)
      frame  : BYTE;      (* frames  *)
      fps    : BYTE;      (* frames per second *)
      dummy  : BYTE;      (* pad *)
      pad    : ARRAY [0..1] OF BYTE;
    | 6 : 
      (* MIDI *)
      songptrpos : windows.DWORD;   (* song pointer position *)
     END;
  END;
  PMMTIME = POINTER TO MMTIME;

CONST
(* types for wType field in MMTIME struct *)
  TIME_MS          = 0001H;  (* time in milliseconds *)
  TIME_SAMPLES     = 0002H;  (* number of wave samples *)
  TIME_BYTES       = 0004H;  (* current byte offset *)
  TIME_SMPTE       = 0008H;  (* SMPTE time *)
  TIME_MIDI        = 0010H;  (* MIDI time *)
  TIME_TICKS       = 0020H;  (* Ticks within MIDI stream *)

(*
 *
 *
 *)
(*# save, call( macro => on ) *)
PROCEDURE MAKEFOURCC(ch0, ch1, ch2, ch3 : windows.DWORD ) : windows.DWORD;
    (* ((DWORD)(BYTE)(ch0) | ((DWORD)(BYTE)(ch1) << 8) | ((DWORD)(BYTE)(ch2) << 16) | ((DWORD)(BYTE)(ch3) << 24 )) *)
(*# restore *)

(****************************************************************************

        Multimedia Extensions Window Messages

****************************************************************************)

CONST
  MM_JOY1MOVE          = 3A0H;           (* joystick *)
  MM_JOY2MOVE          = 3A1H;
  MM_JOY1ZMOVE         = 3A2H;
  MM_JOY2ZMOVE         = 3A3H;
  MM_JOY1BUTTONDOWN    = 3B5H;
  MM_JOY2BUTTONDOWN    = 3B6H;
  MM_JOY1BUTTONUP      = 3B7H;
  MM_JOY2BUTTONUP      = 3B8H;

  MM_MCINOTIFY         = 3B9H;           (* MCI *)

  MM_WOM_OPEN          = 3BBH;           (* waveform output *)
  MM_WOM_CLOSE         = 3BCH;
  MM_WOM_DONE          = 3BDH;

  MM_WIM_OPEN          = 3BEH;           (* waveform input *)
  MM_WIM_CLOSE         = 3BFH;
  MM_WIM_DATA          = 3C0H;

  MM_MIM_OPEN          = 3C1H;           (* MIDI input *)
  MM_MIM_CLOSE         = 3C2H;
  MM_MIM_DATA          = 3C3H;
  MM_MIM_LONGDATA      = 3C4H;
  MM_MIM_ERROR         = 3C5H;
  MM_MIM_LONGERROR     = 3C6H;

  MM_MOM_OPEN          = 3C7H;           (* MIDI output *)
  MM_MOM_CLOSE         = 3C8H;
  MM_MOM_DONE          = 3C9H;

(* these are also in msvideo.h *)
  MM_DRVM_OPEN        = 3D0H;           (* installable drivers *)
  MM_DRVM_CLOSE       = 3D1H;
  MM_DRVM_DATA        = 3D2H;
  MM_DRVM_ERROR       = 3D3H;

(* these are used by msacm.h *)
  MM_STREAM_OPEN       = 3D4H;
  MM_STREAM_CLOSE      = 3D5H;
  MM_STREAM_DONE       = 3D6H;
  MM_STREAM_ERROR      = 3D7H;

  MM_MOM_POSITIONCB    = 3CAH;           (* Callback for MEVT_POSITIONCB *)

  MM_MCISIGNAL         = 3CBH;

  MM_MIM_MOREDATA       = 3CCH;          (* MIM_DONE w/ pending events *)

  MM_MIXM_LINE_CHANGE      = 3D0H;       (* mixer line change notify *)
  MM_MIXM_CONTROL_CHANGE   = 3D1H;       (* mixer control change notify *)

(****************************************************************************

    String resource number bases (internal use)

****************************************************************************)

  MMSYSERR_BASE           = 0;
  WAVERR_BASE             = 3;
  MIDIERR_BASE            = 6;
  TIMERR_BASE             = 9;
  JOYERR_BASE             = 16;
  MCIERR_BASE             = 25;
  MIXERR_BASE             = 102;

  MCI_STRING_OFFSET       = 51;
  MCI_VD_OFFSET           = 102;
  MCI_CD_OFFSET           = 108;
  MCI_WAVE_OFFSET         = 115;
  MCI_SEQ_OFFSET          = 121;

(****************************************************************************

      General error return values

****************************************************************************)

(* general error return values *)
  MMSYSERR_NOERROR       = 0;                   (* no error *)
  MMSYSERR_ERROR         = MMSYSERR_BASE + 1;  (* unspecified error *)
  MMSYSERR_BADDEVICEID   = MMSYSERR_BASE + 2;  (* device ID out of range *)
  MMSYSERR_NOTENABLED    = MMSYSERR_BASE + 3;  (* driver failed enable *)
  MMSYSERR_ALLOCATED     = MMSYSERR_BASE + 4;  (* device already allocated *)
  MMSYSERR_INVALHANDLE   = MMSYSERR_BASE + 5;  (* device handle is invalid *)
  MMSYSERR_NODRIVER      = MMSYSERR_BASE + 6;  (* no device driver present *)
  MMSYSERR_NOMEM         = MMSYSERR_BASE + 7;  (* memory allocation error *)
  MMSYSERR_NOTSUPPORTED  = MMSYSERR_BASE + 8;  (* function isn't supported *)
  MMSYSERR_BADERRNUM     = MMSYSERR_BASE + 9;  (* error value out of range *)
  MMSYSERR_INVALFLAG     = MMSYSERR_BASE + 10; (* invalid flag passed *)
  MMSYSERR_INVALPARAM    = MMSYSERR_BASE + 11; (* invalid parameter passed *)
  MMSYSERR_HANDLEBUSY    = MMSYSERR_BASE + 12; (* handle being used *)
               (* simultaneously on another *)
               (* thread (eg callback) *)
  MMSYSERR_INVALIDALIAS  = MMSYSERR_BASE + 13; (* specified alias not found *)
  MMSYSERR_BADDB         = MMSYSERR_BASE + 14; (* bad registry database *)
  MMSYSERR_KEYNOTFOUND   = MMSYSERR_BASE + 15; (* registry key not found *)
  MMSYSERR_READERROR     = MMSYSERR_BASE + 16; (* registry read error *)
  MMSYSERR_WRITEERROR    = MMSYSERR_BASE + 17; (* registry write error *)
  MMSYSERR_DELETEERROR   = MMSYSERR_BASE + 18; (* registry delete error *)
  MMSYSERR_VALNOTFOUND   = MMSYSERR_BASE + 19; (* registry value not found *)
  MMSYSERR_NODRIVERCB    = MMSYSERR_BASE + 20; (* driver does not call DriverCallback *)
  MMSYSERR_LASTERROR     = MMSYSERR_BASE + 20; (* last error in range *)


TYPE
  HDRVR = windows.HANDLE;
(****************************************************************************

      Installable driver support

****************************************************************************)

TYPE
  DRVCONFIGINFOEX = RECORD
    dwDCISize          : windows.DWORD;
    lpszDCISectionName : windows.PCWSTR;
    lpszDCIAliasName   : windows.PCWSTR;
    dnDevNode          : windows.DWORD;
  END;
  PDRVCONFIGINFOEX = POINTER TO DRVCONFIGINFOEX;

CONST
(* Driver messages *)
  DRV_LOAD                 = 0001H;
  DRV_ENABLE               = 0002H;
  DRV_OPEN                 = 0003H;
  DRV_CLOSE                = 0004H;
  DRV_DISABLE              = 0005H;
  DRV_FREE                 = 0006H;
  DRV_CONFIGURE            = 0007H;
  DRV_QUERYCONFIGURE       = 0008H;
  DRV_INSTALL              = 0009H;
  DRV_REMOVE               = 000AH;
  DRV_EXITSESSION          = 000BH;
  DRV_POWER                = 000FH;
  DRV_RESERVED             = 0800H;
  DRV_USER                 = 4000H;

TYPE
(* LPARAM of DRV_CONFIGURE message *)
  DRVCONFIGINFO = RECORD
    dwDCISize   : windows.DWORD;
    lpszDCISectionName : windows.PCWSTR;
    lpszDCIAliasName :windows.PCWSTR;
  END;
  PDRVCONFIGINFO = POINTER TO DRVCONFIGINFO;

CONST
(* Supported return values for DRV_CONFIGURE message *)
  DRVCNF_CANCEL            = 0000H;
  DRVCNF_OK                = 0001H;
  DRVCNF_RESTART           = 0002H;

TYPE
(* installable driver function prototypes *)
  DRIVERPROC = PROCEDURE( windows.DWORD, HDRVR, windows.UINT, windows.LPARAM, windows.LPARAM): windows.LRESULT;

PROCEDURE CloseDriver(hDriver : HDRVR; lParam1 : windows.LONG; lParam2 : windows.LONG) : windows.LRESULT;
PROCEDURE OpenDriver(szDriverName : windows.PCWSTR; szSectionName : windows.PCWSTR; lParam2 : windows.LONG) : HDRVR;
PROCEDURE SendDriverMessage(hDriver : HDRVR; message : windows.UINT; lParam1 : windows.LONG; lParam2 : windows.LONG) : windows.LRESULT;
PROCEDURE DrvGetModuleHandle(hDriver : HDRVR) : windows.HMODULE;
PROCEDURE GetDriverModuleHandle(hDriver : HDRVR) : windows.HMODULE;
PROCEDURE DefDriverProc(dwDriverIdentifier : windows.DWORD; hdrvr : HDRVR; uMsg : windows.UINT; lParam1 : windows.LPARAM; lParam2 : windows.LPARAM) : windows.LRESULT;

CONST
(* return values from DriverProc() function *)
  DRV_CANCEL             = DRVCNF_CANCEL;
  DRV_OK                 = DRVCNF_OK;
  DRV_RESTART            = DRVCNF_RESTART;

  DRV_MCI_FIRST          = DRV_RESERVED;
  DRV_MCI_LAST           = DRV_RESERVED + 0FFFH;

(****************************************************************************

        Driver callback support

****************************************************************************)

(* flags used with waveOutOpen(), waveInOpen(), midiInOpen(), and *)
(* midiOutOpen() to specify the type of the dwCallback parameter. *)

  CALLBACK_TYPEMASK    = 00070000H;    (* callback type mask *)
  CALLBACK_NULL        = 00000000H;    (* no callback *)
  CALLBACK_WINDOW      = 00010000H;    (* dwCallback is a HWND *)
  CALLBACK_TASK        = 00020000H;    (* dwCallback is a HTASK *)
  CALLBACK_FUNCTION    = 00030000H;    (* dwCallback is a FARPROC *)
  CALLBACK_THREAD      = CALLBACK_TASK;(* thread ID replaces 16 bit task *)
  CALLBACK_EVENT       = 00050000H;    (* dwCallback is an EVENT Handle *)

TYPE
  DRVCALLBACK = PROCEDURE(HDRVR (*hdrvr*), windows.UINT (*uMsg*), windows.DWORD (*dwUser*), windows.DWORD (*dw1*), windows.DWORD (*dw2*));

  PDRVCALLBACK = POINTER TO DRVCALLBACK;

(****************************************************************************

        General MMSYSTEM support

****************************************************************************)

(*
  OutputDebugStr  = OutputDebugString;
*)

(****************************************************************************

          Sound support

****************************************************************************)
PROCEDURE sndPlaySound(pszSound : windows.PCTSTR; fuSound : windows.UINT) : windows.BOOL;

CONST
(*
 *  flag values for fuSound and fdwSound arguments on [snd]PlaySound
 *)
  SND_SYNC             = 0000H; (* play synchronously (default) *)
  SND_ASYNC            = 0001H; (* play asynchronously *)
  SND_NODEFAULT        = 0002H; (* silence (!default) if sound not found *)
  SND_MEMORY           = 0004H; (* pszSound points to a memory file *)
  SND_LOOP             = 0008H; (* loop the sound until next sndPlaySound *)
  SND_NOSTOP           = 0010H; (* don't stop any currently playing sound *)

  SND_NOWAIT           = 00002000H; (* don't wait if the driver is busy *)
  SND_ALIAS            = 00010000H; (* name is a registry alias *)
  SND_ALIAS_ID         = 00110000H; (* alias is a predefined ID *)
  SND_FILENAME         = 00020000H; (* name is file name *)
  SND_RESOURCE         = 00040004H; (* name is resource name or atom *)
  SND_PURGE            = 0040H;     (* purge non-static events for task *)
  SND_APPLICATION      = 0080H;     (* look for application specific association *)

  SND_ALIAS_START  = 0;          (* alias base *)

(*# save, call( macro => on ) *)
PROCEDURE sndAlias( ch0, ch1 : windows.DWORD ) : windows.DWORD;
  (* (SND_ALIAS_START + (DWORD)(BYTE)(ch0) | ((DWORD)(BYTE)(ch1) << 8)) *)
(*# restore *)

CONST
  SND_ALIAS_SYSTEMASTERISK    = SND_ALIAS_START + windows.DWORD( ORD( 'S' ) OR ( ORD( '*' ) << 8 ));
  SND_ALIAS_SYSTEMQUESTION    = SND_ALIAS_START + windows.DWORD( ORD( 'S' ) OR ( ORD( '?' ) << 8 ));
  SND_ALIAS_SYSTEMHAND        = SND_ALIAS_START + windows.DWORD( ORD( 'S' ) OR ( ORD( 'H' ) << 8 ));
  SND_ALIAS_SYSTEMEXIT        = SND_ALIAS_START + windows.DWORD( ORD( 'S' ) OR ( ORD( 'E' ) << 8 ));
  SND_ALIAS_SYSTEMSTART       = SND_ALIAS_START + windows.DWORD( ORD( 'S' ) OR ( ORD( 'S' ) << 8 ));
  SND_ALIAS_SYSTEMWELCOME     = SND_ALIAS_START + windows.DWORD( ORD( 'S' ) OR ( ORD( 'W' ) << 8 ));
  SND_ALIAS_SYSTEMEXCLAMATION = SND_ALIAS_START + windows.DWORD( ORD( 'S' ) OR ( ORD( '!' ) << 8 ));
  SND_ALIAS_SYSTEMDEFAULT     = SND_ALIAS_START + windows.DWORD( ORD( 'S' ) OR ( ORD( 'D' ) << 8 ));

PROCEDURE PlaySound(pszSound : windows.PCTSTR; hmod : windows.HMODULE; fdwSound : windows.DWORD) : windows.BOOL;

(****************************************************************************

      Waveform audio support

****************************************************************************)

CONST

(* waveform audio error return values *)
  WAVERR_BADFORMAT       = WAVERR_BASE + 0;    (* unsupported wave format *)
  WAVERR_STILLPLAYING    = WAVERR_BASE + 1;    (* still something playing *)
  WAVERR_UNPREPARED      = WAVERR_BASE + 2;    (* header not prepared *)
  WAVERR_SYNC            = WAVERR_BASE + 3;    (* device is synchronous *)
  WAVERR_LASTERROR       = WAVERR_BASE + 3;    (* last error in range *)

TYPE
(* waveform audio data types *)
  HWAVE         = windows.HANDLE;
  HWAVEIN       = windows.HANDLE;
  HWAVEOUT      = windows.HANDLE;
  PHWAVEIN      = POINTER TO HWAVEIN;
  PHWAVEOUT     = POINTER TO HWAVEOUT;
  WAVECALLBACK  = DRVCALLBACK ;
  PWAVECALLBACK = POINTER TO WAVECALLBACK;

CONST
(* wave callback messages *)
  WOM_OPEN       = MM_WOM_OPEN;
  WOM_CLOSE      = MM_WOM_CLOSE;
  WOM_DONE       = MM_WOM_DONE;
  WIM_OPEN       = MM_WIM_OPEN;
  WIM_CLOSE      = MM_WIM_CLOSE;
  WIM_DATA       = MM_WIM_DATA;

(* device ID for wave device mapper *)
  WAVE_MAPPER     = windows.UINT( -1 );

(* flags for dwFlags parameter in waveOutOpen() and waveInOpen() *)
   WAVE_FORMAT_QUERY        = 0001H;
   WAVE_ALLOWSYNC           = 0002H;
   WAVE_MAPPED              = 0004H;
   WAVE_FORMAT_DIRECT       = 0008H;
   WAVE_FORMAT_DIRECT_QUERY = WAVE_FORMAT_QUERY OR WAVE_FORMAT_DIRECT;

TYPE
(* wave data block header *)
  PWAVEHDR = POINTER TO WAVEHDR;
  WAVEHDR = RECORD
    lpData        : windows.PSTR;                 (* pointer to locked data buffer *)
    dwBufferLength       : windows.DWORD;         (* length of data buffer *)
    dwBytesRecorded       : windows.DWORD;        (* used for input only *)
    dwUser        : windows.DWORD;                 (* for client's use *)
    dwFlags       : windows.DWORD;                (* assorted flags (see defines) *)
    dwLoops       : windows.DWORD;                (* loop control counter *)
    lpNext        : PWAVEHDR;                     (* reserved for driver *)
    reserved       : windows.DWORD;               (* reserved for driver *)
  END;

CONST
(* flags for dwFlags field of WAVEHDR *)
  WHDR_DONE        = 00000001H; (* done bit *)
  WHDR_PREPARED    = 00000002H; (* set if this header has been prepared *)
  WHDR_BEGINLOOP   = 00000004H; (* loop start block *)
  WHDR_ENDLOOP     = 00000008H; (* loop end block *)
  WHDR_INQUEUE     = 00000010H; (* reserved for driver *)

TYPE
(* waveform output device capabilities structure *)

  WAVEOUTCAPS = RECORD
    wMid    : WORD;                  (* manufacturer ID *)
    wPid    : WORD;                  (* product ID *)
    vDriverVersion : MMVERSION;      (* version of the driver *)
    szPname : ARRAY [0..MAXPNAMELEN-1] OF TCHAR;  (* product name (NULL terminated string) *)
    dwFormats   : windows.DWORD;             (* formats supported *)
    wChannels    : WORD;             (* number of sources supported *)
    wReserved1    : WORD;            (* packing *)
    dwSupport   : windows.DWORD;             (* functionality supported by driver *)
  END;
  PWAVEOUTCAPS = POINTER TO WAVEOUTCAPS;

CONST
(* flags for dwSupport field of WAVEOUTCAPS *)
  WAVECAPS_PITCH           = 0001H;  (* supports pitch control *)
  WAVECAPS_PLAYBACKRATE    = 0002H;  (* supports playback rate control *)
  WAVECAPS_VOLUME          = 0004H;  (* supports volume control *)
  WAVECAPS_LRVOLUME        = 0008H;  (* separate left-right volume control *)
  WAVECAPS_SYNC            = 0010H;
  WAVECAPS_SAMPLEACCURATE  = 0020H;
  WAVECAPS_DIRECTSOUND     = 0040H;

TYPE
(* waveform input device capabilities structure *)

  WAVEINCAPS = RECORD
    wMid           : WORD;             (* manufacturer ID *)
    wPid           : WORD;             (* product ID *)
    vDriverVersion : MMVERSION;        (* version of the driver *)
    szPname        : ARRAY[0..MAXPNAMELEN-1] OF TCHAR;    (* product name (NULL terminated string) *)
    dwFormats      : windows.DWORD;    (* formats supported *)
    wChannels      : WORD;             (* number of channels supported *)
    wReserved1     : WORD;             (* structure packing *)
  END;
  PWAVEINCAPS = POINTER TO WAVEINCAPS;

CONST
(* defines for dwFormat field of WAVEINCAPS and WAVEOUTCAPS *)
  WAVE_INVALIDFORMAT      = 00000000H;      (* invalid format *)
  WAVE_FORMAT_1M08        = 00000001H;      (* 11.025 kHz, Mono,   8-bit  *)
  WAVE_FORMAT_1S08        = 00000002H;      (* 11.025 kHz, Stereo, 8-bit  *)
  WAVE_FORMAT_1M16        = 00000004H;      (* 11.025 kHz, Mono,   16-bit *)
  WAVE_FORMAT_1S16        = 00000008H;      (* 11.025 kHz, Stereo, 16-bit *)
  WAVE_FORMAT_2M08        = 00000010H;      (* 22.05  kHz, Mono,   8-bit  *)
  WAVE_FORMAT_2S08        = 00000020H;      (* 22.05  kHz, Stereo, 8-bit  *)
  WAVE_FORMAT_2M16        = 00000040H;      (* 22.05  kHz, Mono,   16-bit *)
  WAVE_FORMAT_2S16        = 00000080H;      (* 22.05  kHz, Stereo, 16-bit *)
  WAVE_FORMAT_4M08        = 00000100H;      (* 44.1   kHz, Mono,   8-bit  *)
  WAVE_FORMAT_4S08        = 00000200H;      (* 44.1   kHz, Stereo, 8-bit  *)
  WAVE_FORMAT_4M16        = 00000400H;      (* 44.1   kHz, Mono,   16-bit *)
  WAVE_FORMAT_4S16        = 00000800H;      (* 44.1   kHz, Stereo, 16-bit *)

TYPE
(* OLD general waveform format structure (information common to all formats) *)
  WAVEFORMAT = RECORD
    wFormatTag      : WORD;        (* format type *)
    nChannels       : WORD;         (* number of channels (i.e. mono, stereo, etc.) *)
    nSamplesPerSec  : windows.DWORD;    (* sample rate *)
    nAvgBytesPerSec : windows.DWORD;   (* for buffer estimation *)
    nBlockAlign     : WORD;       (* block size of data *)
  END;
  PWAVEFORMAT = POINTER TO WAVEFORMAT;

CONST
(* flags for wFormatTag field of WAVEFORMAT *)
  WAVE_FORMAT_PCM      = 1;

TYPE
(* specific waveform format structure for PCM data *)
  PCMWAVEFORMAT = RECORD
    wf             : WAVEFORMAT;
    wBitsPerSample : WORD;
  END;
  PPCMWAVEFORMAT = POINTER TO PCMWAVEFORMAT;


(*
 *  extended waveform format structure used for all non-PCM formats. this
 *  structure is common to all non-PCM formats.
 *)

  WAVEFORMATEX = RECORD
    wFormatTag       : WORD;          (* format type *)
    nChannels        : WORD;          (* number of channels (i.e. mono, stereo...) *)
    nSamplesPerSec   : windows.DWORD; (* sample rate *)
    nAvgBytesPerSec  : windows.DWORD; (* for buffer estimation *)
    nBlockAlign      : WORD;          (* block size of data *)
    wBitsPerSample   : WORD;          (* number of bits per sample of mono data *)
    cbSize           : WORD;          (* the count in bytes of the size of *)
                                      (* extra information (after cbSize) *)
  END;
  PWAVEFORMATEX = POINTER TO WAVEFORMATEX;

(* waveform audio function prototypes *)
PROCEDURE waveOutGetNumDevs() : windows.UINT;

PROCEDURE waveOutGetDevCaps(uDeviceID : windows.UINT;  pwoc : PWAVEOUTCAPS; cbwoc : windows.UINT) : MMRESULT;

PROCEDURE waveOutGetVolume(hwo : HWAVEOUT; pdwVolume : HWAVEOUT) : MMRESULT;
PROCEDURE waveOutSetVolume(hwo : HWAVEOUT; dwVolume : windows.DWORD) : MMRESULT;

PROCEDURE waveOutGetErrorText(mmrError : MMRESULT; pszText : windows.PTSTR; cchText : windows.UINT) : MMRESULT;

PROCEDURE waveOutOpen(phwo : PHWAVEOUT; uDeviceID : windows.UINT; pwfx : PWAVEFORMATEX; dwCallback : windows.DWORD; dwInstance : windows.DWORD; fdwOpen : windows.DWORD) : MMRESULT;

PROCEDURE waveOutClose(hwo : HWAVEOUT) : MMRESULT;
PROCEDURE waveOutPrepareHeader(hwo : HWAVEOUT; pwh : PWAVEHDR; cbwh  : windows.UINT) : MMRESULT;
PROCEDURE waveOutUnprepareHeader(hwo : HWAVEOUT; pwh : PWAVEHDR; cbwh : windows.UINT) : MMRESULT;
PROCEDURE waveOutWrite(hwo : HWAVEOUT; pwh : PWAVEHDR; cbwh : windows.UINT) : MMRESULT;
PROCEDURE waveOutPause(hwo : HWAVEOUT) : MMRESULT;
PROCEDURE waveOutRestart(hwo : HWAVEOUT) : MMRESULT;
PROCEDURE waveOutReset(hwo : HWAVEOUT) : MMRESULT;
PROCEDURE waveOutBreakLoop(hwo : HWAVEOUT) : MMRESULT;
PROCEDURE waveOutGetPosition(hwo : HWAVEOUT; pmmt : PMMTIME; cbmmt : windows.UINT) : MMRESULT;
PROCEDURE waveOutGetPitch(hwo : HWAVEOUT; pdwPitch : windows.PDWORD) : MMRESULT;
PROCEDURE waveOutSetPitch(hwo : HWAVEOUT; dwPitch : windows.DWORD) : MMRESULT;
PROCEDURE waveOutGetPlaybackRate(hwo : HWAVEOUT; pdwRate : HWAVEOUT) : MMRESULT;
PROCEDURE waveOutSetPlaybackRate(hwo : HWAVEOUT; dwRate : windows.DWORD) : MMRESULT;
PROCEDURE waveOutGetID(hwo : HWAVEOUT; puDeviceID : PUINT) : MMRESULT;

PROCEDURE waveOutMessage(hwo : HWAVEOUT; uMsg : windows.UINT; dw1 : windows.DWORD; dw2 : windows.DWORD) : MMRESULT;

PROCEDURE waveInGetNumDevs() : windows.UINT;

PROCEDURE waveInGetDevCaps(uDeviceID : windows.UINT; pwic : PWAVEINCAPS; cbwic : windows.UINT) : MMRESULT;

PROCEDURE waveInGetErrorText(mmrError : MMRESULT; pszText : windows.PTSTR; cchText : windows.UINT) : MMRESULT;

PROCEDURE waveInOpen(phwi : PHWAVEIN; uDeviceID : windows.UINT; pwfx : PWAVEFORMATEX; dwCallback : windows.DWORD; dwInstance : windows.DWORD; fdwOpen : windows.DWORD) : MMRESULT;

PROCEDURE waveInClose(hwi : HWAVEIN) : MMRESULT;
PROCEDURE waveInPrepareHeader(hwi : HWAVEIN; pwh : PWAVEHDR; cbwh : windows.UINT) : MMRESULT;
PROCEDURE waveInUnprepareHeader(hwi : HWAVEIN; pwh : PWAVEHDR; cbwh : windows.UINT) : MMRESULT;
PROCEDURE waveInAddBuffer(hwi : HWAVEIN; pwh : PWAVEHDR; cbwh : windows.UINT) : MMRESULT;
PROCEDURE waveInStart(hwi : HWAVEIN) : MMRESULT;
PROCEDURE waveInStop(hwi : HWAVEIN) : MMRESULT;
PROCEDURE waveInReset(hwi : HWAVEIN) : MMRESULT;
PROCEDURE waveInGetPosition(hwi : HWAVEIN; pmmt : PMMTIME; cbmmt : windows.UINT) : MMRESULT;
PROCEDURE waveInGetID(hwi : HWAVEIN; puDeviceID : PUINT) : MMRESULT;

PROCEDURE waveInMessage(hwi : HWAVEIN; uMsg : windows.UINT; dw1 : windows.DWORD; dw2 : windows.DWORD) : MMRESULT;

(****************************************************************************

          MIDI audio support

****************************************************************************)

CONST
(* MIDI error return values *)
  MIDIERR_UNPREPARED     = MIDIERR_BASE + 0;   (* header not prepared *)
  MIDIERR_STILLPLAYING   = MIDIERR_BASE + 1;   (* still something playing *)
  MIDIERR_NOMAP          = MIDIERR_BASE + 2;   (* no configured instruments *)
  MIDIERR_NOTREADY       = MIDIERR_BASE + 3;   (* hardware is still busy *)
  MIDIERR_NODEVICE       = MIDIERR_BASE + 4;   (* port no longer connected *)
  MIDIERR_INVALIDSETUP   = MIDIERR_BASE + 5;   (* invalid MIF *)
  MIDIERR_BADOPENMODE    = MIDIERR_BASE + 6;   (* operation unsupported w/ open mode *)
  MIDIERR_DONT_CONTINUE  = MIDIERR_BASE + 7;   (* thru device 'eating' a message *)
  MIDIERR_LASTERROR      = MIDIERR_BASE + 7;   (* last error in range *)

TYPE
(* MIDI audio data types *)
  HMIDI         = windows.HANDLE;
  HMIDIIN       = windows.HANDLE;
  HMIDIOUT      = windows.HANDLE;
  HMIDISTRM     = windows.HANDLE;
  PHMIDI        = POINTER TO HMIDI;
  PHMIDIIN      = POINTER TO HMIDIIN;
  PHMIDIOUT     = POINTER TO HMIDIOUT;
  PHMIDISTRM    = POINTER TO HMIDISTRM;
  MIDICALLBACK  = DRVCALLBACK ;
  PMIDICALLBACK = POINTER TO MIDICALLBACK;

CONST
  MIDIPATCHSIZE    = 12;

TYPE
 PATCHARRAY  = ARRAY [0..MIDIPATCHSIZE-1] OF WORD;
 PPATCHARRAY = POINTER TO WORD;
 KEYARRAY    = ARRAY [0..MIDIPATCHSIZE-1] OF WORD ;
 PKEYARRAY   = POINTER TO WORD;

CONST
(* MIDI callback messages *)
  MIM_OPEN        = MM_MIM_OPEN;
  MIM_CLOSE       = MM_MIM_CLOSE;
  MIM_DATA        = MM_MIM_DATA;
  MIM_LONGDATA    = MM_MIM_LONGDATA;
  MIM_ERROR       = MM_MIM_ERROR;
  MIM_LONGERROR   = MM_MIM_LONGERROR;
  MOM_OPEN        = MM_MOM_OPEN;
  MOM_CLOSE       = MM_MOM_CLOSE;
  MOM_DONE        = MM_MOM_DONE;

  MIM_MOREDATA      = MM_MIM_MOREDATA;
  MOM_POSITIONCB    = MM_MOM_POSITIONCB;

(* device ID for MIDI mapper *)
  MIDIMAPPER     = windows.UINT( -1 );
  MIDI_MAPPER    = windows.UINT( -1 );

(* flags for dwFlags parm of midiInOpen() *)
  MIDI_IO_STATUS       = 00000020H;

(* flags for wFlags parm of midiOutCachePatches(), midiOutCacheDrumPatches() *)
  MIDI_CACHE_ALL       = 1;
  MIDI_CACHE_BESTFIT   = 2;
  MIDI_CACHE_QUERY     = 3;
  MIDI_UNCACHE         = 4;

TYPE
(* MIDI output device capabilities structure *)

  MIDIOUTCAPS = RECORD
    wMid    : WORD;                  (* manufacturer ID *)
    wPid    : WORD;                  (* product ID *)
    vDriverVersion : MMVERSION;      (* version of the driver *)
    szPname : ARRAY [0..MAXPNAMELEN-1] OF TCHAR;  (* product name (NULL terminated string) *)
    wTechnology    : WORD;           (* type of device *)
    wVoices    : WORD;               (* # of voices (internal synth only) *)
    wNotes    : WORD;                (* max # of notes (internal synth only) *)
    wChannelMask    : WORD;          (* channels used (internal synth only) *)
    dwSupport   : windows.DWORD;             (* functionality supported by driver *)
  END;
  PMIDIOUTCAPS = POINTER TO MIDIOUTCAPS;

CONST
(* flags for wTechnology field of MIDIOUTCAPS structure *)
  MOD_MIDIPORT     = 1; (* output port *)
  MOD_SYNTH        = 2; (* generic internal synth *)
  MOD_SQSYNTH      = 3; (* square wave internal synth *)
  MOD_FMSYNTH      = 4; (* FM internal synth *)
  MOD_MAPPER       = 5; (* MIDI mapper *)

(* flags for dwSupport field of MIDIOUTCAPS structure *)
  MIDICAPS_VOLUME           = 0001H; (* supports volume control *)
  MIDICAPS_LRVOLUME         = 0002H; (* separate left-right volume control *)
  MIDICAPS_CACHE            = 0004H;
  MIDICAPS_STREAM           = 0008H; (* driver supports midiStreamOut directly *)

TYPE
(* MIDI input device capabilities structure *)

  MIDIINCAPS = RECORD
    wMid           : WORD;                              (* manufacturer ID *)
    wPid           : WORD;                              (* product ID *)
    vDriverVersion : MMVERSION;                         (* version of the driver *)
    szPname        : ARRAY[0..MAXPNAMELEN-1] OF TCHAR;   (* product name (NULL terminated string) *)
    dwSupport      : windows.DWORD;                     (* functionality supported by driver *)
  END;
  PMIDIINCAPS = POINTER TO MIDIINCAPS;

(* MIDI data block header *)
  PMIDIHDR = POINTER TO MIDIHDR;
  MIDIHDR = RECORD
    lpData             : windows.PSTR;                 (* pointer to locked data block *)
    dwBufferLength     : windows.DWORD;                (* length of data in data block *)
    dwBytesRecorded    : windows.DWORD;                (* used for input only *)
    dwUser             : windows.DWORD;                (* for client's use *)
    dwFlags            : windows.DWORD;                (* assorted flags (see defines) *)
    lpNext             : PMIDIHDR;                     (* reserved for driver *)
    reserved           : windows.DWORD;                (* reserved for driver *)
    dwOffset           : windows.DWORD;                (* Callback offset into buffer *)
    dwReserved         : ARRAY[0..7] OF windows.DWORD; (* Reserved for MMSYSTEM *)
  END;

  MIDIEVENT = RECORD
    dwDeltaTime : windows.DWORD;          (* Ticks since last event *)
    dwStreamID  : windows.DWORD;          (* Reserved; must be zero *)
    dwEvent     : windows.DWORD;          (* Event type and parameters *)
    dwParms     : ARRAY[0..0] OF windows.DWORD;   (* Parameters if this is a long event *)
  END;

  MIDISTRMBUFFVER = RECORD
    dwVersion    : windows.DWORD;         (* Stream buffer format version *)
    dwMid        : windows.DWORD;         (* Manufacturer ID as defined in MMREG.H *)
    dwOEMVersion : windows.DWORD;         (* Manufacturer version for custom ext *)
  END;

CONST
(* flags for dwFlags field of MIDIHDR structure *)
  MHDR_DONE        = 00000001H;      (* done bit *)
  MHDR_PREPARED    = 00000002H;      (* set if header prepared *)
  MHDR_INQUEUE     = 00000004H;      (* reserved for driver *)
  MHDR_ISSTRM      = 00000008H;      (* Buffer is stream buffer *)

(* *)
(* Type codes which go in the high byte of the event DWORD of a stream buffer *)
(* *)
(* Type codes 00-7F contain parameters within the low 24 bits *)
(* Type codes 80-FF contain a length of their parameter in the low 24 *)
(* bits, followed by their parameter data in the buffer. The event *)
(* DWORD contains the exact byte length; the parm data itself must be *)
(* padded to be an even multiple of 4 bytes long. *)
(* *)

  MEVT_F_SHORT         = 00000000H;
  MEVT_F_LONG          = 80000000H;
  MEVT_F_CALLBACK      = 40000000H;

(*# save, call( macro => on ) *)
PROCEDURE MEVT_EVENTTYPE( x : windows.DWORD ) : BYTE;
PROCEDURE MEVT_EVENTPARM( x : windows.DWORD ) : windows.DWORD;
(*# restore *)

CONST
  MEVT_SHORTMSG      = BYTE( 00H );    (* parm = shortmsg for midiOutShortMsg *)
  MEVT_TEMPO         = BYTE( 01H );    (* parm = new tempo in microsec/qn     *)
  MEVT_NOP           = BYTE( 02H );    (* parm = unused; does nothing         *)

(* 0x04-0x7F reserved *)

  MEVT_LONGMSG       = BYTE( 80H );    (* parm = bytes to send verbatim       *)
  MEVT_COMMENT       = BYTE( 82H );    (* parm = comment data                 *)
  MEVT_VERSION       = BYTE( 84H );    (* parm = MIDISTRMBUFFVER struct       *)

(* 0x81-0xFF reserved *)

  MIDISTRM_ERROR       = -2;

(* *)
(* Structures and defines for midiStreamProperty *)
(* *)
  MIDIPROP_SET         = 80000000H;
  MIDIPROP_GET         = 40000000H;

(* These are intentionally both non-zero so the app cannot accidentally *)
(* leave the operation off and happen to appear to work due to default *)
(* action. *)

  MIDIPROP_TIMEDIV     = 00000001H;
  MIDIPROP_TEMPO       = 00000002H;

TYPE
  MIDIPROPTIMEDIV = RECORD
    cbStruct  : windows.DWORD;
    dwTimeDiv : windows.DWORD;
  END;
  PMIDIPROPTIMEDIV = POINTER TO MIDIPROPTIMEDIV;

  MIDIPROPTEMPO = RECORD
    cbStruct  : windows.DWORD;
    dwTempo   : windows.DWORD;
  END;
  PMIDIPROPTEMPO = POINTER TO MIDIPROPTEMPO;

(* MIDI function prototypes *)
PROCEDURE midiOutGetNumDevs() : windows.UINT;
PROCEDURE midiStreamOpen(phms : PHMIDISTRM; puDeviceID : PUINT; cMidi : windows.DWORD; dwCallback : windows.DWORD; dwInstance : windows.DWORD; fdwOpen : windows.DWORD) : MMRESULT;
PROCEDURE midiStreamClose(hms : HMIDISTRM) : MMRESULT;

PROCEDURE midiStreamProperty(hms : HMIDISTRM; lppropdata : windows.PBYTE; dwProperty : windows.DWORD) : MMRESULT;
PROCEDURE midiStreamPosition(hms : HMIDISTRM; lpmmt : PMMTIME; cbmmt : windows.UINT) : MMRESULT;

PROCEDURE midiStreamOut(hms : HMIDISTRM; pmh : PMIDIHDR; cbmh : windows.UINT) : MMRESULT;
PROCEDURE midiStreamPause(hms : HMIDISTRM) : MMRESULT;
PROCEDURE midiStreamRestart(hms : HMIDISTRM) : MMRESULT;
PROCEDURE midiStreamStop(hms : HMIDISTRM) : MMRESULT;

PROCEDURE midiConnect(hmi : HMIDI; hmo : HMIDIOUT; pReserved : windows.PVOID ) : MMRESULT;
PROCEDURE midiDisconnect(hmi : HMIDI; hmo : HMIDIOUT; pReserved : windows.PVOID ) : MMRESULT;


PROCEDURE midiOutGetDevCaps( uDeviceID : windows.UINT; pmoc : PMIDIOUTCAPS; cbmoc : windows.UINT) : MMRESULT;

PROCEDURE midiOutGetVolume(hmo : HMIDIOUT; pdwVolume : HWAVEOUT) : MMRESULT;
PROCEDURE midiOutSetVolume(hmo : HMIDIOUT; dwVolume : windows.DWORD) : MMRESULT;

PROCEDURE midiOutGetErrorText(mmrError : MMRESULT; pszText : windows.PTSTR; cchText : windows.UINT) : MMRESULT;

PROCEDURE midiOutOpen(phmo : PHMIDIOUT; uDeviceID : windows.UINT; dwCallback : windows.DWORD; dwInstance : windows.DWORD; fdwOpen : windows.DWORD) : MMRESULT;
PROCEDURE midiOutClose(hmo : HMIDIOUT) : MMRESULT;
PROCEDURE midiOutPrepareHeader(hmo : HMIDIOUT; pmh : PMIDIHDR; cbmh : windows.UINT) : MMRESULT;
PROCEDURE midiOutUnprepareHeader(hmo : HMIDIOUT; pmh : PMIDIHDR; cbmh : windows.UINT) : MMRESULT;
PROCEDURE midiOutShortMsg(hmo : HMIDIOUT; dwMsg : windows.DWORD) : MMRESULT;
PROCEDURE midiOutLongMsg(hmo : HMIDIOUT; pmh : PMIDIHDR; cbmh : windows.UINT) : MMRESULT;
PROCEDURE midiOutReset(hmo : HMIDIOUT) : MMRESULT;
PROCEDURE midiOutCachePatches(hmo : HMIDIOUT; uBank : windows.UINT; pwpa : windows.PWORD; fuCache : windows.UINT) : MMRESULT;
PROCEDURE midiOutCacheDrumPatches(hmo : HMIDIOUT; uPatch : windows.UINT; pwkya : windows.PWORD; fuCache : windows.UINT) : MMRESULT;
PROCEDURE midiOutGetID(hmo : HMIDIOUT; puDeviceID : PUINT) : MMRESULT;

PROCEDURE midiOutMessage(hmo : HMIDIOUT; uMsg : windows.UINT; dw1 : windows.DWORD; dw2 : windows.DWORD) : MMRESULT;

PROCEDURE midiInGetNumDevs() : windows.UINT;

PROCEDURE midiInGetDevCaps( uDeviceID : windows.UINT; pmic : PMIDIINCAPS; cbmic : windows.UINT) : MMRESULT;
PROCEDURE midiInGetErrorText(mmrError : MMRESULT; pszText : windows.PTSTR; cchText : windows.UINT) : MMRESULT;

PROCEDURE midiInOpen(phmi : PHMIDIIN; uDeviceID : windows.UINT; dwCallback : windows.DWORD; dwInstance : windows.DWORD; fdwOpen : windows.DWORD) : MMRESULT;
PROCEDURE midiInClose(hmi : HMIDIIN) : MMRESULT;
PROCEDURE midiInPrepareHeader(hmi : HMIDIIN; pmh : PMIDIHDR; cbmh : windows.UINT) : MMRESULT;
PROCEDURE midiInUnprepareHeader(hmi : HMIDIIN; pmh : PMIDIHDR; cbmh : windows.UINT) : MMRESULT;
PROCEDURE midiInAddBuffer(hmi : HMIDIIN; pmh : PMIDIHDR; cbmh : windows.UINT) : MMRESULT;
PROCEDURE midiInStart(hmi : HMIDIIN) : MMRESULT;
PROCEDURE midiInStop(hmi : HMIDIIN) : MMRESULT;
PROCEDURE midiInReset(hmi : HMIDIIN) : MMRESULT;
PROCEDURE midiInGetID(hmi : HMIDIIN; puDeviceID : PUINT) : MMRESULT;

PROCEDURE midiInMessage(hmi : HMIDIIN; uMsg : windows.UINT; dw1 : windows.DWORD; dw2 : windows.DWORD) : MMRESULT;

(****************************************************************************

      Auxiliary audio support

****************************************************************************)

CONST
(* device ID for aux device mapper *)
 AUX_MAPPER     = windows.UINT( -1 );

TYPE
(* Auxiliary audio device capabilities structure *)

  AUXCAPS = RECORD
    wMid        : WORD;                (* manufacturer ID *)
    wPid        : WORD;                (* product ID *)
    vDriverVersion : MMVERSION;        (* version of the driver *)
    szPname : ARRAY [0..MAXPNAMELEN-1] OF TCHAR;(* product name (NULL terminated string) *)
    wTechnology     : WORD;            (* type of device *)
    wReserved1      : WORD;            (* padding *)
    dwSupport       : windows.DWORD;   (* functionality supported by driver *)
  END;
  PAUXCAPS = POINTER TO AUXCAPS;

CONST
(* flags for wTechnology field in AUXCAPS structure *)
  AUXCAPS_CDAUDIO     = 1;      (* audio from internal CD-ROM drive *)
  AUXCAPS_AUXIN       = 2;      (* audio from auxiliary input jacks *)

(* flags for dwSupport field in AUXCAPS structure *)
  AUXCAPS_VOLUME      = 0001H; (* supports volume control *)
  AUXCAPS_LRVOLUME    = 0002H; (* separate left-right volume control *)

(* auxiliary audio function prototypes *)
PROCEDURE auxGetNumDevs() : windows.UINT;

PROCEDURE auxGetDevCaps( uDeviceID : windows.UINT; pac : PAUXCAPS; cbac : windows.UINT) : MMRESULT;

PROCEDURE auxSetVolume( uDeviceID : windows.UINT; dwVolume : windows.DWORD) : MMRESULT;
PROCEDURE auxGetVolume( uDeviceID : windows.UINT; pdwVolume : HWAVEOUT) : MMRESULT;

PROCEDURE auxOutMessage( uDeviceID : windows.UINT; uMsg : windows.UINT; dw1 : windows.DWORD; dw2 : windows.DWORD) : MMRESULT;

(****************************************************************************

          Mixer Support

****************************************************************************)

TYPE
  HMIXEROBJ  = windows.HANDLE;
  PHMIXEROBJ = POINTER TO HMIXEROBJ;

  HMIXER     = windows.HANDLE;
  PHMIXER    = POINTER TO HMIXER;

CONST
  MIXER_SHORT_NAME_CHARS    = 1;
  MIXER_LONG_NAME_CHARS     = 6;

(* *)
(*  MMRESULT error return values specific to the mixer API *)
(* *)
  MIXERR_INVALLINE             = MIXERR_BASE + 0;
  MIXERR_INVALCONTROL          = MIXERR_BASE + 1;
  MIXERR_INVALVALUE            = MIXERR_BASE + 2;
  MIXERR_LASTERROR             = MIXERR_BASE + 2;

  MIXER_OBJECTF_HANDLE     = 80000000H;
  MIXER_OBJECTF_MIXER      = 00000000H;
  MIXER_OBJECTF_HMIXER     = MIXER_OBJECTF_HANDLE OR MIXER_OBJECTF_MIXER;
  MIXER_OBJECTF_WAVEOUT    = 10000000H;
  MIXER_OBJECTF_HWAVEOUT   = MIXER_OBJECTF_HANDLE OR MIXER_OBJECTF_WAVEOUT;
  MIXER_OBJECTF_WAVEIN     = 20000000H;
  MIXER_OBJECTF_HWAVEIN    = MIXER_OBJECTF_HANDLE OR MIXER_OBJECTF_WAVEIN;
  MIXER_OBJECTF_MIDIOUT    = 30000000H;
  MIXER_OBJECTF_HMIDIOUT   = MIXER_OBJECTF_HANDLE OR MIXER_OBJECTF_MIDIOUT;
  MIXER_OBJECTF_MIDIIN     = 40000000H;
  MIXER_OBJECTF_HMIDIIN    = MIXER_OBJECTF_HANDLE OR MIXER_OBJECTF_MIDIIN;
  MIXER_OBJECTF_AUX        = 50000000H;

PROCEDURE mixerGetNumDevs() : windows.UINT;

TYPE
  MIXERCAPS = RECORD
    wMid            : WORD;                   (* manufacturer id *)
    wPid            : WORD;                   (* product id *)
    vDriverVersion  : MMVERSION;              (* version of the driver *)
    szPname         : ARRAY [0..MAXPNAMELEN-1] OF TCHAR;   (* product name *)
    fdwSupport      : windows.DWORD;          (* misc. support bits *)
    cDestinations   : windows.DWORD;          (* count of destinations *)
  END;
  PMIXERCAPS = POINTER TO MIXERCAPS;

PROCEDURE mixerGetDevCaps( uMxId : windows.UINT; pmxcaps : PMIXERCAPS; cbmxcaps : windows.UINT) : MMRESULT;

PROCEDURE mixerOpen( phmx : PHMIXER; uMxId : windows.UINT; dwCallback : windows.DWORD; dwInstance : windows.DWORD; fdwOpen : windows.DWORD) : MMRESULT;

PROCEDURE mixerClose(hmx : HMIXER) : MMRESULT;

PROCEDURE mixerMessage(hmx : HMIXER; uMsg : windows.UINT; dwParam1 : windows.DWORD; dwParam2 : windows.DWORD) : windows.DWORD;

TYPE
  MIXERLINE = RECORD
    cbStruct        : windows.DWORD;        (* size of MIXERLINE structure *)
    dwDestination   : windows.DWORD;        (* zero based destination index *)
    dwSource        : windows.DWORD;        (* zero based source index (if source) *)
    dwLineID        : windows.DWORD;        (* unique line id for mixer device *)
    fdwLine         : windows.DWORD;        (* state/information about line *)
    dwUser          : windows.DWORD;        (* driver specific information *)
    dwComponentType : windows.DWORD;        (* component type line connects to *)
    cChannels       : windows.DWORD;        (* number of channels line supports *)
    cConnections    : windows.DWORD;        (* number of connections [possible] *)
    cControls       : windows.DWORD;        (* number of controls at this line *)
    szShortName     : ARRAY [0..MIXER_SHORT_NAME_CHARS-1] OF TCHAR;
    szName          : ARRAY [0..MIXER_LONG_NAME_CHARS-1] OF TCHAR;
    Target : RECORD
      dwType         : windows.DWORD;       (* MIXERLINE_TARGETTYPE_xxxx *)
      dwDeviceID     : windows.DWORD;       (* target device ID of device type *)
      wMid           : WORD;                (* of target device *)
      wPid           : WORD;                (*      " *)
      vDriverVersion : MMVERSION;           (*      " *)
      szPname        : ARRAY [0..MAXPNAMELEN-1] OF TCHAR;   (*      " *)
    END;
  END;
  PMIXERLINE = POINTER TO MIXERLINE;

CONST
(* *)
(*  MIXERLINE.fdwLine *)
(* *)
  MIXERLINE_LINEF_ACTIVE               = 00000001H;
  MIXERLINE_LINEF_DISCONNECTED         = 00008000H;
  MIXERLINE_LINEF_SOURCE               = 80000000H;

(* *)
(*  MIXERLINE.dwComponentType *)
(* *)
(*  component types for destinations and sources *)
(* *)
  MIXERLINE_COMPONENTTYPE_DST_FIRST        = 00000000H;
  MIXERLINE_COMPONENTTYPE_DST_UNDEFINED    = MIXERLINE_COMPONENTTYPE_DST_FIRST + 0;
  MIXERLINE_COMPONENTTYPE_DST_DIGITAL      = MIXERLINE_COMPONENTTYPE_DST_FIRST + 1;
  MIXERLINE_COMPONENTTYPE_DST_LINE         = MIXERLINE_COMPONENTTYPE_DST_FIRST + 2;
  MIXERLINE_COMPONENTTYPE_DST_MONITOR      = MIXERLINE_COMPONENTTYPE_DST_FIRST + 3;
  MIXERLINE_COMPONENTTYPE_DST_SPEAKERS     = MIXERLINE_COMPONENTTYPE_DST_FIRST + 4;
  MIXERLINE_COMPONENTTYPE_DST_HEADPHONES   = MIXERLINE_COMPONENTTYPE_DST_FIRST + 5;
  MIXERLINE_COMPONENTTYPE_DST_TELEPHONE    = MIXERLINE_COMPONENTTYPE_DST_FIRST + 6;
  MIXERLINE_COMPONENTTYPE_DST_WAVEIN       = MIXERLINE_COMPONENTTYPE_DST_FIRST + 7;
  MIXERLINE_COMPONENTTYPE_DST_VOICEIN      = MIXERLINE_COMPONENTTYPE_DST_FIRST + 8;
  MIXERLINE_COMPONENTTYPE_DST_LAST         = MIXERLINE_COMPONENTTYPE_DST_FIRST + 8;

  MIXERLINE_COMPONENTTYPE_SRC_FIRST        = 00001000H;
  MIXERLINE_COMPONENTTYPE_SRC_UNDEFINED    = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 0;
  MIXERLINE_COMPONENTTYPE_SRC_DIGITAL      = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 1;
  MIXERLINE_COMPONENTTYPE_SRC_LINE         = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 2;
  MIXERLINE_COMPONENTTYPE_SRC_MICROPHONE   = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 3;
  MIXERLINE_COMPONENTTYPE_SRC_SYNTHESIZER  = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 4;
  MIXERLINE_COMPONENTTYPE_SRC_COMPACTDISC  = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 5;
  MIXERLINE_COMPONENTTYPE_SRC_TELEPHONE    = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 6;
  MIXERLINE_COMPONENTTYPE_SRC_PCSPEAKER    = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 7;
  MIXERLINE_COMPONENTTYPE_SRC_WAVEOUT      = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 8;
  MIXERLINE_COMPONENTTYPE_SRC_AUXILIARY    = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 9;
  MIXERLINE_COMPONENTTYPE_SRC_ANALOG       = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 10;
  MIXERLINE_COMPONENTTYPE_SRC_LAST         = MIXERLINE_COMPONENTTYPE_SRC_FIRST + 10;

(* *)
(*  MIXERLINE.Target.dwType *)
(* *)
(* *)
  MIXERLINE_TARGETTYPE_UNDEFINED       = 0;
  MIXERLINE_TARGETTYPE_WAVEOUT         = 1;
  MIXERLINE_TARGETTYPE_WAVEIN          = 2;
  MIXERLINE_TARGETTYPE_MIDIOUT         = 3;
  MIXERLINE_TARGETTYPE_MIDIIN          = 4;
  MIXERLINE_TARGETTYPE_AUX             = 5;


PROCEDURE mixerGetLineInfo( hmxobj : HMIXEROBJ; pmxl : PMIXERLINE; fdwInfo : windows.DWORD) : MMRESULT;

CONST
  MIXER_GETLINEINFOF_DESTINATION       = 00000000H;
  MIXER_GETLINEINFOF_SOURCE            = 00000001H;
  MIXER_GETLINEINFOF_LINEID            = 00000002H;
  MIXER_GETLINEINFOF_COMPONENTTYPE     = 00000003H;
  MIXER_GETLINEINFOF_TARGETTYPE        = 00000004H;

  MIXER_GETLINEINFOF_QUERYMASK         = 0000000FH;

PROCEDURE mixerGetID(hmxobj : HMIXEROBJ; puMxId : PUINT; fdwId : windows.DWORD) : MMRESULT;

TYPE
(* *)
(*  MIXERCONTROL *)
(* *)

  MIXERCONTROL = RECORD
    cbStruct        : windows.DWORD;     (* size in bytes of MIXERCONTROL *)
    dwControlID     : windows.DWORD;     (* unique control id for mixer device *)
    dwControlType   : windows.DWORD;     (* MIXERCONTROL_CONTROLTYPE_xxx *)
    fdwControl      : windows.DWORD;     (* MIXERCONTROL_CONTROLF_xxx *)
    cMultipleItems  : windows.DWORD;     (* if MIXERCONTROL_CONTROLF_MULTIPLE set *)
    szShortName     : ARRAY [0..MIXER_SHORT_NAME_CHARS-1] OF TCHAR;
    szName          : ARRAY [0..MIXER_LONG_NAME_CHARS-1] OF TCHAR;
    CASE : CARDINAL OF (* Bounds *)
    | 1 :
      lMinimum : windows.LONG;           (* signed minimum for this control *)
      lMaximum : windows.LONG;           (* signed maximum for this control *)
    | 2 :
      dwMinimum   : windows.DWORD;       (* unsigned minimum for this control *)
      dwMaximum   : windows.DWORD;       (* unsigned maximum for this control *)
    | 3 :
      dwReserved  : ARRAY[0..5] OF windows.DWORD;
    END;
    CASE : CARDINAL OF (* Metrics *)
    | 1 :
      cSteps       : windows.DWORD;      (* # of steps between min & max *)
    | 2 :
      cbCustomData : windows.DWORD;      (* size in bytes of custom data *)
    | 3 :
      dwReserved2  : ARRAY [0..5] OF windows.DWORD;      (* !!! needed? we have cbStruct.... *)
    END;
  END;
  PMIXERCONTROL = POINTER TO MIXERCONTROL;

CONST
(* *)
(*  MIXERCONTROL.fdwControl *)
(* *)
  MIXERCONTROL_CONTROLF_UNIFORM    = 00000001H;
  MIXERCONTROL_CONTROLF_MULTIPLE   = 00000002H;
  MIXERCONTROL_CONTROLF_DISABLED   = 80000000H;

(* *)
(*  MIXERCONTROL_CONTROLTYPE_xxx building block defines *)
(* *)
  MIXERCONTROL_CT_CLASS_MASK           = 0F0000000H;
  MIXERCONTROL_CT_CLASS_CUSTOM         = 00000000H;
  MIXERCONTROL_CT_CLASS_METER          = 10000000H;
  MIXERCONTROL_CT_CLASS_SWITCH         = 20000000H;
  MIXERCONTROL_CT_CLASS_NUMBER         = 30000000H;
  MIXERCONTROL_CT_CLASS_SLIDER         = 40000000H;
  MIXERCONTROL_CT_CLASS_FADER          = 50000000H;
  MIXERCONTROL_CT_CLASS_TIME           = 60000000H;
  MIXERCONTROL_CT_CLASS_LIST           = 70000000H;

  MIXERCONTROL_CT_SUBCLASS_MASK        = 0F000000H;

  MIXERCONTROL_CT_SC_SWITCH_BOOLEAN    = 00000000H;
  MIXERCONTROL_CT_SC_SWITCH_BUTTON     = 01000000H;

  MIXERCONTROL_CT_SC_METER_POLLED      = 00000000H;

  MIXERCONTROL_CT_SC_TIME_MICROSECS    = 00000000H;
  MIXERCONTROL_CT_SC_TIME_MILLISECS    = 01000000H;

  MIXERCONTROL_CT_SC_LIST_SINGLE       = 00000000H;
  MIXERCONTROL_CT_SC_LIST_MULTIPLE     = 01000000H;

  MIXERCONTROL_CT_UNITS_MASK           = 00FF0000H;
  MIXERCONTROL_CT_UNITS_CUSTOM         = 00000000H;
  MIXERCONTROL_CT_UNITS_BOOLEAN        = 00010000H;
  MIXERCONTROL_CT_UNITS_SIGNED         = 00020000H;
  MIXERCONTROL_CT_UNITS_UNSIGNED       = 00030000H;
  MIXERCONTROL_CT_UNITS_DECIBELS       = 00040000H; (* in 10ths *)
  MIXERCONTROL_CT_UNITS_PERCENT        = 00050000H; (* in 10ths *)

(* *)
(*  Commonly used control types for specifying MIXERCONTROL.dwControlType *)
(* *)

  MIXERCONTROL_CONTROLTYPE_CUSTOM          = MIXERCONTROL_CT_CLASS_CUSTOM OR MIXERCONTROL_CT_UNITS_CUSTOM;
  MIXERCONTROL_CONTROLTYPE_BOOLEANMETER    = MIXERCONTROL_CT_CLASS_METER OR MIXERCONTROL_CT_SC_METER_POLLED OR MIXERCONTROL_CT_UNITS_BOOLEAN;
  MIXERCONTROL_CONTROLTYPE_SIGNEDMETER     = MIXERCONTROL_CT_CLASS_METER OR MIXERCONTROL_CT_SC_METER_POLLED OR MIXERCONTROL_CT_UNITS_SIGNED;
  MIXERCONTROL_CONTROLTYPE_PEAKMETER       = MIXERCONTROL_CONTROLTYPE_SIGNEDMETER + 1;
  MIXERCONTROL_CONTROLTYPE_UNSIGNEDMETER   = MIXERCONTROL_CT_CLASS_METER OR MIXERCONTROL_CT_SC_METER_POLLED OR MIXERCONTROL_CT_UNITS_UNSIGNED;
  MIXERCONTROL_CONTROLTYPE_BOOLEAN         = MIXERCONTROL_CT_CLASS_SWITCH OR MIXERCONTROL_CT_SC_SWITCH_BOOLEAN OR MIXERCONTROL_CT_UNITS_BOOLEAN;
  MIXERCONTROL_CONTROLTYPE_ONOFF           = MIXERCONTROL_CONTROLTYPE_BOOLEAN + 1;
  MIXERCONTROL_CONTROLTYPE_MUTE            = MIXERCONTROL_CONTROLTYPE_BOOLEAN + 2;
  MIXERCONTROL_CONTROLTYPE_MONO            = MIXERCONTROL_CONTROLTYPE_BOOLEAN + 3;
  MIXERCONTROL_CONTROLTYPE_LOUDNESS        = MIXERCONTROL_CONTROLTYPE_BOOLEAN + 4;
  MIXERCONTROL_CONTROLTYPE_STEREOENH       = MIXERCONTROL_CONTROLTYPE_BOOLEAN + 5;
  MIXERCONTROL_CONTROLTYPE_BUTTON          = MIXERCONTROL_CT_CLASS_SWITCH OR MIXERCONTROL_CT_SC_SWITCH_BUTTON OR MIXERCONTROL_CT_UNITS_BOOLEAN;
  MIXERCONTROL_CONTROLTYPE_DECIBELS        = MIXERCONTROL_CT_CLASS_NUMBER OR MIXERCONTROL_CT_UNITS_DECIBELS;
  MIXERCONTROL_CONTROLTYPE_SIGNED          = MIXERCONTROL_CT_CLASS_NUMBER OR MIXERCONTROL_CT_UNITS_SIGNED;
  MIXERCONTROL_CONTROLTYPE_UNSIGNED        = MIXERCONTROL_CT_CLASS_NUMBER OR MIXERCONTROL_CT_UNITS_UNSIGNED;
  MIXERCONTROL_CONTROLTYPE_PERCENT         = MIXERCONTROL_CT_CLASS_NUMBER OR MIXERCONTROL_CT_UNITS_PERCENT;
  MIXERCONTROL_CONTROLTYPE_SLIDER          = MIXERCONTROL_CT_CLASS_SLIDER OR MIXERCONTROL_CT_UNITS_SIGNED;
  MIXERCONTROL_CONTROLTYPE_PAN             = MIXERCONTROL_CONTROLTYPE_SLIDER + 1;
  MIXERCONTROL_CONTROLTYPE_QSOUNDPAN       = MIXERCONTROL_CONTROLTYPE_SLIDER + 2;
  MIXERCONTROL_CONTROLTYPE_FADER           = MIXERCONTROL_CT_CLASS_FADER OR MIXERCONTROL_CT_UNITS_UNSIGNED;
  MIXERCONTROL_CONTROLTYPE_VOLUME          = MIXERCONTROL_CONTROLTYPE_FADER + 1;
  MIXERCONTROL_CONTROLTYPE_BASS            = MIXERCONTROL_CONTROLTYPE_FADER + 2;
  MIXERCONTROL_CONTROLTYPE_TREBLE          = MIXERCONTROL_CONTROLTYPE_FADER + 3;
  MIXERCONTROL_CONTROLTYPE_EQUALIZER       = MIXERCONTROL_CONTROLTYPE_FADER + 4;
  MIXERCONTROL_CONTROLTYPE_SINGLESELECT    = MIXERCONTROL_CT_CLASS_LIST OR MIXERCONTROL_CT_SC_LIST_SINGLE OR MIXERCONTROL_CT_UNITS_BOOLEAN;
  MIXERCONTROL_CONTROLTYPE_MUX             = MIXERCONTROL_CONTROLTYPE_SINGLESELECT + 1;
  MIXERCONTROL_CONTROLTYPE_MULTIPLESELECT  = MIXERCONTROL_CT_CLASS_LIST OR MIXERCONTROL_CT_SC_LIST_MULTIPLE OR MIXERCONTROL_CT_UNITS_BOOLEAN;
  MIXERCONTROL_CONTROLTYPE_MIXER           = MIXERCONTROL_CONTROLTYPE_MULTIPLESELECT + 1;
  MIXERCONTROL_CONTROLTYPE_MICROTIME       = MIXERCONTROL_CT_CLASS_TIME OR MIXERCONTROL_CT_SC_TIME_MICROSECS OR MIXERCONTROL_CT_UNITS_UNSIGNED;
  MIXERCONTROL_CONTROLTYPE_MILLITIME       = MIXERCONTROL_CT_CLASS_TIME OR MIXERCONTROL_CT_SC_TIME_MILLISECS OR MIXERCONTROL_CT_UNITS_UNSIGNED;

TYPE
(* *)
(*  MIXERLINECONTROLS *)
(* *)

  MIXERLINECONTROLS = RECORD
    cbStruct           : windows.DWORD;       (* size in bytes of MIXERLINECONTROLS *)
    dwLineID           : windows.DWORD;       (* line id (from MIXERLINE.dwLineID) *)
    CASE : CARDINAL OF 
    | 1 :
      dwControlID      : windows.DWORD;    (* MIXER_GETLINECONTROLSF_ONEBYID *)
    | 2 :
      dwControlType    : windows.DWORD;  (* MIXER_GETLINECONTROLSF_ONEBYTYPE *)
    END;
    cControls          : windows.DWORD;      (* count of controls pmxctrl points to *)
    cbmxctrl           : windows.DWORD;       (* size in bytes of _one_ MIXERCONTROL *)
    pamxctrl           : PMIXERCONTROL;       (* pointer to first MIXERCONTROL array *)
  END;
  PMIXERLINECONTROLS = POINTER TO MIXERLINECONTROLS;

(* *)
(* *)

PROCEDURE mixerGetLineControls( hmxobj : HMIXEROBJ; pmxlc : PMIXERLINECONTROLS; fdwControls : windows.DWORD) : MMRESULT;

CONST
  MIXER_GETLINECONTROLSF_ALL           = 00000000H;
  MIXER_GETLINECONTROLSF_ONEBYID       = 00000001H;
  MIXER_GETLINECONTROLSF_ONEBYTYPE     = 00000002H;

  MIXER_GETLINECONTROLSF_QUERYMASK     = 0000000FH;

TYPE
  MIXERCONTROLDETAILS = RECORD
    cbStruct           : windows.DWORD;     (* size in bytes of MIXERCONTROLDETAILS *)
    dwControlID        : windows.DWORD;     (* control id to get/set details on *)
    cChannels          : windows.DWORD;     (* number of channels in paDetails array *)
    CASE : CARDINAL OF
    | 1 :
      hwndOwner        : windows.HWND;      (* for MIXER_SETCONTROLDETAILSF_CUSTOM *)
    | 2 :
      cMultipleItems   : windows.DWORD;     (* if _MULTIPLE, the number of items per channel *)
    END;
    cbDetails          : windows.DWORD;     (* size of _one_ details_XX struct *)
    paDetails          : windows.PVOID;     (* pointer to array of details_XX structs *)
  END;
  PMIXERCONTROLDETAILS = POINTER TO MIXERCONTROLDETAILS;

(* *)
(*  MIXER_GETCONTROLDETAILSF_LISTTEXT *)
(* *)

  MIXERCONTROLDETAILS_LISTTEXT = RECORD
    dwParam1           : windows.DWORD;
    dwParam2           : windows.DWORD;
    szName             : ARRAY [0..MIXER_LONG_NAME_CHARS-1] OF TCHAR;
  END;
  PMIXERCONTROLDETAILS_LISTTEXT = POINTER TO MIXERCONTROLDETAILS_LISTTEXT;

(* *)
(*  MIXER_GETCONTROLDETAILSF_VALUE *)
(* *)
  MIXERCONTROLDETAILS_BOOLEAN = RECORD
    fValue : windows.LONG;
  END;
  PMIXERCONTROLDETAILS_BOOLEAN = POINTER TO MIXERCONTROLDETAILS_BOOLEAN;

  MIXERCONTROLDETAILS_SIGNED = RECORD
    lValue : windows.LONG;
  END;
  PMIXERCONTROLDETAILS_SIGNED = POINTER TO MIXERCONTROLDETAILS_SIGNED;

  MIXERCONTROLDETAILS_UNSIGNED = RECORD
    dwValue           : windows.DWORD;
  END;
  PMIXERCONTROLDETAILS_UNSIGNED = POINTER TO MIXERCONTROLDETAILS_UNSIGNED;

PROCEDURE mixerGetControlDetails( hmxobj : HMIXEROBJ; pmxcd : PMIXERCONTROLDETAILS; fdwDetails : windows.DWORD) : MMRESULT;

CONST
  MIXER_GETCONTROLDETAILSF_VALUE       = 00000000H;
  MIXER_GETCONTROLDETAILSF_LISTTEXT    = 00000001H;

  MIXER_GETCONTROLDETAILSF_QUERYMASK   = 0000000FH;

PROCEDURE mixerSetControlDetails( hmxobj : HMIXEROBJ; pmxcd : PMIXERCONTROLDETAILS; fdwDetails : windows.DWORD) : MMRESULT;

CONST
  MIXER_SETCONTROLDETAILSF_VALUE       = 00000000H;
  MIXER_SETCONTROLDETAILSF_CUSTOM      = 00000001H;

  MIXER_SETCONTROLDETAILSF_QUERYMASK   = 0000000FH;

(****************************************************************************

          Timer support

****************************************************************************)

CONST
(* timer error return values *)
  TIMERR_NOERROR         = 0;                  (* no error *)
  TIMERR_NOCANDO         = TIMERR_BASE+1;      (* request not completed *)
  TIMERR_STRUCT          = TIMERR_BASE+33;     (* time struct size *)

TYPE
(* timer data types *)
  PTIMECALLBACK = PROCEDURE( (*uTimerID*) windows.UINT, (*uMsg*) windows.UINT, (*dwUser*) windows.DWORD, (*dw1*) windows.DWORD, (*dw2*) windows.DWORD);

CONST
(* flags for fuEvent parameter of timeSetEvent() function *)
  TIME_ONESHOT     = 0000H;  (* program timer for single event *)
  TIME_PERIODIC    = 0001H;  (* program for continuous periodic event *)

  TIME_CALLBACK_FUNCTION       = 0000H; (* callback is function *)
  TIME_CALLBACK_EVENT_SET      = 0010H; (* callback is event - use SetEvent *)
  TIME_CALLBACK_EVENT_PULSE    = 0020H; (* callback is event - use PulseEvent *)

TYPE
(* timer device capabilities data structure *)
  TIMECAPS = RECORD
    wPeriodMin    : windows.UINT;     (* minimum period supported  *)
    wPeriodMax    : windows.UINT;     (* maximum period supported  *)
  END;
  PTIMECAPS = POINTER TO TIMECAPS;

(* timer function prototypes *)
PROCEDURE timeGetSystemTime( pmmt : PMMTIME; cbmmt : windows.UINT) : MMRESULT;
PROCEDURE timeGetTime() : windows.DWORD;
PROCEDURE timeSetEvent( uDelay : windows.UINT; uResolution : windows.UINT; fptc : PTIMECALLBACK; dwUser : windows.DWORD; fuEvent : windows.UINT) : MMRESULT; 
PROCEDURE timeKillEvent( uTimerID : windows.UINT) : MMRESULT;
PROCEDURE timeGetDevCaps( ptc : PTIMECAPS; cbtc : windows.UINT) : MMRESULT;
PROCEDURE timeBeginPeriod( uPeriod : windows.UINT) : MMRESULT;
PROCEDURE timeEndPeriod( uPeriod : windows.UINT) : MMRESULT;

(****************************************************************************

          Joystick support

****************************************************************************)

CONST
(* joystick error return values *)
  JOYERR_NOERROR         = 0;                  (* no error *)
  JOYERR_PARMS           = JOYERR_BASE+5;      (* bad parameters *)
  JOYERR_NOCANDO         = JOYERR_BASE+6;      (* request not completed *)
  JOYERR_UNPLUGGED       = JOYERR_BASE+7;      (* joystick is unplugged *)

(* constants used with JOYINFO and JOYINFOEX structures and MM_JOY* messages *)
  JOY_BUTTON1         = 0001H;
  JOY_BUTTON2         = 0002H;
  JOY_BUTTON3         = 0004H;
  JOY_BUTTON4         = 0008H;
  JOY_BUTTON1CHG      = 0100H;
  JOY_BUTTON2CHG      = 0200H;
  JOY_BUTTON3CHG      = 0400H;
  JOY_BUTTON4CHG      = 0800H;

(* constants used with JOYINFOEX *)
  JOY_BUTTON5          = 00000010H;
  JOY_BUTTON6          = 00000020H;
  JOY_BUTTON7          = 00000040H;
  JOY_BUTTON8          = 00000080H;
  JOY_BUTTON9          = 00000100H;
  JOY_BUTTON10         = 00000200H;
  JOY_BUTTON11         = 00000400H;
  JOY_BUTTON12         = 00000800H;
  JOY_BUTTON13         = 00001000H;
  JOY_BUTTON14         = 00002000H;
  JOY_BUTTON15         = 00004000H;
  JOY_BUTTON16         = 00008000H;
  JOY_BUTTON17         = 00010000H;
  JOY_BUTTON18         = 00020000H;
  JOY_BUTTON19         = 00040000H;
  JOY_BUTTON20         = 00080000H;
  JOY_BUTTON21         = 00100000H;
  JOY_BUTTON22         = 00200000H;
  JOY_BUTTON23         = 00400000H;
  JOY_BUTTON24         = 00800000H;
  JOY_BUTTON25         = 01000000H;
  JOY_BUTTON26         = 02000000H;
  JOY_BUTTON27         = 04000000H;
  JOY_BUTTON28         = 08000000H;
  JOY_BUTTON29         = 10000000H;
  JOY_BUTTON30         = 20000000H;
  JOY_BUTTON31         = 40000000H;
  JOY_BUTTON32         = 80000000H;

(* constants used with JOYINFOEX structure *)
  JOY_POVCENTERED    = WORD( -1 );
  JOY_POVFORWARD     = 0;
  JOY_POVRIGHT       = 900;
  JOY_POVBACKWARD    = 1800;
  JOY_POVLEFT        = 2700;

  JOY_RETURNX    = 00000001H;
  JOY_RETURNY    = 00000002H;
  JOY_RETURNZ    = 00000004H;
  JOY_RETURNR    = 00000008H;
  JOY_RETURNU    = 00000010H; (* axis 5 *)
  JOY_RETURNV    = 00000020H; (* axis 6 *)
  JOY_RETURNPOV    = 00000040H;
  JOY_RETURNBUTTONS  = 00000080H;
  JOY_RETURNRAWDATA  = 00000100H;
  JOY_RETURNPOVCTS   = 00000200H;
  JOY_RETURNCENTERED = 00000400H;
  JOY_USEDEADZONE    = 00000800H;
  JOY_RETURNALL      = JOY_RETURNX OR JOY_RETURNY OR JOY_RETURNZ OR
                       JOY_RETURNR OR JOY_RETURNU OR JOY_RETURNV OR
                       JOY_RETURNPOV OR JOY_RETURNBUTTONS;
  JOY_CAL_READALWAYS = 00010000H;
  JOY_CAL_READXYONLY = 00020000H;
  JOY_CAL_READ3      = 00040000H;
  JOY_CAL_READ4      = 00080000H;
  JOY_CAL_READXONLY  = 00100000H;
  JOY_CAL_READYONLY  = 00200000H;
  JOY_CAL_READ5      = 00400000H;
  JOY_CAL_READ6      = 00800000H;
  JOY_CAL_READZONLY  = 01000000H;
  JOY_CAL_READRONLY  = 02000000H;
  JOY_CAL_READUONLY  = 04000000H;
  JOY_CAL_READVONLY  = 08000000H;

(* joystick ID constants *)
  JOYSTICKID1          = 0;
  JOYSTICKID2          = 1;

(* joystick driver capabilites *)
  JOYCAPS_HASZ      = 0001H;
  JOYCAPS_HASR      = 0002H;
  JOYCAPS_HASU      = 0004H;
  JOYCAPS_HASV      = 0008H;
  JOYCAPS_HASPOV    = 0010H;
  JOYCAPS_POV4DIR   = 0020H;
  JOYCAPS_POVCTS    = 0040H;

TYPE
(* joystick device capabilities data structure *)

  JOYCAPS = RECORD
    wMid     : WORD;                (* manufacturer ID *)
    wPid     : WORD;                (* product ID *)
    szPname  :ARRAY [0..MAXPNAMELEN-1] OF TCHAR;(* product name (NULL terminated string) *)
    wXmin    : windows.UINT;               (* minimum x position value *)
    wXmax    : windows.UINT;               (* maximum x position value *)
    wYmin    : windows.UINT;               (* minimum y position value *)
    wYmax    : windows.UINT;               (* maximum y position value *)
    wZmin    : windows.UINT;               (* minimum z position value *)
    wZmax    : windows.UINT;               (* maximum z position value *)
    wNumButtons   : windows.UINT;         (* number of buttons *)
    wPeriodMin    : windows.UINT;          (* minimum message period when captured *)
    wPeriodMax    : windows.UINT;          (* maximum message period when captured *)
    wRmin    : windows.UINT;               (* minimum r position value *)
    wRmax    : windows.UINT;               (* maximum r position value *)
    wUmin    : windows.UINT;               (* minimum u (5th axis) position value *)
    wUmax    : windows.UINT;               (* maximum u (5th axis) position value *)
    wVmin    : windows.UINT;               (* minimum v (6th axis) position value *)
    wVmax    : windows.UINT;               (* maximum v (6th axis) position value *)
    wCaps    : windows.UINT;     (* joystick capabilites *)
    wMaxAxes    : windows.UINT;    (* maximum number of axes supported *)
    wNumAxes    : windows.UINT;    (* number of axes in use *)
    wMaxButtons    : windows.UINT;   (* maximum number of buttons supported *)
    szRegKey    : ARRAY [0..MAXPNAMELEN-1] OF TCHAR;(* registry key *)
    szOEMVxD    : ARRAY [0..MAX_JOYSTICKOEMVXDNAME-1] OF TCHAR; (* OEM VxD in use *)
  END;
  PJOYCAPS = POINTER TO JOYCAPS;

(* joystick information data structure *)
  JOYINFO = RECORD
    wXpos : windows.UINT;                 (* x position *)
    wYpos : windows.UINT;                 (* y position *)
    wZpos : windows.UINT;                 (* z position *)
    wButtons : windows.UINT;              (* button states *)
  END;
  PJOYINFO = POINTER TO JOYINFO;

  JOYINFOEX = RECORD
    dwSize : windows.DWORD;    (* size of structure *)
    dwFlags : windows.DWORD;     (* flags to indicate what to return *)
    dwXpos : windows.DWORD;                (* x position *)
    dwYpos : windows.DWORD;                (* y position *)
    dwZpos : windows.DWORD;                (* z position *)
    dwRpos : windows.DWORD;    (* rudder/4th axis position *)
    dwUpos : windows.DWORD;    (* 5th axis position *)
    dwVpos : windows.DWORD;    (* 6th axis position *)
    dwButtons : windows.DWORD;             (* button states *)
    dwButtonNumber : windows.DWORD;        (* current button number pressed *)
    dwPOV : windows.DWORD;                 (* point of view state *)
    dwReserved1 : windows.DWORD;     (* reserved for communication between winmm & driver *)
    dwReserved2 : windows.DWORD;     (* reserved for future expansion *)
  END;
  PJOYINFOEX = POINTER TO JOYINFOEX;

(* joystick function prototypes *)
PROCEDURE joyGetNumDevs() : windows.UINT;

PROCEDURE joyGetDevCaps( uJoyID : windows.UINT; pjc : PJOYCAPS; cbjc : windows.UINT) : MMRESULT;
PROCEDURE joyGetPos( uJoyID : windows.UINT; pji : PJOYINFO) : MMRESULT;

PROCEDURE joyGetPosEx( uJoyID : windows.UINT; pji : PJOYINFOEX) : MMRESULT;

PROCEDURE joyGetThreshold( uJoyID : windows.UINT; puThreshold : PUINT) : MMRESULT;
PROCEDURE joyReleaseCapture( uJoyID : windows.UINT) : MMRESULT;
PROCEDURE joySetCapture( hwnd : windows.HWND; uJoyID : windows.UINT; uPeriod : windows.UINT; fChanged : windows.BOOL ) : MMRESULT;
PROCEDURE joySetThreshold( uJoyID : windows.UINT; uThreshold : windows.UINT) : MMRESULT;

(****************************************************************************

      Multimedia File I/O support

****************************************************************************)

CONST
(* MMIO error return values *)
  MMIOERR_BASE                 = 25;
  MMIOERR_FILENOTFOUND         = MMIOERR_BASE + 1;  (* file not found *)
  MMIOERR_OUTOFMEMORY          = MMIOERR_BASE + 2;  (* out of memory *)
  MMIOERR_CANNOTOPEN           = MMIOERR_BASE + 3;  (* cannot open *)
  MMIOERR_CANNOTCLOSE          = MMIOERR_BASE + 4;  (* cannot close *)
  MMIOERR_CANNOTREAD           = MMIOERR_BASE + 5;  (* cannot read *)
  MMIOERR_CANNOTWRITE          = MMIOERR_BASE + 6;  (* cannot write *)
  MMIOERR_CANNOTSEEK           = MMIOERR_BASE + 7;  (* cannot seek *)
  MMIOERR_CANNOTEXPAND         = MMIOERR_BASE + 8;  (* cannot expand file *)
  MMIOERR_CHUNKNOTFOUND        = MMIOERR_BASE + 9;  (* chunk not found *)
  MMIOERR_UNBUFFERED           = MMIOERR_BASE + 10; (*  *)
  MMIOERR_PATHNOTFOUND         = MMIOERR_BASE + 11; (* path incorrect *)
  MMIOERR_ACCESSDENIED         = MMIOERR_BASE + 12; (* file was protected *)
  MMIOERR_SHARINGVIOLATION     = MMIOERR_BASE + 13; (* file in use *)
  MMIOERR_NETWORKERROR         = MMIOERR_BASE + 14; (* network not responding *)
  MMIOERR_TOOMANYOPENFILES     = MMIOERR_BASE + 15; (* no more file handles  *)
  MMIOERR_INVALIDFILE          = MMIOERR_BASE + 16; (* default error file error *)

(* MMIO constants *)
  CFSEPCHAR                    = C'+';               (* compound file name separator char. *)

TYPE
(* MMIO data types *)
  FOURCC      = windows.DWORD;         (* a four character code *)
  HPSTR       = POINTER TO CHAR;       (* a huge version of LPSTR *)
  HMMIO       = windows.HANDLE;        (* a handle to an open file *)
  PMMIOPROC   = PROCEDURE( windows.PSTR (*lpmmioinfo*), windows.UINT (*uMsg*), windows.LPARAM (*lParam1*), windows.LPARAM (*lParam2*) ) : windows.LRESULT;

(* general MMIO information data structure *)
  MMIOINFO = RECORD
    (* general fields *)
    dwFlags       : windows.DWORD;     (* general status flags *)
    fccIOProc     : FOURCC;            (* pointer to I/O procedure *)
    pIOProc       : PMMIOPROC;         (* pointer to I/O procedure *)
    wErrorRet     : windows.UINT;      (* place for error to be returned *)
    htask         : windows.HTASK;     (* alternate local task *)

    (* fields maintained by MMIO functions during buffered I/O *)
    cchBuffer    : windows.LONG;      (* size of I/O buffer (or 0L) *)
    pchBuffer    : windows.PSTR;      (* start of I/O buffer (or NULL) *)
    pchNext      : windows.PSTR;      (* pointer to next byte to read/write *)
    pchEndRead   : windows.PSTR;      (* pointer to last valid byte to read *)
    pchEndWrite  : windows.PSTR;      (* pointer to last byte to write *)
    lBufOffset   : windows.LONG;      (* disk offset of start of buffer *)

    (* fields maintained by I/O procedure *)
    lDiskOffset : windows.LONG;    (* disk offset of next read or write *)
    adwInfo     : ARRAY [0..2] OF windows.DWORD;     (* data specific to type of MMIOPROC *)

    (* other fields maintained by MMIO *)
    dwReserved1 : windows.DWORD;    (* reserved for MMIO use *)
    dwReserved2 : windows.DWORD;    (* reserved for MMIO use *)
    hmmio       : HMMIO;            (* handle to open file *)
  END;
  PMMIOINFO = POINTER TO MMIOINFO;

(* RIFF chunk information data structure *)
  MMCKINFO = RECORD
  ckid         : FOURCC;           (* chunk ID *)
  cksize       : windows.DWORD;         (* chunk size *)
  fccType      : FOURCC;        (* form type or list type *)
  dwDataOffset : windows.DWORD;   (* offset of data portion of chunk *)
  dwFlags      : windows.DWORD;        (* flags used by MMIO functions *)
  END;
  PMMCKINFO = POINTER TO MMCKINFO;

CONST
(* bit field masks *)
  MMIO_RWMODE      = 00000003H;     (* open file for reading/writing/both *)
  MMIO_SHAREMODE   = 00000070H;     (* file sharing mode number *)

(* constants for dwFlags field of MMIOINFO *)
  MMIO_CREATE      = 00001000H;     (* create new file (or truncate file) *)
  MMIO_PARSE       = 00000100H;     (* parse new file returning path *)
  MMIO_DELETE      = 00000200H;     (* create new file (or truncate file) *)
  MMIO_EXIST       = 00004000H;     (* checks for existence of file *)
  MMIO_ALLOCBUF    = 00010000H;     (* mmioOpen() should allocate a buffer *)
  MMIO_GETTEMP     = 00020000H;     (* mmioOpen() should retrieve temp name *)

  MMIO_DIRTY       = 10000000H;     (* I/O buffer is dirty *)

(* read/write mode numbers (bit field MMIO_RWMODE) *)
  MMIO_READ        = 00000000H;     (* open file for reading only *)
  MMIO_WRITE       = 00000001H;     (* open file for writing only *)
  MMIO_READWRITE   = 00000002H;     (* open file for reading and writing *)

(* share mode numbers (bit field MMIO_SHAREMODE) *)
  MMIO_COMPAT      = 00000000H;     (* compatibility mode *)
  MMIO_EXCLUSIVE   = 00000010H;     (* exclusive-access mode *)
  MMIO_DENYWRITE   = 00000020H;     (* deny writing to other processes *)
  MMIO_DENYREAD    = 00000030H;     (* deny reading to other processes *)
  MMIO_DENYNONE    = 00000040H;     (* deny nothing to other processes *)

(* various MMIO flags *)
  MMIO_FHOPEN              = 0010H; (* mmioClose: keep file handle open *)
  MMIO_EMPTYBUF            = 0010H; (* mmioFlush: empty the I/O buffer *)
  MMIO_TOUPPER             = 0010H; (* mmioStringToFOURCC: to u-case *)
  MMIO_INSTALLPROC     = 00010000H; (* mmioInstallIOProc: install MMIOProc *)
  MMIO_GLOBALPROC      = 10000000H; (* mmioInstallIOProc: install globally *)
  MMIO_REMOVEPROC      = 00020000H; (* mmioInstallIOProc: remove MMIOProc *)
  MMIO_UNICODEPROC     = 01000000H; (* mmioInstallIOProc: Unicode MMIOProc *)
  MMIO_FINDPROC        = 00040000H; (* mmioInstallIOProc: find an MMIOProc *)
  MMIO_FINDCHUNK           = 0010H; (* mmioDescend: find a chunk by ID *)
  MMIO_FINDRIFF            = 0020H; (* mmioDescend: find a LIST chunk *)
  MMIO_FINDLIST            = 0040H; (* mmioDescend: find a RIFF chunk *)
  MMIO_CREATERIFF          = 0020H; (* mmioCreateChunk: make a LIST chunk *)
  MMIO_CREATELIST          = 0040H; (* mmioCreateChunk: make a RIFF chunk *)

(* message numbers for MMIOPROC I/O procedure functions *)
  MMIOM_READ       = MMIO_READ;   (* read *)
  MMIOM_WRITE      = MMIO_WRITE;  (* write *)
  MMIOM_SEEK       = 2;           (* seek to a new position in file *)
  MMIOM_OPEN       = 3;           (* open file *)
  MMIOM_CLOSE      = 4;           (* close file *)
  MMIOM_WRITEFLUSH = 5;           (* write and flush *)

  MMIOM_RENAME     = 6;           (* rename specified file *)

  MMIOM_USER       = 8000H;       (* beginning of user-defined messages *)

(* standard four character codes *)

  FOURCC_RIFF = windows.DWORD( ORD( 'R' ) + ORD('I') << 8 + ORD('F') << 16 + ORD('F') <<24 );
  FOURCC_LIST = windows.DWORD( ORD( 'L' ) + ORD('I') << 8 + ORD('S') << 16 + ORD('T') <<24 );  

(* four character codes used to identify standard built-in I/O procedures *)
  FOURCC_DOS = windows.DWORD( ORD( 'D' ) + ORD('O') << 8 + ORD('S') << 16 + ORD(' ') <<24 );
  FOURCC_MEM = windows.DWORD( ORD( 'M' ) + ORD('E') << 8 + ORD('M') << 16 + ORD(' ') <<24 );

(* flags for mmioSeek() *)
  SEEK_SET         = 0;              (* seek to an absolute position *)
  SEEK_CUR         = 1;              (* seek relative to current position *)
  SEEK_END         = 2;              (* seek relative to end of file *)

(* other constants *)
  MMIO_DEFAULTBUFFER       = 8192;   (* default buffer size *)

(* MMIO macros *)
(*
#define mmioFOURCC(ch0, ch1, ch2, ch3)  MAKEFOURCC(ch0, ch1, ch2, ch3)
*)

(* MMIO function prototypes *)

PROCEDURE mmioStringToFOURCC(sz : windows.PCTSTR; uFlags : windows.UINT) : FOURCC;
PROCEDURE mmioInstallIOProc(fccIOProc : FOURCC; pIOProc : PMMIOPROC; dwFlags : windows.DWORD) : PMMIOPROC;
PROCEDURE mmioOpen(pszFileName : windows.PTSTR; pmmioinfo : PMMIOINFO; fdwOpen : windows.DWORD) : HMMIO;
PROCEDURE mmioRename(pszFileName : windows.PCTSTR; pszNewFileName : windows.PCTSTR; pmmioinfo : PMMIOINFO; fdwRename : windows.DWORD) : MMRESULT;

PROCEDURE mmioClose(hmmio : HMMIO; fuClose : windows.UINT) : MMRESULT;
PROCEDURE mmioRead(hmmio : HMMIO; pch : HPSTR; cch : windows.LONG) : windows.LONG;
PROCEDURE mmioWrite(hmmio : HMMIO; pch : windows.PCHAR; cch : windows.LONG) : windows.LONG;
PROCEDURE mmioSeek(hmmio : HMMIO; lOffset : windows.LONG; iOrigin : INTEGER) : windows.LONG;
PROCEDURE mmioGetInfo(hmmio : HMMIO; pmmioinfo : PMMIOINFO; fuInfo : windows.UINT) : MMRESULT;
PROCEDURE mmioSetInfo(hmmio : HMMIO; pmmioinfo : PMMIOINFO; fuInfo : windows.UINT) : MMRESULT;
PROCEDURE mmioSetBuffer(hmmio : HMMIO; pchBuffer : windows.PSTR; cchBuffer : windows.LONG; fuBuffer : windows.UINT) : MMRESULT;
PROCEDURE mmioFlush(hmmio : HMMIO; fuFlush : windows.UINT) : MMRESULT;
PROCEDURE mmioAdvance(hmmio : HMMIO; pmmioinfo : PMMIOINFO; fuAdvance : windows.UINT) : MMRESULT;
PROCEDURE mmioSendMessage(hmmio : HMMIO; uMsg : windows.UINT; lParam1 : windows.LPARAM; lParam2 : windows.LPARAM) : windows.LRESULT;
PROCEDURE mmioDescend(hmmio : HMMIO; pmmcki : PMMCKINFO; pmmckiParent : PMMCKINFO; fuDescend : windows.UINT) : MMRESULT;
PROCEDURE mmioAscend(hmmio : HMMIO; pmmcki : PMMCKINFO; fuAscend : windows.UINT) : MMRESULT;
PROCEDURE mmioCreateChunk(hmmio : HMMIO; pmmcki : PMMCKINFO; fuCreate : windows.UINT) : MMRESULT;

(****************************************************************************

          MCI support

****************************************************************************)

TYPE
  MCIERROR    = windows.DWORD;       (* error return code, 0 means no error *)

  MCIDEVICEID = windows.UINT;    (* MCI device ID type *)

  YIELDPROC   = PROCEDURE((*mciId*) MCIDEVICEID, (*dwYieldData*) windows.DWORD) : windows.UINT;

(* MCI function prototypes *)

PROCEDURE mciSendCommand(mciId : MCIDEVICEID; uMsg : windows.UINT; dwParam1 : windows.DWORD; dwParam2 : windows.DWORD) : MCIERROR;
PROCEDURE mciSendString(lpstrCommand : windows.PCTSTR; lpstrReturnString : windows.PTSTR; uReturnLength : windows.UINT; hwndCallback : windows.HWND) : MCIERROR;
PROCEDURE mciGetDeviceID(pszDevice : windows.PCTSTR) : MCIDEVICEID;
PROCEDURE mciGetDeviceIDFromElementID(dwElementID : windows.DWORD; lpstrType : windows.PCTSTR ) : MCIDEVICEID;
PROCEDURE mciGetErrorString(mcierr : MCIERROR; pszText : windows.PTSTR; cchText : windows.UINT) : windows.BOOL;
PROCEDURE mciSetYieldProc(mciId : MCIDEVICEID; fpYieldProc : YIELDPROC; dwYieldData : windows.DWORD) : windows.BOOL;

PROCEDURE mciGetCreatorTask(mciId : MCIDEVICEID) : windows.HTASK;
PROCEDURE mciGetYieldProc(mciId : MCIDEVICEID; pdwYieldData : HWAVEOUT) : YIELDPROC;

CONST
(* MCI error return values *)
  MCIERR_INVALID_DEVICE_ID         = MCIERR_BASE + 1;
  MCIERR_UNRECOGNIZED_KEYWORD      = MCIERR_BASE + 3;
  MCIERR_UNRECOGNIZED_COMMAND      = MCIERR_BASE + 5;
