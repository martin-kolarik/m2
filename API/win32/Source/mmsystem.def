  MCI_ANIM_GETDEVCAPS_SLOW_RATE    = 00004003H;
  MCI_ANIM_GETDEVCAPS_NORMAL_RATE  = 00004004H;
  MCI_ANIM_GETDEVCAPS_PALETTES     = 00004006H;
  MCI_ANIM_GETDEVCAPS_CAN_STRETCH  = 00004007H;
  MCI_ANIM_GETDEVCAPS_MAX_WINDOWS  = 00004008H;

(* flags for the MCI_REALIZE command message *)
  MCI_ANIM_REALIZE_NORM            = 00010000H;
  MCI_ANIM_REALIZE_BKGD            = 00020000H;

(* flags for dwFlags parameter of MCI_WINDOW command message *)
  MCI_ANIM_WINDOW_HWND             = 00010000H;
  MCI_ANIM_WINDOW_STATE            = 00040000H;
  MCI_ANIM_WINDOW_TEXT             = 00080000H;
  MCI_ANIM_WINDOW_ENABLE_STRETCH   = 00100000H;
  MCI_ANIM_WINDOW_DISABLE_STRETCH  = 00200000H;

(* flags for hWnd field of MCI_ANIM_WINDOW_PARMS parameter block *)
(* MCI_WINDOW command message, (dwFlags == MCI_ANIM_WINDOW_HWND) *)
  MCI_ANIM_WINDOW_DEFAULT          = 00000000H;

(* flags for dwFlags parameter of MCI_PUT command message *)
  MCI_ANIM_RECT                    = 00010000H;
  MCI_ANIM_PUT_SOURCE              = 00020000H;
  MCI_ANIM_PUT_DESTINATION         = 00040000H;

(* flags for dwFlags parameter of MCI_WHERE command message *)
  MCI_ANIM_WHERE_SOURCE            = 00020000H;
  MCI_ANIM_WHERE_DESTINATION       = 00040000H;

(* flags for dwFlags parameter of MCI_UPDATE command message *)
  MCI_ANIM_UPDATE_HDC              = 00020000H;

TYPE
(* parameter block for MCI_OPEN command message *)

  MCI_ANIM_OPEN_PARMS = RECORD
    dwCallback   : windows.DWORD;
    wDeviceID        : MCIDEVICEID;
    lpstrDeviceType  : windows.PCTSTR;
    lpstrElementName : windows.PCTSTR;
    lpstrAlias       : windows.PCTSTR;
    dwStyle          : windows.DWORD;
    hWndParent       : windows.HWND;
  END;
  PMCI_ANIM_OPEN_PARMS = POINTER TO MCI_ANIM_OPEN_PARMS;

(* parameter block for MCI_PLAY command message *)
  MCI_ANIM_PLAY_PARMS = RECORD
    dwCallback   : windows.DWORD;
    dwFrom   : windows.DWORD;
    dwTo   : windows.DWORD;
    dwSpeed   : windows.DWORD;
  END;
  PMCI_ANIM_PLAY_PARMS = POINTER TO MCI_ANIM_PLAY_PARMS;

(* parameter block for MCI_STEP command message *)
  MCI_ANIM_STEP_PARMS = RECORD
    dwCallback   : windows.DWORD;
    dwFrames   : windows.DWORD;
  END;
  PMCI_ANIM_STEP_PARMS = POINTER TO MCI_ANIM_STEP_PARMS;

(* parameter block for MCI_WINDOW command message *)

  MCI_ANIM_WINDOW_PARMS = RECORD
    dwCallback   : windows.DWORD;
    hWnd         : windows.HWND;
    nCmdShow     : windows.UINT;
    lpstrText    : windows.PCTSTR;
  END;
  PMCI_ANIM_WINDOW_PARMS = POINTER TO MCI_ANIM_WINDOW_PARMS;

(* parameter block for MCI_PUT, MCI_UPDATE, MCI_WHERE command messages *)
  MCI_ANIM_RECT_PARMS = RECORD
    dwCallback : windows.DWORD;
    rc         : windows.RECT;
  END;
  PMCI_ANIM_RECT_PARMS = POINTER TO MCI_ANIM_RECT_PARMS;

(* parameter block for MCI_UPDATE PARMS *)
  MCI_ANIM_UPDATE_PARMS = RECORD
    dwCallback  : windows.DWORD;
    rc          : windows.RECT;
    hDC         : windows.HDC;
  END;
  PMCI_ANIM_UPDATE_PARMS = POINTER TO MCI_ANIM_UPDATE_PARMS;

(* MCI extensions for video overlay devices *)

CONST
(* flags for dwFlags parameter of MCI_OPEN command message *)
  MCI_OVLY_OPEN_WS                 = 00010000H;
  MCI_OVLY_OPEN_PARENT             = 00020000H;

(* flags for dwFlags parameter of MCI_STATUS command message *)
  MCI_OVLY_STATUS_HWND             = 00004001H;
  MCI_OVLY_STATUS_STRETCH          = 00004002H;

(* flags for dwFlags parameter of MCI_INFO command message *)
  MCI_OVLY_INFO_TEXT               = 00010000H;

