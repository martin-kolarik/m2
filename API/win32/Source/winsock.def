(*
 * WinSock 2 extensions -- data types for the condition function in
 * WSAAccept() and overlapped I/O completion routine.
 *)

TYPE
  CONDITIONPROC = PROCEDURE( PWSABUF, PWSABUF, PQOS, PQOS, 
                             PWSABUF, PWSABUF, ADDRESS, windows.DWORD ) : INTEGER;
  LPWSAOVERLAPPED_COMPLETION_ROUTINE = PROCEDURE( windows.DWORD, windows.DWORD, PWSAOVERLAPPED, windows.DWORD );
