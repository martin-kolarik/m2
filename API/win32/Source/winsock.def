                       END;
  PWSANAMESPACE_INFO = POINTER TO WSANAMESPACE_INFO;

(* Socket function prototypes *)

PROCEDURE accept( s : SOCKET; addr : Psockaddr; addrlen : windows.PINT ) : SOCKET;
PROCEDURE bind( s : SOCKET; name : Psockaddr; namelen : INTEGER ) : INTEGER;
PROCEDURE closesocket( s : SOCKET ) : INTEGER;
PROCEDURE connect( s : SOCKET; name : Psockaddr; namelen : INTEGER ) : INTEGER;
PROCEDURE ioctlsocket( s : SOCKET; cmd : CARDINAL; argp : Pu_long ) : INTEGER;
PROCEDURE getpeername( s : SOCKET; name : Psockaddr; namelen : windows.PINT ) : INTEGER;
PROCEDURE getsockname( s : SOCKET; name : Psockaddr; namelen : windows.PINT ) : INTEGER;
PROCEDURE getsockopt( s : SOCKET; level, optname : INTEGER; optval : windows.PSTR; optlen : windows.PINT ) : INTEGER;
PROCEDURE htonl( hostlong : u_long ) : u_long;
PROCEDURE htons( hostshort : u_short ) : u_short;
PROCEDURE inet_addr( cp : windows.PSTR ) : CARDINAL;
PROCEDURE inet_ntoa( in : in_addr ) : ADDRESS;
PROCEDURE listen( s : CARDINAL; backlog : INTEGER ) : CARDINAL;
PROCEDURE ntohl( netlong : u_long ) : u_long;
PROCEDURE ntohs( netshort : u_short ) : u_short;
PROCEDURE recv( s : SOCKET; buf : windows.PSTR; len, flags : INTEGER ) : INTEGER;
PROCEDURE recvfrom( s : SOCKET; buf : windows.PSTR; len, flags : INTEGER; from : Psockaddr; fromlen : windows.PINT ) : INTEGER;
PROCEDURE select( nfds : INTEGER; readfds, writefds, exceptfds : Pfd_set; timout : Ptimeval ) : INTEGER;
PROCEDURE send( s : SOCKET; buf : windows.PSTR; len, flags : INTEGER ) : INTEGER;
PROCEDURE sendto( s : SOCKET; buf : windows.PSTR; len, flags : INTEGER; to : Psockaddr; tolen : INTEGER ) : INTEGER;
PROCEDURE setsockopt( s : SOCKET; level, optname : INTEGER; optval : windows.PSTR; optlen : INTEGER ) : INTEGER;
PROCEDURE shutdown( s : SOCKET; how : INTEGER ) : INTEGER;
PROCEDURE socket( af, type, protocol : INTEGER ) : SOCKET;
PROCEDURE gethostbyaddr( addr : windows.PSTR; len, type : INTEGER ) : Phostent;
PROCEDURE gethostbyname( name : windows.PSTR ) : Phostent;
PROCEDURE gethostname( name : windows.PSTR; namelen : INTEGER ) : INTEGER;
PROCEDURE getservbyport( port : INTEGER; proto : windows.PSTR ) : Pservent;
PROCEDURE getservbyname( name, proto : windows.PSTR ) : Pservent;
PROCEDURE getprotobynumber( number : INTEGER ) : Pprotoent;
PROCEDURE getprotobyname( name : windows.PSTR ) : Pprotoent;

