*/*)

(* WinSock 2 API new function prototypes *)

PROCEDURE WSAAccept( s : SOCKET; addr : Psockaddr; addrlen : windows.PINT; 
                     lpfnConditionProc : CONDITIONPROC; 
                     dwCallBackData : windows.DWORD ) : SOCKET;
PROCEDURE WSACloseEvent( hEvent : WSAEVENT ) : windows.BOOL;
PROCEDURE WSAConnect( s : SOCKET; name : ADDRESS; namelen : INTEGER;
                      lpCallerData, lpCaleeData : PWSABUF; 
                      lpSQOS, lpGQOS : PQOS ) : INTEGER;
PROCEDURE WSACreateEvent() : WSAEVENT;
PROCEDURE WSADuplicateSocket( s : SOCKET; dwProcessId : windows.DWORD; lpProtocolInfo : PWSAPROTOCOL_INFO ) : INTEGER;
PROCEDURE WSAEnumNetworkEvents( s : SOCKET; hEventObject : WSAEVENT; 
                                lpNetworkEvents : PWSANETWORKEVENTS ) : INTEGER;
PROCEDURE WSAEnumProtocolsA( lpiProtocols : windows.PINT;
                             lpProtocolBuffer : PWSAPROTOCOL_INFO;
                             lpdwBufferLength : windows.PDWORD ) : INTEGER;
PROCEDURE WSAEventSelect( s : SOCKET; hEventObject : WSAEVENT; 
                          lNetworkEvents : CARDINAL ) : INTEGER;
PROCEDURE WSAGetOverlappedResult( s : SOCKET; lpOverlapped : PWSAOVERLAPPED;
                                  lpcbTransfer : windows.PDWORD;
                                  fWait : windows.BOOL; 
                                  lpdwFlags : windows.PDWORD ) : windows.BOOL;
PROCEDURE WSAGetQOSByName( s : SOCKET; lpQOSName : PWSABUF; lpQOS : PQOS ) : windows.BOOL;
PROCEDURE WSAHtonl( s : SOCKET; hostlong : u_long; lpnetlong : Pu_long ) : INTEGER;
PROCEDURE WSAHtons( s : SOCKET; hostshort : u_short; lpnetshort : Pu_short ) : INTEGER;
PROCEDURE WSAIoctl( s : SOCKET; dwIoControlCode : windows.DWORD; 
                    lpvInBuffer : ADDRESS; cbInBuffer : windows.DWORD; 
                    lpvOutBuffer : ADDRESS; cbOutBuffer : windows.DWORD;
                    lpcbBytesReturned : windows.PDWORD;
                    lpOverlapped : PWSAOVERLAPPED;
                    lpCompletionRoutine : LPWSAOVERLAPPED_COMPLETION_ROUTINE ) : INTEGER;
PROCEDURE WSAJoinLeaf( s : SOCKET; name : Psockaddr; namelen : INTEGER; 
                       lpCallerData, lpCalleeData : PWSABUF;
                       lpSQOS, lpGQOS : PQOS;
                       dwFlags : windows.DWORD ) : SOCKET;
PROCEDURE WSANtohl( s : SOCKET; netlong : u_long; lphostlong : Pu_long ) : INTEGER;
PROCEDURE WSANtohs( s : SOCKET; netshort : u_short; lphostshort : Pu_short ) : INTEGER;

PROCEDURE WSARecv( s : SOCKET; lpBuffers : PWSABUF; dwBufferCount : windows.DWORD;
                   lpNumberOfBytesRecvd, lpFlags : windows.PDWORD; 
                   lpOverlapped : PWSAOVERLAPPED; 
                   lpCompletionRoutine : LPWSAOVERLAPPED_COMPLETION_ROUTINE ) : INTEGER;
PROCEDURE WSARecvDisconnect( s : SOCKET; lpInboundDisconnectData : PWSABUF ) : INTEGER;
PROCEDURE WSARecvFrom( s : SOCKET; lpBuffers : PWSABUF;
                       dwBufferCount : windows.DWORD;
                       lpNumberOfBytesRecvd : windows.PDWORD;
                       lpFlags : windows.PDWORD;
                       lpFrom : Psockaddr; lpFromlen : windows.PINT;
                       lpOverlapped : PWSAOVERLAPPED;
                       lpCompletionRoutine : LPWSAOVERLAPPED_COMPLETION_ROUTINE ) : INTEGER;
PROCEDURE WSAResetEvent( hEvent : WSAEVENT ) : windows.BOOL;
PROCEDURE WSASend( s : SOCKET; lpBuffers : PWSABUF; dwBufferCount : windows.DWORD;
                   lpNumberOfBytesSent : windows.PDWORD; dwFlags : windows.DWORD;
                   lpOverlapped : PWSAOVERLAPPED;
                   lpCompletionRoutine : LPWSAOVERLAPPED_COMPLETION_ROUTINE ) : INTEGER;
PROCEDURE WSASendDisconnect( s : SOCKET; lpOutboundDisconnectData : PWSABUF ) : INTEGER;
PROCEDURE WSASendTo( s : SOCKET; lpBuffers : PWSABUF; dwBufferCount : windows.DWORD;
                     lpNumberOfBytesSent : windows.PDWORD; dwFlags : windows.DWORD;
                     lpTo : Psockaddr; iTolen : INTEGER; 
                     lpOverlapped : PWSAOVERLAPPED;
                     lpCompletionRoutine : LPWSAOVERLAPPED_COMPLETION_ROUTINE ) : INTEGER;
PROCEDURE WSASetEvent( hEvent : WSAEVENT ) : windows.BOOL;
PROCEDURE WSASocket( af, type, protocol : INTEGER; lpProtocolInfo : WSAPROTOCOL_INFO; 
                     g : GROUP; dwFlags : windows.DWORD ) : SOCKET;
PROCEDURE WSAWaitForMultipleEvents( cEvents : windows.DWORD; lphEvents : PWSAEVENT;
                                    fWaitAll : windows.BOOL; dwTimeout : windows.DWORD;
                                    fAlertable : windows.BOOL ) : windows.DWORD;
PROCEDURE WSAAddressToString( lpsaAddress : PSOCKADDR; dwAddressLength : windows.DWORD;
                              lpProtocolInfo : PWSAPROTOCOL_INFO;
                              lpszAddressString : windows.PTSTR;
                              lpdwAddressStringLength : windows.PDWORD ) : INTEGER;
PROCEDURE WSAStringToAddress( AddressString : windows.PTSTR;
                              AddressFamily : INTEGER;
                              lpProtocolInfo : PWSAPROTOCOL_INFO;
                              lpAddress : PSOCKADDR;
                              lpAddressLength : windows.PINT ) : INTEGER;

(* Registration and Name Resolution API functions *)

PROCEDURE WSALookupServiceBegin( lpqsRestrictions : PWSAQUERYSET;
                                 dwControlFlags : windows.DWORD;
                                 lphLookup : windows.PHANDLE ) : INTEGER;
PROCEDURE WSALookupServiceNext( hLookup : windows.HANDLE; dwControlFlags : windows.DWORD;
                                lpdwBufferLength : windows.PDWORD;
                                lpqsResults : PWSAQUERYSET ) : INTEGER;
PROCEDURE WSALookupServiceEnd( hLookup : windows.HANDLE );
PROCEDURE WSAInstallServiceClass( lpServiceClassInfo : PWSASERVICECLASSINFO ) : INTEGER;
PROCEDURE WSARemoveServiceClass( lpServiceClassId : PGUID ) : INTEGER;
PROCEDURE WSAGetServiceClassInfo( lpProviderId : PGUID; 
                                  lpServiceClassId : PGUID;
                                  lpdwBufSize : windows.PDWORD;
                                  lpServiceClassInfo : PWSASERVICECLASSINFO ) : INTEGER;
PROCEDURE WSAEnumNameSpaceProviders( lpdwBufferLength : windows.PDWORD;
                                     lpnspBuffer : PWSANAMESPACE_INFO ) : INTEGER;
PROCEDURE WSAGetServiceClassNameByClassId( lpServiceClassId : PGUID;
                                           lpszServiceClassName : windows.PTSTR; 
                                           lpdwBufferLength : windows.PDWORD ) : INTEGER;
PROCEDURE WSASetService( lpqsRegInfo : PWSAQUERYSET;
                         essoperation : WSAESETSERVICEOP;
                         dwControlFlags : windows.DWORD ) : INTEGER;

(* Microsoft Windows Extended data types *)
TYPE
  SOCKADDR_IN = sockaddr_in;
  PSOCKADDR_IN = POINTER TO sockaddr_in;
  LPSOCKADDR_IN = POINTER TO sockaddr_in;

  LINGER = linger;
  PLINGER = POINTER TO linger;
  LPLINGER = POINTER TO linger;

  IN_ADDR = in_addr;
  PIN_ADDR = POINTER TO in_addr;
  LPIN_ADDR = POINTER TO in_addr;

  PFD_SET = POINTER TO fd_set;
  LPFD_SET = POINTER TO fd_set;

  HOSTENT = hostent;
  PHOSTENT = POINTER TO hostent;
  LPHOSTENT = POINTER TO hostent;

  SERVENT = servent;
  PSERVENT = POINTER TO servent;
  LPSERVENT = POINTER TO servent;

  PROTOENT = protoent;
  PPROTOENT = POINTER TO protoent;
  LPPROTOENT = POINTER TO protoent;

  TIMEVAL = timeval;
  PTIMEVAL = POINTER TO timeval;
  LPTIMEVAL = POINTER TO timeval;

(*
 * Windows message parameter composition and decomposition
 * macros.
 *
 * WSAMAKEASYNCREPLY is intended for use by the Windows Sockets implementation
 * when constructing the response to a WSAAsyncGetXByY() routine.
 *)
(*# call( macro => on ) *)
PROCEDURE WSAMAKEASYNCREPLY( buflen, error : WORD ) : windows.DWORD;
(*# call( macro => off ) *)
(*
#define WSAMAKEASYNCREPLY(buflen,error)     MAKELONG(buflen,error)
*)
(*
 * WSAMAKESELECTREPLY is intended for use by the Windows Sockets implementation
 * when constructing the response to WSAAsyncSelect().
 *)
(*# call( macro => on ) *)
PROCEDURE WSAMAKEASELECTREPLY( event, error : WORD ) : windows.DWORD;
(*# call( macro => off ) *)
(*
#define WSAMAKESELECTREPLY(event,error)     MAKELONG(event,error)
*)
(*
 * WSAGETASYNCBUFLEN is intended for use by the Windows Sockets application
 * to extract the buffer length from the lParam in the response
 * to a WSAAsyncGetXByY().
 *)
(*# call( macro => on ) *)
PROCEDURE WSAGETASYNCBUFLEN( lParam : windows.DWORD ) : WORD;
(*# call( macro => off ) *)
(*
#define WSAGETASYNCBUFLEN(lParam)           LOWORD(lParam)
*)
(*
 * WSAGETASYNCERROR is intended for use by the Windows Sockets application
 * to extract the error code from the lParam in the response
 * to a WSAGetXByY().
 *)
(*# call( macro => on ) *)
PROCEDURE WSAGETASYNCERROR( lParam : windows.DWORD ) : WORD;
(*# call( macro => off ) *)
(*
#define WSAGETASYNCERROR(lParam)            HIWORD(lParam)
*)
(*
 * WSAGETSELECTEVENT is intended for use by the Windows Sockets application
 * to extract the event code from the lParam in the response
 * to a WSAAsyncSelect().
 *)
(*# call( macro => on ) *)
PROCEDURE WSAGETSELECTEVENT( lParam : windows.DWORD ) : WORD;
(*# call( macro => off ) *)
(*
#define WSAGETSELECTEVENT(lParam)           LOWORD(lParam)
*)
(*
 * WSAGETSELECTERROR is intended for use by the Windows Sockets application
 * to extract the error code from the lParam in the response
 * to a WSAAsyncSelect().
 *)
(*# call( macro => on ) *)
PROCEDURE WSAGETSELECTERROR( lParam : windows.DWORD ) : WORD;
(*# call( macro => off ) *)
(*
#define WSAGETSELECTERROR(lParam)           HIWORD(lParam)
*)

END winsock.