(*
 * Structure used in select() call, taken from the BSD file sys/time.h.
 *)
TYPE
  timeval  = RECORD
               tv_sec  : CARDINAL;
               tv_usec : CARDINAL;
             END;
  Ptimeval = POINTER TO timeval;

(*
 * Operations on timevals.
 *
 * NB: timercmp does not work for >= or <=.
 *)
(*# call( macro => on ) *)
PROCEDURE timerisset( tvp : Ptimeval ) : windows.BOOL;

// !!!
// to nejde prevest :-) PROCEDURE timercmp( tvp, ....

PROCEDURE timerclear( tvp : Ptimeval );
