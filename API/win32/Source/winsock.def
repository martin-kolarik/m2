(*
 * WinSock 2 extension -- manifest constants for SIO_TRANSLATE_HANDLE ioctl
 *)
CONST
  TH_NETDEV        = 000000001H;
  TH_TAPI          = 000000002H;


(*
 * Microsoft Windows Extended data types required for the functions to
 * convert   back  and  forth  between  binary  and  string  forms  of
 * addresses.
 *)
TYPE
  SOCKADDR  = sockaddr;
  PSOCKADDR = POINTER TO SOCKADDR;

(*
 * Manifest constants and type definitions related to name resolution and
 * registration (RNR) API
 *)

  BLOB  = RECORD
            cbSize    : CARDINAL;
            pBlobData : ADDRESS;
          END;
  PBLOB = POINTER TO BLOB;

(*
 * Service Install Flags
 *)

CONST
  SERVICE_MULTIPLE       = 000000001H;

(*
 *& Name Spaces
 *)

  NS_ALL                      = (0);

  NS_SAP                      = (1);
  NS_NDS                      = (2);
  NS_PEER_BROWSE              = (3);

  NS_TCPIP_LOCAL              = (10);
  NS_TCPIP_HOSTS              = (11);
  NS_DNS                      = (12);
  NS_NETBT                    = (13);
  NS_WINS                     = (14);

  NS_NBP                      = (20);

  NS_MS                       = (30);
  NS_STDA                     = (31);
  NS_NTDS                     = (32);

  NS_X500                     = (40);
  NS_NIS                      = (41);
  NS_NISPLUS                  = (42);

  NS_WRQ                      = (50);

(*
 * Resolution flags for WSAGetAddressByName().
 * Note these are also used by the 1.1 API GetAddressByName, so
 * leave them around.
 *)
  RES_UNUSED_1                = 000000001H;
  RES_FLUSH_CACHE             = 000000002H;
  RES_SERVICE                 = 000000004H;

(*
 * Well known value names for Service Types
 *)

  SERVICE_TYPE_VALUE_IPXPORT       = "IpxSocket";
  SERVICE_TYPE_VALUE_SAPID         = "SapId";

  SERVICE_TYPE_VALUE_TCPPORT       = "TcpPort";

  SERVICE_TYPE_VALUE_UDPPORT       = "UdpPort";

  SERVICE_TYPE_VALUE_OBJECTID      = "ObjectId";


(*
 * SockAddr Information
 *)
TYPE
  SOCKET_ADDRESS  = RECORD
                      lpSockaddr      : PSOCKADDR;
                      iSockaddrLength : INTEGER;
                    END;
  PSOCKET_ADDRESS = POINTER TO SOCKET_ADDRESS;

(*
 * CSAddr Information
 *)
TYPE
  CSADDR_INFO  = RECORD
                   LocalAddr   : SOCKET_ADDRESS;
                   RemoteAddr  : SOCKET_ADDRESS;
                   iSocketType : INTEGER;
                   iProtocol   : INTEGER;
                 END;
  PCSADDR_INFO = POINTER TO CSADDR_INFO;

(*
 *  Address Family/Protocol Tuples
 *)
  AFPROTOCOLS  = RECORD
                   iAddressFamily : INTEGER;
                   iProtocol      : INTEGER;
                 END;
  PAFPROTOCOLS = POINTER TO AFPROTOCOLS;

(*
 * Client Query API Typedefs
 *)

(*
 * The comparators
 *)
  WSAECOMPARATOR  = ( COMP_EQUAL, COMP_NOTLESS );
  PWSAECOMPARATOR = POINTER TO WSAECOMPARATOR;

  WSAVERSION  = RECORD
                  dwVersion : windows.DWORD;
                  ecHow     : WSAECOMPARATOR;
                END;
  PWSAVERSION = POINTER TO WSAVERSION;

  WSAQUERYSET  = RECORD
                   dwSize                  : windows.DWORD;
                   lpszServiceInstanceName : windows.PTSTR;
                   lpServiceClassId        : PGUID;
                   lpVersion               : PWSAVERSION;
                   lpszComment             : windows.PTSTR;
                   dwNameSpace             : windows.DWORD;
                   lpNSProviderId          : PGUID;
                   lpszContext             : windows.PTSTR;
                   dwNumberOfProtocols     : windows.DWORD;
                   lpafpProtocols          : PAFPROTOCOLS;
                   lpszQueryString         : windows.PTSTR;
                   dwNumberOfCsAddrs       : windows.DWORD;
                   lpcsaBuffer             : PCSADDR_INFO;
                   dwOutputFlags           : windows.DWORD;
                   lpBlob                  : PBLOB;
                 END;
  PWSAQUERYSET = POINTER TO WSAQUERYSET;

CONST
  LUP_DEEP                = 00001H;
  LUP_CONTAINERS          = 00002H;
  LUP_NOCONTAINERS        = 00004H;
  LUP_NEAREST             = 00008H;
  LUP_RETURN_NAME         = 00010H;
