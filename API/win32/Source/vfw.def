(****** GUIDs *******************************************)

#define DEFINE_AVIGUID(name, l, w1, w2) \
    DEFINE_GUID(name, l, w1, w2, 0xC0,0,0,0,0,0,0,0x46)

DEFINE_AVIGUID(IID_IAVIFile,            0x00020020, 0, 0);
DEFINE_AVIGUID(IID_IAVIStream,          0x00020021, 0, 0);
DEFINE_AVIGUID(IID_IAVIStreaming,       0x00020022, 0, 0);
DEFINE_AVIGUID(IID_IGetFrame,           0x00020023, 0, 0);
DEFINE_AVIGUID(IID_IAVIEditStream,      0x00020024, 0, 0);
#ifndef UNICODE
DEFINE_AVIGUID(CLSID_AVISimpleUnMarshal,        0x00020009, 0, 0);
#endif

DEFINE_AVIGUID(CLSID_AVIFile,           0x00020000, 0, 0);

CONST
  AVIFILEHANDLER_CANREADH 	 = 0001H;
  AVIFILEHANDLER_CANWRITE	 = 0002H;
  AVIFILEHANDLER_CANACCEPTNONRGB = 0004H;

(* *)
(* functions *)
(* *)

STDAPI_(void) AVIFileInit(void);   (* Call this first! *)
STDAPI_(void) AVIFileExit(void);

STDAPI_(ULONG) AVIFileAddRef       (PAVIFILE pfile);
STDAPI_(ULONG) AVIFileRelease      (PAVIFILE pfile);

STDAPI AVIFileOpen       (PAVIFILE FAR * ppfile, windows.PCSTR szFile,
			 windows.UINT uMode, PCLSID lpHandler);

STDAPI AVIFileInfo (PAVIFILE pfile, PAVIFILEINFO pfi, windows.LONG lSize);

STDAPI AVIFileGetStream     (PAVIFILE pfile, PAVISTREAM FAR * ppavi, windows.DWORD fccType, windows.LONG lParam);

STDAPI AVIFileCreateStream  (PAVIFILE pfile, PAVISTREAM FAR *ppavi, AVISTREAMINFO FAR * psi);

STDAPI AVIFileWriteData	(PAVIFILE pfile,
					 windows.DWORD ckid,
					 windows.PVOID lpData,
					 windows.LONG cbData);
STDAPI AVIFileReadData	(PAVIFILE pfile,
					 windows.DWORD ckid,
					 windows.PVOID lpData,
					 windows.LONG FAR *lpcbData);
STDAPI AVIFileEndRecord	(PAVIFILE pfile);

STDAPI_(ULONG) AVIStreamAddRef       (PAVISTREAM pavi);
STDAPI_(ULONG) AVIStreamRelease      (PAVISTREAM pavi);

STDAPI AVIStreamInfo  (PAVISTREAM pavi, PAVISTREAMINFO psi, windows.LONG lSize);

STDAPI_(windows.LONG) AVIStreamFindSample(PAVISTREAM pavi, windows.LONG lPos, windows.LONG lFlags);
STDAPI AVIStreamReadFormat   (PAVISTREAM pavi, windows.LONG lPos,windows.PVOID lpFormat,windows.LONG FAR *lpcbFormat);
STDAPI AVIStreamSetFormat    (PAVISTREAM pavi, windows.LONG lPos,windows.PVOID lpFormat,windows.LONG cbFormat);
STDAPI AVIStreamReadData     (PAVISTREAM pavi, windows.DWORD fcc, windows.PVOID lp, windows.LONG FAR *lpcb);
STDAPI AVIStreamWriteData    (PAVISTREAM pavi, windows.DWORD fcc, windows.PVOID lp, windows.LONG cb);

STDAPI AVIStreamRead         (PAVISTREAM pavi,
			      windows.LONG lStart,
			      windows.LONG lSamples,
