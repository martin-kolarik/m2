(************************************************************************

    decompression functions

************************************************************************)

(*
 *  ICDecompress()
 *
 *  decompress a single frame
 *
 *)
(*
CONST
  ICDECOMPRESS_HURRYUP    = 080000000H;     (* don't draw just buffer (hurry up!) *)
*)

PROCEDURE ICDecompress(
    hic         : HIC;
    dwFlags     : windows.DWORD;              (* flags (from AVI index...) *)
    lpbiFormat  : windows.PBITMAPINFOHEADER; (* BITMAPINFO of compressed data *)
                                      (* biSizeImage has the chunk SIZE *)
    lpData      : windows.PVOID;
    lpbi        : windows.PBITMAPINFOHEADER; (* DIB to decompress TO *)
    lpBits      : windows.PVOID ) : windows.DWORD;

(*# save, call( macro => on ) *)

(*
 *  ICDecompressBegin()
 *
 *  start compression from a source format (lpbiInput) to a dest
 *  format (lpbiOutput) is supported.
 *
 *)
PROCEDURE ICDecompressBegin(hic : HIC; lpbiInput : windows.DWORD; lpbiOutput : windows.DWORD) : windows.LRESULT;
(*    ICSendMessage(hic, ICM_DECOMPRESS_BEGIN, (windows.DWORD)(windows.PVOID)(lpbiInput), (windows.DWORD)(windows.PVOID)(lpbiOutput)) *)

(*
 *  ICDecompressQuery()
 *
 *  determines if compression from a source format (lpbiInput) to a dest
 *  format (lpbiOutput) is supported.
 *
 *)
PROCEDURE ICDecompressQuery(hic : HIC; lpbiInput : windows.DWORD; lpbiOutput : windows.DWORD) : windows.LRESULT;
(*    ICSendMessage(hic, ICM_DECOMPRESS_QUERY, (windows.DWORD)(windows.PVOID)(lpbiInput), (windows.DWORD)(windows.PVOID)(lpbiOutput)) *)

(*
 *  ICDecompressGetFormat()
 *
 *  get the output format, (format of un-compressed data)
 *  if lpbiOutput is NULL return the size in bytes needed for format.
 *
 *)
PROCEDURE ICDecompressGetFormat(hic : HIC; lpbiInput : windows.DWORD; lpbiOutput : windows.DWORD) : windows.LRESULT;
(*    ((windows.LONG) ICSendMessage(hic, ICM_DECOMPRESS_GET_FORMAT, (windows.DWORD)(windows.PVOID)(lpbiInput), (windows.DWORD)(windows.PVOID)(lpbiOutput))) *)

PROCEDURE ICDecompressGetFormatSize(hic : HIC; lpbi : windows.DWORD) : windows.LRESULT;
(*    ICDecompressGetFormat(hic, lpbi, NULL) *)

(*
 *  ICDecompressGetPalette()
 *
 *  get the output palette
 *
 *)
PROCEDURE ICDecompressGetPalette(hic : HIC; lpbiInput : windows.DWORD; lpbiOutput : windows.DWORD) : windows.LRESULT;
(*    ICSendMessage(hic, ICM_DECOMPRESS_GET_PALETTE, (windows.DWORD)(windows.PVOID)(lpbiInput), (windows.DWORD)(windows.PVOID)(lpbiOutput)) *)

PROCEDURE ICDecompressSetPalette(hic : HIC; lpbiPalette : windows.DWORD) : windows.LRESULT;
(*    ICSendMessage(hic, ICM_DECOMPRESS_SET_PALETTE, (windows.DWORD)(windows.PVOID)(lpbiPalette), 0) *)

PROCEDURE ICDecompressEnd(hic : HIC) : windows.LRESULT;
(*    ICSendMessage(hic, ICM_DECOMPRESS_END, 0, 0) *)

(*# restore *)

