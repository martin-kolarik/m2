 *
 *)
PROCEDURE ICCompressGetSize(hic : HIC; lpbiInput : windows.DWORD; lpbiOutput : windows.DWORD) : windows.LRESULT;
(*    ICSendMessage(hic, ICM_COMPRESS_GET_SIZE, (windows.DWORD)(windows.PVOID)(lpbiInput), (windows.DWORD)(windows.PVOID)(lpbiOutput)) *)

PROCEDURE ICCompressEnd(hic : HIC) : windows.LRESULT;
