(* ------------------------------------------------------------------ *)
(*  Structures *)
(* ------------------------------------------------------------------ *)

TYPE
  CAPDRIVERCAPS   = RECORD
    wDeviceIndex                : windows.UINT;       (* Driver index in system.ini *)
    fHasOverlay                 : windows.BOOL;       (* Can device overlay? *)
    fHasDlgVideoSource          : windows.BOOL;       (* Has Video source dlg? *)
    fHasDlgVideoFormat          : windows.BOOL;       (* Has Format dlg? *)
    fHasDlgVideoDisplay         : windows.BOOL;       (* Has External out dlg? *)
    fCaptureInitialized         : windows.BOOL;       (* Driver ready to capture? *)
    fDriverSuppliesPalettes     : windows.BOOL;       (* Can driver make palettes? *)

(* following always NULL on Win32. *)
    hVideoIn     : windows.HANDLE;   (* Driver In channel *)
    hVideoOut    : windows.HANDLE; (* Driver Out channel *)
    hVideoExtIn  : windows.HANDLE;  (* Driver Ext In channel *)
    hVideoExtOut : windows.HANDLE;  (* Driver Ext Out channel *)
  END;
  PCAPDRIVERCAPS = POINTER TO CAPDRIVERCAPS; (* FAR  *)

TYPE
  CAPSTATUS   = RECORD
    uiImageWidth                : windows.UINT;      (* Width of the image *)
    uiImageHeight               : windows.UINT;      (* Height of the image *)
    fLiveWindow                 : windows.BOOL;      (* Now Previewing video? *)
    fOverlayWindow              : windows.BOOL;      (* Now Overlaying video? *)
    fScale                      : windows.BOOL;      (* Scale image to client? *)
    ptScroll                    : POINT;     (* Scroll position *)
    fUsingDefaultPalette        : windows.BOOL;      (* Using default driver palette? *)
    fAudioHardware              : windows.BOOL;      (* Audio hardware present? *)
    fCapFileExists              : windows.BOOL;      (* Does capture file exist? *)
    dwCurrentVideoFrame         : windows.DWORD;     (* # of video frames cap'td *)
    dwCurrentVideoFramesDropped : windows.DWORD;     (* # of video frames dropped *)
    dwCurrentWaveSamples        : windows.DWORD;     (* # of wave samples cap'td *)
    dwCurrentTimeElapsedMS      : windows.DWORD;     (* Elapsed capture duration *)
    hPalCurrent                 : windows.HPALETTE;  (* Current palette in use *)
    fCapturingNow               : windows.BOOL;      (* Capture in progress? *)
    dwReturn                    : windows.DWORD;     (* Error value after any operation *)
    wNumVideoAllocated          : windows.UINT;      (* Actual number of video buffers *)
    wNumAudioAllocated          : windows.UINT;      (* Actual number of audio buffers *)
  END;
  PCAPSTATUS = POINTER TO CAPSTATUS; (* FAR  *)

                                      (* Default values in parenthesis *)
TYPE
  CAPTUREPARMS   = RECORD
    dwRequestMicroSecPerFrame   : windows.DWORD;        (* Requested capture rate *)
    fMakeUserHitOKToCapture     : windows.BOOL;         (* Show "Hit OK to cap" dlg? *)
    wPercentDropForError        : windows.UINT;         (* Give error msg if > (10%) *)
    fYield                      : windows.BOOL;         (* Capture via background task? *)
    dwIndexSize                 : windows.DWORD;        (* Max index size in frames (32K) *)
    wChunkGranularity           : windows.UINT;         (* Junk chunk granularity (2K) *)
    fUsingDOSMemory             : windows.BOOL;         (* Use DOS buffers? *)
    wNumVideoRequested          : windows.UINT;         (* # video buffers, If 0, autocalc *)
    fCaptureAudio               : windows.BOOL;         (* Capture audio? *)
    wNumAudioRequested          : windows.UINT;         (* # audio buffers, If 0, autocalc *)
    vKeyAbort                   : windows.UINT;         (* Virtual key causing abort *)
    fAbortLeftMouse             : windows.BOOL;         (* Abort on left mouse? *)
    fAbortRightMouse            : windows.BOOL;         (* Abort on right mouse? *)
    fLimitEnabled               : windows.BOOL;         (* Use wTimeLimit? *)
    wTimeLimit                  : windows.UINT;         (* Seconds to capture *)
    fMCIControl                 : windows.BOOL;         (* Use MCI video source? *)
    fStepMCIDevice              : windows.BOOL;         (* Step MCI device? *)
    dwMCIStartTime              : windows.DWORD;        (* Time to start in MS *)
    dwMCIStopTime               : windows.DWORD;        (* Time to stop in MS *)
    fStepCaptureAt2x            : windows.BOOL;         (* Perform spatial averaging 2x *)
    wStepCaptureAverageFrames   : windows.UINT;         (* Temporal average n Frames *)
    dwAudioBufferSize           : windows.DWORD;        (* Size of audio bufs (0 = default) *)
    fDisableWriteCache          : windows.BOOL;         (* Attempt to disable write cache *)
    AVStreamMaster              : windows.UINT;         (* Which stream controls length? *)
  END;
  PCAPTUREPARMS = POINTER TO CAPTUREPARMS; (* FAR  *)

(* ------------------------------------------------------------------ *)
(*  AVStreamMaster *)
(*  Since Audio and Video streams generally use non-synchronized capture *)
(*  clocks, this flag determines whether the audio stream is to be considered *)
(*  the master or controlling clock when writing the AVI file: *)
(* *)
(*  AVSTREAMMASTER_AUDIO  - Audio is master, video frame duration is forced *)
(*                          to match audio duration (VFW 1.0, 1.1 default) *)
(*  AVSTREAMMASTER_NONE   - No master, audio and video streams may be OF *)
(*                          different lengths *)
(* ------------------------------------------------------------------ *)
CONST
  AVSTREAMMASTER_AUDIO            = 0; (* Audio master (VFW 1.0, 1.1) *)
  AVSTREAMMASTER_NONE             = 1; (* No master *)

TYPE
  CAPINFOCHUNK   = RECORD
    fccInfoID    : FOURCC;      (* Chunk ID, "ICOP" for copyright *)
    lpData       : windows.PVOID;      (* pointer to data *)
    cbData       : windows.LONG;        (* size of lpData *)
  END;
  PCAPINFOCHUNK = POINTER TO CAPINFOCHUNK; (* FAR  *)

(* ------------------------------------------------------------------ *)
(*  Callback Definitions *)
(* ------------------------------------------------------------------ *)

TYPE
  PROCEDURE CAPYIELDCALLBACK(hWnd : windows.HWND) : windows.LRESULT;
  PROCEDURE CAPSTATUSCALLBACK(hWnd : windows.HWND; nID : INTEGER; lpsz : windows.PCTSTR) : windows.LRESULT;
  PROCEDURE CAPERRORCALLBACK(hWnd : windows.HWND; nID : INTEGER; lpsz : windows.PCTSTR) : windows.LRESULT;
  PROCEDURE CAPVIDEOCALLBACK(hWnd : windows.HWND; lpVHdr : PVIDEOHDR) : windows.LRESULT;
  PROCEDURE CAPWAVECALLBACK(hWnd : windows.HWND; lpWHdr : PWAVEHDR) : windows.LRESULT;
  PROCEDURE CAPCONTROLCALLBACK(hWnd : windows.HWND; nState : INTEGER) : windows.LRESULT;

(* ------------------------------------------------------------------ *)
(*  CapControlCallback states *)
(* ------------------------------------------------------------------ *)
CONST
  CONTROLCALLBACK_PREROLL         = 1; (* Waiting to start capture *)
  CONTROLCALLBACK_CAPTURING       = 2; (* Now capturing *)

(* ------------------------------------------------------------------ *)
(*  The only exported functions from AVICAP.DLL *)
(* ------------------------------------------------------------------ *)

PROCEDURE capCreateCaptureWindow(
        lpszWindowName           : windows.PCTSTR;
        dwStyle                  : windows.DWORD;
        x                        : INTEGER;
        y                        : INTEGER;
        nWidth                   : INTEGER;
        nHeight                  : INTEGER;
        hwndParent               : windows.HWND;
        nID                      : INTEGER
        ) : windows.HWND;

PROCEDURE capGetDriverDescription(
        wDriverIndex             : windows.UINT;
        lpszName                 : windows.PTSTR;
        cbName                   : INTEGER;
        lpszVer                  : windows.PTSTR;
        cbVer                    : INTEGER
        ) : windows.BOOL;

(* ------------------------------------------------------------------ *)
(* New Information chunk IDs *)
(* ------------------------------------------------------------------ *)
CONST
  infotypeDIGITIZATION_TIME = windows.DWORD( ORD( 'I' ) + ORD('D') << 8 + ORD('I') << 16 + ORD('T') << 24 );
  infotypeSMPTE_TIME        = windows.DWORD( ORD( 'I' ) + ORD('S') << 8 + ORD('M') << 16 + ORD('P') << 24 );

(* ------------------------------------------------------------------ *)
(* String IDs from status and error callbacks *)
(* ------------------------------------------------------------------ *)

  IDS_CAP_BEGIN               = 300;  (* "Capture Start" *)
  IDS_CAP_END                 = 301;  (* "Capture End" *)

  IDS_CAP_INFO                = 401;  (* "%s" *)
  IDS_CAP_OUTOFMEM            = 402;  (* "Out of memory" *)
  IDS_CAP_FILEEXISTS          = 403;  (* "File '%s' exists -- overwrite it?" *)
  IDS_CAP_ERRORPALOPEN        = 404;  (* "Error opening palette '%s'" *)
  IDS_CAP_ERRORPALSAVE        = 405;  (* "Error saving palette '%s'" *)
  IDS_CAP_ERRORDIBSAVE        = 406;  (* "Error saving frame '%s'" *)
  IDS_CAP_DEFAVIEXT           = 407;  (* "avi" *)
  IDS_CAP_DEFPALEXT           = 408;  (* "pal" *)
  IDS_CAP_CANTOPEN            = 409;  (* "Cannot open '%s'" *)
  IDS_CAP_SEQ_MSGSTART        = 410;  (* "Select OK to start capture\nof video sequence\nto %s." *)
  IDS_CAP_SEQ_MSGSTOP         = 411;  (* "Hit ESCAPE or click to end capture" *)

  IDS_CAP_VIDEDITERR          = 412;  (* "An error occurred while trying to run VidEdit." *)
  IDS_CAP_READONLYFILE        = 413;  (* "The file '%s' is a read-only file." *)
  IDS_CAP_WRITEERROR          = 414;  (* "Unable to write to file '%s'.\nDisk may be full." *)
  IDS_CAP_NODISKSPACE         = 415;  (* "There is no space to create a capture file on the specified device." *)
  IDS_CAP_SETFILESIZE         = 416;  (* "Set File Size" *)
  IDS_CAP_SAVEASPERCENT       = 417;  (* "SaveAs: %2ld%%  Hit Escape to abort." *)

  IDS_CAP_DRIVER_ERROR        = 418;  (* Driver specific error message *)

  IDS_CAP_WAVE_OPEN_ERROR     = 419;  (* "Error: Cannot open the wave input device.\nCheck sample size, frequency, and channels." *)
  IDS_CAP_WAVE_ALLOC_ERROR    = 420;  (* "Error: Out of memory for wave buffers." *)
  IDS_CAP_WAVE_PREPARE_ERROR  = 421;  (* "Error: Cannot prepare wave buffers." *)
  IDS_CAP_WAVE_ADD_ERROR      = 422;  (* "Error: Cannot add wave buffers." *)
  IDS_CAP_WAVE_SIZE_ERROR     = 423;  (* "Error: Bad wave size." *)

  IDS_CAP_VIDEO_OPEN_ERROR    = 424;  (* "Error: Cannot open the video input device." *)
  IDS_CAP_VIDEO_ALLOC_ERROR   = 425;  (* "Error: Out of memory for video buffers." *)
  IDS_CAP_VIDEO_PREPARE_ERROR = 426;  (* "Error: Cannot prepare video buffers." *)
  IDS_CAP_VIDEO_ADD_ERROR     = 427;  (* "Error: Cannot add video buffers." *)
  IDS_CAP_VIDEO_SIZE_ERROR    = 428;  (* "Error: Bad video size." *)

  IDS_CAP_FILE_OPEN_ERROR     = 429;  (* "Error: Cannot open capture file." *)
  IDS_CAP_FILE_WRITE_ERROR    = 430;  (* "Error: Cannot write to capture file.  Disk may be full." *)
  IDS_CAP_RECORDING_ERROR     = 431;  (* "Error: Cannot write to capture file.  Data rate too high or disk full." *)
  IDS_CAP_RECORDING_ERROR2    = 432;  (* "Error while recording" *)
  IDS_CAP_AVI_INIT_ERROR      = 433;  (* "Error: Unable to initialize for capture." *)
  IDS_CAP_NO_FRAME_CAP_ERROR  = 434;  (* "Warning: No frames captured.\nConfirm that vertical sync interrupts\nare configured and enabled." *)
  IDS_CAP_NO_PALETTE_WARN     = 435;  (* "Warning: Using default palette." *)
  IDS_CAP_MCI_CONTROL_ERROR   = 436;  (* "Error: Unable to access MCI device." *)
  IDS_CAP_MCI_CANT_STEP_ERROR = 437;  (* "Error: Unable to step MCI device." *)
  IDS_CAP_NO_AUDIO_CAP_ERROR  = 438;  (* "Error: No audio data captured.\nCheck audio card settings." *)
  IDS_CAP_AVI_DRAWDIB_ERROR   = 439;  (* "Error: Unable to draw this data format." *)
  IDS_CAP_COMPRESSOR_ERROR    = 440;  (* "Error: Unable to initialize compressor." *)
  IDS_CAP_AUDIO_DROP_ERROR    = 441;  (* "Error: Audio data was lost during capture, reduce capture rate." *)

(* status string IDs *)
  IDS_CAP_STAT_LIVE_MODE      = 500;  (* "Live window" *)
  IDS_CAP_STAT_OVERLAY_MODE   = 501;  (* "Overlay window" *)
  IDS_CAP_STAT_CAP_INIT       = 502;  (* "Setting up for capture - Please wait" *)
  IDS_CAP_STAT_CAP_FINI       = 503;  (* "Finished capture, now writing frame %ld" *)
  IDS_CAP_STAT_PALETTE_BUILD  = 504;  (* "Building palette map" *)
  IDS_CAP_STAT_OPTPAL_BUILD   = 505;  (* "Computing optimal palette" *)
  IDS_CAP_STAT_I_FRAMES       = 506;  (* "%d frames" *)
  IDS_CAP_STAT_L_FRAMES       = 507;  (* "%ld frames" *)
  IDS_CAP_STAT_CAP_L_FRAMES   = 508;  (* "Captured %ld frames" *)
  IDS_CAP_STAT_CAP_AUDIO      = 509;  (* "Capturing audio" *)
  IDS_CAP_STAT_VIDEOCURRENT   = 510;  (* "Captured %ld frames (%ld dropped) %d.%03d sec." *)
  IDS_CAP_STAT_VIDEOAUDIO     = 511;  (* "Captured %d.%03d sec.  %ld frames (%ld dropped) (%d.%03d fps).  %ld audio bytes (%d,%03d sps)" *)
  IDS_CAP_STAT_VIDEOONLY      = 512;  (* "Captured %d.%03d sec.  %ld frames (%ld dropped) (%d.%03d fps)" *)
  IDS_CAP_STAT_FRAMESDROPPED  = 513;  (* "Dropped %ld of %ld frames (%d.%02d%%) during capture." *)

