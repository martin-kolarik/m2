PROCEDURE ICOpen(fccType : windows.DWORD; fccHandler : windows.DWORD; wMode : windows.UINT) : HIC;
PROCEDURE ICOpenFunction(fccType : windows.DWORD; fccHandler : windows.DWORD; wMode : windows.UINT; lpfnHandler : windows.FARPROC) : HIC;
