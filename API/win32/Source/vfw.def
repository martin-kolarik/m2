(****** AVI Stream Interface *******************************************)

#undef  INTERFACE
#define INTERFACE   IAVIStream

DECLARE_INTERFACE_(IAVIStream, IUnknown)
{
    (* *** IUnknown methods *** *)
    STDMETHOD(QueryInterface) (THIS_ REFIID riid, windows.PVOID FAR* ppvObj) PURE;
    STDMETHOD_(ULONG,AddRef) (THIS)  PURE;
    STDMETHOD_(ULONG,Release) (THIS) PURE;

    (* *** IAVIStream methods *** *)
    STDMETHOD(Create)      (THIS_ windows.LPARAM lParam1, windows.LPARAM lParam2) PURE ;
    STDMETHOD(Info)        (THIS_ AVISTREAMINFO FAR * psi, windows.LONG lSize) PURE ;
    STDMETHOD_(windows.LONG, FindSample)(THIS_ windows.LONG lPos, windows.LONG lFlags) PURE ;
    STDMETHOD(ReadFormat)  (THIS_ windows.LONG lPos,
			    windows.PVOID lpFormat, windows.LONG FAR *lpcbFormat) PURE ;
    STDMETHOD(SetFormat)   (THIS_ windows.LONG lPos,
			    windows.PVOID lpFormat, windows.LONG cbFormat) PURE ;
    STDMETHOD(Read)        (THIS_ windows.LONG lStart, windows.LONG lSamples,
			    windows.PVOID lpBuffer, windows.LONG cbBuffer,
			    windows.LONG FAR * plBytes, windows.LONG FAR * plSamples) PURE ;
    STDMETHOD(Write)       (THIS_ windows.LONG lStart, windows.LONG lSamples,
			    windows.PVOID lpBuffer, windows.LONG cbBuffer,
			    windows.DWORD dwFlags,
			    windows.LONG FAR *plSampWritten,
			    windows.LONG FAR *plBytesWritten) PURE ;
    STDMETHOD(Delete)      (THIS_ windows.LONG lStart, windows.LONG lSamples) PURE;
    STDMETHOD(ReadData)    (THIS_ windows.DWORD fcc, windows.PVOID lp, windows.LONG FAR *lpcb) PURE ;
    STDMETHOD(WriteData)   (THIS_ windows.DWORD fcc, windows.PVOID lp, windows.LONG cb) PURE ;
    STDMETHOD(SetInfo) (THIS_ AVISTREAMINFO FAR * lpInfo,
			    windows.LONG cbInfo) PURE;
};

typedef       IAVIStream FAR* PAVISTREAM;

#undef  INTERFACE
#define INTERFACE   IAVIStreaming

DECLARE_INTERFACE_(IAVIStreaming, IUnknown)
{
    (* *** IUnknown methods *** *)
    STDMETHOD(QueryInterface) (THIS_ REFIID riid, windows.PVOID FAR* ppvObj) PURE;
    STDMETHOD_(ULONG,AddRef) (THIS)  PURE;
    STDMETHOD_(ULONG,Release) (THIS) PURE;

    (* *** IAVIStreaming methods *** *)
    STDMETHOD(Begin) (THIS_
		      windows.LONG  lStart,		    (* start of what we expect *)
						    (* to play *)
		      windows.LONG  lEnd,		    (* expected end, or -1 *)
		      windows.LONG  lRate) PURE;	    (* Should this be a float? *)
    STDMETHOD(End)   (THIS) PURE;
};

typedef       IAVIStreaming FAR* PAVISTREAMING;

#undef  INTERFACE
#define INTERFACE   IAVIEditStream

DECLARE_INTERFACE_(IAVIEditStream, IUnknown)
{
    (* *** IUnknown methods *** *)
    STDMETHOD(QueryInterface) (THIS_ REFIID riid, windows.PVOID FAR* ppvObj) PURE;
    STDMETHOD_(ULONG,AddRef) (THIS)  PURE;
    STDMETHOD_(ULONG,Release) (THIS) PURE;

    (* *** IAVIEditStream methods *** *)
    STDMETHOD(Cut) (THIS_ windows.LONG FAR *plStart,
			  windows.LONG FAR *plLength,
			  PAVISTREAM FAR * ppResult) PURE;
    STDMETHOD(Copy) (THIS_ windows.LONG FAR *plStart,
			   windows.LONG FAR *plLength,
			   PAVISTREAM FAR * ppResult) PURE;
    STDMETHOD(Paste) (THIS_ windows.LONG FAR *plPos,
			    windows.LONG FAR *plLength,
			    PAVISTREAM pstream,
			    windows.LONG lStart,
			    windows.LONG lEnd) PURE;
    STDMETHOD(Clone) (THIS_ PAVISTREAM FAR *ppResult) PURE;
    STDMETHOD(SetInfo) (THIS_ AVISTREAMINFO FAR * lpInfo,
			    windows.LONG cbInfo) PURE;
};

typedef       IAVIEditStream FAR* PAVIEDITSTREAM;

(****** AVI File Interface *******************************************)

#undef  INTERFACE
#define INTERFACE   IAVIFile
#define PAVIFILE IAVIFile FAR*

DECLARE_INTERFACE_(IAVIFile, IUnknown)
{
    (* *** IUnknown methods *** *)
    STDMETHOD(QueryInterface) (THIS_ REFIID riid, windows.PVOID FAR* ppvObj) PURE;
    STDMETHOD_(ULONG,AddRef) (THIS)  PURE;
    STDMETHOD_(ULONG,Release) (THIS) PURE;

    (* *** IAVIFile methods *** *)
    STDMETHOD(Info)                 (THIS_
                                     AVIFILEINFO FAR * pfi,
                                     windows.LONG lSize) PURE;
    STDMETHOD(GetStream)            (THIS_
                                     PAVISTREAM FAR * ppStream,
				     windows.DWORD fccType,
                                     windows.LONG lParam) PURE;
    STDMETHOD(CreateStream)         (THIS_
                                     PAVISTREAM FAR * ppStream,
                                     AVISTREAMINFO FAR * psi) PURE;
    STDMETHOD(WriteData)            (THIS_
                                     windows.DWORD ckid,
                                     windows.PVOID lpData,
                                     windows.LONG cbData) PURE;
    STDMETHOD(ReadData)             (THIS_
                                     windows.DWORD ckid,
                                     windows.PVOID lpData,
                                     windows.LONG FAR *lpcbData) PURE;
    STDMETHOD(EndRecord)            (THIS) PURE;
    STDMETHOD(DeleteStream)         (THIS_
				     windows.DWORD fccType,
                                     windows.LONG lParam) PURE;
};

#undef PAVIFILE
typedef       IAVIFile FAR* PAVIFILE;

