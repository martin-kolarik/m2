(****************************************************************************
 *
 *  AVIFMT - AVI file format definitions
 *
 ****************************************************************************)

TYPE
  FOURCC = windows.DWORD;

(*
#ifdef _MSC_VER
#pragma warning(disable:4200)
#endif
*)

(* The following is a short description of the AVI file format.  Please
 * see the accompanying documentation for a full explanation.
 *
 * An AVI file is the following RIFF form:
 *
 *	RIFF('AVI'
 *	      LIST('hdrl'
 *		    avih(<MainAVIHeader>)
 *                  LIST ('strl'
 *                      strh(<Stream header>)
 *                      strf(<Stream format>)
 *                      ... additional header data
 *            LIST('movi'	
 *      	  { LIST('rec'
 *      		      SubChunk...
 *      		   )
 *      	      | SubChunk } ....	    
 *            )
 *            [ <AVIIndex> ]
 *      )
 *
 *	The main file header specifies how many streams are present.  For
 *	each one, there must be a stream header chunk and a stream format
 *	chunk, enlosed in a 'strl' LIST chunk.  The 'strf' chunk contains
 *	type-specific format information; for a video stream, this should
 *	be a BITMAPINFO structure, including palette.  For an audio stream,
 *	this should be a WAVEFORMAT (or PCMWAVEFORMAT) structure.
 *
 *	The actual data is contained in subchunks within the 'movi' LIST 
 *	chunk.  The first two characters of each data chunk are the
 *	stream number with which that data is associated.
 *
 *	Some defined chunk types:
 *           Video Streams:
 *                  ##db:	RGB DIB bits
 *                  ##dc:	RLE8 compressed DIB bits
 *                  ##pc:	Palette Change
 *
 *           Audio Streams:
 *                  ##wb:	waveform audio bytes
 *
 * The grouping into LIST 'rec' chunks implies only that the contents of
 *   the chunk should be read into memory at the same time.  This
 *   grouping is used for files specifically intended to be played from 
 *   CD-ROM.
 *
 * The index chunk at the end of the file should contain one entry for 
 *   each data chunk in the file.
 *
 * Limitations for the current software:
 *	Only one video stream and one audio stream are allowed.
 *	The streams must start at the beginning of the file.
 *
 * 
 * To register codec types please obtain a copy of the Multimedia
 * Developer Registration Kit from:
 *
 *  Microsoft Corporation
 *  Multimedia Systems Group
 *  Product Marketing
 *  One Microsoft Way
 *  Redmond, WA 98052-6399
 *
 *)


(*
#ifndef mmioFOURCC
PROCEDURE mmioFOURCC(ch0, ch1, ch2, ch3 : CHAR ) : windows.DWORD;
(* ( (windows.DWORD)(BYTE)(ch0) | ( (windows.DWORD)(BYTE)(ch1) << 8 ) | ( (windows.DWORD)(BYTE)(ch2) << 16 ) | ( (windows.DWORD)(BYTE)(ch3) << 24 ) ) *)	
#endif

#ifndef aviTWOCC
PROCEDURE aviTWOCC(ch0, ch1 : CHAR ) : WORD;
(* ( (WORD)(BYTE)(ch0) | ((WORD)(BYTE)(ch1) << 8) ) *)
#endif
*)

TYPE
  TWOCC = WORD;

(* form types, list types, and chunk types *)
CONST
  formtypeAVI               = windows.DWORD( ORD( 'A' ) + ORD('V') << 8 + ORD('I') << 16 + ORD(' ') << 24 );
  listtypeAVIHEADER         = windows.DWORD( ORD( 'h' ) + ORD('d') << 8 + ORD('r') << 16 + ORD('l') << 24 );
  ckidAVIMAINHDR            = windows.DWORD( ORD( 'a' ) + ORD('v') << 8 + ORD('i') << 16 + ORD('h') << 24 );
  listtypeSTREAMHEADER      = windows.DWORD( ORD( 's' ) + ORD('t') << 8 + ORD('r') << 16 + ORD('l') << 24 );
  ckidSTREAMHEADER          = windows.DWORD( ORD( 's' ) + ORD('t') << 8 + ORD('r') << 16 + ORD('h') << 24 );
  ckidSTREAMFORMAT          = windows.DWORD( ORD( 's' ) + ORD('t') << 8 + ORD('r') << 16 + ORD('f') << 24 );
  ckidSTREAMHANDLERDATA     = windows.DWORD( ORD( 's' ) + ORD('t') << 8 + ORD('r') << 16 + ORD('d') << 24 );
  ckidSTREAMNAME            = windows.DWORD( ORD( 's' ) + ORD('t') << 8 + ORD('r') << 16 + ORD('n') << 24 );

  listtypeAVIMOVIE          = windows.DWORD( ORD( 'm' ) + ORD('o') << 8 + ORD('v') << 16 + ORD('i') << 24 );
  listtypeAVIRECORD         = windows.DWORD( ORD( 'r' ) + ORD('e') << 8 + ORD('c') << 16 + ORD(' ') << 24 );

  ckidAVINEWINDEX           = windows.DWORD( ORD( 'i' ) + ORD('d') << 8 + ORD('x') << 16 + ORD('1') << 24 );

(*
** Stream types for the <fccType> field of the stream header.
*)
  streamtypeVIDEO           = windows.DWORD( ORD( 'v' ) + ORD('i') << 8 + ORD('d') << 16 + ORD('s') << 24 );
  streamtypeAUDIO           = windows.DWORD( ORD( 'a' ) + ORD('u') << 8 + ORD('d') << 16 + ORD('s') << 24 );
  streamtypeMIDI            = windows.DWORD( ORD( 'm' ) + ORD('i') << 8 + ORD('d') << 16 + ORD('s') << 24 );
  streamtypeTEXT            = windows.DWORD( ORD( 't' ) + ORD('x') << 8 + ORD('t') << 16 + ORD('s') << 24 );

(* Basic chunk types *)
  cktypeDIBbits             = windows.DWORD( ORD( 'd' ) + ORD('b') << 8 );
  cktypeDIBcompressed       = windows.DWORD( ORD( 'd' ) + ORD('c') << 8 );
  cktypePALchange           = windows.DWORD( ORD( 'p' ) + ORD('c') << 8 );
  cktypeWAVbytes            = windows.DWORD( ORD( 'w' ) + ORD('b') << 8 );

(* Chunk id to use for extra chunks for padding. *)
  ckidAVIPADDING            = windows.DWORD( ORD( 'J' ) + ORD('U') << 8 + ORD('N') << 16 + ORD('K') << 24 );

(*
** Useful macros
**
** Warning: These are nasty macro, and MS C 6.0 compiles some of them
** incorrectly if optimizations are on.  Ack.
*)

(*
#ifndef mmioFOURCC
PROCEDURE mmioFOURCC(ch0, ch1, ch2, ch3 : CHAR ) : windows.DWORD;
(* ( (windows.DWORD)(BYTE)(ch0) | ( (windows.DWORD)(BYTE)(ch1) << 8 ) | ( (windows.DWORD)(BYTE)(ch2) << 16 ) | ( (windows.DWORD)(BYTE)(ch3) << 24 ) ) *)	
#endif

#ifndef aviTWOCC
PROCEDURE aviTWOCC(ch0, ch1 : CHAR ) : WORD;
(* ( (WORD)(BYTE)(ch0) | ((WORD)(BYTE)(ch1) << 8) ) *)
#endif
*)

(*# save, call( macro => on ) *)

(* Macro to get stream number out of a FOURCC ckid *)
PROCEDURE FromHex( n : BYTE ) : BYTE;
(* (((n) >= 'A') ? ((n) + 10 - 'A') : ((n) - '0')) *)
PROCEDURE StreamFromFOURCC( fcc : windows.DWORD ) : WORD;
(* ((WORD) ((FromHex(LOBYTE(LOWORD(fcc))) << 4) + (FromHex(HIBYTE(LOWORD(fcc)))))) *)

(* Macro to get TWOCC chunk type out of a FOURCC ckid *)
PROCEDURE TWOCCFromFOURCC( fcc : windows.DWORD ) : WORD;

(* Macro to make a ckid for a chunk out of a TWOCC and a stream number
** from 0-255.
*)
PROCEDURE ToHex( n : BYTE ) : BYTE;
(* ((BYTE) (((n) > 9) ? ((n) - 10 + 'A') : ((n) + '0'))) *)
PROCEDURE MAKEAVICKID( tcc : WORD; stream : BYTE ) : windows.DWORD;
(* MAKELONG((ToHex((stream) & 0x0f) << 8) | (ToHex(((stream) & 0xf0) >> 4)), tcc) *)

(*# restore *)

(*
** Main AVI File Header
*)	
		
(* flags for use in <dwFlags> in AVIFileHdr *)
CONST
  AVIF_HASINDEX		= 00000010H;    (* Index at end of file? *)
  AVIF_MUSTUSEINDEX	= 00000020H;
  AVIF_ISINTERLEAVED	= 00000100H;
  AVIF_TRUSTCKTYPE	= 00000800H;	(* Use CKType to find key frames? *)
  AVIF_WASCAPTUREFILE	= 00010000H;
  AVIF_COPYRIGHTED	= 00020000H;

(* The AVI File Header LIST chunk should be padded to this size *)
  AVI_HEADERSIZE  = 2048;                    (* size of AVI header list *)

TYPE
  MainAVIHeader = RECORD
    dwMicroSecPerFrame   : windows.DWORD; (* frame display rate (or 0L) *)
    dwMaxBytesPerSec     : windows.DWORD; (* max. transfer rate *)
    dwPaddingGranularity : windows.DWORD; (* pad to multiples of this *)
                                          (* size; normally 2K. *)
    dwFlags              : windows.DWORD; (* the ever-present flags *)
    dwTotalFrames        : windows.DWORD; (* # frames in file *)
    dwInitialFrames      : windows.DWORD;
    dwStreams            : windows.DWORD;
    dwSuggestedBufferSize : windows.DWORD;

    dwWidth               : windows.DWORD;
    dwHeight              : windows.DWORD;

    dwReserved            : ARRAY [0..3] OF windows.DWORD;
  END;

(*
** Stream header
*)

CONST
  AVISF_DISABLED	 = 00000001H;

  AVISF_VIDEO_PALCHANGES = 00010000H;

TYPE
  AVIStreamHeader = RECORD
    fccType    : FOURCC;
    fccHandler : FOURCC;		
    dwFlags    : windows.DWORD; (* Contains AVITF_* flags *)
    wPriority  : WORD;
    wLanguage  : WORD;
    dwInitialFrames  : windows.DWORD;		
    dwScale          : windows.DWORD;
    dwRate           : windows.DWORD;   (* dwRate / dwScale == samples/second *)
    dwStart          : windows.DWORD;		
    dwLength         : windows.DWORD;   (* In units above... *)
    dwSuggestedBufferSize       : windows.DWORD;		
    dwQuality                   : windows.DWORD;		
    dwSampleSize                : windows.DWORD;		
    rcFrame                     : windows.RECT;		
  END;
(* Flags for index *)

CONST
(*
  AVIIF_LIST          = 00000001H; (* chunk is a 'LIST' *)

  AVIIF_KEYFRAME      = 00000010H; (* this frame is a key frame. *)
*)

  AVIIF_NOTIME	      = 00000100H; (* this frame doesn't take any time *)
  AVIIF_COMPUSE       = 0FFF0000H; (* these bits are for compressor use *)

TYPE
  AVIINDEXENTRY = RECORD
    ckid          : windows.DWORD;		
    dwFlags       : windows.DWORD;		
    dwChunkOffset : windows.DWORD;      (* Position of chunk *)
    dwChunkLength : windows.DWORD;      (* Length of chunk *)
  END;

(*
** Palette change chunk
**
** Used in video streams.
*)
TYPE
  AVIPALCHANGE = RECORD
    bFirstEntry  : BYTE;        (* first entry to change *)
    bNumEntries  : BYTE;        (* # entries to change (0 if 256) *)
    wFlags       : WORD;        (* Mostly to preserve alignment... *)
    peNew        : ARRAY [0..0] OF windows.PALETTEENTRY; (* New color specifications *)
  END;

(****************************************************************************
 *
 *  MMREG.H (standard include file for MM defines, like FOURCC and things)
 *
 ***************************************************************************)

(*
#ifndef NOMMREG
    #include <mmreg.h>
#endif
*)

(* ====================== !!! 8.12.97 !!! ===================================

(****************************************************************************
 *
 *  AVIFile - routines for reading/writing standard AVI files
 *
 ***************************************************************************)

(*
 * Ansi - Unicode thunking.
 *
 * Unicode or Ansi-only apps can call the avifile APIs.
 * any Win32 app who wants to use
 * any of the AVI COM interfaces must be UNICODE - the AVISTREAMINFO and
 * AVIFILEINFO structures used in the Info methods of these interfaces are
 * the unicode variants, and no thunking to or from ansi takes place
 * except in the AVIFILE api entrypoints.
 *
 * For Ansi/Unicode thunking: for each entrypoint or structure that
 * uses chars or strings, two versions are declared in the Win32 version,
 * ApiNameW and ApiNameA. The default name ApiName is #defined to one or
 * other of these depending on whether UNICODE is defined (during
 * compilation of the app that is including this header). The source will
 * contain ApiName and ApiNameA (with ApiName being the Win16 implementation,
 * and also #defined to ApiNameW, and ApiNameA being the thunk entrypoint).
 *
 *)

(*
#ifndef mmioFOURCC
PROCEDURE mmioFOURCC(ch0, ch1, ch2, ch3 : CHAR ) : windows.DWORD;
(* ( (windows.DWORD)(BYTE)(ch0) | ( (windows.DWORD)(BYTE)(ch1) << 8 ) | ( (windows.DWORD)(BYTE)(ch2) << 16 ) | ( (windows.DWORD)(BYTE)(ch3) << 24 ) ) *)	
#endif
*)

(*
CONST
  streamtypeVIDEO           = windows.DWORD( ORD( 'v' ) + ORD('i') << 8 + ORD('d') << 16 + ORD('s') << 24 );
  streamtypeAUDIO           = windows.DWORD( ORD( 'a' ) + ORD('u') << 8 + ORD('d') << 16 + ORD('s') << 24 );
  streamtypeMIDI            = windows.DWORD( ORD( 'm' ) + ORD('i') << 8 + ORD('d') << 16 + ORD('s') << 24 );
  streamtypeTEXT            = windows.DWORD( ORD( 't' ) + ORD('x') << 8 + ORD('t') << 16 + ORD('s') << 24 );
*)

(*
CONST
  AVIIF_KEYFRAME   = 00000010H; (* this frame is a key frame. *)
*)

(* For GetFrame::SetFormat - use the best format for the display *)
CONST
  AVIGETFRAMEF_BESTDISPLAYFMT = 1;

(* *)
(* Structures used by AVIStreamInfo & AVIFileInfo. *)
(* *)
(* These are related to, but not identical to, the header chunks *)
(* in an AVI file. *)
(* *)

(*
 * --- AVISTREAMINFO ------------------------------------------------
*)
TYPE
  AVISTREAMINFO = RECORD
    fccType     : windows.DWORD;		
    fccHandler  : windows.DWORD;
    dwFlags     : windows.DWORD;        (* Contains AVITF_* flags *)
    dwCaps      : windows.DWORD;		
    wPriority   : WORD;		
    wLanguage   : WORD;		
    dwScale     : windows.DWORD;
    dwRate      : windows.DWORD;        (* dwRate / dwScale == samples/second *)
    dwStart     : windows.DWORD;
    dwLength    : windows.DWORD;        (* In units above... *)
    dwInitialFrames             : windows.DWORD;		
    dwSuggestedBufferSize       : windows.DWORD;
    dwQuality                   : windows.DWORD;
    dwSampleSize                : windows.DWORD;
    rcFrame                     : windows.RECT;
    dwEditCount                 : windows.DWORD;		
    dwFormatChangeCount         : windows.DWORD;		
    szName                      : ARRAY [0..63] of TCHAR;
  END;
  PAVISTREAMINFO = POINTER TO AVISTREAMINFO;

CONST
  AVISTREAMINFO_DISABLED		= 00000001H;
  AVISTREAMINFO_FORMATCHANGES		= 00010000H;

(*
 * --- AVIFILEINFO ----------------------------------------------------
 *)

TYPE
  AVIFILEINFO = RECORD
    dwMaxBytesPerSec : windows.DWORD;   (* max. transfer rate *)
    dwFlags          : windows.DWORD;   (* the ever-present flags *)
    dwCaps           : windows.DWORD;		
    dwStreams        : windows.DWORD;		
    dwSuggestedBufferSize    : windows.DWORD;		

    dwWidth     : windows.DWORD;		
    dwHeight    : windows.DWORD;		

    dwScale     : windows.DWORD;	
    dwRate      : windows.DWORD;        (* dwRate / dwScale == samples/second *)
    dwLength    : windows.DWORD;		

    dwEditCount : windows.DWORD;		

    szFileType  : ARRAY [0..63] OF TCHAR; (* descriptive string for file type? *)
  END;
  PAVIFILEINFO = POINTER TO AVIFILEINFO;

(* Flags for dwFlags *)
CONST
  AVIFILEINFO_HASINDEX		= 00000010H;
  AVIFILEINFO_MUSTUSEINDEX	= 00000020H;
  AVIFILEINFO_ISINTERLEAVED	= 00000100H;
  AVIFILEINFO_WASCAPTUREFILE	= 00010000H;
  AVIFILEINFO_COPYRIGHTED	= 00020000H;

(* Flags for dwCaps *)
  AVIFILECAPS_CANREAD		= 00000001H;
  AVIFILECAPS_CANWRITE		= 00000002H;
  AVIFILECAPS_ALLKEYFRAMES	= 00000010H;
  AVIFILECAPS_NOCOMPRESSION	= 00000020H;

TYPE
  AVISAVECALLBACK( INTEGER ) : windows.BOOL;

(************************************************************************)
(* Declaration for the AVICOMPRESSOPTIONS structure.  Make sure it 	*)
(* matches the AutoDoc in avisave.c !!!                            	*)
(************************************************************************)

TYPE
  AVICOMPRESSOPTIONS = RECORD
    fccType           : windows.DWORD;   (* stream type, for consistency *)
    fccHandler        : windows.DWORD;   (* compressor *)
    dwKeyFrameEvery   : windows.DWORD;   (* keyframe rate *)
    dwQuality         : windows.DWORD;   (* compress quality 0-10,000 *)
    dwBytesPerSecond  : windows.DWORD;   (* bytes per second *)
    dwFlags           : windows.DWORD;   (* flags... see below *)
    lpFormat          : windows.PVOID;   (* save format *)
    cbFormat          : windows.DWORD;
    lpParms           : windows.PVOID;   (* compressor options *)
    cbParms           : windows.DWORD;
    dwInterleaveEvery : windows.DWORD;   (* for non-video streams only *)
  END;
  PAVICOMPRESSOPTIONS = POINTER AVICOMPRESSOPTIONS;

(* *)
(* Defines for the dwFlags field of the AVICOMPRESSOPTIONS struct *)
(* Each of these flags determines if the appropriate field in the structure *)
(* (dwInterleaveEvery, dwBytesPerSecond, and dwKeyFrameEvery) is payed *)
(* attention to.  See the autodoc in avisave.c for details. *)
(* *)
  AVICOMPRESSF_INTERLEAVE		= 00000001H;    (* interleave *)
  AVICOMPRESSF_DATARATE		  = 00000002H;    (* use a data rate *)
  AVICOMPRESSF_KEYFRAMES    = 00000004H;    (* use keyframes *)
  AVICOMPRESSF_VALID		    = 00000008H;    (* has valid data? *)

#include <ole2.h>

