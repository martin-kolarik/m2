(*
 *  ICDrawBegin()
 *
 *  start decompressing data with format (lpbiInput) directly to the screen
 *
 *  return zero if the decompressor supports drawing.
 *
 *)

(*
CONST
  ICDRAW_QUERY        = 00000001H;  (* test for support *)
  ICDRAW_FULLSCREEN   = 00000002H;  (* draw to full screen *)
  ICDRAW_HDC          = 00000004H;  (* draw to a windows.HDC/windows.HWND *)
*)

