(* Messages an app will send to MCIWND *)

(* all the text-related messages are defined out of order above (they need *)
(* to be defined before the MCIWndOpen() macros *)

CONST
  MCIWNDM_GETDEVICEID	= (windows.WM_USER + 100);
  MCIWNDM_GETSTART	= (windows.WM_USER + 103);
  MCIWNDM_GETLENGTH	= (windows.WM_USER + 104);
  MCIWNDM_GETEND	= (windows.WM_USER + 105);
  MCIWNDM_EJECT		= (windows.WM_USER + 107);
  MCIWNDM_SETZOOM	= (windows.WM_USER + 108);
  MCIWNDM_GETZOOM       = (windows.WM_USER + 109);
  MCIWNDM_SETVOLUME	= (windows.WM_USER + 110);
  MCIWNDM_GETVOLUME	= (windows.WM_USER + 111);
  MCIWNDM_SETSPEED	= (windows.WM_USER + 112);
  MCIWNDM_GETSPEED	= (windows.WM_USER + 113);
  MCIWNDM_SETREPEAT	= (windows.WM_USER + 114);
  MCIWNDM_GETREPEAT	= (windows.WM_USER + 115);
  MCIWNDM_REALIZE       = (windows.WM_USER + 118);
  MCIWNDM_VALIDATEMEDIA = (windows.WM_USER + 121);
  MCIWNDM_PLAYFROM	= (windows.WM_USER + 122);
  MCIWNDM_PLAYTO        = (windows.WM_USER + 123);
  MCIWNDM_GETPALETTE    = (windows.WM_USER + 126);
  MCIWNDM_SETPALETTE    = (windows.WM_USER + 127);
  MCIWNDM_SETTIMERS	= (windows.WM_USER + 129);
  MCIWNDM_SETACTIVETIMER	= (windows.WM_USER + 130);
  MCIWNDM_SETINACTIVETIMER      = (windows.WM_USER + 131);
  MCIWNDM_GETACTIVETIMER	= (windows.WM_USER + 132);
  MCIWNDM_GETINACTIVETIMER      = (windows.WM_USER + 133);
  MCIWNDM_CHANGESTYLES	        = (windows.WM_USER + 135);
  MCIWNDM_GETSTYLES	  = (windows.WM_USER + 136);
  MCIWNDM_GETALIAS	  = (windows.WM_USER + 137);
  MCIWNDM_PLAYREVERSE	  = (windows.WM_USER + 139);
  MCIWNDM_GET_SOURCE      = (windows.WM_USER + 140);
  MCIWNDM_PUT_SOURCE      = (windows.WM_USER + 141);
  MCIWNDM_GET_DEST        = (windows.WM_USER + 142);
  MCIWNDM_PUT_DEST        = (windows.WM_USER + 143);
  MCIWNDM_CAN_PLAY        = (windows.WM_USER + 144);
  MCIWNDM_CAN_WINDOW      = (windows.WM_USER + 145);
  MCIWNDM_CAN_RECORD      = (windows.WM_USER + 146);
  MCIWNDM_CAN_SAVE        = (windows.WM_USER + 147);
  MCIWNDM_CAN_EJECT       = (windows.WM_USER + 148);
  MCIWNDM_CAN_CONFIG      = (windows.WM_USER + 149);
  MCIWNDM_PALETTEKICK     = (windows.WM_USER + 150);
  MCIWNDM_OPENINTERFACE	  = (windows.WM_USER + 151);
  MCIWNDM_SETOWNER	  = (windows.WM_USER + 152);

  MCIWNDM_SENDSTRING 	  = (windows.WM_USER + 101);
  MCIWNDM_GETPOSITION 	  = (windows.WM_USER + 102);
  MCIWNDM_GETMODE 	  = (windows.WM_USER + 106);
  MCIWNDM_SETTIMEFORMAT   = (windows.WM_USER + 119);
  MCIWNDM_GETTIMEFORMAT   = (windows.WM_USER + 120);
  MCIWNDM_GETFILENAME     = (windows.WM_USER + 124);
  MCIWNDM_GETDEVICE       = (windows.WM_USER + 125);
  MCIWNDM_GETERROR        = (windows.WM_USER + 128);
  MCIWNDM_NEW 	          = (windows.WM_USER + 134);
  MCIWNDM_RETURNSTRING 	  = (windows.WM_USER + 138);
  MCIWNDM_OPEN 		  = (windows.WM_USER + 153);

(* note that the source text for MCIWND will thus contain *)
(* support for eg MCIWNDM_SENDSTRING (both the 16-bit entrypoint AND *)
(* in win32 mapped to MCIWNDM_SENDSTRINGW), and MCIWNDM_SENDSTRINGA (the *)
(* win32 ansi thunk). *)

(* Messages MCIWND will send to an app *)
  MCIWNDM_NOTIFYMODE      = (windows.WM_USER + 200);  (* wp = hwnd, lp = mode *)
  MCIWNDM_NOTIFYPOS	  = (windows.WM_USER + 201);  (* wp = hwnd, lp = pos *)
  MCIWNDM_NOTIFYSIZE	  = (windows.WM_USER + 202);  (* wp = hwnd *)
  MCIWNDM_NOTIFYMEDIA     = (windows.WM_USER + 203);  (* wp = hwnd, lp = fn *)
  MCIWNDM_NOTIFYERROR     = (windows.WM_USER + 205);  (* wp = hwnd, lp = error *)

(* special seek values for START and END *)
  MCIWND_START                = -1;
  MCIWND_END                  = -2;

(* MCI command message identifiers *)
CONST
  MCI_CLOSE                       = 0804H;
  MCI_PLAY                        = 0806H;
  MCI_SEEK                        = 0807H;
  MCI_STOP                        = 0808H;
  MCI_PAUSE                       = 0809H;
  MCI_STEP                        = 080EH;
  MCI_RECORD                      = 080FH;
  MCI_SAVE                        = 0813H;
  MCI_CUT                         = 0851H;
  MCI_COPY                        = 0852H;
  MCI_PASTE                       = 0853H;
  MCI_RESUME                      = 0855H;
  MCI_DELETE                      = 0856H;

(* return values for 'status mode' command *)
  MCI_MODE_NOT_READY      = (524);
  MCI_MODE_STOP           = (525);
  MCI_MODE_PLAY           = (526);
  MCI_MODE_RECORD         = (527);
  MCI_MODE_SEEK           = (528);
  MCI_MODE_PAUSE          = (529);
  MCI_MODE_OPEN           = (530);

(****************************************************************************
 *
 *  VIDEO - Video Capture Driver Interface
 *
 ****************************************************************************)

(* video data types *)

TYPE
  HVIDEO = WORD;
(*DECLARE_HANDLE(HVIDEO);*)                 (* generic handle *)
TYPE
  PHVIDEO = POINTER TO HVIDEO;

(****************************************************************************

                        version api

****************************************************************************)

PROCEDURE VideoForWindowsVersion() : windows.DWORD;

(****************************************************************************

                            Error Return Values

****************************************************************************)
CONST
  DV_ERR_OK               = (0);                 (* No error *)
  DV_ERR_BASE             = (1);                 (* Error Base *)
  DV_ERR_NONSPECIFIC      = (DV_ERR_BASE);
  DV_ERR_BADFORMAT        = (DV_ERR_BASE + 1);
				(* unsupported video format *)
  DV_ERR_STILLPLAYING     = (DV_ERR_BASE + 2);
				(* still something playing *)
  DV_ERR_UNPREPARED       = (DV_ERR_BASE + 3);
				(* header not prepared *)
  DV_ERR_SYNC             = (DV_ERR_BASE + 4);
				(* device is synchronous *)
  DV_ERR_TOOMANYCHANNELS  = (DV_ERR_BASE + 5);
				(* number of channels exceeded *)
  DV_ERR_NOTDETECTED	= (DV_ERR_BASE + 6);   (* HW not detected *)
  DV_ERR_BADINSTALL	= (DV_ERR_BASE + 7);   (* Can not get Profile *)
  DV_ERR_CREATEPALETTE	= (DV_ERR_BASE + 8);
  DV_ERR_SIZEFIELD	= (DV_ERR_BASE + 9);
  DV_ERR_PARAM1		= (DV_ERR_BASE + 10);
  DV_ERR_PARAM2		= (DV_ERR_BASE + 11);
  DV_ERR_CONFIG1	= (DV_ERR_BASE + 12);
  DV_ERR_CONFIG2	= (DV_ERR_BASE + 13);
  DV_ERR_FLAGS		= (DV_ERR_BASE + 14);
  DV_ERR_13		= (DV_ERR_BASE + 15);

  DV_ERR_NOTSUPPORTED     = (DV_ERR_BASE + 16);  (* function not suported *)
  DV_ERR_NOMEM            = (DV_ERR_BASE + 17);  (* out of memory *)
  DV_ERR_ALLOCATED        = (DV_ERR_BASE + 18);  (* device is allocated *)
  DV_ERR_BADDEVICEID      = (DV_ERR_BASE + 19);
  DV_ERR_INVALHANDLE      = (DV_ERR_BASE + 20);
  DV_ERR_BADERRNUM        = (DV_ERR_BASE + 21);
  DV_ERR_NO_BUFFERS       = (DV_ERR_BASE + 22);  (* out of buffers *)

  DV_ERR_MEM_CONFLICT     = (DV_ERR_BASE + 23);  (* Mem conflict detected *)
  DV_ERR_IO_CONFLICT      = (DV_ERR_BASE + 24);  (* I/O conflict detected *)
  DV_ERR_DMA_CONFLICT     = (DV_ERR_BASE + 25);  (* DMA conflict detected *)
  DV_ERR_INT_CONFLICT     = (DV_ERR_BASE + 26);  (* Interrupt conflict detected *)
  DV_ERR_PROTECT_ONLY     = (DV_ERR_BASE + 27);  (* Can not run in standard mode *)
  DV_ERR_LASTERROR        = (DV_ERR_BASE + 27);

  DV_ERR_USER_MSG         = (DV_ERR_BASE + 1000); (* Hardware specific errors *)

(****************************************************************************

                         Callback Messages

Note that the values for all installable driver callback messages are
identical, (ie. MM_DRVM_DATA has the same value for capture drivers,
installable video codecs, and the audio compression manager).
****************************************************************************)

CONST
  MM_DRVM_OPEN       = 3D0H;
  MM_DRVM_CLOSE      = 3D1H;
  MM_DRVM_DATA       = 3D2H;
  MM_DRVM_ERROR      = 3D3H;

CONST
  DV_VM_OPEN        =  MM_DRVM_OPEN;         (* Obsolete messages *)
  DV_VM_CLOSE       =  MM_DRVM_CLOSE;
  DV_VM_DATA        =  MM_DRVM_DATA;
  DV_VM_ERROR       =  MM_DRVM_ERROR;

(****************************************************************************

                         Structures

****************************************************************************)
(* video data block header *)
TYPE
  VIDEOHDR = RECORD
    lpData              : windows.PBYTE;  (* pointer to locked data buffer *)
    dwBufferLength      : windows.DWORD;   (* Length of data buffer *)
    dwBytesUsed         : windows.DWORD;   (* Bytes actually used *)
    dwTimeCaptured      : windows.DWORD;   (* Milliseconds from start of stream *)
    dwUser              : windows.DWORD;   (* for client's use *)
    dwFlags             : windows.DWORD;   (* assorted flags (see defines) *)
    dwReserved          : ARRAY [0..3] OF windows.DWORD; (* reserved for driver *)
  END;
  PVIDEOHDR = POINTER TO VIDEOHDR; (* FAR  *)

(* dwFlags field of VIDEOHDR *)
CONST
  VHDR_DONE       = 00000001H;  (* Done bit *)
  VHDR_PREPARED   = 00000002H;  (* Set if this header has been prepared *)
  VHDR_INQUEUE    = 00000004H;  (* Reserved for driver *)
  VHDR_KEYFRAME   = 00000008H;  (* Key Frame *)

(* Channel capabilities structure *)
TYPE
  CHANNEL_CAPS = RECORD
    dwFlags             : windows.DWORD;      (* Capability flags*)
    dwSrcRectXMod       : windows.DWORD;      (* Granularity of src rect in x *)
    dwSrcRectYMod       : windows.DWORD;      (* Granularity of src rect in y *)
    dwSrcRectWidthMod   : windows.DWORD;      (* Granularity of src rect width *)
    dwSrcRectHeightMod  : windows.DWORD;      (* Granularity of src rect height *)
    dwDstRectXMod       : windows.DWORD;      (* Granularity of dst rect in x *)
    dwDstRectYMod       : windows.DWORD;      (* Granularity of dst rect in y *)
    dwDstRectWidthMod   : windows.DWORD;      (* Granularity of dst rect width *)
    dwDstRectHeightMod  : windows.DWORD;      (* Granularity of dst rect height *)
  END;
  PCHANNEL_CAPS = POINTER TO CHANNEL_CAPS; (* FAR  *)

(* dwFlags of CHANNEL_CAPS *)
CONST
  VCAPS_OVERLAY       = 00000001H;      (* overlay channel *)
  VCAPS_SRC_CAN_CLIP  = 00000002H;      (* src rect can clip *)
  VCAPS_DST_CAN_CLIP  = 00000004H;      (* dst rect can clip *)
  VCAPS_CAN_SCALE     = 00000008H;      (* allows src != dst *)

(****************************************************************************

			API Flags

****************************************************************************)

(* Types of channels to open with the videoOpen function *)
CONST
  VIDEO_EXTERNALIN		= 0001H;
  VIDEO_EXTERNALOUT		= 0002H;
  VIDEO_IN			= 0004H;
  VIDEO_OUT			= 0008H;

(* Is a driver dialog available for this channel? *)
  VIDEO_DLG_QUERY	        = 0010H;

(* videoConfigure (both GET and SET) *)
  VIDEO_CONFIGURE_QUERY   	= 8000H;

(* videoConfigure (SET only) *)
  VIDEO_CONFIGURE_SET		= 1000H;

(* videoConfigure (GET only) *)
  VIDEO_CONFIGURE_GET		= 2000H;
  VIDEO_CONFIGURE_QUERYSIZE	= 0001H;

  VIDEO_CONFIGURE_CURRENT	= 0010H;
  VIDEO_CONFIGURE_NOMINAL	= 0020H;
  VIDEO_CONFIGURE_MIN		= 0040H;
  VIDEO_CONFIGURE_MAX		= 0080H;

(****************************************************************************

			CONFIGURE MESSAGES

****************************************************************************)
  DVM_USER                      = 4000H;

  DVM_CONFIGURE_START		= 1000H;
  DVM_CONFIGURE_END		= 1FFFH;

  DVM_PALETTE			= (DVM_CONFIGURE_START + 1);
  DVM_FORMAT			= (DVM_CONFIGURE_START + 2);
  DVM_PALETTERGB555		= (DVM_CONFIGURE_START + 3);
  DVM_SRC_RECT    		= (DVM_CONFIGURE_START + 4);
  DVM_DST_RECT    		= (DVM_CONFIGURE_START + 5);

(****************************************************************************
 *
 *  AVICAP - Window class for AVI capture
 *
 ***************************************************************************)

(* SendMessage in C++*)
(*# save, 
    call( macro => on ) *)
PROCEDURE AVICapSM( hwnd : windows.HWND; m : windows.UINT; w : windows.WPARAM; l : windows.LPARAM );
(*# restore *)
(*
#define AVICapSM(hwnd,m,w,l) ( (IsWindow(hwnd)) ? ::SendMessage(hwnd,m,w,l) : 0)
*)

(* ------------------------------------------------------------------ *)
(*  Window Messages  WM_CAP... which can be sent to an AVICAP window *)
(* ------------------------------------------------------------------ *)

(* UNICODE *)
(* *)
(* The Win32 version of AVICAP on NT supports UNICODE applications: *)
(* for each API or message that takes a CHAR or string parameter, there are *)
(* two versions, ApiNameA and ApiNameW. The default name ApiName is #defined *)
(* to one or other depending on whether UNICODE is defined. Apps can call *)
(* the A and W apis directly, and mix them. *)
(* *)
(* The 32-bit AVICAP on NT uses unicode exclusively internally. *)
(* ApiNameA() will be implemented as a call to ApiNameW() together WITH *)
(* translation of strings. *)

CONST
(* Defines start of the message range *)
WM_CAP_START                    = windows.WM_USER;

(* start of unicode messages *)
WM_CAP_UNICODE_START            = windows.WM_USER+100;

WM_CAP_GET_CAPSTREAMPTR         = (WM_CAP_START+  1);

WM_CAP_SET_CALLBACK_ERROR       = (WM_CAP_START+  2);
WM_CAP_SET_CALLBACK_STATUS      = (WM_CAP_START+  3);

WM_CAP_SET_CALLBACK_YIELD       = (WM_CAP_START+  4);
WM_CAP_SET_CALLBACK_FRAME       = (WM_CAP_START+  5);
WM_CAP_SET_CALLBACK_VIDEOSTREAM = (WM_CAP_START+  6);
WM_CAP_SET_CALLBACK_WAVESTREAM  = (WM_CAP_START+  7);
WM_CAP_GET_USER_DATA		= (WM_CAP_START+  8);
WM_CAP_SET_USER_DATA		= (WM_CAP_START+  9);

WM_CAP_DRIVER_CONNECT           = (WM_CAP_START+  10);
WM_CAP_DRIVER_DISCONNECT        = (WM_CAP_START+  11);

WM_CAP_DRIVER_GET_NAME         = (WM_CAP_START+  12);
WM_CAP_DRIVER_GET_VERSION      = (WM_CAP_START+  13);

WM_CAP_DRIVER_GET_CAPS          = (WM_CAP_START+  14);

WM_CAP_FILE_SET_CAPTURE_FILE   = (WM_CAP_START+  20);
WM_CAP_FILE_GET_CAPTURE_FILE   = (WM_CAP_START+  21);
WM_CAP_FILE_SAVEAS             = (WM_CAP_START+  23);
WM_CAP_FILE_SAVEDIB            = (WM_CAP_START+  25);

(* out of order to save on ifdefs *)
WM_CAP_FILE_ALLOCATE            = (WM_CAP_START+  22);
WM_CAP_FILE_SET_INFOCHUNK       = (WM_CAP_START+  24);

WM_CAP_EDIT_COPY                = (WM_CAP_START+  30);

WM_CAP_SET_AUDIOFORMAT          = (WM_CAP_START+  35);
WM_CAP_GET_AUDIOFORMAT          = (WM_CAP_START+  36);

WM_CAP_DLG_VIDEOFORMAT          = (WM_CAP_START+  41);
WM_CAP_DLG_VIDEOSOURCE          = (WM_CAP_START+  42);
WM_CAP_DLG_VIDEODISPLAY         = (WM_CAP_START+  43);
WM_CAP_GET_VIDEOFORMAT          = (WM_CAP_START+  44);
WM_CAP_SET_VIDEOFORMAT          = (WM_CAP_START+  45);
WM_CAP_DLG_VIDEOCOMPRESSION     = (WM_CAP_START+  46);

WM_CAP_SET_PREVIEW              = (WM_CAP_START+  50);
WM_CAP_SET_OVERLAY              = (WM_CAP_START+  51);
WM_CAP_SET_PREVIEWRATE          = (WM_CAP_START+  52);
WM_CAP_SET_SCALE                = (WM_CAP_START+  53);
WM_CAP_GET_STATUS               = (WM_CAP_START+  54);
WM_CAP_SET_SCROLL               = (WM_CAP_START+  55);

WM_CAP_GRAB_FRAME               = (WM_CAP_START+  60);
WM_CAP_GRAB_FRAME_NOSTOP        = (WM_CAP_START+  61);

WM_CAP_SEQUENCE                 = (WM_CAP_START+  62);
WM_CAP_SEQUENCE_NOFILE          = (WM_CAP_START+  63);
WM_CAP_SET_SEQUENCE_SETUP       = (WM_CAP_START+  64);
WM_CAP_GET_SEQUENCE_SETUP       = (WM_CAP_START+  65);

WM_CAP_SET_MCI_DEVICE          = (WM_CAP_START+  66);
WM_CAP_GET_MCI_DEVICE          = (WM_CAP_START+  67);

WM_CAP_STOP                     = (WM_CAP_START+  68);
WM_CAP_ABORT                    = (WM_CAP_START+  69);

WM_CAP_SINGLE_FRAME_OPEN        = (WM_CAP_START+  70);
WM_CAP_SINGLE_FRAME_CLOSE       = (WM_CAP_START+  71);
WM_CAP_SINGLE_FRAME             = (WM_CAP_START+  72);

WM_CAP_PAL_OPEN                = (WM_CAP_START+  80);
WM_CAP_PAL_SAVE                = (WM_CAP_START+  81);

WM_CAP_PAL_PASTE                = (WM_CAP_START+  82);
WM_CAP_PAL_AUTOCREATE           = (WM_CAP_START+  83);
WM_CAP_PAL_MANUALCREATE         = (WM_CAP_START+  84);

(* Following added post VFW 1.1 *)
WM_CAP_SET_CALLBACK_CAPCONTROL  = (WM_CAP_START+  85);

(* Defines end of the message range *)
(*
WM_CAP_UNICODE_END             = WM_CAP_PAL_SAVEW;
WM_CAP_END                     = WM_CAP_UNICODE_END;
*)

(* ------------------------------------------------------------------ *)
(*  Message crackers for above *)
(* ------------------------------------------------------------------ *)

(* message wrapper macros are defined for the default messages only. Apps *)
(* that wish to mix Ansi and UNICODE message sending will have TO *)
(* reference the _A and _W messages directly *)

