PROCEDURE ICSendMessage(hic : HIC; msg : windows.UINT; dw1 : windows.DWORD; dw2 : windows.DWORD) : windows.LRESULT;

(* Values for wFlags of ICInstall() *)
CONST
  ICINSTALL_UNICODE       = 08000H;

  ICINSTALL_FUNCTION      = 00001H; (* lParam is a DriverProc (function ptr) *)
  ICINSTALL_DRIVER        = 00002H; (* lParam is a driver name (string) *)
  ICINSTALL_HDRV          = 00004H; (* lParam is a HDRVR (driver handle) *)

  ICINSTALL_DRIVERW       = 08002H; (* lParam is a unicode driver name *)

