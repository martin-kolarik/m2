(************************************************************************

    compression functions

************************************************************************)
(*
 *  ICCompress()
 *
 *  compress a single frame
 *
 *)
  PROCEDURE ICCompress(
    hic        : HIC;
    dwFlags    : windows.DWORD;                 (* flags *)
    lpbiOutput : windows.PBITMAPINFOHEADER;    (* output format *)
    lpData     : windows.PVOID;                (* output data *)
    lpbiInput  : windows.PBITMAPINFOHEADER;    (* format of frame to compress *)
    lpBits     : windows.PVOID;                (* frame data to compress *)
    lpckid     : windows.PDWORD;               (* ckid for data in AVI file *)
    lpdwFlags  : windows.PDWORD;               (* flags in the AVI index. *)
    lFrameNum  : windows.LONG;                  (* frame number of seq. *)
    dwFrameSize  : windows.DWORD;               (* reqested size in bytes. (if non zero) *)
    dwQuality    : windows.DWORD;               (* quality within one frame *)
    lpbiPrev     : windows.PBITMAPINFOHEADER;  (* format of previous frame *)
    lpPrev       : windows.PVOID ) : windows.DWORD;    (* previous frame *)

(*# save, call( macro => on ) *)

(*
 *  ICCompressBegin()
 *
 *  start compression from a source format (lpbiInput) to a dest
 *  format (lpbiOuput) is supported.
 *
 *)
PROCEDURE ICCompressBegin(hic : HIC; lpbiInput : windows.DWORD; lpbiOutput : windows.DWORD) : windows.LRESULT;
(*    ICSendMessage(hic, ICM_COMPRESS_BEGIN, (windows.DWORD)(windows.PVOID)(lpbiInput), (windows.DWORD)(windows.PVOID)(lpbiOutput)) *)

(*
 *  ICCompressQuery()
 *
 *  determines if compression from a source format (lpbiInput) to a dest
 *  format (lpbiOuput) is supported.
 *
 *)
PROCEDURE ICCompressQuery(hic : HIC; lpbiInput : windows.DWORD; lpbiOutput : windows.DWORD) : windows.LRESULT;
(*    ICSendMessage(hic, ICM_COMPRESS_QUERY, (windows.DWORD)(windows.PVOID)(lpbiInput), (windows.DWORD)(windows.PVOID)(lpbiOutput)) *)

(*
 *  ICCompressGetFormat()
 *
 *  get the output format, (format of compressed data)
 *  if lpbiOutput is NULL return the size in bytes needed for format.
 *
 *)
PROCEDURE ICCompressGetFormat(hic : HIC; lpbiInput : windows.DWORD; lpbiOutput : windows.DWORD) : windows.LRESULT;
