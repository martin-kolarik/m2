PROCEDURE ICImageCompress(
        hic              : HIC;               (* compressor to use *)
        uiFlags          : windows.UINT;              (* flags (none yet) *)
        lpbiIn           : windows.PBITMAPINFO;      (* format to compress FROM *)
        lpBits           : windows.PVOID;            (* data to compress *)
        lpbiOut          : windows.PBITMAPINFO;      (* compress to this (NULL ==> default) *)
        lQuality         : windows.LONG;              (* quality to use *)
        plSize           : windows.PLONG    (* compress to this size (0=whatever) *)
        ) : windows.HANDLE;

PROCEDURE ICImageDecompress(
        hic                : HIC;          (* compressor to use *)
        uiFlags            : windows.UINT;         (* flags (none yet) *)
        lpbiIn             : windows.PBITMAPINFO; (* format to decompress FROM *)
        lpBits             : windows.PVOID;       (* data to decompress *)
        lpbiOut            : windows.PBITMAPINFO  (* decompress to this (NULL ==> default) *)
        ) : windows.HANDLE;
(* *)
(* Structure used by ICSeqCompressFrame and ICCompressorChoose routines *)
(* Make sure this matches the autodoc in icm.c! *)
(* *)

TYPE
  PCOMPVARS = POINTER TO COMPVARS;
  COMPVARS = RECORD
    cbSize   : windows.LONG;      (* set to sizeof(COMPVARS) before *)
					(* calling ICCompressorChoose *)
    dwFlags    : windows.DWORD;   (* see below... *)
    hic        : HIC;     (* HIC of chosen compressor *)
    fccType    : windows.DWORD;   (* basically ICTYPE_VIDEO *)
    fccHandler : windows.DWORD; (* handler of chosen compressor OR *)
					(* "" or "DIB " *)
    lpbiIn     : windows.PBITMAPINFO; (* input format *)
    lpbiOut    : windows.PBITMAPINFO; (* output format - will compress to this *)
    lpBitsOut  : windows.PVOID;
    lpBitsPrev : windows.PVOID ;		
    lFrame     : windows.LONG;		
    lKey       : windows.LONG;  (* key frames how often? *)
    lDataRate  : windows.LONG;  (* desired data rate KB/Sec *)
    lQ         : windows.LONG;  (* desired quality *)
    lKeyCount  : windows.LONG;		
    lpState    : windows.PVOID;        (* state of compressor *)
    cbState    : windows.LONG;          (* size of the state *)
  END;

(* FLAGS for dwFlags element of COMPVARS structure: *)
(* set this flag if you initialize COMPVARS before calling ICCompressorChoose *)
CONST
  ICMF_COMPVARS_VALID	= 00000001H;	(* COMPVARS contains valid data *)

(* *)
(*  allows user to choose compressor, quality etc... *)
(* *)
PROCEDURE ICCompressorChoose(
        hwnd                : windows.HWND;      (* parent window for dialog *)
        uiFlags             : windows.UINT;      (* flags *)
        pvIn                : windows.PVOID;    (* input format (optional) *)
        lpData              : windows.PVOID;    (* input data (optional) *)
        pc                  : PCOMPVARS; (* data about the compressor/dlg *)
        lpszTitle           : windows.PSTR      (* dialog title (optional) *)
        ) : windows.BOOL;

(* defines for uiFlags *)
CONST
  ICMF_CHOOSE_KEYFRAME	        = 0001H;	(* show KeyFrame Every box *)
  ICMF_CHOOSE_DATARATE	        = 0002H;	(* show DataRate box *)
  ICMF_CHOOSE_PREVIEW	        = 0004H;	(* allow expanded preview dialog *)
  ICMF_CHOOSE_ALLCOMPRESSORS	= 0008H;	(* don't only show those that *)
						(* can handle the input format *)
						(* or input data *)

PROCEDURE ICSeqCompressFrameStart(pc : PCOMPVARS; lpbiIn : windows.PBITMAPINFO) : windows.BOOL;
PROCEDURE ICSeqCompressFrameEnd(pc : PCOMPVARS);

PROCEDURE ICSeqCompressFrame(
    pc      : PCOMPVARS;       (* set by ICCompressorChoose *)
    uiFlags : windows.UINT;            (* flags *)
    lpBits  : windows.PVOID;          (* input DIB bits *)
    pfKey   : windows.PBOOL; (* did it end up being a key frame? *)
    plSize  : windows.PLONG  (* size to compress to/of returned image *)
    ) : windows.PVOID;

PROCEDURE ICCompressorFree(pc : PCOMPVARS);

(**************************************************************************
 *
 *  DRAWDIB - Routines for drawing to the display.
 *
 *************************************************************************)

TYPE
  HDRAWDIB = windows.HANDLE; (* hdd *)

(*********************************************************************

  DrawDib Flags

**********************************************************************)
CONST
  DDF_UPDATE          = 00002H;        (* re-draw the last DIB *)
  DDF_SAME_HDC        = 00004H;        (* windows.HDC same as last call (all setup) *)
  DDF_SAME_DRAW       = 00008H;        (* draw params are the same *)
  DDF_DONTDRAW        = 00010H;        (* dont draw frame, just decompress *)
  DDF_ANIMATE         = 00020H;        (* allow palette animation *)
  DDF_BUFFER          = 00040H;        (* always buffer image *)
  DDF_JUSTDRAWIT      = 00080H;        (* just draw it with GDI *)
  DDF_FULLSCREEN      = 00100H;        (* use DisplayDib *)
  DDF_BACKGROUNDPAL   = 00200H;        (* Realize palette in background *)
  DDF_NOTKEYFRAME     = 00400H;        (* this is a partial frame update, hint *)
  DDF_HURRYUP         = 00800H;        (* hurry up please! *)
  DDF_HALFTONE        = 01000H;        (* always halftone *)

CONST
  DDF_PREROLL         = DDF_DONTDRAW;    (* Builing up a non-keyframe *)
  DDF_SAME_DIB        = DDF_SAME_DRAW;
  DDF_SAME_SIZE       = DDF_SAME_DRAW;

(*********************************************************************

    DrawDib functions
	
*********************************************************************)
