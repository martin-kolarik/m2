PROCEDURE MKFOURCC(ch0, ch1, ch2, ch3 : CHAR ) : windows.DWORD;
(* ( (windows.DWORD)(BYTE)(ch0) | ( (windows.DWORD)(BYTE)(ch1) << 8 ) | ( (windows.DWORD)(BYTE)(ch2) << 16 ) | ( (windows.DWORD)(BYTE)(ch3) << 24 ) ) *)	

(****************************************************************************
 *
 *  COMPMAN - Installable Compression Manager.
 *
 ****************************************************************************)

CONST
  ICVERSION     = 0104H;

TYPE
  HIC = WORD;
(*DECLARE_HANDLE(HIC);*)     (* Handle to a Installable Compressor *)

(* *)
(* this code in biCompression means the DIB must be accesed via *)
(* 48 bit pointers! using *ONLY* the selector given. *)
(* *)
CONST
  BI_1632  = 032333631H;    (* '1632' *)

(*# save, call( macro => on ) *)

PROCEDURE mmioFOURCC(ch0, ch1, ch2, ch3 : CHAR ) : windows.DWORD;
(* ( (windows.DWORD)(BYTE)(ch0) | ( (windows.DWORD)(BYTE)(ch1) << 8 ) | ( (windows.DWORD)(BYTE)(ch2) << 16 ) | ( (windows.DWORD)(BYTE)(ch3) << 24 ) ) *)	

PROCEDURE aviTWOCC(ch0, ch1 : CHAR ) : WORD;
(* ( (WORD)(BYTE)(ch0) | ((WORD)(BYTE)(ch1) << 8) ) *)

(*# restore *)

CONST
  ICTYPE_AUDIO = windows.DWORD( ORD( 'a' ) + ORD('u') << 8 + ORD('d') << 16 + ORD('c') <<24 );
  ICTYPE_VIDEO = windows.DWORD( ORD( 'v' ) + ORD('i') << 8 + ORD('d') << 16 + ORD('c') <<24 );

CONST
  ICERR_OK              = 0;
  ICERR_DONTDRAW        = 1;
  ICERR_NEWPALETTE      = 2;
  ICERR_GOTOKEYFRAME    = 3;
  ICERR_STOPDRAWING 	= 4;

  ERR_UNSUPPORTED    = -1;
  ERR_BADFORMAT      = -2;
  ERR_MEMORY         = -3;
  ERR_INTERNAL       = -4;
  ERR_BADFLAGS       = -5;
  ERR_BADPARAM       = -6;
  ERR_BADSIZE        = -7;
  ERR_BADHANDLE      = -8;
  ERR_CANTUPDATE     = -9;
  ERR_ABORT	     = -10;
  ERR_ERROR          = -100;
  ERR_BADBITDEPTH    = -200;
  ERR_BADIMAGESIZE   = -201;

  ERR_CUSTOM         = -400;    (* errors less than ICERR_CUSTOM... *)

(* Values for dwFlags of ICOpen() *)
CONST
  MODE_COMPRESS	      = 1;
  MODE_DECOMPRESS     = 2;
  MODE_FASTDECOMPRESS = 3;
  MODE_QUERY          = 4;
  MODE_FASTCOMPRESS   = 5;
  MODE_DRAW           = 8;

(* Flags for AVI file index *)
CONST
  AVIIF_LIST	   = 00000001H;
  AVIIF_TWOCC	   = 00000002H;
  AVIIF_KEYFRAME   = 00000010H;

(* quality flags *)
  QUALITY_LOW      = 0;
  QUALITY_HIGH     = 10000;
  QUALITY_DEFAULT  = -1;

(************************************************************************
************************************************************************)

CONST
  ICM_USER          = mmsystem.DRV_USER + 0H;

  ICM_RESERVED_LOW  = mmsystem.DRV_USER + 01000H;
  ICM_RESERVED_HIGH = mmsystem.DRV_USER + 02000H;
  ICM_RESERVED      = ICM_RESERVED_LOW;

(************************************************************************

    messages.

************************************************************************)

  ICM_GETSTATE               = ICM_RESERVED+0;    (* Get compressor state *)
  ICM_SETSTATE               = ICM_RESERVED+1;    (* Set compressor state *)
  ICM_GETINFO                = ICM_RESERVED+2;    (* Query info about the compressor *)

  ICM_CONFIGURE              = ICM_RESERVED+10;   (* show the configure dialog *)
  ICM_ABOUT                  = ICM_RESERVED+11;   (* show the about box *)

  ICM_GETDEFAULTQUALITY      = ICM_RESERVED+30;   (* get the default value for quality *)
  ICM_GETQUALITY             = ICM_RESERVED+31;   (* get the current value for quality *)
  ICM_SETQUALITY             = ICM_RESERVED+32;   (* set the default value for quality *)

  ICM_SET		     = ICM_RESERVED+40;	  (* Tell the driver something *)
  ICM_GET		     = ICM_RESERVED+41;	  (* Ask the driver something *)

(* Constants for ICM_SET: *)
  ICM_FRAMERATE    = windows.DWORD( ORD( 'F' ) + ORD('r') << 8 + ORD('m') << 16 + ORD('R') <<24 );
  ICM_KEYFRAMERATE = windows.DWORD( ORD( 'K' ) + ORD('e') << 8 + ORD('y') << 16 + ORD('R') <<24 );

(************************************************************************

    ICM specific messages.

************************************************************************)

  ICM_COMPRESS_GET_FORMAT    = ICM_USER+4;     (* get compress format or SIZE *)
  ICM_COMPRESS_GET_SIZE      = ICM_USER+5;     (* get output SIZE *)
  ICM_COMPRESS_QUERY         = ICM_USER+6;     (* query support for compress *)
  ICM_COMPRESS_BEGIN         = ICM_USER+7;     (* begin a series of compress calls. *)
  ICM_COMPRESS               = ICM_USER+8;     (* compress a frame *)
  ICM_COMPRESS_END           = ICM_USER+9;     (* end of a series of compress calls. *)

  ICM_DECOMPRESS_GET_FORMAT  = ICM_USER+10;    (* get decompress format or SIZE *)
  ICM_DECOMPRESS_QUERY       = ICM_USER+11;    (* query support for dempress *)
  ICM_DECOMPRESS_BEGIN       = ICM_USER+12;    (* start a series of decompress calls *)
  ICM_DECOMPRESS             = ICM_USER+13;    (* decompress a frame *)
  ICM_DECOMPRESS_END         = ICM_USER+14;    (* end a series of decompress calls *)
  ICM_DECOMPRESS_SET_PALETTE = ICM_USER+29;    (* fill in the DIB color table *)
  ICM_DECOMPRESS_GET_PALETTE = ICM_USER+30;    (* fill in the DIB color table *)

  ICM_DRAW_QUERY             = ICM_USER+31;    (* query support for dempress *)
  ICM_DRAW_BEGIN             = ICM_USER+15;    (* start a series of draw calls *)
  ICM_DRAW_GET_PALETTE       = ICM_USER+16;    (* get the palette needed for drawing *)
  ICM_DRAW_START             = ICM_USER+18;    (* start decompress clock *)
  ICM_DRAW_STOP              = ICM_USER+19;    (* stop decompress clock *)
  ICM_DRAW_END               = ICM_USER+21;    (* end a series of draw calls *)
  ICM_DRAW_GETTIME           = ICM_USER+32;    (* get value of decompress clock *)
  ICM_DRAW                   = ICM_USER+33;    (* generalized "render" message *)
  ICM_DRAW_WINDOW            = ICM_USER+34;    (* drawing window has moved or hidden *)
  ICM_DRAW_SETTIME           = ICM_USER+35;    (* set correct value for decompress clock *)
  ICM_DRAW_REALIZE           = ICM_USER+36;    (* realize palette for drawing *)
  ICM_DRAW_FLUSH	     = ICM_USER+37;    (* clear out buffered frames *)
  ICM_DRAW_RENDERBUFFER      = ICM_USER+38;    (* draw undrawn things in queue *)

  ICM_DRAW_START_PLAY        = ICM_USER+39;    (* start of a play *)
  ICM_DRAW_STOP_PLAY         = ICM_USER+40;    (* end of a play *)

  ICM_DRAW_SUGGESTFORMAT     = ICM_USER+50;    (* Like ICGetDisplayFormat *)
  ICM_DRAW_CHANGEPALETTE     = ICM_USER+51;    (* for animating palette *)

  ICM_GETBUFFERSWANTED       = ICM_USER+41;    (* ask about prebuffering *)

  ICM_GETDEFAULTKEYFRAMERATE = ICM_USER+42;    (* get the default value for key frames *)

  ICM_DECOMPRESSEX_BEGIN     = ICM_USER+60;    (* start a series of decompress calls *)
  ICM_DECOMPRESSEX_QUERY     = ICM_USER+61;    (* start a series of decompress calls *)
  ICM_DECOMPRESSEX           = ICM_USER+62;    (* decompress a frame *)
  ICM_DECOMPRESSEX_END       = ICM_USER+63;    (* end a series of decompress calls *)

  ICM_COMPRESS_FRAMES_INFO   = ICM_USER+70;    (* tell about compress to come *)
  ICM_SET_STATUS_PROC	     = ICM_USER+72;    (* set status callback *)

(************************************************************************
************************************************************************)
TYPE
  ICOPEN = RECORD
    dwSize      : windows.DWORD;                 (* sizeof(ICOPEN) *)
    fccType     : windows.DWORD;                 (* 'vidc' *)
    fccHandler  : windows.DWORD;                 (* *)
    dwVersion   : windows.DWORD;                 (* version of compman opening you *)
    dwFlags     : windows.DWORD;                 (* LOWORD is type specific *)
    dwError     : windows.LRESULT;               (* error RETURN. *)
    pV1Reserved : windows.PVOID;                (* Reserved *)
    pV2Reserved : windows.PVOID;                (* Reserved *)
    dnDevNode   : windows.DWORD;                 (* Devnode for PnP devices *)
  END;

(************************************************************************
************************************************************************)
TYPE
  ICINFO = RECORD
    dwSize          : windows.DWORD;        (* sizeof(ICINFO) *)
    fccType         : windows.DWORD;        (* compressor type     'vidc' 'audc' *)
    fccHandler      : windows.DWORD;        (* compressor sub-type 'rle ' 'jpeg' 'pcm ' *)
    dwFlags         : windows.DWORD;        (* flags LOWORD is type specific *)
    dwVersion       : windows.DWORD;        (* version of the driver *)
    dwVersionICM    : windows.DWORD;        (* version of the ICM used *)
    (* *)
    (* under Win32, the driver always returns UNICODE strings. *)
    (* *)
    szName          : ARRAY [0..15] OF WCHAR;  (* short name *)
    szDescription   : ARRAY [0..127] OF WCHAR; (* long name *)
    szDriver        : ARRAY [0..127] OF WCHAR; (* driver that contains compressor *)
  END;
  PICINFO = POINTER TO ICINFO;

(* Flags for the <dwFlags> field of the <ICINFO> structure. *)
CONST
  VIDCF_QUALITY        = 0001H; (* supports quality *)
  VIDCF_CRUNCH         = 0002H; (* supports crunching to a frame SIZE *)
  VIDCF_TEMPORAL       = 0004H; (* supports inter-frame compress *)
  VIDCF_COMPRESSFRAMES = 0008H; (* wants the compress all frames message *)
  VIDCF_DRAW           = 0010H; (* supports drawing *)
  VIDCF_FASTTEMPORALC  = 0020H; (* does not need prev frame on compress *)
  VIDCF_FASTTEMPORALD  = 0080H; (* does not need prev frame on decompress *)

(*VIDCF_QUALITYTIME    = 0040H;    supports temporal quality      *)
(*VIDCF_FASTTEMPORAL   = (VIDCF_FASTTEMPORALC|VIDCF_FASTTEMPORALD); *)

(************************************************************************
************************************************************************)

CONST
  ICCOMPRESS_KEYFRAME	= 01H;

TYPE
  ICCOMPRESS = RECORD
    dwFlags       : windows.DWORD;   (* flags *)

    lpbiOutput    : windows.PBITMAPINFOHEADER;   (* output format *)
    lpOutput      : windows.PVOID;               (* output data *)

    lpbiInput     : windows.PBITMAPINFOHEADER;   (* format of frame to compress *)
    lpInput       : windows.PVOID;               (* frame data to compress *)

    lpckid        : windows.PDWORD;              (* ckid for data in AVI file *)
    lpdwFlags     : windows.PDWORD;              (* flags in the AVI index. *)
    lFrameNum     : windows.LONG;                 (* frame number of seq. *)
    dwFrameSize   : windows.DWORD;                (* reqested size in bytes. (if non zero) *)

    dwQuality     : windows.DWORD;                (* quality *)

    (* these are new fields *)
    lpbiPrev      : windows.PBITMAPINFOHEADER;   (* format of previous frame *)
    lpPrev        : windows.PVOID;               (* previous frame *)
  END;

(************************************************************************
************************************************************************)

CONST
  ICCOMPRESSFRAMES_PADDING	= 01H;

TYPE
  TGetData = PROCEDURE (windows.LPARAM (*lInput*), windows.LONG (*lFrame*), windows.PVOID (*lpBits*), windows.LONG (*len*)) : windows.LONG;
  TPutData = PROCEDURE (windows.LPARAM (*lOutput*), windows.LONG (*lFrame*), windows.PVOID (*lpBits*), windows.LONG (*len*)) : windows.LONG;

  ICCOMPRESSFRAMES = RECORD
    dwFlags        : windows.DWORD;                (* flags *)

    lpbiOutput     : windows.PBITMAPINFOHEADER;   (* output format *)
    lOutput        : windows.LPARAM;               (* output identifier *)

    lpbiInput      : windows.PBITMAPINFOHEADER;   (* format of frame to compress *)
    lInput         : windows.LPARAM;               (* input identifier *)

    lStartFrame    : windows.LONG;                 (* start frame *)
    lFrameCount    : windows.LONG;                 (* # of frames *)

    lQuality       : windows.LONG;                 (* quality *)
    lDataRate      : windows.LONG;                 (* data rate *)
    lKeyRate       : windows.LONG;                 (* key frame rate *)

    dwRate         : windows.DWORD;                (* frame rate, as always *)
    dwScale        : windows.DWORD;

    dwOverheadPerFrame  : windows.DWORD;		
    dwReserved2         : windows.DWORD;		

    GetData        : TGetData;
    PutData        : TPutData;
  END;

CONST
(* messages for Status callback *)
  ICSTATUS_START            = 0;
  ICSTATUS_STATUS           = 1;	    (* l == % done *)
  ICSTATUS_END	            = 2;
  ICSTATUS_ERROR	    = 3;	    (* l == error string (windows.PSTR) *)
  ICSTATUS_YIELD	    = 4;
(* return nonzero means abort operation in progress *)

TYPE
  TStatus = PROCEDURE( windows.LPARAM (*lParam*), windows.UINT (*message*), windows.LONG (*l*) ) : windows.LONG;

  ICSETSTATUSPROC = RECORD
    dwFlags     : windows.DWORD;		
    lParam      : windows.LPARAM;		
    Status      : TStatus;
  END;


(************************************************************************
************************************************************************)
CONST
  ICDECOMPRESS_HURRYUP      = 080000000H;   (* don't draw just buffer (hurry up!) *)
  ICDECOMPRESS_UPDATE       = 040000000H;   (* don't draw just update screen *)
  ICDECOMPRESS_PREROLL      = 020000000H;   (* this frame is before real start *)
  ICDECOMPRESS_NULLFRAME    = 010000000H;   (* repeat last frame *)
  ICDECOMPRESS_NOTKEYFRAME  =  08000000H;   (* this frame is not a key frame *)

TYPE
  ICDECOMPRESS = RECORD
    dwFlags    : windows.DWORD;                (* flags (from AVI index...) *)

    lpbiInput  : windows.PBITMAPINFOHEADER;   (* BITMAPINFO of compressed data *)
                                       (* biSizeImage has the chunk SIZE *)
    lpInput    : windows.PVOID;               (* compressed data *)

    lpbiOutput : windows.PBITMAPINFOHEADER;   (* DIB to decompress TO *)
    lpOutput   : windows.PVOID;
    ckid       : windows.DWORD;                (* ckid from AVI file *)
  END;

  ICDECOMPRESSEX = RECORD
    (* *)
    (* same as ICM_DECOMPRESS *)
    (* *)
    dwFlags     : windows.DWORD;
    lpbiSrc     : windows.PBITMAPINFOHEADER;   (* BITMAPINFO of compressed data *)
    lpSrc       : windows.PVOID;               (* compressed data *)

    lpbiDst     : windows.PBITMAPINFOHEADER;   (* DIB to decompress TO *)
    lpDst       : windows.PVOID;               (* output data *)

    (* *)
    (* new for ICM_DECOMPRESSEX *)
    (* *)
    xDst        : INTEGER;  (* destination rectangle *)
    yDst        : INTEGER;
    dxDst       : INTEGER;
    dyDst       : INTEGER;

    xSrc        : INTEGER;  (* source rectangle *)
    ySrc        : INTEGER;
    dxSrc       : INTEGER;
    dySrc       : INTEGER;
  END;

(************************************************************************
************************************************************************)
CONST
  ICDRAW_QUERY        = 000000001H;   (* test for support *)
  ICDRAW_FULLSCREEN   = 000000002H;   (* draw to full screen *)
  ICDRAW_HDC          = 000000004H;   (* draw to a windows.HDC/windows.HWND *)
  ICDRAW_ANIMATE      = 000000008H;   (* expect palette animation *)
  ICDRAW_CONTINUE     = 000000010H;   (* draw is a continuation of previous draw *)
  ICDRAW_MEMORYDC     = 000000020H;   (* DC is offscreen, by the way *)
  ICDRAW_UPDATING     = 000000040H;   (* We're updating, as opposed to playing *)
  ICDRAW_RENDER       = 000000080H;   (* used to render data not draw it *)
  ICDRAW_BUFFER       = 000000100H;   (* please buffer this data offscreen, we will need to update it *)

TYPE
  ICDRAWBEGIN = RECORD
    dwFlags   : windows.DWORD;  (* flags *)

    hpal        : windows.HPALETTE;     (* palette to draw WITH *)
    hwnd        : windows.HWND;         (* window to draw TO *)
    hdc         : windows.HDC;          (* windows.HDC to draw TO *)

    xDst        : INTEGER;  (* destination rectangle *)
    yDst        : INTEGER;
    dxDst       : INTEGER;
    dyDst       : INTEGER;
    lpbi        : windows.PBITMAPINFOHEADER;   (* format of frame to draw *)

    xSrc        : INTEGER;  (* source rectangle *)
    ySrc        : INTEGER;
    dxSrc       : INTEGER;
    dySrc       : INTEGER;

    dwRate      : windows.DWORD;        (* frames/second = (dwRate/dwScale) *)
    dwScale     : windows.DWORD;
  END;

(************************************************************************
************************************************************************)
CONST
  ICDRAW_HURRYUP      = 080000000H;   (* don't draw just buffer (hurry up!) *)
  ICDRAW_UPDATE       = 040000000H;   (* = don't draw just update screen *)
  ICDRAW_PREROLL      = 020000000H;   (* this frame is before real start *)
  ICDRAW_NULLFRAME    = 010000000H;   (* repeat last frame *)
  ICDRAW_NOTKEYFRAME  =  08000000H;   (* this frame is not a key frame *)

TYPE
  ICDRAW = RECORD
    dwFlags     : windows.DWORD;        (* flags *)
    lpFormat    : windows.PVOID;       (* format of frame to decompress *)
    lpData      : windows.PVOID;       (* frame data to decompress *)
    cbData      : windows.DWORD;
    lTime       : windows.LONG;         (* time in drawbegin units (see dwRate and dwScale) *)
  END;

  ICDRAWSUGGEST = RECORD
    lpbiIn      : windows.PBITMAPINFOHEADER;   (* format to be drawn *)
    lpbiSuggest : windows.PBITMAPINFOHEADER;   (* location for suggested format (or NULL to get SIZE) *)
    dxSrc       : INTEGER;                  (* source extent or 0 *)
    dySrc       : INTEGER;                  			
    dxDst       : INTEGER;        (* dest extent or 0 *)
    dyDst       : INTEGER;  			
    hicDecompressor : HIC;    (* decompressor you can talk TO *)
  END;

(************************************************************************
************************************************************************)
  ICPALETTE = RECORD
    dwFlags : windows.DWORD;    (* flags (from AVI index...) *)
    iStart  : INTEGER;      (* first palette to change *)
    iLen    : INTEGER;      (* count of entries to change. *)
    lppe    : windows.PPALETTEENTRY;    (* palette *)
  END;

