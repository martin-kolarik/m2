IMPORT
  windows,
  winreg;

(*****************************************************************************\
*                                                                             *
* shellapi.h -  SHELL.DLL functions, types, and definitions                   *
*                                                                             *
* Copyright (c) 1992-1996, Microsoft Corp.  All rights reserved               *
*                                                                             *
