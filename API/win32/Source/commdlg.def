CONST
  DN_DEFAULTPRN   = 0001H;

PROCEDURE CommDlgExtendedError() : windows.DWORD;

CONST 
  WM_PSD_PAGESETUPDLG    = windows.WM_USER;
  WM_PSD_FULLPAGERECT    = windows.WM_USER+1;
  WM_PSD_MINMARGINRECT   = windows.WM_USER+2;
  WM_PSD_MARGINRECT      = windows.WM_USER+3;
  WM_PSD_GREEKTEXTRECT   = windows.WM_USER+4;
  WM_PSD_ENVSTAMPRECT    = windows.WM_USER+5;
