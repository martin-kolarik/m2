TYPE
  LPPRINTHOOKPROC = PROCEDURE( windows.HWND, windows.UINT, windows.WPARAM, windows.LPARAM) : windows.UINT_PTR;
  LPSETUPHOOKPROC = PROCEDURE( windows.HWND, windows.UINT, windows.WPARAM, windows.LPARAM) : windows.UINT_PTR;

  PRINTDLG = RECORD
    lStructSize : windows.DWORD;
    hwndOwner : windows.HWND;
    hDevMode : windows.HGLOBAL;
    hDevNames : windows.HGLOBAL;
    hDC : windows.HDC;
    Flags : windows.DWORD;
    nFromPage : WORD;
    nToPage : WORD;
    nMinPage : WORD;
    nMaxPage : WORD;
    nCopies : WORD;
    hInstance : windows.HINSTANCE;
    lCustData : windows.LPARAM;
    lpfnPrintHook : LPPRINTHOOKPROC;
    lpfnSetupHook : LPSETUPHOOKPROC;
    lpPrintTemplateName : windows.PCTSTR;
    lpSetupTemplateName : windows.PCTSTR;
    hPrintTemplate : windows.HGLOBAL;
    hSetupTemplate : windows.HGLOBAL;
  END;
  LPPRINTDLG = POINTER TO PRINTDLG;

PROCEDURE PrintDlg( _ : LPPRINTDLG ) : windows.BOOL;

