IMPORT
  windows;


(*============================================================*)
(* Windows header:          commdlg.h                         *)
(*============================================================*)

TYPE
  POFNHOOKPROC = PROCEDURE( windows.HWND, windows.UINT, windows.WPARAM, windows.LPARAM ): windows.UINT_PTR;

  OPENFILENAMEA = RECORD
    lStructSize : windows.DWORD;
    hwndOwner : windows.HWND;
    hInstance : windows.HINSTANCE;
    lpstrFilter : windows.PCSTR;
    lpstrCustomFilter : windows.PSTR;
    nMaxCustFilter : windows.DWORD;
    nFilterIndex : windows.DWORD;
    lpstrFile : windows.PSTR;
    nMaxFile : windows.DWORD;
    lpstrFileTitle : windows.PSTR;
    nMaxFileTitle : windows.DWORD;
    lpstrInitialDir : windows.PCSTR;
    lpstrTitle : windows.PCSTR;
    Flags : windows.DWORD;
    nFileOffset : WORD;
    nFileExtension : WORD;
    lpstrDefExt : windows.PCSTR;
    lCustData : windows.LPARAM;
    lpfnHook : POFNHOOKPROC;
    lpTemplateName : windows.PCSTR;
  END;
  POPENFILENAMEA = POINTER TO OPENFILENAMEA;

  OPENFILENAMEW = RECORD
    lStructSize : windows.DWORD;
    hwndOwner : windows.HWND;
    hInstance : windows.HINSTANCE;
    lpstrFilter : windows.PCWSTR;
    lpstrCustomFilter : windows.PWSTR;
    nMaxCustFilter : windows.DWORD;
    nFilterIndex : windows.DWORD;
    lpstrFile : windows.PWSTR;
    nMaxFile : windows.DWORD;
    lpstrFileTitle : windows.PWSTR;
    nMaxFileTitle : windows.DWORD;
    lpstrInitialDir : windows.PCWSTR;
    lpstrTitle : windows.PCWSTR;
    Flags : windows.DWORD;
    nFileOffset : WORD;
    nFileExtension : WORD;
    lpstrDefExt : windows.PCWSTR;
    lCustData : windows.LPARAM;
    lpfnHook : POFNHOOKPROC;
    lpTemplateName : windows.PCWSTR;
  END;
  POPENFILENAMEW = POINTER TO OPENFILENAMEW;

PROCEDURE GetOpenFileNameA( _ : POPENFILENAMEA ): windows.BOOL;
PROCEDURE GetSaveFileNameA( _ : POPENFILENAMEA ): windows.BOOL;
PROCEDURE GetOpenFileNameW( _ : POPENFILENAMEW ): windows.BOOL;
PROCEDURE GetSaveFileNameW( _ : POPENFILENAMEW ): windows.BOOL;

CONST
(*%F UNICODE *)
  OPENFILENAME    ::= OPENFILENAMEA;
  POPENFILENAME   ::= POPENFILENAMEA;
  GetOpenFileName ::= GetOpenFileNameA;
  GetSaveFileName ::= GetSaveFileNameA;
(*%E UNICODE *)
(*%T UNICODE *)
  OPENFILENAME    ::= OPENFILENAMEW;
  POPENFILENAME   ::= POPENFILENAMEW;
  GetOpenFileName ::= GetOpenFileNameW;
  GetSaveFileName ::= GetSaveFileNameW;
(*%E UNICODE *)

PROCEDURE GetFileTitle( _ : windows.PCTSTR; _ : windows.PTSTR; _ : WORD) : windows.SHORT;

CONST 
  OFN_READONLY               = 00000001H;
  OFN_OVERWRITEPROMPT        = 00000002H;
  OFN_HIDEREADONLY           = 00000004H;
  OFN_NOCHANGEDIR            = 00000008H;
  OFN_SHOWHELP               = 00000010H;
  OFN_ENABLEHOOK             = 00000020H;
  OFN_ENABLETEMPLATE         = 00000040H;
  OFN_ENABLETEMPLATEHANDLE   = 00000080H;
  OFN_NOVALIDATE             = 00000100H;
  OFN_ALLOWMULTISELECT       = 00000200H;
  OFN_EXTENSIONDIFFERENT     = 00000400H;
  OFN_PATHMUSTEXIST          = 00000800H;
  OFN_FILEMUSTEXIST          = 00001000H;
  OFN_CREATEPROMPT           = 00002000H;
  OFN_SHAREAWARE             = 00004000H;
  OFN_NOREADONLYRETURN       = 00008000H;
  OFN_NOTESTFILECREATE       = 00010000H;
  OFN_NONETWORKBUTTON        = 00020000H;
  OFN_NOLONGNAMES            = 00040000H;     // force no long names for 4.x modules
//#if(WINVER >= 0x0400)
  OFN_EXPLORER               = 00080000H;     // new look commdlg
  OFN_NODEREFERENCELINKS     = 00100000H;
  OFN_LONGNAMES              = 00200000H;     // force long names for 3.x modules
  OFN_ENABLEINCLUDENOTIFY    = 00400000H;     // send include message to callback
  OFN_ENABLESIZING           = 00800000H;
//#endif /* WINVER >= 0x0400 */
//#if (_WIN32_WINNT >= 0x0500)
  OFN_DONTADDTORECENT        = 02000000H;
  OFN_FORCESHOWHIDDEN        = 10000000H;    // Show All files including System and hidden files
//#endif // (_WIN32_WINNT >= 0x0500)


(* Return values for the registered message sent to the hook function
   when a sharing violation occurs.  OFN_SHAREFALLTHROUGH allows the
   filename to be accepted, OFN_SHARENOWARN rejects the name but puts
   up no warning (returned when the app has already put up a warning
   message), and OFN_SHAREWARN puts up the default warning message
   for sharing violations.
 
   Note:  Undefined return values map to OFN_SHAREWARN, but are
          reserved for future use.
*)


  OFN_SHAREFALLTHROUGH   = 2;
  OFN_SHARENOWARN        = 1;
  OFN_SHAREWARN          = 0;

TYPE
  CCHOOKPROC = PROCEDURE( windows.HWND, windows.UINT, windows.WPARAM, windows.LPARAM) : windows.UINT_PTR;

(* Structure used for all OpenFileName notifications *)
  OFNOTIFY = RECORD 
    hdr : windows.NMHDR;
    lpOFN : OPENFILENAME;
    pszFile : windows.PTSTR;       (* May be NULL *)
  END;
  POFNOTIFY = POINTER TO OFNOTIFY; 

CONST 
  CDN_FIRST = 0-601;
  CDN_LAST  = 0-699;

(* Notifications when Open or Save dialog status changes *)
  CDN_INITDONE       = CDN_FIRST - 0000H;
  CDN_SELCHANGE      = CDN_FIRST - 0001H;
  CDN_FOLDERCHANGE   = CDN_FIRST - 0002H;
  CDN_SHAREVIOLATION = CDN_FIRST - 0003H;
  CDN_HELP           = CDN_FIRST - 0004H;
  CDN_FILEOK         = CDN_FIRST - 0005H;
  CDN_TYPECHANGE     = CDN_FIRST - 0006H;

  CDM_FIRST          = windows.WM_USER + 100;
  CDM_LAST           = windows.WM_USER + 200;

(* Messages to query information from the Open or Save dialogs

   lParam = pointer to text buffer that gets filled in
   wParam = max number of characters of the text buffer (including NULL)
   return = < 0 if error; number of characters needed (including NULL) *)

  CDM_GETSPEC        = CDM_FIRST + 0000H;

PROCEDURE CommDlg_OpenSave_GetSpec(_hdlg : windows.HWND; _psz : windows.WPARAM; _cbmax : windows.LPARAM );

(* lParam = pointer to text buffer that gets filled in
   wParam = max number of characters of the text buffer (including NULL)
   return = < 0 if error; number of characters needed (including NULL) *)

CONST
  CDM_GETFILEPATH    = CDM_FIRST + 0001H;

PROCEDURE CommDlg_OpenSave_GetFilePath(_hdlg : windows.HWND; _psz : windows.WPARAM; _cbmax : windows.LPARAM);

(* lParam = pointer to text buffer that gets filled in
   wParam = max number of characters of the text buffer (including NULL)
   return = < 0 if error; number of characters needed (including NULL) *)

CONST
  CDM_GETFOLDERPATH   = CDM_FIRST + 0002H;

PROCEDURE CommDlg_OpenSave_GetFolderPathA(_hdlg : windows.HWND; _psz : windows.WPARAM; _cbmax : windows.LPARAM);

(* lParam = pointer to ITEMIDLIST buffer that gets filled in
   wParam = size of the ITEMIDLIST buffer
   return = < 0 if error; length of buffer needed *)

CONST
  CDM_GETFOLDERIDLIST  = CDM_FIRST + 0003H;

PROCEDURE CommDlg_OpenSave_GetFolderIDList(_hdlg : windows.HWND; _pidl : windows.WPARAM; _cbmax : windows.LPARAM);

(* lParam = pointer to a string
   wParam = ID of control to change
   return = not used *)

CONST
  CDM_SETCONTROLTEXT    = CDM_FIRST + 0004H;

PROCEDURE CommDlg_OpenSave_SetControlText(_hdlg : windows.HWND; _id : windows.WPARAM; _text : windows.LPARAM);
        
(* lParam = not used
   wParam = ID of control to change
   return = not used *)

CONST
  CDM_HIDECONTROL        = CDM_FIRST + 0005H;

PROCEDURE CommDlg_OpenSave_HideControl(_hdlg : windows.HWND; _id : windows.WPARAM );

(* lParam = pointer to default extension (no dot)
   wParam = not used
   return = not used *)

CONST
  CDM_SETDEFEXT           = CDM_FIRST + 0006H;

PROCEDURE CommDlg_OpenSave_SetDefExt(_hdlg : windows.HWND; _pszext : windows.LPARAM);

TYPE
  CHOSECOLOR = RECORD
    lStructSize : windows.DWORD;
    hwndOwner : windows.HWND;
    hInstance : windows.HWND;
    rgbResult : windows.COLORREF;
    lpCustColors : windows.PCOLORREF;
    Flags : windows.DWORD;
    lCustData : windows.LPARAM;
    lpfnHook : CCHOOKPROC;
    lpTemplateName : windows.PCTSTR;
  END;
  PCHOOSECOLOR = POINTER TO CHOOSECOLOR;

PROCEDURE ChooseColor(_ : PCHOOSECOLOR) : windows.BOOL;

CONST
  CC_RGBINIT              = 00000001H;
  CC_FULLOPEN             = 00000002H;
  CC_PREVENTFULLOPEN      = 00000004H;
  CC_SHOWHELP             = 00000008H;
  CC_ENABLEHOOK           = 00000010H;
  CC_ENABLETEMPLATE       = 00000020H;
  CC_ENABLETEMPLATEHANDLE = 00000040H;
  CC_SOLIDCOLOR           = 00000080H;
  CC_ANYCOLOR             = 00000100H;

TYPE 
  FRHOOKPROC = PROCEDURE( windows.HWND, windows.UINT, windows.WPARAM, windows.LPARAM): windows.UINT_PTR;

TYPE 
  FINREPLACE = RECORD 
   lStructSize : windows.DWORD;        (* size of this struct 0x20        *)
   hwndOwner : windows.HWND;           (* handle to owner's window        *)
   hInstance : windows.HINSTANCE;      (* instance handle of.EXE that     *)
                                       (*   contains cust. dlg. template  *)
   Flags : windows.DWORD;              (* one or more of the FR_??        *)
   lpstrFindWhat : windows.PTSTR;      (* ptr. to search string           *)
   lpstrReplaceWith : windows.PTSTR;   (* ptr. to replace string          *)
   wFindWhatLen : WORD;                (* size of find buffer             *)
   wReplaceWithLen : WORD;             (* size of replace buffer          *)
   lCustData : windows.LPARAM;         (* data passed to hook fn.         *)
   lpfnHook : FRHOOKPROC;              (* ptr. to hook fn. or NULL        *)
   lpTemplateName : windows.PCTSTR;    (* custom template name            *)
  END;
  PFINDREPLACE = POINTER TO FINDREPLACE;

CONST
  FR_DOWN                  =  00000001H;
  FR_WHOLEWORD             =  00000002H;
  FR_MATCHCASE             =  00000004H;
  FR_FINDNEXT              =  00000008H;
  FR_REPLACE               =  00000010H;
  FR_REPLACEALL            =  00000020H;
  FR_DIALOGTERM            =  00000040H;
  FR_SHOWHELP              =  00000080H;
  FR_ENABLEHOOK            =  00000100H;
  FR_ENABLETEMPLATE        =  00000200H;
  FR_NOUPDOWN              =  00000400H;
  FR_NOMATCHCASE           =  00000800H;
  FR_NOWHOLEWORD           =  00001000H;
  FR_ENABLETEMPLATEHANDLE  =  00002000H;
  FR_HIDEUPDOWN            =  00004000H;
  FR_HIDEMATCHCASE         =  00008000H;
  FR_HIDEWHOLEWORD         =  00010000H;

PROCEDURE FindText( _ : PFINDREPLACE) : windows.HWND;
PROCEDURE ReplaceText( _ : PFINDREPLACE) : windows.HWND;

TYPE 
  CFHOOKPROC = PROCEDURE( windows.HWND, windows.UINT, windows.WPARAM, windows.LPARAM) : windows.UINT_PTR;

TYPE 
  CHOOSEFONT = RECORD 
    lStructSize : windows.DWORD;
    hwndOwner : windows.HWND;          (* caller's window handle                *)
    hDC : windows.HDC;                 (* printer DC/IC or NULL                 *)
    lpLogFont : windows.PLOGFONT;      (* ptr. to a LOGFONT struct              *)
    iPointSize : INTEGER;              (* 10 * size in points of selected font  *)
    Flags : windows.DWORD;             (* enum. type flags                      *)
    rgbColors : windows.COLORREF;      (* returned text color                   *)
    lCustData : windows.LPARAM;        (* data passed to hook fn.               *)
    lpfnHook : CFHOOKPROC;             (* ptr. to hook function                 *)
    lpTemplateName : windows.PCTSTR;   (* custom template name                  *)
    hInstance : windows.HINSTANCE;     (* instance handle of.EXE that           *)
                                       (*   contains cust. dlg. template        *)
    lpszStyle : windows.PTSTR;         (* return the style field here           *)
                                       (* must be LF_FACESIZE or bigger         *)
    nFontType : WORD;                  (* same value reported to the EnumFonts  *)
                                       (*   call back with the extra FONTTYPE_  *)
                                       (*   bits added                          *)
    ___MISSING_ALIGNMENT__ : WORD;
    nSizeMin : INTEGER;                (* minimum pt size allowed &             *)
    nSizeMax : INTEGER;                (* max pt size allowed if                *)
                                       (*   CF_LIMITSIZE is used                *)
  END;
  PCHOOSEFONT = POINTER TO CHOOSEFONT;

PROCEDURE ChooseFont( _ : PCHOOSEFONT ) : windows.BOOL;

CONST
  CF_SCREENFONTS             = 00000001H;
  CF_PRINTERFONTS            = 00000002H;
  CF_BOTH                    = CF_SCREENFONTS + CF_PRINTERFONTS;
  CF_SHOWHELP                = 00000004H;
  CF_ENABLEHOOK              = 00000008H;
  CF_ENABLETEMPLATE          = 00000010H;
  CF_ENABLETEMPLATEHANDLE    = 00000020H;
  CF_INITTOLOGFONTSTRUCT     = 00000040H;
  CF_USESTYLE                = 00000080H;
  CF_EFFECTS                 = 00000100H;
  CF_APPLY                   = 00000200H;
  CF_ANSIONLY                = 00000400H;
  CF_SCRIPTSONLY             = CF_ANSIONLY;
  CF_NOVECTORFONTS           = 00000800H;
  CF_NOOEMFONTS              = CF_NOVECTORFONTS;
  CF_NOSIMULATIONS           = 00001000H;
  CF_LIMITSIZE               = 00002000H;
  CF_FIXEDPITCHONLY          = 00004000H;
  CF_WYSIWYG                 = 00008000H; (* must also have CF_SCREENFONTS & CF_PRINTERFONTS *)
  CF_FORCEFONTEXIST          = 00010000H;
  CF_SCALABLEONLY            = 00020000H;
  CF_TTONLY                  = 00040000H;
  CF_NOFACESEL               = 00080000H;
  CF_NOSTYLESEL              = 00100000H;
  CF_NOSIZESEL               = 00200000H;
  CF_SELECTSCRIPT            = 00400000H;
  CF_NOSCRIPTSEL             = 00800000H;
  CF_NOVERTFONTS             = 01000000H;

(* these are extra nFontType bits that are added to what is returned to the
  EnumFonts callback routine *)

  SIMULATED_FONTTYPE    = 8000H;
  PRINTER_FONTTYPE      = 4000H;
  SCREEN_FONTTYPE       = 2000H;
  BOLD_FONTTYPE         = 0100H;
  ITALIC_FONTTYPE       = 0200H;
  REGULAR_FONTTYPE      = 0400H;

  WM_CHOOSEFONT_GETLOGFONT = windows.WM_USER + 1;

(* strings used to obtain unique window message for communication
   between dialog and caller *)

  LBSELCHSTRING  = "commdlg_LBSelChangedNotify";
  SHAREVISTRING  = "commdlg_ShareViolation";
  FILEOKSTRING   = "commdlg_FileNameOK";
  COLOROKSTRING  = "commdlg_ColorOK";
  SETRGBSTRING   = "commdlg_SetRGBColor";
  HELPMSGSTRING  = "commdlg_help";
  FINDMSGSTRING  = "commdlg_FindReplace";


(* HIWORD values for lParam of commdlg_LBSelChangeNotify message  *)

  CD_LBSELNOITEMS  = -1;
  CD_LBSELCHANGE   =  0;
  CD_LBSELSUB      =  1;
  CD_LBSELADD      =  2;

