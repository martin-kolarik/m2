    lpPageSetupTemplateName : windows.PCTSTR;
    hPageSetupTemplate : windows.HGLOBAL;
  END;
  LPPAGESETUPDLG = POINTER TO PAGESETUPDLG;

PROCEDURE PageSetupDlg( _ : LPPAGESETUPDLG ) : windows.BOOL;

CONST
  PSD_DEFAULTMINMARGINS              = 00000000H; (* default (printer's)   *)
  PSD_INWININIINTLMEASURE            = 00000000H; (* 1st of 4 possible     *)

  PSD_MINMARGINS                     = 00000001H; (* use caller's          *)
  PSD_MARGINS                        = 00000002H; (* use caller's          *)
