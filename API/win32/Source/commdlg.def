  PSD_NOWARNING                      = 00000080H; (* must be same as PD_*  *)
  PSD_DISABLEORIENTATION             = 00000100H;
  PSD_RETURNDEFAULT                  = 00000400H; (* must be same as PD_*  *)
  PSD_DISABLEPAPER                   = 00000200H;
  PSD_SHOWHELP                       = 00000800H; (* must be same as PD_*  *)
  PSD_ENABLEPAGESETUPHOOK            = 00002000H; (* must be same as PD_*  *)
  PSD_ENABLEPAGESETUPTEMPLATE        = 00008000H; (* must be same as PD_*  *)
  PSD_ENABLEPAGESETUPTEMPLATEHANDLE  = 00020000H; (* must be same as PD_*  *)
  PSD_ENABLEPAGEPAINTHOOK            = 00040000H;
  PSD_DISABLEPAGEPAINTING            = 00080000H;
  PSD_NONETWORKBUTTON                = 00200000H; (* must be same as PD_*  *)
