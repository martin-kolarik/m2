TYPE
  PAGEPAINTHOOK = PROCEDURE( windows.HWND, windows.UINT, windows.WPARAM, windows.LPARAM ) : windows.ULONG;
  PAGESETUPHOOK = PROCEDURE( windows.HWND, windows.UINT, windows.WPARAM, windows.LPARAM ) : windows.ULONG;

  PAGESETUPDLG = RECORD
    lStructSize : windows.DWORD;
    hwndOwner : windows.HWND;
    hDevMode : windows.HGLOBAL;
    hDevNames : windows.HGLOBAL;
    Flags : windows.DWORD;
