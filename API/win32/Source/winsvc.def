PROCEDURE QueryServiceLockStatusA( hSCManager     : SC_HANDLE;
                                   lpLockStatus   : PQUERY_SERVICE_LOCK_STATUSA;
                                   cbBufSize      : windows.DWORD;
                                   pcbBytesNeeded : windows.PDWORD ) : windows.BOOL;
PROCEDURE QueryServiceLockStatusW( hSCManager     : SC_HANDLE;
                                   lpLockStatus   : PQUERY_SERVICE_LOCK_STATUSW;
                                   cbBufSize      : windows.DWORD;
                                   pcbBytesNeeded : windows.PDWORD ) : windows.BOOL;
CONST
(*%T UNICODE *)
  QueryServiceLockStatus ::= QueryServiceLockStatusW;
(*%E UNICODE *)
(*%F UNICODE *)
  QueryServiceLockStatus ::= QueryServiceLockStatusA;
(*%E UNICODE *)

