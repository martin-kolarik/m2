                          lpLoadOrderGroup   : windows.PSTR;
                          lpdwTagId          : windows.PDWORD;
                          lpDependencies     : windows.PSTR;
                          lpServiceStartName : windows.PSTR;
                          lpPassword         : windows.PSTR ) : SC_HANDLE;
PROCEDURE CreateServiceW( hSCManager         : SC_HANDLE;
