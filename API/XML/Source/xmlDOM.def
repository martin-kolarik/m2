CONST
  //----------------------------
  // MSXML SPECIFIC ERROR CODES 
  //----------------------------
  E_XML_NOTWF          = 0C00CE223H; // Validate failed because the document is not well formed.
  E_XML_NODTD          = 0C00CE224H; // Validate failed because a DTD/Schema was not specified in the document.
  E_XML_INVALID        = 0C00CE225H; // Validate failed because of a DTD/Schema violation.
  E_XML_BUFFERTOOSMALL = 0C00CE226H; // Buffer passed in is too small to receive the data.

#restore
END xmlDOM.
